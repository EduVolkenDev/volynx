{
  "name": "volynx",
  "version": "1.0.0",
  "private": true,
  "description": "VOLYNX Ecosystem: Premium kits, browser tools, launch systems for devs/designers/businesses. Astro static site + Express API + Supabase + Stripe subscriptions.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/EduVolkenDev/volynx"
  },
  "workspaces": [
    "apps/volynx-os"
  ],
  "scripts": {
    "dev": "astro dev",
    "lab:assets:sync": "node scripts/sync-lab-assets.mjs",
    "lab:assets:check": "node scripts/check-lab-assets.mjs",
    "models:sync": "npm run lab:assets:sync",
    "predev": "npm run lab:assets:sync",
    "prebuild": "npm run lab:assets:sync",
    "dev:volynx-os": "npm run dev --workspace volynx-os",
    "devjourney:package": "node scripts/package-devjourney.mjs",
    "devjourney:publish": "node scripts/publish-devjourney-deliverables.mjs",
    "devjourney:ship": "npm run devjourney:package && npm run devjourney:publish",
    "icons:package": "node scripts/package-private-icons.mjs",
    "icons:publish": "node scripts/publish-private-icons.mjs",
    "icons:ship": "npm run icons:package && npm run icons:publish",
    "build": "astro build",
    "build:volynx-os": "npm run build --workspace volynx-os",
    "lint:volynx-os": "npm run lint --workspace volynx-os",
    "preview": "astro preview",
    "start": "node index.js",
    "api": "node index.js",
    "stripe:catalog:check": "node scripts/stripe-catalog-reconcile.mjs --dry-run",
    "stripe:catalog:apply": "node scripts/stripe-catalog-reconcile.mjs --apply",
    "stripe:catalog:apply:live": "node scripts/stripe-catalog-reconcile.mjs --apply --live",
    "astro": "astro"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "@tensorflow/tfjs": "^4.11.0",
    "@upscalerjs/esrgan-slim": "^1.0.0",
    "astro": "^5.17.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "onnxruntime-web": "^1.21.0",
    "qr-code-styling": "^1.6.0-rc.1",
    "qrcode": "^1.5.3",
    "stripe": "^20.3.1",
    "three": "^0.180.0",
    "upscaler": "^1.0.0",
    "vectortracer": "^0.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "playwright": "^1.59.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
