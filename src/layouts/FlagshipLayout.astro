---
import "../styles/flagship-v3.css";
import FaviconHead from "../components/FaviconHead.astro";
import PageWidgets from "../components/PageWidgets.astro";
import TierAttrInit from "../components/TierAttrInit.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  pageClass?: string;
}
const {
  title = "VOLYNX — Building a Smarter Future",
  description = "Premium tools, kits and systems for the modern web.",
  ogImage = "/assets/volynx-icon.webp",
  ogType = "website",
  pageClass = "",
} = Astro.props;

const canonicalUrl = `https://volynx.world${Astro.url.pathname}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no,date=no,address=no,email=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`https://volynx.world${ogImage}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://volynx.world${ogImage}`} />

    <link rel="preload" as="image" href="/assets/V.webp" />
    <link rel="preload" as="image" href="/assets/wordmark.webp" />

    <FaviconHead />
    <TierAttrInit />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Volynx",
        "url": "https://volynx.world"
      }
    </script>
    <!-- Cross-subdomain auth hydration (runs BEFORE the early auth check below) -->
    <script is:inline src="/js/vx-auth-bridge.js"></script>
    <!-- Preserve the exact page/task across login and signup. -->
    <script is:inline src="/js/vx-return.js"></script>
    <!-- Keep the access_token fresh; otherwise authed calls 401 after 1h -->
    <script src="/js/vx-token-refresh.js" defer></script>
    <script is:inline>
      function vxAuthTokenIsFresh() {
        try {
          var token = localStorage.getItem('volynx_access_token') || '';
          if (!token) return false;
          var payload = token.split('.')[1];
          if (!payload) return false;
          payload = payload.replace(/-/g, '+').replace(/_/g, '/');
          var data = JSON.parse(atob(payload));
          if (!data || !data.exp) return false;
          return (data.exp * 1000) > (Date.now() + 30000);
        } catch(e) {
          return false;
        }
      }
      // Early auth check — avoid flash of "Login" before DOM is ready
      (function(){
        try {
          if (vxAuthTokenIsFresh()) {
            document.documentElement.classList.add('vx-authed');
          } else {
            document.documentElement.classList.remove('vx-authed');
          }
        } catch(e){}
      })();
      // Populate the user badge AFTER DOM is parsed (badge lives in <body>)
      // For avatar slots (data-vx-avatar-slot), writes initials into the inner
      // .vx-avatar__initials span and toggles the icon — vx-avatar.js may then
      // replace with an <img> if the user has a cached avatar choice.
      function vxPopulateUserBadge() {
        try {
          if (!vxAuthTokenIsFresh()) return;
          var name = '';
          try {
            var s = JSON.parse(localStorage.getItem('volynx_session') || '{}');
            var m = (s && s.user && s.user.user_metadata) || {};
            name = m.full_name || m.username || m.name || '';
          } catch(e) {}
          var email = localStorage.getItem('volynx_user_email') || '';
          var label = name ? name.split(' ')[0] : (email ? email.split('@')[0] : '');
          var initials = label ? label.slice(0, 2).toUpperCase() : 'ME';
          var title = name || email || 'Profile';
          ['vxUserBadge', 'vxLoginBtn', 'vxUserBadgeMobileInitials'].forEach(function(id) {
            var el = document.getElementById(id);
            if (!el) return;
            var initialsEl = el.classList.contains('vx-avatar__initials')
              ? el
              : el.querySelector('.vx-avatar__initials');
            if (initialsEl) {
              initialsEl.textContent = initials;
              initialsEl.hidden = false;
              // Hide the icon when authed; vx-avatar.js may further hide both
              // and append <img> if avatar is cached.
              var icon = el.querySelector('.vx-avatar__icon');
              if (icon) icon.style.display = 'none';
            } else {
              // Legacy element (no inner spans) — keep old behavior.
              el.textContent = initials;
            }
            el.setAttribute('title', title);
            el.setAttribute('aria-label', title);
          });
          var mobileLink = document.getElementById('vxUserBadgeMobile');
          if (mobileLink) {
            mobileLink.setAttribute('title', title);
            mobileLink.setAttribute('aria-label', title);
          }
        } catch (e) {}
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', vxPopulateUserBadge);
      } else {
        vxPopulateUserBadge();
      }
    </script>
  </head>
  <body class={pageClass}>
    <!-- Ambient layers -->
    <div class="backdrop backdrop--one" aria-hidden="true"></div>
    <div class="backdrop backdrop--two" aria-hidden="true"></div>
    <div class="noise" aria-hidden="true"></div>

    <slot />

    <PageWidgets hideUtilBar />
    <script is:inline src="/js/vx-clickable-cards.js"></script>
  </body>
</html>
