---
import "../styles/global.css";
import "../styles/home.css";
import FaviconHead from "../components/FaviconHead.astro";
import PageWidgets from "../components/PageWidgets.astro";
import TierAttrInit from "../components/TierAttrInit.astro";

const {
  title = "VOLYNX — Building a Smarter Future",
  description = "Volynx is a digital ecosystem of tools, services and education focused on accessible technology.",
  ogImage = "/assets/volynx-icon.webp",
} = Astro.props;
const canonicalUrl = `https://volynx.world${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no,date=no,address=no,email=no" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`https://volynx.world${ogImage}`} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://volynx.world${ogImage}`} />
    <meta name="twitter:image:alt" content={title} />
    <title>{title}</title>

    <link rel="preload" as="image" href="/assets/lucid5.webp" />
    <link rel="preload" as="image" href="/assets/wordmark.webp" />
    <link rel="preload" as="image" href="/assets/V.webp" />

    <FaviconHead />
    <TierAttrInit />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Volynx",
        "url": "https://volynx.world"
      }
    </script>
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="vx-page" id="main-content">
      <slot />
    </div>
    <PageWidgets hideUtilBar />
  </body>
</html>
