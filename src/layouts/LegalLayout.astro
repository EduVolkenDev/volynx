---
import "../styles/global.css";
import "../styles/legal.css";
import FaviconHead from "../components/FaviconHead.astro";
import PageWidgets from "../components/PageWidgets.astro";
import TierAttrInit from "../components/TierAttrInit.astro";
import Topbar from "../components/Topbar.astro";
import { ROUTES } from "../data/routes";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "VOLYNX — Premium Tech Platform" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <FaviconHead />
    <TierAttrInit />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="universe-bg" aria-hidden="true"></div>

    <div class="shell">
      <Topbar leftLinks={[{ href: ROUTES.about, label: "About", i18n: "footer.about" }, { href: ROUTES.support, label: "Support" }, { href: ROUTES.contact, label: "Contact", i18n: "footer.contact" }]} rightLinks={[{ href: ROUTES.privacy, label: "Privacy", i18n: "footer.privacy" }, { href: ROUTES.terms, label: "Terms", i18n: "footer.terms" }, { href: ROUTES.disclaimer, label: "Disclaimer", i18n: "footer.disclaimer" }]} />

      <main class="card" id="main-content">
        <slot />

        <div class="footer" role="contentinfo">
          <div class="links">
            <a href={ROUTES.about} data-i18n="footer.about">About</a>
            <a href={ROUTES.support}>Support</a>
            <a href={ROUTES.contact} data-i18n="footer.contact">Contact</a>
            <a href={ROUTES.privacy} data-i18n="footer.privacy">Privacy</a>
            <a href={ROUTES.terms} data-i18n="footer.terms">Terms</a>
            <a href={ROUTES.disclaimer} data-i18n="footer.disclaimer">Disclaimer</a>
          </div>
          <div class="meta">© {new Date().getFullYear()} VOLYNX. <span data-i18n="legal.rights">All rights reserved.</span></div>
        </div>
      </main>
    </div>

    <PageWidgets hideUtilBar />
  </body>
</html>
