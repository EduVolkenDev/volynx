---
import "../styles/global.css";
import "../styles/legal.css";
import PageWidgets from "../components/PageWidgets.astro";
import Topbar from "../components/Topbar.astro";
import { ROUTES } from "../data/routes";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "VOLYNX — Premium Tech Platform" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="shortcut icon" href="/assets/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Volynx" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="universe-bg" aria-hidden="true"></div>

    <div class="shell">
      <Topbar leftLinks={[{ href: ROUTES.about, label: "About" }, { href: ROUTES.contact, label: "Contact" }]} rightLinks={[{ href: ROUTES.privacy, label: "Privacy" }, { href: ROUTES.terms, label: "Terms" }, { href: ROUTES.disclaimer, label: "Disclaimer" }]} />

      <main class="card">
        <slot />

        <div class="footer" role="contentinfo">
          <div class="links">
            <a href={ROUTES.about}>About</a>
            <a href={ROUTES.contact}>Contact</a>
            <a href={ROUTES.privacy}>Privacy</a>
            <a href={ROUTES.terms}>Terms</a>
            <a href={ROUTES.disclaimer}>Disclaimer</a>
          </div>
          <div class="meta">© {new Date().getFullYear()} VOLYNX. All rights reserved.</div>
        </div>
      </main>
    </div>

    <PageWidgets hideUtilBar />
  </body>
</html>
