---
import "../styles/global.css";
import FaviconHead from "../components/FaviconHead.astro";
import PageWidgets from "../components/PageWidgets.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  hideUtilBar?: boolean;
}

const {
  title = "VOLYNX",
  description = "VOLYNX — Premium Tech Platform",
  ogImage = "/assets/volynx-icon.webp",
  ogType = "website",
  hideUtilBar = false
} = Astro.props;

const canonicalUrl = `https://volynx.world${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`https://volynx.world${ogImage}`} />

    <FaviconHead />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="vx-page" id="main-content">
      <slot />
    </div>
    <PageWidgets hideUtilBar={hideUtilBar} />
  </body>
</html>
