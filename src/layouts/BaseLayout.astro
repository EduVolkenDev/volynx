---
import "../styles/global.css";
import FaviconHead from "../components/FaviconHead.astro";
import PageWidgets from "../components/PageWidgets.astro";
import TierAttrInit from "../components/TierAttrInit.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  hideUtilBar?: boolean;
}

const {
  title = "VOLYNX",
  description = "VOLYNX — Premium Tech Platform",
  ogImage = "/assets/volynx-icon.webp",
  ogType = "website",
  hideUtilBar = false
} = Astro.props;

const canonicalUrl = `https://volynx.world${Astro.url.pathname}`;
const privatePathPrefixes = [
  "/account/",
  "/activate/",
  "/admin/",
  "/auth/",
  "/checkout/",
  "/dashboard/",
  "/delivery/",
  "/invite/",
  "/login/",
  "/maintenance/",
  "/profile/",
  "/recarregar/",
  "/signup/",
];
const robots = privatePathPrefixes.some((prefix) => Astro.url.pathname.startsWith(prefix))
  ? "noindex, nofollow"
  : "index, follow";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`https://volynx.world${ogImage}`} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://volynx.world${ogImage}`} />
    <meta name="twitter:image:alt" content={title} />

    <FaviconHead />
    <TierAttrInit />
    <script is:inline src="/js/vx-auth-bridge.js"></script>
    <script is:inline src="/js/vx-return.js"></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="vx-page" id="main-content">
      <slot />
    </div>
    <PageWidgets hideUtilBar={hideUtilBar} />
  </body>
</html>
