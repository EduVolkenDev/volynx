---
import "../styles/global.css";
import PageWidgets from "../components/PageWidgets.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Volynx", description = "Volynx — Premium Tech Platform" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <main class="vx-page">
      <slot />
    </main>
    <PageWidgets />
  </body>
</html>
