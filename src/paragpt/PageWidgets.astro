---
import CookieBanner from "./CookieBanner.astro";
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
---

{!isHome && (
  <a href="/" id="vxHomeBtn" class="vx-widget vx-home-btn" aria-label="Ir para o início">
    ← Home
  </a>
)}

<button id="vxBackTop" class="vx-widget vx-backtop" aria-label="Voltar ao topo" type="button">
  ↑
</button>

<CookieBanner />

<style>
  .vx-widget {
    position: fixed;
    z-index: 9990;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, .16);
    background: rgba(8, 6, 16, .78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-radius: 999px;
    color: rgba(255, 255, 255, .90);
    font-family: inherit;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: .04em;
    cursor: pointer;
    text-decoration: none;
    transition: opacity .2s ease, transform .2s ease, background .15s ease, border-color .15s ease;
    box-shadow: 0 4px 18px rgba(0, 0, 0, .38);
    min-height: 40px;
    min-width: 40px;
    padding: 8px 16px;
    line-height: 1;
    user-select: none;
  }
  .vx-widget:hover {
    background: rgba(130, 220, 255, .13);
    border-color: rgba(130, 220, 255, .36);
    color: #fff;
  }

  /* Home button — bottom-left */
  .vx-home-btn {
    bottom: 22px;
    left: 22px;
    gap: 6px;
  }

  /* Back to top — bottom-right, hidden until scroll */
  .vx-backtop {
    bottom: 22px;
    right: 22px;
    font-size: 18px;
    padding: 8px 14px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
  }
  .vx-backtop.vx--visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  @media (max-width: 480px) {
    .vx-home-btn { bottom: 14px; left: 14px; font-size: 12px; padding: 7px 12px; }
    .vx-backtop  { bottom: 14px; right: 14px; }
  }
</style>

<script src="/js/page-widgets.js" defer></script>
