---
import LegalLayout from "../layouts/LegalLayout.astro";
import PlatformAssistStrip from "../components/PlatformAssistStrip.astro";
import { ROUTES } from "../data/routes";

const aboutAssistItems = [
  { href: ROUTES.products, label: { en: "Catalog", pt: "Catálogo" }, title: { en: "Browse products", pt: "Ver produtos" }, copy: { en: "Explore the products available today and find the right fit for your next step.", pt: "Explore os produtos disponíveis hoje e encontre o ideal para o seu próximo passo." }, emphasized: true },
  { href: ROUTES.support, label: { en: "Support", pt: "Suporte" }, title: { en: "Open support", pt: "Abrir suporte" }, copy: { en: "Use the operational lane for delivery, access and launch issues.", pt: "Use a faixa operacional para entrega, acesso e questões de lançamento." } },
  { href: ROUTES.contact, label: { en: "Sales", pt: "Vendas" }, title: { en: "Contact VOLYNX", pt: "Falar com a VOLYNX" }, copy: { en: "Use the commercial lane for new work, partnerships and business conversations.", pt: "Use a faixa comercial para novos projetos, parcerias e conversas de negócio." } },
  { href: ROUTES.daily, label: { en: "Workspace", pt: "Workspace" }, title: { en: "Open Daily", pt: "Abrir Daily" }, copy: { en: "Jump from the company story into the live daily workspace.", pt: "Pule da história da empresa direto para o workspace diário ao vivo." } },
];
---

<LegalLayout
  title="About • Volynx"
  description="Learn about Volynx, a digital ecosystem of tools, services and education."
>
  <div class="kicker" data-i18n="about.kicker">Company</div>
  <h1 data-i18n="about.title">About Volynx</h1>
  <p data-i18n="about.intro"><strong>Volynx is a digital ecosystem of tools, services and education</strong> focused on making technology more accessible—without unnecessary complexity.</p>

  <h2 data-i18n="about.build_title">What we build</h2>
  <ul>
    <li data-i18n="about.tools"><strong>Tools</strong> — practical utilities for creators and builders.</li>
    <li data-i18n="about.services"><strong>Services</strong> — design, implementation, and digital strategy.</li>
    <li data-i18n="about.education"><strong>Education</strong> — learning paths for developers and entrepreneurs.</li>
  </ul>

  <h2 data-i18n="about.p_title">Principles</h2>
  <ul>
    <li data-i18n="about.p1"><strong>Clarity over noise</strong> — the product must be understandable.</li>
    <li data-i18n="about.p2"><strong>Performance is trust</strong> — speed and reliability are part of the brand.</li>
    <li data-i18n="about.p3"><strong>Systems beat one-offs</strong> — consistency scales.</li>
  </ul>

  <PlatformAssistStrip eyebrow={{ en: "Practical path", pt: "Caminho prático" }} title={{ en: "The company story is useful. The next step should be obvious.", pt: "A história da empresa é útil. O próximo passo deve ser óbvio." }} description={{ en: "If you came here to understand VOLYNX, these are the fastest paths back into the real platform.", pt: "Se você veio entender a VOLYNX, esses são os caminhos mais rápidos de volta à plataforma real." }} items={aboutAssistItems} />

  <p class="meta" data-i18n="about.contact">For business inquiries: <a href={ROUTES.contact}>open contact</a> or <a href={ROUTES.support}>use support</a> if this is about access, delivery or launch help.</p>
</LegalLayout>
