---
import BaseLayout from "../layouts/BaseLayout.astro";
import VxHeader from "../components/VxHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
const title = "Pricing — VOLYNX";
const plans = [
  {
    name: "Free (Lab)",
    price: "£0",
    period: "/month",
    tagline: "Try the tools. No friction.",
    perks: [
      "Access to Volynx Lab tools",
      "Basic limits (fair use)",
      "Community updates",
    ],
    cta: { label: "Open Volynx Lab", href: "/volynx-lab/" },
    badge: "Starter",
  },
  {
    name: "Studio Pro",
    price: "£19",
    period: "/month",
    tagline: "The full suite. Faster workflows.",
    perks: [
      "All Studio tools (Pro)",
      "Higher limits + batch processing",
      "Priority updates",
      "Commercial usage",
    ],
    cta: { label: "Go Studio", href: "/volynx-lab/studio/" },
    badge: "Best value",
  },
  {
    name: "Teams",
    price: "£49",
    period: "/month",
    tagline: "Shared workflows for teams.",
    perks: [
      "Team seats",
      "Shared presets",
      "Central billing",
      "Support SLA (lightweight)",
    ],
    cta: { label: "Contact sales", href: "/contact/" },
    badge: "Scale",
  },
];

const faqs = [
  {
    q: "Is the Lab really free?",
    a: "Yes. Lab is for discovery and proof-of-value. Studio is where power users upgrade.",
  },
  {
    q: "How does billing work?",
    a: "Studio runs on a monthly subscription. Cancel anytime—no hostage contracts.",
  },
  {
    q: "Can I use Studio outputs commercially?",
    a: "Yes. Studio is designed for production use.",
  },
];
---

<BaseLayout title={title}>
  <VxHeader />

  <main class="shell pricing">
    <section class="hero">
      <h1>Pricing</h1>
      <p class="sub">
        Lab is your sandbox. Studio is your production pipeline.
      </p>
    </section>

    <section class="grid">
      {plans.map((p, i) => (
        <article class="card" data-plan-index={i}>
          <div class="card-top">
            <span class="badge">{p.badge}</span>
            <h2>{p.name}</h2>
            <div class="price">
              <span class="amount">{p.price}</span>
              <span class="period">{p.period}</span>
            </div>
            <p class="tagline">{p.tagline}</p>
          </div>

          <ul class="perks">
            {p.perks.map((x) => <li>{x}</li>)}
          </ul>

          <a class="btn" href={p.cta.href} data-plan-cta={i}>{p.cta.label}</a>
        </article>
      ))}
    </section>

    <section class="compare">
      <h2>What's included</h2>
      <p class="compare-sub">A clear breakdown so you know exactly what you're getting.</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th class="feature-col">Feature</th>
              <th>Free (Lab)</th>
              <th class="highlight-col">Studio Pro</th>
              <th>Teams</th>
            </tr>
          </thead>
          <tbody>
            <tr class="section-row"><td colspan="4">Tools</td></tr>
            <tr>
              <td>Image processing tools</td>
              <td>✓ Basic limits</td>
              <td class="highlight-col">✓ Unlimited</td>
              <td>✓ Unlimited</td>
            </tr>
            <tr>
              <td>QR code generator</td>
              <td>✓ Basic limits</td>
              <td class="highlight-col">✓ No limits</td>
              <td>✓ No limits</td>
            </tr>
            <tr>
              <td>File converter</td>
              <td>✓ Basic limits</td>
              <td class="highlight-col">✓ Batch mode</td>
              <td>✓ Batch mode</td>
            </tr>
            <tr>
              <td>Image Suite (Studio)</td>
              <td>—</td>
              <td class="highlight-col">✓ Full access</td>
              <td>✓ Full access</td>
            </tr>
            <tr class="section-row"><td colspan="4">Account &amp; Billing</td></tr>
            <tr>
              <td>Commercial usage rights</td>
              <td>—</td>
              <td class="highlight-col">✓</td>
              <td>✓</td>
            </tr>
            <tr>
              <td>Team seats</td>
              <td>—</td>
              <td class="highlight-col">—</td>
              <td>✓ Up to 10</td>
            </tr>
            <tr>
              <td>Central billing</td>
              <td>—</td>
              <td class="highlight-col">—</td>
              <td>✓</td>
            </tr>
            <tr>
              <td>Shared presets</td>
              <td>—</td>
              <td class="highlight-col">—</td>
              <td>✓</td>
            </tr>
            <tr class="section-row"><td colspan="4">Support</td></tr>
            <tr>
              <td>Community access</td>
              <td>✓</td>
              <td class="highlight-col">✓</td>
              <td>✓</td>
            </tr>
            <tr>
              <td>Priority updates</td>
              <td>—</td>
              <td class="highlight-col">✓</td>
              <td>✓</td>
            </tr>
            <tr>
              <td>Support SLA</td>
              <td>—</td>
              <td class="highlight-col">—</td>
              <td>✓ 48h response</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="faq">
      <h2>FAQ</h2>
      <div class="faq-grid">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter />

  <script is:inline type="module">
    // Plan index mapping: 0=free, 1=pro, 2=teams(enterprise)
    const planToIndex = { free: 0, pro: 1, enterprise: 2 };

    async function detectPlan() {
      const token = localStorage.getItem("volynx_access_token");
      const refresh = localStorage.getItem("volynx_refresh_token");
      if (!token || !refresh) return;

      let cfg;
      try { cfg = await fetch("/config.json", { cache: "no-store" }).then(r => r.json()); }
      catch { return; }

      const apiBase = (cfg.apiBaseUrl || "").replace(/\/$/, "");
      if (!apiBase) return;

      try {
        const res = await fetch(`${apiBase}/api/check-permission`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify({ tool: "converter" }),
        });
        if (!res.ok) return;
        const perm = await res.json();
        const plan = perm.plan || "free";
        if (perm.useLocalStorage) return; // no valid plan info

        const idx = planToIndex[plan];
        if (idx === undefined) return;

        // Mark the active plan card
        const card = document.querySelector(`[data-plan-index="${idx}"]`);
        if (!card) return;

        card.classList.add("card--current");

        // Replace badge
        const badge = card.querySelector(".badge");
        if (badge) {
          badge.textContent = "Your plan";
          badge.classList.add("badge--current");
        }

        // Replace CTA button
        const cta = document.querySelector(`[data-plan-cta="${idx}"]`);
        if (cta) {
          cta.textContent = "Current plan ✓";
          cta.classList.add("btn--current");
          cta.removeAttribute("href");
          cta.style.pointerEvents = "none";
        }

        // Mark table column header
        const colHeaders = document.querySelectorAll("thead th");
        if (colHeaders[idx + 1]) {
          const th = colHeaders[idx + 1];
          const marker = document.createElement("div");
          marker.textContent = "Your plan";
          marker.style.cssText = "font-size:9px;letter-spacing:.08em;margin-top:4px;color:#34D399;font-weight:700;";
          th.appendChild(marker);
        }
      } catch {}
    }

    detectPlan();
  </script>
</BaseLayout>

<style>
  @import "../styles/products2.css";
  @import "../styles/services.css";
  @import "../styles/legal.css";

  .pricing .hero { padding: 48px 0 22px; }
  .pricing .sub { max-width: 64ch; opacity: .85; }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 18px;
    margin: 24px 0 44px;
  }
  .card {
    grid-column: span 4;
    border-radius: 24px;
    padding: 22px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(10,12,20,.55);
    backdrop-filter: blur(12px);
  }
  .card-top h2 { margin: 10px 0 6px; }
  .badge {
    display: inline-flex; align-items: center;
    padding: 6px 10px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,.14);
    font-size: 12px; opacity: .9;
  }
  .price { display: flex; gap: 8px; align-items: baseline; margin: 10px 0 6px; }
  .amount { font-size: 40px; line-height: 1; font-weight: 700; }
  .period { opacity: .7; }
  .tagline { opacity: .85; margin-bottom: 14px; }
  .perks { list-style: none; padding: 0; margin: 14px 0 18px; }
  .perks li { padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,.06); opacity: .9; }
  .btn {
    display: inline-flex; justify-content: center; width: 100%;
    padding: 12px 14px; border-radius: 14px;
    border: 1px solid rgba(255,255,255,.12);
    text-decoration: none;
    transition: all .2s;
  }

  /* Current plan indicator */
  .card--current {
    border-color: rgba(52,211,153,.3);
    background: rgba(52,211,153,.04);
    box-shadow: 0 0 24px rgba(52,211,153,.06);
  }
  .badge--current {
    background: rgba(52,211,153,.12) !important;
    border-color: rgba(52,211,153,.35) !important;
    color: #34D399 !important;
    opacity: 1 !important;
  }
  .btn--current {
    background: rgba(52,211,153,.08);
    border-color: rgba(52,211,153,.25);
    color: #34D399;
    cursor: default;
    font-weight: 600;
  }

  /* Comparison table */
  .compare { padding: 16px 0 40px; }
  .compare h2 { margin-bottom: 6px; }
  .compare-sub { opacity: .7; font-size: 14px; margin-bottom: 22px; }

  .table-wrap {
    overflow-x: auto;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,.08);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  thead th {
    padding: 14px 18px;
    text-align: center;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    opacity: .6;
    border-bottom: 1px solid rgba(255,255,255,.07);
    background: rgba(10,12,20,.6);
    white-space: nowrap;
  }
  thead th.feature-col { text-align: left; }
  thead th.highlight-col {
    background: rgba(79,195,247,.06);
    color: #4fc3f7;
    opacity: 1;
    border-left: 1px solid rgba(79,195,247,.15);
    border-right: 1px solid rgba(79,195,247,.15);
  }

  tbody tr td {
    padding: 11px 18px;
    border-bottom: 1px solid rgba(255,255,255,.05);
    text-align: center;
    vertical-align: middle;
    opacity: .85;
  }
  tbody tr td:first-child { text-align: left; opacity: 1; }
  tbody tr td.highlight-col {
    background: rgba(79,195,247,.04);
    border-left: 1px solid rgba(79,195,247,.1);
    border-right: 1px solid rgba(79,195,247,.1);
    color: #e0f7ff;
  }
  tbody tr:hover td { background: rgba(255,255,255,.02); }
  tbody tr:last-child td { border-bottom: none; }

  tr.section-row td {
    padding: 10px 18px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    opacity: .4;
    background: rgba(255,255,255,.02);
    text-align: left !important;
    border-bottom: 1px solid rgba(255,255,255,.06);
    font-weight: 600;
  }

  .faq { padding: 18px 0 70px; }
  .faq-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 14px; margin-top: 14px; }
  .faq-item { grid-column: span 6; padding: 16px; border-radius: 18px;
    border: 1px solid rgba(255,255,255,.08); background: rgba(10,12,20,.35);
  }
  .faq-item summary { cursor: pointer; font-weight: 600; }
  .faq-item p { margin: 10px 0 0; opacity: .85; }

  @media (max-width: 980px) {
    .card { grid-column: span 6; }
    .faq-item { grid-column: span 12; }
  }
  @media (max-width: 640px) {
    .card { grid-column: span 12; }
  }
</style>