  <!-- Immediate checkout bridge: every money CTA gets a response even if later modules lag. -->
  <script is:inline>
    (function() {
      if (window.__vxPricingCheckoutBridge) return;
      window.__vxPricingCheckoutBridge = true;

      var PLAN_LOOKUP_PREFIX = {
        launch: 'builder_launch',
        pro: 'builder_pro',
        studio: 'builder_studio',
        teams: 'builder_teams',
        daily_pro: 'daily_pro',
        daily_diamond: 'daily_diamond'
      };
      var TOKEN_PACK_LOOKUP_PREFIX = {
        starter: 'tokens_starter',
        core: 'tokens_core',
        pro: 'tokens_pro',
        scale: 'tokens_scale'
      };
      var FREE_PLAN_HREFS = {
        free: '/builder/',
        daily_free: 'https://daily.volynx.world/'
      };
      var UI_TEXT = {
        en: {
          signIn: 'Sign in to continue to checkout...',
          checkoutNotConfigured: 'Checkout is not configured. Contact support.',
          checkoutFailed: 'Checkout failed. Please try again.',
          connectionError: 'Connection error. Please try again.',
          redirecting: 'Redirecting...',
          tryAgain: 'Try again'
        },
        pt: {
          signIn: 'Entre para continuar para o checkout...',
          checkoutNotConfigured: 'Checkout não configurado. Fale com o suporte.',
          checkoutFailed: 'O checkout falhou. Tente novamente.',
          connectionError: 'Erro de conexão. Tente novamente.',
          redirecting: 'Redirecionando...',
          tryAgain: 'Tentar novamente'
        }
      };

      var configPromise = null;

      function activeLang() {
        return String(localStorage.getItem('volynx_lang') || document.documentElement.lang || 'en').toLowerCase().startsWith('pt') ? 'pt' : 'en';
      }

      function t(key) {
        var lang = activeLang();
        return (UI_TEXT[lang] && UI_TEXT[lang][key]) || UI_TEXT.en[key] || key;
      }

      function toast(message, options) {
        if (typeof window.vxToast === 'function') {
          window.vxToast(message, options || {});
          return;
        }
        var el = document.getElementById('vxCheckoutToast');
        if (!el) {
          el = document.createElement('div');
          el.id = 'vxCheckoutToast';
          el.setAttribute('role', 'status');
          el.setAttribute('aria-live', 'polite');
          el.style.cssText = 'position:fixed;left:50%;bottom:28px;transform:translateX(-50%);max-width:min(560px,calc(100% - 32px));padding:14px 20px;border-radius:14px;border:1px solid rgba(45,212,191,.45);background:rgba(15,16,28,.96);color:#fff;font-size:14px;line-height:1.5;z-index:99999;box-shadow:0 22px 56px rgba(0,0,0,.5);';
          document.body.appendChild(el);
        }
        el.textContent = message;
        clearTimeout(el._t);
        el._t = setTimeout(function(){ el.remove(); }, (options && options.duration) || 4500);
      }

      function normalizeCurrency(value) {
        var code = String(value || 'GBP').toLowerCase();
        return ['gbp', 'eur', 'brl'].includes(code) ? code : 'gbp';
      }

      function getCheckoutCurrency() {
        var active = document.querySelector('[data-switch-currency].lcbar__pill--active');
        return normalizeCurrency(
          (active && active.dataset.switchCurrency) ||
          new URLSearchParams(window.location.search).get('currency') ||
          localStorage.getItem('volynx_currency') ||
          'GBP'
        );
      }

      function pricingUrl(options) {
        var url = new URL(window.location.href);
        if (options && 'payment' in options) {
          if (options.payment) url.searchParams.set('payment', options.payment);
          else url.searchParams.delete('payment');
        }
        if (options && 'hash' in options) {
          url.hash = options.hash ? '#' + String(options.hash).replace(/^#/, '') : '';
        }
        return url.toString();
      }

      function getConfig() {
        if (!configPromise) {
          configPromise = fetch('/config.json', { cache: 'no-store' })
            .then(function(r) { return r.ok ? r.json() : {}; })
            .catch(function() { return {}; });
        }
        return configPromise;
      }

      async function getFreshToken(cfg) {
        var token = localStorage.getItem('volynx_access_token') || '';
        var refreshToken = localStorage.getItem('volynx_refresh_token') || '';
        if (!token || !refreshToken || !cfg.supabaseUrl || !cfg.supabaseAnonKey) return token;
        try {
          var res = await fetch(cfg.supabaseUrl + '/auth/v1/token?grant_type=refresh_token', {
            method: 'POST',
            headers: { apikey: cfg.supabaseAnonKey, 'Content-Type': 'application/json' },
            body: JSON.stringify({ refresh_token: refreshToken })
          });
          if (!res.ok) return token;
          var session = await res.json();
          if (session.access_token) {
            localStorage.setItem('volynx_access_token', session.access_token);
            if (session.refresh_token) localStorage.setItem('volynx_refresh_token', session.refresh_token);
            return session.access_token;
          }
        } catch (_) {}
        return token;
      }

      function rememberButton(btn) {
        if (!btn.dataset.vxOriginalHtml) btn.dataset.vxOriginalHtml = btn.innerHTML;
      }

      function setBusy(btn) {
        rememberButton(btn);
        btn.innerHTML = t('redirecting');
        btn.setAttribute('aria-busy', 'true');
        btn.style.pointerEvents = 'none';
        if ('disabled' in btn) btn.disabled = true;
      }

      function resetButton(btn) {
        btn.innerHTML = btn.dataset.vxOriginalHtml || t('tryAgain');
        btn.removeAttribute('aria-busy');
        btn.style.pointerEvents = '';
        if ('disabled' in btn) btn.disabled = false;
      }

      function loginNext() {
        return '/login/?next=' + encodeURIComponent('/pricing/' + (window.location.hash || ''));
      }

      function resolveCheckout(target) {
        if (!target) return null;
        if (target.getAttribute('data-preview') === 'true') return null;

        if (target.id === 'cvitaeBusinessBtn') {
          return {
            lookupKey: 'cvitae_business_' + getCheckoutCurrency(),
            successUrl: window.location.origin + '/profile/?payment=success&product=cvitae_business',
            cancelUrl: pricingUrl({ payment: 'cancelled', hash: 'cvitae' })
          };
        }

        if (target.classList.contains('bundle-card__cta')) {
          var bundleKey = target.getAttribute('data-bundle-key');
          if (!bundleKey) return null;
          return {
            lookupKey: bundleKey + '_' + getCheckoutCurrency(),
            successUrl: window.location.origin + '/profile/?payment=success&product=bundle',
            cancelUrl: pricingUrl({ payment: 'cancelled', hash: 'bundles' })
          };
        }

        if (target.classList.contains('token-card__pix')) {
          var pixLookup = target.getAttribute('data-pix-pack');
          if (!pixLookup) return null;
          return {
            lookupKey: pixLookup,
            paymentMethod: 'pix',
            successUrl: window.location.origin + '/account/?payment=pix_success',
            cancelUrl: pricingUrl({ payment: 'cancelled', hash: 'vx' })
          };
        }

        if (target.classList.contains('token-card__cta')) {
          var tokenCard = target.closest('.token-card');
          var packId = tokenCard && tokenCard.getAttribute('data-pack-id');
          var packKey = TOKEN_PACK_LOOKUP_PREFIX[packId];
          if (!packKey) return null;
          return {
            lookupKey: packKey + '_' + getCheckoutCurrency(),
            successUrl: window.location.origin + '/profile/?payment=success&product=vx',
            cancelUrl: pricingUrl({ payment: 'cancelled', hash: 'vx' })
          };
        }

        if (target.matches('.addon-card__cta[data-addon-key]')) {
          var addonKey = target.getAttribute('data-addon-key');
          if (!addonKey) return null;
          return {
            lookupKey: addonKey + '_' + getCheckoutCurrency(),
            successUrl: window.location.origin + '/profile/?payment=success&product=addon',
            cancelUrl: pricingUrl({ payment: 'cancelled', hash: 'addons' })
          };
        }

        if (target.classList.contains('pricing-card__cta')) {
          var planCard = target.closest('.pricing-card');
          var planId = planCard && planCard.getAttribute('data-plan');
          var freeHref = FREE_PLAN_HREFS[planId];
          if (freeHref) return { href: freeHref };
          var prefix = PLAN_LOOKUP_PREFIX[planId];
          if (!prefix) return null;
          return {
            lookupKey: prefix + '_' + getCheckoutCurrency(),
            successUrl: window.location.origin + '/profile/?payment=success&product=' + encodeURIComponent(planId),
            cancelUrl: pricingUrl({ payment: 'cancelled', hash: planId && planId.startsWith('daily_') ? 'daily-plans' : 'plans' })
          };
        }

        return null;
      }

      async function startCheckout(target, checkout) {
        if (checkout.href) {
          window.location.href = checkout.href;
          return;
        }

        var cfg = await getConfig();
        var apiBase = String((cfg.functionsUrl || cfg.apiBaseUrl || '')).replace(/\/$/, '');
        var token = await getFreshToken(cfg);

        if (!token) {
          toast(t('signIn'), { type: 'success', duration: 1600 });
          setTimeout(function() { window.location.href = loginNext(); }, 550);
          return;
        }
        if (!apiBase) {
          toast(t('checkoutNotConfigured'));
          return;
        }

        setBusy(target);
        try {
          var body = {
            lookup_key: checkout.lookupKey,
            success_url: checkout.successUrl || window.location.origin + '/profile/?payment=success',
            cancel_url: checkout.cancelUrl || pricingUrl({ payment: 'cancelled' })
          };
          if (checkout.paymentMethod) body.payment_method = checkout.paymentMethod;

          var res = await fetch(apiBase + '/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify(body)
          });
          var data = await res.json().catch(function() { return {}; });
          if (res.status === 401) {
            toast(data.error || data.message || t('signIn'));
            setTimeout(function() { window.location.href = loginNext(); }, 700);
            return;
          }
          if (data.url) {
            window.location.href = data.url;
            return;
          }
          toast(data.error || data.msg || data.message || t('checkoutFailed'));
          resetButton(target);
        } catch (_) {
          toast(t('connectionError'));
          resetButton(target);
        }
      }

      document.addEventListener('click', function(event) {
        var target = event.target && event.target.closest
          ? event.target.closest('.pricing-card__cta, .bundle-card__cta, .token-card__cta, .token-card__pix, .addon-card__cta[data-addon-key], #cvitaeBusinessBtn')
          : null;
        var checkout = resolveCheckout(target);
        if (!checkout) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        startCheckout(target, checkout);
      }, true);
    })();
  </script>

  <!-- Checkout + Plan detection -->
  <script is:inline type="module">
    const PLAN_LOOKUP_PREFIX = {
      launch: 'builder_launch',
      pro: 'builder_pro',
      studio: 'builder_studio',
      teams: 'builder_teams',
      daily_pro: 'daily_pro',
      daily_diamond: 'daily_diamond',
    };
    const TOKEN_PACK_LOOKUP_PREFIX = {
      starter: 'tokens_starter',
      core: 'tokens_core',
      pro: 'tokens_pro',
      scale: 'tokens_scale',
    };
    const urlParams = new URLSearchParams(window.location.search);
    const uiLang = String(localStorage.getItem('volynx_lang') || document.documentElement.lang || '').toLowerCase().startsWith('pt') ? 'pt' : 'en';
    const UI_TEXT = {
      add: { en: 'Add', pt: 'Adicionar' },
      buy: { en: 'Buy', pt: 'Comprar' },
      checkoutFailed: { en: 'Checkout failed. Please try again.', pt: 'O checkout falhou. Tente novamente.' },
      checkoutNotConfigured: { en: 'Checkout not configured.', pt: 'Checkout não configurado.' },
      connectionError: { en: 'Connection error. Please check your network and try again.', pt: 'Erro de conexão. Verifique sua rede e tente novamente.' },
      currentPlan: { en: 'Current plan ✓', pt: 'Plano atual ✓' },
      manageSubscription: { en: 'Manage subscription', pt: 'Gerir assinatura' },
      openSubscriptionManagerError: { en: 'Could not open subscription manager.', pt: 'Não foi possível abrir o gestor da assinatura.' },
      opening: { en: 'Opening...', pt: 'Abrindo...' },
      redirecting: { en: 'Redirecting...', pt: 'Redirecionando...' },
      tryAgain: { en: 'Try again', pt: 'Tentar novamente' },
      yourPlan: { en: ' ✓ Your plan', pt: ' ✓ Seu plano' },
    };

    function uiText(key) {
      const entry = UI_TEXT[key];
      if (!entry) return key;
      return entry[uiLang] || entry.en;
    }

    function pricingUrl(options = {}) {
      const url = new URL(window.location.href);
      if ('payment' in options) {
        if (options.payment) url.searchParams.set('payment', options.payment);
        else url.searchParams.delete('payment');
      }
      if ('hash' in options) {
        url.hash = options.hash ? '#' + String(options.hash).replace(/^#/, '') : '';
      }
      return url.toString();
    }

    function clearPricingPaymentState() {
      history.replaceState({}, '', pricingUrl({ payment: '' }));
    }

    function openPortalSession(trigger, returnUrl) {
      trigger.textContent = uiText('opening');
      trigger.style.pointerEvents = 'none';
      return fetch(apiBase + '/create-portal-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
        body: JSON.stringify({ return_url: returnUrl }),
      })
        .then((portalRes) => portalRes.json())
        .then((portalData) => {
          if (portalData.url) {
            window.location.href = portalData.url;
            return;
          }
          vxToast(portalData.error || uiText('openSubscriptionManagerError'));
          trigger.textContent = uiText('manageSubscription');
          trigger.style.pointerEvents = '';
        })
        .catch(() => {
          vxToast(uiText('connectionError'));
          trigger.textContent = uiText('manageSubscription');
          trigger.style.pointerEvents = '';
        });
    }

    // Show cancelled banner if redirected from Stripe
    if (urlParams.get('payment') === 'cancelled') {
      const cb = document.getElementById('paymentCancelledBanner');
      if (cb) cb.style.display = '';
      clearPricingPaymentState();
    }
    const dismissCancelledBtn = document.getElementById('paymentCancelledDismiss');
    if (dismissCancelledBtn) {
      dismissCancelledBtn.addEventListener('click', () => {
        const banner = document.getElementById('paymentCancelledBanner');
        if (banner) banner.style.display = 'none';
      });
    }
    function normalizeCurrency(value) {
      const code = String(value || 'GBP').toLowerCase();
      return ['gbp', 'eur', 'brl'].includes(code) ? code : 'gbp';
    }

    function getCheckoutCurrency() {
      const active = document.querySelector('[data-switch-currency].lcbar__pill--active')?.dataset.switchCurrency;
      return normalizeCurrency(active || new URLSearchParams(window.location.search).get('currency') || localStorage.getItem('volynx_currency') || 'GBP');
    }

    let cfg = null;
    let token = localStorage.getItem('volynx_access_token') || '';
    const refreshToken = localStorage.getItem('volynx_refresh_token') || '';

    try { cfg = await fetch('/config.json', { cache: 'no-store' }).then(r => r.json()); } catch {}
    const apiBase = (cfg?.functionsUrl || cfg?.apiBaseUrl || '').replace(/\/$/, '');

    if (token && refreshToken && cfg?.supabaseUrl && cfg?.supabaseAnonKey) {
      try {
        const rr = await fetch(cfg.supabaseUrl + '/auth/v1/token?grant_type=refresh_token', {
          method: 'POST',
          headers: { apikey: cfg.supabaseAnonKey, 'Content-Type': 'application/json' },
          body: JSON.stringify({ refresh_token: refreshToken }),
        });
        if (rr.ok) {
          const sess = await rr.json();
          if (sess.access_token) {
            token = sess.access_token;
            localStorage.setItem('volynx_access_token', sess.access_token);
            if (sess.refresh_token) localStorage.setItem('volynx_refresh_token', sess.refresh_token);
          }
        }
      } catch {}
    }

    // Free / Daily Free plan CTAs route to the actual product instead of
    // dead-clicking. Without this the buttons looked clickable but did
    // nothing, which buyers (correctly) read as "broken".
    const FREE_PLAN_HREFS = {
      free: '/builder/',          // Builder Free → open Builder
      daily_free: 'https://daily.volynx.world/',
    };

    document.querySelectorAll('.pricing-card__cta').forEach((btn) => {
      if (btn.dataset.preview === 'true') return;
      const card = btn.closest('.pricing-card');
      const planId = card?.getAttribute('data-plan') || '';
      const freeHref = FREE_PLAN_HREFS[planId];
      if (freeHref) {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          window.location.href = freeHref;
        });
        return;
      }
      const lookupPrefix = PLAN_LOOKUP_PREFIX[planId];
      if (!lookupPrefix) return;
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        if (!token) { if (window.VxReturn) window.VxReturn.redirectToLogin(); else window.location.href = '/login/?next=/pricing/'; return; }
        if (!apiBase) { vxToast(uiText('checkoutNotConfigured')); return; }
        const lookupKey = lookupPrefix + '_' + getCheckoutCurrency();
        btn.textContent = uiText('redirecting');
        btn.style.pointerEvents = 'none';
        try {
          const res = await fetch(apiBase + '/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ lookup_key: lookupKey, success_url: window.location.origin + '/profile/?payment=success', cancel_url: pricingUrl({ payment: 'cancelled' }) }),
          });
          const data = await res.json();
          if (data.url) window.location.href = data.url;
          else { vxToast(data.error || data.msg || data.message || uiText('checkoutFailed')); btn.textContent = uiText('tryAgain'); btn.style.pointerEvents = ''; }
        } catch { vxToast(uiText('connectionError')); btn.textContent = uiText('tryAgain'); btn.style.pointerEvents = ''; }
      });
    });

    // ── Bundles: checkout via Stripe ──
    document.querySelectorAll('.bundle-card__cta').forEach(btn => {
      if (btn.dataset.preview === 'true') return;
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        if (!token) { if (window.VxReturn) window.VxReturn.redirectToLogin(); else window.location.href = '/login/?next=/pricing/'; return; }
        if (!apiBase) { vxToast(uiText('checkoutNotConfigured')); return; }
        const bundleKey = btn.getAttribute('data-bundle-key');
        if (!bundleKey) return;
        btn.textContent = uiText('redirecting');
        btn.style.pointerEvents = 'none';
        try {
          const res = await fetch(apiBase + '/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ lookup_key: bundleKey + '_' + getCheckoutCurrency(), success_url: window.location.origin + '/profile/?payment=success', cancel_url: pricingUrl({ payment: 'cancelled' }) }),
          });
          const data = await res.json();
          if (data.url) window.location.href = data.url;
          else { vxToast(data.error || data.msg || data.message || uiText('checkoutFailed')); btn.textContent = uiText('tryAgain'); btn.style.pointerEvents = ''; }
        } catch { vxToast(uiText('connectionError')); btn.textContent = uiText('tryAgain'); btn.style.pointerEvents = ''; }
      });
    });

    // ── Token pack: Stripe checkout (card) ──
    document.querySelectorAll('.token-card__cta').forEach((btn) => {
      if (btn.dataset.preview === 'true') return;
      const card = btn.closest('.token-card');
      const packId = card?.getAttribute('data-pack-id') || '';
      const packKey = TOKEN_PACK_LOOKUP_PREFIX[packId];
      if (!packKey) return;
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        if (!token) { if (window.VxReturn) window.VxReturn.redirectToLogin(); else window.location.href = '/login/?next=/pricing/'; return; }
        if (!apiBase) return;
        btn.textContent = uiText('redirecting');
        try {
          const res = await fetch(apiBase + '/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ lookup_key: packKey + '_' + getCheckoutCurrency() }),
          });
          const data = await res.json();
          if (data.url) window.location.href = data.url;
          else { vxToast(data.error || data.msg || data.message || uiText('checkoutFailed')); btn.textContent = uiText('buy'); }
        } catch { btn.textContent = uiText('buy'); }
      });
    });

    // ── Token pack: Pix checkout (BRL only) ──
    // Show Pix buttons only when currency is BRL and Stripe has enabled Pix.
    if (getCheckoutCurrency() === 'brl' && window.__volynxPixEnabled === true) {
      document.querySelectorAll('.token-card__pix').forEach(btn => {
        btn.style.display = 'flex';
      });
    }

    document.querySelectorAll('.token-card__pix').forEach(btn => {
      if (btn.dataset.preview === 'true') return;
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        if (window.__volynxPixEnabled !== true) return;
        if (!token) { if (window.VxReturn) window.VxReturn.redirectToLogin(); else window.location.href = '/login/?next=/pricing/'; return; }
        const packLookup = btn.getAttribute('data-pix-pack');
        if (!packLookup || !window.VxPix) return;
        window.VxPix.checkout(packLookup, {
          successUrl: window.location.origin + '/account/?payment=pix_success',
          cancelUrl: pricingUrl({ payment: 'cancelled' }),
        });
      });
    });

    // ── Add-ons: checkout via Stripe (only active addons have data-addon-key) ──
    document.querySelectorAll('.addon-card__cta[data-addon-key]').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (!token) { if (window.VxReturn) window.VxReturn.redirectToLogin(); else window.location.href = '/login/?next=/pricing/'; return; }
        if (!apiBase) return;
        const addonKey = btn.getAttribute('data-addon-key');
        if (!addonKey) return;
        const lookupKey = addonKey + '_' + getCheckoutCurrency();
        btn.textContent = uiText('redirecting');
        btn.style.pointerEvents = 'none';
        try {
          const res = await fetch(apiBase + '/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ lookup_key: lookupKey }),
          });
          const data = await res.json();
          if (data.url) window.location.href = data.url;
          else { vxToast(data.error || uiText('checkoutFailed')); btn.textContent = uiText('add'); btn.style.pointerEvents = ''; }
        } catch { btn.textContent = uiText('add'); btn.style.pointerEvents = ''; }
      });
    });

    // Clicking the card itself also triggers the active checkout button (no-op on manual / coming_soon).
    document.querySelectorAll('.addon-card').forEach(card => {
      card.addEventListener('click', (e) => {
        if (e.target.closest('.addon-card__cta')) return;
        const btn = card.querySelector('.addon-card__cta[data-addon-key]');
        if (btn) btn.click();
      });
    });

    const cvitaeBusinessBtn = document.getElementById('cvitaeBusinessBtn');
    if (cvitaeBusinessBtn) {
      cvitaeBusinessBtn.addEventListener('click', async () => {
        if (!token) { if (window.VxReturn) window.VxReturn.redirectToLogin(); else window.location.href = '/login/?next=/pricing/#cvitae'; return; }
        if (!apiBase) { vxToast(uiText('checkoutNotConfigured')); return; }
        cvitaeBusinessBtn.textContent = uiText('redirecting');
        cvitaeBusinessBtn.style.pointerEvents = 'none';
        try {
          const res = await fetch(apiBase + '/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({
              lookup_key: 'cvitae_business_' + getCheckoutCurrency(),
              success_url: window.location.origin + '/profile/?payment=success&product=cvitae_business',
              cancel_url: pricingUrl({ payment: 'cancelled', hash: 'cvitae' }),
            }),
          });
          const data = await res.json();
          if (data.url) window.location.href = data.url;
          else {
            vxToast(data.error || data.msg || data.message || uiText('checkoutFailed'));
            cvitaeBusinessBtn.textContent = uiText('tryAgain');
            cvitaeBusinessBtn.style.pointerEvents = '';
          }
        } catch {
          vxToast(uiText('connectionError'));
          cvitaeBusinessBtn.textContent = uiText('tryAgain');
          cvitaeBusinessBtn.style.pointerEvents = '';
        }
      });
    }

    if (token && apiBase) {
      try {
        const res = await fetch(apiBase + '/check-permission', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
          body: JSON.stringify({ tool: 'converter' }),
        });
        if (res.ok) {
          const perm = await res.json();
          if (!perm.useLocalStorage) {
            const currentPlanIds = new Set();
            const builderPlan = (perm.builder_plan || perm.builderPlan || perm.plan || 'free').toLowerCase();
            const dailyPlan = (perm.daily_plan || perm.dailyPlan || 'free').toLowerCase();
            const cvitaePlan = (perm.cvitae_plan || 'free').toLowerCase();
            currentPlanIds.add(builderPlan === 'free' ? 'free' : builderPlan);
            if (dailyPlan !== 'free') currentPlanIds.add('daily_' + dailyPlan);

            document.querySelectorAll('.pricing-card').forEach((card) => {
              const planId = card.getAttribute('data-plan') || '';
              if (!currentPlanIds.has(planId)) return;

              card.style.borderColor = 'rgba(52,211,153,.35)';
              card.style.boxShadow = '0 0 24px rgba(52,211,153,.08)';
              const name = card.querySelector('.pricing-card__name');
              if (name && !name.querySelector('.pricing-card__owned')) {
                const b = document.createElement('span');
                b.className = 'pricing-card__owned';
                b.textContent = uiText('yourPlan');
                b.style.cssText = 'font-size:12px;color:#34D399;font-weight:700;';
                name.appendChild(b);
              }
              const cta = card.querySelector('.pricing-card__cta');
              if (cta && planId !== 'free' && planId !== 'daily_free') {
                cta.textContent = uiText('currentPlan');
                cta.style.cssText = 'background:rgba(52,211,153,.08);border-color:rgba(52,211,153,.25);color:#34D399;pointer-events:none;display:flex;justify-content:center;padding:12px;border-radius:14px;text-decoration:none;font-weight:600;font-size:14px;';

                // Add "Manage subscription" link below the current plan CTA
                if (!cta.parentElement.querySelector('.pricing-card__manage')) {
                  const manageBtn = document.createElement('button');
                  manageBtn.textContent = uiText('manageSubscription');
                  manageBtn.className = 'pricing-card__manage';
                  manageBtn.style.cssText = 'display:flex;align-items:center;justify-content:center;width:100%;padding:10px;margin-top:8px;border-radius:12px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.03);color:rgba(255,255,255,.5);font-size:13px;font-weight:500;cursor:pointer;transition:all .2s;';
                  manageBtn.onmouseenter = () => { manageBtn.style.background = 'rgba(255,80,80,.06)'; manageBtn.style.borderColor = 'rgba(255,80,80,.2)'; manageBtn.style.color = 'rgba(255,120,120,.8)'; };
                  manageBtn.onmouseleave = () => { manageBtn.style.background = 'rgba(255,255,255,.03)'; manageBtn.style.borderColor = 'rgba(255,255,255,.08)'; manageBtn.style.color = 'rgba(255,255,255,.5)'; };
                  manageBtn.addEventListener('click', () => openPortalSession(manageBtn, pricingUrl({ payment: '' })));
                  cta.parentElement.appendChild(manageBtn);
                }
              }
            });

            if (cvitaePlan === 'business' && cvitaeBusinessBtn) {
              cvitaeBusinessBtn.textContent = uiText('currentPlan');
              cvitaeBusinessBtn.style.pointerEvents = 'none';
              cvitaeBusinessBtn.classList.remove('button--gold');
              cvitaeBusinessBtn.classList.add('button--ghost');
              cvitaeBusinessBtn.style.borderColor = 'rgba(52,211,153,.25)';
              cvitaeBusinessBtn.style.color = '#34D399';
              cvitaeBusinessBtn.style.background = 'rgba(52,211,153,.08)';

              const actions = cvitaeBusinessBtn.parentElement;
              if (actions && !actions.querySelector('.cvitae-manage-btn')) {
                const manageBtn = document.createElement('button');
                manageBtn.type = 'button';
                manageBtn.className = 'button button--ghost cvitae-manage-btn';
                manageBtn.textContent = uiText('manageSubscription');
                manageBtn.addEventListener('click', () => openPortalSession(manageBtn, pricingUrl({ payment: '', hash: 'cvitae' })));
                actions.appendChild(manageBtn);
              }
            }
          }
        }
      } catch {}
    }
  </script>
  <script is:inline src="/scripts/kit-checkout.js" defer></script>
</FlagshipLayout>
