    /* Trust block */
    .trust-block { max-width:860px; margin:40px auto 0; display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:10px; padding:20px; border-radius:16px; border:1px solid rgba(255,255,255,.06); background:rgba(255,255,255,.02); }
