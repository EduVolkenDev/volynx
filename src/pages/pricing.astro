---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../components/FlagshipHeader.astro";
import FlagshipFooter from "../components/FlagshipFooter.astro";
import PricingCard from "../components/pricing/PricingCard.astro";
import TokenPackCard from "../components/pricing/TokenPackCard.astro";
import ToolUsageCard from "../components/pricing/ToolUsageCard.astro";
import AddonCard from "../components/pricing/AddonCard.astro";
import LocaleCurrencyBar from "../components/pricing/LocaleCurrencyBar.astro";
import { sitePricing } from "../data/pricing";
import { ROUTES } from "../data/routes";

const lang = Astro.url.searchParams.get('lang') === 'pt' ? 'pt' : 'en';
const currencyParam = Astro.url.searchParams.get('currency') || '';
const currency = (['GBP', 'EUR', 'BRL'] as const).includes(currencyParam as any) ? currencyParam as 'GBP'|'EUR'|'BRL' : 'GBP';

const faqs = [
  { q: { en: "Is the Lab really free?", pt: "O Lab é realmente grátis?" }, a: { en: "Yes. Lab is for discovery and proof-of-value. Studio and Builder are where power users upgrade.", pt: "Sim. O Lab é para descoberta. Studio e Builder são onde usuários avançados fazem upgrade." } },
  { q: { en: "How do tokens work?", pt: "Como funcionam os tokens?" }, a: { en: "Each tool action costs tokens based on complexity. Buy packs anytime — they never expire.", pt: "Cada ação consome tokens baseado na complexidade. Compre packs quando quiser — não expiram." } },
  { q: { en: "Can I use outputs commercially?", pt: "Posso usar comercialmente?" }, a: { en: "Yes. All paid Builder plans include commercial usage rights. Studio Pro tools are included with the Builder Studio plan.", pt: "Sim. Todos os planos pagos do Builder incluem direitos de uso comercial. Ferramentas Studio Pro estão incluídas no plano Builder Studio." } },
  { q: { en: "Can I switch plans anytime?", pt: "Posso trocar de plano?" }, a: { en: "Yes. Upgrade, downgrade or cancel at any time from your dashboard.", pt: "Sim. Faça upgrade, downgrade ou cancele a qualquer momento pelo dashboard." } },
];
---
<FlagshipLayout title="Pricing — VOLYNX" pageClass="page-pricing">
  <FlagshipHeader current={ROUTES.pricing} ctaLabel="Go Pro" />
  <main>

    <!-- ═══ PAYMENT CANCELLED BANNER ═══ -->
    <div id="paymentCancelledBanner" style="display:none;max-width:720px;margin:24px auto 0;padding:16px 20px;border-radius:14px;background:rgba(255,180,0,.06);border:1px solid rgba(255,180,0,.2);font-size:14px;color:#e0e0e0;backdrop-filter:blur(12px);text-align:center;">
      <span style="margin-right:12px;" data-i18n="price.payment_cancelled">Payment was cancelled. You can try again anytime.</span>
      <button type="button" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:13px;text-decoration:underline;" data-i18n="price.dismiss" onclick="this.closest('div').style.display='none';history.replaceState({},'','/pricing/');">Dismiss</button>
    </div>

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="kicker" data-i18n="price.hero_kicker">Pricing logic</span>
          <h1 data-i18n="price.hero_title">Separate discovery from production with premium logic.</h1>
          <p data-i18n="price.hero_desc">Builder Free builds trust. Pro removes friction. Studio and Teams add operational power. Premium features that elevate your work, not just more capacity.</p>
          <div class="hero-actions">
            <a href="#plans" class="button button--gold" data-i18n="price.hero_cta1">View plans</a>
            <a href={ROUTES.lab} class="button button--ghost" data-i18n="price.hero_cta2">Open the Lab</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ LOCALE / CURRENCY BAR ═══ -->
    <section class="page-section" style="padding-top:32px;">
      <div class="shell">
        <LocaleCurrencyBar locale={lang} currency={currency} />
      </div>
    </section>

    <!-- ═══ PLANS ═══ -->
    <section id="plans" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow">{lang === 'pt' ? 'Planos do Builder' : 'Builder Plans'}</span>
        <h2>{lang === 'pt' ? 'Planos prontos para venda' : 'Plans ready to sell'}</h2>
      </div>
      <div class="shell pricing-grid pricing-grid--plans">
        {sitePricing.builderPlans.map((plan) => (
          <PricingCard plan={plan} locale={lang} currency={currency} />
        ))}
      </div>
    </section>

    <!-- ═══ WHAT PRO FEELS LIKE ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <h2 data-i18n="price.pro_section_title">What Pro actually feels like</h2>
        <p data-i18n="price.pro_section_desc">Pro is about working smarter, faster, and with more control over your output.</p>
      </div>
      <div class="shell comparison">
        <div class="comparison-row"><strong data-i18n="price.comp_memory">Workflow memory</strong><span class="check" data-i18n="price.comp_free_memory">No memory</span><span class="check pro" data-i18n="price.comp_pro_memory">Presets, history, reusable recipes</span></div>
        <div class="comparison-row"><strong data-i18n="price.comp_quality">Output quality</strong><span class="check" data-i18n="price.comp_free_quality">Basic modes</span><span class="check pro" data-i18n="price.comp_pro_quality">Premium modes, stronger exports</span></div>
        <div class="comparison-row"><strong data-i18n="price.comp_speed">Comfort and speed</strong><span class="check" data-i18n="price.comp_free_speed">Manual repetition</span><span class="check pro" data-i18n="price.comp_pro_speed">Queues, defaults, faster decision loops</span></div>
        <div class="comparison-row"><strong data-i18n="price.comp_status">Status</strong><span class="check" data-i18n="price.comp_free_status">Discovery mode</span><span class="check pro" data-i18n="price.comp_pro_status">Pro workspace and priority access</span></div>
      </div>
    </section>

    <!-- ═══ TOKEN PACKS ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow">{lang === 'pt' ? 'Packs de tokens' : 'Token Packs'}</span>
        <h2>{lang === 'pt' ? 'Compre tokens avulsos' : 'Buy token packs'}</h2>
      </div>
      <div class="shell grid-2">
        {sitePricing.tokenPacks.map((pack) => (
          <TokenPackCard pack={pack} locale={lang} currency={currency} />
        ))}
      </div>
    </section>

    <!-- ═══ USAGE MATRIX ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow">{lang === 'pt' ? 'Matriz de uso' : 'Usage Matrix'}</span>
        <h2>{lang === 'pt' ? 'Custo por tipo de ação' : 'Cost per action type'}</h2>
      </div>
      <div class="shell grid-3">
        {sitePricing.toolUsage.map((item) => (
          <ToolUsageCard item={item} locale={lang} currency={currency} />
        ))}
      </div>
    </section>

    <!-- ═══ ADD-ONS ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow">Add-ons</span>
        <h2>{lang === 'pt' ? 'Extras para aumentar valor' : 'Extras to boost value'}</h2>
      </div>
      <div class="shell grid-3">
        {sitePricing.builderAddons.map((addon) => (
          <AddonCard addon={addon} locale={lang} currency={currency} />
        ))}
      </div>
    </section>

    <!-- ═══ FAQ ═══ -->
    <section class="page-section page-section--last">
      <div class="shell section-head">
        <span class="eyebrow">FAQ</span>
        <h2>{lang === 'pt' ? 'Perguntas frequentes' : 'Frequently asked questions'}</h2>
      </div>
      <div class="shell grid-2">
        {faqs.map((f) => (
          <details class="panel" style="cursor:pointer;">
            <summary style="font-weight:700;font-size:15px;list-style:none;">{f.q[lang]}</summary>
            <p style="margin:10px 0 0;color:var(--muted);line-height:1.7;">{f.a[lang]}</p>
          </details>
        ))}
      </div>
    </section>

  </main>
  <FlagshipFooter />

  <!-- Checkout + Plan detection (preserved from existing) -->
  <script is:inline type="module">
    const PLAN_KEYS = ['free', 'launch', 'pro', 'studio', 'teams'];
    const urlParams = new URLSearchParams(window.location.search);

    // Show cancelled banner if redirected from Stripe
    if (urlParams.get('payment') === 'cancelled') {
      const cb = document.getElementById('paymentCancelledBanner');
      if (cb) cb.style.display = '';
    }
    const currency = (urlParams.get('currency') || 'GBP').toLowerCase();

    let cfg = null;
    let token = localStorage.getItem('volynx_access_token') || '';
    const refreshToken = localStorage.getItem('volynx_refresh_token') || '';

    try { cfg = await fetch('/config.json', { cache: 'no-store' }).then(r => r.json()); } catch {}
    const apiBase = (cfg?.functionsUrl || cfg?.apiBaseUrl || '').replace(/\/$/, '');

    if (token && refreshToken && cfg?.supabaseUrl && cfg?.supabaseAnonKey) {
      try {
        const rr = await fetch(cfg.supabaseUrl + '/auth/v1/token?grant_type=refresh_token', {
          method: 'POST',
          headers: { apikey: cfg.supabaseAnonKey, 'Content-Type': 'application/json' },
          body: JSON.stringify({ refresh_token: refreshToken }),
        });
        if (rr.ok) {
          const sess = await rr.json();
          if (sess.access_token) {
            token = sess.access_token;
            localStorage.setItem('volynx_access_token', sess.access_token);
            if (sess.refresh_token) localStorage.setItem('volynx_refresh_token', sess.refresh_token);
          }
        }
      } catch {}
    }

    document.querySelectorAll('.pricing-card__cta').forEach((btn, idx) => {
      const planKey = PLAN_KEYS[idx];
      if (planKey === 'free') return;
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        if (!token) { window.location.href = '/login/?next=/pricing/'; return; }
        if (!apiBase) { alert('Checkout not configured.'); return; }
        const lookupKey = planKey === 'teams' ? 'builder_teams_' + currency : 'builder_' + planKey + '_' + currency;
        btn.textContent = 'Redirecting...';
        btn.style.pointerEvents = 'none';
        try {
          const res = await fetch(apiBase + '/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ lookup_key: lookupKey, success_url: window.location.origin + '/profile/?payment=success', cancel_url: window.location.origin + '/pricing/?payment=cancelled' }),
          });
          const data = await res.json();
          if (data.url) window.location.href = data.url;
          else { alert(data.error || data.msg || data.message || 'Checkout failed. Please try again.'); btn.textContent = 'Try again'; btn.style.pointerEvents = ''; }
        } catch { alert('Connection error. Please check your network and try again.'); btn.textContent = 'Try again'; btn.style.pointerEvents = ''; }
      });
    });

    document.querySelectorAll('.token-card__cta').forEach((btn, idx) => {
      const packKeys = ['tokens_starter', 'tokens_core', 'tokens_pro', 'tokens_scale'];
      const packKey = packKeys[idx];
      if (!packKey) return;
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        if (!token) { window.location.href = '/login/?next=/pricing/'; return; }
        if (!apiBase) return;
        btn.textContent = 'Redirecting...';
        try {
          const res = await fetch(apiBase + '/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ lookup_key: packKey + '_' + currency }),
          });
          const data = await res.json();
          if (data.url) window.location.href = data.url;
          else { alert(data.error || data.msg || data.message || 'Checkout failed. Please try again.'); btn.textContent = 'Buy'; }
        } catch { btn.textContent = 'Buy'; }
      });
    });

    if (token && apiBase) {
      try {
        const res = await fetch(apiBase + '/check-permission', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
          body: JSON.stringify({ tool: 'converter' }),
        });
        if (res.ok) {
          const perm = await res.json();
          const plan = perm.builder_plan || perm.builderPlan || perm.plan || 'free';
          if (!perm.useLocalStorage) {
            const cards = document.querySelectorAll('.pricing-card');
            const idx = PLAN_KEYS.indexOf(plan);
            if (idx >= 0 && cards[idx]) {
              cards[idx].style.borderColor = 'rgba(52,211,153,.35)';
              cards[idx].style.boxShadow = '0 0 24px rgba(52,211,153,.08)';
              const name = cards[idx].querySelector('.pricing-card__name');
              if (name) { const b = document.createElement('span'); b.textContent = ' ✓ Your plan'; b.style.cssText = 'font-size:12px;color:#34D399;font-weight:700;'; name.appendChild(b); }
              const cta = cards[idx].querySelector('.pricing-card__cta');
              if (cta && plan !== 'free') {
                cta.textContent = 'Current plan ✓';
                cta.style.cssText = 'background:rgba(52,211,153,.08);border-color:rgba(52,211,153,.25);color:#34D399;pointer-events:none;display:flex;justify-content:center;padding:12px;border-radius:14px;text-decoration:none;font-weight:600;font-size:14px;';

                // Add "Manage subscription" link below the current plan CTA
                const manageBtn = document.createElement('button');
                manageBtn.textContent = 'Manage subscription';
                manageBtn.className = 'pricing-card__manage';
                manageBtn.style.cssText = 'display:flex;align-items:center;justify-content:center;width:100%;padding:10px;margin-top:8px;border-radius:12px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.03);color:rgba(255,255,255,.5);font-size:13px;font-weight:500;cursor:pointer;transition:all .2s;';
                manageBtn.onmouseenter = () => { manageBtn.style.background = 'rgba(255,80,80,.06)'; manageBtn.style.borderColor = 'rgba(255,80,80,.2)'; manageBtn.style.color = 'rgba(255,120,120,.8)'; };
                manageBtn.onmouseleave = () => { manageBtn.style.background = 'rgba(255,255,255,.03)'; manageBtn.style.borderColor = 'rgba(255,255,255,.08)'; manageBtn.style.color = 'rgba(255,255,255,.5)'; };
                manageBtn.addEventListener('click', async () => {
                  manageBtn.textContent = 'Opening...';
                  manageBtn.style.pointerEvents = 'none';
                  try {
                    const portalRes = await fetch(apiBase + '/create-portal-session', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
                      body: JSON.stringify({ return_url: window.location.origin + '/pricing/' }),
                    });
                    const portalData = await portalRes.json();
                    if (portalData.url) window.location.href = portalData.url;
                    else { alert(portalData.error || 'Could not open subscription manager.'); manageBtn.textContent = 'Manage subscription'; manageBtn.style.pointerEvents = ''; }
                  } catch { alert('Connection error.'); manageBtn.textContent = 'Manage subscription'; manageBtn.style.pointerEvents = ''; }
                });
                cta.parentElement.appendChild(manageBtn);
              } else if (cta && plan === 'free') {
                // Free plan - no change needed
              }
            }
          }
        }
      } catch {}
    }
  </script>
</FlagshipLayout>
