---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../components/FlagshipHeader.astro";
import FlagshipFooter from "../components/FlagshipFooter.astro";
import PricingCard from "../components/pricing/PricingCard.astro";
import TokenPackCard from "../components/pricing/TokenPackCard.astro";
import ToolUsageCard from "../components/pricing/ToolUsageCard.astro";
import AddonCard from "../components/pricing/AddonCard.astro";
import PlatformAssistStrip from "../components/PlatformAssistStrip.astro";
import { sitePricing } from "../data/pricing";
import { ROUTES, productPreviewHref } from "../data/routes";

const lang = Astro.url.searchParams.get('lang') === 'pt' ? 'pt' : 'en';
const currencyParam = Astro.url.searchParams.get('currency') || '';
const currency = (['GBP', 'EUR', 'BRL'] as const).includes(currencyParam as any) ? currencyParam as 'GBP'|'EUR'|'BRL' : 'GBP';

const faqs = [
  { qKey: "price.faq_q1", aKey: "price.faq_a1", qFallback: "How does VOLYNX pricing work?", aFallback: "Plans unlock access to product features. VX adds premium usage for selected actions, while bundles save money when you use more than one product." },
  { qKey: "price.faq_q2", aKey: "price.faq_a2", qFallback: "What is VX?", aFallback: "VX is premium usage inside VOLYNX. Buy once and use it where the product explicitly supports VX, such as CVitae exports/templates and selected Studio actions. VX never expires." },
  { qKey: "price.faq_q3", aKey: "price.faq_a3", qFallback: "Can I use VX across different products?", aFallback: "Yes, wherever the product says VX is available. Product subscriptions and one-time purchases are shown separately on their product pages." },
  { qKey: "price.faq_q4", aKey: "price.faq_a4", qFallback: "Do I need a subscription to export from CVitae?", aFallback: "No. CVitae is free to build, preview, and improve with AI. Use 2 VX for a clean PDF export or unlock premium templates with VX. Business is optional for professionals who need unlimited exports and templates." },
  { qKey: "price.faq_q5", aKey: "price.faq_a5", qFallback: "How do bundles work?", aFallback: "Bundles combine two or more VOLYNX products into a single subscription at a combined lower price. Access updates automatically across all included products." },
  { qKey: "price.faq_q6", aKey: "price.faq_a6", qFallback: "What's the difference between a plan and a VX pack?", aFallback: "A plan is a recurring subscription that unlocks ongoing access. A VX pack is a one-time purchase that adds premium usage for selected features. Use them separately or together." },
  { qKey: "price.faq_q7", aKey: "price.faq_a7", qFallback: "Can I change or cancel my plan anytime?", aFallback: "Yes. Upgrade, downgrade or cancel from your account dashboard. Billing adjusts automatically." },
  { qKey: "price.faq_q8", aKey: "price.faq_a8", qFallback: "Can I buy extra VX without changing my plan?", aFallback: "Yes. VX packs add premium usage to your account without changing your subscription." },
];

const bundleLookupById = {
  bundle_essential: 'bundle_volynx_daily_pro',
  bundle_complete: 'bundle_volynx_daily_studio',
} as Record<string, string>;

const pricingAssistItems = [
  { href: ROUTES.products, label: { en: "Catalog", pt: "Catálogo" }, title: { en: "Browse products", pt: "Ver produtos" }, copy: { en: "Go back to kits, tools and product pages while comparing plans.", pt: "Volte para kits, ferramentas e páginas de produto enquanto compara planos." }, emphasized: true, iconSrc: "/assets/allproducts.webp" },
  { href: ROUTES.delivery, label: { en: "Post-purchase", pt: "Pós-compra" }, title: { en: "My products", pt: "Meus produtos" }, copy: { en: "If checkout already happened, reopen delivery and access instead of staying stuck in pricing.", pt: "Se a compra já aconteceu, reabra entrega e acesso em vez de ficar preso nos preços." }, iconSrc: "/assets/mybox.webp" },
  { href: ROUTES.support, label: { en: "Support", pt: "Suporte" }, title: { en: "Open support", pt: "Abrir suporte" }, copy: { en: "Get help with billing, launch and access questions tied to a purchase.", pt: "Receba ajuda com questões de cobrança, lançamento e acesso ligadas a uma compra." }, iconSrc: "/assets/support.webp" },
  { href: ROUTES.daily, label: { en: "Daily", pt: "Daily" }, title: { en: "See Daily live", pt: "Ver Daily ao vivo" }, copy: { en: "See how Daily brings planning, notes and decisions together.", pt: "Veja como o Daily reúne planejamento, notas e decisões." }, iconSrc: "/assets/daily-icon.webp" },
];
---
<FlagshipLayout title="Pricing — VOLYNX" pageClass="page-pricing">
  <FlagshipHeader current={ROUTES.pricing} ctaLabel="Go Pro" ctaI18n="nav.go_pro" />
  <main>

    <!-- ═══ PAYMENT CANCELLED BANNER ═══ -->
    <div id="paymentCancelledBanner" style="display:none;max-width:720px;margin:24px auto 0;padding:16px 20px;border-radius:14px;background:rgba(255,180,0,.06);border:1px solid rgba(255,180,0,.2);font-size:14px;color:#e0e0e0;backdrop-filter:blur(12px);text-align:center;">
      <span style="margin-right:12px;" data-i18n="price.payment_cancelled">Payment was cancelled. You can try again anytime.</span>
      <button type="button" id="paymentCancelledDismiss" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:13px;text-decoration:underline;" data-i18n="price.dismiss">Dismiss</button>
    </div>

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="shell hero-grid hero-grid--pricing">
        <div class="hero-copy">
          <span class="kicker" data-i18n="price.hero_kicker">Ecosystem pricing</span>
          <h1 class="vx-hero-shimmer" data-i18n="price.hero_title">One ecosystem. Clear pricing. More power when you need it.</h1>
          <p data-i18n="price.hero_desc">Choose what you use, combine products to save, or add VX for selected premium actions. One account. One connected experience.</p>
          <p class="hero-subcopy"><span class="i18n-en">VOLYNX connects Builder, Daily, and CVitae into one unified experience. Plans unlock product access. VX covers enabled add-ons like CVitae exports/templates and selected Studio actions.</span><span class="i18n-pt">A VOLYNX une Builder, Daily e CVitae em uma experiência única. Planos liberam acesso aos produtos. VX cobre complementos habilitados, como exportações e modelos do CVitae, além de ações Studio selecionadas.</span></p>
          <div class="hero-actions">
            <a href="#plans" class="button button--gold" data-i18n="price.hero_cta1">View plans</a>
            <a href={ROUTES.lab} class="button button--ghost" data-i18n="price.hero_cta2">Open the Lab</a>
          </div>
        </div>
        <div class="hero-visual hero-visual--float pricing-hero-visual" aria-hidden="true">
          <img src="/assets/pricing.webp" alt="" class="pricing-hero-icon" width="842" height="1264" loading="eager" />
        </div>
      </div>
    </section>

    <PlatformAssistStrip eyebrow={{ en: "Decision support", pt: "Apoio à decisão" }} title={{ en: "Pricing is one step, not the whole journey.", pt: "Pricing é um passo, não a jornada inteira." }} description={{ en: "Compare plans, bundles and VX with the products and support you may need next.", pt: "Compare planos, bundles e VX com os produtos e o suporte de que você pode precisar depois." }} items={pricingAssistItems} />

    <!-- ═══ FASTEST PAID PATHS ═══ -->
    <section class="page-section revenue-funnel-section" aria-label="Fastest VOLYNX paid paths">
      <div class="shell revenue-funnel">
        <div class="revenue-funnel__intro">
          <span class="eyebrow"><span class="i18n-en">Start monetizing the ecosystem</span><span class="i18n-pt">Comece pelo caminho monetizável</span></span>
          <h2><span class="i18n-en">If you want the shortest path to value, choose one of these.</span><span class="i18n-pt">Se você quer o caminho mais curto para valor, escolha um destes.</span></h2>
          <p><span class="i18n-en">These options are available now, with clear pricing and a direct next step.</span><span class="i18n-pt">Estas opções estão disponíveis agora, com preços claros e um próximo passo direto.</span></p>
        </div>

        <div class="revenue-funnel__cards">
          <a href={productPreviewHref("bundle_volynx_daily_pro")} class="revenue-funnel-card revenue-funnel-card--featured">
            <span class="revenue-funnel-card__badge"><span class="i18n-en">Best recurring path</span><span class="i18n-pt">Melhor recorrência</span></span>
            <img src="/assets/bundle.webp" alt="" loading="lazy" decoding="async" />
            <strong>VOLYNX Essential</strong>
            <small>Builder Pro + Daily Pro</small>
            <p><span class="i18n-en">The cleanest subscription for creators who need publishing plus daily execution.</span><span class="i18n-pt">A assinatura mais clara para criadores que precisam publicar e executar todos os dias.</span></p>
            <span class="revenue-funnel-card__price">£35 / month</span>
            <span class="revenue-funnel-card__cta"><span class="i18n-en">View Essential</span><span class="i18n-pt">Ver Essential</span> →</span>
          </a>

          <a href={productPreviewHref("builder_pro")} class="revenue-funnel-card">
            <span class="revenue-funnel-card__badge"><span class="i18n-en">Publish sites</span><span class="i18n-pt">Publicar sites</span></span>
            <img src="/assets/builderpro.webp" alt="" loading="lazy" decoding="async" />
            <strong>Builder Pro</strong>
            <small>Custom domain + premium kits</small>
            <p><span class="i18n-en">For users who are blocked by launch, domain, branding or professional presentation.</span><span class="i18n-pt">Para quem está travado por lançamento, domínio, branding ou apresentação profissional.</span></p>
            <span class="revenue-funnel-card__price">£24 / month</span>
            <span class="revenue-funnel-card__cta"><span class="i18n-en">View Builder Pro</span><span class="i18n-pt">Ver Builder Pro</span> →</span>
          </a>

          <a href={productPreviewHref("cvitae_business")} class="revenue-funnel-card">
            <span class="revenue-funnel-card__badge"><span class="i18n-en">Career ROI</span><span class="i18n-pt">ROI de carreira</span></span>
            <img src="/assets/cvitae.webp" alt="" loading="lazy" decoding="async" />
            <strong>CVitae Business</strong>
            <small>Unlimited CV workflow</small>
            <p><span class="i18n-en">For professionals who need unlimited CVs, templates and export-ready career assets.</span><span class="i18n-pt">Para profissionais que precisam de CVs ilimitados, templates e ativos de carreira prontos para exportar.</span></p>
            <span class="revenue-funnel-card__price">£15 / month</span>
            <span class="revenue-funnel-card__cta"><span class="i18n-en">View Business</span><span class="i18n-pt">Ver Business</span> →</span>
          </a>

          <a href={productPreviewHref("tokens_core")} class="revenue-funnel-card">
            <span class="revenue-funnel-card__badge"><span class="i18n-en">One-time VX pack</span><span class="i18n-pt">Pack VX avulso</span></span>
            <img src="/assets/VX4.webp" alt="" loading="lazy" decoding="async" />
            <strong>32 VX Core</strong>
            <small>No subscription change</small>
            <p><span class="i18n-en">For users who need extra VX for selected exports, templates and Studio features.</span><span class="i18n-pt">Para quem precisa de VX extra para exportações, modelos e recursos Studio selecionados.</span></p>
            <span class="revenue-funnel-card__price">£18 one-time</span>
            <span class="revenue-funnel-card__cta"><span class="i18n-en">Review VX pack</span><span class="i18n-pt">Ver pacote VX</span> →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══ CURRENCY BAR (lang toggle removed — already in topbar) ═══ -->
    <section class="page-section" style="padding-top:32px;">
      <div class="shell">
        <div class="currency-bar">
          <div class="currency-bar__label">
            <svg class="currency-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>
            </svg>
            <span data-i18n="price.currency">Currency</span>
            <span class="currency-bar__hint"><span class="i18n-en">Prices update across the page</span><span class="i18n-pt">Preços atualizam na página inteira</span></span>
          </div>
          <div class="currency-bar__pills">
            {['GBP', 'EUR', 'BRL'].map((c) => (
              <button type="button" class={`lcbar__pill ${c === currency ? 'lcbar__pill--active' : ''}`} data-switch-currency={c} aria-pressed={c === currency ? 'true' : 'false'}>
                <span class="lcbar__pill-symbol">{c === 'GBP' ? '£' : c === 'EUR' ? '€' : 'R$'}</span>
                <span class="lcbar__pill-code">{c}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ ECOSYSTEM OVERVIEW ═══ -->
    <section class="page-section" style="padding-bottom:0;">
      <div class="shell eco-grid">
        <a href={ROUTES.builder} class="eco-card eco-card--builder">
          <div class="eco-card__art-wrap">
            <img src="/assets/new-builder-icon.webp" alt="" class="eco-card__art" loading="lazy" decoding="async" />
          </div>
          <strong>VOLYNX Builder</strong>
          <p><span class="i18n-en">Build and publish premium sites</span><span class="i18n-pt">Crie e publique sites premium</span></p>
          <span class="eco-card__badge"><span class="eco-card__pulse" aria-hidden="true"></span>LIVE</span>
        </a>
        <a href={ROUTES.daily} class="eco-card eco-card--daily">
          <div class="eco-card__art-wrap">
            <img src="/assets/daily-icon.webp" alt="" class="eco-card__art" loading="lazy" decoding="async" />
          </div>
          <strong>VOLYNX Daily</strong>
          <p><span class="i18n-en">Organize, scan, summarize, write, decide</span><span class="i18n-pt">Organize, escaneie, resuma, escreva, decida</span></p>
          <span class="eco-card__badge"><span class="eco-card__pulse" aria-hidden="true"></span>LIVE</span>
        </a>
        <a href={ROUTES.cvitae} class="eco-card eco-card--cvitae">
          <div class="eco-card__art-wrap">
            <img src="/assets/cvitae.webp" alt="" class="eco-card__art" loading="lazy" decoding="async" />
          </div>
          <strong>CVitae</strong>
          <p><span class="i18n-en">Professional CVs. Free to build, pay to export</span><span class="i18n-pt">CVs profissionais. Grátis para criar, pague para exportar</span></p>
          <span class="eco-card__badge"><span class="eco-card__pulse" aria-hidden="true"></span>LIVE</span>
        </a>
      </div>
    </section>

    <!-- ═══ HOW IT WORKS ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">How it works</span><span class="i18n-pt">Como funciona</span></span>
        <h2><span class="i18n-en">How VOLYNX pricing works</span><span class="i18n-pt">Como a economia VOLYNX funciona</span></h2>
        <p><span class="i18n-en">Your plan unlocks product access and features. VX adds premium usage for selected actions when the product says it is available.</span><span class="i18n-pt">Seu plano libera acesso às ferramentas e recursos do produto. VX adiciona uso premium para ações selecionadas quando o produto informar que está disponível.</span></p>
      </div>
      <div class="shell how-grid">
        <div class="how-card how-card--plan">
          <div class="how-card__art-shell" aria-hidden="true">
            <img src="/assets/allproducts.webp" alt="" class="how-card__art" loading="lazy" decoding="async" />
          </div>
          <div class="how-card__equation">
            <strong><span class="i18n-en">Plan</span><span class="i18n-pt">Plano</span></strong>
            <span class="how-eq">=</span>
            <span class="how-val"><span class="i18n-en">access</span><span class="i18n-pt">acesso</span></span>
          </div>
        </div>
        <div class="how-card how-card--vx">
          <div class="how-card__art-shell" aria-hidden="true">
            <img src="/assets/VX4.webp" alt="" class="how-card__art" loading="lazy" decoding="async" />
          </div>
          <div class="how-card__equation">
            <strong>VX</strong>
            <span class="how-eq">=</span>
            <span class="how-val"><span class="i18n-en">premium usage</span><span class="i18n-pt">uso premium</span></span>
          </div>
        </div>
        <div class="how-card how-card--bundle">
          <div class="how-card__art-shell" aria-hidden="true">
            <img src="/assets/bundle.webp" alt="" class="how-card__art how-card__art--icon" loading="lazy" decoding="async" />
          </div>
          <div class="how-card__equation">
            <strong><span class="i18n-en">Bundle</span><span class="i18n-pt">Bundle</span></strong>
            <span class="how-eq">=</span>
            <span class="how-val"><span class="i18n-en">savings</span><span class="i18n-pt">economia</span></span>
          </div>
        </div>
        <div class="how-card how-card--addon">
          <div class="how-card__art-shell" aria-hidden="true">
            <img src="/assets/addonicon.webp" alt="" class="how-card__art how-card__art--icon" loading="lazy" decoding="async" />
          </div>
          <div class="how-card__equation">
            <strong><span class="i18n-en">Add-on</span><span class="i18n-pt">Add-on</span></strong>
            <span class="how-eq">=</span>
            <span class="how-val"><span class="i18n-en">expansion without a plan change</span><span class="i18n-pt">expansão sem trocar de plano</span></span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ NOT SURE WHERE TO START? ═══ -->
    <section class="page-section guidance-section">
      <div class="shell">
        <div class="panel guidance-panel">
          <div class="guidance-head">
            <img src="/assets/start.webp" alt="" class="guidance-icon" loading="lazy" />
            <h2><span class="i18n-en">Not sure where to start?</span><span class="i18n-pt">Não sabe por onde começar?</span></h2>
            <p><span class="i18n-en">Here's how to choose what fits your workflow and budget.</span><span class="i18n-pt">Veja como escolher o que encaixa no seu fluxo e orçamento.</span></p>
          </div>
          <div class="guidance-grid">
            <div class="guidance-card">
              <div class="guidance-card-icon">
                <img src="/assets/startfree.webp" alt="" loading="lazy" decoding="async" aria-hidden="true" />
              </div>
              <h3><span class="i18n-en">Start with Free</span><span class="i18n-pt">Comece no Free</span></h3>
              <p><span class="i18n-en">Test Builder drafts, use all Lab tools, explore Daily basics and build your CV. Upgrade only when you need custom domains, cloud sync or exports.</span><span class="i18n-pt">Teste rascunhos no Builder, use todas as ferramentas do Lab, explore o Daily básico e monte seu CV. Faça upgrade só quando precisar de domínios personalizados, sincronização na nuvem ou exportações.</span></p>
            </div>
            <div class="guidance-card">
              <div class="guidance-card-icon">
                <img src="/assets/updatetopro.webp" alt="" loading="lazy" decoding="async" aria-hidden="true" />
              </div>
              <h3><span class="i18n-en">Go Pro when ready</span><span class="i18n-pt">Vá de Pro quando estiver pronto</span></h3>
              <p><span class="i18n-en">Builder Pro (£24) for publishing sites. Daily Pro (£14) for smarter daily tools. Or bundle Essential (£35) to save. Pro feels different — faster, cleaner, with more room to work.</span><span class="i18n-pt">Builder Pro (£24) para publicar sites. Daily Pro (£14) para ferramentas diárias mais inteligentes. Ou bundle Essential (£35) para economizar. Pro parece diferente — mais rápido, mais limpo, com mais espaço para trabalhar.</span></p>
            </div>
            <div class="guidance-card">
              <div class="guidance-card-icon">
                <img src="/assets/vxsystem.webp" alt="" loading="lazy" decoding="async" aria-hidden="true" />
              </div>
              <h3><span class="i18n-en">Add VX as needed</span><span class="i18n-pt">Adicione VX conforme necessário</span></h3>
              <p><span class="i18n-en">Your plan unlocks access. VX covers enabled premium actions like CVitae exports/templates and selected Studio actions. Buy packs starting at £8.40 for 12 VX — they never expire.</span><span class="i18n-pt">Seu plano libera acesso. VX cobre ações premium habilitadas, como exportações e modelos do CVitae, além de ações Studio selecionadas. Compre pacotes a partir de £8.40 por 12 VX — eles nunca expiram.</span></p>
            </div>
            <div class="guidance-card">
              <div class="guidance-card-icon">
                <img src="/assets/getbundle.webp" alt="" loading="lazy" decoding="async" aria-hidden="true" />
              </div>
              <h3><span class="i18n-en">Need both? Bundle it</span><span class="i18n-pt">Precisa dos dois? Faça bundle</span></h3>
              <p><span class="i18n-en">Essential (Builder Pro + Daily Pro = £35) or Complete (Builder Studio + Daily Diamond = £82). One subscription, both products, better pricing.</span><span class="i18n-pt">Essential (Builder Pro + Daily Pro = £35) ou Complete (Builder Studio + Daily Diamond = £82). Uma assinatura, ambos produtos, preço melhor.</span></p>
            </div>
          </div>
          <div class="guidance-cta">
            <a href={ROUTES.lab} class="button button--ghost"><span class="i18n-en">Try Lab for free first</span><span class="i18n-pt">Teste o Lab grátis primeiro</span></a>
            <a href={ROUTES.signup} class="button button--gold"><span class="i18n-en">Create free account</span><span class="i18n-pt">Criar conta grátis</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ BUILDER PLANS ═══ -->
    <section id="plans" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">The Builder</span><span class="i18n-pt">O Builder</span></span>
        <h2>VOLYNX Builder</h2>
        <p><span class="i18n-en">Create, refine, and publish premium sites with more control, better presentation, and a smoother publishing experience.</span><span class="i18n-pt">Crie, refine e publique sites premium com mais controle, melhor apresentação e uma experiência de publicação mais fluida.</span></p>
      </div>
      <div class="shell pricing-grid pricing-grid--plans">
        {sitePricing.builderPlans.map((plan) => (
          <PricingCard plan={plan} locale={lang} currency={currency} previewSlug="qrgen-pro" />
        ))}
      </div>
      <div class="shell">
        <div class="checkout-support"><span class="i18n-en"><strong>You are activating a VOLYNX plan.</strong> This plan unlocks access to the selected product's features and benefits. VX may apply only to explicitly supported add-on actions. Recurring billing. Cancel or change anytime.</span><span class="i18n-pt"><strong>Você está ativando um plano VOLYNX.</strong> Este plano libera acesso aos recursos e benefícios do produto selecionado. VX só entra em ações extras explicitamente suportadas. Cobrança recorrente. Cancele ou altere quando quiser.</span></div>
      </div>
    </section>

    <!-- ═══ QRGEN PLANS ═══ -->
    <section id="qrgen-plans" class="page-section qrgen-pricing-section">
      <div class="shell section-head">
        <span class="eyebrow">VOLYNX QRGen</span>
        <h2><span class="i18n-en">Premium QR exports follow the same VOLYNX plan logic.</span><span class="i18n-pt">Exports premium de QR seguem a mesma lógica de planos da VOLYNX.</span></h2>
        <p><span class="i18n-en">Static QR creation stays generous. Paid tiers unlock HD output, SVG vector export, transparent backgrounds, logo export and managed dynamic QR workflows.</span><span class="i18n-pt">Criar QR estático continua generoso. Tiers pagos liberam saída HD, SVG vetorial, fundo transparente, export com logo e fluxo de QR dinâmico gerenciado.</span></p>
      </div>
      <div class="shell qrgen-pricing-hero">
        <div class="qrgen-pricing-hero__copy">
