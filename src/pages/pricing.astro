---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../components/FlagshipHeader.astro";
import FlagshipFooter from "../components/FlagshipFooter.astro";
import PricingCard from "../components/pricing/PricingCard.astro";
import TokenPackCard from "../components/pricing/TokenPackCard.astro";
import ToolUsageCard from "../components/pricing/ToolUsageCard.astro";
import AddonCard from "../components/pricing/AddonCard.astro";
import PlatformAssistStrip from "../components/PlatformAssistStrip.astro";
import { sitePricing } from "../data/pricing";
import { ROUTES } from "../data/routes";

const lang = Astro.url.searchParams.get('lang') === 'pt' ? 'pt' : 'en';
const currencyParam = Astro.url.searchParams.get('currency') || '';
const currency = (['GBP', 'EUR', 'BRL'] as const).includes(currencyParam as any) ? currencyParam as 'GBP'|'EUR'|'BRL' : 'GBP';

const faqs = [
  { qKey: "price.faq_q1", aKey: "price.faq_a1", qFallback: "Is the Lab really free?", aFallback: "Yes. Lab tools are always free. No account needed. Files are processed locally in your browser." },
  { qKey: "price.faq_q2", aKey: "price.faq_a2", qFallback: "How do tokens work?", aFallback: "Tokens are the universal currency across the VOLYNX ecosystem. Use them for Builder exports, CVitae downloads, Daily overages, and more. Buy once, use anywhere. They never expire." },
  { qKey: "price.faq_q3", aKey: "price.faq_a3", qFallback: "Can I use outputs commercially?", aFallback: "Yes. All paid plans include commercial usage rights for the outputs you create." },
  { qKey: "price.faq_q4", aKey: "price.faq_a4", qFallback: "Can I switch plans anytime?", aFallback: "Yes. Upgrade, downgrade or cancel at any time from your profile dashboard." },
  { qKey: "price.faq_q5", aKey: "price.faq_a5", qFallback: "What's the difference between Builder and Daily plans?", aFallback: "Builder plans are for creating and publishing websites. Daily plans are for everyday tools: scanning, summarizing, writing, organizing, and deciding. They are separate subscriptions, or you can bundle them to save." },
  { qKey: "price.faq_q6", aKey: "price.faq_a6", qFallback: "How do bundles work?", aFallback: "Bundles combine Builder and Daily subscriptions at a discount. One subscription, both products, shared token balance." },
  { qKey: "price.faq_q7", aKey: "price.faq_a7", qFallback: "Does CVitae require a subscription?", aFallback: "No. CVitae is free to build and preview. You only pay when you export — 2 tokens per clean PDF. No subscription needed for most users. A Business tier exists for professionals who need unlimited exports." },
  { qKey: "price.faq_q8", aKey: "price.faq_a8", qFallback: "Can I use tokens across different products?", aFallback: "Yes. Your VOLYNX token balance works across Builder, Daily, CVitae, and all future products. One balance, one account." },
];

const bundleLookupById = {
  bundle_essential: 'bundle_volynx_daily_pro',
  bundle_complete: 'bundle_volynx_daily_studio',
} as Record<string, string>;

const pricingAssistItems = [
  { href: ROUTES.products, label: "Catalog", title: "Browse products", copy: "Go back to kits, tools and product pages while comparing plans.", emphasized: true, iconSrc: "/assets/allproducts.webp" },
  { href: ROUTES.delivery, label: "Post-purchase", title: "My products", copy: "If checkout already happened, reopen delivery and access instead of staying stuck in pricing.", iconSrc: "/assets/mybox.webp" },
  { href: ROUTES.support, label: "Support", title: "Open support", copy: "Use the support lane for billing, launch and access questions tied to a purchase.", iconSrc: "/assets/support.webp" },
  { href: ROUTES.daily, label: "Workspace", title: "See Daily live", copy: "Jump into the live workspace while evaluating Daily and bundle value.", iconSrc: "/assets/daily-icon.webp" },
];
---
<FlagshipLayout title="Pricing — VOLYNX" pageClass="page-pricing">
  <FlagshipHeader current={ROUTES.pricing} ctaLabel="Go Pro" ctaI18n="nav.go_pro" />
  <main>

    <!-- ═══ PAYMENT CANCELLED BANNER ═══ -->
    <div id="paymentCancelledBanner" style="display:none;max-width:720px;margin:24px auto 0;padding:16px 20px;border-radius:14px;background:rgba(255,180,0,.06);border:1px solid rgba(255,180,0,.2);font-size:14px;color:#e0e0e0;backdrop-filter:blur(12px);text-align:center;">
      <span style="margin-right:12px;" data-i18n="price.payment_cancelled">Payment was cancelled. You can try again anytime.</span>
      <button type="button" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:13px;text-decoration:underline;" data-i18n="price.dismiss" onclick="this.closest('div').style.display='none';history.replaceState({},'','/pricing/');">Dismiss</button>
    </div>

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="kicker" data-i18n="price.hero_kicker">Ecosystem pricing</span>
          <h1 data-i18n="price.hero_title">One ecosystem. Clear pricing. Premium capacity at every tier.</h1>
          <p data-i18n="price.hero_desc">Subscribe to what you use, bundle products to save, or add VX whenever you need more capacity. One account. One ecosystem. One smart balance for premium actions.</p>
          <p class="hero-subcopy"><span class="i18n-en">VOLYNX connects Builder, Daily, and CVitae into one unified experience. Your plans unlock access. Your VX balance unlocks premium actions, exports, deployments, and usage upgrades.</span><span class="i18n-pt">A VOLYNX une Builder, Daily e CVitae em uma experiência única. Seus planos liberam acesso. Seu saldo de VX libera ações premium, exports, deploys e upgrades de uso.</span></p>
          <div class="hero-actions">
            <a href="#plans" class="button button--gold" data-i18n="price.hero_cta1">View plans</a>
            <a href={ROUTES.lab} class="button button--ghost" data-i18n="price.hero_cta2">Open the Lab</a>
          </div>
        </div>
        <div class="pricing-hero-visual" aria-hidden="true">
          <img src="/assets/volynx-icon.webp" alt="" class="pricing-hero-icon" width="200" height="200" loading="eager" />
        </div>
      </div>
    </section>

    <PlatformAssistStrip eyebrow="Decision support" title="Pricing is one step, not the whole journey." description="Stay close to the operational paths while you compare plans, bundles and VX." items={pricingAssistItems} />

    <!-- ═══ CURRENCY BAR (lang toggle removed — already in topbar) ═══ -->
    <section class="page-section" style="padding-top:32px;">
      <div class="shell">
        <div class="currency-bar">
          <span style="font-size:12px;font-weight:700;letter-spacing:.06em;color:rgba(255,255,255,.45);text-transform:uppercase;" data-i18n="price.currency">Currency</span>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            {['GBP', 'EUR', 'BRL'].map((c) => (
              <button type="button" class={`lcbar__pill ${c === currency ? 'lcbar__pill--active' : ''}`} data-switch-currency={c}>{c}</button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ ECOSYSTEM OVERVIEW ═══ -->
    <section class="page-section" style="padding-bottom:0;">
      <div class="shell grid-3" style="gap:16px;">
        <div class="panel" style="text-align:center;padding:20px;">
          <strong>VOLYNX Builder</strong>
          <p style="margin:6px 0 0;color:var(--muted);font-size:13px;"><span class="i18n-en">Build and publish premium sites</span><span class="i18n-pt">Crie e publique sites premium</span></p>
          <span style="display:inline-block;margin-top:8px;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(34,197,94,.1);color:#22c55e;">LIVE</span>
        </div>
        <div class="panel" style="text-align:center;padding:20px;">
          <strong>VOLYNX Daily</strong>
          <p style="margin:6px 0 0;color:var(--muted);font-size:13px;"><span class="i18n-en">Organize, scan, summarize, write, decide</span><span class="i18n-pt">Organize, escaneie, resuma, escreva, decida</span></p>
          <span style="display:inline-block;margin-top:8px;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(34,197,94,.1);color:#22c55e;">LIVE</span>
        </div>
        <div class="panel" style="text-align:center;padding:20px;">
          <strong>CVitae</strong>
          <p style="margin:6px 0 0;color:var(--muted);font-size:13px;"><span class="i18n-en">Professional CVs. Free to build, pay to export</span><span class="i18n-pt">CVs profissionais. Grátis para criar, pague para exportar</span></p>
          <span style="display:inline-block;margin-top:8px;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(34,197,94,.1);color:#22c55e;">LIVE</span>
        </div>
      </div>
    </section>

    <!-- ═══ HOW IT WORKS ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">How it works</span><span class="i18n-pt">Como funciona</span></span>
        <h2><span class="i18n-en">How VOLYNX pricing works</span><span class="i18n-pt">Como a economia VOLYNX funciona</span></h2>
        <p><span class="i18n-en">Your plan unlocks product access and feature availability. Your VX unlocks on-demand premium actions such as exports, deployments, and usage upgrades.</span><span class="i18n-pt">Seu plano libera acesso às ferramentas e recursos do produto. Seu VX libera ações premium sob demanda, como exports, deploys e upgrades de uso.</span></p>
      </div>
      <div class="shell how-grid">
        <div class="how-card how-card--plan">
          <div class="how-card__art-shell" aria-hidden="true">
            <img src="/assets/allproducts.webp" alt="" class="how-card__art" loading="lazy" decoding="async" />
          </div>
          <div class="how-card__equation">
            <strong><span class="i18n-en">Plan</span><span class="i18n-pt">Plano</span></strong>
            <span class="how-eq">=</span>
            <span class="how-val"><span class="i18n-en">access</span><span class="i18n-pt">acesso</span></span>
          </div>
        </div>
        <div class="how-card how-card--vx">
          <div class="how-card__art-shell" aria-hidden="true">
            <img src="/assets/vx-new.webp" alt="" class="how-card__art" loading="lazy" decoding="async" />
          </div>
          <div class="how-card__equation">
            <strong>VX</strong>
            <span class="how-eq">=</span>
            <span class="how-val"><span class="i18n-en">capacity</span><span class="i18n-pt">capacidade</span></span>
          </div>
        </div>
        <div class="how-card how-card--bundle">
          <div class="how-card__art-shell" aria-hidden="true">
            <img src="/assets/icons-store/Hyper-Icons-Premium/infinity.png" alt="" class="how-card__art" loading="lazy" decoding="async" />
          </div>
          <div class="how-card__equation">
            <strong><span class="i18n-en">Bundle</span><span class="i18n-pt">Bundle</span></strong>
            <span class="how-eq">=</span>
            <span class="how-val"><span class="i18n-en">savings</span><span class="i18n-pt">economia</span></span>
          </div>
        </div>
        <div class="how-card how-card--addon">
          <div class="how-card__art-shell" aria-hidden="true">
            <img src="/assets/icons-store/Hyper-Icons-Premium/lightning.png" alt="" class="how-card__art" loading="lazy" decoding="async" />
          </div>
          <div class="how-card__equation">
            <strong><span class="i18n-en">Add-on</span><span class="i18n-pt">Add-on</span></strong>
            <span class="how-eq">=</span>
            <span class="how-val"><span class="i18n-en">expansion without a plan change</span><span class="i18n-pt">expansão sem trocar de plano</span></span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ BUILDER PLANS ═══ -->
    <section id="plans" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">The Builder</span><span class="i18n-pt">O Builder</span></span>
        <h2>VOLYNX Builder</h2>
        <p><span class="i18n-en">Create, refine, and publish premium sites with more control, better presentation, and real delivery capacity.</span><span class="i18n-pt">Crie, refine e publique sites premium com mais controle, melhor apresentação e capacidade real de entrega.</span></p>
      </div>
      <div class="shell pricing-grid pricing-grid--plans">
        {sitePricing.builderPlans.map((plan) => (
          <PricingCard plan={plan} locale={lang} currency={currency} />
        ))}
      </div>
      <div class="shell">
        <div class="checkout-support"><span class="i18n-en"><strong>You are activating a VOLYNX plan.</strong> This plan unlocks access to the selected product's features and benefits. Some premium actions and on-demand upgrades may use VX separately. Recurring billing. Cancel or change anytime.</span><span class="i18n-pt"><strong>Você está ativando um plano VOLYNX.</strong> Este plano libera acesso aos recursos e benefícios do produto selecionado. Alguns recursos premium e ações sob demanda podem usar VX separadamente. Cobrança recorrente. Cancele ou altere quando quiser.</span></div>
      </div>
    </section>

    <!-- ═══ WHAT PRO FEELS LIKE ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <h2 data-i18n="price.pro_section_title">What Pro actually feels like</h2>
        <p data-i18n="price.pro_section_desc">Pro is about working smarter, faster, and with more control over your output.</p>
      </div>
      <div class="shell comparison">
        <div class="comparison-row"><strong data-i18n="price.comp_memory">Workflow memory</strong><span class="check" data-i18n="price.comp_free_memory">No memory</span><span class="check pro" data-i18n="price.comp_pro_memory">Presets, history, reusable recipes</span></div>
        <div class="comparison-row"><strong data-i18n="price.comp_quality">Output quality</strong><span class="check" data-i18n="price.comp_free_quality">Basic modes</span><span class="check pro" data-i18n="price.comp_pro_quality">Premium modes, stronger exports</span></div>
        <div class="comparison-row"><strong data-i18n="price.comp_speed">Comfort and speed</strong><span class="check" data-i18n="price.comp_free_speed">Manual repetition</span><span class="check pro" data-i18n="price.comp_pro_speed">Queues, defaults, faster decision loops</span></div>
        <div class="comparison-row"><strong data-i18n="price.comp_status">Status</strong><span class="check" data-i18n="price.comp_free_status">Discovery mode</span><span class="check pro" data-i18n="price.comp_pro_status">Pro workspace and priority access</span></div>
      </div>
    </section>

    <!-- ═══ DAILY PLANS ═══ -->
    <section id="daily-plans" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">The Daily</span><span class="i18n-pt">O Daily</span></span>
        <h2>VOLYNX Daily</h2>
        <p><span class="i18n-en">Your daily system for organizing, writing, summarizing, deciding, and keeping everything moving better.</span><span class="i18n-pt">Seu sistema diário para organizar, escrever, resumir, decidir e manter tudo fluindo melhor.</span></p>
      </div>
      <div class="shell pricing-grid pricing-grid--plans" style="max-width:960px;">
        {sitePricing.dailyPlans.map((plan) => (
          <PricingCard plan={plan} locale={lang} currency={currency} />
        ))}
      </div>
      <div class="shell">
        <div class="checkout-support"><span class="i18n-en"><strong>You are activating a VOLYNX plan.</strong> This plan unlocks access to the selected product's features and benefits. Some premium actions and on-demand upgrades may use VX separately. Recurring billing. Cancel or change anytime.</span><span class="i18n-pt"><strong>Você está ativando um plano VOLYNX.</strong> Este plano libera acesso aos recursos e benefícios do produto selecionado. Alguns recursos premium e ações sob demanda podem usar VX separadamente. Cobrança recorrente. Cancele ou altere quando quiser.</span></div>
      </div>
    </section>

    <!-- ═══ CVITAE ═══ -->
    <section id="cvitae" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow">CVitae by VOLYNX</span>
        <h2><span class="i18n-en">CVitae by VOLYNX</span><span class="i18n-pt">CVitae by VOLYNX</span></h2>
        <p><span class="i18n-en">Build your CV for free. Only pay when you want a professional export.</span><span class="i18n-pt">Crie seu CV sem pagar nada. Pague apenas quando quiser exportar com acabamento profissional.</span></p>
      </div>
      <div class="shell grid-3" style="max-width:960px;gap:16px;">
        <div class="panel" style="padding:24px;">
          <strong><span class="i18n-en">Free to build</span><span class="i18n-pt">Free to build</span></strong>
          <p style="margin:8px 0 0;color:var(--muted);font-size:13px;line-height:1.6;"><span class="i18n-en">Full editor, live preview, and no barrier to start.</span><span class="i18n-pt">Editor completo, preview ao vivo e construção sem barreira.</span></p>
        </div>
        <div class="panel" style="padding:24px;border-color:rgba(13,148,136,.3);background:rgba(13,148,136,.04);">
          <strong><span class="i18n-en">Professional export — 2 VX</span><span class="i18n-pt">Exportação profissional — 2 VX</span></strong>
          <div style="font-size:1.5rem;font-weight:700;margin:8px 0;">2 VX</div>
          <p style="margin:0;color:var(--muted);font-size:13px;line-height:1.6;"><span class="i18n-en">A clean, professional PDF ready for applications.</span><span class="i18n-pt">PDF limpo, profissional e pronto para candidatura.</span></p>
        </div>
        <div class="panel" style="padding:24px;">
          <strong><span class="i18n-en">CVitae Business</span><span class="i18n-pt">CVitae Business</span></strong>
          <div style="font-size:1.1rem;font-weight:700;margin:8px 0;color:var(--muted);">
            <span class="vx-price" data-currency="GBP">£15</span>
            <span class="vx-price vx-price--hidden" data-currency="EUR">€18</span>
            <span class="vx-price vx-price--hidden" data-currency="BRL">R$99</span>
            <span style="font-size:13px;font-weight:400;"><span class="i18n-en">/month</span><span class="i18n-pt">/mês</span></span>
          </div>
          <p style="margin:0;color:var(--muted);font-size:13px;line-height:1.6;"><span class="i18n-en">For professionals who need unlimited exports, premium templates, and multi-CV management.</span><span class="i18n-pt">Para profissionais que precisam de exports ilimitados, templates premium e gestão de múltiplos CVs.</span></p>
        </div>
      </div>
      <div class="shell" style="max-width:960px;">
        <div class="checkout-support">
          <span class="i18n-en"><strong>CVitae keeps the default path simple.</strong> Build for free, use VX when you want a professional export, and unlock premium templates inside CVitae. Business is for people who need unlimited exports and templates every week.</span>
          <span class="i18n-pt"><strong>O caminho padrão do CVitae continua simples.</strong> Monte grátis, use VX quando quiser exportação profissional e libere templates premium dentro do CVitae. O Business existe para quem precisa de exports e templates sem limite toda semana.</span>
        </div>
        <div class="cvitae-actions">
          <a class="button button--ghost" href={`${ROUTES.cvitae}/editor/`}><span class="i18n-en">Open CVitae</span><span class="i18n-pt">Abrir CVitae</span></a>
          <a class="button button--ghost" href={ROUTES.recarregar}><span class="i18n-en">Get VX</span><span class="i18n-pt">Comprar VX</span></a>
          <button type="button" class="button button--gold" id="cvitaeBusinessBtn"><span class="i18n-en">Activate Business</span><span class="i18n-pt">Ativar Business</span></button>
        </div>
      </div>
    </section>

    <!-- ═══ PROPERTYFLOW ═══ -->
    <section id="propertyflow" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow">PropertyFlow</span>
        <h2><span class="i18n-en">PropertyFlow pricing, documented clearly.</span><span class="i18n-pt">Pricing do PropertyFlow, documentado com clareza.</span></h2>
        <p><span class="i18n-en">Source-code product. One-time purchase. Dedicated delivery and docs flow.</span><span class="i18n-pt">Produto com código-fonte. Pagamento único. Fluxo dedicado de entrega e documentação.</span></p>
      </div>
      <div class="shell pricing-grid pricing-grid--plans" style="max-width:1100px;">
        {sitePricing.propertyFlowPackages.map((plan) => (
          <article class={`pricing-card ${plan.featured ? 'pricing-card--featured' : ''}`}>
            <div class="pricing-card__head">
              <div>
                {plan.badge && <span class="pricing-pill"><span class="i18n-en">{plan.badge.en}</span><span class="i18n-pt">{plan.badge.pt}</span></span>}
                <h3 class="pricing-card__name"><span class="i18n-en">{plan.name.en}</span><span class="i18n-pt">{plan.name.pt}</span></h3>
                <p class="pricing-card__desc"><span class="i18n-en">{plan.description.en}</span><span class="i18n-pt">{plan.description.pt}</span></p>
              </div>
              <div class="pricing-card__price-block">
                <span class="pricing-card__price" data-currency="GBP">{plan.price.GBP}</span>
                <span class="pricing-card__price pricing-card__price--hidden" data-currency="EUR">{plan.price.EUR}</span>
                <span class="pricing-card__price pricing-card__price--hidden" data-currency="BRL">{plan.price.BRL}</span>
                <span class="pricing-card__billing"><span class="i18n-en">{plan.billing.en}</span><span class="i18n-pt">{plan.billing.pt}</span></span>
              </div>
            </div>
            <ul class="pricing-card__features">
              {plan.features.en.map((f: string, i: number) => (
                <li><span class="i18n-en">{f}</span><span class="i18n-pt">{plan.features.pt[i] || f}</span></li>
              ))}
            </ul>
            <a href={plan.href} class={`pricing-card__cta ${plan.featured ? 'pricing-card__cta--primary' : ''}`}>
              <span class="i18n-en">{plan.cta.en}</span><span class="i18n-pt">{plan.cta.pt}</span>
            </a>
            {plan.note && <p class="pricing-card__footnote"><span class="i18n-en">{plan.note.en}</span><span class="i18n-pt">{plan.note.pt}</span></p>}
          </article>
        ))}
      </div>
    </section>

    <!-- ═══ BUNDLES ═══ -->
    <section id="bundles" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">Save with bundles</span><span class="i18n-pt">Economize com bundles</span></span>
        <h2><span class="i18n-en">Use more than one product? Bundle and save.</span><span class="i18n-pt">Usa mais de um produto? Combine e economize.</span></h2>
        <p><span class="i18n-en">Bundles combine subscriptions and capacity more efficiently for users living inside the full ecosystem.</span><span class="i18n-pt">Bundles unem assinatura e capacidade de forma mais eficiente para quem vive o ecossistema completo.</span></p>
      </div>
      <div class="shell grid-2" style="max-width:720px;gap:16px;">
        {sitePricing.bundles.map((b) => (
          <div class="panel" style="padding:24px;border-color:rgba(109,94,252,.2);background:rgba(109,94,252,.03);">
            {b.badge && <span style="display:inline-block;margin-bottom:8px;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(109,94,252,.12);color:#C4B5FD;"><span class="i18n-en">{b.badge.en}</span><span class="i18n-pt">{b.badge.pt}</span></span>}
            <strong style="display:block;font-size:1.1rem;"><span class="i18n-en">{b.name.en}</span><span class="i18n-pt">{b.name.pt}</span></strong>
            <p style="margin:4px 0;color:var(--muted);font-size:13px;"><span class="i18n-en">{b.includes.en}</span><span class="i18n-pt">{b.includes.pt}</span></p>
