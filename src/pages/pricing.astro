---
import BaseLayout from "../layouts/BaseLayout.astro";
import VxHeader from "../components/VxHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
const title = "Pricing — VOLYNX";
const plans = [
  {
    name: "Free (Lab)",
    price: "£0",
    period: "/month",
    tagline: "Try the tools. No friction.",
    perks: [
      "Access to Volynx Lab tools",
      "Basic limits (fair use)",
      "Community updates",
    ],
    cta: { label: "Open Volynx Lab", href: "/volynx-lab/" },
    badge: "Starter",
  },
  {
    name: "Studio Pro",
    price: "£19",
    period: "/month",
    tagline: "The full suite. Faster workflows.",
    perks: [
      "All Studio tools (Pro)",
      "Higher limits + batch processing",
      "Priority updates",
      "Commercial usage",
    ],
    cta: { label: "Go Studio", href: "/volynx-lab/studio/" },
    badge: "Best value",
  },
  {
    name: "Teams",
    price: "£49",
    period: "/month",
    tagline: "Shared workflows for teams.",
    perks: [
      "Team seats",
      "Shared presets",
      "Central billing",
      "Support SLA (lightweight)",
    ],
    cta: { label: "Contact sales", href: "/contact/" },
    badge: "Scale",
  },
];

const faqs = [
  {
    q: "Is the Lab really free?",
    a: "Yes. Lab is for discovery and proof-of-value. Studio is where power users upgrade.",
  },
  {
    q: "How does billing work?",
    a: "Studio runs on a monthly subscription. Cancel anytime—no hostage contracts.",
  },
  {
    q: "Can I use Studio outputs commercially?",
    a: "Yes. Studio is designed for production use.",
  },
];
---

<BaseLayout title={title}>
  <VxHeader />

  <main class="shell pricing">
    <section class="hero">
      <h1>Pricing</h1>
      <p class="sub">
        Lab is your sandbox. Studio is your production pipeline.
      </p>
    </section>

    <section class="grid">
      {plans.map((p) => (
        <article class="card">
          <div class="card-top">
            <span class="badge">{p.badge}</span>
            <h2>{p.name}</h2>
            <div class="price">
              <span class="amount">{p.price}</span>
              <span class="period">{p.period}</span>
            </div>
            <p class="tagline">{p.tagline}</p>
          </div>

          <ul class="perks">
            {p.perks.map((x) => <li>{x}</li>)}
          </ul>

          <a class="btn" href={p.cta.href}>{p.cta.label}</a>
        </article>
      ))}
    </section>

    <section class="faq">
      <h2>FAQ</h2>
      <div class="faq-grid">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  @import "../styles/products2.css";
  @import "../styles/services.css";
  @import "../styles/legal.css";

  .pricing .hero { padding: 48px 0 22px; }
  .pricing .sub { max-width: 64ch; opacity: .85; }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 18px;
    margin: 24px 0 44px;
  }
  .card {
    grid-column: span 4;
    border-radius: 24px;
    padding: 22px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(10,12,20,.55);
    backdrop-filter: blur(12px);
  }
  .card-top h2 { margin: 10px 0 6px; }
  .badge {
    display: inline-flex; align-items: center;
    padding: 6px 10px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,.14);
    font-size: 12px; opacity: .9;
  }
  .price { display: flex; gap: 8px; align-items: baseline; margin: 10px 0 6px; }
  .amount { font-size: 40px; line-height: 1; font-weight: 700; }
  .period { opacity: .7; }
  .tagline { opacity: .85; margin-bottom: 14px; }
  .perks { list-style: none; padding: 0; margin: 14px 0 18px; }
  .perks li { padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,.06); opacity: .9; }
  .btn {
    display: inline-flex; justify-content: center; width: 100%;
    padding: 12px 14px; border-radius: 14px;
    border: 1px solid rgba(255,255,255,.12);
    text-decoration: none;
  }

  .faq { padding: 18px 0 70px; }
  .faq-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 14px; margin-top: 14px; }
  .faq-item { grid-column: span 6; padding: 16px; border-radius: 18px;
    border: 1px solid rgba(255,255,255,.08); background: rgba(10,12,20,.35);
  }
  .faq-item summary { cursor: pointer; font-weight: 600; }
  .faq-item p { margin: 10px 0 0; opacity: .85; }

  @media (max-width: 980px) {
    .card { grid-column: span 6; }
    .faq-item { grid-column: span 12; }
  }
  @media (max-width: 640px) {
    .card { grid-column: span 12; }
  }
</style>