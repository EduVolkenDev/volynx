  <!-- Checkout + Plan detection -->
  <script is:inline type="module">
    const PLAN_LOOKUP_PREFIX = {
      launch: 'builder_launch',
      pro: 'builder_pro',
      studio: 'builder_studio',
      teams: 'builder_teams',
      daily_pro: 'daily_pro',
      daily_diamond: 'daily_diamond',
    };
    const urlParams = new URLSearchParams(window.location.search);

    // Show cancelled banner if redirected from Stripe
    if (urlParams.get('payment') === 'cancelled') {
      const cb = document.getElementById('paymentCancelledBanner');
      if (cb) cb.style.display = '';
      history.replaceState({}, '', '/pricing/');
    }
    function normalizeCurrency(value) {
      const code = String(value || 'GBP').toLowerCase();
      return ['gbp', 'eur', 'brl'].includes(code) ? code : 'gbp';
    }

    function getCheckoutCurrency() {
      const active = document.querySelector('[data-switch-currency].lcbar__pill--active')?.dataset.switchCurrency;
      return normalizeCurrency(active || new URLSearchParams(window.location.search).get('currency') || localStorage.getItem('volynx_currency') || 'GBP');
    }

    let cfg = null;
    let token = localStorage.getItem('volynx_access_token') || '';
    const refreshToken = localStorage.getItem('volynx_refresh_token') || '';

    try { cfg = await fetch('/config.json', { cache: 'no-store' }).then(r => r.json()); } catch {}
    const apiBase = (cfg?.functionsUrl || cfg?.apiBaseUrl || '').replace(/\/$/, '');

    if (token && refreshToken && cfg?.supabaseUrl && cfg?.supabaseAnonKey) {
      try {
        const rr = await fetch(cfg.supabaseUrl + '/auth/v1/token?grant_type=refresh_token', {
          method: 'POST',
          headers: { apikey: cfg.supabaseAnonKey, 'Content-Type': 'application/json' },
          body: JSON.stringify({ refresh_token: refreshToken }),
        });
        if (rr.ok) {
          const sess = await rr.json();
          if (sess.access_token) {
            token = sess.access_token;
            localStorage.setItem('volynx_access_token', sess.access_token);
            if (sess.refresh_token) localStorage.setItem('volynx_refresh_token', sess.refresh_token);
          }
        }
      } catch {}
    }

    // Free / Daily Free plan CTAs route to the actual product instead of
    // dead-clicking. Without this the buttons looked clickable but did
    // nothing, which buyers (correctly) read as "broken".
    const FREE_PLAN_HREFS = {
      free: '/builder/',          // Builder Free → open Builder
      daily_free: 'https://daily.volynx.world/',
    };

    document.querySelectorAll('.pricing-card__cta').forEach((btn) => {
      const card = btn.closest('.pricing-card');
      const planId = card?.getAttribute('data-plan') || '';
      const freeHref = FREE_PLAN_HREFS[planId];
      if (freeHref) {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          window.location.href = freeHref;
        });
        return;
      }
      const lookupPrefix = PLAN_LOOKUP_PREFIX[planId];
      if (!lookupPrefix) return;
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        if (!token) { window.location.href = '/login/?next=/pricing/'; return; }
        if (!apiBase) { vxToast('Checkout not configured.'); return; }
        const lookupKey = lookupPrefix + '_' + getCheckoutCurrency();
        btn.textContent = 'Redirecting...';
        btn.style.pointerEvents = 'none';
        try {
          const res = await fetch(apiBase + '/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ lookup_key: lookupKey, success_url: window.location.origin + '/profile/?payment=success', cancel_url: window.location.origin + '/pricing/?payment=cancelled' }),
          });
          const data = await res.json();
          if (data.url) window.location.href = data.url;
          else { vxToast(data.error || data.msg || data.message || 'Checkout failed. Please try again.'); btn.textContent = 'Try again'; btn.style.pointerEvents = ''; }
        } catch { vxToast('Connection error. Please check your network and try again.'); btn.textContent = 'Try again'; btn.style.pointerEvents = ''; }
      });
    });

    // ── Bundles: checkout via Stripe ──
    document.querySelectorAll('.bundle-card__cta').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        if (!token) { window.location.href = '/login/?next=/pricing/'; return; }
        if (!apiBase) { vxToast('Checkout not configured.'); return; }
        const bundleKey = btn.getAttribute('data-bundle-key');
        if (!bundleKey) return;
        btn.textContent = 'Redirecting...';
        btn.style.pointerEvents = 'none';
        try {
          const res = await fetch(apiBase + '/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ lookup_key: bundleKey + '_' + getCheckoutCurrency(), success_url: window.location.origin + '/profile/?payment=success', cancel_url: window.location.origin + '/pricing/?payment=cancelled' }),
          });
          const data = await res.json();
          if (data.url) window.location.href = data.url;
          else { vxToast(data.error || data.msg || data.message || 'Checkout failed. Please try again.'); btn.textContent = 'Try again'; btn.style.pointerEvents = ''; }
        } catch { vxToast('Connection error. Please check your network and try again.'); btn.textContent = 'Try again'; btn.style.pointerEvents = ''; }
      });
    });

    // ── Token pack: Stripe checkout (card) ──
    document.querySelectorAll('.token-card__cta').forEach((btn, idx) => {
      const packKeys = ['tokens_starter', 'tokens_core', 'tokens_pro', 'tokens_scale'];
      const packKey = packKeys[idx];
      if (!packKey) return;
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        if (!token) { window.location.href = '/login/?next=/pricing/'; return; }
        if (!apiBase) return;
        btn.textContent = 'Redirecting...';
        try {
          const res = await fetch(apiBase + '/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ lookup_key: packKey + '_' + getCheckoutCurrency() }),
          });
          const data = await res.json();
          if (data.url) window.location.href = data.url;
          else { vxToast(data.error || data.msg || data.message || 'Checkout failed. Please try again.'); btn.textContent = 'Buy'; }
        } catch { btn.textContent = 'Buy'; }
      });
    });

    // ── Token pack: Pix checkout (BRL only) ──
    // Show Pix buttons when currency is BRL
    if (getCheckoutCurrency() === 'brl') {
      document.querySelectorAll('.token-card__pix').forEach(btn => {
        btn.style.display = 'flex';
      });
    }

    document.querySelectorAll('.token-card__pix').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        if (!token) { window.location.href = '/login/?next=/pricing/'; return; }
        const packLookup = btn.getAttribute('data-pix-pack');
        if (!packLookup || !window.VxPix) return;
        window.VxPix.checkout(packLookup, {
          successUrl: window.location.origin + '/account/?payment=pix_success',
          cancelUrl: window.location.origin + '/pricing/?payment=cancelled&currency=BRL',
        });
      });
    });

    // ── Add-ons: checkout via Stripe (only active addons have data-addon-key) ──
    document.querySelectorAll('.addon-card__cta[data-addon-key]').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (!token) { window.location.href = '/login/?next=/pricing/'; return; }
        if (!apiBase) return;
        const addonKey = btn.getAttribute('data-addon-key');
        if (!addonKey) return;
        const lookupKey = addonKey + '_' + getCheckoutCurrency();
        btn.textContent = '...';
        btn.style.pointerEvents = 'none';
        try {
          const res = await fetch(apiBase + '/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ lookup_key: lookupKey }),
          });
          const data = await res.json();
          if (data.url) window.location.href = data.url;
          else { vxToast(data.error || 'Checkout failed.'); btn.textContent = 'Add'; btn.style.pointerEvents = ''; }
        } catch { btn.textContent = 'Add'; btn.style.pointerEvents = ''; }
      });
    });

    // Clicking the card itself also triggers the active checkout button (no-op on manual / coming_soon).
    document.querySelectorAll('.addon-card').forEach(card => {
      card.addEventListener('click', (e) => {
        if (e.target.closest('.addon-card__cta')) return;
        const btn = card.querySelector('.addon-card__cta[data-addon-key]');
        if (btn) btn.click();
      });
    });

    const cvitaeBusinessBtn = document.getElementById('cvitaeBusinessBtn');
    if (cvitaeBusinessBtn) {
      cvitaeBusinessBtn.addEventListener('click', async () => {
        if (!token) { window.location.href = '/login/?next=/pricing/#cvitae'; return; }
        if (!apiBase) { vxToast('Checkout not configured.'); return; }
        cvitaeBusinessBtn.textContent = 'Redirecting...';
        cvitaeBusinessBtn.style.pointerEvents = 'none';
        try {
          const res = await fetch(apiBase + '/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({
              lookup_key: 'cvitae_business_' + getCheckoutCurrency(),
              success_url: window.location.origin + '/profile/?payment=success&product=cvitae_business',
              cancel_url: window.location.origin + '/pricing/?payment=cancelled#cvitae',
            }),
          });
          const data = await res.json();
          if (data.url) window.location.href = data.url;
          else {
            vxToast(data.error || data.msg || data.message || 'Checkout failed. Please try again.');
            cvitaeBusinessBtn.textContent = 'Try again';
            cvitaeBusinessBtn.style.pointerEvents = '';
          }
        } catch {
          vxToast('Connection error. Please check your network and try again.');
          cvitaeBusinessBtn.textContent = 'Try again';
          cvitaeBusinessBtn.style.pointerEvents = '';
        }
      });
    }

    if (token && apiBase) {
      try {
        const res = await fetch(apiBase + '/check-permission', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
          body: JSON.stringify({ tool: 'converter' }),
        });
        if (res.ok) {
          const perm = await res.json();
          if (!perm.useLocalStorage) {
            const currentPlanIds = new Set();
            const builderPlan = (perm.builder_plan || perm.builderPlan || perm.plan || 'free').toLowerCase();
            const dailyPlan = (perm.daily_plan || perm.dailyPlan || 'free').toLowerCase();
            currentPlanIds.add(builderPlan === 'free' ? 'free' : builderPlan);
            if (dailyPlan !== 'free') currentPlanIds.add('daily_' + dailyPlan);

            document.querySelectorAll('.pricing-card').forEach((card) => {
              const planId = card.getAttribute('data-plan') || '';
              if (!currentPlanIds.has(planId)) return;

              card.style.borderColor = 'rgba(52,211,153,.35)';
              card.style.boxShadow = '0 0 24px rgba(52,211,153,.08)';
              const name = card.querySelector('.pricing-card__name');
              if (name) { const b = document.createElement('span'); b.textContent = ' ✓ Your plan'; b.style.cssText = 'font-size:12px;color:#34D399;font-weight:700;'; name.appendChild(b); }
              const cta = card.querySelector('.pricing-card__cta');
              if (cta && planId !== 'free' && planId !== 'daily_free') {
                cta.textContent = 'Current plan ✓';
                cta.style.cssText = 'background:rgba(52,211,153,.08);border-color:rgba(52,211,153,.25);color:#34D399;pointer-events:none;display:flex;justify-content:center;padding:12px;border-radius:14px;text-decoration:none;font-weight:600;font-size:14px;';

                // Add "Manage subscription" link below the current plan CTA
                const manageBtn = document.createElement('button');
                manageBtn.textContent = 'Manage subscription';
                manageBtn.className = 'pricing-card__manage';
                manageBtn.style.cssText = 'display:flex;align-items:center;justify-content:center;width:100%;padding:10px;margin-top:8px;border-radius:12px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.03);color:rgba(255,255,255,.5);font-size:13px;font-weight:500;cursor:pointer;transition:all .2s;';
                manageBtn.onmouseenter = () => { manageBtn.style.background = 'rgba(255,80,80,.06)'; manageBtn.style.borderColor = 'rgba(255,80,80,.2)'; manageBtn.style.color = 'rgba(255,120,120,.8)'; };
                manageBtn.onmouseleave = () => { manageBtn.style.background = 'rgba(255,255,255,.03)'; manageBtn.style.borderColor = 'rgba(255,255,255,.08)'; manageBtn.style.color = 'rgba(255,255,255,.5)'; };
                manageBtn.addEventListener('click', async () => {
                  manageBtn.textContent = 'Opening...';
                  manageBtn.style.pointerEvents = 'none';
                  try {
                    const portalRes = await fetch(apiBase + '/create-portal-session', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
                      body: JSON.stringify({ return_url: window.location.origin + '/pricing/' }),
                    });
                    const portalData = await portalRes.json();
                    if (portalData.url) window.location.href = portalData.url;
                    else { vxToast(portalData.error || 'Could not open subscription manager.'); manageBtn.textContent = 'Manage subscription'; manageBtn.style.pointerEvents = ''; }
                  } catch { vxToast('Connection error.'); manageBtn.textContent = 'Manage subscription'; manageBtn.style.pointerEvents = ''; }
                });
                cta.parentElement.appendChild(manageBtn);
              }
            });
          }
        }
      } catch {}
    }
  </script>
</FlagshipLayout>
