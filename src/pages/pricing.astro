---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../components/FlagshipHeader.astro";
import FlagshipFooter from "../components/FlagshipFooter.astro";
import PricingCard from "../components/pricing/PricingCard.astro";
import TokenPackCard from "../components/pricing/TokenPackCard.astro";
import ToolUsageCard from "../components/pricing/ToolUsageCard.astro";
import AddonCard from "../components/pricing/AddonCard.astro";
import { sitePricing } from "../data/pricing";
import { ROUTES } from "../data/routes";

const lang = Astro.url.searchParams.get('lang') === 'pt' ? 'pt' : 'en';
const currencyParam = Astro.url.searchParams.get('currency') || '';
const currency = (['GBP', 'EUR', 'BRL'] as const).includes(currencyParam as any) ? currencyParam as 'GBP'|'EUR'|'BRL' : 'GBP';

const faqs = [
  { qKey: "price.faq_q1", aKey: "price.faq_a1", qFallback: "Is the Lab really free?", aFallback: "Yes. Lab tools are always free. No account needed. Files are processed locally in your browser." },
  { qKey: "price.faq_q2", aKey: "price.faq_a2", qFallback: "How do tokens work?", aFallback: "Tokens are the universal currency across the VOLYNX ecosystem. Use them for Builder exports, CVitae downloads, Daily overages, and more. Buy once, use anywhere. They never expire." },
  { qKey: "price.faq_q3", aKey: "price.faq_a3", qFallback: "Can I use outputs commercially?", aFallback: "Yes. All paid plans include commercial usage rights for the outputs you create." },
  { qKey: "price.faq_q4", aKey: "price.faq_a4", qFallback: "Can I switch plans anytime?", aFallback: "Yes. Upgrade, downgrade or cancel at any time from your profile dashboard." },
  { qKey: "price.faq_q5", aKey: "price.faq_a5", qFallback: "What's the difference between Builder and Daily plans?", aFallback: "Builder plans are for creating and publishing websites. Daily plans are for everyday tools: scanning, summarizing, writing, organizing, and deciding. They are separate subscriptions, or you can bundle them to save." },
  { qKey: "price.faq_q6", aKey: "price.faq_a6", qFallback: "How do bundles work?", aFallback: "Bundles combine Builder and Daily subscriptions at a discount. One subscription, both products, shared token balance." },
  { qKey: "price.faq_q7", aKey: "price.faq_a7", qFallback: "Does CVitae require a subscription?", aFallback: "No. CVitae is free to build and preview. You only pay when you export — 2 tokens per clean PDF. No subscription needed for most users. A Business tier exists for professionals who need unlimited exports." },
  { qKey: "price.faq_q8", aKey: "price.faq_a8", qFallback: "Can I use tokens across different products?", aFallback: "Yes. Your VOLYNX token balance works across Builder, Daily, CVitae, and all future products. One balance, one account." },
];
---
<FlagshipLayout title="Pricing — VOLYNX" pageClass="page-pricing">
  <FlagshipHeader current={ROUTES.pricing} ctaLabel="Go Pro" ctaI18n="nav.go_pro" />
  <main>

    <!-- ═══ PAYMENT CANCELLED BANNER ═══ -->
    <div id="paymentCancelledBanner" style="display:none;max-width:720px;margin:24px auto 0;padding:16px 20px;border-radius:14px;background:rgba(255,180,0,.06);border:1px solid rgba(255,180,0,.2);font-size:14px;color:#e0e0e0;backdrop-filter:blur(12px);text-align:center;">
      <span style="margin-right:12px;" data-i18n="price.payment_cancelled">Payment was cancelled. You can try again anytime.</span>
      <button type="button" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:13px;text-decoration:underline;" data-i18n="price.dismiss" onclick="this.closest('div').style.display='none';history.replaceState({},'','/pricing/');">Dismiss</button>
    </div>

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="kicker" data-i18n="price.hero_kicker">Ecosystem pricing</span>
          <h1 data-i18n="price.hero_title">One ecosystem. Clear pricing. Premium at every tier.</h1>
          <p data-i18n="price.hero_desc">VOLYNX products share one account and one token system. Subscribe to what you use, bundle to save, or pay-per-use with tokens.</p>
          <div class="hero-actions">
            <a href="#plans" class="button button--gold" data-i18n="price.hero_cta1">View plans</a>
            <a href={ROUTES.lab} class="button button--ghost" data-i18n="price.hero_cta2">Open the Lab</a>
          </div>
        </div>
        <div class="pricing-hero-visual" aria-hidden="true">
          <img src="/assets/volynx-icon.webp" alt="" class="pricing-hero-icon" width="200" height="200" loading="eager" />
        </div>
      </div>
    </section>

    <!-- ═══ CURRENCY BAR (lang toggle removed — already in topbar) ═══ -->
    <section class="page-section" style="padding-top:32px;">
      <div class="shell">
        <div class="currency-bar">
          <span style="font-size:12px;font-weight:700;letter-spacing:.06em;color:rgba(255,255,255,.45);text-transform:uppercase;" data-i18n="price.currency">Currency</span>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            {['GBP', 'EUR', 'BRL'].map((c) => (
              <button type="button" class={`lcbar__pill ${c === currency ? 'lcbar__pill--active' : ''}`} data-switch-currency={c}>{c}</button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ ECOSYSTEM OVERVIEW ═══ -->
    <section class="page-section" style="padding-bottom:0;">
      <div class="shell grid-3" style="gap:16px;">
        <div class="panel" style="text-align:center;padding:20px;">
          <strong>VOLYNX Builder</strong>
          <p style="margin:6px 0 0;color:var(--muted);font-size:13px;"><span class="i18n-en">Build and publish premium sites</span><span class="i18n-pt">Crie e publique sites premium</span></p>
          <span style="display:inline-block;margin-top:8px;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(34,197,94,.1);color:#22c55e;">LIVE</span>
        </div>
        <div class="panel" style="text-align:center;padding:20px;">
          <strong>VOLYNX Daily</strong>
          <p style="margin:6px 0 0;color:var(--muted);font-size:13px;"><span class="i18n-en">Organize, scan, summarize, write, decide</span><span class="i18n-pt">Organize, escaneie, resuma, escreva, decida</span></p>
          <span style="display:inline-block;margin-top:8px;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(34,197,94,.1);color:#22c55e;">LIVE</span>
        </div>
        <div class="panel" style="text-align:center;padding:20px;">
          <strong>CVitae</strong>
          <p style="margin:6px 0 0;color:var(--muted);font-size:13px;"><span class="i18n-en">Professional CVs. Free to build, pay to export</span><span class="i18n-pt">CVs profissionais. Grátis para criar, pague para exportar</span></p>
          <span style="display:inline-block;margin-top:8px;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(34,197,94,.1);color:#22c55e;">LIVE</span>
        </div>
      </div>
    </section>

    <!-- ═══ BUILDER PLANS ═══ -->
    <section id="plans" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">Builder Plans</span><span class="i18n-pt">Planos do Builder</span></span>
        <h2><span class="i18n-en">Plans ready to sell</span><span class="i18n-pt">Planos prontos para venda</span></h2>
      </div>
      <div class="shell pricing-grid pricing-grid--plans">
        {sitePricing.builderPlans.map((plan) => (
          <PricingCard plan={plan} locale={lang} currency={currency} />
        ))}
      </div>
    </section>

    <!-- ═══ WHAT PRO FEELS LIKE ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <h2 data-i18n="price.pro_section_title">What Pro actually feels like</h2>
        <p data-i18n="price.pro_section_desc">Pro is about working smarter, faster, and with more control over your output.</p>
      </div>
      <div class="shell comparison">
        <div class="comparison-row"><strong data-i18n="price.comp_memory">Workflow memory</strong><span class="check" data-i18n="price.comp_free_memory">No memory</span><span class="check pro" data-i18n="price.comp_pro_memory">Presets, history, reusable recipes</span></div>
        <div class="comparison-row"><strong data-i18n="price.comp_quality">Output quality</strong><span class="check" data-i18n="price.comp_free_quality">Basic modes</span><span class="check pro" data-i18n="price.comp_pro_quality">Premium modes, stronger exports</span></div>
        <div class="comparison-row"><strong data-i18n="price.comp_speed">Comfort and speed</strong><span class="check" data-i18n="price.comp_free_speed">Manual repetition</span><span class="check pro" data-i18n="price.comp_pro_speed">Queues, defaults, faster decision loops</span></div>
        <div class="comparison-row"><strong data-i18n="price.comp_status">Status</strong><span class="check" data-i18n="price.comp_free_status">Discovery mode</span><span class="check pro" data-i18n="price.comp_pro_status">Pro workspace and priority access</span></div>
      </div>
    </section>

    <!-- ═══ DAILY PLANS ═══ -->
    <section id="daily-plans" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">VOLYNX Daily</span><span class="i18n-pt">VOLYNX Daily</span></span>
        <h2><span class="i18n-en">Your daily toolkit. Free to start, Pro to unlock.</span><span class="i18n-pt">Seu kit diário. Comece grátis, evolua com Pro.</span></h2>
      </div>
      <div class="shell pricing-grid pricing-grid--plans" style="max-width:960px;">
        {sitePricing.dailyPlans.map((plan) => (
          <PricingCard plan={plan} locale={lang} currency={currency} />
        ))}
      </div>
    </section>

    <!-- ═══ CVITAE ═══ -->
    <section id="cvitae" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow">CVitae by VOLYNX</span>
        <h2><span class="i18n-en">Professional CVs. Free to build. Pay to export.</span><span class="i18n-pt">CVs profissionais. Grátis para criar. Pague para exportar.</span></h2>
      </div>
      <div class="shell grid-3" style="max-width:960px;gap:16px;">
        <div class="panel" style="padding:24px;">
          <strong><span class="i18n-en">Free</span><span class="i18n-pt">Grátis</span></strong>
          <p style="margin:8px 0 0;color:var(--muted);font-size:13px;line-height:1.6;"><span class="i18n-en">Full editor, live preview, all sections. Your CV builds as you type.</span><span class="i18n-pt">Editor completo, preview ao vivo, todas as seções. Seu CV se constrói enquanto você digita.</span></p>
        </div>
        <div class="panel" style="padding:24px;border-color:rgba(13,148,136,.3);background:rgba(13,148,136,.04);">
          <strong><span class="i18n-en">Professional export</span><span class="i18n-pt">Exportação profissional</span></strong>
          <div style="font-size:1.5rem;font-weight:700;margin:8px 0;">2 tokens</div>
          <p style="margin:0;color:var(--muted);font-size:13px;line-height:1.6;"><span class="i18n-en">Clean PDF, no watermark, ready for any application.</span><span class="i18n-pt">PDF limpo, sem marca d'água, pronto para qualquer candidatura.</span></p>
        </div>
        <div class="panel" style="padding:24px;">
          <strong><span class="i18n-en">CVitae Business</span><span class="i18n-pt">CVitae Business</span></strong>
          <div style="font-size:1.1rem;font-weight:700;margin:8px 0;color:var(--muted);">
            <span class="vx-price" data-currency="GBP">£15</span>
            <span class="vx-price vx-price--hidden" data-currency="EUR">€17.90</span>
            <span class="vx-price vx-price--hidden" data-currency="BRL">R$99</span>
            <span style="font-size:13px;font-weight:400;"><span class="i18n-en">/month</span><span class="i18n-pt">/mês</span></span>
          </div>
          <p style="margin:0;color:var(--muted);font-size:13px;line-height:1.6;"><span class="i18n-en">Unlimited exports, premium templates, multi-CV management.</span><span class="i18n-pt">Exports ilimitados, templates premium, gestão de múltiplos CVs.</span></p>
        </div>
      </div>
    </section>

    <!-- ═══ BUNDLES ═══ -->
    <section id="bundles" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">Save with bundles</span><span class="i18n-pt">Economize com bundles</span></span>
        <h2><span class="i18n-en">Use more than one product? Bundle and save.</span><span class="i18n-pt">Usa mais de um produto? Combine e economize.</span></h2>
      </div>
      <div class="shell grid-2" style="max-width:720px;gap:16px;">
        {sitePricing.bundles.map((b) => (
          <div class="panel" style="padding:24px;border-color:rgba(109,94,252,.2);background:rgba(109,94,252,.03);">
            {b.badge && <span style="display:inline-block;margin-bottom:8px;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(109,94,252,.12);color:#C4B5FD;"><span class="i18n-en">{b.badge.en}</span><span class="i18n-pt">{b.badge.pt}</span></span>}
            <strong style="display:block;font-size:1.1rem;"><span class="i18n-en">{b.name.en}</span><span class="i18n-pt">{b.name.pt}</span></strong>
            <p style="margin:4px 0;color:var(--muted);font-size:13px;"><span class="i18n-en">{b.includes.en}</span><span class="i18n-pt">{b.includes.pt}</span></p>
            <div style="font-size:1.3rem;font-weight:700;margin:8px 0;">
              <span class="vx-price" data-currency="GBP">{b.price.GBP}</span>
              <span class="vx-price vx-price--hidden" data-currency="EUR">{b.price.EUR}</span>
              <span class="vx-price vx-price--hidden" data-currency="BRL">{b.price.BRL}</span>
              <span style="font-size:13px;font-weight:400;"><span class="i18n-en">{b.billing.en}</span><span class="i18n-pt">{b.billing.pt}</span></span>
            </div>
            <p style="margin:0 0 12px;color:var(--muted);font-size:12px;"><span class="i18n-en">{b.savings.en}</span><span class="i18n-pt">{b.savings.pt}</span></p>
            <p style="margin:0;color:var(--muted);font-size:13px;line-height:1.5;"><span class="i18n-en">{b.description.en}</span><span class="i18n-pt">{b.description.pt}</span></p>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ TOKEN PACKS ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">VOLYNX Tokens</span><span class="i18n-pt">VOLYNX Tokens</span></span>
        <h2><span class="i18n-en">One currency. Every product. Never expire.</span><span class="i18n-pt">Uma moeda. Todo o ecossistema. Sem expiração.</span></h2>
        <p style="color:var(--muted);max-width:560px;margin:8px auto 0;font-size:14px;line-height:1.6;"><span class="i18n-en">Use tokens across Builder, Daily, CVitae and all future products. Buy once, use anywhere.</span><span class="i18n-pt">Use tokens no Builder, Daily, CVitae e em todos os futuros produtos. Compre uma vez, use em qualquer lugar.</span></p>
      </div>
      <div class="shell grid-2">
        {sitePricing.tokenPacks.map((pack) => (
          <TokenPackCard pack={pack} locale={lang} currency={currency} />
        ))}
      </div>
    </section>

    <!-- ═══ USAGE MATRIX ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">Usage Matrix</span><span class="i18n-pt">Matriz de uso</span></span>
        <h2><span class="i18n-en">Cost per action type</span><span class="i18n-pt">Custo por tipo de ação</span></h2>
      </div>
      <div class="shell grid-3">
        {sitePricing.toolUsage.map((item) => (
          <ToolUsageCard item={item} locale={lang} currency={currency} />
        ))}
      </div>
    </section>

    <!-- ═══ ADD-ONS ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="price.addons">Add-ons</span>
        <h2><span class="i18n-en">Extras to boost value</span><span class="i18n-pt">Extras para aumentar valor</span></h2>
      </div>
      <div class="shell grid-3">
        {sitePricing.builderAddons.map((addon) => (
          <AddonCard addon={addon} locale={lang} currency={currency} />
        ))}
      </div>
    </section>

    <!-- ═══ FAQ ═══ -->
    <section class="page-section page-section--last">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="price.faq_heading">FAQ</span>
        <h2><span class="i18n-en">Frequently asked questions</span><span class="i18n-pt">Perguntas frequentes</span></h2>
      </div>
      <div class="shell grid-2">
        {faqs.map((f) => (
          <details class="panel" style="cursor:pointer;">
            <summary style="font-weight:700;font-size:15px;list-style:none;" data-i18n={f.qKey}>{f.qFallback}</summary>
            <p style="margin:10px 0 0;color:var(--muted);line-height:1.7;" data-i18n={f.aKey}>{f.aFallback}</p>
          </details>
        ))}
      </div>
    </section>

  </main>

  <style>
    .page-pricing .hero-copy h1 {
      margin: 12px auto 16px;
    }
    .page-pricing .hero-grid {
      align-items: center;
    }
    .pricing-hero-visual {
      display:none;
      place-items:center;
      justify-content:center;
      overflow:hidden;
    }
    .pricing-hero-icon {
      width:min(650px, 100%);
      height:auto;
      filter:drop-shadow(0 24px 56px rgba(0,0,0,.4));
      animation:floatIcon 4s ease-in-out infinite;
      border-left:1px inset;
      margin:0;
    }
    @keyframes floatIcon {
      0%, 100% { transform:translateY(0); }
      50% { transform:translateY(-12px); }
    }
    @media (min-width:1024px) {
      .pricing-hero-visual { display:grid; }
    }
    .currency-bar { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 20px; border-radius:14px; border:1px solid rgba(255,255,255,.06); background:rgba(255,255,255,.03); }
    .lcbar__pill { padding:6px 14px; border-radius:999px; font-size:12px; font-weight:700; letter-spacing:.06em; border:1px solid rgba(255,255,255,.08); background:rgba(255,255,255,.03); color:rgba(255,255,255,.45); cursor:pointer; transition:all .15s; }
    .lcbar__pill:hover { border-color:rgba(255,255,255,.15); color:rgba(255,255,255,.7); }
    .lcbar__pill--active { background:rgba(109,94,252,.12); border-color:rgba(109,94,252,.35); color:#C4B5FD; }
    .vx-price--hidden, .pricing-card__price--hidden { display:none !important; }
  </style>

  <script is:inline>
    // Currency switcher
    document.querySelectorAll('[data-switch-currency]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var target = btn.dataset.switchCurrency;
        if (!target) return;
        document.querySelectorAll('[data-switch-currency]').forEach(function(p) { p.classList.remove('lcbar__pill--active'); });
        btn.classList.add('lcbar__pill--active');
        document.querySelectorAll('[data-currency]').forEach(function(el) {
          var curr = el.dataset.currency;
          el.classList.toggle('vx-price--hidden', curr !== target);
          el.classList.toggle('pricing-card__price--hidden', curr !== target);
        });
        var url = new URL(window.location.href);
        url.searchParams.set('currency', target);
        history.replaceState(null, '', url.toString());
      });
    });
  </script>

  <FlagshipFooter />

  <!-- Pix checkout helper -->
  <script is:inline src="/js/vx-pix.js"></script>

  <!-- Checkout + Plan detection -->
  <script is:inline type="module">
    const PLAN_KEYS = ['free', 'launch', 'pro', 'studio', 'teams'];
    const urlParams = new URLSearchParams(window.location.search);

    // Show cancelled banner if redirected from Stripe
    if (urlParams.get('payment') === 'cancelled') {
      const cb = document.getElementById('paymentCancelledBanner');
      if (cb) cb.style.display = '';
      history.replaceState({}, '', '/pricing/');
    }
    const currency = (urlParams.get('currency') || 'GBP').toLowerCase();

    let cfg = null;
    let token = localStorage.getItem('volynx_access_token') || '';
    const refreshToken = localStorage.getItem('volynx_refresh_token') || '';

    try { cfg = await fetch('/config.json', { cache: 'no-store' }).then(r => r.json()); } catch {}
    const apiBase = (cfg?.functionsUrl || cfg?.apiBaseUrl || '').replace(/\/$/, '');

    if (token && refreshToken && cfg?.supabaseUrl && cfg?.supabaseAnonKey) {
      try {
        const rr = await fetch(cfg.supabaseUrl + '/auth/v1/token?grant_type=refresh_token', {
          method: 'POST',
          headers: { apikey: cfg.supabaseAnonKey, 'Content-Type': 'application/json' },
          body: JSON.stringify({ refresh_token: refreshToken }),
        });
        if (rr.ok) {
          const sess = await rr.json();
          if (sess.access_token) {
            token = sess.access_token;
            localStorage.setItem('volynx_access_token', sess.access_token);
            if (sess.refresh_token) localStorage.setItem('volynx_refresh_token', sess.refresh_token);
          }
        }
      } catch {}
    }

    document.querySelectorAll('.pricing-card__cta').forEach((btn, idx) => {
      const planKey = PLAN_KEYS[idx];
      if (planKey === 'free') return;
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        if (!token) { window.location.href = '/login/?next=/pricing/'; return; }
        if (!apiBase) { alert('Checkout not configured.'); return; }
        const lookupKey = planKey === 'teams' ? 'builder_teams_' + currency : 'builder_' + planKey + '_' + currency;
        btn.textContent = 'Redirecting...';
        btn.style.pointerEvents = 'none';
        try {
          const res = await fetch(apiBase + '/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ lookup_key: lookupKey, success_url: window.location.origin + '/profile/?payment=success', cancel_url: window.location.origin + '/pricing/?payment=cancelled' }),
          });
          const data = await res.json();
          if (data.url) window.location.href = data.url;
          else { alert(data.error || data.msg || data.message || 'Checkout failed. Please try again.'); btn.textContent = 'Try again'; btn.style.pointerEvents = ''; }
        } catch { alert('Connection error. Please check your network and try again.'); btn.textContent = 'Try again'; btn.style.pointerEvents = ''; }
      });
    });

    // ── Token pack: Stripe checkout (card) ──
    document.querySelectorAll('.token-card__cta').forEach((btn, idx) => {
      const packKeys = ['tokens_starter', 'tokens_core', 'tokens_pro', 'tokens_scale'];
      const packKey = packKeys[idx];
      if (!packKey) return;
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        if (!token) { window.location.href = '/login/?next=/pricing/'; return; }
        if (!apiBase) return;
        btn.textContent = 'Redirecting...';
        try {
          const res = await fetch(apiBase + '/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ lookup_key: packKey + '_' + currency }),
          });
          const data = await res.json();
          if (data.url) window.location.href = data.url;
          else { alert(data.error || data.msg || data.message || 'Checkout failed. Please try again.'); btn.textContent = 'Buy'; }
        } catch { btn.textContent = 'Buy'; }
      });
    });

    // ── Token pack: Pix checkout (BRL only) ──
    // Show Pix buttons when currency is BRL
    if (currency === 'brl') {
      document.querySelectorAll('.token-card__pix').forEach(btn => {
        btn.style.display = 'flex';
      });
    }

    document.querySelectorAll('.token-card__pix').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        if (!token) { window.location.href = '/login/?next=/pricing/'; return; }
        const packLookup = btn.getAttribute('data-pix-pack');
        if (!packLookup || !window.VxPix) return;
        window.VxPix.checkout(packLookup);
      });
    });

    // ── Add-ons: checkout via Stripe ──
    document.querySelectorAll('.addon-card__cta').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (!token) { window.location.href = '/login/?next=/pricing/'; return; }
        if (!apiBase) return;
        const addonKey = btn.getAttribute('data-addon-key');
        if (!addonKey) return;
        const lookupKey = addonKey + '_' + currency;
        btn.textContent = '...';
        btn.style.pointerEvents = 'none';
        try {
          const res = await fetch(apiBase + '/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ lookup_key: lookupKey }),
          });
          const data = await res.json();
          if (data.url) window.location.href = data.url;
          else { alert(data.error || 'Checkout failed.'); btn.textContent = 'Add'; btn.style.pointerEvents = ''; }
        } catch { btn.textContent = 'Add'; btn.style.pointerEvents = ''; }
      });
    });

    // Clicking the card itself also triggers the button
    document.querySelectorAll('.addon-card').forEach(card => {
      card.addEventListener('click', (e) => {
        if (e.target.closest('.addon-card__cta')) return;
        const btn = card.querySelector('.addon-card__cta');
        if (btn) btn.click();
      });
    });

    if (token && apiBase) {
      try {
        const res = await fetch(apiBase + '/check-permission', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
          body: JSON.stringify({ tool: 'converter' }),
        });
        if (res.ok) {
          const perm = await res.json();
          const plan = perm.effective_tier || perm.builder_plan || perm.builderPlan || perm.plan || 'free';
          if (!perm.useLocalStorage) {
            const cards = document.querySelectorAll('.pricing-card');
            const idx = PLAN_KEYS.indexOf(plan);
            if (idx >= 0 && cards[idx]) {
              cards[idx].style.borderColor = 'rgba(52,211,153,.35)';
              cards[idx].style.boxShadow = '0 0 24px rgba(52,211,153,.08)';
              const name = cards[idx].querySelector('.pricing-card__name');
              if (name) { const b = document.createElement('span'); b.textContent = ' ✓ Your plan'; b.style.cssText = 'font-size:12px;color:#34D399;font-weight:700;'; name.appendChild(b); }
              const cta = cards[idx].querySelector('.pricing-card__cta');
              if (cta && plan !== 'free') {
                cta.textContent = 'Current plan ✓';
                cta.style.cssText = 'background:rgba(52,211,153,.08);border-color:rgba(52,211,153,.25);color:#34D399;pointer-events:none;display:flex;justify-content:center;padding:12px;border-radius:14px;text-decoration:none;font-weight:600;font-size:14px;';

                // Add "Manage subscription" link below the current plan CTA
                const manageBtn = document.createElement('button');
                manageBtn.textContent = 'Manage subscription';
                manageBtn.className = 'pricing-card__manage';
                manageBtn.style.cssText = 'display:flex;align-items:center;justify-content:center;width:100%;padding:10px;margin-top:8px;border-radius:12px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.03);color:rgba(255,255,255,.5);font-size:13px;font-weight:500;cursor:pointer;transition:all .2s;';
                manageBtn.onmouseenter = () => { manageBtn.style.background = 'rgba(255,80,80,.06)'; manageBtn.style.borderColor = 'rgba(255,80,80,.2)'; manageBtn.style.color = 'rgba(255,120,120,.8)'; };
                manageBtn.onmouseleave = () => { manageBtn.style.background = 'rgba(255,255,255,.03)'; manageBtn.style.borderColor = 'rgba(255,255,255,.08)'; manageBtn.style.color = 'rgba(255,255,255,.5)'; };
                manageBtn.addEventListener('click', async () => {
                  manageBtn.textContent = 'Opening...';
                  manageBtn.style.pointerEvents = 'none';
                  try {
                    const portalRes = await fetch(apiBase + '/create-portal-session', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
                      body: JSON.stringify({ return_url: window.location.origin + '/pricing/' }),
                    });
                    const portalData = await portalRes.json();
                    if (portalData.url) window.location.href = portalData.url;
                    else { alert(portalData.error || 'Could not open subscription manager.'); manageBtn.textContent = 'Manage subscription'; manageBtn.style.pointerEvents = ''; }
                  } catch { alert('Connection error.'); manageBtn.textContent = 'Manage subscription'; manageBtn.style.pointerEvents = ''; }
                });
                cta.parentElement.appendChild(manageBtn);
              } else if (cta && plan === 'free') {
                // Free plan - no change needed
              }
            }
          }
        }
      } catch {}
    }
  </script>
</FlagshipLayout>
