    .vx-acceptance-card--stripe { border-color: rgba(196,181,253,.18); }
    .vx-acceptance-card__status {
      display: inline-flex;
      margin-bottom: 10px;
      padding: 5px 9px;
      border-radius: 999px;
      color: #5eead4;
      background: rgba(94,234,212,.08);
      border: 1px solid rgba(94,234,212,.18);
      font-size: .66rem;
      font-weight: 900;
      letter-spacing: .11em;
      text-transform: uppercase;
    }
    .vx-acceptance-card strong {
      display: block;
      color: #fff;
      font-family: var(--display);
      font-size: 1.18rem;
      letter-spacing: -.035em;
      line-height: 1.05;
    }
    .vx-acceptance-card p {
      margin: 9px 0 0;
      color: rgba(226,232,240,.68);
      font-size: .86rem;
      line-height: 1.45;
    }
    .vx-price--hidden, .pricing-card__price--hidden { display:none !important; }
    .cvitae-mini-icon { width: 86px; height: 86px; object-fit: contain; margin: 0 0 14px; filter: drop-shadow(0 16px 32px rgba(0,0,0,.38)); }
    .cvitae-actions { display:flex; flex-wrap:wrap; justify-content:center; gap:12px; margin-top:20px; }
    .cvitae-actions :global(.button) { min-width:180px; justify-content:center; }
    .pricing-card__footnote {
      margin: 12px 0 0;
      color: rgba(255,255,255,.52);
      font-size: 12px;
      line-height: 1.55;
    }
    .pricing-card--propertyflow {
      position: relative;
      display: flex;
      flex-direction: column;
      min-height: 100%;
      min-width: 0;
      padding: 26px;
      box-sizing: border-box;
      border-radius: 26px;
      border: 1px solid rgba(255,255,255,.08);
      background:
        radial-gradient(circle at 50% 0%, rgba(214,179,106,.14), transparent 34%),
        linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.025));
      box-shadow: 0 28px 72px rgba(0,0,0,.24);
      overflow: hidden;
      isolation: isolate;
      transition: transform .28s ease, border-color .28s ease, box-shadow .28s ease;
    }
    .pricing-grid--propertyflow {
      gap: 24px;
      align-items: stretch;
    }
    .pricing-card--propertyflow::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(135deg, rgba(255,255,255,.08), transparent 34%, rgba(109,94,252,.08));
      opacity: .52;
      pointer-events: none;
    }
    .pricing-card--propertyflow:hover {
      transform: translateY(-6px);
      border-color: rgba(214,179,106,.24);
      box-shadow: 0 36px 90px rgba(0,0,0,.34), 0 0 0 1px rgba(214,179,106,.08);
    }
    .pricing-card--propertyflow.pricing-card--featured {
      border-color: rgba(214,179,106,.34);
      background:
        radial-gradient(circle at 50% 0%, rgba(214,179,106,.2), transparent 36%),
        linear-gradient(180deg, rgba(214,179,106,.09), rgba(255,255,255,.025));
    }
    .pf-card-art {
      display: grid;
      place-items: center;
      min-height: 166px;
      margin: -6px -6px 16px;
      border-radius: 22px;
      background:
        radial-gradient(circle at 50% 42%, rgba(255,255,255,.14), transparent 34%),
        linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.015));
      border: 1px solid rgba(255,255,255,.07);
      overflow: hidden;
    }
    .pf-card-art img {
      width: min(220px, 88%);
      height: auto;
      object-fit: contain;
      filter: drop-shadow(0 22px 38px rgba(0,0,0,.42));
      transition: transform .32s ease, filter .32s ease;
    }
    .pricing-card--propertyflow:hover .pf-card-art img {
      transform: translateY(-4px) scale(1.05);
      filter: drop-shadow(0 28px 48px rgba(0,0,0,.5));
    }
    .pricing-card--propertyflow .pricing-card__head {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
      margin-bottom: 18px;
      min-width: 0;
    }
    .pricing-card--propertyflow .pricing-pill {
      position: absolute;
      top: 18px;
      right: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: 4px 12px;
      border-radius: 999px;
      background: rgba(214,179,106,.14);
      border: 1px solid rgba(214,179,106,.32);
      color: #fff2c6;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
      box-shadow: 0 12px 28px rgba(0,0,0,.28);
      z-index: 2;
    }
    .pricing-card--propertyflow .pricing-card__name {
      margin: 0 0 8px;
      color: #fff;
      font-size: clamp(1.22rem, 1.65vw, 1.5rem);
      letter-spacing: -.02em;
      line-height: 1.12;
      overflow-wrap: normal;
    }
    .pricing-card--propertyflow .pricing-card__desc {
      margin: 0;
      color: rgba(255,255,255,.58);
      font-size: 13px;
      line-height: 1.55;
      min-height: 62px;
    }
    .pricing-card--propertyflow .pricing-card__price-block {
      width: 100%;
      min-width: 0;
      max-width: none;
      text-align: left;
      flex-shrink: 1;
      padding: 14px 0 2px;
      border-top: 1px solid rgba(255,255,255,.06);
    }
    .pricing-card--propertyflow .pricing-card__price {
      display: block;
      color: #fff;
      font-size: clamp(2rem, 3.3vw, 2.48rem);
      font-weight: 900;
      letter-spacing: -.06em;
      line-height: 1;
      white-space: nowrap;
      word-break: normal;
      overflow: visible;
    }
    .pricing-card--propertyflow .pricing-card__billing {
      display: block;
      margin-top: 6px;
      color: rgba(255,255,255,.46);
      font-size: 12px;
      line-height: 1.35;
    }
    .pricing-card--propertyflow .pricing-card__features {
      list-style: none;
      padding: 0;
      margin: 0 0 20px;
      flex: 1;
      text-align: left;
    }
    .pricing-card--propertyflow .pricing-card__features li {
      padding: 8px 0;
      border-bottom: 1px solid rgba(255,255,255,.05);
      color: rgba(255,255,255,.74);
      font-size: 14px;
    }
    .pricing-card--propertyflow .pricing-card__features li::before {
      content: "✓ ";
      color: #34D399;
      font-weight: 800;
    }
    .pricing-card--propertyflow .pricing-card__cta {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      padding: 12px;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,.12);
      background: rgba(255,255,255,.045);
      color: rgba(255,255,255,.78);
      text-decoration: none;
      font-weight: 700;
      transition: background .2s ease, border-color .2s ease, color .2s ease;
    }
    .pricing-card--propertyflow .pricing-card__cta:hover {
      background: rgba(255,255,255,.09);
      border-color: rgba(255,255,255,.2);
      color: #fff;
    }
    .pricing-card--propertyflow .pricing-card__cta--primary {
      background: rgba(214,179,106,.18);
      border-color: rgba(214,179,106,.38);
      color: #fff2c6;
    }
    .pricing-card--propertyflow .pricing-card__cta--primary:hover {
      background: rgba(214,179,106,.26);
      border-color: rgba(214,179,106,.52);
    }
    .qrgen-pricing-section {
      position: relative;
      overflow: hidden;
      border-block: 1px solid rgba(125,249,255,.10);
      background: linear-gradient(180deg, rgba(5,9,16,0), rgba(6,18,22,.36) 48%, rgba(5,9,16,0));
    }
    .qrgen-pricing-hero {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(220px, 360px);
      align-items: center;
      gap: clamp(18px, 3vw, 44px);
      margin-bottom: 24px;
      padding: clamp(24px, 4vw, 44px);
      border-radius: 8px;
      border: 1px solid rgba(125,249,255,.16);
      background:
        linear-gradient(135deg, rgba(125,249,255,.09), rgba(32,227,178,.035)),
        rgba(255,255,255,.025);
      box-shadow: 0 28px 78px rgba(0,0,0,.28);
      overflow: hidden;
      isolation: isolate;
    }
    .qrgen-pricing-hero__copy {
      position: relative;
      z-index: 1;
      display: grid;
      gap: 14px;
      max-width: 680px;
    }
    .qrgen-pricing-hero__pill {
      width: max-content;
      max-width: 100%;
      padding: 5px 12px;
      border-radius: 999px;
      border: 1px solid rgba(32,227,178,.26);
      background: rgba(32,227,178,.10);
      color: #7df9ff;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .qrgen-pricing-hero__copy strong {
      color: #fff;
      font-size: clamp(2rem, 5vw, 4.6rem);
      line-height: .94;
      letter-spacing: 0;
    }
    .qrgen-pricing-hero__copy p {
      margin: 0;
      color: rgba(226,232,240,.70);
      font-size: clamp(1rem, 1.4vw, 1.12rem);
      line-height: 1.65;
    }
    .qrgen-pricing-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 6px;
    }
    .qrgen-pricing-hero__art {
      position: relative;
      z-index: 1;
      width: min(100%, 330px);
      justify-self: center;
      height: auto;
      object-fit: contain;
      filter: drop-shadow(0 28px 58px rgba(0,0,0,.48));
      transform: rotate(2deg);
    }
    .qrgen-pricing-grid {
      position: relative;
    }
    :global(.qrgen-pricing-grid .pricing-card__head) {
      display: grid;
      gap: 18px;
      padding-right: min(132px, 32%);
    }
    :global(.qrgen-pricing-grid .pricing-card__price-block) {
      align-items: flex-start;
      max-width: none;
      text-align: left;
    }
    @media (max-width: 1120px) and (min-width: 768px) {
      .pricing-grid--propertyflow {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        max-width: 840px !important;
      }
    }
    @media (max-width: 767px) {
      .pricing-card--propertyflow {
        padding: 22px;
        text-align: center;
      }
      .pf-card-art {
        min-height: 150px;
        margin-bottom: 14px;
      }
      .pf-card-art img {
        width: min(200px, 86%);
      }
      .pricing-card--propertyflow .pricing-card__head {
        align-items: center;
        text-align: center;
      }
      .pricing-card--propertyflow .pricing-card__price-block {
        text-align: center;
        max-width: none;
      }
      .pricing-card--propertyflow .pricing-card__desc {
        min-height: 0;
      }
      .pricing-card--propertyflow .pricing-pill {
        top: 16px;
        right: 16px;
      }
      .qrgen-pricing-hero {
        grid-template-columns: 1fr;
        text-align: center;
        padding: 26px 20px 28px;
      }
      .qrgen-pricing-hero__copy,
      .qrgen-pricing-hero__pill {
        justify-items: center;
        margin-inline: auto;
      }
      .qrgen-pricing-hero__actions {
        justify-content: center;
      }
      .qrgen-pricing-hero__art {
        width: min(230px, 72vw);
        transform: none;
      }
      :global(.qrgen-pricing-grid .pricing-card__head) {
        padding-right: 0;
      }
    }

    /* Hero subcopy */
    .hero-subcopy { margin-top:14px; color:var(--muted); font-size:14px; line-height:1.65; max-width:640px; }

    /* How it works grid — hero icons, centered, premium */
    .how-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
      max-width: 1240px;
      margin: 0 auto;
    }
    .how-card {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 18px;
      padding: 28px 22px 26px;
      border-radius: 28px;
      border: 1px solid rgba(255, 255, 255, .08);
      background: linear-gradient(180deg, rgba(255, 255, 255, .045), rgba(255, 255, 255, .02));
      box-shadow: 0 30px 70px rgba(0, 0, 0, .22);
      overflow: hidden;
      isolation: isolate;
      font-size: 14px;
      transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease;
    }
    .how-card:hover {
      transform: translateY(-5px);
      border-color: rgba(255, 255, 255, .16);
      box-shadow: 0 40px 90px rgba(0, 0, 0, .32);
    }
    .how-card::before {
      content: "";
      position: absolute;
      inset: -20% -10% auto -10%;
      height: 80%;
      border-radius: 50%;
      opacity: .55;
      z-index: 0;
      pointer-events: none;
      filter: blur(34px);
      background: radial-gradient(circle, rgba(255, 255, 255, .14), rgba(255, 255, 255, 0));
    }
    .how-card > * { position: relative; z-index: 1; }
    .how-card__art-shell {
      position: relative;
      display: grid;
      place-items: center;
      width: 100%;
      max-width: 320px;
      aspect-ratio: 1 / 1;
      border-radius: 36px;
      border: 1px solid rgba(255, 255, 255, .1);
      background:
        radial-gradient(circle at 50% 30%, rgba(255, 255, 255, .12), transparent 55%),
        linear-gradient(180deg, rgba(255, 255, 255, .07), rgba(255, 255, 255, .02));
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .06), 0 22px 44px rgba(0, 0, 0, .28);
      overflow: hidden;
    }
    .how-card__art-shell::before {
      content: "";
      position: absolute;
      inset: 18px;
      border-radius: 28px;
      background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, .14), rgba(255, 255, 255, 0));
      opacity: .85;
    }
    .how-card__art {
      position: relative;
      z-index: 1;
      width: 78%;
      height: 78%;
      object-fit: contain;
      filter: drop-shadow(0 22px 44px rgba(0, 0, 0, .42));
      transition: transform .35s ease, filter .35s ease;
    }
    .how-card__art--icon {
      width: 56%;
      height: 56%;
    }
    .how-card:hover .how-card__art {
      transform: translateY(-4px) scale(1.04);
      filter: drop-shadow(0 28px 56px rgba(0, 0, 0, .52));
    }
    .how-card__equation {
      display: grid;
      gap: 8px;
      max-width: 26ch;
      justify-items: center;
    }
    .how-card strong {
      color: #fff;
      font-weight: 800;
      font-size: 1.18rem;
      letter-spacing: -0.02em;
    }
    .how-card .how-eq {
      color: rgba(255, 255, 255, .35);
      font-weight: 700;
      font-size: 1.1rem;
      line-height: 1;
    }
    .how-card .how-val {
      color: var(--muted);
      line-height: 1.55;
      font-size: 1rem;
    }
    .how-card--plan::before {
      background:radial-gradient(circle, rgba(45,212,191,.22), rgba(45,212,191,0));
    }
    .how-card--vx::before {
      background:radial-gradient(circle, rgba(251,191,36,.26), rgba(251,191,36,0));
    }
    .how-card--bundle::before {
      background:radial-gradient(circle, rgba(129,140,248,.24), rgba(129,140,248,0));
    }
    .how-card--addon::before {
      background:radial-gradient(circle, rgba(56,189,248,.24), rgba(56,189,248,0));
    }

    /* Start guidance — keep the premium icon contained inside the panel */
    .guidance-panel {
      position: relative;
      overflow: hidden;
    }
    .guidance-head {
      display: grid;
      justify-items: center;
      gap: 10px;
      max-width: 760px;
      margin: 0 auto 28px;
      text-align: center;
    }
    .guidance-icon {
      display: block;
      width: clamp(86px, 9vw, 128px);
      max-width: min(128px, 42vw);
      height: auto;
      margin: -4px auto 2px;
      object-fit: contain;
      filter: drop-shadow(0 16px 34px rgba(0, 0, 0, .38));
    }
    .guidance-head h2 {
      margin: 0;
    }
    .guidance-head p {
      margin: 0 auto;
      max-width: 58ch;
      color: var(--muted);
      line-height: 1.65;
    }
    .guidance-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
    }
    .guidance-card {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 0;
      padding: 22px 18px 24px;
      border-radius: 24px;
      border: 1px solid rgba(255,255,255,.08);
      background:
        radial-gradient(circle at 50% 0%, rgba(255,255,255,.08), transparent 44%),
        linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.018));
      text-align: center;
      overflow: hidden;
      isolation: isolate;
    }
    .guidance-card::before {
      content: "";
      position: absolute;
      inset: -28% 6% auto;
      height: 52%;
      border-radius: 999px;
      background: radial-gradient(circle, rgba(214,179,106,.18), transparent 70%);
      filter: blur(28px);
      z-index: -1;
    }
    .guidance-card-icon {
      display: grid;
      place-items: center;
      width: clamp(104px, 9vw, 138px);
      height: clamp(104px, 9vw, 138px);
      margin: -4px auto 10px;
      flex-shrink: 0;
    }
    .guidance-card-icon img {
      width: 118%;
      height: 118%;
      object-fit: contain;
      filter: drop-shadow(0 18px 34px rgba(0,0,0,.42));
    }
    .guidance-card h3 {
      margin: 0 0 10px;
      color: #fff;
      font-size: clamp(1.05rem, 1.35vw, 1.2rem);
      line-height: 1.12;
    }
    .guidance-card p {
      margin: 0;
      color: var(--muted);
      font-size: .92rem;
      line-height: 1.62;
    }
    .guidance-cta {
      position: relative;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: clamp(30px, 4vw, 46px);
      padding-top: 26px;
    }
    .guidance-cta::before {
      content: "";
      position: absolute;
      top: 0;
      left: 50%;
      width: min(560px, 82%);
      height: 1px;
      transform: translateX(-50%);
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.12), transparent);
    }
    @media (max-width: 980px) {
      .guidance-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 620px) {
      .guidance-grid { grid-template-columns: 1fr; }
      .guidance-card { padding: 24px 20px; }
      .guidance-cta {
        display: grid;
        gap: 10px;
        margin-top: 32px;
      }
      .guidance-card-icon {
        width: min(170px, 52vw);
        height: min(170px, 52vw);
      }
    }

    /* VX lead block */
    .vx-lead { max-width:720px; margin:0 auto 24px; padding:20px 22px; border-radius:16px; border:1px solid rgba(52,211,153,.18); background:linear-gradient(180deg,rgba(52,211,153,.06),rgba(52,211,153,.02)); text-align:center; }
    .vx-lead p { margin:0; color:rgba(255,255,255,.78); font-size:14px; line-height:1.7; }
    .vx-lead strong { color:#34D399; }

    /* Checkout support — animated, premium notice with gradient border */
    .checkout-support {
      position: relative;
      max-width: 820px;
      margin: 28px auto 0;
      padding: 22px 28px 22px 64px;
      border-radius: 18px;
      border: 1px solid rgba(196, 181, 253, .25);
      background:
        radial-gradient(circle at 0% 50%, rgba(109, 94, 252, .14), transparent 50%),
        radial-gradient(circle at 100% 50%, rgba(45, 212, 191, .10), transparent 55%),
        linear-gradient(180deg, rgba(255, 255, 255, .035), rgba(255, 255, 255, .015));
      color: rgba(255, 255, 255, .82);
      font-size: 14px;
      line-height: 1.7;
      text-align: left;
      box-shadow: 0 22px 56px rgba(109, 94, 252, .14);
      overflow: hidden;
    }
    .checkout-support::before {
      content: "";
      position: absolute;
      left: 22px;
      top: 50%;
      transform: translateY(-50%);
      width: 30px;
      height: 30px;
      border-radius: 999px;
      background:
        radial-gradient(circle at 50% 50%, rgba(196, 181, 253, .9), rgba(196, 181, 253, .15) 60%, transparent 70%);
      animation: checkoutPulse 2.6s ease-in-out infinite;
      pointer-events: none;
    }
    .checkout-support::after {
      content: "i";
      position: absolute;
      left: 22px;
      top: 50%;
      transform: translateY(-50%);
      width: 30px;
      height: 30px;
      display: grid;
      place-items: center;
      font-family: Georgia, "Times New Roman", serif;
      font-style: italic;
      font-size: 18px;
      font-weight: 700;
      color: #1a0e3a;
      background: linear-gradient(135deg, #C4B5FD, #67e8f9);
      border-radius: 999px;
      box-shadow: 0 0 18px rgba(196, 181, 253, .6), inset 0 1px 0 rgba(255, 255, 255, .55);
    }
    @keyframes checkoutPulse {
      0%, 100% { opacity: .9; transform: translateY(-50%) scale(1); }
      50%      { opacity: .35; transform: translateY(-50%) scale(1.6); }
    }
    .checkout-support strong {
      display: inline;
      color: #fff;
      font-weight: 700;
    }
    @media (max-width: 540px) {
      .checkout-support { padding: 56px 22px 22px; text-align: center; }
      .checkout-support::before, .checkout-support::after {
        left: 50%; top: 22px; transform: translateX(-50%);
      }
    }

    /* Trust block */
    .trust-block { max-width:860px; margin:40px auto 0; display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:10px; padding:20px; border-radius:16px; border:1px solid rgba(255,255,255,.06); background:rgba(255,255,255,.02); }
    .trust-block__item { display:flex; align-items:flex-start; gap:8px; font-size:13px; color:rgba(255,255,255,.7); line-height:1.5; }
    .trust-block__item::before { content:"✓"; color:#34D399; font-weight:700; flex:none; }
    @media (max-width: 767px) {
      .page-pricing .hero-copy h1 { margin-left: 0; margin-right: 0; }
