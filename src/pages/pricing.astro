  <script is:inline>
    // Premium inline toast helper — replaces native vxToast() so checkout
    // failures don't yank the user into a system dialog mid-funnel.
    // Auto-dismisses after 6s; supports a "Try again" affordance via the
    // calling site (button state is reset there).
    function vxToast(msg, opts) {
      opts = opts || {};
      var type = opts.type || 'error';
      var el = document.getElementById('vxCheckoutToast');
      if (!el) {
        el = document.createElement('div');
        el.id = 'vxCheckoutToast';
        el.setAttribute('role', 'status');
        el.setAttribute('aria-live', 'polite');
        el.style.cssText = 'position:fixed;left:50%;bottom:28px;transform:translateX(-50%) translateY(0);max-width:min(560px,calc(100% - 32px));padding:14px 56px 14px 20px;border-radius:14px;border:1px solid;background:rgba(15,16,28,.96);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);color:#fff;font-size:14px;line-height:1.5;z-index:99999;box-shadow:0 22px 56px rgba(0,0,0,.5);opacity:0;transition:opacity .25s ease, transform .25s ease;pointer-events:auto;letter-spacing:.01em;';
        var close = document.createElement('button');
        close.type = 'button';
        close.setAttribute('aria-label', 'Close');
        close.style.cssText = 'position:absolute;top:8px;right:10px;width:28px;height:28px;background:transparent;border:0;color:rgba(255,255,255,.55);cursor:pointer;font-size:20px;line-height:1;border-radius:8px;';
        close.textContent = '×';
        close.addEventListener('click', function(){ el.style.opacity='0'; });
        el.appendChild(close);
        var msgEl = document.createElement('span');
        msgEl.id = 'vxCheckoutToastMsg';
        el.appendChild(msgEl);
        document.body.appendChild(el);
      }
      el.style.borderColor = type === 'error' ? 'rgba(255,107,107,.55)' : 'rgba(45,212,191,.55)';
      var msgEl = document.getElementById('vxCheckoutToastMsg');
      if (msgEl) msgEl.textContent = msg;
      el.style.opacity = '1';
      el.style.transform = 'translateX(-50%) translateY(0)';
      clearTimeout(el._t);
      el._t = setTimeout(function(){ el.style.opacity = '0'; }, opts.duration || 6000);
    }

    // Currency switcher
    function normalizePricingCurrency(value) {
      value = String(value || '').toUpperCase();
      return /^(GBP|EUR|BRL)$/.test(value) ? value : 'GBP';
    }

    function applyPricingCurrency(target, updateUrl) {
      target = normalizePricingCurrency(target);
      document.querySelectorAll('[data-switch-currency]').forEach(function(p) {
        var active = p.dataset.switchCurrency === target;
        p.classList.toggle('lcbar__pill--active', active);
        p.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      document.querySelectorAll('[data-currency]').forEach(function(el) {
        var curr = el.dataset.currency;
        el.classList.toggle('vx-price--hidden', curr !== target);
        el.classList.toggle('pricing-card__price--hidden', curr !== target);
      });
      document.querySelectorAll('.token-card__pix').forEach(function(el) {
        el.style.display = target === 'BRL' && window.__volynxPixEnabled === true ? 'flex' : 'none';
      });
      if (updateUrl) {
        var url = new URL(window.location.href);
        url.searchParams.set('currency', target);
        history.replaceState(null, '', url.toString());
      }
      try { localStorage.setItem('volynx_currency', target); } catch {}
      try {
        window.dispatchEvent(new CustomEvent('vx:currency-changed', {
          detail: { code: target, currency: target.toLowerCase() }
        }));
      } catch {}
    }

    document.querySelectorAll('[data-switch-currency]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var target = btn.dataset.switchCurrency;
        if (!target) return;
        applyPricingCurrency(target, true);
      });
    });
    applyPricingCurrency(new URLSearchParams(window.location.search).get('currency') || localStorage.getItem('volynx_currency') || 'GBP', false);
    fetch('/config.json', { cache: 'no-store' })
      .then(function(r) { return r.ok ? r.json() : {}; })
      .then(function(c) {
        window.__volynxPixEnabled = c.pixEnabled === true;
        applyPricingCurrency(
          new URLSearchParams(window.location.search).get('currency') ||
          localStorage.getItem('volynx_currency') ||
          'GBP',
          false
        );
      })
      .catch(function() {});
  </script>

