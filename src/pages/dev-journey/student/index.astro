---
import "../../../styles/volynx-devjourney.css";
import FaviconHead from "../../../components/FaviconHead.astro";
import VxHeader from "../../../components/VxHeader.astro";
import VxFooter from "../../../components/VxFooter.astro";
import PageWidgets from "../../../components/PageWidgets.astro";
import { ROUTES } from "../../../data/routes";
import { DEVJOURNEY_DELIVERABLES } from "../../../data/devjourney-deliverables.js";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1" name="viewport" />
  <meta content="#080610" name="theme-color" />
  <title>Área do aluno • Dev Journey • VOLYNX</title>
  <meta name="description" content="Área do aluno do Dev Journey: materiais, checklist e submissão de projeto." />
  <meta name="robots" content="noindex,nofollow" />
  <FaviconHead />
</head>

<body>
  <div class="dust" aria-hidden="true"></div>
  <a class="skip" href="#content"><span class="i18n-en">Skip to content</span><span class="i18n-pt">Pular para o conteúdo</span></a>

  <VxHeader primaryCtaLabel="Sign out" primaryCtaI18n="djs.sign_out" primaryCtaHref="/login/?logout=1" />
  <PageWidgets />

  <main id="content">
    <div class="container" style="padding-top: 96px;">

      <!-- Logged-out state -->
      <section id="djsLoggedOut" class="reveal" hidden>
        <div class="card" style="padding:32px; text-align:center; max-width: 560px; margin: 0 auto;">
          <div class="djs-hero-art-shell djs-hero-art-shell--login" aria-hidden="true">
            <img src="/assets/devjourneyicon2.webp" alt="" class="djs-hero-art" loading="lazy" decoding="async" />
          </div>
          <h1 style="margin:0 0 12px; font-size: 28px;">
            <span class="i18n-en">Sign in to enter the student area</span>
            <span class="i18n-pt">Entre para acessar a área do aluno</span>
          </h1>
          <p class="muted" style="margin: 0 0 22px; line-height:1.6;">
            <span class="i18n-en">Dev Journey is free, but login is required to track progress, save your checklist and submit your project for validation.</span>
            <span class="i18n-pt">O Dev Journey é grátis, mas o login é necessário pra acompanhar progresso, salvar o checklist e submeter seu projeto para validação.</span>
          </p>
          <div class="ctaRow" style="justify-content:center;">
            <a class="btn primary" id="djsLoginBtn" href="/login/?next=/dev-journey/student/">
              <span class="i18n-en">Sign in</span>
              <span class="i18n-pt">Entrar</span>
            </a>
            <a class="btn ghost" id="djsSignupBtn" href="/signup/?next=/dev-journey/student/">
              <span class="i18n-en">Create account</span>
              <span class="i18n-pt">Criar conta</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Logged-in state -->
      <section id="djsLoggedIn" class="reveal" hidden>
        <header class="sectionTitle" style="border-top:none; padding-top:0;">
          <div>
            <h1 style="margin:0 0 8px;">
              <span class="i18n-en">Welcome to Dev Journey</span>
              <span class="i18n-pt">Bem-vindo ao Dev Journey</span>
            </h1>
            <p class="muted" style="margin:0;">
              <span class="i18n-en">Pick up where you left off. Materials, checklist and submission for your tier.</span>
              <span class="i18n-pt">Continue de onde parou. Materiais, checklist e submissão pro seu nível.</span>
            </p>
          </div>
          <div class="djs-tier" id="djsTier" data-tier="social" aria-live="polite">
            <span class="i18n-en">Tier:</span><span class="i18n-pt">Plano:</span>
            <strong id="djsTierLabel">Social</strong>
          </div>
        </header>

        <section class="djs-hero-band">
          <article class="djs-hero-card djs-hero-card--student">
            <div class="djs-hero-copy">
              <span class="kicker">
                <span class="i18n-en">Dev Journey control room</span>
                <span class="i18n-pt">Central do Dev Journey</span>
              </span>
              <h2>
                <span class="i18n-en">Student area, downloads and submission now live in one visible lane.</span>
                <span class="i18n-pt">Área do aluno, downloads e submissão agora vivem em uma faixa visível só.</span>
              </h2>
              <p>
                <span class="i18n-en">Use this page as your operational hub: open the checklist, grab your ZIP, continue your block and move toward manual validation without leaving VOLYNX.</span>
                <span class="i18n-pt">Use esta página como hub operacional: abra o checklist, pegue seu ZIP, continue seu bloco e avance pra validação manual sem sair da VOLYNX.</span>
              </p>
            </div>
            <img src="/assets/devjourneyicon1.webp" alt="" class="djs-hero-bg-art" loading="lazy" decoding="async" aria-hidden="true" />
          </article>
        </section>

        <!-- Quick actions -->
        <div class="djs-quick-grid">
          <a class="djs-quick-card" href={ROUTES.devJourneyChecklist}>
            <div class="djs-card-art-shell" aria-hidden="true">
              <img src="/assets/devjourneyicon4.webp" alt="" class="djs-card-art" loading="lazy" decoding="async" />
            </div>
            <div class="djs-quick-badge">01</div>
            <h3><span class="i18n-en">Checklist</span><span class="i18n-pt">Checklist</span></h3>
            <p>
              <span class="i18n-en">Track each item until it works on screen. Progress saves to your account.</span>
              <span class="i18n-pt">Marque cada item até funcionar na tela. Progresso salva na sua conta.</span>
            </p>
            <span class="djs-quick-cta"><span class="i18n-en">Open checklist →</span><span class="i18n-pt">Abrir checklist →</span></span>
          </a>

          <a class="djs-quick-card" href="#downloads">
            <div class="djs-card-art-shell" aria-hidden="true">
              <img src="/assets/devjourneyicon1.webp" alt="" class="djs-card-art" loading="lazy" decoding="async" />
            </div>
            <div class="djs-quick-badge">02</div>
            <h3><span class="i18n-en">Materials</span><span class="i18n-pt">Materiais</span></h3>
            <p>
              <span class="i18n-en">PDFs, glossaries and starter projects for your tier.</span>
              <span class="i18n-pt">PDFs, glossários e projetos starter pro seu nível.</span>
            </p>
            <span class="djs-quick-cta"><span class="i18n-en">See materials ↓</span><span class="i18n-pt">Ver materiais ↓</span></span>
          </a>

          <a class="djs-quick-card djs-quick-card--locked" id="djsSubmitCard" href="#materials" data-locked="false">
            <div class="djs-card-art-shell" aria-hidden="true">
              <img src="/assets/devjourneyicon18.webp" alt="" class="djs-card-art" loading="lazy" decoding="async" />
            </div>
            <div class="djs-quick-badge">03</div>
            <h3><span class="i18n-en">Submit project</span><span class="i18n-pt">Submeter projeto</span></h3>
            <p>
              <span class="i18n-en">Send your repo + live URL for manual review. Available in Phase 2.</span>
              <span class="i18n-pt">Envie repo + URL live pra revisão manual. Disponível na Phase 2.</span>
            </p>
            <span class="djs-quick-cta"><span class="i18n-en">Coming soon</span><span class="i18n-pt">Em breve</span></span>
          </a>
        </div>

        <section id="downloads" class="djs-downloads">
          <div class="sectionTitle" style="border-top:none; padding-top:0; margin-bottom: 14px;">
            <div>
              <h2 style="margin:0 0 8px;">
                <span class="i18n-en">Download vault</span>
                <span class="i18n-pt">Vault de downloads</span>
              </h2>
              <p class="muted" style="margin:0;">
                <span class="i18n-en">Each tier unlocks one clean ZIP. Open your pack here, then use the breakdown below as your study map.</span>
                <span class="i18n-pt">Cada tier libera um ZIP limpo. Abra seu pacote aqui e use o detalhamento abaixo como mapa de estudo.</span>
              </p>
            </div>
          </div>

          <div class="djs-download-grid">
            {DEVJOURNEY_DELIVERABLES.map((pack) => (
              <article
                class:list={[
                  "djs-download-card",
                  `djs-download-card--${pack.tier}`,
                  pack.tier !== "social" && "djs-download-card--locked",
                ]}
                data-tier-required={pack.tier !== "social" ? pack.tier : undefined}
              >
                <div class="djs-card-art-shell djs-card-art-shell--download" aria-hidden="true">
                  <img src={pack.iconSrc} alt="" class="djs-card-art djs-card-art--download" loading="lazy" decoding="async" />
                </div>
                <div class="djs-download-head">
                  <span class:list={["djs-mat-tier-pill", pack.tier]}>
                    <span class="i18n-en">{pack.badgeEn}</span>
                    <span class="i18n-pt">{pack.badgePt}</span>
                  </span>
                  {pack.tier !== "social" && (
                    <a class="djs-unlock" href="/dev-journey/#upgrade">
                      <span class="i18n-en">Unlock with {pack.badgeEn}</span>
                      <span class="i18n-pt">Desbloquear com {pack.badgePt}</span>
                    </a>
                  )}
                </div>

                <h3>
                  <span class="i18n-en">{pack.titleEn}</span>
                  <span class="i18n-pt">{pack.titlePt}</span>
                </h3>

                <p class="djs-download-copy">
                  <span class="i18n-en">{pack.summaryEn}</span>
                  <span class="i18n-pt">{pack.summaryPt}</span>
                </p>

                <p class="djs-download-note">
                  <span class="i18n-en">{pack.noteEn}</span>
                  <span class="i18n-pt">{pack.notePt}</span>
                </p>

                <div class="djs-download-actions">
                  <a class="btn primary djs-download-btn" href={pack.href} download={pack.fileName}>
                    <span class="i18n-en">{pack.ctaEn}</span>
                    <span class="i18n-pt">{pack.ctaPt}</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- Materials list (gated) -->
        <section id="materials" class="djs-materials">
          <h2><span class="i18n-en">Your materials</span><span class="i18n-pt">Seus materiais</span></h2>

          <div class="djs-mat-block">
            <div class="djs-card-art-shell djs-card-art-shell--material" aria-hidden="true">
              <img src="/assets/devjourneyicon11.webp" alt="" class="djs-card-art djs-card-art--material" loading="lazy" decoding="async" />
            </div>
            <h3>Bloco 0 — Setup <span class="djs-mat-tier-pill social">Social</span></h3>
            <ul class="djs-mat-list">
              <li><span class="djs-mat-icon">📄</span><span class="i18n-en">Welcome guide (Comece-Aqui)</span><span class="i18n-pt">Guia de boas-vindas (Comece-Aqui)</span></li>
              <li><span class="djs-mat-icon">📄</span><span class="i18n-en">How to use the course</span><span class="i18n-pt">Como usar o curso</span></li>
              <li><span class="djs-mat-icon">📄</span><span class="i18n-en">Requirements + compatibility</span><span class="i18n-pt">Requisitos e compatibilidade</span></li>
              <li><span class="djs-mat-icon">📄</span><span class="i18n-en">Universal setup checklist</span><span class="i18n-pt">Checklist universal de setup</span></li>
            </ul>
            <p class="djs-mat-status">
              <span class="i18n-en">📦 The Social ZIP is live in the download vault above.</span>
              <span class="i18n-pt">📦 O ZIP Social já está liberado no vault de downloads acima.</span>
            </p>
          </div>

          <div class="djs-mat-block">
            <div class="djs-card-art-shell djs-card-art-shell--material" aria-hidden="true">
              <img src="/assets/devjourneyicon10.webp" alt="" class="djs-card-art djs-card-art--material" loading="lazy" decoding="async" />
            </div>
            <h3>Bloco 1 + 2 — HTML/CSS/JS + DOM <span class="djs-mat-tier-pill social">Social</span></h3>
            <ul class="djs-mat-list">
              <li><span class="djs-mat-icon">📄</span><span class="i18n-en">Block 1 — HTML/CSS/JS Foundations</span><span class="i18n-pt">Bloco 1 — Fundamentos HTML/CSS/JS</span></li>
              <li><span class="djs-mat-icon">📄</span><span class="i18n-en">Block 2 — JavaScript + DOM + JSON</span><span class="i18n-pt">Bloco 2 — JavaScript + DOM + JSON</span></li>
              <li><span class="djs-mat-icon">📚</span><span class="i18n-en">Glossary Block 1</span><span class="i18n-pt">Glossário Bloco 1</span></li>
              <li><span class="djs-mat-icon">📚</span><span class="i18n-en">Glossary Block 2</span><span class="i18n-pt">Glossário Bloco 2</span></li>
              <li><span class="djs-mat-icon">📁</span><span class="i18n-en">Starter projects (Bloco 1, Bloco 2)</span><span class="i18n-pt">Projetos starter (Bloco 1, Bloco 2)</span></li>
            </ul>
          </div>

          <div class="djs-mat-block djs-mat-locked" data-tier-required="pro">
            <div class="djs-card-art-shell djs-card-art-shell--material" aria-hidden="true">
              <img src="/assets/devjourneyicon9.webp" alt="" class="djs-card-art djs-card-art--material" loading="lazy" decoding="async" />
            </div>
            <h3>
              Bloco 3 — React App incremental
              <span class="djs-mat-tier-pill pro">Pro</span>
              <a class="djs-unlock" href="/dev-journey/#upgrade"><span class="i18n-en">Unlock with Pro</span><span class="i18n-pt">Desbloquear com Pro</span></a>
            </h3>
            <ul class="djs-mat-list">
              <li><span class="djs-mat-icon">📄</span><span class="i18n-en">Block 3 PDF — incremental React app</span><span class="i18n-pt">PDF do Bloco 3 — app React incremental</span></li>
              <li><span class="djs-mat-icon">⚛️</span><span class="i18n-en">Complete Vite starter with components and sample data</span><span class="i18n-pt">Starter completo em Vite com components e dados de exemplo</span></li>
              <li><span class="djs-mat-icon">🧭</span><span class="i18n-en">Shared course guides and setup docs bundled together</span><span class="i18n-pt">Guias compartilhados do curso e docs de setup empacotados juntos</span></li>
            </ul>
            <p class="muted">
              <span class="i18n-en">PDF + complete React starter project (Vite + components). Available with Pro.</span>
              <span class="i18n-pt">PDF + projeto React starter completo (Vite + components). Disponível no Pro.</span>
            </p>
            <p class="djs-mat-status">
              <span class="i18n-en">📦 When unlocked, download the Pro ZIP from the vault above.</span>
              <span class="i18n-pt">📦 Quando liberar, baixe o ZIP Pro no vault acima.</span>
            </p>
          </div>

          <div class="djs-mat-block djs-mat-locked" data-tier-required="bundle">
            <div class="djs-card-art-shell djs-card-art-shell--material" aria-hidden="true">
              <img src="/assets/devjourneyicon12.webp" alt="" class="djs-card-art djs-card-art--material" loading="lazy" decoding="async" />
            </div>
            <h3>
              Bloco 4 + 5 + Arsenal Kit
              <span class="djs-mat-tier-pill bundle">Bundle</span>
              <a class="djs-unlock" href="/dev-journey/#upgrade"><span class="i18n-en">Unlock with Bundle</span><span class="i18n-pt">Desbloquear com Bundle</span></a>
            </h3>
            <ul class="djs-mat-list">
              <li><span class="djs-mat-icon">📄</span><span class="i18n-en">Blocks 4 + 5 PDFs with API and deploy guidance</span><span class="i18n-pt">PDFs dos Blocos 4 + 5 com orientacao de API e deploy</span></li>
              <li><span class="djs-mat-icon">🛠</span><span class="i18n-en">Express API starter and GitHub Actions workflow example</span><span class="i18n-pt">Starter de API Express e exemplo de workflow no GitHub Actions</span></li>
              <li><span class="djs-mat-icon">📦</span><span class="i18n-en">Arsenal Kit with reusable projects and cheatcodes</span><span class="i18n-pt">Arsenal Kit com projetos reutilizaveis e cheatcodes</span></li>
            </ul>
            <p class="muted">
              <span class="i18n-en">Express API, deploy with GitHub Actions, certification rules, Arsenal Kit (4 reusable projects + Cheatcodes).</span>
              <span class="i18n-pt">API Express, deploy com GitHub Actions, regras de certificação, Arsenal Kit (4 projetos reutilizáveis + Cheatcodes).</span>
            </p>
            <p class="djs-mat-status">
              <span class="i18n-en">📦 When unlocked, download the Bundle ZIP from the vault above.</span>
              <span class="i18n-pt">📦 Quando liberar, baixe o ZIP Bundle no vault acima.</span>
            </p>
          </div>
        </section>

        <p class="djs-honest-note">
          <strong><span class="i18n-en">Honest note:</span><span class="i18n-pt">Nota honesta:</span></strong>
          <span class="i18n-en"> certification today is by manual review. We're shipping the auto-validation pipeline post-launch. Your submission is queued and you'll receive the certificate by email after review.</span>
          <span class="i18n-pt"> a certificação hoje é por revisão manual. A pipeline de auto-validação chega pós-launch. Sua submissão fica na fila e você recebe a certificação por email após revisão.</span>
        </p>

      </section>

    </div>
  </main>

  <VxFooter />

  <script is:inline>
    (function () {
      var loggedIn = document.getElementById('djsLoggedIn');
      var loggedOut = document.getElementById('djsLoggedOut');
      var tierEl = document.getElementById('djsTier');
      var tierLabel = document.getElementById('djsTierLabel');

      function getToken() {
        try { return localStorage.getItem('volynx_access_token') || ''; } catch (_) { return ''; }
      }

      function show(el) { if (el) el.hidden = false; }
      function hide(el) { if (el) el.hidden = true; }

      var token = getToken();
      if (!token) {
        show(loggedOut);
        hide(loggedIn);
        return;
      }

      show(loggedIn);
      hide(loggedOut);

      // Fetch tier + progress
      fetch('https://zdmpzrderifgqmqivjoy.supabase.co/functions/v1/devjourney-progress', {
        method: 'POST',
        headers: {
          'Authorization': 'Bearer ' + token,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ action: 'get' }),
      })
        .then(function (r) {
          if (r.status === 401) {
            // Token expired or invalid — kick to login
            location.replace('/login/?next=/dev-journey/student/');
            return null;
          }
          return r.json();
        })
        .then(function (data) {
          if (!data) return;
          var tier = (data.tier || 'social').toLowerCase();
          tierEl.dataset.tier = tier;
          tierLabel.textContent = tier.charAt(0).toUpperCase() + tier.slice(1);

          // Unlock material blocks based on tier
          var rank = { social: 0, pro: 1, bundle: 2 };
          var userRank = rank[tier] != null ? rank[tier] : 0;
          document.querySelectorAll('[data-tier-required]').forEach(function (block) {
            var req = block.getAttribute('data-tier-required');
            if (rank[req] != null && userRank >= rank[req]) {
              block.classList.remove('djs-mat-locked');
              block.classList.remove('djs-download-card--locked');
              var unlock = block.querySelector('.djs-unlock');
              if (unlock) unlock.style.display = 'none';
            }
          });
        })
        .catch(function (err) {
          console.warn('[djs] progress fetch failed:', err);
        });
    })();
  </script>

  <style>
    .djs-hero-band {
      margin: 0 0 28px;
    }
    .djs-hero-card {
      position: relative;
      display: grid;
      gap: 18px;
      padding: 24px;
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,.10);
      background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      overflow: hidden;
    }
    .djs-hero-card--student::after {
      content: "";
      position: absolute;
      inset: 16% 8% 10% auto;
      width: min(340px, 38vw);
      border-radius: 999px;
      background: radial-gradient(circle, rgba(0,219,255,.14), transparent 72%);
      filter: blur(28px);
      pointer-events: none;
    }
    .djs-hero-copy {
      position: relative;
      z-index: 1;
      display: grid;
      gap: 12px;
    }
    .djs-hero-copy h2 {
      margin: 0;
      font-size: clamp(24px, 3vw, 34px);
      line-height: 1.1;
    }
    .djs-hero-copy p {
      margin: 0;
      max-width: 62ch;
      font-size: 14px;
      line-height: 1.7;
      color: rgba(255,255,255,.74);
    }
    .djs-hero-card--student .djs-hero-copy {
      max-width: min(62ch, 58%);
    }
    .djs-hero-bg-art {
      position: absolute;
      right: clamp(-34px, -2vw, -8px);
      bottom: -42px;
      width: min(460px, 40vw);
      max-width: 44%;
      height: auto;
      opacity: 0.92;
      pointer-events: none;
      filter: saturate(1.06) brightness(1.04) drop-shadow(0 28px 42px rgba(0,0,0,.42));
      z-index: 0;
    }
    .djs-hero-art-shell,
    .djs-card-art-shell {
      position: relative;
      display: grid;
      place-items: center;
      padding: 16px;
      border-radius: 22px;
      border: 1px solid rgba(255,255,255,.08);
      background:
        radial-gradient(circle at 50% 30%, rgba(0,219,255,.14), transparent 58%),
        linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.02));
      overflow: hidden;
      isolation: isolate;
    }
    .djs-hero-art-shell::before,
    .djs-card-art-shell::before {
      content: "";
      position: absolute;
      inset: auto 14% 8% 14%;
      height: 32%;
      border-radius: 999px;
      background: radial-gradient(circle, rgba(167,139,250,.18), transparent 72%);
      filter: blur(20px);
      z-index: -1;
    }
    .djs-hero-art-shell {
      min-height: 230px;
    }
    .djs-hero-art-shell--login {
      margin: 0 auto 20px;
      min-height: 220px;
      max-width: 280px;
    }
    .djs-card-art-shell {
      min-height: 180px;
    }
    .djs-card-art-shell--download {
      min-height: 170px;
    }
    .djs-card-art-shell--material {
      min-height: 190px;
      margin-bottom: 16px;
    }
    .djs-hero-art,
    .djs-card-art {
      width: min(100%, 220px);
      max-height: 210px;
      object-fit: contain;
      filter: drop-shadow(0 24px 34px rgba(0,0,0,.36));
    }
    .djs-card-art--download {
      width: min(100%, 200px);
      max-height: 190px;
    }
    .djs-card-art--material {
      width: min(100%, 210px);
      max-height: 200px;
    }
    .djs-tier {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 14px; border-radius: 999px;
      border: 1px solid rgba(255,255,255,.14);
      background: rgba(255,255,255,.04);
      font-size: 13px; color: rgba(255,255,255,.85);
    }
    .djs-tier strong { color: #fff; font-weight: 700; }
    .djs-tier[data-tier="pro"] { border-color: rgba(0,219,255,.35); background: rgba(0,219,255,.08); }
