  <script is:inline>
    (() => {
      const chips = Array.from(document.querySelectorAll("[data-dj-filter]"));
      const cards = Array.from(document.querySelectorAll(".dj-track-card"));
      if (!chips.length || !cards.length) return;

      const applyFilter = (filter) => {
        chips.forEach((chip) => {
          chip.classList.toggle("is-active", chip.dataset.djFilter === filter);
        });

        cards.forEach((card) => {
          const groups = String(card.dataset.in || "").split(/\s+/).filter(Boolean);
          card.hidden = filter !== "all" && !groups.includes(filter);
        });
      };

      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          applyFilter(chip.dataset.djFilter || "all");
        });
      });

      applyFilter("social");
    })();
  </script>
