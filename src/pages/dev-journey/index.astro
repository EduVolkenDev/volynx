---
import "../../styles/devjourney-landing.css";
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import PlatformAssistStrip from "../../components/PlatformAssistStrip.astro";
import { ROUTES } from "../../data/routes";

const devJourneyAssistItems = [
  {
    href: ROUTES.devJourneyStudent,
    label: { en: "Student area", pt: "Área do aluno" },
    title: { en: "Open the real course flow", pt: "Abrir o fluxo real do curso" },
    copy: { en: "Progress, ZIP downloads, gated materials and the practical side of the journey live here.", pt: "Progresso, downloads ZIP, materiais bloqueados e o lado prático da jornada vivem aqui." },
    emphasized: true,
    iconSrc: "/assets/journeyicon.webp",
  },
  {
    href: ROUTES.devJourneyChecklist,
    label: { en: "Checklist", pt: "Checklist" },
    title: { en: "Track what actually shipped", pt: "Marque o que realmente foi entregue" },
    copy: { en: "Each block becomes visible work on screen instead of abstract study time.", pt: "Cada bloco vira trabalho visível na tela em vez de tempo abstrato de estudo." },
  },
  {
    href: ROUTES.delivery,
    label: { en: "Recovery", pt: "Recuperação" },
    title: { en: "Keep the post-purchase lane in one place", pt: "Mantenha o pós-compra em um só lugar" },
    copy: { en: "When Pro or Bundle access is involved, delivery stays attached to the same VOLYNX recovery path.", pt: "Quando Pro ou Bundle entram na jogada, a entrega continua presa ao mesmo caminho de recuperação da VOLYNX." },
    iconSrc: "/assets/mybox.webp",
  },
  {
    href: ROUTES.support,
    label: { en: "Support", pt: "Suporte" },
    title: { en: "Use the same operational lane", pt: "Use a mesma faixa operacional" },
    copy: { en: "Access, delivery and launch questions should route through support without leaving the ecosystem.", pt: "Dúvidas de acesso, entrega e lançamento devem passar pelo suporte sem sair do ecossistema." },
    iconSrc: "/assets/support.webp",
  },
];

const methodCards = [
  { titleKey: "dj.method_step1", title: "1) Direction", descKey: "dj.method_step1_desc", desc: "You know what to do and why. No \"I'll try\".", asset: "/assets/devjourneyicon15.webp" },
  { titleKey: "dj.method_step2", title: "2) Delivery", descKey: "dj.method_step2_desc", desc: "Every module closes with a publishable result. Visible progress, not subjective.", asset: "/assets/devjourneyicon16.webp" },
  { titleKey: "dj.method_step3", title: "3) Refinement", descKey: "dj.method_step3_desc", desc: "Review and improvement: the difference between \"it works\" and \"it's professional\".", asset: "/assets/devjourneyicon17.webp" },
];

const projectCards = [
  { titleKey: "dj.project_landing", title: "Premium landing", descKey: "dj.project_landing_desc", desc: "Grid, hierarchy, responsiveness, and micro-interactions. The right aesthetic sells.", asset: "/assets/devjourneyicon5.webp" },
  { titleKey: "dj.project_app", title: "Web app", descKey: "dj.project_app_desc", desc: "Data, states, and UX: interfaces that respond fast and can become a product.", asset: "/assets/devjourneyicon20.webp" },
  { titleKey: "dj.project_final", title: "Final project", descKey: "dj.project_final_desc", desc: "Plan, execute, publish, and present. The full cycle, as in the real world.", asset: "/assets/devjourneyicon21.webp" },
];

const nextSteps = [
  {
    href: ROUTES.portfolioKit,
    badgeKey: "dj.next_badge_kit",
    badge: "Kit",
    titleKey: "dj.next_title_kit",
    title: "Need a portfolio?",
    descKey: "dj.next_desc_kit",
    desc: "The Portfolio Pro Kit is the professional version of what you just built. Sections, motion, SEO — ready to deploy.",
    ctaKey: "dj.next_cta_kit",
    cta: "See the kit →",
    asset: "/assets/portfolioshield1.webp",
  },
  {
    href: ROUTES.studio,
    badgeKey: "dj.next_badge_studio",
    badge: "Studio",
    titleKey: "dj.next_title_studio",
    title: "Want the pro tools?",
    descKey: "dj.next_desc_studio",
    desc: "Studio Pro unlocks batch processing, advanced export, and commercial usage for your day-to-day workflow.",
    ctaKey: "dj.next_cta_studio",
    cta: "Explore Studio →",
    asset: "/assets/new-suite.webp",
  },
  {
    href: ROUTES.services,
    badgeKey: "dj.next_badge_services",
    badge: "Services",
    titleKey: "dj.next_title_services",
    title: "Need a real site built?",
    descKey: "dj.next_desc_services",
    desc: "VOLYNX builds it for you — landing pages, full sites, and maintenance plans. You scope it, I execute.",
    ctaKey: "dj.next_cta_services",
    cta: "Work with VOLYNX →",
    asset: "/assets/launch.webp",
  },
];
---

<FlagshipLayout
  title="Dev Journey • VOLYNX.Lab Education"
  description="Dev Journey: trilha de aprendizado guiada por projetos, sem encheção de linguiça. Grátis com login — salve progresso, baixe materiais, acompanhe checklists e prepare seu projeto para revisão manual."
  pageClass="page-dev-journey"
>
  <FlagshipHeader ctaHref={ROUTES.devJourneyStudent} ctaLabel="Enter Student Area" ctaI18n="dj.btn_access" />

  <main>
    <section class="page-section dj-hero-section" id="home">
      <div class="shell">
        <div class="dj-hero panel">
          <div class="dj-hero__copy">
            <span class="label label--free dj-hero__label">
              <span class="dj-hero__label-dot" aria-hidden="true"></span>
              <span class="i18n-en">VOLYNX.Lab Education</span>
              <span class="i18n-pt">VOLYNX.Lab Education</span>
            </span>

            <div class="kicker" data-i18n="dj.hero_title">Dev Journey. Less noise. More shipping.</div>

            <h1 data-i18n="dj.hero_subtitle">Build your first live project — self-guided, distraction-free, and with a real deliverable.</h1>
            <p class="dj-lead" data-i18n="dj.hero_lead">A self-guided track (text + files + checklists) with projects that become portfolio work. Learn by building real, publishable projects.</p>

            <div class="dj-hero__notice">
              <strong data-i18n="dj.notice_important">Importante:</strong>
              <span data-i18n="dj.notice_text"> o curso é grátis, mas exige login pra ativar a experiência completa: salvar progresso, baixar materiais, desbloquear blocos, usar checklists e preparar seu projeto para revisão manual.</span>
              <span class="dj-hero__notice-sub" data-i18n="dj.notice_subtext">Sem login você vê a visão geral; com login você roda a jornada.</span>
            </div>

            <div class="dj-hero__actions">
              <a class="button button--gold" href={ROUTES.devJourneyStudent} data-i18n="dj.btn_start">Comece agora (grátis)</a>
              <a class="button button--ghost" href="#curriculum" data-i18n="dj.btn_curriculum">Ver currículo</a>
              <a class="button button--ghost" href="#access" data-i18n="dj.btn_login">Como funciona o login</a>
            </div>

            <div class="hero-inline-stats dj-hero__stats">
              <div>
                <strong data-i18n="dj.stat_sprint">Guided sprint</strong>
                <span data-i18n="dj.stat_sprint_desc">Short blocks + checkpoints (what should appear on screen).</span>
              </div>
              <div>
                <strong data-i18n="dj.stat_deliverables">Deliverables</strong>
                <span data-i18n="dj.stat_deliverables_desc">Social (7 days), Pro (14 days), Bundle (30 days). Published and versioned.</span>
              </div>
              <div>
                <strong data-i18n="dj.stat_checkpoints">Checkpoints</strong>
                <span data-i18n="dj.stat_checkpoints_desc">"If it worked" + "if it didn't" (debug without guessing).</span>
              </div>
            </div>
          </div>

          <aside class="dj-system panel" aria-label="Dev Journey inside VOLYNX">
            <div class="dj-system__art-shell" aria-hidden="true">
              <img src="/assets/journeyicon.webp" alt="" class="dj-system__art" loading="lazy" decoding="async" />
            </div>

            <span class="eyebrow">
              <span class="i18n-en">Inside VOLYNX</span>
              <span class="i18n-pt">Dentro da VOLYNX</span>
            </span>

            <h2>
              <span class="i18n-en">The course now sits in the same system as the rest of the platform.</span>
              <span class="i18n-pt">O curso agora vive no mesmo sistema que o resto da plataforma.</span>
            </h2>

            <p>
              <span class="i18n-en">Student area, checklist, ZIP delivery, support and post-purchase recovery no longer need a separate visual language. Dev Journey should feel like a real VOLYNX surface.</span>
              <span class="i18n-pt">Área do aluno, checklist, entrega ZIP, suporte e recuperação pós-compra não precisam mais de uma linguagem visual separada. O Dev Journey deve parecer uma superfície real da VOLYNX.</span>
            </p>

            <div class="dj-system__links">
              <a class="dj-system__link" href={ROUTES.devJourneyStudent}>
                <strong>
                  <span class="i18n-en">Student area</span>
                  <span class="i18n-pt">Área do aluno</span>
                </strong>
                <span>
                  <span class="i18n-en">Progress, gated materials and ZIP downloads.</span>
                  <span class="i18n-pt">Progresso, materiais bloqueados e downloads ZIP.</span>
                </span>
              </a>

              <a class="dj-system__link" href={ROUTES.devJourneyChecklist}>
                <strong>
                  <span class="i18n-en">Checklist</span>
                  <span class="i18n-pt">Checklist</span>
                </strong>
                <span>
                  <span class="i18n-en">Track what actually shipped, not what felt studied.</span>
                  <span class="i18n-pt">Marque o que realmente foi entregue, não só o que pareceu estudado.</span>
                </span>
              </a>

              <a class="dj-system__link" href={ROUTES.delivery}>
                <strong>
                  <span class="i18n-en">My products</span>
                  <span class="i18n-pt">Meus produtos</span>
                </strong>
                <span>
                  <span class="i18n-en">Keep the upgrade and recovery lane attached to the platform.</span>
                  <span class="i18n-pt">Mantenha a trilha de upgrade e recuperação presa à plataforma.</span>
                </span>
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <PlatformAssistStrip
      eyebrow={{ en: "Platform flow", pt: "Fluxo da plataforma" }}
      title={{ en: "Dev Journey should move like the rest of VOLYNX.", pt: "O Dev Journey deve se mover como o resto da VOLYNX." }}
      description={{ en: "Open the course, track progress, recover purchases and route support without jumping into a detached microsite.", pt: "Abra o curso, acompanhe progresso, recupere compras e direcione suporte sem cair num microsite desconectado." }}
      items={devJourneyAssistItems}
    />

    <section class="page-section" id="curriculum">
      <div class="shell">
        <div class="section-head section-head--split">
          <div>
            <span class="eyebrow">
              <span class="i18n-en">Curriculum</span>
              <span class="i18n-pt">Currículo</span>
            </span>
            <h2 data-i18n="dj.curriculum_title">Track by blocks (no confusion)</h2>
          </div>
          <div>
            <p data-i18n="dj.curriculum_desc">You advance through small, visible deliverables. Every step produces something real you can show. Select your level to see what's included:</p>
            <div class="dj-filter" role="tablist" aria-label="Filter by plan">
              <button class="dj-filter__btn is-active" data-dj-filter="social" type="button" data-i18n="dj.chip_social">Social Sprint</button>
              <button class="dj-filter__btn" data-dj-filter="pro" type="button" data-i18n="dj.chip_pro">Pro (Upgrade)</button>
              <button class="dj-filter__btn" data-dj-filter="bundle" type="button" data-i18n="dj.chip_bundle">Bundle</button>
              <button class="dj-filter__btn" data-dj-filter="all" type="button" data-i18n="dj.chip_all">See all</button>
            </div>
          </div>
        </div>

        <div class="dj-roadmap">
          <article class="panel dj-track-card dj-track-card--core" data-in="social pro bundle">
            <div class="dj-track-card__top">
              <span class="dj-track-card__num" data-i18n="dj.block0_num">Block 0</span>
              <span class="dj-track-card__badge" data-i18n="dj.block0_badge">Start Here</span>
            </div>
            <div class="dj-card-art-shell dj-card-art-shell--roadmap" aria-hidden="true">
              <img src="/assets/devjourneyicon11.webp" alt="" class="dj-card-art" loading="lazy" decoding="async" />
            </div>
            <h3 data-i18n="dj.block0_title">Setup + how to study the right way</h3>
            <p data-i18n="dj.block0_desc">Environment ready, folder organised, and the VOLYNX method to get out of errors without being stuck for hours.</p>
            <ul class="detail-list">
              <li data-i18n="dj.block0_li1">Editor + browser + Live Server (the "why" and the "how")</li>
              <li data-i18n="dj.block0_li2">Validatable checklist (you know when you're ready)</li>
              <li data-i18n="dj.block0_li3">Current review status + manual certification</li>
            </ul>
          </article>

          <article class="panel dj-track-card dj-track-card--core" data-in="social pro bundle">
            <div class="dj-track-card__top">
              <span class="dj-track-card__num" data-i18n="dj.block1_num">Block 1</span>
              <span class="dj-track-card__badge" data-i18n="dj.block1_badge">Foundations</span>
            </div>
            <div class="dj-card-art-shell dj-card-art-shell--roadmap" aria-hidden="true">
              <img src="/assets/devjourneyicon10.webp" alt="" class="dj-card-art" loading="lazy" decoding="async" />
            </div>
            <h3 data-i18n="dj.block1_title">HTML + CSS + basic JS (with a click on screen)</h3>
            <p data-i18n="dj.block1_desc">First real project: 3 connected files and an interaction working on the page (not just in the console).</p>
            <ul class="detail-list">
              <li data-i18n="dj.block1_li1">Semantic structure + simple responsive layout</li>
              <li data-i18n="dj.block1_li2">Buttons, form, and visible feedback</li>
              <li data-i18n="dj.block1_li3">Basic debugging: console, common errors, and fixes</li>
            </ul>
          </article>

          <article class="panel dj-track-card dj-track-card--core" data-in="social pro bundle">
            <div class="dj-track-card__top">
              <span class="dj-track-card__num" data-i18n="dj.block2_num">Block 2</span>
              <span class="dj-track-card__badge" data-i18n="dj.block2_badge">JavaScript + DOM</span>
            </div>
            <div class="dj-card-art-shell dj-card-art-shell--roadmap" aria-hidden="true">
              <img src="/assets/devjourneyicon8.webp" alt="" class="dj-card-art" loading="lazy" decoding="async" />
            </div>
            <h3 data-i18n="dj.block2_title">Real interactivity</h3>
            <p data-i18n="dj.block2_desc">You learn to manipulate the page: events, validation, logic, and data (includes JSON with practical examples).</p>
            <ul class="detail-list">
              <li data-i18n="dj.block2_li1">Types, operators, functions, and events</li>
              <li data-i18n="dj.block2_li2">DOM: select, change, create elements</li>
              <li data-i18n="dj.block2_li3">JSON: what it is, why it exists, and where you use it</li>
            </ul>
          </article>

          <article class="panel dj-track-card dj-track-card--pro" data-in="pro bundle">
            <div class="dj-track-card__top">
              <span class="dj-track-card__num" data-i18n="dj.block3_num">Block 3</span>
              <span class="dj-track-card__badge" data-i18n="dj.block3_badge">Incremental project</span>
              <a class="dj-plan-chip" href="#upgrade" data-i18n="dj.unlock_pro">Unlock with Pro</a>
            </div>
            <div class="dj-card-art-shell dj-card-art-shell--roadmap" aria-hidden="true">
              <img src="/assets/devjourneyicon9.webp" alt="" class="dj-card-art" loading="lazy" decoding="async" />
            </div>
            <h3 data-i18n="dj.block3_title">An app that grows module by module</h3>
            <p data-i18n="dj.block3_desc">Each module adds a visible feature. You finish with a presentable app that's easy to explain.</p>
            <ul class="detail-list">
              <li data-i18n="dj.block3_li1">State, simple components, and code organisation</li>
              <li data-i18n="dj.block3_li2">Basic persistence (e.g. localStorage) + UX</li>
              <li data-i18n="dj.block3_li3">Publishing + quality checklist</li>
            </ul>
          </article>

          <article class="panel dj-track-card dj-track-card--bundle" data-in="bundle">
            <div class="dj-track-card__top">
              <span class="dj-track-card__num" data-i18n="dj.block4_num">Block 4</span>
              <span class="dj-track-card__badge" data-i18n="dj.block4_badge">Advanced layer</span>
              <a class="dj-plan-chip" href="#upgrade" data-i18n="dj.unlock_bundle">Unlock with Bundle</a>
            </div>
            <div class="dj-card-art-shell dj-card-art-shell--roadmap" aria-hidden="true">
              <img src="/assets/devjourneyicon14.webp" alt="" class="dj-card-art" loading="lazy" decoding="async" />
            </div>
            <h3 data-i18n="dj.block4_title">Architecture + integration</h3>
            <p data-i18n="dj.block4_desc">You learn design patterns, integration, and "product" decisions (what to build first and why).</p>
            <ul class="detail-list">
              <li data-i18n="dj.block4_li1">Guided refactor: clarity from names and tags to responsibility</li>
              <li data-i18n="dj.block4_li2">Integrations and data (common market flows)</li>
              <li data-i18n="dj.block4_li3">Anti-bug checklist before publishing</li>
            </ul>
          </article>

          <article class="panel dj-track-card dj-track-card--bundle" data-in="bundle">
            <div class="dj-track-card__top">
              <span class="dj-track-card__num" data-i18n="dj.block5_num">Block 5</span>
              <span class="dj-track-card__badge" data-i18n="dj.block5_badge">Final delivery</span>
              <a class="dj-plan-chip" href="#upgrade" data-i18n="dj.unlock_bundle">Unlock with Bundle</a>
            </div>
            <div class="dj-card-art-shell dj-card-art-shell--roadmap" aria-hidden="true">
              <img src="/assets/devjourneyicon13.webp" alt="" class="dj-card-art" loading="lazy" decoding="async" />
            </div>
            <h3 data-i18n="dj.block5_title">Deploy + professional finishing</h3>
            <p data-i18n="dj.block5_desc">You close the course with a complete project: documentation, deploy, repo and review-ready final version.</p>
            <ul class="detail-list">
              <li data-i18n="dj.block5_li1">Publishing and validation (GitHub)</li>
              <li data-i18n="dj.block5_li2">Final checklist (responsive, accessible, functional)</li>
              <li data-i18n="dj.block5_li3">Repo + live URL ready for manual review</li>
            </ul>
          </article>

          <article class="panel dj-track-card dj-track-card--arsenal" data-in="bundle">
            <div class="dj-track-card__top">
              <span class="dj-track-card__num" data-i18n="dj.arsenal_num">Arsenal Kit</span>
              <span class="dj-track-card__badge dj-track-card__badge--gold" data-i18n="dj.arsenal_badge">Bundle Only</span>
              <a class="dj-plan-chip" href="#upgrade" data-i18n="dj.unlock_bundle">Unlock with Bundle</a>
            </div>
            <div class="dj-card-art-shell dj-card-art-shell--roadmap" aria-hidden="true">
              <img src="/assets/bonus-project-devjourney.png" alt="" class="dj-card-art dj-card-art--wide" loading="lazy" decoding="async" />
            </div>
            <h3 data-i18n="dj.arsenal_title">A VOLYNX gift to accelerate your progress during and after the course!</h3>
            <p data-i18n="dj.arsenal_desc">Reusable files so you can build faster (and learn through reverse engineering).</p>
            <ul class="detail-list">
              <li data-i18n="dj.arsenal_li1">1 full site + 1 landing page</li>
              <li data-i18n="dj.arsenal_li2">2 ready JavaScript apps</li>
              <li data-i18n="dj.arsenal_li3">Cheatcodes (shortcuts and daily-use patterns)</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="page-section" id="access">
      <div class="shell grid-2 dj-access-layout">
        <article class="panel panel--pro dj-access-card">
          <span class="eyebrow">
            <span class="i18n-en">Free access with login</span>
            <span class="i18n-pt">Acesso grátis com login</span>
          </span>
          <h2 data-i18n="dj.free_access_title">Acesso grátis (com login)</h2>
          <p data-i18n="dj.free_access_desc">Start free. Login lets you save progress, download the Social ZIP, track your work and prepare the project for manual review.</p>
          <ul class="detail-list">
            <li>
              <span class="i18n-en">Student area keeps the journey attached to your account.</span>
              <span class="i18n-pt">A área do aluno mantém a jornada ligada à sua conta.</span>
            </li>
            <li>
              <span class="i18n-en">Checklist, downloads and review prep stop being loose docs and become part of the platform flow.</span>
              <span class="i18n-pt">Checklist, downloads e preparação de revisão deixam de ser documentos soltos e passam a fazer parte do fluxo da plataforma.</span>
            </li>
            <li>
              <span class="i18n-en">When Pro or Bundle is involved, delivery and recovery stay in the same VOLYNX lane.</span>
              <span class="i18n-pt">Quando Pro ou Bundle entram na jogada, entrega e recuperação continuam na mesma faixa da VOLYNX.</span>
            </li>
          </ul>
          <div class="dj-access-card__actions">
            <a class="button button--gold" href={ROUTES.devJourneyStudent} data-i18n="dj.btn_access">Entrar na área do aluno</a>
            <a class="button button--ghost" href="#faq" data-i18n="dj.link_faq">Ler o FAQ</a>
          </div>
        </article>

        <div class="dj-method-shell">
          <div class="section-head">
            <span class="eyebrow">
              <span class="i18n-en">Method</span>
              <span class="i18n-pt">Método</span>
            </span>
            <h2 data-i18n="dj.method_title">VOLYNX.Lab Education method</h2>
            <p data-i18n="dj.method_desc">Clear direction. Real deliverables. Professional results. Learn by shipping, not by studying.</p>
          </div>

          <div class="grid-3 dj-method-grid">
            {methodCards.map((card) => (
              <article class="panel dj-step-card">
                <div class="dj-card-art-shell dj-card-art-shell--feature" aria-hidden="true">
                  <img src={card.asset} alt="" class="dj-card-art dj-card-art--feature" loading="lazy" decoding="async" />
                </div>
                <h3 data-i18n={card.titleKey}>{card.title}</h3>
                <p data-i18n={card.descKey}>{card.desc}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="page-section" id="projects">
      <div class="shell">
        <div class="section-head section-head--split">
          <div>
            <span class="eyebrow">
              <span class="i18n-en">Portfolio output</span>
              <span class="i18n-pt">Saída de portfólio</span>
            </span>
            <h2 data-i18n="dj.projects_title">Projects that become portfolio</h2>
          </div>
          <p data-i18n="dj.projects_desc">It's not just about "learning". It's about building assets: pages, apps, and case studies that represent you.</p>
        </div>

        <div class="grid-3">
          {projectCards.map((card) => (
            <article class="panel dj-project-card">
              <div class="dj-card-art-shell dj-card-art-shell--feature" aria-hidden="true">
