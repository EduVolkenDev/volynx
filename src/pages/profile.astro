---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../components/FlagshipHeader.astro";
import FlagshipFooter from "../components/FlagshipFooter.astro";
import { ROUTES } from "../data/routes";
import { AVATAR_CATALOG } from "../data/avatars";

const PLAN_LABELS: Record<string, string> = {
	free: "Free",
	launch: "Launch",
	business: "Business",
	pro: "Pro",
	diamond: "Diamond",
	studio: "Studio",
	teams: "Teams",
	enterprise: "Enterprise",
};
const NON_BD_AVATARS = AVATAR_CATALOG.filter((a) => !a.bdOnly);
const BD_AVATARS = AVATAR_CATALOG.filter((a) => a.bdOnly);
---

<FlagshipLayout
	title="Profile — VOLYNX"
	description="Manage your VOLYNX account, profile settings, and subscription."
	ogImage="/assets/volynx-icon.webp"
	pageClass="page-profile"
>
	<script is:inline src="/js/vx-plan.js"></script>
	<script set:html={`window.VX_AVATAR_CATALOG = ${JSON.stringify(AVATAR_CATALOG)};`}></script>
	<FlagshipHeader current={ROUTES.profile} ctaLabel="Go Pro" ctaHref={ROUTES.pricing} ctaI18n="nav.go_pro" />

	<div class="orb orb-a" aria-hidden="true"></div>
	<div class="orb orb-b" aria-hidden="true"></div>

		<!-- ═══ VIEW: loading ═══ -->
		<div id="viewLoading" class="view view--active">
			<div class="spinner"></div>
			<p data-i18n="profile.loading"><span class="i18n-en">Loading your profile…</span><span class="i18n-pt">Carregando seu perfil…</span></p>
			<p class="text-muted" style="margin-top:8px;font-size:.85rem;opacity:.65;"><span class="i18n-en">Verifying your session.</span><span class="i18n-pt">Verificando sua sessão.</span></p>
		</div>

		<!-- ═══ VIEW: error ═══ -->
		<div id="viewError" class="view" style="display:none;">
			<p id="errorMsg" class="error-text" data-i18n="profile.error_generic">Something went wrong.</p>
			<a href={ROUTES.login} class="btn" data-i18n="profile.btn_signin">Sign in again</a>
		</div>

		<!-- ═══ VIEW: profile ═══ -->
		<div id="viewProfile" class="view" style="display:none;">

			<div id="firstTimeBanner" class="banner banner--welcome" style="display:none;" role="status">
				<div class="banner-row">
					<div>
						<p class="banner-title"><strong data-i18n="profile.welcome_title">Welcome to VOLYNX</strong></p>
						<p data-i18n="profile.welcome_desc">Complete your profile below to get started.</p>
					</div>
					<div class="banner-actions">
						<button type="button" class="btn btn--sm btn--ghost" id="firstTimeContinueBtn" data-i18n="profile.btn_continue_later" hidden>Continue where you were</button>
					</div>
				</div>
			</div>

			<div id="paymentSuccessBanner" class="banner banner--success" style="display:none;">
				<div class="banner-row">
					<span data-i18n="profile.payment_success">Payment confirmed! Your plan is now active.</span>
					<button type="button" class="btn btn--sm btn--ghost" data-i18n="profile.btn_dismiss" onclick="this.closest('.banner').style.display='none';history.replaceState({},'','/profile/');">Dismiss</button>
				</div>
			</div>

			<div id="welcomeBanner" class="banner banner--subtle" style="display:none;">
				<div class="banner-row">
					<span data-i18n="profile.welcome_back">Welcome back!</span>
					<div class="banner-actions">
						<button type="button" class="btn btn--sm" id="editProfileBtn" data-i18n="profile.btn_edit">Edit profile</button>
						<button type="button" class="btn btn--sm btn--ghost" id="continueBtn" data-i18n="profile.btn_continue">Continue</button>
					</div>
				</div>
			</div>

			<section class="hero">
				<div class="hero-inner">
					<div class="avatar-zone">
						<div class="avatar-glow" aria-hidden="true"></div>
						<div class="avatar-frame" id="avatarFrameBtn" role="button" tabindex="0" title="Change avatar" aria-haspopup="dialog" aria-expanded="false" aria-controls="avatarPanel">
							<img id="avatarPreview" class="avatar-img" src="/assets/avatar.webp" alt=""
								style="display:none;"
								onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
							<div class="avatar-fallback" id="avatarFallback">ME</div>
							<div class="avatar-overlay" id="avatarOverlay"><span data-i18n="profile.avatar_change">Change</span></div>
						</div>
						<input id="avatarInput" type="file" accept="image/*" hidden />

						<!-- Avatar picker panel -->
						<div class="avatar-panel" id="avatarPanel" role="dialog" aria-modal="true" aria-labelledby="avatarPanelTitle" hidden>
							<div class="avatar-panel__header">
								<span class="avatar-panel__title" id="avatarPanelTitle" data-i18n="profile.avatar_choose">Choose avatar</span>
								<button type="button" class="avatar-panel__close" id="avatarPanelClose" aria-label="Close avatar picker">✕</button>
							</div>

							<div class="avatar-panel__section">
								<span class="avatar-panel__label">
									<span class="i18n-en">Plan avatars</span>
									<span class="i18n-pt">Avatares por plano</span>
								</span>
								<div class="avatar-panel__grid">
									{NON_BD_AVATARS.map((a) => (
										<button
											type="button"
											class="avatar-option"
											data-avatar-id={a.id}
											data-avatar-plan={a.plan}
											data-avatar-src={a.src}
											title={`${a.label} · ${PLAN_LABELS[a.plan]}`}
											aria-label={`${a.label} · ${PLAN_LABELS[a.plan]}`}
										>
											<img src={a.src} alt={a.label} loading="lazy" />
											<span class="avatar-option__plan">{PLAN_LABELS[a.plan]}</span>
										</button>
									))}
								</div>
							</div>

							<div class="avatar-panel__section avatar-panel__section--bd" hidden>
								<span class="avatar-panel__label">
									<span class="i18n-en">Black Diamond</span>
									<span class="i18n-pt">Black Diamond</span>
									<span class="avatar-bd-tag">BD</span>
								</span>
								<div class="avatar-panel__grid">
									{BD_AVATARS.map((a) => (
										<button
											type="button"
											class="avatar-option avatar-option--bd"
											data-avatar-id={a.id}
											data-avatar-bd-only="1"
											data-avatar-src={a.src}
											title={a.label}
											aria-label={a.label}
										>
											<img src={a.src} alt={a.label} loading="lazy" />
										</button>
									))}
								</div>
							</div>

							<p class="avatar-panel__hint" id="avatarPanelHint" hidden>
								<span class="i18n-en">Locked avatars require a higher plan.</span>
								<span class="i18n-pt">Avatares bloqueados exigem um plano superior.</span>
							</p>
						</div>
					</div>
					<div class="hero-identity">
						<h1 id="profileName" class="hero-name">—</h1>
						<p id="profileHandle" class="hero-handle"></p>
						<p id="heroBio" class="hero-bio"></p>
						<div class="hero-meta">
							<span id="heroEmail">—</span>
							<span class="meta-sep"></span>
							<span id="heroLocation">—</span>
							<span class="meta-sep"></span>
							<span id="heroJoined">—</span>
						</div>
						<div class="hero-badges">
							<span id="heroPlan" class="plan-badge">Free</span>
							<a id="planCta" href={ROUTES.pricing} class="plan-cta" data-i18n="profile.btn_upgrade">Upgrade plan</a>
							<span id="planHelper" class="plan-helper" style="display:none"></span>
						</div>
					</div>
				</div>
				<div class="hero-cta">
					<a href={ROUTES.builder} class="btn" data-i18n="profile.btn_builder">Open Builder</a>
					<a href={ROUTES.studio} class="btn btn--ghost" data-i18n="profile.btn_studio">Studio Pro</a>
					<button type="button" class="btn btn--ghost" id="scrollToEdit" data-i18n="profile.btn_edit_profile">Edit profile</button>
				</div>
			</section>

			<section class="details-strip">
				<div class="detail-cell"><span class="detail-label" data-i18n="profile.label_fullname">Full name</span><strong id="detailName">—</strong></div>
				<div class="detail-cell"><span class="detail-label" data-i18n="profile.label_username">Username</span><strong id="detailUsername">—</strong></div>
				<div class="detail-cell"><span class="detail-label" data-i18n="profile.label_website">Website</span><strong id="detailWebsite">—</strong></div>
				<div class="detail-cell"><span class="detail-label" data-i18n="profile.label_email">Email</span><strong id="detailEmail">—</strong></div>
			</section>

			<section class="layer-passport glass-section" id="layerPassport" aria-labelledby="layerPassportTitle">
				<div class="section-headline">
					<div>
						<div class="section-label">
							<span class="i18n-en">Layer Passport</span>
							<span class="i18n-pt">Passaporte de camadas</span>
						</div>
						<h2 id="layerPassportTitle" class="layer-passport__title">
							<span class="i18n-en">Your VOLYNX identity across every layer.</span>
							<span class="i18n-pt">Sua identidade VOLYNX atravessando cada camada.</span>
						</h2>
						<p class="layer-passport__copy">
							<span class="i18n-en">Plans, VX, products, and daily context now live as one operational profile.</span>
							<span class="i18n-pt">Planos, VX, produtos e contexto diário agora aparecem como um perfil operacional único.</span>
						</p>
					</div>
					<a href={ROUTES.recarregar} class="btn btn--sm btn--ghost">
						<span id="layerVxBalance">0</span>&nbsp;VX
					</a>
				</div>

				<div class="layer-grid">
					<a href={ROUTES.platform} class="layer-card layer-card--core" data-layer-card="core">
						<span class="layer-card__media"><img src="/assets/dark-icon-light.webp" alt="" loading="lazy" /></span>
						<span class="layer-card__body">
							<span class="layer-card__name">VOLYNX</span>
							<span class="layer-card__desc">
								<span class="i18n-en">Core account, billing, VX, and ecosystem access.</span>
								<span class="i18n-pt">Conta central, pagamentos, VX e acesso ao ecossistema.</span>
							</span>
						</span>
						<span class="layer-card__status" id="layerCoreStatus">Active</span>
					</a>

					<a href={ROUTES.builder} class="layer-card" data-layer-card="builder">
						<span class="layer-card__media"><img src="/assets/new-builder.webp" alt="" loading="lazy" /></span>
						<span class="layer-card__body">
							<span class="layer-card__name">Builder</span>
							<span class="layer-card__desc">
								<span class="i18n-en">Sites, published pages, presets, and launch kits.</span>
								<span class="i18n-pt">Sites, páginas publicadas, presets e kits de lançamento.</span>
							</span>
						</span>
						<span class="layer-card__status" id="layerBuilderStatus">Free</span>
					</a>

					<a href="https://daily.volynx.world" class="layer-card" data-layer-card="daily">
						<span class="layer-card__media"><img id="layerDailyArt" src="/assets/daily-icon.webp" alt="" loading="lazy" /></span>
						<span class="layer-card__body">
							<span class="layer-card__name">Daily</span>
							<span class="layer-card__desc">
								<span class="i18n-en">Daily command, Vault, history, and AI routines.</span>
								<span class="i18n-pt">Comando diário, Vault, histórico e rotinas com IA.</span>
							</span>
						</span>
						<span class="layer-card__status" id="layerDailyStatus">Free</span>
					</a>

					<a href="https://cvitae.volynx.world" class="layer-card" data-layer-card="cvitae">
						<span class="layer-card__media"><img src="/assets/cvitae.webp" alt="" loading="lazy" /></span>
						<span class="layer-card__body">
							<span class="layer-card__name">CVitae</span>
							<span class="layer-card__desc">
								<span class="i18n-en">Career assets, resumes, exports, and applications.</span>
								<span class="i18n-pt">Ativos de carreira, currículos, exportações e candidaturas.</span>
							</span>
						</span>
						<span class="layer-card__status" id="layerCvitaeStatus">Free</span>
					</a>

					<a href={ROUTES.propertyflow} class="layer-card" data-layer-card="propertyflow">
						<span class="layer-card__media"><img src="/assets/propertyflow.webp" alt="" loading="lazy" /></span>
						<span class="layer-card__body">
							<span class="layer-card__name">PropertyFlow</span>
							<span class="layer-card__desc">
								<span class="i18n-en">Property pages, delivery assets, and real-estate workflows.</span>
								<span class="i18n-pt">Páginas imobiliárias, entregas e fluxos para imóveis.</span>
							</span>
						</span>
						<span class="layer-card__status layer-card__status--soft">
							<span class="i18n-en">Product</span>
							<span class="i18n-pt">Produto</span>
						</span>
					</a>
				</div>
			</section>

			<section class="lab-profile glass-section" id="labWorkspacePanel" aria-labelledby="labWorkspaceTitle">
				<div class="section-headline">
					<div>
						<div class="section-label">VOLYNX Lab</div>
						<h2 id="labWorkspaceTitle" class="lab-profile__title">
							<span class="i18n-en">Your tools now remember the work.</span>
							<span class="i18n-pt">Suas ferramentas agora lembram o trabalho.</span>
						</h2>
						<p class="lab-profile__copy">
							<span class="i18n-en">Recent exports, generated assets, and saved presets from Converter, Image Scaler, Image Suite, Lumina, and QRGen.</span>
							<span class="i18n-pt">Exportações recentes, ativos gerados e presets salvos do Converter, Image Scaler, Image Suite, Lumina e QRGen.</span>
						</p>
					</div>
					<a href={ROUTES.lab} class="btn btn--sm btn--ghost">
						<span class="i18n-en">Open Lab</span>
						<span class="i18n-pt">Abrir Lab</span>
					</a>
				</div>
				<div class="lab-profile__grid">
					<div>
						<strong class="lab-profile__heading">
							<span class="i18n-en">Recent activity</span>
							<span class="i18n-pt">Atividade recente</span>
						</strong>
						<div class="lab-profile__list" data-lab-history></div>
					</div>
					<div>
						<strong class="lab-profile__heading">
							<span class="i18n-en">Saved presets</span>
							<span class="i18n-pt">Presets salvos</span>
						</strong>
						<div class="lab-profile__list" data-lab-presets></div>
					</div>
				</div>
			</section>

			<section id="editPanel" class="glass-section">
				<div class="section-label" id="formLabel" data-i18n="profile.section_edit">Edit profile</div>
				<form id="profileForm" class="edit-form">
					<div class="form-grid">
						<label class="field"><span data-i18n="profile.form_fullname">Full name</span><input id="inputName" type="text" placeholder="Your full name" data-i18n-placeholder="profile.ph_fullname" /></label>
						<label class="field"><span data-i18n="profile.form_username">Username</span><input id="inputUsername" type="text" placeholder="username" data-i18n-placeholder="profile.ph_username" /></label>
						<label class="field"><span data-i18n="profile.form_email">Email</span><input id="inputEmail" type="email" disabled /></label>
						<label class="field"><span data-i18n="profile.form_website">Website</span><input id="inputWebsite" type="url" placeholder="https://..." data-i18n-placeholder="profile.ph_website" /></label>
						<label class="field"><span data-i18n="profile.form_location">Location</span><input id="inputLocation" type="text" placeholder="City, Country" data-i18n-placeholder="profile.ph_location" /></label>
						<label class="field field--full"><span data-i18n="profile.form_bio">Bio</span><textarea id="inputBio" rows="4" placeholder="Tell us about yourself..." data-i18n-placeholder="profile.ph_bio"></textarea></label>
					</div>
					<div class="form-footer">
						<button type="submit" class="btn" id="saveBtn" data-i18n="profile.btn_save">Save changes</button>
						<button type="button" class="btn btn--ghost" id="resetBtn" data-i18n="profile.btn_reset">Reset</button>
						<p class="form-status" id="saveStatus"></p>
					</div>
				</form>
			</section>

			<section id="vxSection" class="token-section glass-section">
				<div class="section-label" data-i18n="profile.section_tokens">VX Available</div>
				<div class="token-overview">
					<div class="token-balance-display">
						<span class="token-balance-number" id="tokenBalance">—</span>
						<span class="token-balance-label" data-i18n="profile.tokens_available">VX available</span>
					</div>
					<div class="vx-actions" style="display:flex;flex-wrap:wrap;gap:8px;">
						<a href={ROUTES.recarregar} class="btn btn--sm" id="buyTokensBtn" data-i18n="profile.btn_tokens">Get VX</a>
						<a href="#tokenHistory" class="btn btn--sm btn--ghost" data-i18n="profile.btn_view_usage">View usage</a>
						<a href={ROUTES.pricing} class="btn btn--sm btn--ghost" data-i18n="profile.btn_see_plans">See plans</a>
					</div>
				</div>
				<p class="text-muted vx-support" style="font-size:.85rem;margin:12px 0 4px;line-height:1.6;" data-i18n="profile.vx_support">Your VX balance can be used where a product explicitly supports VX, such as CVitae exports/templates and selected Studio actions.</p>
				<div id="tokenHistory" class="token-history">
					<p class="text-muted" style="font-size:.85rem;" data-i18n="profile.loading_history">Loading history...</p>
				</div>
			</section>

			<!-- ═══ SUBSCRIPTIONS (multi-product) ═══ -->
			<section class="glass-section" id="subscriptionsSection">
				<div class="section-label" data-i18n="profile.your_subscriptions">Your Subscriptions</div>
				<div class="subs-grid" id="subsGrid">
					<div class="sub-card">
						<div class="sub-card__icon"><img src="/assets/new-builder.webp" alt="" class="profile-card__art" loading="lazy" /></div>
						<div class="sub-card__label">VOLYNX Builder</div>
						<div class="sub-card__plan" id="subBuilderPlan">Free</div>
						<a href={ROUTES.pricing} class="sub-card__link" id="subBuilderCta" data-i18n="profile.sub_upgrade">Upgrade</a>
					</div>
					<div class="sub-card">
						<div class="sub-card__icon"><img id="subDailyArt" src="/assets/daily-icon.webp" alt="" class="profile-card__art" loading="lazy" /></div>
						<div class="sub-card__label">VOLYNX Daily</div>
						<div class="sub-card__plan" id="subDailyPlan">Free</div>
						<a href="https://daily.volynx.world/pricing/" class="sub-card__link" id="subDailyCta" data-i18n="profile.sub_upgrade">Upgrade</a>
					</div>
					<div class="sub-card">
						<div class="sub-card__icon"><img src="/assets/cvitae.webp" alt="" class="profile-card__art profile-card__art--portrait" loading="lazy" /></div>
						<div class="sub-card__label">CVitae</div>
						<div class="sub-card__plan" id="subCvitaePlan">Free</div>
						<a href="https://cvitae.volynx.world/profile/" class="sub-card__link" id="subCvitaeCta" data-i18n="profile.sub_upgrade">Upgrade</a>
					</div>
					<div class="sub-card">
						<div class="sub-card__icon"><img src="/assets/VX4.webp" alt="" class="profile-card__art profile-card__art--mark" loading="lazy" /></div>
						<div class="sub-card__label" data-i18n="profile.sub_tokens_label">VX</div>
						<div class="sub-card__plan" id="subTokens">0</div>
						<a href={ROUTES.recarregar} class="sub-card__link" data-i18n="profile.sub_buy_tokens">Get VX</a>
					</div>
				</div>
			</section>

			<section class="glass-section" id="iconPurchasesSection" style="display:none;">
				<div class="section-headline">
					<div>
						<div class="section-label">Your icon purchases</div>
						<p class="section-subcopy">Singles and packs unlocked through Stripe checkout.</p>
					</div>
					<a href={ROUTES.iconsStore} class="btn btn--sm btn--ghost">Open Icon Vault</a>
				</div>
				<div class="icon-purchases-grid" id="iconPurchasesGrid">
					<p class="text-muted" style="font-size:.85rem;">Checking icon purchases...</p>
				</div>
			</section>

			<!-- ═══ QUICK ACCESS ═══ -->
			<section class="glass-section">
				<div class="section-label" data-i18n="profile.quick_access">Quick Access</div>
				<div class="quick-grid">
					<a href={ROUTES.builder} class="quick-card">
						<span class="quick-card__icon"><img src="/assets/new-builder.webp" alt="" class="profile-card__art" loading="lazy" /></span>
						<span class="quick-card__title" data-i18n="profile.quick_builder_title">Builder</span>
						<span class="quick-card__desc text-muted" data-i18n="profile.quick_builder_desc">Create & publish sites</span>
					</a>
					<a href={ROUTES.studio} class="quick-card">
						<span class="quick-card__icon"><img src="/assets/volynxstudio.webp" alt="" class="profile-card__art profile-card__art--studio" loading="lazy" /></span>
						<span class="quick-card__title" data-i18n="profile.quick_studio_title">Studio Pro</span>
						<span class="quick-card__desc text-muted" data-i18n="profile.quick_studio_desc">Image tools & exports</span>
					</a>
					<a href={ROUTES.iconsStore} class="quick-card">
						<span class="quick-card__icon quick-card__icon--vault"><img src="/assets/icons-store-logo.webp" alt="" class="profile-card__art profile-card__art--vault" loading="lazy" /></span>
						<span class="quick-card__title" data-i18n="profile.quick_icons_title">Icon Vault</span>
						<span class="quick-card__desc text-muted" data-i18n="profile.quick_icons_desc">Browse packs</span>
					</a>
					<a href="https://daily.volynx.world/tools/my-day/" class="quick-card">
						<span class="quick-card__icon"><img src="/assets/daily-icon.webp" alt="" class="profile-card__art" loading="lazy" /></span>
						<span class="quick-card__title" data-i18n="profile.quick_daily_title">Daily OS</span>
						<span class="quick-card__desc text-muted" data-i18n="profile.quick_daily_desc">Your daily dashboard</span>
					</a>
				</div>
			</section>

			<section class="bottom-grid">
				<div class="glass-section glass-section--compact">
					<div class="section-label" data-i18n="profile.section_activity">Activity</div>
					<div class="timeline-row"><div class="dot"></div><div><strong data-i18n="profile.activity_created">Account created</strong><br/><span id="activityJoined" class="text-muted">—</span></div></div>
				</div>
				<div class="glass-section glass-section--compact">
					<div class="section-label" data-i18n="profile.section_security">Security</div>
					<div class="info-row"><span data-i18n="profile.security_password">Password</span><strong data-i18n="profile.security_set">Set</strong></div>
					<div class="info-row" style="margin-top:8px;">
						<button type="button" class="btn btn--sm" id="changePasswordBtn" data-i18n="profile.change_password">Change password</button>
					</div>
					<div id="passwordForm" hidden style="margin-top:12px;">
						<div style="display:grid;gap:8px;">
							<input id="newPassword" type="password" placeholder="New password (min 6 chars)" data-i18n-placeholder="profile.password_new_ph" minlength="6" class="field-input" style="padding:10px 14px;border-radius:12px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.04);color:#fff;font-size:.9rem;" />
							<input id="confirmPassword" type="password" placeholder="Confirm new password" data-i18n-placeholder="profile.password_confirm_ph" class="field-input" style="padding:10px 14px;border-radius:12px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.04);color:#fff;font-size:.9rem;" />
							<div style="display:flex;gap:8px;align-items:center;">
								<button type="button" class="btn btn--sm" id="savePasswordBtn" data-i18n="profile.password_save">Save password</button>
