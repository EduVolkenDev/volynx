---
import PageWidgets from "../components/PageWidgets.astro";

const user = {
	name: "Eduardo Volken",
	username: "@eduardo",
	email: "eduardo@volynx.world",
	role: "VOLYNX Pro Member",
	plan: "VOLYNX Pro",
	status: "Active",
	joinedAt: "Jan 2026",
	location: "Brazil",
	website: "https://volynx.world",
	bio: "Your identity layer inside VOLYNX. Access, settings, activity and control in one premium command center.",
	avatar: "/assets/avatar.webp",
	cover: "/assets/fluxprofile2.jpg", // troque se quiser
};

const stats = [
	{ label: "Projects", value: "12", hint: "Active in workspace" },
	{ label: "Tools Used", value: "08", hint: "Across VOLYNX ecosystem" },
	{ label: "Exports", value: "184", hint: "Last 30 days" },
	{ label: "Plan Cycle", value: "17 days", hint: "Until renewal" },
];

const activity = [
	{ title: "Image Suite export completed", meta: "Today · 14:22" },
	{ title: "Plan renewed successfully", meta: "Mar 02, 2026 · 09:10" },
	{ title: "Password updated", meta: "Feb 28, 2026 · 22:41" },
	{ title: "New login from iMac", meta: "Feb 28, 2026 · 22:39" },
];

const sessions = [
	{ device: "iMac 21.5", browser: "Chrome · macOS", location: "Brazil", current: true },
	{ device: "MacBook Pro 16", browser: "Safari · macOS", location: "Brazil", current: false },
	{ device: "iPhone", browser: "Safari · iOS", location: "Brazil", current: false },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Profile — VOLYNX</title>
		<meta
			name="description"
			content="Manage your VOLYNX account, profile, plan, security and activity."
		/>
	</head>

	<body>
		<div class="page-shell">
			<div class="ambient ambient-a"></div>
			<div class="ambient ambient-b"></div>

			<header class="topbar">
				<a href="/" class="brand" aria-label="VOLYNX home">
					<span class="brand-mark">V</span>
					<span class="brand-text">VOLYNX</span>
				</a>

				<nav class="topbar-nav" aria-label="Primary navigation">
					<a href="/volynx-lab/studio/">Studio</a>
					<a href="/pricing/">Pricing</a>
					<a href="/contact/">Support</a>
					<button type="button" class="logout-btn" id="logoutBtn">Sign out</button>
				</nav>
			</header>

			<!-- Welcome banner (shown after login) -->
			<div id="welcomeBanner" class="welcome-banner" hidden>
				<div class="welcome-inner">
					<div class="welcome-text">
						<strong>Welcome back!</strong>
						<span>Want to complete your profile, or continue where you left off?</span>
					</div>
					<div class="welcome-actions">
						<button type="button" class="btn btn-primary" id="editProfileBtn">Edit profile</button>
						<button type="button" class="btn btn-secondary" id="continueBtn">Continue task</button>
					</div>
				</div>
			</div>

			<main class="container">
				<section class="profile-cover card">
					<div class="cover-media">
						<img src={user.cover} alt="" />
					</div>

					<div class="cover-overlay"></div>

					<div class="profile-hero">
						<div class="profile-main">
							<div class="avatar-wrap">
								<img
									id="avatarPreview"
									class="avatar-image"
									src={user.avatar}
									alt={`${user.name} avatar`}
									onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
								/>
								<div class="avatar-fallback" style="display:none;">EV</div>
								<label class="avatar-edit" for="avatarInput">Change</label>
								<input id="avatarInput" type="file" accept="image/*" hidden />
							</div>

							<div class="identity-block">
								<p class="eyebrow">Profile</p>
								<h1 id="profileName">{user.name}</h1>
								<p class="handle" id="profileHandle">{user.username}</p>

								<div class="hero-tags">
									<span>{user.role}</span>
									<span>{user.location}</span>
									<span>Member since {user.joinedAt}</span>
								</div>
							</div>
						</div>

						<div class="hero-actions">
							<a href="/volynx-lab/studio/" class="btn btn-primary">Open Studio</a>
							<button type="button" class="btn btn-secondary" id="scrollToEdit">
								Edit profile
							</button>
						</div>
					</div>
				</section>

				<section class="stats-grid">
					{
						stats.map((item) => (
							<article class="card stat-card">
								<p class="mini-label">{item.label}</p>
								<div class="stat-value">{item.value}</div>
								<p>{item.hint}</p>
							</article>
						))
					}
				</section>

				<section class="content-grid">
					<div class="main-column">
						<section class="card section-card">
							<div class="section-head">
								<div>
									<p class="mini-label">Account overview</p>
									<h3>Core identity</h3>
								</div>
								<span class="status-pill">{user.status}</span>
							</div>

							<div class="identity-summary">
								<div class="info-item">
									<span>Full name</span>
									<strong id="summaryName">{user.name}</strong>
								</div>

								<div class="info-item">
									<span>Email</span>
									<strong id="summaryEmail">{user.email}</strong>
								</div>

								<div class="info-item">
									<span>Username</span>
									<strong id="summaryUsername">{user.username}</strong>
								</div>

								<div class="info-item">
									<span>Website</span>
									<strong id="summaryWebsite">{user.website}</strong>
								</div>

								<div class="info-item full">
									<span>Bio</span>
									<strong id="summaryBio">{user.bio}</strong>
								</div>
							</div>
						</section>

						<section id="editPanel" class="card section-card">
							<div class="section-head">
								<div>
									<p class="mini-label">Profile editor</p>
									<h3>Edit your public identity</h3>
								</div>
							</div>

							<form class="profile-form" id="profileForm">
								<div class="field-grid">
									<label class="field">
										<span>Full name</span>
										<input id="inputName" type="text" value={user.name} />
									</label>

									<label class="field">
										<span>Username</span>
										<input id="inputUsername" type="text" value={user.username} />
									</label>

									<label class="field">
										<span>Email</span>
										<input type="email" value={user.email} disabled />
									</label>

									<label class="field">
										<span>Website</span>
										<input id="inputWebsite" type="url" value={user.website} />
									</label>

									<label class="field full">
										<span>Bio</span>
										<textarea id="inputBio" rows="5">{user.bio}</textarea>
									</label>
								</div>

								<div class="form-actions">
									<button type="submit" class="btn btn-primary">Save changes</button>
									<button type="reset" class="btn btn-secondary" id="resetProfile">
										Reset
									</button>
									<p class="form-note" id="saveStatus">Local preview only for now.</p>
								</div>
							</form>
						</section>

						<section class="card section-card">
							<div class="section-head">
								<div>
									<p class="mini-label">Recent activity</p>
									<h3>Account timeline</h3>
								</div>
								<a href="/activity/" class="text-action">View all</a>
							</div>

							<div class="timeline">
								{
									activity.map((item) => (
										<div class="timeline-item">
											<div class="timeline-dot"></div>
											<div class="timeline-copy">
												<strong>{item.title}</strong>
												<span>{item.meta}</span>
											</div>
										</div>
									))
								}
							</div>
						</section>
					</div>

					<aside class="side-column">
						<section class="card side-card plan-card">
							<div class="section-head">
								<div>
									<p class="mini-label">Current plan</p>
									<h3>{user.plan}</h3>
								</div>
							</div>

							<div class="plan-grid">
								<div>
									<span class="mini-label">Billing</span>
									<strong>£19/month</strong>
								</div>

								<div>
									<span class="mini-label">Renewal</span>
									<strong>Apr 02, 2026</strong>
								</div>

								<div>
									<span class="mini-label">Rights</span>
									<strong>Commercial</strong>
								</div>

								<div>
									<span class="mini-label">Processing</span>
									<strong>Cloud + Local</strong>
								</div>
							</div>

							<a href="/pricing/" class="inline-link">Manage subscription <span aria-hidden="true">→</span></a>
						</section>

						<section class="card side-card">
							<div class="section-head">
								<div>
									<p class="mini-label">Preferences</p>
									<h3>Experience controls</h3>
								</div>
							</div>

							<div class="preferences">
								<label class="toggle-row">
									<div>
										<strong>Analytics cookies</strong>
										<p>Help improve the platform responsibly.</p>
									</div>
									<input type="checkbox" checked />
								</label>

								<label class="toggle-row">
									<div>
										<strong>Product emails</strong>
										<p>Updates about tools, launches and improvements.</p>
									</div>
									<input type="checkbox" />
								</label>

								<label class="toggle-row">
									<div>
										<strong>Public presence</strong>
										<p>Show member badge and public creator status.</p>
									</div>
									<input type="checkbox" checked />
								</label>
							</div>
						</section>

						<section class="card side-card">
							<div class="section-head">
								<div>
									<p class="mini-label">Active sessions</p>
									<h3>Connected devices</h3>
								</div>
							</div>

							<ul class="session-list">
								{
									sessions.map((session) => (
										<li class="session-item">
											<div>
												<strong>
													{session.device}
													{session.current ? " · Current" : ""}
												</strong>
												<span>{session.browser}</span>
												<span>{session.location}</span>
											</div>

											{session.current ? (
												<span class="session-badge">Now</span>
											) : (
												<button type="button" class="session-btn">Revoke</button>
											)}
										</li>
									))
								}
							</ul>
						</section>

						<section class="card side-card support-card">
							<p class="mini-label">Security</p>
							<h3>Protected access</h3>

							<ul class="side-list">
								<li>
									<span>Password</span>
									<strong>Last updated 17 days ago</strong>
								</li>
								<li>
									<span>2FA</span>
									<strong>Not enabled</strong>
								</li>
								<li>
									<span>Recovery email</span>
									<strong>{user.email}</strong>
								</li>
							</ul>

							<a href="/settings/security/" class="btn btn-secondary btn-block">
								Review security
							</a>
						</section>
					</aside>
				</section>
			</main>
		</div>

		<script is:inline>
			// --- Session & welcome banner ---
			(function () {
				// Redirect to login if no session
				const token = localStorage.getItem("volynx_access_token");
				if (!token) { window.location.href = "/login/?next=/profile/"; return; }

				// Load real email
				const email = localStorage.getItem("volynx_user_email") || "";
				const emailEl = document.getElementById("summaryEmail");
				if (emailEl && email) emailEl.textContent = email;

				// Welcome banner
				const params = new URLSearchParams(window.location.search);
				if (params.get("welcome") === "1") {
					document.getElementById("welcomeBanner").hidden = false;
					// Clean URL without reload
					history.replaceState({}, "", "/profile/");
				}

				// Continue task button
				document.getElementById("continueBtn")?.addEventListener("click", () => {
					const next = localStorage.getItem("volynx_post_login_next") || "/volynx-lab/studio/";
					localStorage.removeItem("volynx_post_login_next");
					window.location.href = next;
				});

				// Edit profile button — just dismiss banner and stay
				document.getElementById("editProfileBtn")?.addEventListener("click", () => {
					document.getElementById("welcomeBanner").hidden = true;
				});

				// Logout
				document.getElementById("logoutBtn")?.addEventListener("click", () => {
					localStorage.removeItem("volynx_access_token");
					localStorage.removeItem("volynx_refresh_token");
					localStorage.removeItem("volynx_user_email");
					localStorage.removeItem("volynx_session");
					localStorage.removeItem("volynx_post_login_next");
					window.location.href = "/";
				});
			})();
		</script>

		<script is:inline>
			const avatarInput = document.getElementById("avatarInput");
			const avatarPreview = document.getElementById("avatarPreview");
			const avatarFallback = document.querySelector(".avatar-fallback");
			const scrollToEdit = document.getElementById("scrollToEdit");
			const editPanel = document.getElementById("editPanel");
			const profileForm = document.getElementById("profileForm");
			const resetProfile = document.getElementById("resetProfile");
			const saveStatus = document.getElementById("saveStatus");

			const inputName = document.getElementById("inputName");
			const inputUsername = document.getElementById("inputUsername");
			const inputWebsite = document.getElementById("inputWebsite");
			const inputBio = document.getElementById("inputBio");

			const profileName = document.getElementById("profileName");
			const profileHandle = document.getElementById("profileHandle");
			const summaryName = document.getElementById("summaryName");
			const summaryUsername = document.getElementById("summaryUsername");
			const summaryWebsite = document.getElementById("summaryWebsite");
			const summaryBio = document.getElementById("summaryBio");

			const initialData = {
				name: inputName.value,
				username: inputUsername.value,
				website: inputWebsite.value,
				bio: inputBio.value
			};

			scrollToEdit?.addEventListener("click", () => {
				editPanel?.scrollIntoView({ behavior: "smooth", block: "start" });
			});

			avatarInput?.addEventListener("change", (event) => {
				const file = event.target.files?.[0];
				if (!file) return;

				const url = URL.createObjectURL(file);
				avatarPreview.src = url;
				avatarPreview.style.display = "block";
				if (avatarFallback) avatarFallback.style.display = "none";
			});

			function applyProfilePreview() {
				const name = inputName.value.trim() || "Unnamed User";
				const username = inputUsername.value.trim() || "@username";
				const website = inputWebsite.value.trim() || "-";
				const bio = inputBio.value.trim() || "No bio added yet.";

				profileName.textContent = name;
				profileHandle.textContent = username;
				summaryName.textContent = name;
				summaryUsername.textContent = username;
				summaryWebsite.textContent = website;
				summaryBio.textContent = bio;
			}

			profileForm?.addEventListener("submit", (e) => {
				e.preventDefault();
				applyProfilePreview();
				saveStatus.textContent = "Profile preview updated successfully.";
			});

			resetProfile?.addEventListener("click", () => {
				setTimeout(() => {
					inputName.value = initialData.name;
					inputUsername.value = initialData.username;
					inputWebsite.value = initialData.website;
					inputBio.value = initialData.bio;
					applyProfilePreview();
					saveStatus.textContent = "Profile reset to initial values.";
				}, 0);
			});
		</script>

		<PageWidgets />
	</body>
</html>

<style>
	:root {
		--bg: #06070b;
		--bg-soft: rgba(90, 60, 138, 0.325);
		--panel: rgba(9, 12, 24, 0.46);
		--line: rgba(255, 255, 255, 0.1);
		--line-strong: rgba(255, 255, 255, 0.16);
		--text: #f5f7fb;
		--muted: rgba(245, 247, 251, 0.66);
		--muted-2: rgba(245, 247, 251, 0.48);
		--accent: #00e8c5;
		--accent-soft: rgba(137, 234, 243, 0.703);
		--success: #8fe0b5;
		--danger: #ff7676;
		--radius-xl: 28px;
		--radius-lg: 22px;
		--radius-md: 16px;
		--radius-sm: 12px;
		--shadow: 0 30px 80px rgba(0, 0, 0, 0.535);
		--container: 1240px;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		background-image: url(/assets/fluxprofile2.jpg);
		background-size: cover;
		background-position: center;
		background-attachment: fixed;
		background-color: #05060a;
	}

	body {
		margin: 0;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
			"Segoe UI", sans-serif;
		color: var(--text);
		background: linear-gradient(180deg, rgba(3, 4, 8, 0.45), rgba(5, 6, 10, 0.82));
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	button,
	input,
	textarea {
		font: inherit;
	}

	button {
		cursor: pointer;
	}

	.page-shell {
		position: relative;
		min-height: 100vh;
		overflow: clip;
	}

	.ambient {
		position: absolute;
		border-radius: 999px;
		filter: blur(70px);
		opacity: 0.45;
		pointer-events: none;
	}

	.ambient-a {
		top: -120px;
		right: -60px;
		width: 280px;
		height: 280px;
		background: rgba(120, 0, 255, 0.2);
	}

	.ambient-b {
		left: -80px;
		bottom: 8%;
		width: 240px;
		height: 240px;
		background: rgba(0, 232, 197, 0.14);
	}

	.container {
		width: min(calc(100% - 32px), var(--container));
		margin: 0 auto;
		padding: 18px 0 56px;
	}

	.topbar {
		width: min(calc(100% - 32px), var(--container));
		margin: 0 auto;
		padding: 22px 0 10px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-weight: 800;
		letter-spacing: 0.16em;
		font-size: 0.82rem;
	}

	.brand-mark {
		width: 38px;
		height: 38px;
		display: grid;
		place-items: center;
		border-radius: 14px;
		background:
			linear-gradient(135deg, rgba(255,255,255,0.12), rgba(255,255,255,0.02)),
			radial-gradient(circle at top left, rgba(0,232,197,0.26), transparent 62%);
		border: 1px solid var(--line);
		box-shadow:
			inset 0 1px 0 rgba(255,255,255,0.06),
			0 0 12px rgba(0, 232, 197, 0.18);
	}

	.brand-text {
		color: var(--text);
		text-shadow: 0 0 12px rgba(0, 232, 197, 0.22);
	}

	.topbar-nav {
		display: inline-flex;
		align-items: center;
		gap: 18px;
		flex-wrap: wrap;
	}

	.topbar-nav a {
		color: var(--muted);
		font-size: 0.95rem;
		transition: color 0.2s ease, text-shadow 0.2s ease;
	}

	.topbar-nav a:hover {
		color: var(--text);
		text-shadow: 0 0 10px rgba(0, 232, 197, 0.5);
	}

	.card {
		background:
			linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.03)),
			var(--panel);
		border: 1px solid var(--line);
		box-shadow: var(--shadow);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
	}

	.profile-cover {
		position: relative;
		border-radius: var(--radius-xl);
		overflow: hidden;
		min-height: 320px;
		margin-top: 12px;
	}

	.cover-media {
		position: absolute;
		inset: 0;
	}

	.cover-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		filter: saturate(1.05) contrast(1.05);
	}

	.cover-overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(6, 7, 11, 0.16), rgba(6, 7, 11, 0.78)),
			linear-gradient(90deg, rgba(95, 0, 170, 0.24), rgba(0, 232, 197, 0.08));
	}

	.profile-hero {
		position: relative;
		z-index: 2;
		min-height: 320px;
		padding: 28px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 24px;
	}

	.profile-main {
		display: flex;
		align-items: end;
		gap: 22px;
		flex-wrap: wrap;
	}

	.avatar-wrap {
		position: relative;
		width: 118px;
		height: 118px;
		flex: 0 0 auto;
	}

	.avatar-image,
	.avatar-fallback {
		width: 230px;
		height: auto;
		border-radius: 28px;
		border: 3px solid rgba(255, 255, 255, 0.75);
		box-shadow:
			inset 0 0 5px 1px rgba(15, 203, 177, 0.74),
			0 0 50px 10px rgba(134, 26, 242, 0.35);
		background: linear-gradient(33deg, #af00ff 0%, #6abfd9 48%, #7d0fc9 100%);
		object-fit: cover;
	}

	.avatar-fallback {
		display: grid;
		place-items: center;
		font-size: 1.5rem;
		font-weight: 800;
		color: #eff7ff;
		text-shadow: 0 0 10px rgba(0, 0, 0, 0.45);
	}

	.avatar-edit {
		position: absolute;
		right: -6px;
		bottom: -6px;
		padding: 8px 12px;
		border-radius: 999px;
		background: rgba(13, 17, 33, 0.92);
		border: 1px solid rgba(255,255,255,0.18);
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--text);
		cursor: pointer;
		box-shadow: 0 0 16px rgba(0, 232, 197, 0.1);
	}

	.identity-block {
flex: 1 1 420px;
  max-width: 600px;
  margin: auto;	}

	.eyebrow,
	.mini-label {
		font-size: 0.76rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
		margin: 0 0 8px;
		text-shadow: 0 0 12px rgba(0, 232, 197, 0.35);
	}

	h1,
	h2,
	h3,
	h4,
	p {
		margin-top: 0;
	}

	.identity-block h1 {
