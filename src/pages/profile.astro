---
import PageWidgets from "../components/PageWidgets.astro";
import Topbar from "../components/Topbar.astro";
import { ROUTES } from "../data/routes";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Profile — VOLYNX</title>
		<meta name="description" content="Manage your VOLYNX account, profile settings, and subscription." />

		<!-- Open Graph Tags -->
		<meta property="og:title" content="Profile — VOLYNX" />
		<meta property="og:description" content="Manage your VOLYNX account, profile settings, and subscription." />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://volynx.world/profile/" />
		<meta property="og:image" content="https://volynx.world/assets/volynx-icon.webp" />

		<script is:inline src="/js/vx-plan.js"></script>
	</head>

	<body>
		<div class="orb orb-a" aria-hidden="true"></div>
		<div class="orb orb-b" aria-hidden="true"></div>

		<Topbar leftLinks={[
			{ href: ROUTES.builder, label: "Builder" },
			{ href: ROUTES.studio, label: "Studio" },
			{ href: ROUTES.pricing, label: "Pricing" },
		]}>
			<button slot="right" type="button" class="logout-btn" id="logoutBtn">Sign out</button>
		</Topbar>

		<!-- ═══ VIEW: loading ═══ -->
		<div id="viewLoading" class="view view--active">
			<div class="spinner"></div>
			<p data-i18n="profile.loading">Loading your profile...</p>
		</div>

		<!-- ═══ VIEW: error ═══ -->
		<div id="viewError" class="view" style="display:none;">
			<p id="errorMsg" class="error-text" data-i18n="profile.error_generic">Something went wrong.</p>
			<a href={ROUTES.login} class="btn" data-i18n="profile.btn_signin">Sign in again</a>
		</div>

		<!-- ═══ VIEW: profile ═══ -->
		<div id="viewProfile" class="view" style="display:none;">

			<div id="firstTimeBanner" class="banner banner--welcome" style="display:none;">
				<h2 data-i18n="profile.welcome_title">Welcome to VOLYNX</h2>
				<p data-i18n="profile.welcome_desc">Complete your profile below to get started.</p>
			</div>

			<div id="paymentSuccessBanner" class="banner banner--success" style="display:none;">
				<div class="banner-row">
					<span data-i18n="profile.payment_success">Payment confirmed! Your plan is now active.</span>
					<button type="button" class="btn btn--sm btn--ghost" data-i18n="profile.btn_dismiss" onclick="this.closest('.banner').style.display='none';history.replaceState({},'','/profile/');">Dismiss</button>
				</div>
			</div>

			<div id="welcomeBanner" class="banner banner--subtle" style="display:none;">
				<div class="banner-row">
					<span data-i18n="profile.welcome_back">Welcome back!</span>
					<div class="banner-actions">
						<button type="button" class="btn btn--sm" id="editProfileBtn" data-i18n="profile.btn_edit">Edit profile</button>
						<button type="button" class="btn btn--sm btn--ghost" id="continueBtn" data-i18n="profile.btn_continue">Continue</button>
					</div>
				</div>
			</div>

			<section class="hero">
				<div class="hero-inner">
					<div class="avatar-zone">
						<div class="avatar-glow" aria-hidden="true"></div>
						<div class="avatar-frame" id="avatarFrameBtn" role="button" tabindex="0" title="Change avatar">
							<img id="avatarPreview" class="avatar-img" src="/assets/avatar.webp" alt=""
								style="display:none;"
								onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
							<div class="avatar-fallback" id="avatarFallback">??</div>
							<div class="avatar-overlay" id="avatarOverlay"><span data-i18n="profile.avatar_change">Change</span></div>
						</div>
						<input id="avatarInput" type="file" accept="image/*" hidden />

						<!-- Avatar picker panel -->
						<div class="avatar-panel" id="avatarPanel" hidden>
							<div class="avatar-panel__header">
								<span class="avatar-panel__title" data-i18n="profile.avatar_choose">Choose avatar</span>
								<button type="button" class="avatar-panel__close" id="avatarPanelClose">✕</button>
							</div>

							<div class="avatar-panel__section">
								<span class="avatar-panel__label" data-i18n="profile.avatar_free">Free</span>
								<div class="avatar-panel__grid">
									<button type="button" class="avatar-option" data-avatar="/assets/avatarfree/1.png">
										<img src="/assets/avatarfree/1.png" alt="Avatar 1" />
									</button>
									<button type="button" class="avatar-option" data-avatar="/assets/avatarfree/2.png">
										<img src="/assets/avatarfree/2.png" alt="Avatar 2" />
									</button>
									<button type="button" class="avatar-option" data-avatar="/assets/avatarfree/avatarfree3.webp">
										<img src="/assets/avatarfree/avatarfree3.webp" alt="Avatar 3" />
									</button>
								</div>
							</div>

							<div class="avatar-panel__section" id="proAvatarSection" hidden>
								<span class="avatar-panel__label">Pro <span class="avatar-pro-tag">PRO</span></span>
								<div class="avatar-panel__grid" id="proAvatarGrid"></div>
							</div>

							<div class="avatar-panel__section">
								<span class="avatar-panel__label" data-i18n="profile.avatar_custom">Custom</span>
								<div class="avatar-panel__grid">
									<label class="avatar-option avatar-option--upload" for="avatarInput">
										<span data-i18n="profile.avatar_upload">+ Upload</span>
									</label>
								</div>
							</div>
						</div>
					</div>
					<div class="hero-identity">
						<h1 id="profileName" class="hero-name">—</h1>
						<p id="profileHandle" class="hero-handle"></p>
						<p id="heroBio" class="hero-bio"></p>
						<div class="hero-meta">
							<span id="heroEmail">—</span>
							<span class="meta-sep"></span>
							<span id="heroLocation">—</span>
							<span class="meta-sep"></span>
							<span id="heroJoined">—</span>
						</div>
						<div class="hero-badges">
							<span id="heroPlan" class="plan-badge">Free</span>
							<a id="planCta" href={ROUTES.pricing} class="plan-cta" data-i18n="profile.btn_upgrade">Upgrade plan</a>
							<span id="planHelper" class="plan-helper" style="display:none"></span>
						</div>
					</div>
				</div>
				<div class="hero-cta">
					<a href={ROUTES.builder} class="btn" data-i18n="profile.btn_builder">Open Builder</a>
					<a href={ROUTES.studio} class="btn btn--ghost" data-i18n="profile.btn_studio">Studio Pro</a>
					<button type="button" class="btn btn--ghost" id="scrollToEdit" data-i18n="profile.btn_edit_profile">Edit profile</button>
				</div>
			</section>

			<section class="details-strip">
				<div class="detail-cell"><span class="detail-label" data-i18n="profile.label_fullname">Full name</span><strong id="detailName">—</strong></div>
				<div class="detail-cell"><span class="detail-label" data-i18n="profile.label_username">Username</span><strong id="detailUsername">—</strong></div>
				<div class="detail-cell"><span class="detail-label" data-i18n="profile.label_website">Website</span><strong id="detailWebsite">—</strong></div>
				<div class="detail-cell"><span class="detail-label" data-i18n="profile.label_email">Email</span><strong id="detailEmail">—</strong></div>
			</section>

			<section id="editPanel" class="glass-section">
				<div class="section-label" id="formLabel" data-i18n="profile.section_edit">Edit profile</div>
				<form id="profileForm" class="edit-form">
					<div class="form-grid">
						<label class="field"><span data-i18n="profile.form_fullname">Full name</span><input id="inputName" type="text" placeholder="Your full name" data-i18n-placeholder="profile.ph_fullname" /></label>
						<label class="field"><span data-i18n="profile.form_username">Username</span><input id="inputUsername" type="text" placeholder="username" data-i18n-placeholder="profile.ph_username" /></label>
						<label class="field"><span data-i18n="profile.form_email">Email</span><input id="inputEmail" type="email" disabled /></label>
						<label class="field"><span data-i18n="profile.form_website">Website</span><input id="inputWebsite" type="url" placeholder="https://..." data-i18n-placeholder="profile.ph_website" /></label>
						<label class="field"><span data-i18n="profile.form_location">Location</span><input id="inputLocation" type="text" placeholder="City, Country" data-i18n-placeholder="profile.ph_location" /></label>
						<label class="field field--full"><span data-i18n="profile.form_bio">Bio</span><textarea id="inputBio" rows="4" placeholder="Tell us about yourself..." data-i18n-placeholder="profile.ph_bio"></textarea></label>
					</div>
					<div class="form-footer">
						<button type="submit" class="btn" id="saveBtn" data-i18n="profile.btn_save">Save changes</button>
						<button type="button" class="btn btn--ghost" id="resetBtn" data-i18n="profile.btn_reset">Reset</button>
						<p class="form-status" id="saveStatus"></p>
					</div>
				</form>
			</section>

			<section class="token-section glass-section">
				<div class="section-label" data-i18n="profile.section_tokens">Token Balance</div>
				<div class="token-overview">
					<div class="token-balance-display">
						<span class="token-balance-number" id="tokenBalance">—</span>
						<span class="token-balance-label" data-i18n="profile.tokens_available">tokens available</span>
					</div>
					<a href="/pricing/#tokens" class="btn btn--sm" id="buyTokensBtn" data-i18n="profile.btn_tokens">Get more tokens</a>
				</div>
				<div id="tokenHistory" class="token-history">
					<p class="text-muted" style="font-size:.85rem;" data-i18n="profile.loading_history">Loading history...</p>
				</div>
			</section>

			<!-- ═══ SUBSCRIPTIONS (multi-product) ═══ -->
			<section class="glass-section" id="subscriptionsSection">
				<div class="section-label">Your Subscriptions</div>
				<div class="subs-grid" id="subsGrid">
					<div class="sub-card">
						<div class="sub-card__icon">&#9881;</div>
						<div class="sub-card__label">VOLYNX Builder</div>
						<div class="sub-card__plan" id="subBuilderPlan">Free</div>
						<a href={ROUTES.pricing} class="sub-card__link" id="subBuilderCta">Upgrade</a>
					</div>
					<div class="sub-card">
						<div class="sub-card__icon">&#9728;</div>
						<div class="sub-card__label">VOLYNX Daily</div>
						<div class="sub-card__plan" id="subDailyPlan">Free</div>
						<a href="https://daily.volynx.world/pricing/" class="sub-card__link" id="subDailyCta">Upgrade</a>
					</div>
					<div class="sub-card">
						<div class="sub-card__icon">&#127912;</div>
						<div class="sub-card__label">Tokens</div>
						<div class="sub-card__plan" id="subTokens">0</div>
						<a href="/pricing/#tokens" class="sub-card__link">Buy tokens</a>
					</div>
				</div>
			</section>

			<!-- ═══ QUICK ACCESS ═══ -->
			<section class="glass-section">
				<div class="section-label">Quick Access</div>
				<div class="quick-grid">
					<a href={ROUTES.builder} class="quick-card">
						<span class="quick-card__icon">&#128187;</span>
						<span class="quick-card__title">Builder</span>
						<span class="quick-card__desc text-muted">Create & publish sites</span>
					</a>
					<a href={ROUTES.studio} class="quick-card">
						<span class="quick-card__icon">&#127912;</span>
						<span class="quick-card__title">Studio Pro</span>
						<span class="quick-card__desc text-muted">Image tools & exports</span>
					</a>
					<a href={ROUTES.iconsStore} class="quick-card">
						<span class="quick-card__icon">&#11088;</span>
						<span class="quick-card__title">Icons Store</span>
						<span class="quick-card__desc text-muted">1,160+ premium icons</span>
					</a>
					<a href="https://daily.volynx.world/tools/my-day/" class="quick-card">
						<span class="quick-card__icon">&#9728;</span>
						<span class="quick-card__title">Daily OS</span>
						<span class="quick-card__desc text-muted">Your daily dashboard</span>
					</a>
				</div>
			</section>

			<section class="bottom-grid">
				<div class="glass-section glass-section--compact">
					<div class="section-label" data-i18n="profile.section_activity">Activity</div>
					<div class="timeline-row"><div class="dot"></div><div><strong data-i18n="profile.activity_created">Account created</strong><br/><span id="activityJoined" class="text-muted">—</span></div></div>
				</div>
				<div class="glass-section glass-section--compact">
					<div class="section-label" data-i18n="profile.section_security">Security</div>
					<div class="info-row"><span data-i18n="profile.security_password">Password</span><strong data-i18n="profile.security_set">Set</strong></div>
					<div class="info-row" style="margin-top:8px;">
						<button type="button" class="btn btn--sm" id="changePasswordBtn">Change password</button>
					</div>
					<div id="passwordForm" hidden style="margin-top:12px;">
						<div style="display:grid;gap:8px;">
							<input id="newPassword" type="password" placeholder="New password (min 6 chars)" minlength="6" class="field-input" style="padding:10px 14px;border-radius:12px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.04);color:#fff;font-size:.9rem;" />
							<input id="confirmPassword" type="password" placeholder="Confirm new password" class="field-input" style="padding:10px 14px;border-radius:12px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.04);color:#fff;font-size:.9rem;" />
							<div style="display:flex;gap:8px;align-items:center;">
								<button type="button" class="btn btn--sm" id="savePasswordBtn">Save password</button>
								<button type="button" class="btn btn--sm btn--ghost" id="cancelPasswordBtn">Cancel</button>
								<span id="passwordMsg" style="font-size:.8rem;"></span>
							</div>
						</div>
					</div>
					<div class="info-row" style="margin-top:8px;"><span data-i18n="profile.security_2fa">2FA</span><strong data-i18n="profile.security_not_enabled">Not enabled</strong></div>
				</div>
			</section>
		</div>

		<!--
			SCRIPT 1 (is:inline): Logout + failsafe.
			Zero imports. Zero CDN. Always runs.
		-->
		<script is:inline>
		(function() {
			var KEYS = ["volynx_access_token","volynx_refresh_token","volynx_user_email","volynx_session","volynx_post_login_next"];

			/* Fallback sign out — only fires if main script hasn't overridden onclick */
			var btn = document.getElementById("logoutBtn");
			if (btn) {
				btn.addEventListener("click", function() {
					if (btn._mainHandlerAttached) return; /* main script owns it */
					KEYS.forEach(function(k) { localStorage.removeItem(k); });
					console.log("[profile] fallback logout: cleared storage");
					window.location.href = "/";
				});
			}

			/* Failsafe timeout */
			setTimeout(function() {
				var el = document.getElementById("viewLoading");
				if (el && el.classList.contains("view--active")) {
					console.error("[profile] FAILSAFE: 12s timeout — module never completed");
					el.classList.remove("view--active");
					document.getElementById("viewError").classList.add("view--active");
					document.getElementById("errorMsg").textContent =
						"Profile took too long to load. Please refresh the page.";
				}
			}, 12000);
		})();
		</script>

		<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
		<script is:inline>
			console.log("[profile] main script loaded, supabase global:", typeof supabase);
			if (typeof supabase === "undefined") {
				console.error("[profile] FATAL: supabase UMD not loaded");
				document.getElementById("viewLoading").classList.remove("view--active");
				document.getElementById("viewError").classList.add("view--active");
				document.getElementById("errorMsg").textContent = "Failed to load dependencies. Please refresh.";
			} else {
			var createClient = supabase.createClient;

			(async function main() {
				const t0 = performance.now();
				const log = (msg) => console.log(`[profile] ${msg} (${Math.round(performance.now() - t0)}ms)`);

				log("script start");

				// ── Helpers ──────────────────────────────────────────
				const $ = (id) => document.getElementById(id);

				const KEYS = ["volynx_access_token","volynx_refresh_token","volynx_user_email","volynx_session","volynx_post_login_next"];

				function clearSession() {
					KEYS.forEach(k => localStorage.removeItem(k));
					// Also clear plan cache and usage data
					if (window.VxPlan) {
						window.VxPlan.clearCache();
						window.VxPlan.clearAllUsage();
					}
				}

				function showView(name) {
					["viewLoading","viewError","viewProfile"].forEach(id => {
						var el = document.getElementById(id);
						el.classList.remove("view--active");
						el.style.display = "none";
					});
					var target = document.getElementById("view" + name.charAt(0).toUpperCase() + name.slice(1));
					target.classList.add("view--active");
					target.style.display = "";
					log("state → " + name);
				}

				function showError(msg) {
					$("errorMsg").textContent = msg;
					showView("error");
				}

				function goLogin() {
					clearSession();
					log("redirecting to login");
					window.location.href = "/login/?next=/profile/";
				}

				function initials(name, email) {
					if (name?.trim()) {
						const p = name.trim().split(/\s+/);
						return (p[0][0] + (p[1]?.[0] || "")).toUpperCase();
					}
					return email ? email.slice(0, 2).toUpperCase() : "??";
				}

				function nullIfEmpty(v) {
					const s = (v || "").trim();
					return s.length > 0 ? s : null;
				}

				const USERNAME_RE = /^[a-z0-9][a-z0-9_]*[a-z0-9]$/;
				function validateUsername(raw) {
					if (!raw?.trim()) return null;
					const v = raw.trim().toLowerCase().replace(/^@/, "");
					if (v.length < 3 || v.length > 30) return { error: "Username must be 3-30 characters." };
					if (!USERNAME_RE.test(v)) return { error: "Only lowercase letters, numbers, and underscores." };
					return { value: v };
				}

				// ══════════════════════════════════════════════════════
				// PHASE 1: Auth + Profile (blocking)
				// ══════════════════════════════════════════════════════
				let supabase;
				let user;
				let profile;
				let cfg;
				let accessToken;

				try {
					log("reading tokens");
					accessToken = localStorage.getItem("volynx_access_token") || "";
					const refreshToken = localStorage.getItem("volynx_refresh_token") || "";
					log("tokens: access=" + (accessToken ? "yes" : "NO") + " refresh=" + (refreshToken ? "yes" : "NO"));
					if (!accessToken) { goLogin(); return; }

					log("fetching config.json");
					const cfgRes = await fetch("/config.json", { cache: "no-store" });
					if (!cfgRes.ok) { showError("Configuration error. Please refresh."); return; }
					cfg = await cfgRes.json();
					log("config loaded: url=" + (cfg.supabaseUrl ? "set" : "MISSING"));

					log("creating supabase client");
					supabase = createClient(cfg.supabaseUrl, cfg.supabaseAnonKey);
					log("client created");

					log("setSession start");
					const { error: sessErr } = await supabase.auth.setSession({
						access_token: accessToken,
						refresh_token: refreshToken,
					});
					if (sessErr) {
						log("setSession FAILED: " + sessErr.message);
						goLogin();
						return;
					}
					log("setSession ok");

					log("getUser start");
					const { data: authData, error: authErr } = await supabase.auth.getUser();
					if (authErr || !authData?.user) {
						log("getUser FAILED: " + (authErr?.message || "no user"));
						goLogin();
						return;
					}
					user = authData.user;
					log("getUser ok: " + user.id);

					log("profile query start");
					const { data: profData, error: profErr } = await supabase
						.from("profiles")
						.select("*")
						.eq("id", user.id)
						.single();

					if (profErr) {
						log("profile query FAILED: " + profErr.message + " code=" + profErr.code);

						// Profile row missing — create it automatically for new users
						if (profErr.code === "PGRST116") {
							log("profile not found — creating for new user");
							const meta = user.user_metadata || {};
							const newProfile = {
								id: user.id,
								email: user.email || "",
								full_name: meta.full_name || null,
								username: meta.username || null,
								plan: "free",
								builder_plan: "free",
								token_balance: 0,
							};
							const { data: created, error: createErr } = await supabase
								.from("profiles")
								.upsert(newProfile, { onConflict: "id" })
								.select("*")
								.single();

							if (createErr) {
								log("profile create FAILED: " + createErr.message);
								showError("Could not initialize your profile. Please try again or contact support.");
								return;
							}
							profile = created;
							log("profile created for new user");
						} else {
							showError("Failed to load profile: " + profErr.message);
							return;
						}
					} else {
						profile = profData;
						log("profile loaded");
					}

				} catch (err) {
					console.error("[profile] unexpected error:", err);
					showError("Something went wrong. Please refresh the page.");
					return;
				}

				// ══════════════════════════════════════════════════════
				// PHASE 2: Render (synchronous — zero awaits)
				// ══════════════════════════════════════════════════════
				log("render start");

				const email     = user.email || "";
				const fullName  = profile.full_name  || "";
				const username  = profile.username   || "";
				const bio       = profile.bio        || "";
				const website   = profile.website    || "";
				const loc       = profile.location   || "";
				const avatarUrl = profile.avatar_url || "";
				const createdAt = user.created_at ? new Date(user.created_at) : null;
				const joinedFmt = createdAt ? createdAt.toLocaleDateString("en-US", { month: "short", year: "numeric" }) : "—";
				const isFirstTime = !fullName && !username && !bio;

				$("profileName").textContent   = fullName || (isFirstTime ? "New Member" : "Unnamed User");
				$("profileHandle").textContent = username ? "@" + username : "";
				$("heroBio").textContent       = bio;
				$("heroEmail").textContent     = email;
				$("heroLocation").textContent  = loc || "—";
				$("heroJoined").textContent    = "Joined " + joinedFmt;

				const avatarPreview  = $("avatarPreview");
				const avatarFallback = $("avatarFallback");
				if (avatarUrl) {
					avatarPreview.src = avatarUrl;
					avatarPreview.style.display = "block";
					avatarFallback.style.display = "none";
				} else {
					avatarPreview.style.display = "none";
					avatarFallback.style.display = "grid";
					avatarFallback.textContent = initials(fullName, email);
				}

				$("detailName").textContent     = fullName || "Not set";
				$("detailUsername").textContent  = username ? "@" + username : "Not set";
				$("detailWebsite").textContent   = website || "Not set";
				$("detailEmail").textContent     = email;
				$("activityJoined").textContent = createdAt
					? createdAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
					: "—";

				($("inputName")).value     = fullName;
				($("inputUsername")).value  = username;
				($("inputEmail")).value    = email;
				($("inputWebsite")).value  = website;
				($("inputLocation")).value = loc;
				($("inputBio")).value   = bio;

				const saved = { name: fullName, username, website, location: loc, bio };

				if (isFirstTime) {
					$("firstTimeBanner").style.display = "";
					$("formLabel").textContent = "Complete your profile";
				}

				const params = new URLSearchParams(window.location.search);
				if (params.get("payment") === "success") {
					$("paymentSuccessBanner").style.display = "";
					if (window.VxPlan) window.VxPlan.clearCache();
					history.replaceState({}, "", "/profile/");
				} else if (params.get("welcome") === "1" && !isFirstTime) {
					$("welcomeBanner").style.display = "";
					history.replaceState({}, "", "/profile/");
				}

				showView("profile");
				log("render complete");

				// ══════════════════════════════════════════════════════
				// PHASE 3: Plan (non-blocking, from billing backend)
				// ══════════════════════════════════════════════════════
				const planBadge = $("heroPlan");
				const planCta = $("planCta");
				const planHelper = $("planHelper");

				function renderPlan(name, paid, helperText) {
					var n = name.toLowerCase();
					planBadge.textContent = name.charAt(0).toUpperCase() + name.slice(1);
					// Remove old tier classes
					planBadge.classList.remove("plan-badge--paid","plan-badge--launch","plan-badge--pro","plan-badge--studio","plan-badge--teams");
					if (paid) {
						// Apply tier-specific class, fallback to generic --paid
						var tierClass = "plan-badge--" + n;
						if (["launch","pro","studio","teams"].includes(n)) {
							planBadge.classList.add(tierClass);
						} else {
							planBadge.classList.add("plan-badge--paid");
						}
						planCta.textContent = "Manage plan";
					} else {
						planCta.textContent = "Upgrade plan";
					}
					planCta.href = "/pricing/";
					if (planHelper) {
						planHelper.textContent = helperText || "";
						planHelper.style.display = helperText ? "" : "none";
					}
				}

				// Read plan from profile row (Supabase source of truth)
				// Use the higher of plan vs builder_plan
				const _planRank = { free: 0, launch: 1, pro: 2, studio: 3, teams: 4, enterprise: 5 };
				const _allPlans = [profile?.plan, profile?.builder_plan, profile?.daily_plan, profile?.cvitae_plan]
					.map(p => (p || "free").toLowerCase().trim());
				const dbPlan = _allPlans.reduce((best, p) => (_planRank[p] || 0) > (_planRank[best] || 0) ? p : best, "free");
				const dbPaid = dbPlan && dbPlan !== "free";
				renderPlan(dbPaid ? dbPlan : "Free", dbPaid);
				log("plan from DB: " + dbPlan);
				if (window.VxPlan) window.VxPlan.cache(dbPlan);

				// Also try billing backend for most up-to-date info
				const apiBase = ((cfg).functionsUrl || (cfg).apiBaseUrl || "").replace(/\/$/, "");
				if (apiBase) {
					(async () => {
						try {
							const ctrl = new AbortController();
							const t = setTimeout(() => ctrl.abort(), 8000);
							const res = await fetch(`${apiBase}/check-permission`, {
								method: "POST",
								headers: { "Content-Type": "application/json", Authorization: `Bearer ${accessToken}` },
								body: JSON.stringify({ tool: "profile" }),
								signal: ctrl.signal,
							});
							clearTimeout(t);
							if (res.ok) {
								const d = await res.json();
								const _apiPlans = [d.plan, d.builder_plan, d.daily_plan, d.cvitae_plan]
									.map(pp => (pp || "free").toLowerCase().trim());
								const p = _apiPlans.reduce((best, pp) => (_planRank[pp] || 0) > (_planRank[best] || 0) ? pp : best, "free");
								const paid = p && p !== "free";
								renderPlan(paid ? p : "Free", paid);
								if (window.VxPlan) window.VxPlan.cache(p);
								log("plan from API: " + p);
							}
						} catch (_) {
							log("plan API unavailable, using DB: " + dbPlan);
						}
					})();
				} else {
					log("plan: Free (no billing backend)");
				}

				// ══════════════════════════════════════════════════════
				// PHASE 3a: Multi-product subscription cards
				// ══════════════════════════════════════════════════════
				const builderTier = (profile?.builder_plan || "free").toLowerCase().trim();
				const dailyTier = (profile?.daily_plan || "free").toLowerCase().trim();

				const subBuilderEl = $("subBuilderPlan");
				const subDailyEl = $("subDailyPlan");
				const subTokensEl = $("subTokens");
				const subBuilderCta = $("subBuilderCta");
				const subDailyCta = $("subDailyCta");

				if (subBuilderEl) {
					subBuilderEl.textContent = builderTier.charAt(0).toUpperCase() + builderTier.slice(1);
					subBuilderEl.setAttribute("data-tier", builderTier);
					if (builderTier !== "free" && subBuilderCta) {
						subBuilderCta.textContent = "Manage";
						subBuilderCta.href = "/pricing/";
					}
				}
				if (subDailyEl) {
					subDailyEl.textContent = dailyTier.charAt(0).toUpperCase() + dailyTier.slice(1);
					subDailyEl.setAttribute("data-tier", dailyTier);
					if (dailyTier !== "free" && subDailyCta) {
						subDailyCta.textContent = "Manage";
					}
				}
				if (subTokensEl) {
					subTokensEl.textContent = String(profile?.token_balance || 0);
				}

				// ══════════════════════════════════════════════════════
				// PHASE 3a2: Change password
				// ══════════════════════════════════════════════════════
				const cpBtn = $("changePasswordBtn");
				const cpForm = $("passwordForm");
				const cpSave = $("savePasswordBtn");
				const cpCancel = $("cancelPasswordBtn");
				const cpMsg = $("passwordMsg");
				const cpNew = $("newPassword");
				const cpConfirm = $("confirmPassword");

				if (cpBtn && cpForm) {
					cpBtn.addEventListener("click", () => { cpForm.hidden = false; cpBtn.style.display = "none"; });
					cpCancel.addEventListener("click", () => { cpForm.hidden = true; cpBtn.style.display = ""; cpMsg.textContent = ""; });
					cpSave.addEventListener("click", async () => {
						const pw = cpNew.value;
						const pw2 = cpConfirm.value;
						if (!pw || pw.length < 6) { cpMsg.textContent = "Min 6 characters"; cpMsg.style.color = "#ef4444"; return; }
						if (pw !== pw2) { cpMsg.textContent = "Passwords don't match"; cpMsg.style.color = "#ef4444"; return; }
						cpSave.disabled = true;
						cpMsg.textContent = "Saving..."; cpMsg.style.color = "var(--muted)";
						try {
							const res = await fetch(cfg.supabaseUrl + "/auth/v1/user", {
								method: "PUT",
								headers: { apikey: cfg.supabaseAnonKey, Authorization: "Bearer " + accessToken, "Content-Type": "application/json" },
								body: JSON.stringify({ password: pw }),
							});
							if (res.ok) {
								cpMsg.textContent = "Password updated!"; cpMsg.style.color = "#22c55e";
								cpNew.value = ""; cpConfirm.value = "";
								setTimeout(() => { cpForm.hidden = true; cpBtn.style.display = ""; cpMsg.textContent = ""; }, 2000);
							} else {
								const err = await res.json().catch(() => ({}));
								cpMsg.textContent = err.msg || err.error_description || "Failed to update"; cpMsg.style.color = "#ef4444";
							}
						} catch(e) { cpMsg.textContent = "Connection error"; cpMsg.style.color = "#ef4444"; }
						finally { cpSave.disabled = false; }
					});
				}

				// ══════════════════════════════════════════════════════
				// PHASE 3b: Token balance (non-blocking)
				// ══════════════════════════════════════════════════════
				const tokenBalanceEl = $("tokenBalance");
				const tokenHistoryEl = $("tokenHistory");

				// Show balance from profile (instant)
				const initialBalance = profile.token_balance || 0;
				tokenBalanceEl.textContent = String(initialBalance);

				// Fetch recent transactions
				if (apiBase) {
					(async () => {
						try {
							const ctrl = new AbortController();
							const t = setTimeout(() => ctrl.abort(), 8000);
							const res = await fetch(`${apiBase}/get-balance`, {
								method: "POST",
								headers: { "Content-Type": "application/json", Authorization: `Bearer ${accessToken}` },
								body: JSON.stringify({}),
								signal: ctrl.signal,
							});
							clearTimeout(t);
							if (res.ok) {
								const d = await res.json();
								tokenBalanceEl.textContent = String(d.balance || 0);
								const recent = d.recent || [];
								if (recent.length === 0) {
									tokenHistoryEl.innerHTML = '<p class="text-muted" style="font-size:.85rem;">No token activity yet.</p>';
								} else {
									tokenHistoryEl.innerHTML = recent.slice(0, 8).map((tx) => {
										const isSpend = tx.amount < 0;
										const sign = isSpend ? "" : "+";
										const color = isSpend ? "var(--danger)" : "var(--success)";
										const date = new Date(tx.created_at).toLocaleDateString("en-US", { month: "short", day: "numeric" });
										const desc = tx.description || tx.tool_name || tx.type;
										return `<div class="token-tx"><span class="token-tx-desc">${desc}</span><span class="token-tx-amount" style="color:${color}">${sign}${tx.amount}</span><span class="token-tx-date">${date}</span></div>`;
									}).join("");
								}
								log("tokens: " + d.balance);
							} else {
								tokenHistoryEl.innerHTML = '<p class="text-muted" style="font-size:.85rem;">Could not load history.</p>';
							}
						} catch (_) {
							tokenHistoryEl.innerHTML = '<p class="text-muted" style="font-size:.85rem;">Could not load history.</p>';
						}
					})();
				}

				// ══════════════════════════════════════════════════════
				// PHASE 4: Event listeners
				// ══════════════════════════════════════════════════════

				const logoutEl = $("logoutBtn");
				logoutEl._mainHandlerAttached = true;
				logoutEl.onclick = async () => {
					try { await supabase.auth.signOut(); } catch (_) {}
					clearSession();
					log("signOut complete");
					window.location.href = "/";
				};

				$("editProfileBtn")?.addEventListener("click", () => {
					$("welcomeBanner").style.display = "none";
					$("editPanel")?.scrollIntoView({ behavior: "smooth", block: "start" });
				});

				$("continueBtn")?.addEventListener("click", () => {
					const next = localStorage.getItem("volynx_post_login_next") || "/volynx-lab/studio/";
					localStorage.removeItem("volynx_post_login_next");
					if (next.startsWith("/") && !next.startsWith("//")) {
						window.location.href = next;
					} else {
						window.location.href = "/volynx-lab/studio/";
					}
				});

				$("scrollToEdit")?.addEventListener("click", () => {
					$("editPanel")?.scrollIntoView({ behavior: "smooth", block: "start" });
				});

				// Avatar panel toggle — click on avatar frame to open
				const avatarPanel = $("avatarPanel");
				$("avatarFrameBtn")?.addEventListener("click", () => {
					avatarPanel.hidden = !avatarPanel.hidden;
				});
				$("avatarFrameBtn")?.addEventListener("keydown", (e) => {
					if (e.key === "Enter" || e.key === " ") { e.preventDefault(); avatarPanel.hidden = !avatarPanel.hidden; }
				});
				$("avatarPanelClose")?.addEventListener("click", () => { avatarPanel.hidden = true; });

				// Pro avatars
				const FREE_AVATARS = ["/assets/avatarfree/1.png", "/assets/avatarfree/2.png", "/assets/avatarfree/avatarfree3.webp"];
				const PRO_AVATARS = ["/assets/avatarpro/avatargoldpro.webp"];
				const DEFAULT_PRO_AVATAR = PRO_AVATARS[0];
				const userPlan = (profile?.plan || "free").trim().toLowerCase();
			const isPro = window.VxPlan ? window.VxPlan.isPaid(userPlan) : (userPlan !== "free");

				// Show pro avatars section if user is pro
				if (isPro && PRO_AVATARS.length > 0) {
					const proSection = $("proAvatarSection");
					const proGrid = $("proAvatarGrid");
					if (proSection && proGrid) {
						proSection.hidden = false;
						proGrid.innerHTML = PRO_AVATARS.map((src, i) =>
							`<button type="button" class="avatar-option" data-avatar="${src}"><img src="${src}" alt="Pro Avatar ${i+1}" /></button>`
						).join("");
					}
				}

				// Auto-upgrade avatar: if user is pro but still has a free avatar, switch to pro
				const currentAvatarUrl = profile.avatar_url || "";
				const hasDefaultOrFreeAvatar = !currentAvatarUrl || currentAvatarUrl === "/assets/avatar.webp" || FREE_AVATARS.includes(currentAvatarUrl);
				if (isPro && hasDefaultOrFreeAvatar && DEFAULT_PRO_AVATAR) {
					avatarPreview.src = DEFAULT_PRO_AVATAR;
					avatarPreview.style.display = "block";
					avatarFallback.style.display = "none";
					await supabase.from("profiles").update({ avatar_url: DEFAULT_PRO_AVATAR }).eq("id", user.id);
					log("auto-upgraded avatar to pro: " + DEFAULT_PRO_AVATAR);
				}

				// Avatar option click (free + pro) — bind AFTER pro avatars are injected
				function bindAvatarOptions() {
					document.querySelectorAll(".avatar-option[data-avatar]").forEach(btn => {
						btn.addEventListener("click", () => {
							const url = (btn).dataset.avatar;
							avatarPreview.src = url;
							avatarPreview.style.display = "block";
							avatarFallback.style.display = "none";
							avatarPanel.hidden = true;
							(avatarPreview)._selectedFreeAvatar = url;
							(avatarPreview)._pendingFile = null;
							document.querySelectorAll(".avatar-option").forEach(o => o.classList.remove("avatar-option--selected"));
							btn.classList.add("avatar-option--selected");
						});
					});
				}
				bindAvatarOptions();

				// Custom file upload
				$("avatarInput")?.addEventListener("change", (e) => {
					const file = (e.target).files?.[0];
					if (!file) return;
					if (file.size > 2 * 1024 * 1024) { alert("Max 2MB."); return; }
					avatarPreview.src = URL.createObjectURL(file);
					avatarPreview.style.display = "block";
					avatarFallback.style.display = "none";
					avatarPanel.hidden = true;
					(avatarPreview)._selectedFreeAvatar = null;
					(avatarPreview)._pendingFile = file;
				});

				function applyToUI(d) {
					$("profileName").textContent   = d.full_name || "Unnamed User";
					$("profileHandle").textContent = d.username ? "@" + d.username : "";
					$("heroBio").textContent       = d.bio || "";
					$("heroLocation").textContent  = d.location || "—";
					$("detailName").textContent     = d.full_name || "Not set";
					$("detailUsername").textContent = d.username ? "@" + d.username : "Not set";
					$("detailWebsite").textContent  = d.website || "Not set";
					avatarFallback.textContent       = initials(d.full_name || "", email);
					$("firstTimeBanner").style.display = "none";
				}

				$("profileForm")?.addEventListener("submit", async (e) => {
					e.preventDefault();
					const saveBtn = $("saveBtn");
					const status  = $("saveStatus");

					const usernameResult = validateUsername(($("inputUsername")).value);
					if (usernameResult && "error" in usernameResult) {
						status.textContent = usernameResult.error;
						status.style.color = "var(--danger)";
						return;
					}

					saveBtn.disabled   = true;
					status.textContent = "Saving...";
					status.style.color = "";

					const selectedAvatar = (avatarPreview)._selectedFreeAvatar || null;
					const pendingFile = (avatarPreview)._pendingFile || null;
					const updates = {
						full_name: nullIfEmpty(($("inputName")).value),
						username:  usernameResult?.value ?? null,
						website:   nullIfEmpty(($("inputWebsite")).value),
						location:  nullIfEmpty(($("inputLocation")).value),
						bio:       nullIfEmpty(($("inputBio")).value),
					};

					// Avatar: free preset OR custom upload
					if (selectedAvatar) {
						updates.avatar_url = selectedAvatar;
					} else if (pendingFile) {
						status.textContent = "Uploading avatar...";
						const ext = pendingFile.name.split(".").pop()?.toLowerCase() || "png";
						const path = `${user.id}/avatar.${ext}`;
						const { error: uploadErr } = await supabase.storage
							.from("avatars")
							.upload(path, pendingFile, { upsert: true, contentType: pendingFile.type });
						if (uploadErr) {
							status.textContent = "Avatar upload failed: " + uploadErr.message;
							status.style.color = "var(--danger)";
							log("avatar upload failed: " + uploadErr.message);
							saveBtn.disabled = false;
							return;
						}
						const { data: urlData } = supabase.storage.from("avatars").getPublicUrl(path);
						updates.avatar_url = urlData?.publicUrl || "";
						(avatarPreview)._pendingFile = null;
						log("avatar uploaded: " + updates.avatar_url);
					}

					const { error } = await supabase.from("profiles").update(updates).eq("id", user.id);

					if (error) {
						status.textContent = error.message.includes("username_unique")
							? "This username is already taken."
							: "Error: " + error.message;
						status.style.color = "var(--danger)";
						log("save FAILED: " + error.message);
					} else {
						status.textContent = "Profile saved.";
						status.style.color = "var(--success)";
						applyToUI(updates);
						Object.assign(saved, {
							name: updates.full_name || "",
							username: updates.username || "",
							website: updates.website || "",
							location: updates.location || "",
							bio: updates.bio || "",
						});
						log("save ok");
					}
					saveBtn.disabled = false;
				});

				$("resetBtn")?.addEventListener("click", () => {
					($("inputName")).value     = saved.name;
					($("inputUsername")).value  = saved.username;
					($("inputWebsite")).value  = saved.website;
					($("inputLocation")).value = saved.location;
					($("inputBio")).value   = saved.bio;
					$("saveStatus").textContent = "Form reset.";
					$("saveStatus").style.color = "";
				});
			})();
			} // end supabase check
		</script>

		<PageWidgets hideUtilBar />
	</body>
</html>

<style>
	:root {
		--text: #f2f4f8;
		--muted: rgba(242,244,248,.55);
		--accent: #00e8c5;
		--accent-dim: rgba(0,232,197,.12);
		--success: #8fe0b5;
		--danger: #ff7676;
		--glass: rgba(255,255,255,.03);
		--glass-border: rgba(255,255,255,.06);
		--w: min(calc(100% - 40px), 1100px);
	}
	*,*::before,*::after { box-sizing: border-box; }
	html { scroll-behavior: smooth; background: #050609; }
	body { margin: 0; font-family: Inter, ui-sans-serif, system-ui, sans-serif;
		color: var(--text); line-height: 1.55; -webkit-font-smoothing: antialiased;
		position: relative; }
	body::after {
		content: "";
		position: fixed; inset: 0;
		width: 100%; height: 100%;
		background: url("/assets/vynxbig.webp") center center / cover no-repeat;
		opacity: .08;
		pointer-events: none;
		z-index: 1;
	}
	a { color: inherit; text-decoration: none; }
	button, input, textarea { font: inherit; }
	button { cursor: pointer; }
	h1,h2,h3,p { margin-top: 0; }

	/* ═══ STATE SYSTEM ═══ */
	.view { display: none; }
	.view--active { display: flex; }

	#viewLoading, #viewError {
		flex-direction: column; align-items: center; justify-content: center;
		min-height: 50vh; gap: 16px; text-align: center;
		width: var(--w); margin: 0 auto; padding: 40px 20px;
		position: relative; z-index: 2;
	}
	#viewLoading p, #viewError p { color: var(--muted); font-size: .95rem; margin: 0; }
	.error-text { color: var(--danger) !important; }
	.spinner { width: 28px; height: 28px;
		border: 2px solid rgba(255,255,255,.08); border-top-color: var(--accent);
		border-radius: 999px; animation: spin .6s linear infinite; }
	@keyframes spin { to { transform: rotate(360deg); } }

	#viewProfile {
		flex-direction: column; gap: 40px;
		width: var(--w); margin: 0 auto; padding: 0 0 80px;
		position: relative; z-index: 2;
	}

	.orb { position: fixed; border-radius: 999px; pointer-events: none; z-index: 0; }
	.orb-a { width: 500px; height: 500px; top: -160px; right: -100px;
		background: radial-gradient(circle, rgba(120,0,255,.12), transparent 70%); filter: blur(80px); }
	.orb-b { width: 400px; height: 400px; bottom: 10%; left: -100px;
		background: radial-gradient(circle, rgba(0,232,197,.08), transparent 70%); filter: blur(70px); }

	.logout-btn { background: none; border: 1px solid rgba(255,120,120,.2); border-radius: 8px;
		color: rgba(255,180,180,.7); font-size: .82rem; font-weight: 600; padding: 5px 12px; }
	.logout-btn:hover { background: rgba(255,120,120,.08); border-color: rgba(255,120,120,.4); }

	.banner { padding: 20px 24px; border-radius: 16px; backdrop-filter: blur(12px); }
	.banner--welcome { background: linear-gradient(135deg, rgba(0,232,197,.06), rgba(120,0,255,.04));
		border: 1px solid rgba(0,232,197,.18); text-align: center; }
	.banner--welcome h2 { margin: 0 0 4px; font-size: 1.2rem; }
	.banner--welcome p { margin: 0; color: var(--muted); font-size: .9rem; }
	.banner--success { background: linear-gradient(135deg, rgba(0,232,120,.08), rgba(0,180,255,.04));
		border: 1px solid rgba(0,232,120,.25); }
	.banner--success .banner-row span { color: #00e878; font-weight: 600; }
	.banner--subtle { background: rgba(255,255,255,.02); border: 1px solid var(--glass-border); }
	.banner-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
	.banner-row span { font-size: .9rem; }
	.banner-actions { display: flex; gap: 8px; }

	.btn { display: inline-flex; align-items: center; justify-content: center;
		padding: 10px 22px; border-radius: 999px; font-size: .88rem; font-weight: 700;
		border: 1px solid rgba(0,232,197,.25);
		background: linear-gradient(135deg, rgba(0,232,197,.15), rgba(120,0,255,.1));
		color: var(--accent); text-decoration: none; transition: transform .15s, box-shadow .15s; }
	.btn:hover { transform: translateY(-2px); box-shadow: 0 0 20px rgba(0,232,197,.1); }
	.btn--ghost { background: rgba(255,255,255,.04); border-color: var(--glass-border); color: var(--text); }
	.btn--ghost:hover { background: rgba(255,255,255,.07); }
