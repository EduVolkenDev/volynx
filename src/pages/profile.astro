				</div>
			</section>
		</div>

		<!--
			SCRIPT 1 (is:inline): Logout + failsafe.
			Zero imports. Zero CDN. Always runs.
		-->
		<script is:inline src="/scripts/vx-lab-workspace.js?v=20260603-lab-workspace"></script>
		<script is:inline>
		(function() {
			var KEYS = ["volynx_access_token","volynx_refresh_token","volynx_user_email","volynx_session","volynx_post_login_next"];

			/* Fallback sign out — only fires if main script hasn't overridden onclick */
			var btn = document.getElementById("logoutBtn");
			if (btn) {
				btn.addEventListener("click", function() {
					if (btn._mainHandlerAttached) return; /* main script owns it */
					KEYS.forEach(function(k) { localStorage.removeItem(k); });
					if (window.VxAuthBridge) window.VxAuthBridge.clear();
					window.location.href = "/";
				});
			}

			/* Failsafe timeout */
			setTimeout(function() {
				var el = document.getElementById("viewLoading");
				if (el && el.classList.contains("view--active")) {
					console.error("[profile] FAILSAFE: 12s timeout — module never completed");
					el.classList.remove("view--active");
					document.getElementById("viewError").classList.add("view--active");
					document.getElementById("errorMsg").textContent =
						"Profile took too long to load. Please refresh the page.";
				}
			}, 12000);
		})();
		</script>

		<script is:inline src="/vendor/supabase.js"></script>
		<script is:inline src="/vendor/jszip.min.js"></script>
		<script is:inline>
			if (typeof supabase === "undefined") {
				console.error("[profile] FATAL: supabase UMD not loaded");
				document.getElementById("viewLoading").classList.remove("view--active");
				document.getElementById("viewError").classList.add("view--active");
				document.getElementById("errorMsg").textContent = "Failed to load dependencies. Please refresh.";
			} else {
			var createClient = supabase.createClient;

			(async function main() {
				const t0 = performance.now();
				const DEBUG = (() => { try { return new URLSearchParams(location.search).has("debug"); } catch (_) { return false; } })();
				const log = DEBUG
					? (msg) => console.log(`[profile] ${msg} (${Math.round(performance.now() - t0)}ms)`)
					: () => {};

				log("script start");

				// ── Helpers ──────────────────────────────────────────
				const $ = (id) => document.getElementById(id);

				const KEYS = ["volynx_access_token","volynx_refresh_token","volynx_user_email","volynx_session","volynx_post_login_next"];

				function clearSession() {
					KEYS.forEach(k => localStorage.removeItem(k));
					if (window.VxAuthBridge) window.VxAuthBridge.clear();
					// Also clear plan cache and usage data
					if (window.VxPlan) {
						window.VxPlan.clearCache();
						window.VxPlan.clearAllUsage();
					}
				}

				function showView(name) {
					["viewLoading","viewError","viewProfile"].forEach(id => {
						var el = document.getElementById(id);
						el.classList.remove("view--active");
						el.style.display = "none";
					});
					var target = document.getElementById("view" + name.charAt(0).toUpperCase() + name.slice(1));
					target.classList.add("view--active");
					target.style.display = "";
					log("state → " + name);
				}

				function showError(msg) {
					$("errorMsg").textContent = msg;
					showView("error");
				}

				function goLogin() {
					clearSession();
					log("redirecting to login");
					window.location.href = "/login/?next=/profile/";
				}

				function initials(name, email) {
					if (name?.trim()) {
						const p = name.trim().split(/\s+/);
						return (p[0][0] + (p[1]?.[0] || "")).toUpperCase();
					}
					return email ? email.slice(0, 2).toUpperCase() : "ME";
				}

				function nullIfEmpty(v) {
					const s = (v || "").trim();
					return s.length > 0 ? s : null;
				}

				const USERNAME_RE = /^[a-z0-9][a-z0-9_]*[a-z0-9]$/;
				function validateUsername(raw) {
					if (!raw?.trim()) return null;
					const v = raw.trim().toLowerCase().replace(/^@/, "");
					if (v.length < 3 || v.length > 30) return { error: "Username must be 3-30 characters." };
					if (!USERNAME_RE.test(v)) return { error: "Only lowercase letters, numbers, and underscores." };
					return { value: v };
				}

				// ══════════════════════════════════════════════════════
				// PHASE 1: Auth + Profile (blocking)
				// ══════════════════════════════════════════════════════
				let supabase;
				let user;
				let profile;
				let cfg;
				let accessToken;

				try {
					log("reading tokens");
					accessToken = localStorage.getItem("volynx_access_token") || "";
					const refreshToken = localStorage.getItem("volynx_refresh_token") || "";
					log("tokens: access=" + (accessToken ? "yes" : "NO") + " refresh=" + (refreshToken ? "yes" : "NO"));
					if (!accessToken) { goLogin(); return; }

					log("fetching config.json");
					const cfgRes = await fetch("/config.json", { cache: "no-store" });
					if (!cfgRes.ok) { showError("Configuration error. Please refresh."); return; }
					cfg = await cfgRes.json();
					log("config loaded: url=" + (cfg.supabaseUrl ? "set" : "MISSING"));

					log("creating supabase client");
					supabase = createClient(cfg.supabaseUrl, cfg.supabaseAnonKey);
					log("client created");

					log("setSession start");
					const { error: sessErr } = await supabase.auth.setSession({
						access_token: accessToken,
						refresh_token: refreshToken,
					});
					if (sessErr) {
						log("setSession FAILED: " + sessErr.message);
						goLogin();
						return;
					}
					log("setSession ok");

					log("getUser start");
					const { data: authData, error: authErr } = await supabase.auth.getUser();
					if (authErr || !authData?.user) {
						log("getUser FAILED: " + (authErr?.message || "no user"));
						goLogin();
						return;
					}
					user = authData.user;
					log("getUser ok: " + user.id);

					log("profile query start");
					const { data: profData, error: profErr } = await supabase
						.from("profiles")
						.select("*")
						.eq("id", user.id)
						.single();

					if (profErr) {
						log("profile query FAILED: " + profErr.message + " code=" + profErr.code);

						// Profile row missing — create it automatically for new users
						if (profErr.code === "PGRST116") {
							log("profile not found — creating for new user");
							const meta = user.user_metadata || {};
							const newProfile = {
								id: user.id,
								email: user.email || "",
								full_name: meta.full_name || null,
								username: meta.username || null,
								plan: "free",
								builder_plan: "free",
								token_balance: 0,
							};
							const { data: created, error: createErr } = await supabase
								.from("profiles")
								.upsert(newProfile, { onConflict: "id" })
								.select("*")
								.single();

							if (createErr) {
								log("profile create FAILED: " + createErr.message);
								showError("Could not initialize your profile. Please try again or contact support.");
								return;
							}
							profile = created;
							log("profile created for new user");
						} else {
							showError("Failed to load profile: " + profErr.message);
							return;
						}
					} else {
						profile = profData;
						log("profile loaded");
					}

				} catch (err) {
					console.error("[profile] unexpected error:", err);
					showError("Something went wrong. Please refresh the page.");
					return;
				}

				// ══════════════════════════════════════════════════════
				// PHASE 2: Render (synchronous — zero awaits)
				// ══════════════════════════════════════════════════════
				log("render start");

				const email     = user.email || "";
				const fullName  = profile.full_name  || "";
				const username  = profile.username   || "";
				const bio       = profile.bio        || "";
				const website   = profile.website    || "";
				const loc       = profile.location   || "";
				const createdAt = user.created_at ? new Date(user.created_at) : null;
				const joinedFmt = createdAt ? createdAt.toLocaleDateString("en-US", { month: "short", year: "numeric" }) : "—";
				const isFirstTime = !fullName && !username && !bio;

				$("profileName").textContent   = fullName || (isFirstTime ? "New Member" : "Unnamed User");
				$("profileHandle").textContent = username ? "@" + username : "";
				$("heroBio").textContent       = bio;
				$("heroEmail").textContent     = email;
				$("heroLocation").textContent  = loc || "—";
				$("heroJoined").textContent    = "Joined " + joinedFmt;

				// Resolve avatar via catalog (PT-2c). Falls back to legacy avatar_url, then initials.
				const avatarPreview  = $("avatarPreview");
				const avatarFallback = $("avatarFallback");
				const avatarCatalog = (window).VX_AVATAR_CATALOG || [];
				const avatarMeta = profile.avatar_id
					? avatarCatalog.find(a => a.id === profile.avatar_id)
					: null;
				const resolvedAvatarSrc = avatarMeta?.src || profile.avatar_url || "";
				if (resolvedAvatarSrc) {
					avatarPreview.src = resolvedAvatarSrc;
					avatarPreview.style.display = "block";
					avatarFallback.style.display = "none";
					// Cache for cross-page resolver (PT-2d)
					try {
						localStorage.setItem("volynx_avatar_cache", JSON.stringify({
							id: profile.avatar_id || null,
							src: resolvedAvatarSrc,
							ts: Date.now(),
						}));
					} catch (_) {}
				} else {
					avatarPreview.style.display = "none";
					avatarFallback.style.display = "grid";
					avatarFallback.textContent = initials(fullName, email);
				}

				$("detailName").textContent     = fullName || "Not set";
				$("detailUsername").textContent  = username ? "@" + username : "Not set";
				$("detailWebsite").textContent   = website || "Not set";
				$("detailEmail").textContent     = email;
				$("activityJoined").textContent = createdAt
					? createdAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
					: "—";

				($("inputName")).value     = fullName;
				($("inputUsername")).value  = username;
				($("inputEmail")).value    = email;
				($("inputWebsite")).value  = website;
				($("inputLocation")).value = loc;
				($("inputBio")).value   = bio;

				const saved = { name: fullName, username, website, location: loc, bio };

				if (isFirstTime) {
					$("firstTimeBanner").style.display = "";
					$("formLabel").textContent = "Complete your profile";
				}

				const params = new URLSearchParams(window.location.search);
				if (params.get("payment") === "success") {
					$("paymentSuccessBanner").style.display = "";
					if (window.VxPlan) window.VxPlan.clearCache();
					history.replaceState({}, "", "/profile/");
				} else if (params.get("welcome") === "1" && !isFirstTime) {
					$("welcomeBanner").style.display = "";
					history.replaceState({}, "", "/profile/");
				}

				showView("profile");
				log("render complete");

				// ══════════════════════════════════════════════════════
				// PHASE 3: Plan (non-blocking, from billing backend)
				// ══════════════════════════════════════════════════════
				const planBadge = $("heroPlan");
				const planCta = $("planCta");
				const planHelper = $("planHelper");

				function renderPlan(name, paid, helperText) {
					var n = name.toLowerCase();
					planBadge.textContent = name.charAt(0).toUpperCase() + name.slice(1);
					// Remove old tier classes
					planBadge.classList.remove("plan-badge--paid","plan-badge--launch","plan-badge--pro","plan-badge--studio","plan-badge--teams");
					if (paid) {
						// Apply tier-specific class, fallback to generic --paid
						var tierClass = "plan-badge--" + n;
						if (["launch","pro","diamond","studio","teams"].includes(n)) {
							planBadge.classList.add(tierClass);
						} else {
							planBadge.classList.add("plan-badge--paid");
						}
						planCta.textContent = "Manage plan";
					} else {
						planCta.textContent = "Upgrade plan";
					}
					planCta.href = "/pricing/";
					if (planHelper) {
						planHelper.textContent = helperText || "";
						planHelper.style.display = helperText ? "" : "none";
					}
				}

				// Read plan from profile row (Supabase source of truth)
				// Use the higher of plan vs builder_plan
				const _planRank = { free: 0, launch: 1, business: 2, pro: 2, diamond: 2, studio: 3, teams: 4 };
				const _allPlans = [profile?.builder_plan, profile?.daily_plan, profile?.cvitae_plan, profile?.plan]
					.map(p => (p || "free").toLowerCase().trim());
				const dbPlan = _allPlans.reduce((best, p) => (_planRank[p] || 0) > (_planRank[best] || 0) ? p : best, "free");
				const dbPaid = dbPlan && dbPlan !== "free";
				renderPlan(dbPaid ? dbPlan : "Free", dbPaid);
				log("plan from DB: " + dbPlan);
				if (window.VxPlan) window.VxPlan.cache(dbPlan);

				// Also try billing backend for most up-to-date info
				const apiBase = ((cfg).functionsUrl || (cfg).apiBaseUrl || "").replace(/\/$/, "");
				if (apiBase) {
					(async () => {
						try {
							const ctrl = new AbortController();
							const t = setTimeout(() => ctrl.abort(), 8000);
							const res = await fetch(`${apiBase}/check-permission`, {
								method: "POST",
								headers: { "Content-Type": "application/json", Authorization: `Bearer ${accessToken}` },
								body: JSON.stringify({ tool: "profile" }),
								signal: ctrl.signal,
							});
							clearTimeout(t);
							if (res.ok) {
								const d = await res.json();
								// Use server-computed effective_tier if available, else compute from all plans
								const p = d.effective_tier || [d.builder_plan, d.daily_plan, profile?.cvitae_plan, d.plan]
									.map(pp => (pp || "free").toLowerCase().trim())
									.reduce((best, pp) => (_planRank[pp] || 0) > (_planRank[best] || 0) ? pp : best, "free");
								const paid = p && p !== "free";
								renderPlan(paid ? p : "Free", paid);
								if (window.VxPlan) window.VxPlan.cache(p);
								log("plan from API: " + p);
							}
						} catch (_) {
							log("plan API unavailable, using DB: " + dbPlan);
						}
					})();
				} else {
					log("plan: Free (no billing backend)");
				}

				// ══════════════════════════════════════════════════════
				// PHASE 3a: Multi-product subscription cards
				// ══════════════════════════════════════════════════════
				const builderTier = (profile?.builder_plan || "free").toLowerCase().trim();
				const dailyTier = (profile?.daily_plan || "free").toLowerCase().trim();
				const cvitaeTier = (profile?.cvitae_plan || "free").toLowerCase().trim();

				const subBuilderEl = $("subBuilderPlan");
				const subDailyEl = $("subDailyPlan");
				const subCvitaeEl = $("subCvitaePlan");
				const subTokensEl = $("subTokens");
				const subDailyArt = $("subDailyArt");
				const subBuilderCta = $("subBuilderCta");
				const subDailyCta = $("subDailyCta");
				const subCvitaeCta = $("subCvitaeCta");
				const dailyPlanAssets = {
					free: "/assets/daily-icon.webp",
					pro: "/assets/dailypro.webp",
					diamond: "/assets/daily-diamond.webp",
				};
				const layerRank = { free: 0, launch: 1, business: 2, pro: 2, diamond: 3, studio: 4, teams: 5, enterprise: 6 };
				function titleTier(tier) {
					const value = String(tier || "free").toLowerCase().trim();
					return value.charAt(0).toUpperCase() + value.slice(1);
				}
				function paintLayerStatus(id, tier, opts = {}) {
					const el = $(id);
					if (!el) return;
					const value = String(tier || "free").toLowerCase().trim();
					el.textContent = opts.label || titleTier(value);
					el.dataset.tier = value;
					el.classList.toggle("layer-card__status--active", value !== "free" || !!opts.active);
					el.classList.toggle("layer-card__status--premium", (layerRank[value] || 0) >= 2);
				}

				if (subBuilderEl) {
					subBuilderEl.textContent = titleTier(builderTier);
					subBuilderEl.setAttribute("data-tier", builderTier);
					if (builderTier !== "free" && subBuilderCta) {
						subBuilderCta.textContent = "Manage";
						subBuilderCta.href = "/pricing/";
					}
				}
				if (subDailyEl) {
					subDailyEl.textContent = titleTier(dailyTier);
					subDailyEl.setAttribute("data-tier", dailyTier);
					if (subDailyArt) {
						subDailyArt.src = dailyPlanAssets[dailyTier] || dailyPlanAssets.free;
					}
					if (dailyTier !== "free" && subDailyCta) {
						subDailyCta.textContent = "Manage";
					}
				}
				if (subCvitaeEl) {
					subCvitaeEl.textContent = titleTier(cvitaeTier);
					subCvitaeEl.setAttribute("data-tier", cvitaeTier);
					if (cvitaeTier !== "free" && subCvitaeCta) {
						subCvitaeCta.textContent = "Manage";
					}
				}
				if (subTokensEl) {
					subTokensEl.textContent = String(profile?.token_balance || 0);
				}
				paintLayerStatus("layerCoreStatus", dbPlan, { active: true, label: dbPaid ? titleTier(dbPlan) : "Active" });
				paintLayerStatus("layerBuilderStatus", builderTier);
				paintLayerStatus("layerDailyStatus", dailyTier);
				paintLayerStatus("layerCvitaeStatus", cvitaeTier);
				const layerVxBalance = $("layerVxBalance");
				if (layerVxBalance) layerVxBalance.textContent = Number(profile?.token_balance || 0).toLocaleString();
				const layerDailyArt = $("layerDailyArt");
				if (layerDailyArt) layerDailyArt.src = dailyPlanAssets[dailyTier] || dailyPlanAssets.free;

				// ══════════════════════════════════════════════════════
				// PHASE 3a1: Icon purchases + automatic delivery
				// ══════════════════════════════════════════════════════
				const iconPurchasesSection = $("iconPurchasesSection");
				const iconPurchasesGrid = $("iconPurchasesGrid");
				let iconPurchaseRows = [];
				const iconDeliveryApiBase = ((cfg).apiBaseUrl || (cfg).functionsUrl || "").replace(/\/$/, "");
				const iconDeliveryEndpoint = iconDeliveryApiBase
					? iconDeliveryApiBase.includes("/functions/v1")
						? `${iconDeliveryApiBase}/icon-purchase-delivery`
						: `${iconDeliveryApiBase}/api/icon-purchase-delivery`
					: "";
				const ICON_CHECKOUT_PRICES = {
					icons_single_budget:   { gbp: 0.8, eur: 0.95, brl: 5.5 },
					icons_single_standard: { gbp: 1.4, eur: 1.6, brl: 9.9 },
					icons_single_premium:  { gbp: 2.2, eur: 2.6, brl: 14.9 },
					icons_single_hyper:    { gbp: 5.9, eur: 6.9, brl: 39.9 },
					icons_pack_mixed:      { gbp: 5.2, eur: 6, brl: 34.9 },
					icons_pack_premium:    { gbp: 11.2, eur: 13, brl: 74.9 },
					icons_pack_hyper:      { gbp: 37, eur: 43, brl: 249 },
				};

				function escapeHtml(value) {
					return String(value ?? "")
						.replace(/&/g, "&amp;")
						.replace(/</g, "&lt;")
						.replace(/>/g, "&gt;")
						.replace(/"/g, "&quot;");
				}

				function titleCaseWords(value) {
					return String(value || "")
						.replace(/[_-]+/g, " ")
						.replace(/\s+/g, " ")
						.trim()
						.replace(/\b\w/g, (letter) => letter.toUpperCase());
				}

				function iconMeta(row) {
					const value = row && row.metadata;
					if (!value) return {};
					if (typeof value === "string") {
						try { return JSON.parse(value); } catch (_) { return {}; }
					}
					return typeof value === "object" ? value : {};
				}

				function stripCurrencySuffix(value) {
					return String(value || "").trim().replace(/_(gbp|eur|brl)$/i, "");
				}

				function iconLookupBase(row) {
					const meta = iconMeta(row);
					return stripCurrencySuffix(meta.lookup_key || row?.lookup_key || row?.addon_id || "");
				}

				function iconSessionId(row) {
					const meta = iconMeta(row);
					return String(meta.stripe_session_id || row?.stripe_session_id || "").trim();
				}

				function iconRecoveryHref(row) {
					const sessionId = iconSessionId(row);
					if (!sessionId) return "";
					return `/dashboard/purchases/icons?session_id=${encodeURIComponent(sessionId)}`;
				}

				function iconPriceFromCatalog(row) {
					const base = iconLookupBase(row);
					const currency = String(row?.currency || "GBP").toLowerCase();
					const priceTable = ICON_CHECKOUT_PRICES[base];
					return priceTable && typeof priceTable[currency] === "number" ? priceTable[currency] : null;
				}

				function iconKind(row) {
					const meta = iconMeta(row);
					if (meta.kind === "single" || meta.kind === "pack") return meta.kind;
					return iconLookupBase(row).includes("_pack_") ? "pack" : "single";
				}

				function iconTier(row) {
					const meta = iconMeta(row);
					if (meta.tier) return String(meta.tier);
					return iconLookupBase(row)
						.replace(/^icons_(single|pack)_/, "")
						.replace(/_(gbp|eur|brl)$/i, "");
				}

				function safeAssetPath(raw) {
					const path = String(raw || "").trim();
					if (!path || path.includes("..") || path.includes("\\") || /^https?:\/\//i.test(path)) return "";
					if (!path.startsWith("/assets/") && !path.startsWith("/icons/") && !path.startsWith("/products/")) return "";
					return path;
				}

				function fileNameFromPath(path, fallback) {
					const clean = String(path || "").split("?")[0].split("#")[0];
					const file = clean.split("/").filter(Boolean).pop() || fallback || "volynx-icon";
					return file.replace(/[^a-z0-9._-]+/gi, "-").slice(0, 120) || fallback || "volynx-icon";
				}

				function slugFileName(value, fallback) {
					const slug = String(value || "")
						.toLowerCase()
						.replace(/[^a-z0-9]+/g, "-")
						.replace(/^-+|-+$/g, "")
						.slice(0, 90);
					return slug || fallback || "volynx-icons";
				}

				function iconPurchaseTitle(row) {
					const meta = iconMeta(row);
					if (iconKind(row) === "single") {
						return meta.icon_label || titleCaseWords(iconTier(row) + " icon");
					}
					return meta.icon_label || (meta.icon_collection === "__all_premium__" ? "Full premium combo" : meta.icon_collection) || titleCaseWords(iconTier(row) + " icon pack");
				}

				function iconPurchaseSubtitle(row) {
					const kind = iconKind(row);
					const tier = titleCaseWords(iconTier(row));
					const meta = iconMeta(row);
					if (kind === "single" && meta.icon_collection) return `${tier} single · ${meta.icon_collection}`;
					if (kind === "pack" && meta.icon_collection === "__all_premium__") return `${tier} pack · All premium collections`;
					if (kind === "pack" && meta.icon_collection) return `${tier} pack · ${meta.icon_collection}`;
					return `${tier} ${kind}`;
				}

				function formatIconPurchasePrice(row) {
					const amount = row?.price_paid != null ? Number(row.price_paid) : iconPriceFromCatalog(row);
					if (amount == null || Number.isNaN(amount)) return "";
					try {
						return new Intl.NumberFormat(undefined, {
							style: "currency",
							currency: String(row.currency || "GBP").toUpperCase(),
						}).format(amount);
					} catch (_) {
						return `${amount} ${row.currency || ""}`.trim();
					}
				}

				function formatIconPurchaseDate(row) {
					if (!row?.created_at) return "";
					try {
						return new Date(row.created_at).toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" });
					} catch (_) {
						return "";
					}
				}

				function iconPurchaseDeliverable(row) {
					const meta = iconMeta(row);
					const kind = iconKind(row);
					const directPath = safeAssetPath(meta.icon_path);
					if (kind === "single" && directPath) {
						return { ready: true, mode: "single", label: "Download icon" };
					}
					if (kind === "pack" && meta.icon_collection) {
						return { ready: true, mode: "pack", label: "Download ZIP" };
					}
					if (directPath) {
						return { ready: true, mode: "single", label: "Download file" };
					}
					if (iconSessionId(row)) {
						return { ready: false, mode: "recover", label: "Open delivery" };
					}
					return { ready: false, mode: "manual", label: "Prepare delivery" };
				}

				function mergeIconPurchaseRows(addonRows, eventRows) {
					const seen = new Set();
					const rows = [];
					const pushRow = (row, source) => {
						const key = iconSessionId(row) || iconLookupBase(row) || String(row?.id || "");
						if (!key || seen.has(key)) return;
						seen.add(key);
						rows.push({ ...row, _source: source });
					};

					(addonRows || []).forEach((row) => {
						if (!iconLookupBase(row).startsWith("icons_")) return;
						pushRow(row, "addons");
					});

					(eventRows || []).forEach((row) => {
						if (!iconLookupBase(row).startsWith("icons_")) return;
						pushRow({
							...row,
							addon_id: row?.addon_id || iconLookupBase(row),
							price_paid: row?.price_paid != null ? row.price_paid : iconPriceFromCatalog(row),
						}, "events");
					});

					return rows.sort((a, b) => new Date(b?.created_at || 0).getTime() - new Date(a?.created_at || 0).getTime());
				}

				function iconPurchaseCard(row, index) {
					const meta = iconMeta(row);
					const deliverable = iconPurchaseDeliverable(row);
					const title = iconPurchaseTitle(row);
					const subtitle = iconPurchaseSubtitle(row);
					const date = formatIconPurchaseDate(row);
					const price = formatIconPurchasePrice(row);
					const previewPath = safeAssetPath(meta.icon_path);
					const badge = iconKind(row) === "pack" ? "Pack" : "Single";

					return `
						<article class="icon-purchase-card">
							<div class="icon-purchase-card__preview">
								${previewPath ? `<img src="${escapeHtml(previewPath)}" alt="" loading="lazy" />` : `<span>${escapeHtml(badge)}</span>`}
							</div>
							<div class="icon-purchase-card__body">
								<div class="icon-purchase-card__topline">
									<span>${escapeHtml(badge)}</span>
									<span>${escapeHtml(titleCaseWords(iconTier(row)))}</span>
								</div>
								<h3>${escapeHtml(title)}</h3>
								<p>${escapeHtml(subtitle)}</p>
								<div class="icon-purchase-card__meta">
									${date ? `<span>${escapeHtml(date)}</span>` : ""}
									${price ? `<span>${escapeHtml(price)}</span>` : ""}
									${row?.status ? `<span>${escapeHtml(titleCaseWords(row.status))}</span>` : ""}
								</div>
							</div>
							<button class="btn btn--sm ${deliverable.ready ? "" : "btn--ghost"} icon-delivery-btn" type="button" data-icon-purchase-index="${index}">
								${escapeHtml(deliverable.label)}
							</button>
						</article>
					`;
				}

				function downloadBlob(blob, filename) {
					const url = URL.createObjectURL(blob);
					const anchor = document.createElement("a");
					anchor.href = url;
					anchor.download = filename;
					document.body.appendChild(anchor);
					anchor.click();
					document.body.removeChild(anchor);
					setTimeout(() => URL.revokeObjectURL(url), 1000);
				}

				function downloadDirect(path, filename) {
					const anchor = document.createElement("a");
					anchor.href = path;
					anchor.download = filename || fileNameFromPath(path, "volynx-icon");
					document.body.appendChild(anchor);
					anchor.click();
					document.body.removeChild(anchor);
				}

				async function downloadIconPackZip(row) {
					const meta = iconMeta(row);
					const collection = String(meta.icon_collection || "").trim();
					if (!collection) throw new Error("Pack collection is missing.");
					if (!window.JSZip) throw new Error("ZIP engine is still loading. Try again in a moment.");

					const catalogRes = await fetch("/assets/icons-store/catalog.json", { cache: "no-store" });
					if (!catalogRes.ok) throw new Error("Icon catalog is unavailable.");
					const catalog = await catalogRes.json();
					if (!Array.isArray(catalog)) throw new Error("Icon catalog is invalid.");

					const icons = collection === "__all_premium__"
						? catalog.filter((icon) => ["premium", "paid"].includes(String(icon?.plan || "").toLowerCase()))
						: catalog.filter((icon) => String(icon?.collection || "") === collection);
					if (!icons.length) throw new Error("No files found for this pack.");

					const zip = new window.JSZip();
					const folderName = slugFileName(collection, "volynx-icons-pack");

					for (const icon of icons) {
						const path = safeAssetPath(icon?.path);
						if (!path) continue;
						const fileRes = await fetch(path);
						if (!fileRes.ok) continue;
						const blob = await fileRes.blob();
						const filename = fileNameFromPath(icon?.file || path, "icon.webp");
						zip.file(`${folderName}/${filename}`, blob);
					}

					const content = await zip.generateAsync({ type: "blob" });
					downloadBlob(content, `${folderName}.zip`);
				}

				async function resolveIconDelivery(row) {
					if (iconPurchaseDeliverable(row).ready) return row;
					if (!iconDeliveryEndpoint) return row;

					const res = await fetch(iconDeliveryEndpoint, {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
							Authorization: `Bearer ${accessToken}`,
						},
						body: JSON.stringify({
							purchase_id: row?.id || null,
							session_id: iconSessionId(row) || null,
							lookup_key: row?.lookup_key || iconLookupBase(row) || null,
						}),
					});

					const payload = await res.json().catch(() => ({}));
					if (!res.ok || !payload?.ok || !payload?.purchase) {
						throw new Error(payload?.error || "Could not resolve icon delivery.");
					}

					const recovered = { ...row, ...payload.purchase, metadata: payload.purchase.metadata || row.metadata || {} };
					const recoveredKey = iconSessionId(recovered) || iconLookupBase(recovered) || String(recovered?.id || "");
					const index = iconPurchaseRows.findIndex((entry) => {
						const entryKey = iconSessionId(entry) || iconLookupBase(entry) || String(entry?.id || "");
						return entryKey === recoveredKey;
					});
					if (index >= 0) iconPurchaseRows[index] = recovered;
					return recovered;
				}

				async function handleIconDelivery(row, button) {
					const originalText = button.textContent;
					let workingRow = row;
					let meta = iconMeta(workingRow);
					let deliverable = iconPurchaseDeliverable(workingRow);
					button.disabled = true;
					button.textContent = deliverable.mode === "pack" ? "Building ZIP..." : "Opening...";

					try {
						if (!deliverable.ready && deliverable.mode === "recover") {
							button.textContent = "Preparing delivery...";
							workingRow = await resolveIconDelivery(workingRow);
							meta = iconMeta(workingRow);
							deliverable = iconPurchaseDeliverable(workingRow);
						}

						if (deliverable.mode === "single") {
							const path = safeAssetPath(meta.icon_path);
							if (!path) throw new Error("Icon path is missing.");
							downloadDirect(path, fileNameFromPath(path, slugFileName(iconPurchaseTitle(workingRow), "volynx-icon")));
							button.textContent = "Downloaded";
						} else if (deliverable.mode === "pack") {
							await downloadIconPackZip(workingRow);
							button.textContent = "ZIP ready";
						} else {
							const recoveryHref = iconRecoveryHref(workingRow);
							if (recoveryHref) {
								window.location.href = recoveryHref;
								return;
							}
							const purchaseId = encodeURIComponent(workingRow?.id || workingRow?.addon_id || "icons");
							window.location.href = `/support/?product=volynx-icons-store&intent=delivery&purchase=${purchaseId}`;
							return;
						}
					} catch (error) {
						console.error("[profile] icon delivery failed:", error);
						const recoveryHref = iconRecoveryHref(workingRow);
						if (recoveryHref) {
							window.location.href = recoveryHref;
							return;
						}
						button.textContent = "Delivery issue";
						button.classList.add("btn--ghost");
						setTimeout(() => { button.textContent = originalText; button.disabled = false; }, 2200);
						return;
					}

					setTimeout(() => { button.textContent = originalText; button.disabled = false; }, 1800);
				}

				function bindIconDeliveryButtons() {
					document.querySelectorAll(".icon-delivery-btn[data-icon-purchase-index]").forEach((button) => {
						button.addEventListener("click", () => {
							const index = Number(button.getAttribute("data-icon-purchase-index") || "0");
							const row = iconPurchaseRows[index];
							if (row) handleIconDelivery(row, button);
						});
					});
				}

				async function loadIconPurchases() {
					if (!iconPurchasesSection || !iconPurchasesGrid) return;
					try {
						const [addonResult, eventResult] = await Promise.all([
							supabase
								.from("addons_purchased")
								.select("id,addon_id,price_paid,currency,status,metadata,created_at")
								.eq("user_id", user.id)
								.like("addon_id", "icons_%")
								.order("created_at", { ascending: false }),
							supabase
								.from("purchase_events")
								.select("id,stripe_session_id,lookup_key,product_key,amount_paid,currency,status,metadata,created_at")
								.eq("user_id", user.id)
								.like("lookup_key", "icons_%")
								.order("created_at", { ascending: false }),
						]);

						if (addonResult.error) throw addonResult.error;
						if (eventResult.error) throw eventResult.error;

						iconPurchaseRows = mergeIconPurchaseRows(
							Array.isArray(addonResult.data) ? addonResult.data : [],
							Array.isArray(eventResult.data) ? eventResult.data : [],
						);
						iconPurchasesSection.style.display = "";

						if (!iconPurchaseRows.length) {
							iconPurchasesGrid.innerHTML = `
								<div class="icon-purchases-empty">
									<strong>No icon purchases yet.</strong>
									<span>Purchased singles and packs will appear here automatically.</span>
								</div>
							`;
							return;
						}

						iconPurchasesGrid.innerHTML = iconPurchaseRows.map(iconPurchaseCard).join("");
						bindIconDeliveryButtons();
						log("icon purchases: " + iconPurchaseRows.length);
					} catch (error) {
						console.error("[profile] icon purchases failed:", error);
						if (iconPurchasesSection && iconPurchasesGrid) {
							iconPurchasesSection.style.display = "";
							iconPurchasesGrid.innerHTML = '<p class="text-muted" style="font-size:.85rem;">Could not load icon purchases.</p>';
						}
					}
				}

				loadIconPurchases();

				// ══════════════════════════════════════════════════════
				// PHASE 3a2: Change password
				// ══════════════════════════════════════════════════════
				const cpBtn = $("changePasswordBtn");
				const cpForm = $("passwordForm");
				const cpSave = $("savePasswordBtn");
				const cpCancel = $("cancelPasswordBtn");
				const cpMsg = $("passwordMsg");
				const cpNew = $("newPassword");
				const cpConfirm = $("confirmPassword");

				if (cpBtn && cpForm) {
					cpBtn.addEventListener("click", () => { cpForm.hidden = false; cpBtn.style.display = "none"; });
					cpCancel.addEventListener("click", () => { cpForm.hidden = true; cpBtn.style.display = ""; cpMsg.textContent = ""; });
					cpSave.addEventListener("click", async () => {
						const pw = cpNew.value;
						const pw2 = cpConfirm.value;
						if (!pw || pw.length < 6) { cpMsg.textContent = "Min 6 characters"; cpMsg.style.color = "#ef4444"; return; }
						if (pw !== pw2) { cpMsg.textContent = "Passwords don't match"; cpMsg.style.color = "#ef4444"; return; }
						cpSave.disabled = true;
						cpMsg.textContent = "Saving..."; cpMsg.style.color = "var(--muted)";
						try {
							const res = await fetch(cfg.supabaseUrl + "/auth/v1/user", {
								method: "PUT",
								headers: { apikey: cfg.supabaseAnonKey, Authorization: "Bearer " + accessToken, "Content-Type": "application/json" },
								body: JSON.stringify({ password: pw }),
							});
							if (res.ok) {
								cpMsg.textContent = "Password updated!"; cpMsg.style.color = "#22c55e";
								cpNew.value = ""; cpConfirm.value = "";
								setTimeout(() => { cpForm.hidden = true; cpBtn.style.display = ""; cpMsg.textContent = ""; }, 2000);
							} else {
								const err = await res.json().catch(() => ({}));
								cpMsg.textContent = err.msg || err.error_description || "Failed to update"; cpMsg.style.color = "#ef4444";
							}
						} catch(e) { cpMsg.textContent = "Connection error"; cpMsg.style.color = "#ef4444"; }
						finally { cpSave.disabled = false; }
					});
				}

				// ══════════════════════════════════════════════════════
				// PHASE 3b: Token balance (non-blocking)
				// ══════════════════════════════════════════════════════
				const tokenBalanceEl = $("tokenBalance");
				const tokenHistoryEl = $("tokenHistory");

				// Show balance from profile (instant)
				const initialBalance = profile.token_balance || 0;
				tokenBalanceEl.textContent = String(initialBalance);

				// Fetch recent transactions
				if (apiBase) {
					(async () => {
						try {
							const ctrl = new AbortController();
							const t = setTimeout(() => ctrl.abort(), 8000);
							const res = await fetch(`${apiBase}/get-balance`, {
								method: "POST",
								headers: { "Content-Type": "application/json", Authorization: `Bearer ${accessToken}` },
								body: JSON.stringify({}),
								signal: ctrl.signal,
							});
							clearTimeout(t);
							if (res.ok) {
								const d = await res.json();
								tokenBalanceEl.textContent = String(d.balance || 0);
								const recent = d.recent || [];
								if (recent.length === 0) {
									tokenHistoryEl.innerHTML = '<p class="text-muted" style="font-size:.85rem;">No token activity yet.</p>';
								} else {
									tokenHistoryEl.innerHTML = recent.slice(0, 8).map((tx) => {
										const isSpend = tx.amount < 0;
										const sign = isSpend ? "" : "+";
										const color = isSpend ? "var(--danger)" : "var(--success)";
										const date = new Date(tx.created_at).toLocaleDateString("en-US", { month: "short", day: "numeric" });
										const desc = tx.description || tx.tool_name || tx.type;
										return `<div class="token-tx"><span class="token-tx-desc">${desc}</span><span class="token-tx-amount" style="color:${color}">${sign}${tx.amount}</span><span class="token-tx-date">${date}</span></div>`;
									}).join("");
								}
								log("tokens: " + d.balance);
							} else {
								tokenHistoryEl.innerHTML = '<p class="text-muted" style="font-size:.85rem;">Could not load history.</p>';
							}
						} catch (_) {
							tokenHistoryEl.innerHTML = '<p class="text-muted" style="font-size:.85rem;">Could not load history.</p>';
						}
					})();
				}

				// ══════════════════════════════════════════════════════
				// PHASE 4: Event listeners
				// ══════════════════════════════════════════════════════

				const logoutEl = $("logoutBtn");
				logoutEl._mainHandlerAttached = true;
				logoutEl.onclick = async () => {
					try { await supabase.auth.signOut(); } catch (_) {}
					clearSession();
					log("signOut complete");
					window.location.href = "/";
				};

				$("editProfileBtn")?.addEventListener("click", () => {
					$("welcomeBanner").style.display = "none";
					$("editPanel")?.scrollIntoView({ behavior: "smooth", block: "start" });
				});

				// Reveal the firstTime "Continue where you were" button only when
				// there is a real return URL saved (i.e. the user came from a
				// product/checkout). Prevents stranding first-time signups
				// mid-purchase with no way back.
				// NOTE: this script block is <script is:inline> = plain JS. Do
				// NOT use TypeScript casts here — they break the whole file at
				// browser parse time and leave the page stuck on the spinner.
				const pendingNext = localStorage.getItem("volynx_post_login_next") || "";
				if (pendingNext && pendingNext.startsWith("/") && !pendingNext.startsWith("//") && pendingNext !== "/volynx-lab/" && !pendingNext.startsWith("/profile")) {
					const firstTimeCta = $("firstTimeContinueBtn");
					if (firstTimeCta) {
						firstTimeCta.hidden = false;
						firstTimeCta.addEventListener("click", () => {
							localStorage.removeItem("volynx_post_login_next");
							window.location.href = pendingNext;
						});
					}
				}

				$("continueBtn")?.addEventListener("click", () => {
					const next = localStorage.getItem("volynx_post_login_next") || "/volynx-lab/";
					localStorage.removeItem("volynx_post_login_next");
					if (next.startsWith("/") && !next.startsWith("//")) {
						window.location.href = next;
					} else {
						window.location.href = "/volynx-lab/";
					}
				});

				$("scrollToEdit")?.addEventListener("click", () => {
					$("editPanel")?.scrollIntoView({ behavior: "smooth", block: "start" });
				});

				// Avatar panel — accessible dialog with focus management
				const avatarPanel = $("avatarPanel");
				const avatarTrigger = $("avatarFrameBtn");
				const avatarCloseBtn = $("avatarPanelClose");
				let avatarLastFocus = null;

				function getAvatarFocusables() {
					if (!avatarPanel) return [];
					return Array.from(avatarPanel.querySelectorAll(
						'button, [href], input, [tabindex]:not([tabindex="-1"])'
					)).filter(el => !el.hasAttribute("disabled") && el.offsetParent !== null);
				}

				function openAvatarPanel() {
					if (!avatarPanel) return;
					avatarLastFocus = document.activeElement;
					avatarPanel.hidden = false;
					avatarTrigger?.setAttribute("aria-expanded", "true");
					// Focus first interactive element so screen readers announce dialog
					const focusables = getAvatarFocusables();
					(focusables[0] || avatarCloseBtn)?.focus();
				}

				function closeAvatarPanel() {
					if (!avatarPanel || avatarPanel.hidden) return;
					avatarPanel.hidden = true;
					avatarTrigger?.setAttribute("aria-expanded", "false");
					// Restore focus to the trigger so keyboard users keep their place
					if (avatarLastFocus && typeof avatarLastFocus.focus === "function") {
						avatarLastFocus.focus();
					} else {
						avatarTrigger?.focus();
					}
				}

				avatarTrigger?.addEventListener("click", () => {
					avatarPanel.hidden ? openAvatarPanel() : closeAvatarPanel();
				});
				avatarTrigger?.addEventListener("keydown", (e) => {
					if (e.key === "Enter" || e.key === " ") {
						e.preventDefault();
						avatarPanel.hidden ? openAvatarPanel() : closeAvatarPanel();
					}
				});
				avatarCloseBtn?.addEventListener("click", closeAvatarPanel);

				// Escape closes; Tab cycles focus inside the panel
				document.addEventListener("keydown", (e) => {
					if (avatarPanel?.hidden) return;
					if (e.key === "Escape") {
						e.preventDefault();
						closeAvatarPanel();
						return;
					}
					if (e.key !== "Tab") return;
					const focusables = getAvatarFocusables();
					if (focusables.length === 0) return;
					const first = focusables[0];
					const last = focusables[focusables.length - 1];
					if (e.shiftKey && document.activeElement === first) {
						e.preventDefault();
						last.focus();
					} else if (!e.shiftKey && document.activeElement === last) {
						e.preventDefault();
						first.focus();
					}
				});

				// ── Avatar picker (PT-2c) — catalog-driven ──────────────────────
				// Plan rank mirror (matches src/data/avatars.ts and check-permission edge).
				const AVATAR_PLAN_RANK = { free: 0, launch: 1, business: 2, pro: 2, diamond: 2, studio: 3, teams: 4, enterprise: 5 };

				const avatarUserRank = Math.max(
					AVATAR_PLAN_RANK[(profile?.plan || "free").toLowerCase()] ?? 0,
					AVATAR_PLAN_RANK[(profile?.builder_plan || "free").toLowerCase()] ?? 0,
					AVATAR_PLAN_RANK[(profile?.daily_plan || "free").toLowerCase()] ?? 0,
					AVATAR_PLAN_RANK[(profile?.cvitae_plan || "free").toLowerCase()] ?? 0,
				);
				const avatarUserIsBd = !!profile?.is_black_diamond;

				// Lock or unlock each non-BD option based on plan rank
				document.querySelectorAll('.avatar-option[data-avatar-id]:not([data-avatar-bd-only])').forEach(btn => {
					const reqPlan = btn.dataset.avatarPlan;
					const reqRank = AVATAR_PLAN_RANK[reqPlan] ?? 99;
					if (avatarUserRank < reqRank) {
						btn.classList.add("avatar-option--locked");
						btn.setAttribute("aria-disabled", "true");
						const ptHint = "Faça upgrade para " + (reqPlan?.charAt(0).toUpperCase() + reqPlan?.slice(1)) + " para desbloquear";
						const enHint = "Upgrade to " + (reqPlan?.charAt(0).toUpperCase() + reqPlan?.slice(1)) + " to unlock";
						btn.setAttribute("title", document.documentElement.lang === "pt" ? ptHint : enHint);
					}
				});

				// Show BD section if user is Black Diamond
				if (avatarUserIsBd) {
					const bdSection = document.querySelector(".avatar-panel__section--bd");
					if (bdSection) bdSection.hidden = false;
				}

				// Show locked-hint if there are any locked options remaining
				const anyLocked = !!document.querySelector(".avatar-option--locked");
				const hintEl = $("avatarPanelHint");
				if (hintEl) hintEl.hidden = !anyLocked;

				// Mark current avatar as selected
				if (profile?.avatar_id) {
					const sel = document.querySelector(`.avatar-option[data-avatar-id="${profile.avatar_id}"]`);
					if (sel) sel.classList.add("avatar-option--selected");
				}

				// Click handler — saves immediately via /update-avatar edge fn
				async function selectAvatar(btn) {
					if (btn.classList.contains("avatar-option--locked")) {
						// Wiggle to signal locked
						try {
							btn.animate(
								[{ transform: "translateX(0)" }, { transform: "translateX(-4px)" }, { transform: "translateX(4px)" }, { transform: "translateX(0)" }],
								{ duration: 280 },
							);
						} catch (_) {}
						return;
					}
					const id = btn.dataset.avatarId;
					const src = btn.dataset.avatarSrc;
					if (!id || !src) return;

					// Optimistic UI
					avatarPreview.src = src;
					avatarPreview.style.display = "block";
					avatarFallback.style.display = "none";
					document.querySelectorAll(".avatar-option").forEach(o => o.classList.remove("avatar-option--selected"));
					btn.classList.add("avatar-option--selected");
					closeAvatarPanel();

					// Persist
					const apiBase = (cfg?.functionsUrl || cfg?.apiBaseUrl || "").replace(/\/$/, "");
					const token = localStorage.getItem("volynx_access_token") || "";
					if (!apiBase || !token) return;
					try {
						const res = await fetch(apiBase + "/update-avatar", {
							method: "POST",
							headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
							body: JSON.stringify({ avatar_id: id }),
						});
						const data = await res.json().catch(() => ({}));
						if (!res.ok || !data?.ok) {
							log("avatar save failed: " + (data?.error || res.status));
							const status = $("saveStatus");
							if (status) {
								const pt = document.documentElement.lang === "pt";
								status.textContent = pt ? "Falha ao salvar avatar." : "Failed to save avatar.";
								status.style.color = "var(--danger)";
							}
							return;
						}
						// Cache for cross-page resolver (PT-2d)
						try {
							localStorage.setItem("volynx_avatar_cache", JSON.stringify({ id, src, ts: Date.now() }));
						} catch (_) {}
						// Update in-memory profile so subsequent saves don't regress
						if (profile) profile.avatar_id = id;
					} catch (err) {
						log("avatar network error: " + (err?.message || err));
					}
				}

				document.querySelectorAll(".avatar-option[data-avatar-id]").forEach(btn => {
					btn.addEventListener("click", () => selectAvatar(btn));
				});

				function applyToUI(d) {
					$("profileName").textContent   = d.full_name || "Unnamed User";
					$("profileHandle").textContent = d.username ? "@" + d.username : "";
					$("heroBio").textContent       = d.bio || "";
					$("heroLocation").textContent  = d.location || "—";
					$("detailName").textContent     = d.full_name || "Not set";
					$("detailUsername").textContent = d.username ? "@" + d.username : "Not set";
					$("detailWebsite").textContent  = d.website || "Not set";
					avatarFallback.textContent       = initials(d.full_name || "", email);
					$("firstTimeBanner").style.display = "none";
				}

				$("profileForm")?.addEventListener("submit", async (e) => {
					e.preventDefault();
					const saveBtn = $("saveBtn");
					const status  = $("saveStatus");

					const usernameResult = validateUsername(($("inputUsername")).value);
					if (usernameResult && "error" in usernameResult) {
						status.textContent = usernameResult.error;
						status.style.color = "var(--danger)";
						return;
					}

					saveBtn.disabled   = true;
					status.textContent = "Saving...";
					status.style.color = "";

					// Avatar is saved separately via /update-avatar edge fn (PT-2c).
					// Form only saves text fields here.
					const updates = {
						full_name: nullIfEmpty(($("inputName")).value),
						username:  usernameResult?.value ?? null,
						website:   nullIfEmpty(($("inputWebsite")).value),
						location:  nullIfEmpty(($("inputLocation")).value),
						bio:       nullIfEmpty(($("inputBio")).value),
					};

					const { error } = await supabase.from("profiles").update(updates).eq("id", user.id);

					if (error) {
						status.textContent = error.message.includes("username_unique")
							? "This username is already taken."
							: "Error: " + error.message;
						status.style.color = "var(--danger)";
						log("save FAILED: " + error.message);
					} else {
						status.textContent = "Profile saved.";
						status.style.color = "var(--success)";
						applyToUI(updates);
						Object.assign(saved, {
							name: updates.full_name || "",
							username: updates.username || "",
							website: updates.website || "",
							location: updates.location || "",
							bio: updates.bio || "",
						});
						log("save ok");
					}
					saveBtn.disabled = false;
				});

				$("resetBtn")?.addEventListener("click", () => {
					($("inputName")).value     = saved.name;
					($("inputUsername")).value  = saved.username;
					($("inputWebsite")).value  = saved.website;
					($("inputLocation")).value = saved.location;
					($("inputBio")).value   = saved.bio;
					$("saveStatus").textContent = "Form reset.";
					$("saveStatus").style.color = "";
				});
			})();
			} // end supabase check
		</script>

	<FlagshipFooter />
</FlagshipLayout>

