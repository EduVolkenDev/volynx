  <h2 data-i18n="terms.contact_title">Contact</h2>
  <p data-i18n-html="terms.contact_desc">Questions about these terms: <a href="mailto:hello@volynx.world">hello@volynx.world</a></p>
  <p class="meta" data-i18n="terms.updated">Last updated: {new Date().toISOString().slice(0, 10)}</p>
