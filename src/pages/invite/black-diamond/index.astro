          fine3: 'Permanente após ativação',
          footer_txt: 'Emitido por Volynx · Acesso Fundador Privado',
          sign_in_cta: 'Entrar para ativar',
          activated_msg: '◆ Ativado. <strong>{n} VX</strong> foram creditados na sua conta. Bem-vindo ao círculo fundador.',
          already_msg:   '◆ Black Diamond já está ativo na sua conta. Bem-vindo de volta, membro fundador.',
          missing_code_msg: 'Este convite privado exige um código de convite válido. Use o link completo recebido ou cole o código na página de ativação.',
          invalid_code:   'Não foi possível validar este código de convite. Verifique o link ou fale com o suporte da Volynx.',
          expired:        'Este código de convite expirou.',
          max_uses_reached: 'Este código de convite já foi totalmente resgatado.',
          wrong_recipient: 'Este convite foi emitido para outro destinatário e é intransferível.',
          already_redeemed: 'Este código de convite já foi resgatado.',
          error_msg:     'Algo correu mal: ',
          enter_code:     'Inserir código do convite',
          goto_profile:  'Ir para o seu perfil →',
          try_again:     'Tentar novamente',
          activating:    'A ativar…',
          network_error: 'Erro de rede. Por favor tente novamente.',
          copy_done:     'Copiado',
        }
      };

      var lang = localStorage.getItem('bd_lang') || (navigator.language.startsWith('pt') ? 'pt' : 'en');

      function applyLang(l) {
        lang = l;
        localStorage.setItem('bd_lang', l);
        var s = STRINGS[l];

        // update all data-i elements (except dynamic ones handled separately)
        document.querySelectorAll('[data-i]').forEach(function(el) {
          var key = el.getAttribute('data-i');
          if (key && s[key] !== undefined) {
            // Keep the CTA aligned with the current auth/claim state when language changes.
            if (key === 'cta_activate' && acceptBtn && acceptBtn._mode) {
              var modeText = {
                signin: s.sign_in_cta,
                enter_code: s.enter_code,
                activating: s.activating,
                profile: s.goto_profile,
                retry: s.try_again,
              }[acceptBtn._mode];
              if (modeText) { el.textContent = modeText; return; }
            }
            el.textContent = s[key];
          }
        });

        // update lang buttons
        document.querySelectorAll('.lang-btn').forEach(function(btn) {
          btn.classList.toggle('active', btn.dataset.lang === l);
        });
      }

      // Lang toggle click
      document.querySelectorAll('.lang-btn').forEach(function(btn) {
        btn.addEventListener('click', function() { applyLang(btn.dataset.lang); });
      });

      // ── URL params (already rendered by head script, re-read for logic) ──
      var name = window.__bdName || '';
      var code = window.__bdCode || '';

      // Ensure they're set (redundant safety net)
      var heroNameEl   = document.getElementById('heroName');
      var detailNameEl = document.getElementById('detailName');
      var codeValueEl  = document.getElementById('codeValue');
      var codeBlock    = document.getElementById('codeBlock');

      if (name) {
        if (heroNameEl)   heroNameEl.textContent   = name;
        if (detailNameEl) detailNameEl.textContent  = name;
      } else {
        if (heroNameEl)   heroNameEl.textContent   = lang === 'pt' ? 'Membro convidado' : 'Invited member';
        if (detailNameEl) detailNameEl.textContent  = lang === 'pt' ? 'Membro convidado' : 'Invited member';
      }

      if (code) {
        if (codeValueEl) codeValueEl.textContent  = code;
        if (codeBlock)   codeBlock.style.display  = 'flex';
      }

      // Copy button
      var codeCopy = document.getElementById('codeCopy');
      if (codeCopy) {
        codeCopy.addEventListener('click', function() {
          function markCopied() {
            codeCopy.textContent = STRINGS[lang].copy_done;
            codeCopy.classList.add('copied');
            setTimeout(function() {
              codeCopy.textContent = STRINGS[lang].code_copy;
              codeCopy.classList.remove('copied');
            }, 2000);
          }
          function fallbackCopy() {
            try {
              var ta = document.createElement('textarea');
              ta.value = code;
              ta.setAttribute('readonly', '');
              ta.style.position = 'fixed';
              ta.style.left = '-9999px';
              document.body.appendChild(ta);
              ta.select();
              var ok = document.execCommand('copy');
              document.body.removeChild(ta);
              if (ok) { markCopied(); return; }
            } catch(_) {}
            codeCopy.textContent = lang === 'pt' ? 'Falha — copie manualmente' : 'Copy failed — copy manually';
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(code).then(markCopied).catch(fallbackCopy);
          } else {
            fallbackCopy();
          }
        });
      }

      // Apply initial lang (after DOM is populated)
      applyLang(lang);

      // ── Auth flow ─────────────────────────────────────────────────────────
      var acceptBtn = document.getElementById('acceptBtn');
      var claimMsg  = document.getElementById('claimMsg');

      function setButtonMode(mode) {
        acceptBtn._mode = mode;
        var s = STRINGS[lang];
        var text = {
          signin: s.sign_in_cta,
          enter_code: s.enter_code,
          activating: s.activating,
          profile: s.goto_profile,
          retry: s.try_again,
        }[mode] || s.cta_activate;
        acceptBtn.textContent = text;
      }

      function showMsg(html, ok) {
        claimMsg.style.display    = 'block';
        claimMsg.style.background = ok ? 'rgba(34,197,94,.07)'           : 'rgba(239,68,68,.07)';
        claimMsg.style.border     = ok ? '1px solid rgba(34,197,94,.18)' : '1px solid rgba(239,68,68,.18)';
        claimMsg.style.color      = ok ? '#4ade80' : '#f87171';
        claimMsg.innerHTML        = html;
      }

      function voucherErrorMessage(error) {
        var s = STRINGS[lang];
        return s[error] || s.error_msg + (error || 'unknown error');
      }

      var token = localStorage.getItem('volynx_access_token');

      if (!token) {
        var next = encodeURIComponent(window.location.pathname + window.location.search);
        acceptBtn.href        = '/login/?next=' + next;
        setButtonMode('signin');
        return;
      }

      if (!code) {
        showMsg(STRINGS[lang].missing_code_msg, false);
        acceptBtn.href = '/activate/';
        setButtonMode('enter_code');
        return;
      }

      acceptBtn.addEventListener('click', async function(e) {
        e.preventDefault();
        setButtonMode('activating');
        acceptBtn.style.opacity       = '0.65';
        acceptBtn.style.pointerEvents = 'none';

        try {
          var cfg = {};
          try { cfg = await fetch('/config.json').then(function(r){ return r.json(); }); } catch(_) {}
          var base = ((cfg.functionsUrl || 'https://zdmpzrderifgqmqivjoy.supabase.co/functions/v1') + '').replace(/\/$/, '');

          var data;

          var vRes = await fetch(base + '/redeem-voucher', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
            body: JSON.stringify({ code: code }),
          });
          var vData = await vRes.json();

          if (vData.ok) {
            var grants = vData.grants_applied || {};
            var isBlackDiamondVoucher = vData.voucher_type === 'black_diamond' || grants.badge === 'black_diamond';
            data = isBlackDiamondVoucher
              ? { ok: true, already_claimed: false, tokens_granted: grants.tokens || 0 }
              : { ok: false, error: 'invalid_code' };
          } else if (vData.error === 'already_black_diamond') {
            data = { ok: true, already_claimed: true, tokens_granted: 0 };
          } else if (vData.error === 'already_redeemed') {
            data = { ok: false, error: vData.error };
          } else {
            data = { ok: false, error: vData.error };
          }

          var s = STRINGS[lang];

          if (data.ok && data.already_claimed) {
            showMsg(s.already_msg, true);
            acceptBtn.style.display = 'none';
          } else if (data.ok) {
            showMsg(s.activated_msg.replace('{n}', data.tokens_granted), true);
            setButtonMode('profile');
            acceptBtn.textContent     = s.goto_profile;
            acceptBtn.href            = '/profile/';
            acceptBtn.style.opacity       = '1';
            acceptBtn.style.pointerEvents = 'auto';
            // Clear plan cache so profile shows updated state
            if (window.VxPlan) window.VxPlan.clearCache();
          } else {
            showMsg(voucherErrorMessage(data.error), false);
            setButtonMode('retry');
            acceptBtn.style.opacity       = '1';
            acceptBtn.style.pointerEvents = 'auto';
          }
        } catch(_) {
          var s2 = STRINGS[lang];
          showMsg(s2.network_error, false);
          setButtonMode('retry');
          acceptBtn.style.opacity       = '1';
          acceptBtn.style.pointerEvents = 'auto';
        }
      });

    });
  </script>
</body>
</html>
