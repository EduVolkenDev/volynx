---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";

const landingBriefHref = `${ROUTES.contact}?product=services&intent=landing-express`;
---

<FlagshipLayout title="Landing Express — VOLYNX" description="A premium conversion-focused landing page, delivered in 48–72 hours from £300." pageClass="page-landing-express">
  <FlagshipHeader current={ROUTES.landingExpress} ctaLabel="Get started" ctaI18n="landing.express_cta" ctaHref={landingBriefHref} />

  <main>
    <section class="lx-hero">
      <div class="shell lx-hero-grid">
        <div class="lx-hero-copy">
          <span class="kicker"><span class="i18n-en">Landing Express · Conversion-first · 48–72h</span><span class="i18n-pt">Landing Express · Orientada à conversão · 48–72h</span></span>
          <h1><span class="i18n-en">A landing page that gives your offer somewhere to go.</span><span class="i18n-pt">Uma landing page que dá direção à sua oferta.</span></h1>
          <p class="lx-hero-desc"><span class="i18n-en">A focused, premium page for a product, service, launch or local business that needs visitors to understand the value and take the next step.</span><span class="i18n-pt">Uma página premium e focada para produto, serviço, lançamento ou negócio local que precisa fazer o visitante entender o valor e avançar.</span></p>
          <div class="hero-actions">
            <a class="button button--gold" href={landingBriefHref}><span class="i18n-en">Start your Landing Express</span><span class="i18n-pt">Começar sua Landing Express</span></a>
            <a class="button button--ghost" href={ROUTES.services}><span class="i18n-en">See all services</span><span class="i18n-pt">Ver todos os serviços</span></a>
          </div>
          <div class="lx-proof-row" aria-label="Landing Express facts">
            <div><strong>£300+</strong><span><span class="i18n-en">fixed starting point</span><span class="i18n-pt">a partir de valor fechado</span></span></div>
            <div><strong>48–72h</strong><span><span class="i18n-en">typical delivery</span><span class="i18n-pt">entrega típica</span></span></div>
            <div><strong>1 page</strong><span><span class="i18n-en">one clear conversion path</span><span class="i18n-pt">um caminho de conversão</span></span></div>
          </div>
        </div>

        <div class="lx-hero-visual">
          <div class="lx-orbit lx-orbit--one" aria-hidden="true"></div>
          <div class="lx-orbit lx-orbit--two" aria-hidden="true"></div>
          <img src="/assets/saasbig.webp" alt="" loading="eager" />
          <aside class="panel panel--pro lx-offer-card">
            <span class="label label--pro"><span class="i18n-en">The fast, serious option</span><span class="i18n-pt">A opção rápida e séria</span></span>
            <strong><span class="i18n-en">Landing Express</span><span class="i18n-pt">Landing Express</span></strong>
            <span class="lx-offer-price"><span class="i18n-en">From £300</span><span class="i18n-pt">A partir de £300</span></span>
            <span class="lx-offer-note"><span class="i18n-en">A premium page, not a disposable template.</span><span class="i18n-pt">Uma página premium, não um template descartável.</span></span>
          </aside>
        </div>
      </div>
    </section>

    <section id="includes" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">What you get</span><span class="i18n-pt">O que você recebe</span></span>
        <h2><span class="i18n-en">One page. All the important decisions made properly.</span><span class="i18n-pt">Uma página. Todas as decisões importantes feitas direito.</span></h2>
        <p><span class="i18n-en">Landing Express keeps the scope focused so the page can move quickly without feeling rushed.</span><span class="i18n-pt">A Landing Express mantém o escopo focado para a página avançar rápido sem parecer improvisada.</span></p>
      </div>
      <div class="shell grid-3 lx-includes-grid">
        <article class="panel lx-feature-card"><img class="lx-feature-icon" src="/assets/landing-express/offer-structure.webp" alt="" loading="lazy" decoding="async" /><span class="lx-feature-number">01</span><h3><span class="i18n-en">Offer structure</span><span class="i18n-pt">Estrutura da oferta</span></h3><p><span class="i18n-en">A clear hierarchy for the promise, proof, objections and next step.</span><span class="i18n-pt">Hierarquia clara para promessa, prova, objeções e próximo passo.</span></p></article>
        <article class="panel lx-feature-card"><img class="lx-feature-icon" src="/assets/landing-express/premium-visual-system.webp" alt="" loading="lazy" decoding="async" /><span class="lx-feature-number">02</span><h3><span class="i18n-en">Premium visual system</span><span class="i18n-pt">Sistema visual premium</span></h3><p><span class="i18n-en">Typography, colour, spacing and imagery aligned with the value you sell.</span><span class="i18n-pt">Tipografia, cor, espaçamento e imagens alinhados ao valor que você vende.</span></p></article>
        <article class="panel lx-feature-card"><img class="lx-feature-icon" src="/assets/landing-express/conversion-path.webp" alt="" loading="lazy" decoding="async" /><span class="lx-feature-number">03</span><h3><span class="i18n-en">Conversion path</span><span class="i18n-pt">Caminho de conversão</span></h3><p><span class="i18n-en">A focused CTA connected to booking, contact, purchase or your chosen next action.</span><span class="i18n-pt">CTA focado conectado ao booking, contato, compra ou ação que você escolher.</span></p></article>
        <article class="panel lx-feature-card"><img class="lx-feature-icon" src="/assets/landing-express/responsive-build.webp" alt="" loading="lazy" decoding="async" /><span class="lx-feature-number">04</span><h3><span class="i18n-en">Responsive build</span><span class="i18n-pt">Construção responsiva</span></h3><p><span class="i18n-en">A polished experience across mobile, tablet and desktop.</span><span class="i18n-pt">Uma experiência refinada em mobile, tablet e desktop.</span></p></article>
        <article class="panel lx-feature-card"><img class="lx-feature-icon" src="/assets/landing-express/seo-trust.webp" alt="" loading="lazy" decoding="async" /><span class="lx-feature-number">05</span><h3><span class="i18n-en">SEO and trust basics</span><span class="i18n-pt">Fundamentos de SEO e confiança</span></h3><p><span class="i18n-en">Page metadata, accessible structure and the details that make the first impression credible.</span><span class="i18n-pt">Metadados, estrutura acessível e os detalhes que tornam a primeira impressão confiável.</span></p></article>
        <article class="panel lx-feature-card"><img class="lx-feature-icon" src="/assets/landing-express/launch-handoff.webp" alt="" loading="lazy" decoding="async" /><span class="lx-feature-number">06</span><h3><span class="i18n-en">Launch handoff</span><span class="i18n-pt">Entrega para publicação</span></h3><p><span class="i18n-en">Launch-ready files, clear next steps and optional support after delivery.</span><span class="i18n-pt">Arquivos prontos, próximos passos claros e suporte opcional após a entrega.</span></p></article>
      </div>
    </section>

    <section class="page-section lx-fit-section">
      <div class="shell grid-2 lx-fit-grid">
        <div class="panel panel--pro lx-fit-card">
          <span class="eyebrow"><span class="i18n-en">Built for focused offers</span><span class="i18n-pt">Feita para ofertas focadas</span></span>
          <h2><span class="i18n-en">The right fit for a business that needs clarity now.</span><span class="i18n-pt">O caminho certo para um negócio que precisa de clareza agora.</span></h2>
          <ul class="detail-list">
            <li><span class="i18n-en">A local business that needs more calls, bookings or enquiries.</span><span class="i18n-pt">Um negócio local que precisa de mais chamadas, bookings ou contatos.</span></li>
            <li><span class="i18n-en">A consultant, freelancer or studio launching a focused offer.</span><span class="i18n-pt">Um consultor, freelancer ou estúdio lançando uma oferta focada.</span></li>
            <li><span class="i18n-en">A product or event that needs one page to carry the pitch.</span><span class="i18n-pt">Um produto ou evento que precisa de uma página para sustentar o pitch.</span></li>
          </ul>
        </div>
        <div class="lx-price-card">
          <span class="label label--pro"><span class="i18n-en">Landing Express</span><span class="i18n-pt">Landing Express</span></span>
          <strong class="lx-price"><span class="i18n-en">From £300</span><span class="i18n-pt">A partir de £300</span></strong>
          <p><span class="i18n-en">Final scope is confirmed before work starts. Additional copy, integrations, bilingual setup or complex tooling can be quoted separately.</span><span class="i18n-pt">O escopo final é confirmado antes do início. Copy adicional, integrações, versão bilíngue ou ferramentas complexas podem ser cotados separadamente.</span></p>
          <a class="button button--gold" href={landingBriefHref}><span class="i18n-en">Request your landing</span><span class="i18n-pt">Solicitar minha landing</span></a>
        </div>
      </div>
    </section>

    <section id="process" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">How it runs</span><span class="i18n-pt">Como funciona</span></span>
        <h2><span class="i18n-en">Fast because the decisions stay focused.</span><span class="i18n-pt">Rápida porque as decisões permanecem focadas.</span></h2>
      </div>
      <div class="shell grid-3 lx-process-grid">
        <article class="panel lx-process-card lx-process-card--brief"><img class="lx-process-icon" src="/assets/landing-express/landing-express-icon1.webp" alt="" loading="lazy" decoding="async" /><span>01</span><h3><span class="i18n-en">Brief</span><span class="i18n-pt">Briefing</span></h3><p><span class="i18n-en">You share the offer, audience, assets and the action you want visitors to take.</span><span class="i18n-pt">Você compartilha a oferta, público, ativos e a ação que espera do visitante.</span></p></article>
        <article class="panel lx-process-card lx-process-card--build"><img class="lx-process-icon" src="/assets/landing-express/landing-express-icon4.webp" alt="" loading="lazy" decoding="async" /><span>02</span><h3><span class="i18n-en">Build</span><span class="i18n-pt">Construção</span></h3><p><span class="i18n-en">VOLYNX turns that brief into the page structure, visual direction and responsive build.</span><span class="i18n-pt">A VOLYNX transforma o briefing em estrutura, direção visual e construção responsiva.</span></p></article>
        <article class="panel lx-process-card lx-process-card--launch"><img class="lx-process-icon" src="/assets/landing-express/landing-express-icon5.webp" alt="" loading="lazy" decoding="async" /><span>03</span><h3><span class="i18n-en">Launch</span><span class="i18n-pt">Publicação</span></h3><p><span class="i18n-en">You review the page, approve the final scope and receive the launch-ready handoff.</span><span class="i18n-pt">Você revisa a página, aprova o escopo final e recebe a entrega pronta para publicar.</span></p></article>
      </div>
    </section>

    <section class="page-section lx-faq-section">
      <div class="shell grid-2 lx-faq-grid">
        <div class="section-head"><img class="lx-faq-icon" src="/assets/landing-express/landing-express-icon3.webp" alt="" loading="lazy" decoding="async" /><span class="eyebrow"><span class="i18n-en">Before you start</span><span class="i18n-pt">Antes de começar</span></span><h2><span class="i18n-en">The short version.</span><span class="i18n-pt">A versão curta.</span></h2><p><span class="i18n-en">A focused service should make the next step easy.</span><span class="i18n-pt">Um serviço focado deve tornar o próximo passo simples.</span></p></div>
        <div class="lx-faq-list">
          <details open><summary><span class="i18n-en">Is £300 the final price?</span><span class="i18n-pt">£300 é o preço final?</span></summary><p><span class="i18n-en">It is the starting point for the focused one-page scope. You receive the final scope and price before work begins.</span><span class="i18n-pt">É o ponto de partida para o escopo focado de uma página. Você recebe escopo e preço final antes do início.</span></p></details>
          <details><summary><span class="i18n-en">Can you work with my existing brand?</span><span class="i18n-pt">Vocês conseguem trabalhar com minha marca atual?</span></summary><p><span class="i18n-en">Yes. We can work with existing assets or add a compact visual direction when the page needs more cohesion.</span><span class="i18n-pt">Sim. Podemos trabalhar com seus ativos atuais ou criar uma direção visual compacta quando a página precisar de mais coesão.</span></p></details>
          <details><summary><span class="i18n-en">Can I upgrade later?</span><span class="i18n-pt">Posso ampliar depois?</span></summary><p><span class="i18n-en">Yes. Landing Express can become the first step toward a larger VOLYNX site, brand or integration project.</span><span class="i18n-pt">Sim. A Landing Express pode ser o primeiro passo para um site, marca ou projeto de integração maior com a VOLYNX.</span></p></details>
        </div>
      </div>
    </section>

    <section class="page-section page-section--last">
      <div class="shell lx-final-cta panel panel--pro">
        <img class="lx-final-cta-icon" src="/assets/landing-express/landing-express-icon2.webp" alt="" loading="lazy" decoding="async" />
        <span class="eyebrow"><span class="i18n-en">Your offer deserves a clear first impression</span><span class="i18n-pt">Sua oferta merece uma primeira impressão clara</span></span>
        <h2><span class="i18n-en">Ready to give it a sharper place to land?</span><span class="i18n-pt">Pronto para dar à sua oferta um lugar mais afiado para chegar?</span></h2>
        <p><span class="i18n-en">Send the context and we will confirm the smallest useful scope.</span><span class="i18n-pt">Envie o contexto e confirmaremos o menor escopo útil.</span></p>
        <a class="button button--gold" href={landingBriefHref}><span class="i18n-en">Start Landing Express →</span><span class="i18n-pt">Começar Landing Express →</span></a>
      </div>
    </section>
  </main>

  <FlagshipFooter />
</FlagshipLayout>

<style>
  .page-landing-express .lx-hero { padding: clamp(56px, 8vw, 112px) 0 clamp(42px, 6vw, 78px); }
  .lx-hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(300px, .9fr); gap: clamp(34px, 7vw, 96px); align-items: center; }
  .lx-hero-copy h1 { max-width: 780px; margin: 16px 0 18px; font-size: clamp(2.7rem, 6vw, 6rem); line-height: .98; letter-spacing: -.045em; }
  .lx-hero-desc { max-width: 680px; margin: 0; color: var(--muted, rgba(209,215,230,.74)); font-size: clamp(1rem, 1.45vw, 1.24rem); line-height: 1.65; }
  .lx-proof-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; max-width: 680px; margin-top: 30px; }
  .lx-proof-row > div { display: grid; gap: 3px; padding: 13px 12px; border: 1px solid rgba(255,255,255,.09); border-radius: 15px; background: rgba(255,255,255,.035); }
  .lx-proof-row strong { color: var(--cyan, #8bfaf0); font-size: 1.05rem; }
  .lx-proof-row span { color: var(--muted, rgba(209,215,230,.74)); font-size: .72rem; line-height: 1.35; }
  .lx-hero-visual { position: relative; display: grid; place-items: center; min-height: 470px; isolation: isolate; }
  .lx-hero-visual > img { position: relative; z-index: 2; width: min(100%, 650px); filter: drop-shadow(0 26px 54px rgba(0,0,0,.42)) drop-shadow(0 0 46px rgba(139,250,240,.18)); }
  .lx-orbit { position: absolute; border: 1px solid rgba(139,250,240,.18); border-radius: 50%; transform: rotate(-18deg); pointer-events: none; }
  .lx-orbit--one { width: min(100%, 480px); height: 220px; }
  .lx-orbit--two { width: min(82%, 380px); height: 170px; border-color: rgba(177,150,255,.22); transform: rotate(28deg); }
  .lx-offer-card { position: absolute; z-index: 3; right: 0; bottom: 22px; display: grid; gap: 9px; width: min(260px, 70%); padding: 18px; box-shadow: 0 0 20px 10px rgba(0,0,0,1); backdrop-filter: blur(15px); background: #5e2d75b0; }
  .lx-offer-card strong { font-size: 1.2rem; }
  .lx-offer-price { color: var(--cyan, #8bfaf0); font-size: 1.35rem; font-weight: 750; }
  .lx-offer-note { color: var(--muted, rgba(209,215,230,.74)); font-size: .78rem; line-height: 1.45; }
  .lx-includes-grid, .lx-process-grid { align-items: stretch; }
  .lx-feature-card, .lx-process-card { position: relative; overflow: hidden; }
  .lx-feature-card { min-height: 190px; }
  .lx-feature-icon { display: block; width: min(100%, 250px); height: auto; margin: 0 auto; object-fit: contain; filter: drop-shadow(0 12px 20px rgba(0,0,0,.34)); }
  .lx-feature-number { color: var(--cyan, #8bfaf0); font-size: .75rem; letter-spacing: .12em; }
  .lx-feature-card h3, .lx-process-card h3 { margin: 16px 0 8px; }
  .lx-feature-card p, .lx-process-card p { margin: 0; color: var(--muted, rgba(209,215,230,.74)); line-height: 1.6; font-size: .9rem; }
  .lx-process-card { display: flex; flex-direction: column; min-height: 260px; justify-content: flex-end; padding: 24px; }
  .lx-process-card > span, .lx-process-card > h3, .lx-process-card > p { position: relative; z-index: 1; }
  .lx-process-card > span { color: var(--cyan, #8bfaf0); font-size: .8rem; letter-spacing: .12em; }
  .lx-process-card > h3, .lx-process-card > p { max-width: 62%; background: #ffffff3b; padding: 15px; backdrop-filter: blur(5px); border-radius: 10px; color: white; }
  .lx-process-card > p { position: relative; z-index: 1; }
  .lx-process-icon { position: absolute; z-index: 0; top: -90px; right: -50px; display: block; width: 370px; height: auto; transform: rotate(-15deg); object-fit: contain; pointer-events: none; filter: drop-shadow(0 16px 24px rgba(0,0,0,.42)); opacity: .88; }
  .lx-process-card--build .lx-process-icon { top: -15px; right: -50px; width: 340px; height: auto; transform: rotate(8deg); opacity: .72; }
  .lx-process-card--launch .lx-process-icon { right: -48px; bottom: -40px; width: 330px; height: auto; transform: rotate(-12deg); opacity: .86; }
  .lx-fit-section { padding-top: 120px; }
  .lx-fit-grid { align-items: stretch; }
  .lx-fit-card h2 { margin: 14px 0 18px; }
  .lx-fit-card .detail-list { margin: 0; }
  .lx-price-card { display: grid; align-content: center; gap: 14px; padding: clamp(24px, 4vw, 42px); border: 1px solid rgba(139,250,240,.22); border-radius: var(--radius, 24px); background: radial-gradient(circle at 80% 0%, rgba(139,250,240,.16), transparent 45%), rgba(255,255,255,.04); box-shadow: inset 0 1px 0 rgba(255,255,255,.08), 0 24px 70px rgba(0,0,0,.2); }
  .lx-price { font-size: clamp(2.4rem, 5vw, 4.2rem); line-height: 1; color: var(--cyan, #8bfaf0); }
  .lx-price-card p { margin: 0; color: var(--muted, rgba(209,215,230,.74)); line-height: 1.6; }
  .lx-price-card .button { justify-self: start; }
  .lx-faq-grid { align-items: start; }
  .lx-faq-icon { position: relative; display: block; width: clamp(210px, 60vw, 430px); height: auto; margin: -90px auto; object-fit: contain; transform: rotate(-10deg) translateX(-150px); filter: drop-shadow(0 18px 26px rgba(0,0,0,.38)); opacity: .9; z-index: -4; }
  .lx-faq-list { display: grid; gap: 10px; }
  .lx-faq-list details { border: 1px solid rgba(255,255,255,.09); border-radius: 16px; padding: 0 18px; background: rgba(255,255,255,.035); }
  .lx-faq-list details[open] { border-color: rgba(139,250,240,.22); background: rgba(139,250,240,.045); }
  .lx-faq-list summary { position: relative; cursor: pointer; list-style: none; padding: 17px 26px 17px 0; font-weight: 650; }
  .lx-faq-list summary::-webkit-details-marker { display: none; }
  .lx-faq-list summary::after { content: "+"; position: absolute; right: 0; top: 14px; color: var(--cyan, #8bfaf0); font-size: 1.2rem; }
  .lx-faq-list details[open] summary::after { content: "−"; }
  .lx-faq-list p { margin: -2px 0 18px; color: var(--muted, rgba(209,215,230,.74)); line-height: 1.6; font-size: .9rem; }
  .lx-final-cta { position: relative; isolation: isolate; overflow: hidden; display: grid; justify-items: center; gap: 14px; padding: clamp(30px, 5vw, 58px); text-align: center; background: radial-gradient(circle at 50% 0%, rgba(139,250,240,.14), transparent 50%), linear-gradient(135deg, rgba(255,255,255,.07), rgba(255,255,255,.025)); border-color: rgba(139,250,240,.2); }
  .lx-final-cta > :not(.lx-final-cta-icon) { position: relative; z-index: 1; }
  .lx-final-cta-icon { position: absolute; z-index: 0; right: clamp(-22px, 0vw, -20px); bottom: clamp(-100px, -80vw, -50px); width: clamp(250px, 100vw, 460px); height: auto; object-fit: contain; transform: rotate(20deg); filter: drop-shadow(0 20px 30px rgba(0,0,0,.52)); opacity: .72; pointer-events: none; }
  .lx-final-cta h2 { max-width: 800px; margin: 0; }
  .lx-final-cta p { margin: 0; color: var(--muted, rgba(209,215,230,.74)); }
  @media (max-width: 900px) {
    .lx-hero-grid { grid-template-columns: 1fr; }
    .lx-hero-visual { min-height: 380px; }
    .lx-hero-copy { text-align: center; }
    .lx-hero-copy .hero-actions, .lx-proof-row { justify-content: center; margin-inline: auto; }
    .lx-hero-desc { margin-inline: auto; }
  }
  @media (max-width: 767px) {
    .page-landing-express .lx-hero { padding-top: 30px; }
    .lx-hero-copy h1 { font-size: clamp(2.45rem, 12vw, 4rem); }
    .lx-proof-row { grid-template-columns: 1fr; max-width: 280px; }
    .lx-hero-visual { min-height: 330px; }
    .lx-hero-visual > img { width: min(62%, 240px); }
    .lx-offer-card { right: 2%; bottom: 4px; width: min(235px, 72%); }
    .lx-orbit--one { height: 170px; }
    .lx-orbit--two { height: 130px; }
    .lx-process-card { min-height: 235px; }
    .lx-process-card--brief .lx-process-icon { width: 138px; height: 132px; top: -16px; right: -18px; }
    .lx-process-card--build .lx-process-icon { width: 158px; height: 140px; top: 0; right: -22px; }
    .lx-process-card--launch .lx-process-icon { width: 132px; height: 142px; right: -14px; bottom: -30px; }
    .lx-faq-icon { width: 156px; height: auto; margin: -12px auto -12px 0; transform: rotate(-8deg) translateX(-8px); z-index: 0; }
    .lx-final-cta-icon { right: -30px; bottom: -28px; width: 142px; height: auto; transform: rotate(12deg); opacity: .5; }
    .lx-price-card .button { width: 100%; text-align: center; }
  }
  @media (min-width: 768px) {
    .lx-feature-icon { width: min(100%, 400px); height: 350px; margin: -80px auto -20px; transform: rotate(15deg) translateX(130px); }
  }
</style>
