---
import BaseLayout from "../layouts/BaseLayout.astro";
import VxHeader from "../components/VxHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = "Changelog — VOLYNX";
---

<BaseLayout title={title}>
  <VxHeader />

  <main class="shell changelog">
    <section class="hero">
      <h1 data-i18n="changelog.title">Changelog</h1>
      <p class="sub" data-i18n="changelog.subtitle">What’s new. Updates, improvements, and releases.</p>
    </section>

    <section class="timeline">
      <article class="entry">
        <div class="meta">
          <span class="tag" data-i18n="changelog.r1_tag">Release</span>
          <time datetime="2026-02-24">2026-02-24</time>
        </div>
        <h2 data-i18n="changelog.r1_title">Platform deployed on Cloudflare Pages</h2>
        <ul>
          <li data-i18n="changelog.r1_item1">Astro static build stabilized</li>
          <li data-i18n="changelog.r1_item2">Routing cleanup for Lab/Studio</li>
          <li data-i18n="changelog.r1_item3">Asset weight reduced (public cleanup)</li>
        </ul>
      </article>

      <article class="entry">
        <div class="meta">
          <span class="tag" data-i18n="changelog.r2_tag">Update</span>
          <time datetime="2026-02-20">2026-02-20</time>
        </div>
        <h2 data-i18n="changelog.r2_title">Volynx Lab tools lineup</h2>
        <ul>
          <li data-i18n="changelog.r2_item1">Converter</li>
          <li data-i18n="changelog.r2_item2">Image Scaler</li>
          <li data-i18n="changelog.r2_item3">iMage Suite</li>
          <li data-i18n="changelog.r2_item4">QR Generator</li>
        </ul>
      </article>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  @import "../styles/legal.css";
  @import "../styles/services.css";

  .changelog .hero { padding: 48px 0 22px; }
  .changelog .sub { opacity: .85; max-width: 65ch; }

  .timeline { display: grid; gap: 14px; padding: 10px 0 70px; }
  .entry {
    border-radius: 22px;
    padding: 18px 18px 14px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(10,12,20,.45);
  }
  .meta {
    display: flex; justify-content: space-between; align-items: center;
    opacity: .85; margin-bottom: 10px;
  }
  .tag {
    display: inline-flex; padding: 6px 10px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,.14);
    font-size: 12px;
  }
  .entry h2 { margin: 0 0 10px; }
  .entry ul { margin: 0; padding-left: 18px; opacity: .9; }
  .entry li { padding: 4px 0; }
</style>