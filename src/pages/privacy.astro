---
import LegalLayout from "../layouts/LegalLayout.astro";
---

<LegalLayout
  title="Privacy Policy • Volynx"
  description="Volynx privacy policy: what we collect, why, and how you control your data."
>
  <div class="kicker" data-i18n="legal.kicker">Legal</div>
  <h1 data-i18n="priv.title">Privacy Policy</h1>
  <p data-i18n-html="priv.intro">This policy explains how Volynx collects, uses, and protects your personal data when you use our website, tools, and digital products at <strong>volynx.world</strong>.</p>

  <h2 data-i18n="priv.collect_title">What we collect</h2>
  <ul>
    <li data-i18n-html="priv.collect_account"><strong>Account data</strong> — name and email address when you create an account or sign in via Supabase Auth.</li>
    <li data-i18n-html="priv.collect_payment"><strong>Payment data</strong> — billing information processed securely by Stripe. Volynx never stores card numbers directly.</li>
    <li data-i18n-html="priv.collect_usage"><strong>Usage data</strong> — pages visited, tool interactions, and device/browser information for performance and analytics purposes.</li>
    <li data-i18n-html="priv.collect_contact"><strong>Contact data</strong> — messages and information you submit through our contact form (processed via Formspree).</li>
    <li data-i18n-html="priv.collect_cookies"><strong>Cookies</strong> — essential session cookies for authentication and optional analytics cookies.</li>
  </ul>

  <h2 data-i18n="priv.why_title">Why we collect it</h2>
  <ul>
    <li data-i18n="priv.why_account">To create and manage your account and authenticate sessions</li>
    <li data-i18n="priv.why_purchases">To process purchases of digital products, icon packs, kits, and subscriptions</li>
    <li data-i18n="priv.why_tools">To deliver and improve our web tools (image processing, QR generator, converters)</li>
    <li data-i18n="priv.why_support">To respond to support and sales inquiries</li>
    <li data-i18n="priv.why_legal">To comply with legal and financial obligations</li>
  </ul>

  <h2 data-i18n="priv.third_title">Third-party services</h2>
  <ul>
    <li data-i18n-html="priv.third_supabase"><strong>Supabase</strong> — authentication and database hosting (EU infrastructure)</li>
    <li data-i18n-html="priv.third_stripe"><strong>Stripe</strong> — payment processing. Subject to <a href="https://stripe.com/privacy" target="_blank" rel="noopener">Stripe's Privacy Policy</a>.</li>
    <li data-i18n-html="priv.third_formspree"><strong>Formspree</strong> — contact form processing</li>
    <li data-i18n-html="priv.third_cloudflare"><strong>Cloudflare Pages</strong> — website hosting and CDN</li>
  </ul>

  <h2 data-i18n="priv.cookies_title">Cookies</h2>
  <p data-i18n="priv.cookies_desc">We use essential cookies to keep you logged in and maintain session state. We may also use anonymous analytics cookies to understand usage patterns. You can disable non-essential cookies in your browser settings at any time.</p>

  <h2 data-i18n="priv.retention_title">Data retention</h2>
  <p data-i18n="priv.retention_desc">Account data is retained while your account is active. You may request deletion at any time. Payment records are retained as required by applicable financial regulations.</p>

  <h2 data-i18n="priv.rights_title">Your rights</h2>
  <ul>
    <li data-i18n="priv.rights_access">Request access to, correction, or deletion of your personal data</li>
    <li data-i18n="priv.rights_consent">Withdraw consent for marketing communications at any time</li>
    <li data-i18n="priv.rights_complaint">Lodge a complaint with your local data protection authority</li>
  </ul>

  <h2 data-i18n="priv.contact_title">Contact</h2>
  <p data-i18n-html="priv.contact_desc">For privacy requests: <a href="mailto:hello@volynx.world">hello@volynx.world</a></p>
  <p class="meta" data-i18n="priv.updated">Last updated: {new Date().toISOString().slice(0, 10)}</p>
</LegalLayout>
