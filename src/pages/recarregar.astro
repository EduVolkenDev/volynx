---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../components/FlagshipHeader.astro";
import FlagshipFooter from "../components/FlagshipFooter.astro";
import { ROUTES } from "../data/routes";
import { sitePricing } from "../data/pricing";

const lang = Astro.url.searchParams.get('lang') === 'en' ? 'en' : 'pt';
const currencyParam = Astro.url.searchParams.get('currency') || 'BRL';
const currency = (['GBP', 'EUR', 'BRL'] as const).includes(currencyParam as any) ? (currencyParam as 'GBP'|'EUR'|'BRL') : 'BRL';
const tokenPackById = Object.fromEntries(sitePricing.tokenPacks.map((pack) => [pack.id, pack]));
const getPackAmount = (id: string) => tokenPackById[id]?.amount || 0;
const getPackPrice = (id: string) => tokenPackById[id]?.price[currency] || '';

// Enriched packages with bonus/emotional copy
const packs = [
  {
    id: 'starter',
    bonus: { pt: '', en: '' },
    tagline: { pt: 'Primeiro passo', en: 'First step' },
    desc: { pt: 'Para testar sem compromisso.', en: 'Try without committing.' }
  },
  {
    id: 'core',
    priceOriginal: { GBP: '£28', EUR: '€33', BRL: 'R$189' },
    bonus: { pt: '+20% VX extra', en: '+20% extra VX' },
    tagline: { pt: 'Mais popular', en: 'Most popular' },
    desc: { pt: 'O sweet spot da plataforma.', en: 'The platform sweet spot.' },
    featured: true
  },
  {
    id: 'pro',
    priceOriginal: { GBP: '£68', EUR: '€79', BRL: 'R$449' },
    bonus: { pt: '+30% VX + badge Power User', en: '+30% VX + Power User badge' },
    tagline: { pt: 'Melhor custo', en: 'Best value' },
    desc: { pt: 'Para quem usa todos os dias.', en: 'For daily power users.' }
  },
  {
    id: 'scale',
    bonus: { pt: 'Diamond perks + prioridade', en: 'Diamond perks + priority' },
    tagline: { pt: 'Whale', en: 'Whale tier' },
    desc: { pt: 'Operação pesada sem fricção.', en: 'Heavy operation, zero friction.' }
  }
];

const t = {
  pt: {
    pill: 'Adicione VX com bônus',
    title: 'Adicione VX',
    titleAccent: 'e acelere',
    subtitle: 'Quanto mais você usa, mais rápido você cresce. Cada pack tem bônus exclusivo e Pix instantâneo.',
    ofYourChoice: 'packs premium',
    pixBadge: '⚡ Pix instantâneo',
    stripeBadge: 'Cartão internacional',
    tokens: 'VX',
    each: 'cada',
    buyPix: 'Comprar com Pix',
    buyCard: 'Comprar com cartão',
    trustBilling: '✓ Cobrança segura',
    trustInstant: '✓ Crédito instantâneo',
    trustNoExpiry: '✓ VX nunca expira',
    footerNote: 'Todos os packs incluem Power User badge quando você acumula 100+ VX. Um único saldo aparece na conta e funciona nas áreas com VX habilitado.',
    from: 'Era',
    currencyLabel: 'Moeda',
    currencyHint: 'Escolha a moeda para cartão. Pix fica em BRL.',
  },
  en: {
    pill: 'Add VX with bonus',
    title: 'Add VX',
    titleAccent: 'and scale',
    subtitle: 'The more you use, the faster you grow. Every pack ships with an exclusive bonus and instant Pix.',
    ofYourChoice: 'premium packs',
    pixBadge: '⚡ Instant Pix',
    stripeBadge: 'International card',
    tokens: 'VX',
    each: 'each',
    buyPix: 'Buy with Pix',
    buyCard: 'Buy with card',
    trustBilling: '✓ Secure billing',
    trustInstant: '✓ Instant credit',
    trustNoExpiry: '✓ VX never expires',
    footerNote: 'Every pack includes a Power User badge when you reach 100+ VX. One balance appears in your account and works in VX-enabled areas.',
    from: 'Was',
    currencyLabel: 'Currency',
    currencyHint: 'Choose card currency. Pix stays in BRL.',
  }
};
const L = t[lang];
---
<FlagshipLayout title="Comprar VX — VOLYNX" description="Adicione VX com Pix instantâneo ou cartão. Bônus exclusivos em cada pack." pageClass="page-recarregar">
  <script is:inline>
    /* Sync ?lang= URL param with global volynx_lang in localStorage.
       This page is SSR'd per-language, so a mismatch must trigger a reload. */
    (function () {
      function getStored() {
        try {
          var raw = localStorage.getItem('volynx_lang');
          if (!raw) return null;
          var v = String(raw).toLowerCase();
          if (v.indexOf('pt') === 0) return 'pt';
          if (v.indexOf('en') === 0) return 'en';
        } catch (_) {}
        return null;
      }
      function syncUrl(lang) {
        try {
          var url = new URL(location.href);
          if (url.searchParams.get('lang') === lang) return;
          url.searchParams.set('lang', lang);
          location.replace(url.toString());
        } catch (_) {}
      }
      var pref = getStored();
      if (pref) syncUrl(pref);
      window.addEventListener('vx:lang-changed', function (e) {
        var lang = e && e.detail && e.detail.lang;
        if (lang === 'pt' || lang === 'en') syncUrl(lang);
      });
    })();
  </script>
  <FlagshipHeader current={ROUTES.pricing} ctaLabel={L.buyCard} />
  <main>

    <section class="rec-hero">
      <div class="rec-bg" aria-hidden="true"></div>
      <div class="shell rec-hero-inner">
        <div class="rec-hero-grid">
          <div class="rec-hero-copy">
            <div class="rec-pill">
              <span class="rec-pill-dot"></span>
              <span>{L.pill}</span>
            </div>
            <h1 class="rec-title">
              {L.title}<br />
              <span class="gradient-text">{L.titleAccent}</span>
            </h1>
            <p class="rec-subtitle">{L.subtitle}</p>

            <div class="rec-methods">
              <span class="rec-method-pill rec-method-pill--pix">{L.pixBadge}</span>
              <span class="rec-method-pill">{L.stripeBadge}</span>
            </div>
          </div>
          <div class="hero-visual hero-visual--float rec-hero-visual" aria-hidden="true">
            <img src="/assets/vxsystem.webp" alt="" class="rec-hero-icon" width="1536" height="1536" loading="eager" />
          </div>
        </div>
      </div>
    </section>

    <section class="shell rec-currency-shell" aria-label={L.currencyLabel}>
      <div class="rec-currency-bar">
        <div class="rec-currency-copy">
          <span class="rec-currency-label">{L.currencyLabel}</span>
          <span class="rec-currency-hint">{L.currencyHint}</span>
        </div>
        <div class="rec-currency-pills">
          {(['BRL', 'GBP', 'EUR'] as const).map((c) => (
            <button
              type="button"
              class={`rec-currency-pill ${c === currency ? 'rec-currency-pill--active' : ''}`}
              data-rec-currency={c}
              aria-pressed={c === currency ? 'true' : 'false'}
            >
              <span>{c === 'GBP' ? '£' : c === 'EUR' ? '€' : 'R$'}</span>
              <strong>{c}</strong>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="shell rec-packs">
      {packs.map((pack, i) => (
        <article class={`rec-card${pack.featured ? ' rec-card--featured' : ''}`} data-pack-id={`tokens_${pack.id}`}>
          {pack.featured && <span class="rec-card-ribbon">{L.ofYourChoice}</span>}
          <div class="rec-card-top">
            <div>
              <span class="rec-card-tag">{pack.tagline[lang]}</span>
              <h3 class="rec-card-amount">{getPackAmount(pack.id)} <span class="rec-card-amount-unit">{L.tokens}</span></h3>
              <p class="rec-card-desc">{pack.desc[lang]}</p>
            </div>
            <div class="rec-card-price">
              {pack.priceOriginal && (
                <span
                  class="rec-card-price-original"
                  data-rec-price-original
                  data-price-gbp={pack.priceOriginal.GBP}
                  data-price-eur={pack.priceOriginal.EUR}
                  data-price-brl={pack.priceOriginal.BRL}
                >
                  {L.from} {pack.priceOriginal[currency]}
                </span>
              )}
              <div
                class="rec-card-price-current"
                data-rec-price
                data-price-gbp={tokenPackById[pack.id]?.price.GBP}
                data-price-eur={tokenPackById[pack.id]?.price.EUR}
                data-price-brl={tokenPackById[pack.id]?.price.BRL}
              >
                {getPackPrice(pack.id)}
              </div>
              {pack.bonus[lang] && <span class="rec-card-bonus">🎁 {pack.bonus[lang]}</span>}
            </div>
          </div>

          <div class={`rec-card-actions ${currency !== 'BRL' ? 'rec-card-actions--single' : ''}`}>
            <button class={`rec-btn rec-btn--pix ${currency !== 'BRL' ? 'rec-btn--hidden' : ''}`} data-buy-pix={`tokens_${pack.id}_brl`} type="button">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M17.7 6.3c-1.2-1.2-2.8-1.8-4.5-1.8s-3.3.6-4.5 1.8L5.4 9.6l2.1 2.1 3.3-3.3c.6-.6 1.4-.9 2.4-.9s1.8.3 2.4.9l3.3 3.3 2.1-2.1-3.3-3.3z" fill="currentColor"/><path d="M6.3 17.7c1.2 1.2 2.8 1.8 4.5 1.8s3.3-.6 4.5-1.8l3.3-3.3-2.1-2.1-3.3 3.3c-.6.6-1.4.9-2.4.9s-1.8-.3-2.4-.9l-3.3-3.3-2.1 2.1 3.3 3.3z" fill="currentColor"/></svg>
              {L.buyPix}
            </button>
            <button class="rec-btn rec-btn--card" data-buy-card-base={`tokens_${pack.id}`} data-buy-card={`tokens_${pack.id}_${currency.toLowerCase()}`} type="button">
              {L.buyCard}
            </button>
          </div>
        </article>
      ))}
    </section>

    <section class="shell rec-trust">
      <div class="rec-trust-item">
        <div class="rec-trust-icon">✓</div>
        <div>
          <strong>{L.trustBilling}</strong>
          <p>{lang === 'pt' ? 'Cartoes e Pix via Stripe. Fluxo seguro com verificacao automatica.' : 'Cards and Pix via Stripe. Secure flow with automated verification.'}</p>
        </div>
      </div>
      <div class="rec-trust-item">
        <div class="rec-trust-icon">⚡</div>
        <div>
          <strong>{L.trustInstant}</strong>
          <p>{lang === 'pt' ? 'Seu VX aparece no saldo em segundos via webhook.' : 'VX appears in your balance in seconds via webhook.'}</p>
        </div>
      </div>
      <div class="rec-trust-item">
        <div class="rec-trust-icon">♾️</div>
        <div>
          <strong>{L.trustNoExpiry}</strong>
          <p>{lang === 'pt' ? 'Compre agora, use quando quiser. Saldo acumula sem validade.' : 'Buy now, use whenever. Balance never expires.'}</p>
        </div>
      </div>
    </section>

    <p class="shell rec-footer-note">{L.footerNote}</p>

  </main>
  <FlagshipFooter />

  <!-- Pix checkout helper -->
  <script is:inline src="/js/vx-pix.js"></script>

  <script is:inline>
    (function() {
      var token = localStorage.getItem('volynx_access_token') || '';
      var cfg = null;
      var checkoutLoadingLabel = (localStorage.getItem('volynx_lang') === 'en' ? 'Opening checkout…' : 'Abrindo checkout…');
      var validCurrencies = ['BRL', 'GBP', 'EUR'];

      function normalizeCurrency(value) {
        var code = String(value || 'BRL').toUpperCase();
        return validCurrencies.indexOf(code) !== -1 ? code : 'BRL';
      }

      function currentCurrency() {
        var fromUrl = new URLSearchParams(window.location.search).get('currency');
        var fromStorage = '';
        try { fromStorage = localStorage.getItem('volynx_currency') || ''; } catch {}
        return normalizeCurrency(fromUrl || fromStorage || 'BRL');
      }

      function loginHref() {
        return '/login/?next=' + encodeURIComponent('/recarregar/?currency=' + currentCurrency());
      }

      function priceFor(el, code) {
        return el.getAttribute('data-price-' + code.toLowerCase()) || '';
      }

      function applyCurrency(code) {
        var target = normalizeCurrency(code);
        try { localStorage.setItem('volynx_currency', target); } catch {}

        document.querySelectorAll('[data-rec-currency]').forEach(function(btn) {
          var active = btn.getAttribute('data-rec-currency') === target;
          btn.classList.toggle('rec-currency-pill--active', active);
          btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        document.querySelectorAll('[data-rec-price]').forEach(function(el) {
          var price = priceFor(el, target);
          if (price) el.textContent = price;
        });
        document.querySelectorAll('[data-rec-price-original]').forEach(function(el) {
          var price = priceFor(el, target);
          if (price) {
            var prefix = el.textContent.trim().split(/\s+/)[0] || '';
            el.textContent = prefix + ' ' + price;
          }
        });
        document.querySelectorAll('[data-buy-card-base]').forEach(function(btn) {
          var base = btn.getAttribute('data-buy-card-base');
          if (base) btn.setAttribute('data-buy-card', base + '_' + target.toLowerCase());
        });
        document.querySelectorAll('.rec-card-actions').forEach(function(actions) {
          actions.classList.toggle('rec-card-actions--single', target !== 'BRL');
        });
        document.querySelectorAll('[data-buy-pix]').forEach(function(btn) {
          btn.classList.toggle('rec-btn--hidden', target !== 'BRL');
        });

        var url = new URL(window.location.href);
        url.searchParams.set('currency', target);
        history.replaceState(null, '', url.toString());
      }

      applyCurrency(currentCurrency());

      document.querySelectorAll('[data-rec-currency]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          applyCurrency(btn.getAttribute('data-rec-currency') || 'BRL');
        });
      });

      // Load config
      fetch('/config.json', { cache: 'no-store' }).then(function(r) { return r.json(); }).then(function(c) { cfg = c; }).catch(function(){});

      // Pix buttons
      document.querySelectorAll('[data-buy-pix]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          if (!token) { window.location.href = loginHref(); return; }
          var lookup = btn.getAttribute('data-buy-pix');
          if (!lookup || !window.VxPix) return;
          window.VxPix.checkout(lookup, {
            successUrl: window.location.origin + '/account/?payment=pix_success',
            cancelUrl: window.location.origin + '/recarregar/?payment=cancelled',
          });
        });
      });

      // Card (Stripe) buttons
      document.querySelectorAll('[data-buy-card]').forEach(function(btn) {
        btn.addEventListener('click', async function(e) {
          e.preventDefault();
          if (!token) { window.location.href = loginHref(); return; }
          if (!cfg) cfg = await fetch('/config.json', { cache: 'no-store' }).then(function(r){return r.json();});
          var apiBase = (cfg.functionsUrl || '').replace(/\/$/, '');
          if (!apiBase) return;
          var lookup = btn.getAttribute('data-buy-card');
          btn.disabled = true;
          btn.setAttribute('aria-busy', 'true');
          var orig = btn.textContent;
          btn.textContent = checkoutLoadingLabel;
          try {
            var res = await fetch(apiBase + '/create-checkout-session', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
              body: JSON.stringify({
                lookup_key: lookup,
                success_url: window.location.origin + '/account/?recarga=sucesso',
                cancel_url: window.location.href
              })
            });
            var data = await res.json();
            if (data.url) window.location.href = data.url;
            else { alert(data.error || 'Checkout failed'); btn.textContent = orig; btn.disabled = false; btn.removeAttribute('aria-busy'); }
          } catch (err) { btn.textContent = orig; btn.disabled = false; btn.removeAttribute('aria-busy'); }
        });
      });

      // Confetti on successful return from Stripe
      if (window.location.search.indexOf('recarga=sucesso') !== -1) {
        setTimeout(function() {
          if (window.VxGame) window.VxGame.triggerConfetti();
        }, 500);
      }
    })();
  </script>

  <style>
    .page-recarregar { background: #09090b; }

    .rec-hero {
      position: relative;
      padding: clamp(60px, 10vh, 120px) 0 clamp(40px, 6vh, 80px);
      overflow: hidden;
      text-align: center;
    }
    .rec-bg {
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 70% 60% at 50% 30%, rgba(45, 212, 191, 0.18), transparent 60%),
        radial-gradient(ellipse 50% 40% at 80% 100%, rgba(59, 130, 246, 0.1), transparent 70%);
      pointer-events: none;
      z-index: 0;
    }
    .rec-hero-inner {
      position: relative;
      z-index: 2;
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 20px;
    }
    .rec-hero-grid {
      display: grid;
      gap: clamp(24px, 4vw, 56px);
      align-items: center;
    }
    .rec-hero-copy {
      max-width: 720px;
      margin: 0 auto;
    }
    .rec-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 16px;
      border-radius: 999px;
      background: rgba(45, 212, 191, 0.08);
      border: 1px solid rgba(45, 212, 191, 0.28);
      color: #5eead4;
      font-size: .82rem;
      font-weight: 700;
      margin-bottom: 24px;
    }
    .rec-pill-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: #2dd4bf;
      box-shadow: 0 0 8px #2dd4bf;
      animation: recPulse 2s infinite;
    }
    @keyframes recPulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: .4; transform: scale(.85); }
    }

    .rec-title {
      font-family: var(--display, 'Orbitron', sans-serif);
      font-size: clamp(2.2rem, 6vw, 4rem);
      font-weight: 700;
      letter-spacing: -.035em;
      line-height: 1.05;
      margin: 0 0 20px;
      color: #fff;
    }
    .rec-title .gradient-text {
      background: linear-gradient(135deg, #2dd4bf, #22d3ee, #3b82f6);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
    .rec-subtitle {
      font-size: clamp(1rem, 1.7vw, 1.14rem);
      color: rgba(209, 215, 230, 0.72);
      max-width: 54ch;
      margin: 0 auto 24px;
      line-height: 1.6;
    }
    .rec-methods {
      display: inline-flex;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .rec-method-pill {
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      font-size: .82rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.7);
    }
    .rec-method-pill--pix {
      background: rgba(45, 212, 191, 0.1);
      border-color: rgba(45, 212, 191, 0.35);
      color: #5eead4;
    }
    .rec-currency-shell {
      max-width: 760px;
      padding: 0 20px;
      margin-top: -8px;
    }
    .rec-currency-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 14px;
      border-radius: 22px;
      border: 1px solid rgba(255,255,255,.08);
      background:
        radial-gradient(circle at 0% 0%, rgba(45,212,191,.16), transparent 34%),
        rgba(255,255,255,.035);
      box-shadow: 0 18px 42px rgba(0,0,0,.24);
    }
    .rec-currency-copy {
      display: grid;
      gap: 3px;
      text-align: left;
    }
    .rec-currency-label {
      color: #fff;
      font-size: .84rem;
      font-weight: 850;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .rec-currency-hint {
      color: rgba(209, 215, 230, .55);
      font-size: .78rem;
      line-height: 1.35;
    }
    .rec-currency-pills {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      min-width: min(360px, 48vw);
    }
    .rec-currency-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      min-height: 42px;
      padding: 9px 12px;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,.1);
      background: rgba(255,255,255,.045);
      color: rgba(255,255,255,.72);
      cursor: pointer;
      font: inherit;
      transition: transform .18s ease, border-color .18s ease, background .18s ease, color .18s ease;
    }
    .rec-currency-pill:hover {
      transform: translateY(-1px);
      border-color: rgba(45,212,191,.35);
      background: rgba(45,212,191,.08);
      color: #fff;
    }
    .rec-currency-pill span {
      display: grid;
      place-items: center;
      width: 22px;
      height: 22px;
      border-radius: 999px;
      background: rgba(255,255,255,.08);
      font-weight: 900;
    }
    .rec-currency-pill strong {
      font-size: .8rem;
      letter-spacing: .05em;
    }
    .rec-currency-pill--active {
      border-color: rgba(45,212,191,.55);
      background: linear-gradient(135deg, rgba(45,212,191,.22), rgba(34,211,238,.12));
      color: #fff;
      box-shadow: 0 10px 28px rgba(45,212,191,.13);
    }
    .rec-hero-visual {
      display: none;
      min-height: clamp(280px, 28vw, 440px);
      justify-items: end;
      overflow: visible;
      pointer-events: none;
    }
    .rec-hero-icon {
      width: min(100%, 380px);
      height: auto;
      aspect-ratio: 1 / 1;
      object-fit: contain;
      max-width: none;
      margin: 0 -8px -8px 0;
      filter: drop-shadow(0 32px 80px rgba(0,0,0,.48));
    }

    /* ── Pack cards ── */
    .rec-packs {
      display: grid;
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 40px 20px 60px;
      max-width: 760px;
    }
    @media (min-width: 768px) {
      .rec-packs { gap: 22px; padding: 60px 20px 80px; }
    }

    .rec-card {
      position: relative;
      background: linear-gradient(180deg, #18181b, #09090b);
      border: 1px solid rgba(244, 244, 245, 0.08);
      border-radius: 28px;
      padding: 28px;
      transition: border-color .25s, transform .25s, box-shadow .25s;
    }
    .rec-card:hover {
      border-color: rgba(45, 212, 191, 0.35);
      transform: translateY(-2px);
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5), 0 0 40px rgba(45, 212, 191, 0.08);
    }
    .rec-card--featured {
      border-color: rgba(45, 212, 191, 0.4);
      box-shadow: 0 20px 60px rgba(45, 212, 191, 0.12), 0 0 0 1px rgba(45, 212, 191, 0.2);
    }
    .rec-card-ribbon {
      position: absolute;
      top: -12px;
      left: 28px;
      background: linear-gradient(135deg, #2dd4bf, #22d3ee);
      color: #09090b;
      padding: 5px 14px;
      border-radius: 999px;
      font-size: .72rem;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
