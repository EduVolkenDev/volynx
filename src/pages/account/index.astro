---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";
---
<FlagshipLayout title="Command Center — VOLYNX" description="Your Pro workspace: plan usage, presets, brand memory and quick access to tools." pageClass="page-account">
  <FlagshipHeader ctaLabel="Manage plan" />
  <main>

    <!-- ═══ COMMAND CENTER ═══ -->
    <section class="hero account-hero">
      <div class="shell command-grid">
        <div class="overview panel panel--pro">
          <span class="label label--pro" id="planBadge">Studio Pro</span>
          <h1>Pro Command Center</h1>
          <p>Your account surface feels like a cockpit: stronger hierarchy, workflow memory, plan clarity and quick access to serious tools.</p>
          <div class="stats-row">
            <div class="stat-block"><b id="tokenPercent">—</b><span>token reserve</span></div>
            <div class="stat-block"><b id="presetCount">—</b><span>saved presets</span></div>
            <div class="stat-block"><b id="brandCount">—</b><span>brand profiles</span></div>
            <div class="stat-block"><b id="projectCount">—</b><span>projects</span></div>
          </div>
        </div>
        <div class="stack" style="display:grid;gap:16px;">
          <div class="panel">
            <span class="label">Plan usage</span>
            <div class="split-header"><h3>Monthly usage</h3><span id="usageLabel">— / —</span></div>
            <div class="progress"><span id="usageBar" style="width:0%"></span></div>
          </div>
          <div class="panel">
            <span class="label">Quick actions</span>
            <ul class="detail-list">
              <li><a href={ROUTES.studioConverter} style="color:var(--text);">Open Converter Pro</a></li>
              <li><a href={ROUTES.studioImageSuite} style="color:var(--text);">Open Image Suite</a></li>
              <li><a href={ROUTES.builder} style="color:var(--text);">Open Builder</a></li>
              <li><a href={ROUTES.profile} style="color:var(--text);">Edit profile</a></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ FAVORITES & HISTORY ═══ -->
    <section class="page-section">
      <div class="shell grid-3">
        <article class="panel">
          <span class="label label--pro">Favorites</span>
          <h3>Fast access to premium tools</h3>
          <p>Converter Pro, Image Suite and Builder Pro — one tap away from your most-used workflows.</p>
          <div class="actions" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:16px;">
            <a href={ROUTES.studioConverter} class="button button--ghost">Converter</a>
            <a href={ROUTES.studioImageScaler} class="button button--ghost">Scaler</a>
            <a href={ROUTES.studioQrGen} class="button button--ghost">QR Gen</a>
          </div>
        </article>
        <article class="panel">
          <span class="label">History</span>
          <h3>Recent outputs</h3>
          <p>Processing history makes the Pro layer feel trustworthy and production ready. Your last exports are always available.</p>
        </article>
        <article class="panel">
          <span class="label">Brand Memory</span>
          <h3>Saved defaults</h3>
          <p>Colors, export settings and naming rules reduce repetition for serious users. Pro reduces friction, not just limits.</p>
        </article>
      </div>
    </section>

    <!-- ═══ PLAN CTA ═══ -->
    <section class="page-section page-section--last">
      <div class="shell callout panel panel--pro">
        <div>
          <span class="label label--pro">Your plan</span>
          <strong>Upgrade, manage or explore what Pro unlocks.</strong>
          <p>The Command Center is where Pro status translates into real workflow advantages.</p>
        </div>
        <div class="hero-actions">
          <a href={ROUTES.pricing} class="button button--gold">Manage plan</a>
          <a href={ROUTES.profile} class="button button--ghost">Edit profile</a>
          <button type="button" id="logoutBtn" class="button button--ghost" style="border-color:rgba(255,100,100,.2);color:rgba(255,150,150,.9);">Sign out</button>
        </div>
      </div>
    </section>

  </main>
  <FlagshipFooter />

  <script is:inline type="module">
    // Redirect if not logged in
    const token = localStorage.getItem('volynx_access_token');
    if (!token) { window.location.href = '/login/?next=/account/'; }

    // Load plan info
    let cfg = null;
    try { cfg = await fetch('/config.json', { cache: 'no-store' }).then(r => r.json()); } catch {}
    const apiBase = (cfg?.apiBaseUrl || '').replace(/\/$/, '');

    if (token && apiBase) {
      try {
        const res = await fetch(apiBase + '/api/check-permission', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
          body: JSON.stringify({ tool: 'converter' }),
        });
        if (res.ok) {
          const perm = await res.json();
          const plan = perm.builderPlan || perm.plan || 'free';
          const badge = document.getElementById('planBadge');
          if (badge) badge.textContent = plan === 'free' ? 'Free' : plan.charAt(0).toUpperCase() + plan.slice(1);
        }
      } catch {}
    }

    // Logout
    document.getElementById('logoutBtn')?.addEventListener('click', () => {
      localStorage.removeItem('volynx_access_token');
      localStorage.removeItem('volynx_refresh_token');
      window.location.href = '/login/';
    });
  </script>
</FlagshipLayout>

<style>
  .account-hero{ padding-top: clamp(28px, 5vw, 52px); }
</style>
