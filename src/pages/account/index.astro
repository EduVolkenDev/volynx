---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";
---
<FlagshipLayout title="Command Center — VOLYNX" description="Your Pro workspace: plan usage, presets, brand memory and quick access to tools." pageClass="page-account">
  <FlagshipHeader ctaLabel="Manage plan" />
  <main>

    <!-- ═══ COMMAND CENTER ═══ -->
    <section class="hero account-hero">
      <div class="shell command-grid">
        <div class="overview panel panel--pro">
          <span class="label label--pro" id="planBadge">Loading...</span>
          <h1 data-i18n="acct.title">Pro Command Center</h1>
          <p data-i18n="acct.desc">Your workspace. View your plan details, access saved settings, and launch your tools — all from one dashboard.</p>
          <div class="stats-row">
            <div class="stat-block"><b id="tokenPercent">—</b><span data-i18n="acct.stat_tokens">token reserve</span></div>
            <div class="stat-block"><b id="presetCount">—</b><span data-i18n="acct.stat_presets">saved presets</span></div>
            <div class="stat-block"><b id="brandCount">—</b><span data-i18n="acct.stat_brands">brand profiles</span></div>
            <div class="stat-block"><b id="projectCount">—</b><span data-i18n="acct.stat_projects">projects</span></div>
          </div>
        </div>
        <div class="stack" style="display:grid;gap:16px;">
          <div class="panel">
            <span class="label" data-i18n="acct.plan_usage_label">Plan usage</span>
            <div class="split-header"><h3 data-i18n="acct.monthly_usage">Monthly usage</h3><span id="usageLabel">— / —</span></div>
            <div class="progress"><span id="usageBar" style="width:0%"></span></div>
          </div>
          <div class="panel">
            <span class="label" data-i18n="acct.quick_actions_label">Quick actions</span>
            <ul class="detail-list">
              <li><a href={ROUTES.studioConverter} style="color:var(--text);" data-i18n="acct.open_converter">Open Converter Pro</a></li>
              <li><a href={ROUTES.studioImageSuite} style="color:var(--text);" data-i18n="acct.open_image_suite">Open Image Suite</a></li>
              <li><a href={ROUTES.builder} style="color:var(--text);" data-i18n="acct.open_builder">Open Builder</a></li>
              <li><a href={ROUTES.profile} style="color:var(--text);" data-i18n="acct.edit_profile">Edit profile</a></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ FAVORITES & HISTORY ═══ -->
    <section class="page-section">
      <div class="shell grid-3">
        <article class="panel">
          <span class="label label--pro" data-i18n="acct.favorites_label">Favorites</span>
          <h3 data-i18n="acct.favorites_title">Fast access to premium tools</h3>
          <p data-i18n="acct.favorites_desc">Converter Pro, Image Suite and Builder Pro — one tap away from your most-used workflows.</p>
          <div class="actions" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:16px;">
            <a href={ROUTES.studioConverter} class="button button--ghost" data-i18n="acct.btn_converter">Converter</a>
            <a href={ROUTES.studioImageScaler} class="button button--ghost" data-i18n="acct.btn_scaler">Scaler</a>
            <a href={ROUTES.studioQrGen} class="button button--ghost" data-i18n="acct.btn_qr_gen">QR Gen</a>
          </div>
        </article>
        <article class="panel">
          <span class="label" data-i18n="acct.history_label">History</span>
          <h3 data-i18n="acct.history_title">Recent outputs</h3>
          <p data-i18n="acct.history_desc">View your processing history. Every export and output stays accessible so you can revisit, reuse, or rebuild from your past work.</p>
        </article>
        <article class="panel">
          <span class="label" data-i18n="acct.brand_memory_label">Brand Memory</span>
          <h3 data-i18n="acct.brand_memory_title">Saved defaults</h3>
          <p data-i18n="acct.brand_memory_desc">Store your colors, export presets, and naming conventions. One setup saves hours across all your projects.</p>
        </article>
      </div>
    </section>

    <!-- ═══ PLAN CTA ═══ -->
    <section class="page-section page-section--last">
      <div class="shell callout panel panel--pro">
        <div>
          <span class="label label--pro" data-i18n="acct.your_plan_label">Your plan</span>
          <strong data-i18n="acct.plan_cta_title">Upgrade, manage or explore what Pro unlocks.</strong>
          <p data-i18n="acct.plan_cta_desc">The Command Center is where Pro status translates into real workflow advantages.</p>
        </div>
        <div class="hero-actions">
          <a href={ROUTES.pricing} class="button button--gold" data-i18n="acct.manage_plan">Manage plan</a>
          <a href={ROUTES.profile} class="button button--ghost" data-i18n="acct.edit_profile2">Edit profile</a>
          <button type="button" id="logoutBtn" class="button button--ghost" data-i18n="acct.sign_out" style="border-color:rgba(255,100,100,.2);color:rgba(255,150,150,.9);">Sign out</button>
        </div>
      </div>
    </section>

  </main>
  <FlagshipFooter />

  <script is:inline src="/js/vx-plan.js"></script>
  <script is:inline type="module">
    // Redirect if not logged in
    const token = localStorage.getItem('volynx_access_token');
    if (!token) { window.location.href = '/login/?next=/account/'; }

    // Load plan info
    let cfg = null;
    try { cfg = await fetch('/config.json', { cache: 'no-store' }).then(r => r.json()); } catch {}
    const apiBase = (cfg?.functionsUrl || cfg?.apiBaseUrl || '').replace(/\/$/, '');

    // Try cache first, then API
    const cached = window.VxPlan.getCached();
    if (cached) {
      const badge = document.getElementById('planBadge');
      if (badge) badge.textContent = window.VxPlan.label(cached.plan);
    }

    if (token && apiBase) {
      try {
        const res = await fetch(apiBase + '/check-permission', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
          body: JSON.stringify({ tool: 'converter' }),
        });
        if (res.ok) {
          const perm = await res.json();
          const plan = window.VxPlan.normalize(perm.builderPlan || perm.plan);
          window.VxPlan.cache(plan);
          const badge = document.getElementById('planBadge');
          if (badge) badge.textContent = window.VxPlan.label(plan);

          // Update usage stats
          if (perm.remaining !== undefined && perm.limit !== undefined && perm.used !== undefined) {
            const remaining = perm.remaining;
            const limit = perm.limit;
            const used = perm.used;

            // Calculate percentage for remaining tokens
            const remainingPercent = Math.round((remaining / limit) * 100);
            const tokenPercentEl = document.getElementById('tokenPercent');
            if (tokenPercentEl) {
              tokenPercentEl.textContent = remainingPercent + '%';
            }

            // Show "X / Y" usage
            const usageLabelEl = document.getElementById('usageLabel');
            if (usageLabelEl) {
              usageLabelEl.textContent = used + ' / ' + limit;
            }

            // Set usage bar width percentage
            const usagePercent = Math.round((used / limit) * 100);
            const usageBarEl = document.getElementById('usageBar');
            if (usageBarEl) {
              usageBarEl.style.width = usagePercent + '%';
            }
          }
        }
      } catch {}
    }

    // Logout — clear all Volynx data
    document.getElementById('logoutBtn')?.addEventListener('click', () => {
      window.VxPlan.clearCache();
      window.VxPlan.clearAllUsage();
      window.location.href = '/login/';
    });
  </script>
</FlagshipLayout>

<style>
  .account-hero{ padding-top: clamp(28px, 5vw, 52px); }
</style>
