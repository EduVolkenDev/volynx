---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../components/FlagshipHeader.astro";
import FlagshipFooter from "../components/FlagshipFooter.astro";
import "../styles/home-premium.css";
import { ROUTES } from "../data/routes";

const title = "VOLYNX — Build faster. Launch smarter.";
const description = "AI-assisted web creation, designed for premium output. From idea to live page without losing design quality. One ecosystem for design, automation, publishing and growth.";

// Marquee items — short tokens that compose the platform identity
const marqueeItems = [
  "Builder", "Daily", "CVitae", "Lab", "Studio Pro",
  "AI assist", "Premium kits", "Live preview", "Custom domains", "Black Diamond",
];
// Doubled for seamless loop
const marqueeLoop = [...marqueeItems, ...marqueeItems];
---

<FlagshipLayout title={title} description={description} pageClass="page-home-premium">
  <FlagshipHeader current="/" ctaLabel="Open Builder" ctaI18n="homevx.hero_cta_primary" ctaHref={ROUTES.builder} />

  <main>
    <!-- ════════════════════════════════════════════════════════════
         1) HERO — animated gradient mesh, floating particles,
                   scramble headline, magnetic CTA, lynx-eye chrome ring
         ════════════════════════════════════════════════════════════ -->
    <section class="hp-section hp-hero">
      <div class="hp-mesh" aria-hidden="true">
        <div class="hp-mesh__layer hp-mesh__layer--a"></div>
        <div class="hp-mesh__layer hp-mesh__layer--b"></div>
        <div class="hp-mesh__layer hp-mesh__layer--c"></div>
        <div class="hp-mesh__layer hp-mesh__layer--d"></div>
      </div>
      <div class="hp-particles" aria-hidden="true">
        <span class="hp-particle"></span><span class="hp-particle"></span><span class="hp-particle"></span>
        <span class="hp-particle"></span><span class="hp-particle"></span><span class="hp-particle"></span>
        <span class="hp-particle"></span><span class="hp-particle"></span><span class="hp-particle"></span>
        <span class="hp-particle"></span><span class="hp-particle"></span><span class="hp-particle"></span>
      </div>

      <div class="hp-shell">
        <div class="hp-hero__grid">
          <div class="hp-hero__copy">
            <span class="hp-eyebrow hp-reveal" data-i18n="homevx.hero_eyebrow">VOLYNX</span>
            <h1 class="hp-h1 hp-scramble hp-reveal hp-reveal--delay-1" data-i18n="homevx.hero_title">Build faster. Launch smarter.</h1>
            <p class="hp-lead hp-reveal hp-reveal--delay-2" data-i18n="homevx.hero_sub">
              AI-assisted web creation, designed for premium output. From idea to live page without losing design quality.
            </p>
            <div class="hp-hero__cta-row hp-reveal hp-reveal--delay-3">
              <a href={ROUTES.builder} class="hp-btn hp-btn--primary hp-magnetic">
                <span data-i18n="homevx.hero_cta_primary">Build with VOLYNX</span>
                <span class="hp-btn__arrow" aria-hidden="true">→</span>
              </a>
              <a href={ROUTES.platform} class="hp-btn hp-btn--ghost">
                <span data-i18n="homevx.hero_cta_secondary">Explore the ecosystem</span>
              </a>
            </div>
          </div>

          <div class="hp-hero__visual hp-reveal hp-reveal--delay-2" aria-hidden="true">
            <div class="hp-hero__chrome-ring"></div>
            <img src="/assets/dark-icon-light.webp" alt="" width="560" height="560" loading="eager" decoding="async" fetchpriority="high" />
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         MARQUEE — what lives inside the platform
         ════════════════════════════════════════════════════════════ -->
    <div class="hp-marquee" aria-hidden="true">
      <div class="hp-marquee__track">
        {marqueeLoop.map((item) => (
          <span class="hp-marquee__item">{item}</span>
        ))}
      </div>
    </div>

    <!-- ════════════════════════════════════════════════════════════
         2) PLATFORM VALUE — 4 large blocks, not cards
         ════════════════════════════════════════════════════════════ -->
    <section class="hp-section">
      <div class="hp-orb hp-orb--lilac hp-orb--anim-1" style="top:10%;right:-20%;opacity:0.5;" aria-hidden="true"></div>

      <div class="hp-shell">
        <div class="hp-value__head">
          <span class="hp-eyebrow hp-reveal" data-i18n="homevx.value_eyebrow">What is VOLYNX</span>
          <h2 class="hp-h2 hp-reveal hp-reveal--delay-1" data-i18n="homevx.value_title">
            One ecosystem for design, automation, publishing and growth.
          </h2>
          <p class="hp-lead hp-reveal hp-reveal--delay-2" data-i18n="homevx.value_sub">
            We build the layer between AI capability and premium output. Design quality stays. Speed compounds.
          </p>
        </div>

        <div class="hp-value__grid">
          <article class="hp-value__block hp-value__block--gold hp-reveal">
            <div class="hp-value__num">01</div>
            <h3 class="hp-h3" data-i18n="homevx.value_b1_t">Design quality, end to end.</h3>
            <p class="hp-body" data-i18n="homevx.value_b1_d">
              Premium output by default — kits, sections and components engineered for taste, not templates.
            </p>
          </article>
          <article class="hp-value__block hp-value__block--lilac hp-reveal hp-reveal--delay-1">
            <div class="hp-value__num">02</div>
            <h3 class="hp-h3" data-i18n="homevx.value_b2_t">AI-assisted, not AI-replaced.</h3>
            <p class="hp-body" data-i18n="homevx.value_b2_d">
              Smart drafts you actually ship. AI accelerates the work; you stay in control of the result.
            </p>
          </article>
          <article class="hp-value__block hp-value__block--cyan hp-reveal hp-reveal--delay-2">
            <div class="hp-value__num">03</div>
            <h3 class="hp-h3" data-i18n="homevx.value_b3_t">Workflows that don't fight you.</h3>
            <p class="hp-body" data-i18n="homevx.value_b3_d">
              Tools, tokens, automations and publishing in one place. No tab graveyard.
            </p>
          </article>
          <article class="hp-value__block hp-value__block--chrome hp-reveal hp-reveal--delay-3">
            <div class="hp-value__num">04</div>
            <h3 class="hp-h3" data-i18n="homevx.value_b4_t">Live in minutes, not weeks.</h3>
            <p class="hp-body" data-i18n="homevx.value_b4_d">
              Static-first publishing on your domain. From draft to deploy in a single confident motion.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         2b) STATS STRIP — counters animate up on first view
         ════════════════════════════════════════════════════════════ -->
    <section class="hp-stats-section">
      <div class="hp-shell">
        <div class="hp-stats hp-reveal">
          <div class="hp-stats__cell">
            <div class="hp-stats__num"><span class="hp-counter" data-target="8">0</span></div>
            <p class="hp-stats__label" data-i18n="homevx.stats_1">Months in motion</p>
          </div>
          <div class="hp-stats__cell">
            <div class="hp-stats__num"><span class="hp-counter" data-target="5">0</span></div>
            <p class="hp-stats__label" data-i18n="homevx.stats_2">Live products</p>
          </div>
          <div class="hp-stats__cell">
            <div class="hp-stats__num"><span class="hp-counter" data-target="100">0</span><span class="hp-stats__suffix">%</span></div>
            <p class="hp-stats__label" data-i18n="homevx.stats_3">Static delivery</p>
          </div>
          <div class="hp-stats__cell">
            <div class="hp-stats__num"><span class="hp-counter" data-target="inf">∞</span></div>
            <p class="hp-stats__label" data-i18n="homevx.stats_4">Possibilities</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         3) BUILDER SPOTLIGHT — strategic dark moment, conversion-focused
         ════════════════════════════════════════════════════════════ -->
    <section class="hp-section hp-builder">
      <div class="hp-shell">
        <div class="hp-builder__grid">
          <div class="hp-builder__copy">
            <span class="hp-eyebrow hp-reveal" data-i18n="homevx.builder_eyebrow">VOLYNX Builder</span>
            <h2 class="hp-h2 hp-reveal hp-reveal--delay-1" data-i18n="homevx.builder_title">
              From idea to live page — without losing design quality.
            </h2>
            <p class="hp-lead hp-reveal hp-reveal--delay-2" data-i18n="homevx.builder_sub">
              Pick a kit. Compose with sections. Publish to your domain. AI assists at every step. Designers stay in control.
            </p>

            <div class="hp-steps hp-reveal hp-reveal--delay-3">
              <div class="hp-steps__item">
                <span class="hp-steps__num" data-i18n="homevx.builder_step1_n">01</span>
                <h4 class="hp-steps__title" data-i18n="homevx.builder_step1_t">Idea</h4>
                <p class="hp-steps__desc" data-i18n="homevx.builder_step1_d">Describe what you need or pick a starting kit.</p>
              </div>
              <div class="hp-steps__item">
                <span class="hp-steps__num" data-i18n="homevx.builder_step2_n">02</span>
                <h4 class="hp-steps__title" data-i18n="homevx.builder_step2_t">Structure</h4>
                <p class="hp-steps__desc" data-i18n="homevx.builder_step2_d">Premium kits ready to compose, no design from scratch.</p>
              </div>
              <div class="hp-steps__item">
                <span class="hp-steps__num" data-i18n="homevx.builder_step3_n">03</span>
                <h4 class="hp-steps__title" data-i18n="homevx.builder_step3_t">Sections</h4>
                <p class="hp-steps__desc" data-i18n="homevx.builder_step3_d">Drag, edit, refine. Live preview, every change.</p>
              </div>
              <div class="hp-steps__item">
                <span class="hp-steps__num" data-i18n="homevx.builder_step4_n">04</span>
                <h4 class="hp-steps__title" data-i18n="homevx.builder_step4_t">Publish</h4>
                <p class="hp-steps__desc" data-i18n="homevx.builder_step4_d">Push to your domain. Static, fast, indexed.</p>
              </div>
            </div>

            <a href={ROUTES.builder} class="hp-btn hp-btn--gold hp-magnetic hp-reveal hp-reveal--delay-4">
              <span data-i18n="homevx.builder_cta">Open Builder</span>
              <span class="hp-btn__arrow" aria-hidden="true">→</span>
            </a>
          </div>

          <div class="hp-builder__visual hp-reveal hp-reveal--delay-2">
            <img src="/assets/hero-builder.webp" alt="VOLYNX Builder interface preview" width="900" height="675" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         4) ECOSYSTEM — Builder featured, others compose around
         ════════════════════════════════════════════════════════════ -->
    <section class="hp-section">
      <div class="hp-orb hp-orb--gold hp-orb--anim-2" style="top:5%;left:-15%;opacity:0.45;" aria-hidden="true"></div>
      <div class="hp-orb hp-orb--cyan" style="bottom:-10%;right:-15%;opacity:0.55;" aria-hidden="true"></div>

      <div class="hp-shell">
        <div class="hp-eco__head">
          <span class="hp-eyebrow hp-reveal" data-i18n="homevx.eco_eyebrow">Inside the platform</span>
          <h2 class="hp-h2 hp-reveal hp-reveal--delay-1" data-i18n="homevx.eco_title">
            Four products. One ecosystem.
          </h2>
          <p class="hp-lead hp-reveal hp-reveal--delay-2" data-i18n="homevx.eco_sub">
            Each product solves one moment of the journey. Together, they compound.
          </p>
        </div>

        <div class="hp-eco__grid">
          <a href={ROUTES.builder} class="hp-eco__panel hp-eco__panel--featured hp-tilt hp-reveal">
            <img src="/assets/builder.webp" alt="" class="hp-eco__art" width="320" height="320" loading="lazy" decoding="async" />
            <span class="hp-eco__panel-tag">FLAGSHIP</span>
            <h3 class="hp-h3" data-i18n="homevx.eco_builder_t">VOLYNX Builder</h3>
            <p class="hp-body" data-i18n="homevx.eco_builder_d">Sites, kits and publishing — the main commercial product.</p>
            <span class="hp-eco__panel-link" data-i18n="homevx.eco_explore">Explore product</span>
          </a>

          <a href={ROUTES.daily} class="hp-eco__panel hp-tilt hp-reveal hp-reveal--delay-1">
            <img src="/assets/daily-icon.webp" alt="" class="hp-eco__art" width="240" height="240" loading="lazy" decoding="async" />
            <h3 class="hp-h3" data-i18n="homevx.eco_daily_t">VOLYNX Daily</h3>
            <p class="hp-body" data-i18n="homevx.eco_daily_d">The operational layer for daily work. Scanner, summary, vault, decisions.</p>
            <span class="hp-eco__panel-link" data-i18n="homevx.eco_explore">Explore product</span>
          </a>

          <a href={ROUTES.cvitae} class="hp-eco__panel hp-tilt hp-reveal hp-reveal--delay-2">
            <img src="/assets/cvitae.webp" alt="" class="hp-eco__art" width="240" height="240" loading="lazy" decoding="async" />
            <h3 class="hp-h3" data-i18n="homevx.eco_cvitae_t">CVitae</h3>
            <p class="hp-body" data-i18n="homevx.eco_cvitae_d">AI-assisted CV builder with guided sections, live preview and premium templates.</p>
            <span class="hp-eco__panel-link" data-i18n="homevx.eco_explore">Explore product</span>
          </a>

          <a href={ROUTES.studio} class="hp-eco__panel hp-tilt hp-reveal hp-reveal--delay-3">
            <img src="/assets/studio-logo.webp" alt="" class="hp-eco__art" width="240" height="240" loading="lazy" decoding="async" />
            <h3 class="hp-h3" data-i18n="homevx.eco_studio_t">Studio Pro</h3>
            <p class="hp-body" data-i18n="homevx.eco_studio_d">Premium custom work. When DIY isn't enough, the studio takes over.</p>
            <span class="hp-eco__panel-link" data-i18n="homevx.eco_explore">Explore product</span>
          </a>

          <a href={ROUTES.lab} class="hp-eco__panel hp-tilt hp-reveal hp-reveal--delay-4">
            <img src="/assets/lab.webp" alt="" class="hp-eco__art" width="240" height="240" loading="lazy" decoding="async" />
            <h3 class="hp-h3" data-i18n="homevx.eco_lab_t">VOLYNX Lab</h3>
            <p class="hp-body" data-i18n="homevx.eco_lab_d">Free experimental tools — converters, generators, AI image suite.</p>
            <span class="hp-eco__panel-link" data-i18n="homevx.eco_explore">Explore product</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         4b) LAB TOOLS — free, browser-based, your premium icons
         ════════════════════════════════════════════════════════════ -->
    <section class="hp-section">
      <div class="hp-shell">
        <div class="hp-tools__head">
          <div class="hp-tools__head-text">
            <span class="hp-eyebrow hp-reveal" data-i18n="homevx.tools_eyebrow">VOLYNX Lab · always free</span>
            <h2 class="hp-h2 hp-reveal hp-reveal--delay-1" data-i18n="homevx.tools_title">Free tools that earn trust before asking for anything.</h2>
          </div>
          <p class="hp-lead hp-reveal hp-reveal--delay-2" data-i18n="homevx.tools_sub">Convert, resize, generate and optimise assets — all processed locally in your browser. No account needed.</p>
        </div>

        <div class="hp-tools__grid">
          <a href={ROUTES.labConverter} class="hp-tools__card hp-tilt hp-reveal">
            <img src="/assets/converterbig.webp" alt="" class="hp-tools__card-art" width="200" height="200" loading="lazy" decoding="async" />
            <span class="hp-tools__card-tag" data-i18n="homevx.tools_chip_free">Free</span>
            <h3 class="hp-tools__card-title" data-i18n="homevx.tools_conv_t">Converter</h3>
            <p class="hp-tools__card-desc" data-i18n="homevx.tools_conv_d">WebP, PNG, JPG, AVIF — convert in-browser, no upload.</p>
          </a>
          <a href={ROUTES.labImageScaler} class="hp-tools__card hp-tilt hp-reveal hp-reveal--delay-1">
            <img src="/assets/newimagescaler.webp" alt="" class="hp-tools__card-art" width="200" height="200" loading="lazy" decoding="async" />
            <span class="hp-tools__card-tag" data-i18n="homevx.tools_chip_free">Free</span>
            <h3 class="hp-tools__card-title" data-i18n="homevx.tools_scaler_t">Image Scaler</h3>
            <p class="hp-tools__card-desc" data-i18n="homevx.tools_scaler_d">Batch resize with precise presets and clean export.</p>
          </a>
          <a href={ROUTES.labImageSuite} class="hp-tools__card hp-tilt hp-reveal hp-reveal--delay-2">
            <img src="/assets/newimagesuite.webp" alt="" class="hp-tools__card-art" width="200" height="200" loading="lazy" decoding="async" />
            <span class="hp-tools__card-tag" data-i18n="homevx.tools_chip_free">Free</span>
            <h3 class="hp-tools__card-title" data-i18n="homevx.tools_suite_t">Image Suite</h3>
            <p class="hp-tools__card-desc" data-i18n="homevx.tools_suite_d">Cleanup, crop, AI background-remove and export in one flow.</p>
          </a>
          <a href={ROUTES.labQrGen} class="hp-tools__card hp-tilt hp-reveal hp-reveal--delay-3">
            <img src="/assets/newqrgen.webp" alt="" class="hp-tools__card-art" width="200" height="200" loading="lazy" decoding="async" />
            <span class="hp-tools__card-tag" data-i18n="homevx.tools_chip_free">Free</span>
            <h3 class="hp-tools__card-title" data-i18n="homevx.tools_qr_t">QR Generator</h3>
            <p class="hp-tools__card-desc" data-i18n="homevx.tools_qr_d">Premium branded QR codes with logo, palette, and ready exports.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         4c) FREE FOREVER STRIP — trust signal, premium icons
         ════════════════════════════════════════════════════════════ -->
    <section class="hp-section" style="padding-top:0;">
      <div class="hp-shell">
        <div class="hp-free hp-reveal">
          <div class="hp-free__visual" aria-hidden="true">
            <img src="/assets/freeforever.webp" alt="" width="380" height="380" loading="lazy" decoding="async" />
          </div>
          <div class="hp-free__body">
            <div class="hp-free__head">
              <span class="hp-free__chip" data-i18n="homevx.free_chip">Free forever</span>
              <h2 class="hp-free__title" data-i18n="homevx.free_title">Premium things you can use without paying a cent.</h2>
            </div>
            <div class="hp-free__grid">
              <a href={ROUTES.lab} class="hp-free__item">
                <img src="/assets/lab-free.webp" alt="" class="hp-free__item-art" width="52" height="52" loading="lazy" />
                <div class="hp-free__item-text">
                  <strong data-i18n="homevx.free_1_t">All Lab tools, free</strong>
                  <p data-i18n="homevx.free_1_d">Converter, Image Scaler, Image Suite, QR Generator — full power, zero paywall.</p>
                </div>
              </a>
              <a href={ROUTES.iconsStore || "/icons-store/"} class="hp-free__item">
                <img src="/assets/freeicons.webp" alt="" class="hp-free__item-art" width="52" height="52" loading="lazy" />
                <div class="hp-free__item-text">
                  <strong data-i18n="homevx.free_2_t">Free icon packs after signup</strong>
                  <p data-i18n="homevx.free_2_d">Hundreds of curated icons unlocked the moment you create your account.</p>
                </div>
              </a>
              <a href={ROUTES.cvitae} class="hp-free__item">
                <img src="/assets/cvitae.webp" alt="" class="hp-free__item-art" width="52" height="52" loading="lazy" />
                <div class="hp-free__item-text">
                  <strong data-i18n="homevx.free_3_t">CVitae — free to build</strong>
                  <p data-i18n="homevx.free_3_d">Write, preview and export your CV with guided sections and AI help.</p>
                </div>
              </a>
              <a href={ROUTES.daily} class="hp-free__item">
                <img src="/assets/daily-icon.webp" alt="" class="hp-free__item-art" width="52" height="52" loading="lazy" />
                <div class="hp-free__item-text">
                  <strong data-i18n="homevx.free_4_t">Daily lite — free daily use</strong>
                  <p data-i18n="homevx.free_4_d">Scan, summarize, write, decide — VOLYNX Daily basics stay free for everyone.</p>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         4d) ESSENCE / MANIFESTO — cinematic dark signature moment.
              Lynx-eye pulses inside a rotating gold/lilac halo.
              This is where the platform's soul lives.
         ════════════════════════════════════════════════════════════ -->
    <section class="hp-section hp-essence">
      <div class="hp-shell hp-essence__shell">
        <div class="hp-essence__visual hp-reveal" aria-hidden="true">
          <div class="hp-essence__halo"></div>
          <div class="hp-essence__halo hp-essence__halo--inner"></div>
          <img src="/assets/lynx-eye.webp" alt="" class="hp-essence__eye" width="380" height="380" loading="lazy" decoding="async" />
        </div>

        <div class="hp-essence__copy">
          <span class="hp-eyebrow hp-reveal" data-i18n="homevx.essence_eyebrow">The purpose</span>
          <h2 class="hp-h2 hp-reveal hp-reveal--delay-1" data-i18n="homevx.essence_title">
            Technology only matters when it truly helps someone.
          </h2>
          <p class="hp-reveal hp-reveal--delay-2" data-i18n-html="homevx.essence_p1">
            VOLYNX was built on a simple belief: <strong>premium output should be a default, not a luxury</strong>. Every part of the ecosystem exists to solve a concrete problem — create with clarity, work with flow, ship with confidence.
          </p>
          <p class="hp-reveal hp-reveal--delay-3" data-i18n-html="homevx.essence_p2">
            Eight months in motion. Five products. One belief: build with intention, high standards, and real impact.
          </p>
          <a href={ROUTES.blackDiamond} class="hp-essence__diamond hp-reveal hp-reveal--delay-4" data-i18n="homevx.essence_diamond">
            Black Diamond — by invitation
          </a>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         5) WHY DIFFERENT — strategic positioning, not feature list
         ════════════════════════════════════════════════════════════ -->
    <section class="hp-section">
      <div class="hp-shell">
        <div class="hp-why__head">
          <span class="hp-eyebrow hp-reveal" data-i18n="homevx.diff_eyebrow">Strategic difference</span>
          <h2 class="hp-h2 hp-reveal hp-reveal--delay-1" data-i18n="homevx.diff_title">
            Performance is a brand decision.
          </h2>
          <p class="hp-lead hp-reveal hp-reveal--delay-2" data-i18n="homevx.diff_sub">
            We don't ship features. We ship advantages — measurable ones.
          </p>
        </div>

