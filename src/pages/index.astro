---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../components/FlagshipHeader.astro";
import FlagshipFooter from "../components/FlagshipFooter.astro";
import { ROUTES } from "../data/routes";
---
<FlagshipLayout title="VOLYNX — Building a Smarter Future" pageClass="page-home">
  <FlagshipHeader current={ROUTES.home} ctaLabel="Open Builder" ctaI18n="nav.open_builder" ctaHref={ROUTES.builder} />
  <main>

    <!-- ═══ HERO (v2 — premium emotional) ═══ -->
    <section class="hero-v2">
      <div class="hero-v2__bg" aria-hidden="true"></div>
      <div class="shell hero-v2__inner">
        <div class="hero-v2__copy">
          <div class="hero-v2__pill">
            <span class="hero-v2__pill-dot" aria-hidden="true"></span>
            <span data-i18n="home2.kicker_flagship">Ecossistema Premium</span>
          </div>

          <h1 class="hero-v2__title" data-i18n-html="home2.hero_title_html">
            Tudo que você precisa<br />
            para construir sua carreira<br />
            <span class="gradient-text">em um só lugar</span>
          </h1>

          <p class="hero-v2__desc" data-i18n-html="home2.hero_subtitle_html">
            Site profissional · Rotina produtiva · CV de alto impacto · Ativos imobiliários.<br />
            Uma conta. Um ecossistema. Resultados reais.
          </p>

          <div class="hero-v2__actions">
            <a href="#ecosystem" class="hero-v2__cta-main" data-i18n="home2.btn_start_free">Começar grátis agora</a>
            <a href={ROUTES.products} class="hero-v2__cta-ghost" data-i18n="home2.btn_view_kits">Ver os produtos</a>
          </div>

          <div class="hero-v2__trust">
            <span><span class="check">✓</span> <span data-i18n="home2.trust_free">Free generoso</span></span>
            <span><span class="check">✓</span> <span data-i18n="home2.trust_no_card">Sem cartão até precisar</span></span>
            <span><span class="check">✓</span> <span data-i18n="home2.trust_pt">Suporte em português</span></span>
          </div>
        </div>

        <div class="hero-v2__visual">
          <div class="hero-v2__mockup">
            <div class="hero-v2__mockup-glow" aria-hidden="true"></div>
            <a href="https://daily.volynx.world/" class="hero-v2__mockup-chip" aria-label="Open VOLYNX Daily" data-i18n-aria="home2.mockup_daily_aria">
              <img src="/assets/volynx-daily.webp" alt="VOLYNX Daily" />
            </a>
            <p class="hero-v2__mockup-title" data-i18n="home2.mockup_title">Seu dia mais inteligente e organizado começa aqui</p>
            <div class="hero-v2__mockup-grid">
              <a href="https://daily.volynx.world/tools/my-day/"   class="hero-v2__mockup-tag"><img src="/assets/myday.webp"    alt="">My Day</a>
              <a href="https://daily.volynx.world/tools/scanner/"  class="hero-v2__mockup-tag"><img src="/assets/scanner.webp"  alt="">Smart Scanner</a>
              <a href="https://daily.volynx.world/tools/summary/"  class="hero-v2__mockup-tag"><img src="/assets/summary.webp"  alt="">Universal Summary</a>
              <a href="https://daily.volynx.world/tools/vault/"    class="hero-v2__mockup-tag"><img src="/assets/vault.webp"    alt="">Smart Vault</a>
              <a href="https://daily.volynx.world/tools/writing/"  class="hero-v2__mockup-tag"><img src="/assets/writing.webp"  alt="">Writing Studio</a>
              <a href="https://daily.volynx.world/tools/decision/" class="hero-v2__mockup-tag"><img src="/assets/decision.webp" alt="">Decision Desk</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- floating: Ecosystem -->
    <div class="section-float section-float--right" aria-hidden="true">
      <img src="/assets/ecosystem.webp" alt="" loading="lazy" />
    </div>

    <!-- ═══ ECOSYSTEM ═══ -->
    <section id="ecosystem" class="page-section">
      <div class="shell section-head section-head--split">
        <div>
          <span class="eyebrow" data-i18n="home2.eyebrow_ecosystem">What Volynx is</span>
          <h2 data-i18n="home2.section_ecosystem_title">An ecosystem, not a pile of pages.</h2>
        </div>
        <p data-i18n="home2.section_ecosystem_desc">Four products with one account, one token system, and a shared commitment to premium quality.</p>
      </div>
      <div class="shell grid-3">
        <article class="panel feature-card premium-frame panel--pro has-card-asset">
          <img src="/assets/builder.webp" alt="" class="card-asset" loading="lazy" />
          <a href={ROUTES.builder} class="label label--pro" data-i18n="home2.card_builder_label">Flagship</a>
          <h3 data-i18n="home2.card_builder_title">VOLYNX Builder</h3>
          <p data-i18n="home2.card_builder_desc">Create and publish premium sites with no-code. Premium kits, custom domains, and a production workspace that ships real results.</p>
          <ul class="detail-list">
            <li data-i18n="home2.card_builder_item1">No-code site builder with live preview</li>
            <li data-i18n="home2.card_builder_item2">Premium kits for portfolios, agencies, SaaS</li>
            <li data-i18n="home2.card_builder_item3">Publish to subdomain or custom domain</li>
          </ul>
        </article>
        <article class="panel feature-card premium-frame has-card-asset">
          <img src="/assets/daily-icon.webp" alt="" class="card-asset" loading="lazy" />
          <a href={ROUTES.daily} class="label" data-i18n="home2.card_daily_label">Daily tools</a>
          <h3 data-i18n="home2.card_daily_title">VOLYNX Daily</h3>
          <p data-i18n="home2.card_daily_desc">Six tools for your real routine. Scan documents, summarize texts, save references, write better and make clearer decisions — every day.</p>
          <ul class="detail-list">
            <li data-i18n="home2.card_daily_item1">Scanner, Summary, Vault, Writing, Decision</li>
            <li data-i18n="home2.card_daily_item2">Cloud sync on Pro, unlimited on Diamond</li>
            <li data-i18n="home2.card_daily_item3">Broader audience: not just devs</li>
          </ul>
        </article>
        <article class="panel feature-card premium-frame has-card-asset">
          <img src="/assets/cvitae.webp" alt="" class="card-asset" loading="lazy" />
          <a href={ROUTES.cvitae} class="label" data-i18n="home2.card_cvitae_label">Career tools</a>
          <h3 data-i18n="home2.card_cvitae_title">CVitae by VOLYNX</h3>
          <p data-i18n="home2.card_cvitae_desc">Present yourself at the level you deserve. Build a professional CV for free. Export a clean PDF when you're ready — no subscription needed.</p>
          <ul class="detail-list">
            <li data-i18n="home2.card_cvitae_item1">Free to build, pay to export (2 tokens)</li>
            <li data-i18n="home2.card_cvitae_item2">Guided editor with live preview</li>
            <li data-i18n="home2.card_cvitae_item3">Business tier for professionals</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- ═══ FREE VALUE STRIP ═══ -->
    <section class="page-section free-strip-section" style="padding-top:0;">
      <div class="shell">
        <div class="panel free-strip">
          <div class="free-strip__head">
            <span class="label label--free" data-i18n="home2.free_kicker">Free forever</span>
            <h2 data-i18n="home2.free_title">Premium things you can use without paying a cent.</h2>
          </div>
          <div class="free-strip__grid">
            <div class="free-strip__item">
              <span class="free-strip__icon" aria-hidden="true">&#10003;</span>
              <div>
                <strong data-i18n="home2.free_1_title">All Lab tools, free</strong>
                <p data-i18n="home2.free_1_desc">Converter, Image Scaler, Image Suite, QR Generator — full power, zero paywall.</p>
              </div>
            </div>
            <div class="free-strip__item">
              <span class="free-strip__icon" aria-hidden="true">&#10003;</span>
              <div>
                <strong data-i18n="home2.free_2_title">Free icon packs after signup</strong>
                <p data-i18n="home2.free_2_desc">Hundreds of curated icons unlocked the moment you create your account.</p>
              </div>
            </div>
            <div class="free-strip__item">
              <span class="free-strip__icon" aria-hidden="true">&#10003;</span>
              <div>
                <strong data-i18n="home2.free_3_title">CVitae — free to build</strong>
                <p data-i18n="home2.free_3_desc">Design a professional CV with live preview. Only pay if you want a clean PDF export.</p>
              </div>
            </div>
            <div class="free-strip__item">
              <span class="free-strip__icon" aria-hidden="true">&#10003;</span>
              <div>
                <strong data-i18n="home2.free_4_title">Daily lite — free daily use</strong>
                <p data-i18n="home2.free_4_desc">Scan, summarize, write, decide — the VOLYNX Daily basics stay free for everyone.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ LAB — Free Tools ═══ -->
    <section class="page-section lab-section">
      <div class="shell section-head section-head--split">
        <div>
          <span class="eyebrow" data-i18n="home2.lab_eyebrow">VOLYNX Lab · always free</span>
          <h2 data-i18n="home2.lab_title">Free tools that earn trust before asking for anything.</h2>
        </div>
        <p data-i18n="home2.lab_desc">Convert, resize, generate and optimise assets — all processed locally in your browser. No account needed. No upload. No catch.</p>
      </div>
      <div class="shell lab-tools-grid">
        <a href={ROUTES.labConverter} class="panel feature-card lab-tool-card">
          <img src="/assets/converterbig.webp" alt="" class="lab-tool-card__icon" loading="lazy" />
          <span class="label label--free" data-i18n="home2.lab_free_chip">Free</span>
          <h3 data-i18n="home2.lab_tool_converter_title">Converter</h3>
          <p data-i18n="home2.lab_tool_converter_desc">Convert images across formats — WebP, PNG, JPG, AVIF — in-browser.</p>
        </a>
        <a href={ROUTES.labImageScaler} class="panel feature-card lab-tool-card">
          <img src="/assets/scalericonofi.webp" alt="" class="lab-tool-card__icon" loading="lazy" />
          <span class="label label--free" data-i18n="home2.lab_free_chip">Free</span>
          <h3 data-i18n="home2.lab_tool_scaler_title">Image Scaler</h3>
          <p data-i18n="home2.lab_tool_scaler_desc">Resize images at scale with precise presets and a clean batch pipeline.</p>
        </a>
        <a href={ROUTES.labImageSuite} class="panel feature-card lab-tool-card">
          <img src="/assets/suiteiconofi.webp" alt="" class="lab-tool-card__icon" loading="lazy" />
          <span class="label label--free" data-i18n="home2.lab_free_chip">Free</span>
          <h3 data-i18n="home2.lab_tool_suite_title">Image Suite</h3>
          <p data-i18n="home2.lab_tool_suite_desc">Cleanup, crop and export in one flow — designed for creators who ship.</p>
        </a>
        <a href={ROUTES.labQrGen} class="panel feature-card lab-tool-card">
          <img src="/assets/qrgen.webp" alt="" class="lab-tool-card__icon" loading="lazy" />
          <span class="label label--free" data-i18n="home2.lab_free_chip">Free</span>
          <h3 data-i18n="home2.lab_tool_qr_title">QR Generator</h3>
          <p data-i18n="home2.lab_tool_qr_desc">Premium branded QR codes with logo, palette and download-ready exports.</p>
        </a>
      </div>
      <div class="shell lab-section-cta">
        <a href={ROUTES.lab} class="button button--gold" data-i18n="home2.lab_btn_try">Open VOLYNX Lab</a>
        <a href={ROUTES.iconsStore} class="button button--ghost" data-i18n="home2.lab_btn_icons">Browse Icons Store</a>
      </div>
    </section>

    <!-- floating: Premium Value -->
    <div class="section-float section-float--left section-float--products" aria-hidden="true">
      <img src="/assets/float-products.webp" alt="" loading="lazy" width="300" height="300" />
    </div>

    <!-- ═══ FEATURED PRODUCTS (editorial) ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="home2.eyebrow_featured">Featured now</span>
        <h2 data-i18n="home2.section_featured_title">Commercial products first. Vision immediately after.</h2>
        <p data-i18n="home2.section_featured_desc">Premium tools and kits ready to use today. Tomorrow's innovations already in development.</p>
      </div>
      <div class="shell editorial-grid">
        <article class="panel gallery-card gallery-card--xl" style="background-image:url('/assets/newportfolio.webp')">
          <span class="label" data-i18n="home2.featured_portfolio_label">Flagship kit</span>
          <h3 data-i18n="home2.featured_portfolio_title">Portfolio Pro Kit</h3>
          <p data-i18n="home2.featured_portfolio_desc">Launch fast, look expensive and give your personal brand a real operating system.</p>
          <div class="actions"><a href={ROUTES.portfolioKit} class="button button--ghost" data-i18n="home2.featured_portfolio_btn">Open kit</a></div>
        </article>
        <article class="panel gallery-card" style="background-image:url('/assets/newlaunch.webp')">
          <span class="label" data-i18n="home2.featured_agency_label">For agencies</span>
          <h3 data-i18n="home2.featured_agency_title">Agency Launch Kit</h3>
          <p data-i18n="home2.featured_agency_desc">Proposal, SOW and premium website structure built to close with less friction.</p>
          <div class="actions"><a href={ROUTES.agencyKit} class="button button--ghost" data-i18n="home2.featured_agency_btn">Open kit</a></div>
        </article>
        <article class="panel gallery-card" style="background-image:url('/assets/saasbig.webp')">
          <span class="label" data-i18n="home2.featured_saas_label">For SaaS</span>
          <h3 data-i18n="home2.featured_saas_title">SaaS Landing System</h3>
          <p data-i18n="home2.featured_saas_desc">Section-first, speed-aware and ready to turn product value into conviction.</p>
          <div class="actions"><a href={ROUTES.saasSystem} class="button button--ghost" data-i18n="home2.featured_saas_btn">Open kit</a></div>
        </article>
      </div>
      <div class="shell spotlight-row">
        <article class="panel spotlight-card panel--pro">
          <div>
            <span class="label label--pro" data-i18n="home2.spotlight_pf_label">New · Real estate SaaS</span>
            <h3 data-i18n="home2.spotlight_pf_title">PropertyFlow deserves its own stage.</h3>
            <p data-i18n="home2.spotlight_pf_desc">A bilingual property platform with stronger catalog logic, polished filtering and a visual language that already feels like a product line, not just a listing page.</p>
          </div>
          <img src="/assets/propertyflow2.webp" alt="PropertyFlow preview" class="spotlight-img" />
          <a href={ROUTES.propertyflow} class="button button--gold" data-i18n="home2.spotlight_pf_btn">View PropertyFlow</a>
        </article>
      </div>
    </section>

    <!-- ═══ ICONS STORE (featured product) ═══ -->
    <section class="page-section">
      <div class="shell">
        <article class="panel panel--pro icons-store-showcase">
          <div class="icons-store-copy">
            <span class="label label--pro" data-i18n="home2.icons_store_label">Premium Asset Vault</span>
            <h2 data-i18n="home2.icons_store_title">900+ premium icons. Now live.</h2>
            <p data-i18n="home2.icons_store_desc">Seventeen curated icon packs across 9 categories. Browse every collection, preview each pack, and pick the one that fits your product.</p>
            <div class="icons-store-stats">
              <div><strong>900+</strong><span data-i18n="home2.icons_store_stat1">Icons</span></div>
              <div><strong>17</strong><span data-i18n="home2.icons_store_stat2">Packs</span></div>
              <div><strong>9</strong><span data-i18n="home2.icons_store_stat3">Categories</span></div>
            </div>
            <a href={ROUTES.iconsStore} class="button button--gold" data-i18n="home2.icons_store_btn">Open Icon Vault</a>
          </div>
          <div class="icons-store-preview">
            <div class="icons-preview-grid">
              <img src="/assets/icons-store/Icons-Glass-Premium/glass-premium1.webp" alt="" loading="lazy" />
              <img src="/assets/icons-store/Abstract-Free/icon-neon-premium1.webp" alt="" loading="lazy" />
              <img src="/assets/icons-store/Iridescent-Premium/daily-iridescent-premium1.webp" alt="" loading="lazy" />
              <img src="/assets/icons-store/Icons-Glass-Premium/glass-premium10.webp" alt="" loading="lazy" />
              <img src="/assets/icons-store/Pink-Abstract-Free/icons-sliced4_09.webp" alt="" loading="lazy" />
              <img src="/assets/icons-store/Chromed-Premium/Chromed-Premium100.webp" alt="" loading="lazy" />
              <img src="/assets/icons-store/Icons-Glass-Premium/glass-premium11.webp" alt="" loading="lazy" />
              <img src="/assets/icons-store/Pink-Abstract-Free/icons-sliced4_11.webp" alt="" loading="lazy" />
              <img src="/assets/icons-store/Iridescent-Premium/daily-iridescent-premium10.webp" alt="" loading="lazy" />
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- floating: Shipping -->
    <div class="section-float section-float--right" aria-hidden="true">
      <img src="/assets/float-principles.webp" alt="" loading="lazy" />
    </div>

    <!-- ═══ PRINCIPLES ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="home2.eyebrow_principles">Operating philosophy</span>
        <h2 data-i18n="home2.section_principles_title">Premium direction needs principles, not decoration.</h2>
      </div>
      <div class="shell grid-2 principles-grid-v3">
        <article class="panel principle-panel"><h3 data-i18n="home2.principle_1_title">Clear by default</h3><p data-i18n="home2.principle_1_desc">If users cannot understand the value in seconds, the page is still unfinished.</p></article>
        <article class="panel principle-panel"><h3 data-i18n="home2.principle_2_title">Built as systems</h3><p data-i18n="home2.principle_2_desc">Layouts, tools and products need to scale without feeling random or stitched together.</p></article>
        <article class="panel principle-panel"><h3 data-i18n="home2.principle_3_title">Shipped for real use</h3><p data-i18n="home2.principle_3_desc">Real publishing, real workflows and real delivery matter more than aspirational mockups alone.</p></article>
        <article class="panel principle-panel"><h3 data-i18n="home2.principle_4_title">Fast enough to feel expensive</h3><p data-i18n="home2.principle_4_desc">Performance is part of luxury. Slowness cheapens the whole product experience.</p></article>
      </div>
    </section>

    <!-- floating: Engineering -->
    <div class="section-float section-float--left" aria-hidden="true">
      <img src="/assets/float-rnd.webp" alt="" loading="lazy" />
    </div>

    <!-- ═══ R&D PORTFOLIO ═══ -->
    <section class="page-section">
      <div class="shell section-head section-head--split">
        <div>
          <span class="eyebrow" data-i18n="home2.eyebrow_rnd">VOLYNX Vision</span>
          <h2 data-i18n="home2.section_rnd_title">Building toward a smarter future.</h2>
        </div>
        <p data-i18n="home2.section_rnd_desc">The same engineering rigor behind Builder, Daily, and our free tools is directed at harder, longer-term problems. These are active research projects — not products you can buy today, but signals of where we believe technology should go.</p>
      </div>
      <div class="shell grid-3">
        <article class="panel product-vision has-card-asset">
          <img src="/assets/carbontracker.webp" alt="" class="card-asset" loading="lazy" />
          <span class="label" data-i18n="home2.rnd_carbon_label">Impact · In Research</span>
          <h3 data-i18n="home2.rnd_carbon_title">Carbon Tracker</h3>
          <p data-i18n="home2.rnd_carbon_desc">Real-time tracking of personal and business carbon impact with premium visualization.</p>
        </article>
        <article class="panel product-vision has-card-asset">
          <img src="/assets/safetyguardian.webp" alt="" class="card-asset" loading="lazy" />
          <span class="label" data-i18n="home2.rnd_safety_label">Safety · In Research</span>
          <h3 data-i18n="home2.rnd_safety_title">Safety Guardian</h3>
          <p data-i18n="home2.rnd_safety_desc">Smart systems for routing, triaging and responding to critical abuse reports.</p>
        </article>
        <article class="panel product-vision has-card-asset">
          <img src="/assets/precisionhealth.webp" alt="" class="card-asset" loading="lazy" />
          <span class="label" data-i18n="home2.rnd_health_label">Health · In Research</span>
          <h3 data-i18n="home2.rnd_health_title">Precision Health</h3>
          <p data-i18n="home2.rnd_health_desc">AI tools for disease prevention, early detection and research operations.</p>
        </article>
      </div>
    </section>

    <!-- floating: Craft -->
    <div class="section-float section-float--right" aria-hidden="true">
      <img src="/assets/float-cta.webp" alt="" loading="lazy" />
    </div>

    <!-- ═══ FINAL CTA ═══ -->
    <section class="page-section page-section--last">
      <div class="shell callout callout--heroic panel panel--pro">
        <div>
          <span class="label label--pro" data-i18n="home2.cta_label">From free to pro</span>
          <strong data-i18n="home2.cta_tagline">Free should feel generous. Pro should feel inevitable.</strong>
          <p data-i18n="home2.cta_desc">That rule now shapes the entire platform: home, pricing, tools, builder and account surfaces.</p>
        </div>
        <div class="hero-actions">
          <a href={ROUTES.pricing} class="button button--gold" data-i18n="home2.cta_pricing_btn">See the pricing logic</a>
          <a href={ROUTES.profile} class="button button--ghost" data-i18n="home2.cta_profile_btn">Open Pro Command Center</a>
        </div>
      </div>
    </section>

  </main>
  <FlagshipFooter />
</FlagshipLayout>

<style>
  /* ═══ HERO V2 — Premium Emotional ═══ */
  .hero-v2 {
    position: relative;
    min-height: calc(100vh - 74px);
    display: flex;
    align-items: center;
    padding: clamp(48px, 8vh, 96px) 0 clamp(40px, 6vh, 80px);
    overflow: hidden;
  }
  .hero-v2__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 80% at 50% 40%, rgba(20, 184, 166, 0.12) 0%, transparent 60%),
      radial-gradient(ellipse 40% 60% at 90% 90%, rgba(59, 130, 246, 0.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-v2__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 980px) {
    .hero-v2__inner { grid-template-columns: 1.3fr 1fr; gap: 56px; }
  }

  .hero-v2__copy { max-width: 720px; }

  .hero-v2__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: 999px;
    background: rgba(45, 212, 191, 0.08);
    border: 1px solid rgba(45, 212, 191, 0.25);
    margin-bottom: 24px;
    font-size: .82rem;
    font-weight: 600;
    color: #5eead4;
    letter-spacing: .02em;
  }
  .hero-v2__pill-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #2dd4bf;
