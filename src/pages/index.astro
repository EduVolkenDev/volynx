---
import { ROUTES } from "../data/routes";

// Top 4 most user-facing surfaces. The full catalogue (PropertyFlow, Products,
// Services + others) lives at /platform/ — the CTA at the bottom takes them there.
const platformSurfaces = [
  {
    num: "01",
    name: { pt: "VOLYNX Builder", en: "VOLYNX Builder" },
    desc: {
      pt: "Workspace no-code para criar e publicar sites premium com preview ao vivo, kits prontos e domínio próprio.",
      en: "A no-code workspace to build and publish premium sites with live preview, ready-made kits, and custom domains.",
    },
    tag: { pt: "Sites & Publicação", en: "Sites & Publishing" },
    href: ROUTES.builder,
  },
  {
    num: "02",
    name: { pt: "VOLYNX Daily", en: "VOLYNX Daily" },
    desc: {
      pt: "A camada operacional do dia a dia: My Day, Scanner, Summary, Vault, Writing e Decision dentro de um único sistema.",
      en: "The operational layer for everyday work: My Day, Scanner, Summary, Vault, Writing, and Decision inside one system.",
    },
    tag: { pt: "Rotina & Produtividade", en: "Routine & Productivity" },
    href: ROUTES.daily,
  },
  {
    num: "03",
    name: { pt: "CVitae", en: "CVitae" },
    desc: {
      pt: "Criador de currículo com IA, editor guiado, preview ao vivo e templates. Monte grátis, use VX para exports premium ou Business para uso ilimitado.",
      en: "AI-assisted CV builder with guided editing, live preview, and templates. Build for free, use VX for premium exports, or go Business for unlimited use.",
    },
    tag: { pt: "Carreira & IA", en: "Career & AI" },
    href: ROUTES.cvitae,
  },
  {
    num: "04",
    name: { pt: "VOLYNX Lab + Studio Pro", en: "VOLYNX Lab + Studio Pro" },
    desc: {
      pt: "Ferramentas no browser para converter, redimensionar e gerar assets. Lab é grátis; Studio Pro libera recursos por plano, com VX só nas ações conectadas.",
      en: "Browser-based tools to convert, resize, and generate assets. Lab is free; Studio Pro unlocks plan-gated features, with VX only on wired actions.",
    },
    tag: { pt: "Ferramentas & Studio", en: "Tools & Studio" },
    href: ROUTES.lab,
  },
];
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Volynx — Bem-vindos</title>
<meta name="description" id="pageDescription" content="Oito meses sem parar. Muitas horas de trabalho. Um lançamento que apresenta a VOLYNX e abre a plataforma em /platform.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Mono:wght@300;400;500&family=Syne:wght@400;600;700;800&display=swap">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Mono:wght@300;400;500&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
<script>
  (function () {
    try {
      var raw = localStorage.getItem('volynx_lang') || navigator.language || 'pt-BR';
      var next = String(raw).toLowerCase().startsWith('pt') ? 'pt-BR' : 'en';
      document.documentElement.lang = next;
    } catch (_) {}
  })();
</script>
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --black: #060608;
    --white: #f4f1ec;
    --cream: #e8e3d8;
    --gold: #c9a85c;
    --gold-dim: #8a6e3a;
    --text-muted: #6b6560;
    --border: rgba(201,168,92,0.18);
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--black);
    color: var(--white);
    font-family: 'DM Mono', monospace;
    overflow-x: hidden;
  }

  html[lang="en"] .i18n-pt,
  html[lang="en-US"] .i18n-pt,
  html[lang="en-us"] .i18n-pt {
    display: none;
  }

  html[lang="pt"] .i18n-en,
  html[lang="pt-BR"] .i18n-en,
  html[lang="pt-br"] .i18n-en {
    display: none;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E");
    opacity: 0.028;
    pointer-events: none;
    z-index: 9999;
  }

  .lang-toggle {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 10001;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 999px;
    border: 1px solid rgba(201,168,92,0.28);
    background: rgba(6, 6, 8, 0.72);
    color: var(--cream);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    cursor: pointer;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }

  .lang-toggle:hover {
    transform: translateY(-1px);
    border-color: rgba(201,168,92,0.52);
    background: rgba(12, 12, 16, 0.84);
  }

  .lang-toggle__text {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .lang-toggle__tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    min-height: 28px;
    padding: 0 10px;
    border-radius: 999px;
    border: 1px solid rgba(201,168,92,0.25);
    color: var(--gold);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    padding: 80px 24px;
    text-align: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 50% at 50% 60%, rgba(201,168,92,0.07) 0%, transparent 70%),
      radial-gradient(ellipse 40% 30% at 20% 80%, rgba(42,61,110,0.15) 0%, transparent 60%),
      radial-gradient(ellipse 30% 40% at 80% 20%, rgba(184,74,46,0.08) 0%, transparent 55%);
  }

  .hero-lines {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(0deg, transparent, transparent 79px, rgba(201,168,92,0.04) 80px);
    pointer-events: none;
  }

  /* Subtle brand stamp at top-left of hero (only visible during hero) */
  .hero-wordmark {
    position: absolute;
    top: clamp(20px, 3vw, 32px);
    left: clamp(20px, 3vw, 32px);
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    opacity: 0;
    animation: fadeIn 1.4s 0.2s forwards;
    user-select: none;
  }
  .hero-wordmark__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 10px rgba(201, 168, 92, 0.6);
  }
  .hero-wordmark__img {
    height: auto;
    width: 120px;
    display: block;
  }

  /* Skip-link — invisible until focused */
  .skip-link {
    position: fixed;
    top: 16px;
    left: 16px;
    z-index: 10002;
    padding: 10px 16px;
    border-radius: 6px;
    background: var(--gold);
    color: var(--black);
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transform: translateY(-200%);
    transition: transform 0.2s ease;
  }
  .skip-link:focus,
  .skip-link:focus-visible {
    transform: translateY(0);
    outline: none;
  }

  .hero-months {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(120px, 22vw, 260px);
    font-weight: 300;
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(201,168,92,0.3);
    opacity: 0;
    animation: fadeUp 1.2s 0.5s forwards;
    user-select: none;
  }

  .hero-months-label {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(18px, 3vw, 32px);
    font-weight: 300;
    font-style: italic;
    letter-spacing: 0.08em;
    color: var(--cream);
    margin-top: 8px;
    opacity: 0;
    animation: fadeUp 1s 0.8s forwards;
  }

  .hero-tagline {
    font-family: 'Syne', sans-serif;
    font-size: clamp(24px, 4.5vw, 52px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-top: 56px;
    max-width: 800px;
    opacity: 0;
    animation: fadeUp 1s 1.1s forwards;
  }

  .hero-tagline em {
    font-style: italic;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: 1.15em;
    color: var(--gold);
  }

  .scroll-hint {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
    animation: fadeIn 1s 2.5s forwards;
  }

  .scroll-hint span {
    font-size: 9px;
    letter-spacing: 0.3em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--gold), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  /* ── STORY ── */
  .story {
    max-width: 760px;
    margin: 0 auto;
    padding: 120px 24px;
  }

  .section-label {
    font-size: 10px;
    letter-spacing: 0.35em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 40px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .story-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(22px, 3.2vw, 32px);
    font-weight: 300;
    line-height: 1.65;
    color: var(--cream);
  }

  .story-text p { margin-bottom: 1.6em; }
  .story-text strong { font-weight: 600; color: var(--white); }
  .story-text .accent { color: var(--gold); font-style: italic; }
  .break-rule {
    border: 0;
    width: 64px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    opacity: 0.6;
    margin: 2.6em auto;
  }

  /* ── WELCOME ── */
  .welcome {
    padding: 80px 24px 120px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .welcome-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 60% at 50% 50%, rgba(201,168,92,0.06) 0%, transparent 70%);
  }

  .welcome-eyebrow {
    font-size: 10px;
    letter-spacing: 0.4em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 32px;
  }

  .welcome-title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(40px, 9vw, 110px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.9;
    margin-bottom: 16px;
  }

  .welcome-title .voly { color: var(--white); }
  .welcome-title .nx   { color: var(--gold); }

  .welcome-subtitle {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: clamp(18px, 2.5vw, 26px);
    font-weight: 300;
    color: var(--text-muted);
    margin-top: 24px;
    letter-spacing: 0.05em;
  }

  .divider {
    width: 100%;
    height: 1px;
    background: var(--border);
    max-width: 900px;
    margin: 0 auto;
  }

  /* ── ABOUT ── */
  .about {
    max-width: 900px;
    margin: 0 auto;
    padding: 100px 24px;
  }

  .about-intro {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(24px, 3.5vw, 38px);
    font-weight: 300;
    line-height: 1.5;
    color: var(--cream);
    margin-bottom: 64px;
    max-width: 700px;
  }

  .about-intro strong { font-weight: 600; color: var(--white); }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    margin-bottom: 80px;
  }

  .tool-card {
    position: relative;
    background: var(--black);
    display: block;
    padding: 36px 32px;
    text-decoration: none;
    color: inherit;
    transition: background 0.3s;
    cursor: pointer;
    min-height: 100%;
  }

  .tool-card:hover { background: rgba(201,168,92,0.04); }
  .tool-card:hover .tool-num { color: var(--gold); }
  .tool-card:hover .tool-name { color: var(--gold); }

  .tool-arrow {
    position: absolute;
    top: 30px;
    right: 30px;
    font-size: 14px;
    color: var(--gold);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .tool-card:hover .tool-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* "Ver o ecossistema completo →" — closes the catalog teaser */
  .tools-seeall {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    padding: 10px 0;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
    border-bottom: 1px solid rgba(201, 168, 92, 0.32);
    transition: color 0.25s ease, border-color 0.25s ease;
  }
  .tools-seeall:hover {
    color: var(--cream);
    border-color: var(--cream);
  }
  .tools-seeall__arrow {
    transition: transform 0.25s ease;
  }
  .tools-seeall:hover .tools-seeall__arrow {
    transform: translateX(4px);
  }

  /* ── DEV JOURNEY ── */
  .dev-journey {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px 100px;
  }

  .dev-journey-panel {
    position: relative;
    display: grid;
    gap: 28px;
    padding: clamp(32px, 6vw, 58px);
    border: 1px solid rgba(201,168,92,0.24);
    background:
      radial-gradient(circle at 85% 18%, rgba(201,168,92,0.10), transparent 34%),
      radial-gradient(circle at 16% 90%, rgba(42,61,110,0.16), transparent 38%),
      rgba(201,168,92,0.025);
    overflow: hidden;
    isolation: isolate;
  }

  .dev-journey-panel::before {
    content: '';
    position: absolute;
    inset: 1px;
    border: 1px solid rgba(255,255,255,0.035);
    pointer-events: none;
    z-index: -1;
  }

  .dev-journey-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--gold);
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .dev-journey-kicker::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--gold);
    box-shadow: 0 0 14px rgba(201,168,92,0.55);
  }

  .dev-journey-title {
    max-width: 720px;
    font-family: 'Syne', sans-serif;
    font-size: clamp(32px, 5vw, 62px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: var(--white);
  }

  .dev-journey-title em {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    color: var(--gold);
  }

  .dev-journey-copy {
    max-width: 680px;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(21px, 3vw, 29px);
    line-height: 1.55;
    color: var(--cream);
  }

  .dev-journey-copy strong {
    color: var(--white);
    font-weight: 600;
  }

  .dev-journey-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 1px;
    background: rgba(201,168,92,0.16);
    border: 1px solid rgba(201,168,92,0.18);
  }

  .dev-journey-meta div {
    background: rgba(6,6,8,0.84);
    padding: 20px;
  }

  .dev-journey-meta strong {
    display: block;
    margin-bottom: 8px;
    font-family: 'Syne', sans-serif;
    font-size: 16px;
    color: var(--white);
  }

  .dev-journey-meta span {
    display: block;
    font-size: 11px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .dev-journey-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .dev-journey-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 14px 20px;
    border: 1px solid rgba(201,168,92,0.32);
    color: var(--gold);
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .dev-journey-btn:hover {
    background: var(--gold);
    color: var(--black);
    border-color: var(--gold);
    transform: translateY(-1px);
  }

  .dev-journey-btn--ghost {
    color: var(--cream);
    border-color: rgba(255,255,255,0.14);
  }

  .tool-num {
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--text-muted);
    margin-bottom: 20px;
    transition: color 0.3s;
  }

  .tool-name {
    font-family: 'Syne', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 12px;
    color: var(--white);
  }

  .tool-desc {
    font-size: 12px;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .tool-tag {
    display: inline-block;
    margin-top: 20px;
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-dim);
    border: 1px solid rgba(201,168,92,0.2);
    padding: 4px 10px;
  }

  /* ── MANIFESTO ── */
  .manifesto {
    border-top: 1px solid var(--border);
    padding: 100px 24px;
    max-width: 760px;
    margin: 0 auto;
  }

  .manifesto-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(20px, 3vw, 30px);
    font-weight: 300;
    line-height: 1.7;
    color: var(--cream);
  }

  .manifesto-text p { margin-bottom: 1.5em; }
  .manifesto-text .highlight { font-style: italic; color: var(--gold); }

  /* ── CTA ENTER ── */
  .cta-section {
    text-align: center;
    padding: 80px 24px 140px;
    border-top: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }

  .cta-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 50% 80% at 50% 100%, rgba(201,168,92,0.07) 0%, transparent 70%);
  }

  .cta-label {
    font-size: 10px;
    letter-spacing: 0.4em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 32px;
  }

  .cta-heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 6vw, 72px);
    font-weight: 300;
    font-style: italic;
    line-height: 1.1;
    color: var(--cream);
    margin-bottom: 48px;
  }

  .cta-heading strong {
    font-style: normal;
    font-weight: 600;
    color: var(--white);
  }

  /* Botão de entrada */
  .enter-btn {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    background: transparent;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 20px 48px;
    position: relative;
    cursor: pointer;
    transition: all 0.4s ease;
    overflow: hidden;
  }

  .enter-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--gold);
    transform: translateX(-101%);
    transition: transform 0.4s ease;
    z-index: 0;
  }

  .enter-btn:hover::before { transform: translateX(0); }

  .enter-btn:hover {
    color: var(--black);
  }

  .enter-btn span {
    position: relative;
    z-index: 1;
  }

  .enter-btn .arrow {
    position: relative;
    z-index: 1;
    transition: transform 0.3s ease;
  }

  .enter-btn:hover .arrow { transform: translateX(6px); }

  .cta-sub {
    margin-top: 24px;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  /* ── SIGN ── */
  .sign {
    text-align: center;
    padding: 60px 24px 80px;
    border-top: 1px solid var(--border);
  }

  .sign-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(14px, 2vw, 18px);
    font-style: italic;
    font-weight: 300;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .sign-title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 5vw, 52px);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  .sign-wordmark {
    display: block;
    margin: 0 auto;
    height: clamp(40px, 6vw, 72px);
    width: auto;
    user-select: none;
  }

  .sign-domain {
    margin-top: 16px;
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--gold-dim);
    text-transform: uppercase;
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes scrollPulse {
    0%, 100% { opacity: 0.4; }
    50%       { opacity: 1; }
  }

  .reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.9s ease, transform 0.9s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 600px) {
    .tools-grid { grid-template-columns: 1fr; }
    .lang-toggle {
      top: 14px;
      right: 14px;
      padding: 9px 12px;
      gap: 10px;
    }
    .lang-toggle__text { display: none; }
    .hero-wordmark__img { width: 96px; }
    .dev-journey { padding-bottom: 72px; }
    .dev-journey-actions { flex-direction: column; }
    .dev-journey-btn { width: 100%; }
  }

  @media (max-height: 820px) and (min-width: 768px) {
    .hero {
      min-height: auto;
      padding: 80px 24px 72px;
    }

    .scroll-hint {
      position: relative;
      bottom: auto;
      left: auto;
      transform: none;
      margin-top: 32px;
    }
  }
</style>
</head>
<body>

<a class="skip-link" href="#cta-section">
  <span class="i18n-pt">Pular para o conteúdo</span>
  <span class="i18n-en">Skip to content</span>
</a>

<button
  class="lang-toggle"
  type="button"
  data-vx-lang-toggle
  data-vx-lang-title
>
  <span class="lang-toggle__text">
    <span class="i18n-pt">Idioma</span>
    <span class="i18n-en">Language</span>
  </span>
  <span class="lang-toggle__tag" data-vx-lang-label>PT</span>
</button>

<!-- HERO -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-lines"></div>
  <div class="hero-wordmark" aria-hidden="true">
    <span class="hero-wordmark__dot"></span>
    <img src="/assets/wordmark.webp" alt="VOLYNX" class="hero-wordmark__img" width="1375" height="750" loading="eager" decoding="async" />
  </div>
  <div class="hero-months">8</div>
  <div class="hero-months-label">
    <span class="i18n-pt">oito meses sem parar</span>
    <span class="i18n-en">eight months without stopping</span>
  </div>
  <h1 class="hero-tagline">
    <span class="i18n-pt">Trabalho intenso, sem pausa.<br><em>Dias de mais de 30 horas.</em><br>Uma visão que virou VOLYNX.</span>
    <span class="i18n-en">Relentless, intense work.<br><em>30-hour-plus days.</em><br>A vision that became VOLYNX.</span>
  </h1>
  <div class="scroll-hint">
    <span class="i18n-pt">continuar</span>
    <span class="i18n-en">continue</span>
    <div class="scroll-line"></div>
  </div>
</section>

<!-- STORY -->
<section class="story">
  <div class="section-label reveal">
    <span class="i18n-pt">O processo</span>
    <span class="i18n-en">The process</span>
  </div>
  <div class="story-text reveal">
    <p>
      <span class="i18n-pt">Por <strong>8 meses</strong>, tudo ao redor continuou andando enquanto eu voltava para a mesma tela, para a mesma ideia e para a mesma vontade de construir algo real.</span>
      <span class="i18n-en">For <strong>8 months</strong>, everything around me kept moving while I kept returning to the same screen, the same idea, and the same need to build something real.</span>
    </p>
    <p>
      <span class="i18n-pt">Foram <strong>8 meses sem pausa de verdade.</strong> Muitas horas por dia, noites inteiras e sessões de <span class="accent">mais de 30 horas programando sem parar</span>, ajustando arquitetura, interface, lógica e detalhe por detalhe.</span>
      <span class="i18n-en">It was <strong>8 months without a real break.</strong> Long days, full nights, and sessions of <span class="accent">more than 30 hours coding without stopping</span>, refining architecture, interface, logic, and detail after detail.</span>
    </p>
    <p>
      <span class="i18n-pt">Construí a VOLYNX <strong>sozinho.</strong> Cada linha de código, cada decisão e cada pixel passaram pela mesma cabeça e pela mesma obsessão de fazer isso existir do jeito certo.</span>
      <span class="i18n-en">I built VOLYNX <strong>alone.</strong> Every line of code, every decision, and every pixel passed through the same mind and the same obsession to make it exist the right way.</span>
    </p>
    <hr class="break-rule" aria-hidden="true" />
    <p>
      <span class="i18n-pt">Eu sempre quis ser programador não só para escrever software, mas para <span class="accent">criar algo maior</span> — algo que chegasse na vida real das pessoas com utilidade, padrão e impacto.</span>
      <span class="i18n-en">I always wanted to be a programmer not just to write software, but to <span class="accent">build something bigger</span> — something that would reach real people's lives with utility, standards, and impact.</span>
    </p>
    <p>
      <span class="i18n-pt">Esses <strong>8 meses foram a travessia entre sonho e produto.</strong> O resultado é esta plataforma: um ecossistema pronto para começar.</span>
      <span class="i18n-en">Those <strong>8 months were the crossing between dream and product.</strong> The result is this platform: an ecosystem ready to begin.</span>
    </p>
  </div>
</section>

<!-- WELCOME -->
<section class="welcome">
  <div class="welcome-bg"></div>
  <div class="welcome-eyebrow reveal">
    <span class="i18n-pt">É com o coração cheio que eu digo</span>
    <span class="i18n-en">With a full heart, I can finally say</span>
  </div>
  <h2 class="welcome-title reveal">
    <span class="i18n-pt"><span class="voly">Bem-vindos à </span><span class="nx">Volynx</span></span>
    <span class="i18n-en"><span class="voly">Welcome to </span><span class="nx">Volynx</span></span>
  </h2>
  <p class="welcome-subtitle reveal">
    <span class="i18n-pt">Um ecossistema criado do zero, com ambição real e padrão alto.</span>
    <span class="i18n-en">An ecosystem built from zero, with real ambition and high standards.</span>
  </p>
</section>

<div class="divider"></div>

<!-- ABOUT -->
<section class="about">
  <div class="section-label reveal">
    <span class="i18n-pt">O que é a Volynx</span>
    <span class="i18n-en">What VOLYNX is</span>
  </div>
  <p class="about-intro reveal">
    <span class="i18n-pt">A VOLYNX não é uma ferramenta só. É um <strong>ecossistema conectado</strong>, onde cada área tem uma função real: criar, organizar, vender, entregar e escalar.</span>
    <span class="i18n-en">VOLYNX is not just one tool. It is a <strong>connected ecosystem</strong>, where each area has a real role: create, organize, sell, deliver, and scale.</span>
  </p>

  <div class="tools-grid reveal">
    {platformSurfaces.map((surface) => (
      <a class="tool-card" href={surface.href}>
        <div class="tool-num">{surface.num}</div>
        <div class="tool-name">
          <span class="i18n-pt">{surface.name.pt}</span>
          <span class="i18n-en">{surface.name.en}</span>
        </div>
        <div class="tool-desc">
          <span class="i18n-pt">{surface.desc.pt}</span>
          <span class="i18n-en">{surface.desc.en}</span>
        </div>
        <div class="tool-tag">
          <span class="i18n-pt">{surface.tag.pt}</span>
          <span class="i18n-en">{surface.tag.en}</span>
        </div>
        <span class="tool-arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </div>

  <a class="tools-seeall reveal" href={ROUTES.platform}>
    <span class="i18n-pt">Ver o ecossistema completo</span>
    <span class="i18n-en">See the full ecosystem</span>
    <span class="tools-seeall__arrow" aria-hidden="true">→</span>
  </a>
</section>

<!-- DEV JOURNEY -->
<section class="dev-journey" id="dev-journey-mission" aria-label="Dev Journey">
  <article class="dev-journey-panel reveal">
    <div class="dev-journey-kicker">
      <span class="i18n-pt">Educação VOLYNX · começo gratuito</span>
      <span class="i18n-en">VOLYNX Education · free start</span>
    </div>
    <h2 class="dev-journey-title">
      <span class="i18n-pt">Dev Journey: código real, <em>sem encheção.</em></span>
      <span class="i18n-en">Dev Journey: real code, <em>no fluff.</em></span>
    </h2>
    <p class="dev-journey-copy">
      <span class="i18n-pt">A VOLYNX também existe para tornar tecnologia e conhecimento acessíveis. O Dev Journey é uma trilha autoguiada, baseada em projetos, para trocar <strong>“eu entendi”</strong> por <strong>“eu entreguei”</strong>. O Social Sprint começa grátis, com login.</span>
      <span class="i18n-en">VOLYNX also exists to make technology and knowledge accessible. Dev Journey is a self-guided, project-based track that turns <strong>“I understood”</strong> into <strong>“I shipped”</strong>. Social Sprint starts free, with login.</span>
    </p>
    <div class="dev-journey-meta" role="list">
      <div role="listitem">
        <strong>Bloco 0–2</strong>
        <span class="i18n-pt">Grátis para começar</span>
        <span class="i18n-en">Free to start</span>
      </div>
      <div role="listitem">
        <strong>Projetos reais</strong>
        <span class="i18n-pt">Aprender construindo</span>
        <span class="i18n-en">Learn by shipping</span>
      </div>
      <div role="listitem">
        <strong>Revisão manual</strong>
        <span class="i18n-pt">Certificação honesta</span>
        <span class="i18n-en">Honest certification</span>
      </div>
    </div>
    <div class="dev-journey-actions">
      <a class="dev-journey-btn" href={ROUTES.devJourney}>
        <span class="i18n-pt">Ver currículo</span>
        <span class="i18n-en">See curriculum</span>
        <span aria-hidden="true">→</span>
      </a>
      <a class="dev-journey-btn dev-journey-btn--ghost" href={ROUTES.devJourneyStudent}>
        <span class="i18n-pt">Área do aluno</span>
        <span class="i18n-en">Student area</span>
      </a>
    </div>
  </article>
</section>

<!-- MANIFESTO -->
<section class="manifesto">
  <div class="section-label reveal">
    <span class="i18n-pt">O Propósito</span>
    <span class="i18n-en">The purpose</span>
  </div>
  <div class="manifesto-text reveal">
    <p>
      <span class="i18n-pt">A VOLYNX nasceu de uma crença simples: <span class="highlight">tecnologia só vale quando ajuda alguém de verdade.</span></span>
      <span class="i18n-en">VOLYNX was built on a simple belief: <span class="highlight">technology only matters when it truly helps someone.</span></span>
    </p>
    <p>
      <span class="i18n-pt">Por isso cada área do ecossistema existe para resolver um problema concreto — criar com mais clareza, trabalhar com mais fluidez, vender melhor e apresentar ideias com mais força.</span>
      <span class="i18n-en">That is why each part of the ecosystem exists to solve a concrete problem — create with more clarity, work with more flow, sell better, and present ideas with more force.</span>
    </p>
    <p>
      <span class="i18n-pt">No fim, este lançamento não é sobre software por software. É sobre construir ferramentas com intenção, padrão alto e impacto real.</span>
      <span class="i18n-en">In the end, this launch is not about software for the sake of software. It is about building tools with intention, high standards, and real impact.</span>
    </p>
  </div>
</section>

<!-- CTA ENTER -->
<section class="cta-section">
  <div class="cta-label reveal">
    <span class="i18n-pt">A próxima etapa</span>
    <span class="i18n-en">The next step</span>
  </div>
  <h2 class="cta-heading reveal">
    <span class="i18n-pt">A apresentação termina aqui.<br><strong>A plataforma começa agora.</strong></span>
    <span class="i18n-en">The introduction ends here.<br><strong>The platform begins now.</strong></span>
  </h2>
  <a href={ROUTES.platform} class="enter-btn reveal">
    <span class="i18n-pt">Entrar na plataforma</span>
    <span class="i18n-en">Enter the platform</span>
    <span class="arrow">→</span>
  </a>
  <p class="cta-sub reveal">
    <span class="i18n-pt">volynx.world/platform</span>
    <span class="i18n-en">volynx.world/platform</span>
  </p>
</section>

<!-- SIGN -->
<footer class="sign">
  <div class="sign-name reveal">
    <span class="i18n-pt">Feito com código, suor e propósito</span>
    <span class="i18n-en">Made with code, sweat, and purpose</span>
  </div>
  <img src="/assets/wordmark.webp" alt="VOLYNX" class="sign-wordmark reveal" width="1375" height="750" loading="lazy" decoding="async" />
  <div class="sign-domain reveal">volynx.world</div>
</footer>

<script>
  window.VX_TRANS = {
    en: {
      "aria.toggle_lang": "Toggle language",
      "intro.meta_title": "Volynx — Welcome",
      "intro.meta_description": "Eight months without stopping. Long hours of work. A launch page that introduces VOLYNX and opens the platform at /platform."
    },
    pt: {
      "aria.toggle_lang": "Mudar idioma",
      "intro.meta_title": "Volynx — Bem-vindos",
      "intro.meta_description": "Oito meses sem parar. Muitas horas de trabalho. Um lançamento que apresenta a VOLYNX e abre a plataforma em /platform."
    }
  };
</script>
<script is:inline src="/js/i18n.js"></script>
<script src="/js/recording-mode.js?v=20260506" defer></script>
<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.12 });

<script src="/js/vx-touch-links.js?v=20260525" defer></script>
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  function syncIntroMeta(lang) {
    const normalized = String(lang || document.documentElement.lang || '').toLowerCase().startsWith('pt') ? 'pt' : 'en';
    const dict = window.VX_TRANS && window.VX_TRANS[normalized];
    if (!dict) return;
    document.title = dict["intro.meta_title"];
    const meta = document.getElementById('pageDescription');
    if (meta) meta.setAttribute('content', dict["intro.meta_description"]);
  }

  syncIntroMeta(document.documentElement.lang);
  window.addEventListener('vx:lang-changed', (event) => {
    syncIntroMeta(event.detail && event.detail.lang);
  });
</script>

</body>
</html>
