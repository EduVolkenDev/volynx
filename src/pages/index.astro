---
import HomeLayout from "../layouts/HomeLayout.astro";
import HomeMenus from "../components/HomeMenus.astro";
---

<HomeLayout>
  <canvas id="particles" aria-hidden="true" style="position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:1;"></canvas>
  <div class="universe-bg" aria-hidden="true"></div>

  <div class="shell">
    <div class="topbar">

      <!-- Brand / Hero -->
      <div class="brand">
        <div class="eye-container">
          <img src="/assets/volynx-icon.webp" alt="VOLYNX" class="volynx-eye-img" />
          <span class="eye-sheen" aria-hidden="true"></span>
        </div>
        <div class="brand-logo">
          <img src="/assets/wordmark.webp" alt="VOLYNX" class="brand-logo-img" />
          <div class="slogan" data-i18n="home.slogan">Building a Smarter Future.</div>
        </div>
      </div>

      <!-- Navigation Panels -->
      <HomeMenus />

      <!-- CTA Section -->
      <div class="cta-section">
        <div class="cta-title" data-i18n="home.cta_primary">ACCESS THE VOLYNX LAB</div>
        <div class="cta-subtitle" data-i18n="home.cta_explore">
          Explore technology, social impact, and many possible futures in a unique environment.
        </div>
        <div class="cta-buttons">
          <a href="/products/" class="cta-button primary"><span data-i18n="home.btn_kits">Explore the kits</span></a>
          <a href="/manifesto/" class="cta-button secondary"><span data-i18n="home.btn_manifesto">Read the manifesto</span></a>
        </div>
      </div>

      <div class="volynx-kits">
        <h2 data-i18n="home.kits_title">VOLYNX Kits</h2>
        Premium Kits for Devs and Designers — ready to sell and scale.</p>
        <div class="products-grid">
          <a class="product-card" href="/products/portfolio-pro-kit/">
            <div class="card-img"><img src="/assets/newportfolio.webp" alt="Portfolio Kit" /></div>
            <div class="card-text">
              <h3>Portfolio Pro-Kit</h3>
              <p>Premium Structure (Figma + Code) to Launch Fast and Look Expensive.</p>
            </div>
          </a>
          <a class="product-card" href="/products/agency-launch-kit/">
            <div class="card-img"><img src="/assets/newlaunch.webp" alt="Agency Launch Kit" /></div>
            <div class="card-text">
              <h3>Agency Launch Kit</h3>
              <p>Website + proposal/SOW/onboarding to close more deals without stress.</p>
            </div>
          </a>
          <a class="product-card" href="/products/saas-landing-system/">
            <div class="card-img"><img src="/assets/saasbig.webp" alt="SaaS Landing System" /></div>
            <div class="card-text">
              <h3>SaaS Landing System</h3>
              <p>Landing "section-first" with base copy/SEO and fast interaction.</p>
            </div>
          </a>
        </div>
      </div>
      </div>

      <!-- PropertyFlow -->
      <div class="products-grid">
          <a class="product-card" href="/products/propertyflow/">
            <div class="card-img"><img src="/assets/propertyflow.webp" alt="PropertyFlow" /></div>
            <div class="card-text">
              <span class="card-badge" data-i18n="home.pf_badge">New · Real Estate SaaS</span>
              <h3>PropertyFlow</h3>
              <p>Premium property management for real estate agencies — smart catalogue, bilingual interface, live filters and a polished showcase.</p>
            </div>
          </a>
      </div>

      <!-- VOLYNX Principles -->
      <section class="volynx-principles" id="volynx" aria-label="VOLYNX Principles">
        <h2 data-i18n="home.principles_title">VOLYNX Principles</h2>
        <p>Human touch, zero exposing: clear values, impeccable execution.</p>
        <div class="principles-grid">
          <div class="principle-card">
            <h3 data-i18n="home.p1">Clarity over noise</h3>
            <p>If not quickly understandable, not to sell!</p>
          </div>
          <div class="principle-card">
            <h3 data-i18n="home.p2">Systems beat one-offs</h3>
            <p>Design + code as system. Consistency = speed.</p>
          </div>
          <div class="principle-card">
            <h3 data-i18n="home.p3">Shipping is a feature</h3>
            <p>Real Delivery. No eternal "almost ready".</p>
          </div>
          <div class="principle-card">
            <h3 data-i18n="home.p4">Performance is trust</h3>
            <p>A fast website looks expensive. Slow website feels amateur.</p>
          </div>
          <div class="principle-card">
            <h3 data-i18n="home.p5">Docs reduce chaos</h3>
            <p>Documentation decreases support and increases scale.</p>
          </div>
        </div>
      </section>
      

       


      <!-- Products in Development + Kits -->
      <div class="future-products" id="products">
        <h2 data-i18n="home.future_title">Innovative Products in Development</h2>
        <p>Contribute to the future of sustainability and health with AI.</p>
        <div class="products-grid">
          <div class="product-card">
            <div class="card-img"><img src="/assets/carbontracker.webp" alt="Carbon Tracker" /></div>
            <div class="card-text">
              <span class="product-chip">IMPACT</span>
              <h3>Carbon Tracker</h3>
              <p>Real-time tracking of personal and business carbon impact.</p>
            </div>
          </div>
          <div class="product-card">
            <div class="card-img"><img src="/assets/safetyguardian.webp" alt="Safety Guardian" /></div>
            <div class="card-text">
              <span class="product-chip">SAFETY</span>
              <h3>Safety Guardian</h3>
              <p>Smart tools to analyse, route and respond to critical abuse reports.</p>
            </div>
          </div>
          <div class="product-card">
            <div class="card-img"><img src="/assets/precisionhealth.webp" alt="Precision Health" /></div>
            <div class="card-text">
              <span class="product-chip">HEALTH</span>
              <h3>Precision Health</h3>
              <p>AI tools for disease prevention and research, including HIV/AIDS and Cancer.</p>
            </div>
          </div>
        </div>
    </div><!-- /topbar -->

       

        

    <footer class="home-footer" aria-label="Site links">
      <a href="/about/">About</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href="/manifesto/">Manifesto</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href="/contact/">Contact</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href="/privacy/">Privacy</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href="/terms/">Terms</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href="/disclaimer/">Disclaimer</a>
    </footer>
  </div><!-- /shell -->

  <script src="/js/particles.js" defer></script>
</HomeLayout>
