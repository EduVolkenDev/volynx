---
import { ROUTES } from "../data/routes";

const platformSurfaces = [
  {
    num: "01",
    name: "VOLYNX Builder",
    desc: "Workspace no-code para criar e publicar sites premium com preview ao vivo, kits prontos e domínio próprio.",
    tag: "Sites & Publicação",
    href: ROUTES.builder,
  },
  {
    num: "02",
    name: "VOLYNX Daily",
    desc: "A camada operacional do dia a dia: My Day, Scanner, Summary, Vault, Writing e Decision dentro de um único sistema.",
    tag: "Rotina & Produtividade",
    href: ROUTES.daily,
  },
  {
    num: "03",
    name: "CVitae",
    desc: "Editor de currículo com preview ao vivo. Você monta grátis e exporta com acabamento premium quando precisar.",
    tag: "Carreira",
    href: ROUTES.cvitae,
  },
  {
    num: "04",
    name: "VOLYNX Lab + Studio Pro",
    desc: "Ferramentas no browser para converter, redimensionar e gerar assets. Lab é grátis; Studio Pro libera ações premium com VX.",
    tag: "Ferramentas & VX",
    href: ROUTES.lab,
  },
  {
    num: "05",
    name: "PropertyFlow",
    desc: "Plataforma imobiliária bilíngue com catálogo inteligente, filtros ao vivo e apresentação premium para agências e corretores.",
    tag: "Real Estate",
    href: ROUTES.propertyflow,
  },
  {
    num: "06",
    name: "Products",
    desc: "Catálogo dos kits, assets e do Icon Vault da VOLYNX: portfolio, SaaS, agência e packs prontos para usar.",
    tag: "Kits & Assets",
    href: ROUTES.products,
  },
  {
    num: "07",
    name: "Services",
    desc: "Projetos sob medida de site + marca, conduzidos por briefing, escopo claro e entrega profissional do início ao deploy.",
    tag: "Serviços Sob Medida",
    href: ROUTES.services,
  },
];
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Volynx — Bem-vindos</title>
<meta name="description" content="Oito meses sem parar. Muitas horas de trabalho. Um lançamento que apresenta a VOLYNX e abre a plataforma em /platform.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Mono:wght@300;400;500&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --black: #060608;
    --white: #f4f1ec;
    --cream: #e8e3d8;
    --gold: #c9a85c;
    --gold-dim: #8a6e3a;
    --text-muted: #6b6560;
    --border: rgba(201,168,92,0.18);
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--black);
    color: var(--white);
    font-family: 'DM Mono', monospace;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E");
    opacity: 0.028;
    pointer-events: none;
    z-index: 9999;
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    padding: 80px 24px;
    text-align: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 50% at 50% 60%, rgba(201,168,92,0.07) 0%, transparent 70%),
      radial-gradient(ellipse 40% 30% at 20% 80%, rgba(42,61,110,0.15) 0%, transparent 60%),
      radial-gradient(ellipse 30% 40% at 80% 20%, rgba(184,74,46,0.08) 0%, transparent 55%);
  }

  .hero-lines {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(0deg, transparent, transparent 79px, rgba(201,168,92,0.04) 80px);
    pointer-events: none;
  }

  .hero-counter {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 48px;
    opacity: 0;
    animation: fadeUp 1s 0.3s forwards;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hero-counter::before,
  .hero-counter::after {
    content: '';
    display: block;
    width: 40px;
    height: 1px;
    background: var(--gold);
    opacity: 0.5;
  }

  .hero-months {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(120px, 22vw, 260px);
    font-weight: 300;
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(201,168,92,0.3);
    opacity: 0;
    animation: fadeUp 1.2s 0.5s forwards;
    user-select: none;
  }

  .hero-months-label {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(18px, 3vw, 32px);
    font-weight: 300;
    font-style: italic;
    letter-spacing: 0.08em;
    color: var(--cream);
    margin-top: 8px;
    opacity: 0;
    animation: fadeUp 1s 0.8s forwards;
  }

  .hero-tagline {
    font-family: 'Syne', sans-serif;
    font-size: clamp(24px, 4.5vw, 52px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-top: 56px;
    max-width: 800px;
    opacity: 0;
    animation: fadeUp 1s 1.1s forwards;
  }

  .hero-tagline em {
    font-style: italic;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: 1.15em;
    color: var(--gold);
  }

  .scroll-hint {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
    animation: fadeIn 1s 2.5s forwards;
  }

  .scroll-hint span {
    font-size: 9px;
    letter-spacing: 0.3em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--gold), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  /* ── STORY ── */
  .story {
    max-width: 760px;
    margin: 0 auto;
    padding: 120px 24px;
  }

  .section-label {
    font-size: 10px;
    letter-spacing: 0.35em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 40px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .story-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(22px, 3.2vw, 32px);
    font-weight: 300;
    line-height: 1.65;
    color: var(--cream);
  }

  .story-text p { margin-bottom: 1.6em; }
  .story-text strong { font-weight: 600; color: var(--white); }
  .story-text .accent { color: var(--gold); font-style: italic; }
  .story-text .break {
    color: var(--text-muted);
    font-size: 0.8em;
    letter-spacing: 0.05em;
    font-family: 'DM Mono', monospace;
    font-style: normal;
    display: block;
    margin: 2em 0;
  }

  /* ── WELCOME ── */
  .welcome {
    padding: 80px 24px 120px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .welcome-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 60% at 50% 50%, rgba(201,168,92,0.06) 0%, transparent 70%);
  }

  .welcome-eyebrow {
    font-size: 10px;
    letter-spacing: 0.4em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 32px;
  }

  .welcome-title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(40px, 9vw, 110px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.9;
    margin-bottom: 16px;
  }

  .welcome-title .voly { color: var(--white); }
  .welcome-title .nx   { color: var(--gold); }

  .welcome-subtitle {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: clamp(18px, 2.5vw, 26px);
    font-weight: 300;
    color: var(--text-muted);
    margin-top: 24px;
    letter-spacing: 0.05em;
  }

  .divider {
    width: 100%;
    height: 1px;
    background: var(--border);
    max-width: 900px;
    margin: 0 auto;
  }

  /* ── ABOUT ── */
  .about {
    max-width: 900px;
    margin: 0 auto;
    padding: 100px 24px;
  }

  .about-intro {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(24px, 3.5vw, 38px);
    font-weight: 300;
    line-height: 1.5;
    color: var(--cream);
    margin-bottom: 64px;
    max-width: 700px;
  }

  .about-intro strong { font-weight: 600; color: var(--white); }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    margin-bottom: 80px;
  }

  .tool-card {
    background: var(--black);
    display: block;
    padding: 36px 32px;
    text-decoration: none;
    color: inherit;
    transition: background 0.3s;
    cursor: pointer;
    min-height: 100%;
  }

  .tool-card:hover { background: rgba(201,168,92,0.04); }
  .tool-card:hover .tool-num { color: var(--gold); }
  .tool-card:hover .tool-name { color: var(--gold); }

  .tool-num {
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--text-muted);
    margin-bottom: 20px;
    transition: color 0.3s;
  }

  .tool-name {
    font-family: 'Syne', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 12px;
    color: var(--white);
  }

  .tool-desc {
    font-size: 12px;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .tool-tag {
    display: inline-block;
    margin-top: 20px;
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-dim);
    border: 1px solid rgba(201,168,92,0.2);
    padding: 4px 10px;
  }

  /* ── MANIFESTO ── */
  .manifesto {
    border-top: 1px solid var(--border);
    padding: 100px 24px;
    max-width: 760px;
    margin: 0 auto;
  }

  .manifesto-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(20px, 3vw, 30px);
    font-weight: 300;
    line-height: 1.7;
    color: var(--cream);
  }

  .manifesto-text p { margin-bottom: 1.5em; }
  .manifesto-text .highlight { font-style: italic; color: var(--gold); }

  /* ── CTA ENTER ── */
  .cta-section {
    text-align: center;
    padding: 80px 24px 140px;
    border-top: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }

  .cta-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 50% 80% at 50% 100%, rgba(201,168,92,0.07) 0%, transparent 70%);
  }

  .cta-label {
    font-size: 10px;
    letter-spacing: 0.4em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 32px;
  }

  .cta-heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 6vw, 72px);
    font-weight: 300;
    font-style: italic;
    line-height: 1.1;
    color: var(--cream);
    margin-bottom: 48px;
  }

  .cta-heading strong {
    font-style: normal;
    font-weight: 600;
    color: var(--white);
  }

  /* Botão de entrada */
  .enter-btn {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    background: transparent;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 20px 48px;
    position: relative;
    cursor: pointer;
    transition: all 0.4s ease;
    overflow: hidden;
  }

  .enter-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--gold);
    transform: translateX(-101%);
    transition: transform 0.4s ease;
    z-index: 0;
  }

  .enter-btn:hover::before { transform: translateX(0); }

  .enter-btn:hover {
    color: var(--black);
  }

  .enter-btn span {
    position: relative;
    z-index: 1;
  }

  .enter-btn .arrow {
    position: relative;
    z-index: 1;
    transition: transform 0.3s ease;
  }

  .enter-btn:hover .arrow { transform: translateX(6px); }

  .cta-sub {
    margin-top: 24px;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  /* ── SIGN ── */
  .sign {
    text-align: center;
    padding: 60px 24px 80px;
    border-top: 1px solid var(--border);
  }

  .sign-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(14px, 2vw, 18px);
    font-style: italic;
    font-weight: 300;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .sign-title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 5vw, 52px);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  .sign-domain {
    margin-top: 16px;
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--gold-dim);
    text-transform: uppercase;
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes scrollPulse {
    0%, 100% { opacity: 0.4; }
    50%       { opacity: 1; }
  }

  .reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.9s ease, transform 0.9s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 600px) {
    .tools-grid { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<!-- HERO -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-lines"></div>
  <div class="hero-counter">8 meses de criação</div>
  <div class="hero-months">8</div>
  <div class="hero-months-label">oito meses sem parar</div>
  <h1 class="hero-tagline">
    Oito meses de trabalho intenso.<br>
    Dias de <em>mais de 30 horas.</em><br>
    Uma visão que virou VOLYNX.
  </h1>
  <div class="scroll-hint">
    <span>continuar</span>
    <div class="scroll-line"></div>
  </div>
</section>

<!-- STORY -->
<section class="story">
  <div class="section-label reveal">O processo</div>
  <div class="story-text reveal">
    <p>Por <strong>8 meses</strong>, tudo ao redor continuou andando enquanto eu voltava para a mesma tela, para a mesma ideia e para a mesma vontade de construir algo real.</p>
    <p>Foram <strong>8 meses sem pausa de verdade.</strong> Muitas horas por dia, noites inteiras e sessões de <span class="accent">mais de 30 horas programando sem parar</span>, ajustando arquitetura, interface, lógica e detalhe por detalhe.</p>
    <p>Construí a VOLYNX <strong>sozinho.</strong> Cada linha de código, cada decisão e cada pixel passaram pela mesma cabeça e pela mesma obsessão de fazer isso existir do jeito certo.</p>
    <span class="break">— — —</span>
    <p>Eu sempre quis ser programador não só para escrever software, mas para <span class="accent">criar algo maior</span> — algo que chegasse na vida real das pessoas com utilidade, padrão e impacto.</p>
    <p>Esses <strong>8 meses foram a travessia entre sonho e produto.</strong> O resultado é esta plataforma: um ecossistema pronto para começar.</p>
  </div>
</section>

<!-- WELCOME -->
<section class="welcome">
  <div class="welcome-bg"></div>
  <div class="welcome-eyebrow reveal">É com o coração cheio que eu digo</div>
  <h2 class="welcome-title reveal">
    <span class="voly">Bem-vindos à </span><span class="nx">Volynx</span>
  </h2>
  <p class="welcome-subtitle reveal">Um ecossistema criado do zero, com ambição real e padrão alto.</p>
</section>

<div class="divider"></div>

<!-- ABOUT -->
<section class="about">
  <div class="section-label reveal">O que é a Volynx</div>
  <p class="about-intro reveal">
    A VOLYNX não é uma ferramenta só. É um <strong>ecossistema conectado</strong>, onde cada área tem uma função real: criar, organizar, vender, entregar e escalar.
  </p>

  <div class="tools-grid reveal">
    {platformSurfaces.map((surface) => (
      <a class="tool-card" href={surface.href}>
        <div class="tool-num">{surface.num}</div>
        <div class="tool-name">{surface.name}</div>
        <div class="tool-desc">{surface.desc}</div>
        <div class="tool-tag">{surface.tag}</div>
      </a>
    ))}
  </div>
</section>

<!-- MANIFESTO -->
<section class="manifesto">
  <div class="section-label reveal">O Propósito</div>
  <div class="manifesto-text reveal">
    <p>A VOLYNX nasceu de uma crença simples: <span class="highlight">tecnologia só vale quando ajuda alguém de verdade.</span></p>
    <p>Por isso cada área do ecossistema existe para resolver um problema concreto — criar com mais clareza, trabalhar com mais fluidez, vender melhor e apresentar ideias com mais força.</p>
    <p>No fim, este lançamento não é sobre software por software. É sobre construir ferramentas com intenção, padrão alto e impacto real.</p>
  </div>
</section>

<!-- CTA ENTER -->
<section class="cta-section">
  <div class="cta-label reveal">A próxima etapa</div>
  <h2 class="cta-heading reveal">
    A apresentação termina aqui.<br>
    <strong>A plataforma começa agora.</strong>
  </h2>
  <a href={ROUTES.platform} class="enter-btn reveal">
    <span>Entrar na plataforma</span>
    <span class="arrow">→</span>
  </a>
  <p class="cta-sub reveal">volynx.world/platform</p>
</section>

<!-- SIGN -->
<footer class="sign">
  <div class="sign-name reveal">Feito com código, suor e propósito</div>
  <div class="sign-title reveal">Volynx</div>
  <div class="sign-domain reveal">volynx.world</div>
</footer>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.12 });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>

</body>
</html>
