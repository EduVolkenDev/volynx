---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../components/FlagshipHeader.astro";
import FlagshipFooter from "../components/FlagshipFooter.astro";
import { ROUTES } from "../data/routes";
---
<FlagshipLayout title="VOLYNX — Building a Smarter Future" pageClass="page-home">
  <FlagshipHeader current={ROUTES.home} ctaLabel="Access Studio Pro" />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero hero--home">
      <div class="shell hero-grid hero-grid--home">
        <div class="hero-copy">
          <span class="kicker">Flagship ecosystem</span>
          <h1>Build premium digital products with purpose, clarity and real momentum.</h1>
          <p>VOLYNX is the ecosystem for premium kits, browser-based tools and launch systems built for developers, designers and modern internet businesses. Cleaner than a portal. Stronger than a landing page. Structured like a real platform.</p>
          <div class="hero-actions">
            <a href="#ecosystem" class="button button--gold">Explore the ecosystem</a>
            <a href={ROUTES.products} class="button button--ghost">View premium kits</a>
          </div>
          <div class="hero-inline-stats">
            <div><strong>3 layers</strong><span>Lab · Builder · Studio</span></div>
            <div><strong>Mobile first</strong><span>Refined for tablet, notebook and 16"</span></div>
            <div><strong>Production logic</strong><span>Free for discovery, Pro for delivery</span></div>
          </div>
        </div>
        <div class="hero-visual hero-visual--flagship glass-stage">
          <div class="floating-asset floating-asset--lg">
            <img src="/assets/volynx-icon.webp" alt="VOLYNX icon" />
          </div>
          <div class="floating-asset floating-asset--sm floating-asset--left"></div>
          <div class="floating-asset floating-asset--sm floating-asset--right"></div>
          <div class="glass-card glass-card--metric">
            <span class="label label--pro">Studio Pro</span>
            <strong>Operate like a premium studio</strong>
            <p>Saved presets, brand memory, higher-quality outputs, commercial workflows and a cleaner workspace for users who are shipping for real.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ ECOSYSTEM ═══ -->
    <section id="ecosystem" class="page-section">
      <div class="shell section-head section-head--split">
        <div>
          <span class="eyebrow">What Volynx is</span>
          <h2>An ecosystem, not a pile of pages.</h2>
        </div>
        <p>The V3 structure turns the homepage into a clear brand narrative: what the platform is, what it sells now, what makes it valuable and what the future portfolio is building toward.</p>
      </div>
      <div class="shell grid-3">
        <article class="panel feature-card premium-frame">
          <span class="label">Premium Kits</span>
          <h3>Ship fast with premium systems</h3>
          <p>Launch-ready structures for portfolios, agencies, SaaS pages and premium vertical products.</p>
          <ul class="detail-list">
            <li>Design + copy + code logic</li>
            <li>Conversion-focused layouts</li>
            <li>Built for real publishing</li>
          </ul>
        </article>
        <article class="panel feature-card premium-frame">
          <span class="label label--free">VOLYNX Lab</span>
          <h3>Useful free tools that create trust</h3>
          <p>Local-first browser tools that are actually helpful, not bait. Clean enough for discovery. Strong enough to convert into Studio.</p>
          <ul class="detail-list">
            <li>Convert, upscale and generate</li>
            <li>Zero upload logic where possible</li>
            <li>Low friction trial experience</li>
          </ul>
        </article>
        <article class="panel feature-card premium-frame panel--pro">
          <span class="label label--pro">Builder + Studio</span>
          <h3>Production workflow with more command</h3>
          <p>Publishing, custom domains, brand control, premium exports, workflow memory and a serious Pro workspace.</p>
          <ul class="detail-list">
            <li>More power, not just more limits</li>
            <li>Cleaner dashboard logic</li>
            <li>Ready for pro and team expansion</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- ═══ FEATURED PRODUCTS (editorial) ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow">Featured now</span>
        <h2>Commercial products first. Vision immediately after.</h2>
        <p>The homepage now prioritizes what users can buy, use or trust today before it introduces R&amp;D and future-facing concepts.</p>
      </div>
      <div class="shell editorial-grid">
        <article class="panel gallery-card gallery-card--xl" style="background-image:url('/assets/newportfolio.webp')">
          <span class="label">Flagship kit</span>
          <h3>Portfolio Pro Kit</h3>
          <p>Launch fast, look expensive and give your personal brand a real operating system.</p>
          <div class="actions"><a href={ROUTES.portfolioKit} class="button button--ghost">Open kit</a></div>
        </article>
        <article class="panel gallery-card" style="background-image:url('/assets/newlaunch.webp')">
          <span class="label">For agencies</span>
          <h3>Agency Launch Kit</h3>
          <p>Proposal, SOW and premium website structure built to close with less friction.</p>
          <div class="actions"><a href={ROUTES.agencyKit} class="button button--ghost">Open kit</a></div>
        </article>
        <article class="panel gallery-card" style="background-image:url('/assets/saasbig.webp')">
          <span class="label">For SaaS</span>
          <h3>SaaS Landing System</h3>
          <p>Section-first, speed-aware and ready to turn product value into conviction.</p>
          <div class="actions"><a href={ROUTES.saasSystem} class="button button--ghost">Open kit</a></div>
        </article>
      </div>
      <div class="shell spotlight-row">
        <article class="panel spotlight-card panel--pro">
          <div>
            <span class="label label--pro">New · Real estate SaaS</span>
            <h3>PropertyFlow deserves its own stage.</h3>
            <p>A bilingual property platform with stronger catalog logic, polished filtering and a visual language that already feels like a product line, not just a listing page.</p>
          </div>
          <a href={ROUTES.propertyflow} class="button button--gold">View PropertyFlow</a>
        </article>
      </div>
    </section>

    <!-- ═══ PRINCIPLES ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow">Operating philosophy</span>
        <h2>Premium direction needs principles, not decoration.</h2>
      </div>
      <div class="shell grid-2 principles-grid-v3">
        <article class="panel principle-panel"><h3>Clear by default</h3><p>If users cannot understand the value in seconds, the page is still unfinished.</p></article>
        <article class="panel principle-panel"><h3>Built as systems</h3><p>Layouts, tools and products need to scale without feeling random or stitched together.</p></article>
        <article class="panel principle-panel"><h3>Shipped for real use</h3><p>Real publishing, real workflows and real delivery matter more than aspirational mockups alone.</p></article>
        <article class="panel principle-panel"><h3>Fast enough to feel expensive</h3><p>Performance is part of luxury. Slowness cheapens the whole product experience.</p></article>
      </div>
    </section>

    <!-- ═══ R&D PORTFOLIO ═══ -->
    <section class="page-section">
      <div class="shell section-head section-head--split">
        <div>
          <span class="eyebrow">R&amp;D portfolio</span>
          <h2>Future-facing products, curated instead of crammed.</h2>
        </div>
        <p>Future ideas sit lower in the page, where they reinforce ambition without competing with immediate monetization.</p>
      </div>
      <div class="shell grid-3">
        <article class="panel product-vision"><span class="label">Impact</span><h3>Carbon Tracker</h3><p>Real-time tracking of personal and business carbon impact with premium visualization.</p></article>
        <article class="panel product-vision"><span class="label">Safety</span><h3>Safety Guardian</h3><p>Smart systems for routing, triaging and responding to critical abuse reports.</p></article>
        <article class="panel product-vision"><span class="label">Health</span><h3>Precision Health</h3><p>AI tools for disease prevention, early detection and research operations.</p></article>
      </div>
    </section>

    <!-- ═══ FINAL CTA ═══ -->
    <section class="page-section page-section--last">
      <div class="shell callout callout--heroic panel panel--pro">
        <div>
          <span class="label label--pro">From lab to studio</span>
          <strong>Free should feel generous. Pro should feel inevitable.</strong>
          <p>That rule now shapes the entire platform: home, pricing, tools, builder and account surfaces.</p>
        </div>
        <div class="hero-actions">
          <a href={ROUTES.pricing} class="button button--gold">See the pricing logic</a>
          <a href={ROUTES.profile} class="button button--ghost">Open Pro Command Center</a>
        </div>
      </div>
    </section>

  </main>
  <FlagshipFooter />
</FlagshipLayout>
