---
import HomeLayout from "../layouts/HomeLayout.astro";
import HomeMenus from "../components/HomeMenus.astro";
---

<HomeLayout>
  <div class="universe-bg" aria-hidden="true"></div>

  <div class="shell">
    <div class="topbar">

      <!-- Brand / Hero -->
      <div class="brand">
        <div class="eye-container">
          <img src="/assets/volynx-icon.webp" alt="VOLYNX" class="volynx-eye-img" />
          <span class="eye-sheen" aria-hidden="true"></span>
        </div>
        <div class="brand-logo">
          <img src="/assets/wordmark.webp" alt="VOLYNX" class="brand-logo-img" />
          <div class="slogan">Building a Smarter Future.</div>
        </div>
      </div>

      <!-- Navigation Panels -->
      <HomeMenus />

      <!-- CTA Section -->
      <div class="cta-section">
        <div class="cta-title">ACCESS THE VOLYNX LAB</div>
        <div class="cta-subtitle">
          Explore technology, social impact, and many possible futures in a unique environment.
        </div>
        <div class="cta-buttons">
          <a href="/products/" class="cta-button primary"><span>Explore the kits</span></a>
          <a href="/manifesto/" class="cta-button secondary"><span>Read the manifesto</span></a>
        </div>
      </div>

      <!-- VOLYNX Principles -->
      <section class="volynx-principles" id="volynx" aria-label="VOLYNX Principles">
        <h2>VOLYNX Principles</h2>
        <p>Human touch, zero exposing: clear values, impeccable execution.</p>
        <div class="principles-grid">
          <div class="principle-card">
            <h3>Clarity over noise</h3>
            <p>If not quickly understandable, not to sell!</p>
          </div>
          <div class="principle-card">
            <h3>Systems beat one-offs</h3>
            <p>Design + code as system. Consistency = speed.</p>
          </div>
          <div class="principle-card">
            <h3>Shipping is a feature</h3>
            <p>Real Delivery. No eternal "almost ready".</p>
          </div>
          <div class="principle-card">
            <h3>Performance is trust</h3>
            <p>A fast website looks expensive. Slow website feels amateur.</p>
          </div>
          <div class="principle-card">
            <h3>Docs reduce chaos</h3>
            <p>Documentation decreases support and increases scale.</p>
          </div>
        </div>
      </section>
      <h2>VOLYNX Kits</h2>
        <p>Portfolios and premium kits for devs/designers — ready to sell and scale.</p>
        <div class="products-grid">
          <a class="product-card" href="/products/portfolio-pro-kit/">
            <div class="card-img"><img src=/assets/portfolio.webp alt="Portfolio Kit"> </div>
            <div class="product-chip">PORTFOLIO</div>
            <h3>Portfolio Pro-Kit</h3>
            <p>Premium structure (Figma + Code) to launch fast and look expensive.</p>
          </a>
          <a class="product-card" href="/products/agency-launch-kit/">
                        <div class="card-img"><img src=/assets/launcher.webp alt="Agency Launch Kit"> </div>
            <div class="product-chip">AGENCY</div>
            <h3>Agency Launch Kit</h3>
            <p>Website + proposal/SOW/onboarding to close more deals and stress less.</p>
          </a>
          <a class="product-card" href="/products/saas-landing-system/">
                                    <div class="card-img"><img src=/assets/saas.webp alt="Agency Launch Kit"> </div>

            <div class="product-chip">LANDING</div>
            <h3>SaaS Landing System</h3>
            <p>Landing "section-first" with base copy/SEO and fast interaction.</p>
          </a>
        </div>
      </div>

       <!-- PropertyFlow Featured Promo -->
        <a href="/products/propertyflow/" style="
          display: block;
          margin-bottom: 32px;
          border-radius: 20px;
          overflow: hidden;
          border: 1px solid rgba(214,179,106,0.28);
          background:
            radial-gradient(ellipse 80% 120% at 0% 50%, rgba(89,195,255,0.07), transparent 50%),
            radial-gradient(ellipse 60% 100% at 100% 50%, rgba(139,92,246,0.07), transparent 50%),
            linear-gradient(135deg, rgba(214,179,106,0.10), rgba(7,7,11,0.95));
          padding: 28px 32px;
          text-decoration: none;
          color: white;
          transition: border-color 220ms ease, transform 220ms ease, box-shadow 220ms ease;
          box-shadow: 0 12px 48px rgba(0,0,0,0.45);
        "
        onmouseover="this.style.borderColor='rgba(214,179,106,0.55)';this.style.transform='translateY(-3px)';this.style.boxShadow='0 20px 60px rgba(0,0,0,0.55)'"
        onmouseout="this.style.borderColor='rgba(214,179,106,0.28)';this.style.transform='translateY(0)';this.style.boxShadow='0 12px 48px rgba(0,0,0,0.45)'"
        >
          <div style="display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;">
            <div>
              <div style="
                display:inline-flex;align-items:center;gap:8px;
                padding:5px 12px;border-radius:999px;
                background:rgba(214,179,106,0.12);
                border:1px solid rgba(214,179,106,0.28);
                color:#ead8aa;font-size:12px;letter-spacing:0.06em;text-transform:uppercase;
                margin-bottom:14px;font-family:var(--display);
              ">
                <span style="width:6px;height:6px;border-radius:999px;background:#d6b36a;display:inline-block;box-shadow:0 0 8px #d6b36a;"></span>
                New · Real Estate SaaS
              </div>
              <div style="font-size:clamp(20px,4vw,30px);font-weight:800;letter-spacing:-0.04em;margin-bottom:10px;font-style:italic;color:#f1deaa;font-family:var(--display);">
                PropertyFlow
              </div>
              <p style="margin:0;color:rgba(255,255,255,0.62);font-size:clamp(14px,2.5vw,16px);max-width:56ch;line-height:1.7;">
                Premium property management for real estate agencies — smart catalogue, bilingual interface, live filters and a polished showcase.
              </p>
            </div>
            <div style="
              display:inline-flex;align-items:center;gap:8px;
              padding:12px 22px;border-radius:999px;
              background:linear-gradient(135deg,#f1deaa,#d6b36a);
              color:#0a0a0f;font-weight:700;font-size:14px;
              white-space:nowrap;flex-shrink:0;
            ">
              Explore PropertyFlow →
            </div>
          </div>
        </a>


      <!-- Products in Development + Kits -->
      <div class="future-products" id="products">
        <h2>Innovative Products in Development</h2>
        <p>Contribute to the future of sustainability and health with AI.</p>
        <div class="products-grid">
          <div class="product-card">
            <div class="product-chip">IMPACT</div>
            <h3>Carbon Tracker</h3>
            <p>Real-time tracking of personal and business carbon impact.</p>
          </div>
          <div class="product-card">
            <div class="product-chip">SAFETY</div>
            <h3>Safety Guardian</h3>
            <p>Smart tools to analyse, route and respond to critical abuse reports.</p>
          </div>
          <div class="product-card">
            <div class="product-chip">HEALTH</div>
            <h3>Precision Health</h3>
            <p>AI tools for disease prevention and research, including HIV/AIDS and Cancer.</p>
          </div>
        </div>
    </div><!-- /topbar -->

       

        

    <footer class="home-footer" aria-label="Site links">
      <a href="/about">About</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href="/manifesto">Manifesto</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href="/contact">Contact</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href="/privacy">Privacy</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href="/terms">Terms</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href="/disclaimer">Disclaimer</a>
    </footer>
  </div><!-- /shell -->
</HomeLayout>
