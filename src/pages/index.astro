<script is:inline>
  // ── Scroll-aware header (light → solid on scroll) ──────────────
  (function () {
    const body = document.body;
    if (!body || !body.classList.contains('page-home-premium')) return;
    let ticking = false;
    function update() {
      const scrolled = window.scrollY > 40;
      body.classList.toggle('is-scrolled', scrolled);
      ticking = false;
    }
    window.addEventListener('scroll', function () {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
    update();
  })();

  // ── Reveal-on-scroll (lightweight IntersectionObserver) ────────
  (function () {
    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll('.hp-reveal');
    if (reduce || !('IntersectionObserver' in window)) {
      targets.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }
    const io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    targets.forEach(function (el) { io.observe(el); });
  })();
</script>
