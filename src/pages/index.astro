---
import PlatformHome from "./platform.astro";
---

<script is:inline>
  (function () {
    try {
      var launchSeenKey = "volynx_launch_seen_v2";
      if (localStorage.getItem(launchSeenKey) !== "1") {
        window.location.replace("/volynx-launch/");
      }
    } catch (_) {}
  })();
</script>

<PlatformHome />
