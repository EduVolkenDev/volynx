---
import FaviconHead from "../../components/FaviconHead.astro";
import { ROUTES } from "../../data/routes";

const devHubHref = ROUTES.devHub;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="VOLYNX Core — da intenção ao impacto executável." />
    <title>VOLYNX Core — Da intenção ao impacto</title>
    <FaviconHead />
  </head>
  <body>
    <div class="ambient ambient--one" aria-hidden="true"></div>
    <div class="ambient ambient--two" aria-hidden="true"></div>
    <div class="starfield" aria-hidden="true"></div>

    <header class="core-header">
      <a class="brand" href={ROUTES.core} aria-label="VOLYNX Core home">
        <img src="/assets/V.webp" alt="" width="40" height="40" />
        <span>VOLYNX <small>CORE</small></span>
      </a>
      <nav aria-label="Core navigation">
        <a href="#pathways" data-en="Explore" data-pt="Explorar">Explorar</a>
        <a href={ROUTES.manifesto} data-en="Vision" data-pt="Visão">Visão</a>
        <a href={devHubHref} data-en="Dev Hub" data-pt="Dev Hub">Dev Hub</a>
      </nav>
      <button class="language" type="button" data-language-toggle aria-label="Mudar idioma">PT / EN</button>
    </header>

    <main id="top">
      <section class="hero core-shell" aria-labelledby="hero-title">
        <div class="hero__copy reveal">
          <p class="eyebrow"><span class="eyebrow__signal" aria-hidden="true"></span><span data-en="VOLYNX Core" data-pt="VOLYNX Core">VOLYNX Core</span></p>
          <h1 id="hero-title">
            <span data-en="Intention is the beginning." data-pt="A intenção é o começo.">A intenção é o começo.</span>
            <em data-en="Impact is the path." data-pt="O impacto é o caminho.">O impacto é o caminho.</em>
          </h1>
          <p class="hero__lead" data-en="VOLYNX helps turn what you want to change into a clearer problem, a responsible next step and the tools to make it real." data-pt="A VOLYNX transforma o que você quer mudar em um problema mais claro, um próximo passo responsável e as ferramentas para torná-lo real.">
            A VOLYNX transforma o que você quer mudar em um problema mais claro, um próximo passo responsável e as ferramentas para torná-lo real.
          </p>
          <div class="hero__actions">
            <a class="button button--primary" href="#begin" data-en="Start with your intention" data-pt="Começar pela sua intenção">Começar pela sua intenção</a>
            <a class="button button--quiet" href={ROUTES.manifesto} data-en="Understand the vision" data-pt="Entender a visão">Entender a visão</a>
          </div>
          <p class="hero__trust" data-en="No empty promises. One clear next step." data-pt="Sem promessas vazias. Um próximo passo claro.">Sem promessas vazias. Um próximo passo claro.</p>
        </div>

        <div class="signal-stage reveal reveal--late" aria-label="VOLYNX Core signal">
          <div class="signal-stage__halo signal-stage__halo--outer"></div>
          <div class="signal-stage__halo signal-stage__halo--inner"></div>
          <div class="signal-stage__axis signal-stage__axis--one"></div>
          <div class="signal-stage__axis signal-stage__axis--two"></div>
          <div class="signal-stage__core">
            <img src="/assets/V.webp" alt="" width="70" height="70" />
            <span>CORE</span>
          </div>
          <div class="signal-label signal-label--top"><span>01</span><b data-en="INTENTION" data-pt="INTENÇÃO">INTENÇÃO</b></div>
          <div class="signal-label signal-label--right"><span>02</span><b data-en="ACTION" data-pt="AÇÃO">AÇÃO</b></div>
          <div class="signal-label signal-label--bottom"><span>03</span><b data-en="EVIDENCE" data-pt="EVIDÊNCIA">EVIDÊNCIA</b></div>
        </div>
      </section>

      <section class="intro core-shell reveal" id="begin" aria-labelledby="begin-title">
        <div class="section-kicker"><span>01</span><span data-en="Begin with what matters" data-pt="Comece pelo que importa">Comece pelo que importa</span></div>
        <div class="intro__grid">
          <div>
            <h2 id="begin-title" data-en="What are you trying to make possible?" data-pt="O que você está tentando tornar possível?">O que você está tentando tornar possível?</h2>
          </div>
          <div class="intro__body">
            <p data-en="The first VOLYNX experience should not make you learn a catalogue. It should help you clarify the work in front of you." data-pt="A primeira experiência VOLYNX não deve obrigar você a aprender um catálogo. Ela deve ajudar a esclarecer o trabalho que está diante de você.">A primeira experiência VOLYNX não deve obrigar você a aprender um catálogo. Ela deve ajudar a esclarecer o trabalho que está diante de você.</p>
            <a class="text-link" href="#pathways" data-en="See the paths →" data-pt="Ver os caminhos →">Ver os caminhos →</a>
          </div>
        </div>
      </section>

      <section class="pathways core-shell" id="pathways" aria-labelledby="pathways-title">
        <div class="section-heading reveal">
          <div class="section-kicker"><span>02</span><span data-en="A connected system" data-pt="Um sistema conectado">Um sistema conectado</span></div>
          <h2 id="pathways-title" data-en="From intention to a real next move." data-pt="Da intenção ao próximo movimento real.">Da intenção ao próximo movimento real.</h2>
        </div>
        <div class="path-grid">
          <article class="path-card path-card--intention reveal">
            <div class="path-card__number">01</div>
            <p class="path-card__label" data-en="Clarify" data-pt="Esclarecer">Esclarecer</p>
            <h3 data-en="See the problem clearly." data-pt="Enxergar o problema com clareza.">Enxergar o problema com clareza.</h3>
            <p data-en="Turn a vague goal into an Impact Map with an audience, assumptions, risks and a first measurable outcome." data-pt="Transforme um objetivo vago em um Mapa de Impacto com público, hipóteses, riscos e um primeiro resultado mensurável.">Transforme um objetivo vago em um Mapa de Impacto com público, hipóteses, riscos e um primeiro resultado mensurável.</p>
          </article>
          <article class="path-card path-card--action reveal reveal--late">
            <div class="path-card__number">02</div>
            <p class="path-card__label" data-en="Build" data-pt="Construir">Construir</p>
            <h3 data-en="Use the right capability." data-pt="Usar a capacidade certa.">Usar a capacidade certa.</h3>
            <p data-en="Move into the Dev Hub only when a tool helps: Builder, Daily, Lab, Services or an existing VOLYNX product." data-pt="Entre no Dev Hub quando uma ferramenta ajudar: Builder, Daily, Lab, Services ou um produto VOLYNX existente.">Entre no Dev Hub quando uma ferramenta ajudar: Builder, Daily, Lab, Services ou um produto VOLYNX existente.</p>
          </article>
          <article class="path-card path-card--evidence reveal reveal--later">
            <div class="path-card__number">03</div>
            <p class="path-card__label" data-en="Learn" data-pt="Comprovar">Comprovar</p>
            <h3 data-en="Know what changed." data-pt="Saber o que mudou.">Saber o que mudou.</h3>
            <p data-en="Keep evidence of progress, uncertainty and outcome. Impact is something we learn, not something we claim." data-pt="Registre progresso, incerteza e resultado. Impacto é algo que aprendemos, não algo que apenas declaramos.">Registre progresso, incerteza e resultado. Impacto é algo que aprendemos, não algo que apenas declaramos.</p>
          </article>
        </div>
      </section>

      <section class="handoff core-shell reveal" aria-labelledby="handoff-title">
        <div class="handoff__copy">
          <div class="section-kicker"><span>03</span><span data-en="The Dev Hub underneath" data-pt="O Dev Hub por baixo">O Dev Hub por baixo</span></div>
          <h2 id="handoff-title" data-en="The vision gets you moving. The Dev Hub helps you ship." data-pt="A visão coloca você em movimento. O Dev Hub ajuda você a entregar.">A visão coloca você em movimento. O Dev Hub ajuda você a entregar.</h2>
          <p data-en="The tools already built by VOLYNX become part of the new experience — available when useful, never forced as the starting point." data-pt="As ferramentas que a VOLYNX já construiu passam a fazer parte da nova experiência — disponíveis quando ajudam, nunca impostas como ponto de partida.">As ferramentas que a VOLYNX já construiu passam a fazer parte da nova experiência — disponíveis quando ajudam, nunca impostas como ponto de partida.</p>
          <a class="text-link" href={devHubHref} data-en="Enter the existing Dev Hub →" data-pt="Entrar no Dev Hub atual →">Entrar no Dev Hub atual →</a>
        </div>
        <div class="hub-list">
          <a href={ROUTES.builder}><span>BUILD</span><strong>Builder</strong><small data-en="Create and publish" data-pt="Criar e publicar">Criar e publicar</small></a>
          <a href={ROUTES.daily}><span>OPERATE</span><strong>Daily</strong><small data-en="Plan and focus" data-pt="Planejar e focar">Planejar e focar</small></a>
          <a href={ROUTES.lab}><span>MAKE</span><strong>Lab</strong><small data-en="Create locally" data-pt="Criar localmente">Criar localmente</small></a>
          <a href={ROUTES.world}><span>CONNECT</span><strong>World</strong><small data-en="Find people and resources" data-pt="Encontrar pessoas e recursos">Encontrar pessoas e recursos</small></a>
        </div>
      </section>

      <section class="future core-shell reveal" aria-labelledby="future-title">
        <div class="section-heading">
          <div class="section-kicker"><span>04</span><span data-en="Research directions" data-pt="Direções de pesquisa">Direções de pesquisa</span></div>
          <h2 id="future-title" data-en="The future is a direction, not a claim." data-pt="O futuro é uma direção, não uma promessa.">O futuro é uma direção, não uma promessa.</h2>
          <p data-en="These ideas remain signals of where VOLYNX can go. They become products only when a real problem, safe boundary and measurable outcome are clear." data-pt="Estas ideias continuam sinalizando para onde a VOLYNX pode ir. Só se tornam produtos quando houver problema real, limite seguro e resultado mensurável.">Estas ideias continuam sinalizando para onde a VOLYNX pode ir. Só se tornam produtos quando houver problema real, limite seguro e resultado mensurável.</p>
        </div>
        <div class="future-grid">
          <article><span>IMPACT / RESEARCH</span><h3>Carbon Tracker</h3><p data-en="Make personal and organisational environmental decisions more visible." data-pt="Tornar decisões ambientais pessoais e organizacionais mais visíveis.">Tornar decisões ambientais pessoais e organizacionais mais visíveis.</p></article>
          <article><span>SAFETY / RESEARCH</span><h3>Safety Guardian</h3><p data-en="Explore responsible routing and support for critical reports with humans in control." data-pt="Explorar encaminhamento responsável e apoio para relatos críticos, com humanos no controle.">Explorar encaminhamento responsável e apoio para relatos críticos, com humanos no controle.</p></article>
          <article><span>HEALTH / RESEARCH</span><h3>Precision Health</h3><p data-en="Support prevention and research workflows without presenting medical advice as a product promise." data-pt="Apoiar prevenção e fluxos de pesquisa sem apresentar aconselhamento médico como promessa de produto.">Apoiar prevenção e fluxos de pesquisa sem apresentar aconselhamento médico como promessa de produto.</p></article>
        </div>
      </section>

      <section class="closing core-shell reveal" aria-labelledby="closing-title">
        <div class="closing__mark" aria-hidden="true"><img src="/assets/V.webp" alt="" width="56" height="56" /></div>
        <p class="eyebrow" data-en="A first Core direction" data-pt="Uma primeira direção para o Core">Uma primeira direção para o Core</p>
        <h2 id="closing-title" data-en="Build what makes a better future more possible." data-pt="Construa o que torna um futuro melhor mais possível.">Construa o que torna um futuro melhor mais possível.</h2>
        <div class="closing__actions">
          <a class="button button--primary" href="#begin" data-en="Begin the journey" data-pt="Começar a jornada">Começar a jornada</a>
          <a class="button button--quiet" href={ROUTES.launch2026} data-en="See the original story" data-pt="Ver a história original">Ver a história original</a>
        </div>
      </section>
    </main>

    <footer class="core-footer core-shell">
      <span>VOLYNX / CORE PREVIEW</span>
      <span data-en="A new layer. Existing work preserved." data-pt="Uma nova camada. O trabalho existente preservado.">Uma nova camada. O trabalho existente preservado.</span>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector("[data-language-toggle]");
        const setLanguage = (language) => {
          root.lang = language === "pt" ? "pt-BR" : "en";
          document.querySelectorAll("[data-en][data-pt]").forEach((node) => {
            node.textContent = node.dataset[language === "pt" ? "pt" : "en"] || node.textContent;
          });
          if (toggle) toggle.textContent = language === "pt" ? "PT / EN" : "EN / PT";
          try { localStorage.setItem("volynx_core_preview_language", language); } catch (_) {}
        };
        let language = "pt";
        try { language = localStorage.getItem("volynx_core_preview_language") || "pt"; } catch (_) {}
        setLanguage(language);
        toggle?.addEventListener("click", () => setLanguage(root.lang.startsWith("pt") ? "en" : "pt"));

        const reduceMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
        const reveals = document.querySelectorAll(".reveal");
        if (reduceMotion || !("IntersectionObserver" in window)) {
          reveals.forEach((node) => node.classList.add("is-visible"));
        } else {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
          reveals.forEach((node) => observer.observe(node));
        }
      })();
    </script>
  </body>
</html>

<style>
  :root {
    --ink: #f5f6ff;
    --muted: rgba(211, 214, 236, .68);
    --soft: rgba(211, 214, 236, .48);
    --line: rgba(255, 255, 255, .13);
    --violet: #a78bfa;
    --cyan: #6ee7f9;
    --gold: #e9d7a5;
    --bg: #03040b;
    --display: "Manrope", system-ui, sans-serif;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--bg); }
  body { margin: 0; overflow-x: hidden; color: var(--ink); background: var(--bg); font-family: var(--display); -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; }
  .ambient, .starfield { position: fixed; inset: 0; pointer-events: none; }
  .ambient { z-index: -3; filter: blur(12px); }
  .ambient--one { background: radial-gradient(circle at 70% 15%, rgba(124, 58, 237, .23), transparent 27%), radial-gradient(circle at 12% 70%, rgba(14, 165, 233, .14), transparent 24%); }
  .ambient--two { background: radial-gradient(circle at 42% 36%, rgba(167, 139, 250, .10), transparent 20%), linear-gradient(180deg, rgba(3, 4, 11, .12), rgba(3, 4, 11, .92)); z-index: -2; }
  .starfield { z-index: -1; opacity: .65; background-image: radial-gradient(1px 1px at 12% 18%, #fff, transparent 70%), radial-gradient(1px 1px at 74% 13%, #fff, transparent 70%), radial-gradient(1px 1px at 89% 42%, #fff, transparent 70%), radial-gradient(1px 1px at 22% 67%, #fff, transparent 70%), radial-gradient(1px 1px at 57% 84%, #fff, transparent 70%), radial-gradient(1px 1px at 38% 31%, #fff, transparent 70%), radial-gradient(1px 1px at 8% 91%, #fff, transparent 70%); }
  .core-shell { width: min(1180px, calc(100% - 48px)); margin-inline: auto; }
  .core-header { position: relative; z-index: 5; width: min(1280px, calc(100% - 48px)); margin-inline: auto; padding: 22px 0; display: flex; align-items: center; justify-content: space-between; gap: 24px; border-bottom: 1px solid rgba(255,255,255,.08); }
  .brand { display: inline-flex; align-items: center; gap: 11px; font-size: .82rem; font-weight: 800; letter-spacing: .16em; }
  .brand img { object-fit: contain; filter: drop-shadow(0 0 16px rgba(167,139,250,.42)); }
  .brand small { display: block; margin-top: 3px; color: var(--gold); font-size: .52rem; letter-spacing: .32em; font-weight: 700; }
  nav { display: flex; align-items: center; gap: 26px; color: var(--muted); font-size: .78rem; letter-spacing: .09em; text-transform: uppercase; }
  nav a, .language { transition: color .2s ease, border-color .2s ease; }
  nav a:hover, nav a:focus-visible { color: var(--ink); }
  .language { border: 1px solid var(--line); border-radius: 999px; padding: 9px 13px; color: var(--muted); background: rgba(255,255,255,.035); cursor: pointer; font-size: .7rem; letter-spacing: .12em; }
  .language:hover, .language:focus-visible { color: var(--ink); border-color: rgba(233,215,165,.55); }
  .hero { min-height: 760px; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(380px, .95fr); align-items: center; gap: clamp(42px, 8vw, 120px); padding-top: 64px; padding-bottom: 86px; }
  .eyebrow, .section-kicker, .path-card__label, .future-grid span { color: var(--gold); font-size: .68rem; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
  .eyebrow { display: flex; align-items: center; gap: 10px; }
  .eyebrow__signal { width: 7px; height: 7px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 18px var(--cyan); }
  h1, h2, h3, p { margin-top: 0; }
  h1 { max-width: 720px; margin-bottom: 26px; font-size: clamp(3.8rem, 7.2vw, 7.6rem); line-height: .91; letter-spacing: -.075em; font-weight: 700; }
  h1 em { display: block; color: transparent; background: linear-gradient(115deg, #fff 5%, var(--violet) 58%, var(--cyan)); -webkit-background-clip: text; background-clip: text; font-style: normal; }
  .hero__lead { max-width: 580px; color: var(--muted); font-size: clamp(1rem, 1.55vw, 1.2rem); line-height: 1.7; }
  .hero__actions, .closing__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 13px 19px; border-radius: 999px; font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; transition: transform .22s ease, border-color .22s ease, background .22s ease, box-shadow .22s ease; }
  .button:hover, .button:focus-visible { transform: translateY(-2px); }
  .button--primary { color: #0a0711; background: linear-gradient(120deg, #fff, var(--gold)); box-shadow: 0 14px 40px rgba(233,215,165,.18); }
  .button--quiet { border: 1px solid var(--line); color: var(--ink); background: rgba(255,255,255,.035); }
  .button--quiet:hover, .button--quiet:focus-visible { border-color: rgba(167,139,250,.7); background: rgba(167,139,250,.09); }
  .hero__trust { margin: 22px 0 0; color: var(--soft); font-size: .77rem; letter-spacing: .07em; }
  .signal-stage { position: relative; min-height: 540px; display: grid; place-items: center; isolation: isolate; }
  .signal-stage::before { content: ""; position: absolute; width: 46%; aspect-ratio: 1; border-radius: 50%; background: rgba(110,231,249,.10); filter: blur(55px); z-index: -1; }
  .signal-stage__halo { position: absolute; border: 1px solid rgba(167,139,250,.35); border-radius: 50%; transform: rotate(-24deg); }
  .signal-stage__halo--outer { width: min(500px, 90%); aspect-ratio: 1; box-shadow: inset 0 0 80px rgba(124,58,237,.07), 0 0 60px rgba(124,58,237,.10); }
  .signal-stage__halo--inner { width: 63%; aspect-ratio: 1; border-color: rgba(110,231,249,.42); transform: rotate(32deg); }
  .signal-stage__axis { position: absolute; width: 1px; height: 86%; background: linear-gradient(180deg, transparent, rgba(255,255,255,.25), transparent); }
  .signal-stage__axis--one { transform: rotate(62deg); }
  .signal-stage__axis--two { transform: rotate(-62deg); }
  .signal-stage__core { width: 150px; height: 150px; display: grid; place-items: center; align-content: center; gap: 6px; border: 1px solid rgba(233,215,165,.65); border-radius: 50%; background: radial-gradient(circle at 35% 25%, rgba(255,255,255,.30), rgba(21,14,40,.92) 58%); box-shadow: 0 0 0 12px rgba(167,139,250,.05), 0 0 70px rgba(167,139,250,.32), inset 0 0 32px rgba(110,231,249,.18); }
  .signal-stage__core img { object-fit: contain; filter: brightness(1.5) drop-shadow(0 0 14px rgba(255,255,255,.7)); }
  .signal-stage__core span { color: var(--gold); font-size: .55rem; letter-spacing: .26em; }
  .signal-label { position: absolute; display: grid; gap: 4px; color: var(--soft); font-size: .58rem; letter-spacing: .2em; }
  .signal-label span { color: var(--cyan); }
  .signal-label b { color: var(--ink); font-size: .67rem; font-weight: 800; }
  .signal-label--top { top: 5%; left: 28%; }
  .signal-label--right { right: 3%; top: 51%; text-align: left; }
  .signal-label--bottom { left: 31%; bottom: 4%; }
  .intro { padding: 64px 0 132px; border-top: 1px solid var(--line); }
  .section-kicker { display: flex; gap: 12px; align-items: center; }
  .section-kicker span:first-child { color: var(--cyan); }
  .intro__grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 80px; margin-top: 24px; }
  h2 { max-width: 780px; font-size: clamp(2.5rem, 5vw, 5.5rem); line-height: .98; letter-spacing: -.065em; }
  .intro__body, .section-heading > p, .handoff__copy > p { color: var(--muted); font-size: 1rem; line-height: 1.7; }
  .text-link { display: inline-block; margin-top: 15px; color: var(--gold); font-size: .78rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .text-link:hover, .text-link:focus-visible { color: var(--cyan); }
  .pathways { padding-bottom: 138px; }
  .section-heading { margin-bottom: 36px; }
  .section-heading h2 { margin: 20px 0 0; }
  .path-grid, .future-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .path-card { min-height: 330px; padding: 27px; display: flex; flex-direction: column; border: 1px solid var(--line); background: linear-gradient(150deg, rgba(255,255,255,.075), rgba(255,255,255,.015)); clip-path: polygon(0 0, 96% 0, 100% 8%, 100% 100%, 4% 100%, 0 92%); transition: transform .3s ease, border-color .3s ease, background .3s ease; }
  .path-card:hover { transform: translateY(-5px); border-color: rgba(110,231,249,.5); background: linear-gradient(150deg, rgba(110,231,249,.12), rgba(255,255,255,.02)); }
  .path-card__number { color: var(--cyan); font-size: .72rem; letter-spacing: .16em; }
  .path-card__label { margin-top: auto; color: var(--gold); }
  .path-card h3 { margin: 12px 0 12px; font-size: clamp(1.5rem, 2.3vw, 2.3rem); line-height: 1; letter-spacing: -.05em; }
  .path-card > p:last-child { margin-bottom: 0; color: var(--muted); font-size: .9rem; line-height: 1.6; }
  .handoff { display: grid; grid-template-columns: .95fr 1.05fr; gap: 70px; align-items: center; padding: 72px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .handoff h2 { margin: 18px 0; font-size: clamp(2.5rem, 4.8vw, 5rem); }
