---
import FaviconHead from "../../components/FaviconHead.astro";
import CoreIcon from "../../components/CoreIcon.astro";
import { ROUTES } from "../../data/routes";
import "../../styles/galaxy-bgs.css";

const devHubHref = ROUTES.devHub;
const platformHref = ROUTES.platform;

const ecosystemSurfaces = [
  { name: "Builder", icon: "builder" as const, href: ROUTES.builder, asset: "/assets/galaxy/core-surface-builder.webp", label: { en: "Build and publish", pt: "Construir e publicar" }, copy: { en: "Turn an idea into a clear public site, campaign or product page.", pt: "Transforme uma ideia em um site, campanha ou página de produto clara." }, tone: "cyan" },
  { name: "Daily", icon: "daily" as const, href: ROUTES.daily, asset: "/assets/galaxy/core-surface-daily.webp", label: { en: "Plan and focus", pt: "Planejar e focar" }, copy: { en: "Keep the next actions, context and routines visible while the work moves.", pt: "Mantenha ações, contexto e rotinas visíveis enquanto o trabalho avança." }, tone: "violet" },
  { name: "Lab", icon: "lab" as const, href: ROUTES.lab, asset: "/assets/galaxy/core-surface-lab.webp", label: { en: "Make and refine", pt: "Criar e refinar" }, copy: { en: "Prepare images, QR projects and creative assets in the browser.", pt: "Prepare imagens, projetos QR e ativos criativos no navegador." }, tone: "gold" },
  { name: "World", icon: "world" as const, href: ROUTES.world, asset: "/assets/galaxy/core-surface-world.webp", label: { en: "Connect and discover", pt: "Conectar e descobrir" }, copy: { en: "Find people, opportunities and resources around meaningful work.", pt: "Encontre pessoas, oportunidades e recursos para trabalhos relevantes." }, tone: "cyan" },
  { name: "Services", icon: "services" as const, href: ROUTES.services, asset: "/assets/galaxy/core-surface-services.webp", label: { en: "Work with an expert", pt: "Trabalhar com especialistas" }, copy: { en: "Add strategy, design and implementation when the project needs a human partner.", pt: "Adicione estratégia, design e implementação quando o projeto precisar de parceria humana." }, tone: "violet" },
  { name: "Dev Journey", icon: "journey" as const, href: ROUTES.devJourney, asset: "/assets/galaxy/core-surface-journey.webp", label: { en: "Learn by building", pt: "Aprender construindo" }, copy: { en: "Move from understanding to a real project with a guided, practical track.", pt: "Passe do entendimento a um projeto real com uma trilha prática e guiada." }, tone: "gold" },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="VOLYNX Core — da intenção ao impacto executável." />
    <title>VOLYNX Core — Da intenção ao impacto</title>
    <FaviconHead />
  </head>
  <body class="page-core">
    <div class="ambient ambient--one" aria-hidden="true"></div>
    <div class="ambient ambient--two" aria-hidden="true"></div>
    <div class="starfield" aria-hidden="true"></div>
    <div class="galaxyfield" aria-hidden="true"></div>

    <header class="core-header">
      <a class="brand" href={ROUTES.core} aria-label="VOLYNX Core home">
        <img src="/assets/V.webp" alt="" width="40" height="40" />
        <span>VOLYNX <small>CORE</small></span>
      </a>
      <nav aria-label="Core navigation">
        <a href="#pathways" data-en="Explore" data-pt="Explorar">Explorar</a>
        <a href={ROUTES.manifesto} data-en="Vision" data-pt="Visão">Visão</a>
        <a href={devHubHref} data-en="Dev Hub" data-pt="Dev Hub">Dev Hub</a>
        <a class="core-nav-platform" href={platformHref} data-en="Platform" data-pt="Plataforma">Plataforma</a>
      </nav>
      <button class="language" type="button" data-language-toggle aria-label="Mudar idioma">PT / EN</button>
    </header>

    <main id="top">
      <section class="hero core-shell" aria-labelledby="hero-title">
        <div class="hero__copy reveal">
          <p class="eyebrow"><span class="eyebrow__signal" aria-hidden="true"></span><span data-en="VOLYNX Core" data-pt="VOLYNX Core">VOLYNX Core</span></p>
          <h1 id="hero-title">
            <span data-en="Intention is the beginning." data-pt="A intenção é o começo.">A intenção é o começo.</span>
            <em data-en="Impact is the path." data-pt="O impacto é o caminho.">O impacto é o caminho.</em>
          </h1>
          <p class="hero__lead" data-en="VOLYNX helps turn what you want to change into a clearer problem, a responsible next step and the tools to make it real." data-pt="A VOLYNX transforma o que você quer mudar em um problema mais claro, um próximo passo responsável e as ferramentas para torná-lo real.">
            A VOLYNX transforma o que você quer mudar em um problema mais claro, um próximo passo responsável e as ferramentas para torná-lo real.
          </p>
          <div class="hero__actions">
            <a class="button button--primary" href="#begin" data-en="Start with your intention" data-pt="Começar pela sua intenção">Começar pela sua intenção</a>
            <a class="button button--quiet" href={ROUTES.manifesto} data-en="Understand the vision" data-pt="Entender a visão">Entender a visão</a>
          </div>
          <a class="legacy-entry" href={platformHref}>
            <span class="legacy-entry__signal" aria-hidden="true"></span>
            <span data-en="Already know VOLYNX? Open your workspace" data-pt="Já conhece a VOLYNX? Abrir seu espaço">Já conhece a VOLYNX? Abrir seu espaço</span>
            <span aria-hidden="true">↗</span>
          </a>
          <p class="hero__trust" data-en="No empty promises. One clear next step." data-pt="Sem promessas vazias. Um próximo passo claro.">Sem promessas vazias. Um próximo passo claro.</p>
        </div>

        <div class="signal-stage reveal reveal--late" aria-label="VOLYNX Core signal" data-signal-stage>
          <div class="signal-stage__halo signal-stage__halo--outer"></div>
          <div class="signal-stage__halo signal-stage__halo--inner"></div>
          <div class="signal-stage__axis signal-stage__axis--one"></div>
          <div class="signal-stage__axis signal-stage__axis--two"></div>
          <svg class="signal-stage__constellation" viewBox="0 0 520 520" aria-hidden="true" focusable="false">
            <path d="M260 260 260 50M260 260 470 260M260 260 260 470M260 260 50 260" />
            <circle cx="260" cy="260" r="207" />
          </svg>
          <a class="orbit-node orbit-node--build" href={ROUTES.builder} data-signal-en="Build" data-signal-pt="Construir" aria-label="Abrir Builder">
            <span class="orbit-node__icon"><CoreIcon name="builder" size={25} /></span><span data-en="Build" data-pt="Construir">Construir</span>
          </a>
          <a class="orbit-node orbit-node--operate" href={ROUTES.daily} data-signal-en="Plan" data-signal-pt="Planejar" aria-label="Abrir Daily">
            <span class="orbit-node__icon"><CoreIcon name="daily" size={25} /></span><span data-en="Plan" data-pt="Planejar">Planejar</span>
          </a>
          <a class="orbit-node orbit-node--make" href={ROUTES.lab} data-signal-en="Create" data-signal-pt="Criar" aria-label="Abrir Lab">
            <span class="orbit-node__icon"><CoreIcon name="lab" size={25} /></span><span data-en="Create" data-pt="Criar">Criar</span>
          </a>
          <a class="orbit-node orbit-node--connect" href={ROUTES.world} data-signal-en="Discover" data-signal-pt="Descobrir" aria-label="Abrir World">
            <span class="orbit-node__icon"><CoreIcon name="world" size={25} /></span><span data-en="Discover" data-pt="Descobrir">Descobrir</span>
          </a>
          <div class="signal-stage__core">
            <img src="/assets/V.webp" alt="" width="70" height="70" />
            <span>CORE</span>
          </div>
          <p class="signal-stage__caption" data-en="Choose where to begin" data-pt="Escolha por onde começar">Escolha por onde começar</p>
          <div class="signal-label signal-label--top"><span>01</span><b data-en="INTENTION" data-pt="INTENÇÃO">INTENÇÃO</b></div>
          <div class="signal-label signal-label--right"><span>02</span><b data-en="ACTION" data-pt="AÇÃO">AÇÃO</b></div>
          <div class="signal-label signal-label--bottom"><span>03</span><b data-en="EVIDENCE" data-pt="EVIDÊNCIA">EVIDÊNCIA</b></div>
        </div>
      </section>

      <section class="intro core-shell reveal" id="begin" aria-labelledby="begin-title">
        <div class="section-kicker"><span>01</span><span data-en="Begin with what matters" data-pt="Comece pelo que importa">Comece pelo que importa</span></div>
        <div class="intro__grid">
          <div>
            <h2 id="begin-title" data-en="What are you trying to make possible?" data-pt="O que você está tentando tornar possível?">O que você está tentando tornar possível?</h2>
          </div>
          <div class="intro__body">
            <p data-en="You do not need to understand everything at once. Start with the challenge in front of you, and we will help you find the right next step." data-pt="Você não precisa entender tudo de uma vez. Comece pelo desafio à sua frente, e ajudaremos a encontrar o próximo passo.">Você não precisa entender tudo de uma vez. Comece pelo desafio à sua frente, e ajudaremos a encontrar o próximo passo.</p>
            <a class="text-link" href="#pathways" data-en="See the paths →" data-pt="Ver os caminhos →">Ver os caminhos →</a>
          </div>
        </div>
      </section>

      <section class="pathways core-shell" id="pathways" aria-labelledby="pathways-title">
        <div class="section-heading reveal">
          <div class="section-kicker"><span>02</span><span data-en="Everything in one place" data-pt="Tudo em um só lugar">Tudo em um só lugar</span></div>
          <h2 id="pathways-title" data-en="From intention to a real next move." data-pt="Da intenção ao próximo movimento real.">Da intenção ao próximo movimento real.</h2>
        </div>
        <div class="path-grid">
          <article class="path-card path-card--intention reveal">
            <div class="path-card__number">01</div>
            <img class="path-card__art" src="/assets/galaxy/core-clarify.webp" alt="" loading="lazy" decoding="async" width="1254" height="1254" />
            <div class="path-card__content">
              <p class="path-card__label" data-en="Clarify" data-pt="Esclarecer">Esclarecer</p>
              <h3 data-en="See the problem clearly." data-pt="Enxergar o problema com clareza.">Enxergar o problema com clareza.</h3>
              <p data-en="Turn a vague goal into an Impact Map with an audience, assumptions, risks and a first measurable outcome." data-pt="Transforme um objetivo vago em um Mapa de Impacto com público, hipóteses, riscos e um primeiro resultado mensurável.">Transforme um objetivo vago em um Mapa de Impacto com público, hipóteses, riscos e um primeiro resultado mensurável.</p>
            </div>
          </article>
          <article class="path-card path-card--action reveal reveal--late">
            <div class="path-card__number">02</div>
            <img class="path-card__art" src="/assets/galaxy/core-build.webp" alt="" loading="lazy" decoding="async" width="1254" height="1254" />
            <div class="path-card__content">
              <p class="path-card__label" data-en="Build" data-pt="Construir">Construir</p>
              <h3 data-en="Take the next step." data-pt="Dar o próximo passo.">Dar o próximo passo.</h3>
              <p data-en="Explore Builder, Daily, Lab, Services and other VOLYNX products whenever one can help you move forward." data-pt="Explore Builder, Daily, Lab, Services e outros produtos VOLYNX sempre que algum deles puder ajudar você a avançar.">Explore Builder, Daily, Lab, Services e outros produtos VOLYNX sempre que algum deles puder ajudar você a avançar.</p>
            </div>
          </article>
          <article class="path-card path-card--evidence reveal reveal--later">
            <div class="path-card__number">03</div>
            <img class="path-card__art" src="/assets/galaxy/core-prove.webp" alt="" loading="lazy" decoding="async" width="1254" height="1254" />
            <div class="path-card__content">
              <p class="path-card__label" data-en="Learn" data-pt="Comprovar">Comprovar</p>
              <h3 data-en="Know what changed." data-pt="Saber o que mudou.">Saber o que mudou.</h3>
              <p data-en="Keep evidence of progress, uncertainty and outcome. Impact is something we learn, not something we claim." data-pt="Registre progresso, incerteza e resultado. Impacto é algo que aprendemos, não algo que apenas declaramos.">Registre progresso, incerteza e resultado. Impacto é algo que aprendemos, não algo que apenas declaramos.</p>
            </div>
          </article>
        </div>
      </section>

      <section class="handoff core-shell reveal" aria-labelledby="handoff-title">
        <div class="handoff__copy">
          <div class="section-kicker"><span>03</span><span data-en="Inside the VOLYNX ecosystem" data-pt="Dentro do ecossistema VOLYNX">Dentro do ecossistema VOLYNX</span></div>
          <h2 id="handoff-title" data-en="From ideas to useful digital work." data-pt="Da ideia a um trabalho digital que faz diferença.">Da ideia a um trabalho digital que faz diferença.</h2>
          <p data-en="Builder, Daily, Lab and World come together when they help you move a project forward." data-pt="Builder, Daily, Lab e World se conectam quando ajudam você a avançar um projeto.">Builder, Daily, Lab e World se conectam quando ajudam você a avançar um projeto.</p>
          <a class="text-link" href={devHubHref} data-en="Explore VOLYNX tools →" data-pt="Explorar ferramentas VOLYNX →">Explorar ferramentas VOLYNX →</a>
        </div>
        <div class="hub-list">
          <a href={ROUTES.builder}><span data-en="CREATE" data-pt="CRIAR">CRIAR</span><strong>Builder</strong><small data-en="Create and publish" data-pt="Criar e publicar">Criar e publicar</small></a>
          <a href={ROUTES.daily}><span data-en="PLAN" data-pt="PLANEJAR">PLANEJAR</span><strong>Daily</strong><small data-en="Plan and focus" data-pt="Planejar e focar">Planejar e focar</small></a>
          <a href={ROUTES.lab}><span data-en="REFINE" data-pt="REFINAR">REFINAR</span><strong>Lab</strong><small data-en="Create locally" data-pt="Criar localmente">Criar localmente</small></a>
          <a href={ROUTES.world}><span data-en="DISCOVER" data-pt="DESCOBRIR">DESCOBRIR</span><strong>World</strong><small data-en="Find people and resources" data-pt="Encontrar pessoas e recursos">Encontrar pessoas e recursos</small></a>
        </div>
      </section>

      <section class="ecosystem core-shell reveal" id="ecosystem" aria-labelledby="ecosystem-title">
        <div class="section-heading">
          <div class="section-kicker"><span>04</span><span data-en="The universe in motion" data-pt="O universo em movimento">O universo em movimento</span></div>
          <h2 id="ecosystem-title" data-en="One intention. Many ways to make it real." data-pt="Uma intenção. Muitos caminhos para torná-la real.">Uma intenção. Muitos caminhos para torná-la real.</h2>
          <p data-en="VOLYNX is not a catalogue to memorise. Each layer appears when it can make the next step clearer, faster or more human." data-pt="A VOLYNX não é um catálogo para decorar. Cada camada aparece quando pode tornar o próximo passo mais claro, rápido ou humano.">A VOLYNX não é um catálogo para decorar. Cada camada aparece quando pode tornar o próximo passo mais claro, rápido ou humano.</p>
        </div>
        <div class="surface-grid">
          {ecosystemSurfaces.map((surface) => (
            <a class:list={["surface-card", `surface-card--${surface.tone}`]} href={surface.href}>
              <span class="surface-card__icon"><CoreIcon name={surface.icon} size={28} /></span>
              <span class="surface-card__meta"><span>{surface.name}</span><span aria-hidden="true">↗</span></span>
              <span class="surface-card__visual" aria-hidden="true">
                <img class="surface-card__art" src={surface.asset} alt="" loading="lazy" decoding="async" width="640" height="640" />
              </span>
              <strong><span class="i18n-en">{surface.label.en}</span><span class="i18n-pt">{surface.label.pt}</span></strong>
              <span class="surface-card__copy"><span class="i18n-en">{surface.copy.en}</span><span class="i18n-pt">{surface.copy.pt}</span></span>
            </a>
          ))}
        </div>
      </section>

      <section class="future core-shell reveal" aria-labelledby="future-title">
        <div class="section-heading">
          <div class="section-kicker"><span>05</span><span data-en="Research directions" data-pt="Direções de pesquisa">Direções de pesquisa</span></div>
          <h2 id="future-title" data-en="The future is a direction, not a claim." data-pt="O futuro é uma direção, não uma promessa.">O futuro é uma direção, não uma promessa.</h2>
          <p data-en="These ideas remain signals of where VOLYNX can go. They become products only when a real problem, safe boundary and measurable outcome are clear." data-pt="Estas ideias continuam sinalizando para onde a VOLYNX pode ir. Só se tornam produtos quando houver problema real, limite seguro e resultado mensurável.">Estas ideias continuam sinalizando para onde a VOLYNX pode ir. Só se tornam produtos quando houver problema real, limite seguro e resultado mensurável.</p>
        </div>
        <div class="future-grid">
          <article><span>IMPACT / RESEARCH</span><h3>Carbon Tracker</h3><p data-en="Make personal and organisational environmental decisions more visible." data-pt="Tornar decisões ambientais pessoais e organizacionais mais visíveis.">Tornar decisões ambientais pessoais e organizacionais mais visíveis.</p></article>
          <article><span>SAFETY / RESEARCH</span><h3>Safety Guardian</h3><p data-en="Explore responsible routing and support for critical reports with humans in control." data-pt="Explorar encaminhamento responsável e apoio para relatos críticos, com humanos no controle.">Explorar encaminhamento responsável e apoio para relatos críticos, com humanos no controle.</p></article>
          <article><span>HEALTH / RESEARCH</span><h3>Precision Health</h3><p data-en="Support prevention and research workflows without presenting medical advice as a product promise." data-pt="Apoiar prevenção e fluxos de pesquisa sem apresentar aconselhamento médico como promessa de produto.">Apoiar prevenção e fluxos de pesquisa sem apresentar aconselhamento médico como promessa de produto.</p></article>
        </div>
      </section>

      <section class="closing core-shell reveal" aria-labelledby="closing-title">
        <div class="closing__mark" aria-hidden="true"><img src="/assets/V.webp" alt="" width="56" height="56" /></div>
        <p class="eyebrow" data-en="Where VOLYNX is heading" data-pt="Para onde a VOLYNX está indo">Para onde a VOLYNX está indo</p>
        <h2 id="closing-title" data-en="Build what makes a better future more possible." data-pt="Construa o que torna um futuro melhor mais possível.">Construa o que torna um futuro melhor mais possível.</h2>
        <div class="closing__actions">
          <a class="button button--primary" href="#begin" data-en="Begin the journey" data-pt="Começar a jornada">Começar a jornada</a>
          <a class="button button--quiet" href={platformHref} data-en="Enter the existing platform" data-pt="Entrar na plataforma atual">Entrar na plataforma atual</a>
          <a class="button button--quiet" href={ROUTES.launch2026} data-en="See the original story" data-pt="Ver a história original">Ver a história original</a>
        </div>
      </section>
    </main>

    <footer class="core-footer core-shell">
      <span>VOLYNX / CORE</span>
      <span data-en="One connected experience. Built to keep evolving." data-pt="Uma experiência conectada. Feita para evoluir.">Uma experiência conectada. Feita para evoluir.</span>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector("[data-language-toggle]");
        const setLanguage = (language) => {
          root.lang = language === "pt" ? "pt-BR" : "en";
          document.querySelectorAll("[data-en][data-pt]").forEach((node) => {
            node.textContent = node.dataset[language === "pt" ? "pt" : "en"] || node.textContent;
          });
          if (toggle) toggle.textContent = language === "pt" ? "PT / EN" : "EN / PT";
          try { localStorage.setItem("volynx_core_preview_language", language); } catch (_) {}
        };
        let language = "pt";
        try { language = localStorage.getItem("volynx_core_preview_language") || "pt"; } catch (_) {}
        setLanguage(language);
        toggle?.addEventListener("click", () => setLanguage(root.lang.startsWith("pt") ? "en" : "pt"));

        const reduceMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
        const signalStage = document.querySelector("[data-signal-stage]");
        const signalCaption = document.querySelector("[data-signal-stage] .signal-stage__caption");
        const orbitNodes = document.querySelectorAll("[data-signal-stage] .orbit-node");
        const setSignalCaption = (node) => {
          if (!signalCaption || !node) return;
          const languageKey = root.lang.startsWith("pt") ? "signalPt" : "signalEn";
          signalCaption.textContent = node.dataset[languageKey] || signalCaption.textContent;
        };
        orbitNodes.forEach((node) => {
          node.addEventListener("pointerenter", () => setSignalCaption(node));
          node.addEventListener("focus", () => setSignalCaption(node));
        });
        signalStage?.addEventListener("pointermove", (event) => {
          if (reduceMotion) return;
          const rect = signalStage.getBoundingClientRect();
          signalStage.style.setProperty("--pointer-x", ((event.clientX - rect.left) / rect.width - .5).toFixed(3));
          signalStage.style.setProperty("--pointer-y", ((event.clientY - rect.top) / rect.height - .5).toFixed(3));
        });
        signalStage?.addEventListener("pointerleave", () => {
          signalStage.style.setProperty("--pointer-x", "0");
          signalStage.style.setProperty("--pointer-y", "0");
          if (signalCaption) signalCaption.textContent = root.lang.startsWith("pt") ? signalCaption.dataset.pt : signalCaption.dataset.en;
        });
        const reveals = document.querySelectorAll(".reveal");
        if (reduceMotion || !("IntersectionObserver" in window)) {
          reveals.forEach((node) => node.classList.add("is-visible"));
        } else {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
          reveals.forEach((node) => observer.observe(node));
        }
      })();
      </script>
  </body>
</html>

<style>
  :root {
    --ink: #f5f6ff;
    --muted: rgba(211, 214, 236, .68);
    --soft: rgba(211, 214, 236, .48);
    --line: rgba(255, 255, 255, .13);
    --violet: #a78bfa;
    --cyan: #6ee7f9;
    --gold: #e9d7a5;
    --bg: #03040b;
    --display: "Manrope", system-ui, sans-serif;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--bg); }
  body { margin: 0; overflow-x: hidden; color: var(--ink); background: var(--bg); font-family: var(--display); -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; }
  .ambient, .starfield { position: fixed; inset: 0; pointer-events: none; }
  .ambient { z-index: -3; filter: blur(12px); }
  .ambient--one { background: radial-gradient(circle at 70% 15%, rgba(124, 58, 237, .23), transparent 27%), radial-gradient(circle at 12% 70%, rgba(14, 165, 233, .14), transparent 24%); }
  .ambient--two { background: radial-gradient(circle at 42% 36%, rgba(167, 139, 250, .10), transparent 20%), linear-gradient(180deg, rgba(3, 4, 11, .12), rgba(3, 4, 11, .92)); z-index: -2; }
  .starfield { z-index: -1; opacity: .65; background-image: radial-gradient(1px 1px at 12% 18%, #fff, transparent 70%), radial-gradient(1px 1px at 74% 13%, #fff, transparent 70%), radial-gradient(1px 1px at 89% 42%, #fff, transparent 70%), radial-gradient(1px 1px at 22% 67%, #fff, transparent 70%), radial-gradient(1px 1px at 57% 84%, #fff, transparent 70%), radial-gradient(1px 1px at 38% 31%, #fff, transparent 70%), radial-gradient(1px 1px at 8% 91%, #fff, transparent 70%); }
  .core-shell { width: min(1180px, calc(100% - 48px)); margin-inline: auto; }
