    line-height: 1.02;
    letter-spacing: 0;
  }

  .ds-section-head p,
  .ds-section-copy p {
    margin: 18px 0 0;
    color: var(--ds-muted);
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.75;
  }

  .ds-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 14px 24px;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--ds-ink);
    font-size: 14px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    transition:
      transform 260ms var(--ds-ease),
      border-color 260ms var(--ds-ease),
      background 260ms var(--ds-ease),
      box-shadow 260ms var(--ds-ease);
  }

  .ds-btn--primary {
