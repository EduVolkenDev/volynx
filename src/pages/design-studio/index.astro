  }

  .ds-cta-section {
    position: relative;
    padding: clamp(86px, 11vw, 150px) 0;
    text-align: center;
    overflow: hidden;
  }

  .ds-cta-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.04), transparent 42%),
      linear-gradient(120deg, rgba(115,241,255,0.11), transparent 34%),
      linear-gradient(260deg, rgba(245,208,111,0.12), transparent 34%);
