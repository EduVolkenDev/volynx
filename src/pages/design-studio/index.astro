  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 680ms var(--ds-ease),
      transform 680ms var(--ds-ease);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes dsAmbient {
    0% { transform: translate3d(-1%, -1%, 0) rotate(0deg); }
    100% { transform: translate3d(1%, 1%, 0) rotate(8deg); }
  }

  @keyframes dsHeroLight {
    0% { transform: translate3d(-3%, -1%, 0) scale(1); opacity: 0.28; }
    100% { transform: translate3d(3%, 1%, 0) scale(1.04); opacity: 0.52; }
  }

  @keyframes dsScrollCue {
    0% { transform: translateY(-100%); opacity: 0; }
    30% { opacity: 1; }
    100% { transform: translateY(260%); opacity: 0; }
  }

  @media (max-width: 980px) {
    .ds-intro__grid,
    .ds-diagnostic__grid,
    .ds-score__grid {
      grid-template-columns: 1fr;
    }

    .ds-flow,
    .ds-delivery-grid {
      grid-template-columns: 1fr;
    }

    .ds-delivery-card--featured {
      transform: none;
    }

    .ds-application,
    .ds-application--wide,
    .ds-application--tall {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  @media (max-width: 680px) {
    .shell {
      width: min(100% - 28px, 1180px);
    }

