<!-- ═══════════════════════════════════════════════════════════
     SCRIPTS: reveal + parallax suave
════════════════════════════════════════════════════════════ -->
<script>
  (function () {
    // ── Respect prefers-reduced-motion ─────────────────────
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── Reveal on scroll ────────────────────────────────────
    const revealEls = document.querySelectorAll('[data-reveal]');
    if (revealEls.length && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry, i) => {
            if (entry.isIntersecting) {
              // Stagger siblings dentro do mesmo parent
              const siblings = Array.from(
                entry.target.parentElement?.querySelectorAll('[data-reveal]') ?? []
              );
              const idx = siblings.indexOf(entry.target as HTMLElement);
              const delay = reduced ? 0 : Math.min(idx * 80, 300);
              setTimeout(() => {
                (entry.target as HTMLElement).classList.add('is-visible');
              }, delay);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      revealEls.forEach((el) => observer.observe(el));
    } else {
      // Sem suporte: exibe tudo diretamente
      revealEls.forEach((el) => el.classList.add('is-visible'));
    }

    // ── Parallax suave no vídeo do hero (CSS variable) ─────
    if (!reduced) {
      const heroVideo = document.querySelector<HTMLVideoElement>('.ds-hero__video');
      if (heroVideo) {
        let ticking = false;
        const onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              const y = window.scrollY;
              const max = window.innerHeight;
              const pct = Math.min(y / max, 1);
              // Move levemente o vídeo para baixo ao scrollar — max 30px
              heroVideo.style.transform = `translateY(${pct * 30}px)`;
              heroVideo.style.opacity = String(0.28 - pct * 0.18);
              ticking = false;
            });
            ticking = true;
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    }

    // ── Floating layers sutis nos ícones de serviço ────────
    if (!reduced) {
      const icons = document.querySelectorAll<HTMLElement>('.ds-svc-card__icon');
      icons.forEach((icon, i) => {
        const amplitude = 4 + (i % 3) * 2;
        const duration  = 3400 + i * 340;
        const offset    = i * 600;
        let start: number | null = null;

        const animate = (ts: number) => {
          if (!start) start = ts - offset;
          const t   = (ts - start) / duration;
          const y   = Math.sin(t * Math.PI * 2) * amplitude;
          icon.style.transform = `translateY(${y}px)`;
          requestAnimationFrame(animate);
        };
        requestAnimationFrame(animate);
      });
    }

    // ── Vídeo fallback: esconde fallback após load ─────────
    const vid = document.querySelector<HTMLVideoElement>('.ds-hero__video');
    const fallback = document.querySelector<HTMLElement>('.ds-hero__video-fallback');
    if (vid && fallback) {
      const hideFallback = () => { fallback.style.opacity = '0'; };
      if (vid.readyState >= 2) { hideFallback(); }
      else { vid.addEventListener('canplay', hideFallback, { once: true }); }
    }
  })();
</script>
