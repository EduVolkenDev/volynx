          <a href="#diagnostico" class="ds-btn ds-btn--ghost" data-i18n="ds.cta_review">Rever diagnóstico</a>
        </div>
      </div>
    </section>
  </main>

  <FlagshipFooter />
</FlagshipLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .page-design-studio {
    --ds-bg: #02050a;
    --ds-bg-soft: #06111a;
    --ds-ink: rgba(246, 249, 255, 0.96);
    --ds-muted: rgba(218, 227, 239, 0.68);
    --ds-soft: rgba(246, 249, 255, 0.08);
    --ds-softer: rgba(246, 249, 255, 0.045);
    --ds-line: rgba(246, 249, 255, 0.12);
    --ds-line-strong: rgba(246, 249, 255, 0.22);
    --ds-cyan: #73f1ff;
    --ds-teal: #28d0b5;
    --ds-gold: #f5d06f;
    --ds-rose: #f08fb2;
    --ds-violet: #9ea7ff;
    --ds-shadow: 0 28px 90px rgba(0, 0, 0, 0.42);
    --ds-radius: 26px;
    --ds-radius-lg: 38px;
    --ds-ease: cubic-bezier(0.22, 1, 0.36, 1);
    color: var(--ds-ink);
    background: var(--ds-bg);
  }

  .ds-main {
    position: relative;
    z-index: 1;
    overflow: clip;
    min-height: 100vh;
    background:
      linear-gradient(130deg, rgba(115, 241, 255, 0.11), transparent 28%),
      linear-gradient(220deg, rgba(245, 208, 111, 0.09), transparent 26%),
      linear-gradient(180deg, #02050a 0%, #071019 48%, #02050a 100%);
  }

  .ds-main::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
      linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, transparent, black 18%, black 78%, transparent);
  }

  .ds-main::after {
    content: "";
    position: fixed;
    inset: -20%;
    z-index: -1;
    pointer-events: none;
    opacity: 0.5;
    background:
      conic-gradient(from 160deg at 18% 28%, rgba(115, 241, 255, 0.16), transparent 18%, rgba(245, 208, 111, 0.10), transparent 44%, rgba(240, 143, 178, 0.12), transparent 70%, rgba(115, 241, 255, 0.16)),
      linear-gradient(120deg, transparent, rgba(255,255,255,0.035), transparent);
    filter: blur(36px);
    animation: dsAmbient 18s var(--ds-ease) infinite alternate;
  }

  .shell {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
    position: relative;
    z-index: 2;
  }

  .page-section {
    position: relative;
    padding: clamp(74px, 10vw, 144px) 0;
  }

  .ds-eyebrow,
  .ds-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    color: rgba(222, 246, 255, 0.78);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ds-eyebrow::before,
  .ds-kicker::before {
    content: "";
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, var(--ds-cyan), transparent);
  }

  .ds-section-head,
  .ds-section-copy {
    max-width: 720px;
  }

  .ds-section-head {
    margin: 0 auto clamp(38px, 6vw, 72px);
    text-align: center;
  }

  .ds-section-head .ds-eyebrow {
    justify-content: center;
  }

  .ds-section-head .ds-eyebrow::after {
    content: "";
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--ds-cyan));
  }

  .ds-section-head h2,
  .ds-section-copy h2 {
    margin: 0;
    color: var(--ds-ink);
    font-family: var(--font-display, "Orbitron", sans-serif);
