---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";

const designBriefHref = `${ROUTES.contact}?product=design-studio&intent=brand-diagnosis`;
---

<FlagshipLayout
  title="VOLYNX Design Studio — Brand Systems, Logos e Identidade Premium"
  description="Crie uma identidade de marca completa, não apenas um logotipo. Diagnóstico, direção visual, aplicações reais, Brand Score e arquivos prontos para web e impressão."
  ogImage="/assets/volynxstudio.webp"
  pageClass="page-design-studio"
>
  <FlagshipHeader current={ROUTES.designStudio} />

  <main class="ds-main">
    <section class="ds-hero" id="topo" aria-label="VOLYNX Design Studio">
      <div class="ds-hero__media" aria-hidden="true">
        <video
          class="ds-hero__video"
          src="/assets/design-studio-catalog-open.mp4"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        ></video>
      </div>

      <div class="shell ds-hero__content">
        <span class="ds-eyebrow" data-reveal data-i18n="ds.hero_eyebrow">Brand Studio by VOLYNX</span>
        <h1 class="ds-hero__title" data-reveal aria-label="VOLYNX Design Studio">
          <img
            class="ds-hero__wordmark"
            src="/assets/design-studio/volynx-wordmark-gold.webp"
            alt="VOLYNX"
            width="1800"
            height="836"
            decoding="async"
            fetchpriority="high"
          />
          <span class="ds-hero__title-text" data-i18n="ds.hero_title">Design Studio</span>
        </h1>
        <p class="ds-hero__lead" data-reveal data-i18n="ds.hero_lead">Crie uma identidade de marca completa, não apenas um logotipo. Diagnóstico, direção visual, aplicações reais e arquivos prontos para vender desde o primeiro contato.</p>

        <div class="ds-hero__actions" data-reveal>
          <a href="#diagnostico" class="ds-btn ds-btn--primary" data-i18n="ds.hero_cta_primary">Iniciar diagnóstico</a>
          <a href="#brand-score" class="ds-btn ds-btn--ghost" data-i18n="ds.hero_cta_secondary">Ver Brand Score</a>
        </div>

        <div class="ds-hero__signal" data-reveal aria-label="Diferenciais do Design Studio" data-i18n-aria="ds.hero_signal_aria">
          <span data-i18n="ds.signal_logo">Logo</span>
          <span data-i18n="ds.signal_brand_kit">Brand Kit</span>
          <span data-i18n="ds.signal_mockups">Mockups</span>
          <span data-i18n="ds.signal_score">Score</span>
          <span data-i18n="ds.signal_files">Arquivos finais</span>
        </div>
      </div>

      <div class="ds-scroll-cue" aria-hidden="true">
        <span></span>
      </div>
    </section>

    <nav class="ds-subnav" aria-label="Navegação do Design Studio" data-i18n-aria="ds.subnav_aria">
      <div class="shell ds-subnav__inner">
        <a href="#diagnostico" data-i18n="ds.nav_diagnostic">Diagnóstico</a>
        <a href="#arquitetura" data-i18n="ds.nav_architect">Brand Architect</a>
        <a href="#aplicacoes" data-i18n="ds.nav_applications">Aplicações</a>
        <a href="#signa-tracer" data-i18n="ds.nav_tracer">Signa Tracer</a>
        <a href="#brand-score" data-i18n="ds.nav_score">Score</a>
        <a href="#entrega" data-i18n="ds.nav_delivery">Entrega</a>
      </div>
    </nav>

    <section class="ds-intro page-section" aria-labelledby="ds-intro-title">
      <div class="shell ds-intro__grid">
        <div class="ds-section-copy" data-reveal>
          <span class="ds-eyebrow" data-i18n="ds.intro_eyebrow">Oportunidade real</span>
          <h2 id="ds-intro-title" data-i18n="ds.intro_title">A maioria cria um logotipo bonito. A VOLYNX constrói uma marca aplicável</h2>
          <p data-i18n="ds.intro_copy">O Design Studio nasce como um produto de identidade: entende o negócio, define a direção, testa a marca em contextos reais e entrega um sistema visual que pode se transformar em site, campanha, placa, código QR, conteúdo para redes sociais e material impresso.</p>
        </div>

        <div class="ds-principles" data-reveal>
          <article>
            <strong data-i18n="ds.principle_1_title">Menos opções aleatórias</strong>
            <span data-i18n="ds.principle_1_copy">Mais critério, mais contexto e menos ruído para o cliente decidir.</span>
          </article>
          <article>
            <strong data-i18n="ds.principle_2_title">Marca em uso real</strong>
            <span data-i18n="ds.principle_2_copy">Prévia em site, avatar, favicon, cartão, banner e assinatura.</span>
          </article>
          <article>
            <strong data-i18n="ds.principle_3_title">Qualidade mensurável</strong>
            <span data-i18n="ds.principle_3_copy">Pontuação de legibilidade, versatilidade, memorabilidade e preparo para impressão.</span>
          </article>
        </div>
      </div>
    </section>

    <section class="ds-diagnostic page-section" id="diagnostico" aria-labelledby="ds-diagnostic-title">
      <div class="shell ds-diagnostic__grid">
        <div class="ds-studio-panel ds-diagnostic__form" data-reveal>
          <div class="ds-panel-head">
            <span class="ds-kicker" data-i18n="ds.diagnostic_kicker">01 / Diagnóstico guiado</span>
            <h2 id="ds-diagnostic-title" data-i18n="ds.diagnostic_title">Comece pelo negócio, não pelo desenho</h2>
            <p data-i18n="ds.diagnostic_copy">Digite um nome de teste e veja a página adaptar as aplicações em tempo real.</p>
          </div>

          <label class="ds-field">
            <span data-i18n="ds.brand_name_label">Nome da marca</span>
            <input data-brand-input type="text" value="Aurora Clinic" maxlength="34" autocomplete="off" />
          </label>

          <div class="ds-choice-grid" aria-label="Pontos avaliados no briefing" data-i18n-aria="ds.choice_aria">
            <button class="ds-choice is-active" type="button" data-i18n="ds.choice_audience">Público</button>
            <button class="ds-choice" type="button" data-i18n="ds.choice_market">Mercado</button>
            <button class="ds-choice" type="button" data-i18n="ds.choice_tone">Tom</button>
            <button class="ds-choice" type="button" data-i18n="ds.choice_use">Uso</button>
          </div>

          <div class="ds-brief-list" aria-label="Perguntas do diagnóstico" data-i18n-aria="ds.brief_aria">
            <div>
              <strong data-i18n="ds.brief_1_title">Onde essa marca precisa funcionar?</strong>
              <span data-i18n="ds.brief_1_copy">Site, placa, ícone de aplicativo, avatar, banner, embalagem ou material impresso.</span>
            </div>
            <div>
              <strong data-i18n="ds.brief_2_title">Como a marca deve ser percebida?</strong>
              <span data-i18n="ds.brief_2_copy">Acessível, premium, técnico, autoral, institucional ou experimental.</span>
            </div>
            <div>
              <strong data-i18n="ds.brief_3_title">O que deve ser evitado?</strong>
              <span data-i18n="ds.brief_3_copy">Visual genérico, símbolo fraco, baixa leitura ou excesso de tendência.</span>
            </div>
          </div>
        </div>

        <div class="ds-live-stage" data-reveal aria-label="Prévia da identidade" data-i18n-aria="ds.preview_aria">
          <div class="ds-live-stage__top">
            <span data-i18n="ds.preview_label">Identidade em tempo real</span>
            <strong data-brand-output>Aurora Clinic</strong>
          </div>

          <div class="ds-brand-canvas">
            <div class="ds-brand-mark" aria-hidden="true">
              <span></span>
            </div>
            <div>
              <p class="ds-brand-name" data-brand-output>Aurora Clinic</p>
              <p class="ds-brand-line" data-i18n="ds.preview_tagline">Precisão tranquila para o cuidado moderno.</p>
            </div>
          </div>

          <div class="ds-mini-system" aria-label="Componentes do sistema visual" data-i18n-aria="ds.system_aria">
            <span class="ds-swatch ds-swatch--a"></span>
            <span class="ds-swatch ds-swatch--b"></span>
            <span class="ds-swatch ds-swatch--c"></span>
            <span class="ds-font-sample">Aa</span>
            <span class="ds-file-pill">SVG</span>
            <span class="ds-file-pill">PDF</span>
          </div>

          <div class="ds-live-note">
            <strong data-i18n="ds.preview_note_title">Prévia conceitual</strong>
            <span data-i18n="ds.preview_note_copy">A experiência final deve gerar direções, aplicações e pacotes de entrega a partir do briefing.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="ds-architect page-section" id="arquitetura" aria-labelledby="ds-architect-title">
      <div class="shell">
        <div class="ds-section-head" data-reveal>
          <span class="ds-eyebrow" data-i18n="ds.architect_eyebrow">Brand Architect</span>
          <h2 id="ds-architect-title" data-i18n="ds.architect_title">Um fluxo mais inteligente do que um criador de logotipos comum</h2>
          <p data-i18n="ds.architect_copy">Looka, Canva, Adobe Express, Brandmark e Wix mostram bons caminhos. A oportunidade da VOLYNX é juntar facilidade com critério de marca e aplicação real.</p>
        </div>

        <div class="ds-flow" aria-label="Fluxo do Brand Architect" data-i18n-aria="ds.flow_aria">
          <article data-reveal>
            <img class="ds-flow__asset" src="/assets/design-studio/diagnosis.webp" alt="" width="128" height="128" loading="lazy" decoding="async" />
            <span>01</span>
            <h3 data-i18n="ds.flow_1_title">Diagnosticar</h3>
            <p data-i18n="ds.flow_1_copy">Negócio, público, posicionamento, tom, concorrentes e canais de uso.</p>
          </article>
          <article data-reveal>
            <img class="ds-flow__asset" src="/assets/design-studio/direction.webp" alt="" width="128" height="128" loading="lazy" decoding="async" />
            <span>02</span>
            <h3 data-i18n="ds.flow_2_title">Direcionar</h3>
            <p data-i18n="ds.flow_2_copy">Paleta, linguagem, ritmo, referências e riscos visuais antes de gerar.</p>
          </article>
          <article data-reveal>
            <img class="ds-flow__asset" src="/assets/design-studio/creation.webp" alt="" width="128" height="128" loading="lazy" decoding="async" />
            <span>03</span>
            <h3 data-i18n="ds.flow_3_title">Criar</h3>
            <p data-i18n="ds.flow_3_copy">Símbolo, assinatura tipográfica, versões horizontal e vertical, favicon e avatar.</p>
          </article>
          <article data-reveal>
            <img class="ds-flow__asset" src="/assets/design-studio/applying.webp" alt="" width="128" height="128" loading="lazy" decoding="async" />
            <span>04</span>
            <h3 data-i18n="ds.flow_4_title">Aplicar</h3>
            <p data-i18n="ds.flow_4_copy">Mockups em site, redes sociais, cartão, placa, banner, aplicativo e assinatura.</p>
          </article>
          <article data-reveal>
            <img class="ds-flow__asset" src="/assets/design-studio/evaluate.webp" alt="" width="128" height="128" loading="lazy" decoding="async" />
            <span>05</span>
            <h3 data-i18n="ds.flow_5_title">Avaliar</h3>
            <p data-i18n="ds.flow_5_copy">Brand Score para leitura, versatilidade, originalidade e impressão.</p>
          </article>
          <article data-reveal>
            <img class="ds-flow__asset" src="/assets/design-studio/delivery.webp" alt="" width="128" height="128" loading="lazy" decoding="async" />
            <span>06</span>
            <h3 data-i18n="ds.flow_6_title">Entregar</h3>
            <p data-i18n="ds.flow_6_copy">Arquivos organizados, guia rápido e formatos prontos para web e impressão.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="ds-applications page-section" id="aplicacoes" aria-labelledby="ds-applications-title">
      <div class="shell">
        <div class="ds-section-head" data-reveal>
          <span class="ds-eyebrow" data-i18n="ds.apps_eyebrow">Prévia em contexto</span>
          <h2 id="ds-applications-title" data-i18n="ds.apps_title">A marca precisa sobreviver fora do arquivo</h2>
          <p data-i18n="ds.apps_copy">O cliente decide melhor quando vê a identidade funcionando em situações reais, não perdida em uma tela branca.</p>
        </div>

        <div class="ds-application-grid">
          <article class="ds-application ds-application--wide" data-reveal>
            <div class="ds-browser-frame">
              <div class="ds-browser-bar" aria-hidden="true"><span></span><span></span><span></span></div>
              <div class="ds-site-preview">
                <header>
                  <strong data-brand-output>Aurora Clinic</strong>
                  <nav><span data-i18n="ds.mock_nav_services">Serviços</span><span data-i18n="ds.mock_nav_booking">Agendar</span><span data-i18n="ds.mock_nav_contact">Contato</span></nav>
                </header>
                <div>
                  <p data-i18n="ds.mock_kicker">Sistema de marca moderno</p>
                  <h3 data-i18n="ds.mock_title">Identidade criada para o primeiro clique</h3>
                  <span data-i18n="ds.mock_cta">Agendar consulta</span>
                </div>
              </div>
            </div>
            <h3 data-i18n="ds.app_1_title">Cabeçalho de site e página de destino</h3>
            <p data-i18n="ds.app_1_copy">Assinatura tipográfica, contraste, tom e hierarquia testados onde a venda realmente acontece.</p>
          </article>

          <article class="ds-application" data-reveal>
            <div class="ds-social-preview">
              <div class="ds-avatar"><span></span></div>
              <strong data-brand-output>Aurora Clinic</strong>
              <p>@brand.system</p>
              <div class="ds-social-lines" aria-hidden="true"><span></span><span></span><span></span></div>
            </div>
            <h3 data-i18n="ds.app_2_title">Avatar para redes sociais</h3>
            <p data-i18n="ds.app_2_copy">Leitura rápida em tamanho pequeno, com símbolo preparado para perfil.</p>
          </article>

          <article class="ds-application" data-reveal>
            <div class="ds-card-preview">
              <span class="ds-card-mark"></span>
              <strong data-brand-output>Aurora Clinic</strong>
              <small data-i18n="ds.card_roles">estratégia / identidade / lançamento</small>
            </div>
            <h3 data-i18n="ds.app_3_title">Cartão e assinatura</h3>
            <p data-i18n="ds.app_3_copy">Aplicações comerciais que revelam se a identidade parece confiável.</p>
          </article>

          <article class="ds-application ds-application--tall" data-reveal>
            <div class="ds-sign-preview">
              <span data-brand-output>Aurora Clinic</span>
            </div>
            <h3 data-i18n="ds.app_4_title">Placa, banner e impressão</h3>
            <p data-i18n="ds.app_4_copy">Teste de escala para evitar logotipos bonitos na tela, mas fracos no mundo real.</p>
          </article>

          <article class="ds-application" data-reveal>
            <div class="ds-favicon-row">
              <span class="ds-favicon ds-favicon--one"></span>
              <span class="ds-favicon ds-favicon--two"></span>
              <span class="ds-favicon ds-favicon--three"></span>
            </div>
            <h3 data-i18n="ds.app_5_title">Favicon e ícone de aplicativo</h3>
            <p data-i18n="ds.app_5_copy">Versões simplificadas para navegador, aplicativo, painel e atalhos.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="ds-tracer page-section" id="signa-tracer" aria-labelledby="ds-tracer-title">
      <div class="shell ds-tracer__grid">
        <div class="ds-section-copy" data-reveal>
          <span class="ds-eyebrow" data-i18n="ds.tracer_eyebrow">Signa Tracer</span>
          <h2 id="ds-tracer-title" data-i18n="ds.tracer_title">Vetor real para logos, símbolos e marcas iniciais</h2>
          <p data-i18n="ds.tracer_copy">O Signa Tracer transforma rascunhos, PNGs e artes chapadas em SVG com paths reais. Ele foi pensado para identidade visual: logo, favicon, avatar, marca d'água e aplicações de marca.</p>
          <div class="ds-tracer-points" aria-label="Signa Tracer outputs" data-i18n-aria="ds.tracer_points_aria">
            <span data-i18n="ds.tracer_point_1">SVG com paths editáveis</span>
            <span data-i18n="ds.tracer_point_2">Preview para favicon e escala</span>
            <span data-i18n="ds.tracer_point_3">Melhor para logos e artes flat</span>
          </div>
        </div>

        <div class="ds-tracer-tool" data-reveal>
          <div class="ds-tracer-tool__head">
            <div>
              <span class="ds-kicker" data-i18n="ds.tracer_tool_kicker">VTracer spline engine</span>
              <h3 data-i18n="ds.tracer_tool_title">Converta um logo em SVG</h3>
            </div>
            <span class="ds-tracer-badge">WASM · SPLINE</span>
          </div>

          <label class="ds-tracer-drop" for="signaTracerFile" id="signaTracerDrop">
            <input id="signaTracerFile" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
            <strong data-i18n="ds.tracer_drop_title">Arraste ou selecione uma imagem</strong>
            <span data-i18n="ds.tracer_drop_copy">Use logos simples, sketches ou marcas em alto contraste para o melhor resultado.</span>
          </label>

          <div class="ds-tracer-controls" aria-label="Signa Tracer controls" data-i18n-aria="ds.tracer_controls_aria">
            <label>
              <span><span data-i18n="ds.tracer_threshold">Contraste</span> <output id="signaTracerThresholdValue">132</output></span>
              <input id="signaTracerThreshold" type="range" min="20" max="235" value="132" aria-describedby="signaTracerThresholdValue" />
            </label>
            <label>
              <span><span data-i18n="ds.tracer_smoothing">Suavização</span> <output id="signaTracerSmoothingValue">6</output></span>
              <input id="signaTracerSmoothing" type="range" min="2" max="12" value="6" aria-describedby="signaTracerSmoothingValue" />
            </label>
            <label>
              <span><span data-i18n="ds.tracer_noise">Remover ruído</span> <output id="signaTracerNoiseValue">4 px</output></span>
              <input id="signaTracerNoise" type="range" min="0" max="24" value="4" aria-describedby="signaTracerNoiseValue" />
            </label>
            <label>
              <span data-i18n="ds.tracer_precision">Precisão</span>
              <select id="signaTracerDetail">
                <option value="640" data-i18n="ds.tracer_precision_balanced">Balanceada</option>
                <option value="1024" selected data-i18n="ds.tracer_precision_high">Alta</option>
                <option value="1600" data-i18n="ds.tracer_precision_ultra">Ultra</option>
              </select>
            </label>
            <label class="ds-tracer-toggle">
              <input id="signaTracerInvert" type="checkbox" />
              <span data-i18n="ds.tracer_invert">Inverter marca</span>
            </label>
          </div>

          <div class="ds-tracer-preview-grid">
            <div class="ds-tracer-preview">
              <span data-i18n="ds.tracer_original">Original</span>
              <canvas id="signaTracerCanvas" width="320" height="220" aria-label="Original image preview"></canvas>
            </div>
            <div class="ds-tracer-preview ds-tracer-preview--svg">
              <span data-i18n="ds.tracer_vector">SVG vetorial</span>
              <div id="signaTracerSvgPreview" class="ds-tracer-svg-preview" role="img" aria-label="Vectorized SVG preview"></div>
            </div>
          </div>

          <div class="ds-tracer-output">
            <p id="signaTracerStatus" data-i18n="ds.tracer_status_empty">Selecione uma imagem para gerar paths SVG reais.</p>
            <button id="signaTracerDownload" class="ds-btn ds-btn--primary" type="button" disabled>
              <span data-i18n="ds.tracer_download">Baixar SVG vetorial</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="ds-score page-section" id="brand-score" aria-labelledby="ds-score-title">
      <div class="shell ds-score__grid">
        <div class="ds-section-copy" data-reveal>
          <span class="ds-eyebrow" data-i18n="ds.score_eyebrow">Brand Score</span>
          <h2 id="ds-score-title" data-i18n="ds.score_title">Um logotipo pode ser bonito e ainda falhar</h2>
          <p data-i18n="ds.score_copy">A camada de avaliação ajuda a explicar, com critérios visuais, onde a marca está forte e onde precisa ser refinada. Não promete validação jurídica, mas evita escolhas fracas, genéricas ou pouco versáteis.</p>
          <a href="#caminho" class="ds-btn ds-btn--ghost" data-i18n="ds.score_cta">Ver o caminho recomendado</a>
        </div>

        <div class="ds-score-board" data-reveal>
          <div class="ds-score-board__head">
            <span data-i18n="ds.score_label">Pontuação do protótipo</span>
            <strong>86</strong>
          </div>

          <div class="ds-score-list">
            <div class="ds-score-row" style="--score: 91%">
              <span data-i18n="ds.metric_versatility">Versatilidade</span>
              <i></i>
              <strong>91</strong>
            </div>
            <div class="ds-score-row" style="--score: 88%">
              <span data-i18n="ds.metric_readability">Leitura</span>
              <i></i>
              <strong>88</strong>
            </div>
            <div class="ds-score-row" style="--score: 82%">
              <span data-i18n="ds.metric_memory">Memorabilidade</span>
              <i></i>
              <strong>82</strong>
            </div>
            <div class="ds-score-row" style="--score: 76%">
              <span data-i18n="ds.metric_originality">Originalidade</span>
              <i></i>
              <strong>76</strong>
            </div>
            <div class="ds-score-row" style="--score: 69%">
              <span data-i18n="ds.metric_favicon">Preparo para favicon</span>
              <i></i>
              <strong>69</strong>
            </div>
            <div class="ds-score-row" style="--score: 94%">
              <span data-i18n="ds.metric_print">Preparo para impressão</span>
              <i></i>
              <strong>94</strong>
            </div>
          </div>

          <div class="ds-score-warning">
            <strong data-i18n="ds.score_insight_title">Análise de exemplo</strong>
            <span data-i18n="ds.score_insight_copy">Funciona bem em aplicações grandes; a versão favicon deve ser simplificada para ganhar força em 16px.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="ds-delivery page-section" id="entrega" aria-labelledby="ds-delivery-title">
      <div class="shell">
        <div class="ds-section-head" data-reveal>
          <span class="ds-eyebrow" data-i18n="ds.delivery_eyebrow">Sistema de entrega</span>
          <h2 id="ds-delivery-title" data-i18n="ds.delivery_title">Não termina no logotipo. Começa no pacote de marca</h2>
