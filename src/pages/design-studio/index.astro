---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";

const whatsappBriefing = `${ROUTES.whatsapp}?text=Ol%C3%A1%20VOLYNX%2C%20quero%20come%C3%A7ar%20um%20diagn%C3%B3stico%20de%20marca%20no%20Design%20Studio.`;
---

<FlagshipLayout
  title="VOLYNX Design Studio — Brand Systems, Logos e Identidade Premium"
  description="Crie uma identidade de marca completa, nao apenas um logotipo. Diagnostico, direcao visual, aplicacoes reais, Brand Score e arquivos prontos para web e impressao."
  ogImage="/assets/volynxstudio.webp"
  pageClass="page-design-studio"
>
  <FlagshipHeader current={ROUTES.designStudio} />

  <main class="ds-main">
    <section class="ds-hero" id="topo" aria-label="VOLYNX Design Studio">
      <div class="ds-hero__media" aria-hidden="true">
        <video
          class="ds-hero__video"
          src="/assets/design-studio-catalog-open.mp4"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        ></video>
      </div>

      <div class="shell ds-hero__content">
        <span class="ds-eyebrow" data-reveal>Brand Studio by VOLYNX</span>
        <h1 class="ds-hero__title" data-reveal aria-label="VOLYNX Design Studio">
          <img
            class="ds-hero__wordmark"
            src="/assets/design-studio/volynx-wordmark-gold.webp"
            alt="VOLYNX"
            width="1800"
            height="836"
            decoding="async"
            fetchpriority="high"
          />
          <span class="ds-hero__title-text">Design Studio</span>
        </h1>
        <p class="ds-hero__lead" data-reveal>
          Crie uma identidade de marca completa, nao apenas um logotipo.
          Diagnostico, direcao visual, aplicacoes reais e arquivos prontos para vender desde o primeiro contato.
        </p>

        <div class="ds-hero__actions" data-reveal>
          <a href="#diagnostico" class="ds-btn ds-btn--primary">Iniciar diagnostico</a>
          <a href="#brand-score" class="ds-btn ds-btn--ghost">Ver Brand Score</a>
        </div>

        <div class="ds-hero__signal" data-reveal aria-label="Diferenciais do Design Studio">
          <span>Logo</span>
          <span>Brand Kit</span>
          <span>Mockups</span>
          <span>Score</span>
          <span>Arquivos finais</span>
        </div>
      </div>

      <div class="ds-scroll-cue" aria-hidden="true">
        <span></span>
      </div>
    </section>

    <nav class="ds-subnav" aria-label="Navegacao do Design Studio">
      <div class="shell ds-subnav__inner">
        <a href="#diagnostico">Diagnostico</a>
        <a href="#arquitetura">Brand Architect</a>
        <a href="#aplicacoes">Aplicacoes</a>
        <a href="#brand-score">Score</a>
        <a href="#entrega">Entrega</a>
      </div>
    </nav>

    <section class="ds-intro page-section" aria-labelledby="ds-intro-title">
      <div class="shell ds-intro__grid">
        <div class="ds-section-copy" data-reveal>
          <span class="ds-eyebrow">Oportunidade real</span>
          <h2 id="ds-intro-title">A maioria cria um logo bonito. A VOLYNX constrói uma marca aplicavel.</h2>
          <p>
            O Design Studio nasce como um produto de identidade: entende o negocio, define a direcao, testa a marca em contexto real e entrega um sistema visual que pode virar site, campanha, placa, QR, social e material impresso.
          </p>
        </div>

        <div class="ds-principles" data-reveal>
          <article>
            <strong>Menos opcoes aleatorias</strong>
            <span>Mais criterio, mais contexto e menos ruido para o cliente decidir.</span>
          </article>
          <article>
            <strong>Marca em uso real</strong>
            <span>Preview em site, avatar, favicon, cartao, banner e assinatura.</span>
          </article>
          <article>
            <strong>Qualidade mensuravel</strong>
            <span>Score de legibilidade, versatilidade, memorabilidade e preparo para impressao.</span>
          </article>
        </div>
      </div>
    </section>

    <section class="ds-diagnostic page-section" id="diagnostico" aria-labelledby="ds-diagnostic-title">
      <div class="shell ds-diagnostic__grid">
        <div class="ds-studio-panel ds-diagnostic__form" data-reveal>
          <div class="ds-panel-head">
            <span class="ds-kicker">01 / Diagnostico guiado</span>
            <h2 id="ds-diagnostic-title">Comece pelo negocio, nao pelo desenho.</h2>
            <p>Digite um nome de teste e veja a pagina adaptar as aplicacoes em tempo real.</p>
          </div>

          <label class="ds-field">
            <span>Nome da marca</span>
            <input data-brand-input type="text" value="Aurora Clinic" maxlength="34" autocomplete="off" />
          </label>

          <div class="ds-choice-grid" aria-label="Pontos avaliados no briefing">
            <button class="ds-choice is-active" type="button">Publico</button>
            <button class="ds-choice" type="button">Mercado</button>
            <button class="ds-choice" type="button">Tom</button>
            <button class="ds-choice" type="button">Uso</button>
          </div>

          <div class="ds-brief-list" aria-label="Perguntas do diagnostico">
            <div>
              <strong>Onde essa marca precisa funcionar?</strong>
              <span>Site, placa, app icon, avatar, banner, embalagem ou material impresso.</span>
            </div>
            <div>
              <strong>Qual faixa de percepcao?</strong>
              <span>Acessivel, premium, tecnico, autoral, institucional ou experimental.</span>
            </div>
            <div>
              <strong>O que deve ser evitado?</strong>
              <span>Visual generico, simbolo fraco, baixa leitura, excesso de tendencia.</span>
            </div>
          </div>
        </div>

        <div class="ds-live-stage" data-reveal aria-label="Preview de identidade">
          <div class="ds-live-stage__top">
            <span>Live brand canvas</span>
            <strong data-brand-output>Aurora Clinic</strong>
          </div>

          <div class="ds-brand-canvas">
            <div class="ds-brand-mark" aria-hidden="true">
              <span></span>
            </div>
            <div>
              <p class="ds-brand-name" data-brand-output>Aurora Clinic</p>
              <p class="ds-brand-line">Calm precision for modern care</p>
            </div>
          </div>

          <div class="ds-mini-system" aria-label="Componentes do sistema visual">
            <span class="ds-swatch ds-swatch--a"></span>
            <span class="ds-swatch ds-swatch--b"></span>
            <span class="ds-swatch ds-swatch--c"></span>
            <span class="ds-font-sample">Aa</span>
            <span class="ds-file-pill">SVG</span>
            <span class="ds-file-pill">PDF</span>
          </div>

          <div class="ds-live-note">
            <strong>Preview conceitual</strong>
            <span>A experiencia final deve gerar direcoes, aplicacoes e pacotes de entrega a partir do briefing.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="ds-architect page-section" id="arquitetura" aria-labelledby="ds-architect-title">
      <div class="shell">
        <div class="ds-section-head" data-reveal>
          <span class="ds-eyebrow">Brand Architect</span>
          <h2 id="ds-architect-title">Um fluxo mais inteligente que um logo maker comum.</h2>
          <p>Looka, Canva, Adobe Express, Brandmark e Wix mostram caminhos bons. A oportunidade da VOLYNX e juntar facilidade com criterio de marca e aplicacao real.</p>
        </div>

        <div class="ds-flow" aria-label="Fluxo do Brand Architect">
          <article data-reveal>
            <img class="ds-flow__asset" src="/assets/design-studio/diagnosis.webp" alt="" width="128" height="128" loading="lazy" decoding="async" />
            <span>01</span>
            <h3>Diagnosticar</h3>
            <p>Negocio, publico, posicionamento, tom, concorrentes e canais de uso.</p>
          </article>
          <article data-reveal>
            <img class="ds-flow__asset" src="/assets/design-studio/direction.webp" alt="" width="128" height="128" loading="lazy" decoding="async" />
            <span>02</span>
            <h3>Direcionar</h3>
            <p>Paleta, linguagem, ritmo, referencias e riscos visuais antes de gerar.</p>
          </article>
          <article data-reveal>
            <img class="ds-flow__asset" src="/assets/design-studio/creation.webp" alt="" width="128" height="128" loading="lazy" decoding="async" />
            <span>03</span>
            <h3>Criar</h3>
            <p>Simbolo, wordmark, versoes horizontal e vertical, favicon e avatar.</p>
          </article>
          <article data-reveal>
            <img class="ds-flow__asset" src="/assets/design-studio/applying.webp" alt="" width="128" height="128" loading="lazy" decoding="async" />
            <span>04</span>
            <h3>Aplicar</h3>
            <p>Mockups em site, social, cartao, placa, banner, app e assinatura.</p>
          </article>
          <article data-reveal>
            <img class="ds-flow__asset" src="/assets/design-studio/evaluate.webp" alt="" width="128" height="128" loading="lazy" decoding="async" />
            <span>05</span>
            <h3>Avaliar</h3>
            <p>Brand Score para leitura, versatilidade, originalidade e impressao.</p>
          </article>
          <article data-reveal>
            <img class="ds-flow__asset" src="/assets/design-studio/delivery.webp" alt="" width="128" height="128" loading="lazy" decoding="async" />
            <span>06</span>
            <h3>Entregar</h3>
            <p>Arquivos organizados, guia rapido e formatos prontos para web e print.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="ds-applications page-section" id="aplicacoes" aria-labelledby="ds-applications-title">
      <div class="shell">
        <div class="ds-section-head" data-reveal>
          <span class="ds-eyebrow">Preview em contexto</span>
          <h2 id="ds-applications-title">A marca precisa sobreviver fora do arquivo.</h2>
          <p>O cliente decide melhor quando ve a identidade funcionando em situacoes reais, nao perdida em uma tela branca.</p>
        </div>

        <div class="ds-application-grid">
          <article class="ds-application ds-application--wide" data-reveal>
            <div class="ds-browser-frame">
              <div class="ds-browser-bar" aria-hidden="true"><span></span><span></span><span></span></div>
              <div class="ds-site-preview">
                <header>
                  <strong data-brand-output>Aurora Clinic</strong>
                  <nav><span>Services</span><span>Booking</span><span>Contact</span></nav>
                </header>
                <div>
                  <p>Modern brand system</p>
                  <h3>Identity built for the first click.</h3>
                  <span>Book consultation</span>
                </div>
              </div>
            </div>
            <h3>Header de site e landing</h3>
            <p>Wordmark, contraste, tom e hierarquia testados onde a venda realmente acontece.</p>
          </article>

          <article class="ds-application" data-reveal>
            <div class="ds-social-preview">
              <div class="ds-avatar"><span></span></div>
              <strong data-brand-output>Aurora Clinic</strong>
              <p>@brand.system</p>
              <div class="ds-social-lines" aria-hidden="true"><span></span><span></span><span></span></div>
            </div>
            <h3>Avatar social</h3>
            <p>Leitura rapida em tamanho pequeno, com simbolo preparado para perfil.</p>
          </article>

          <article class="ds-application" data-reveal>
            <div class="ds-card-preview">
              <span class="ds-card-mark"></span>
              <strong data-brand-output>Aurora Clinic</strong>
              <small>strategy / identity / launch</small>
            </div>
            <h3>Cartao e assinatura</h3>
            <p>Aplicacoes comerciais que revelam se a identidade parece confiavel.</p>
          </article>

          <article class="ds-application ds-application--tall" data-reveal>
            <div class="ds-sign-preview">
              <span data-brand-output>Aurora Clinic</span>
            </div>
            <h3>Placa, banner e impressao</h3>
            <p>Teste de escala para evitar logos bonitos na tela e fracos no mundo real.</p>
          </article>

          <article class="ds-application" data-reveal>
            <div class="ds-favicon-row">
              <span class="ds-favicon ds-favicon--one"></span>
              <span class="ds-favicon ds-favicon--two"></span>
              <span class="ds-favicon ds-favicon--three"></span>
            </div>
            <h3>Favicon e app icon</h3>
            <p>Versoes simplificadas para navegador, app, dashboard e atalhos.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="ds-score page-section" id="brand-score" aria-labelledby="ds-score-title">
      <div class="shell ds-score__grid">
        <div class="ds-section-copy" data-reveal>
          <span class="ds-eyebrow">Brand Score</span>
          <h2 id="ds-score-title">Um logo pode ser bonito e ainda falhar.</h2>
          <p>
            A camada de score ajuda a explicar, com criterio visual, onde a marca esta forte e onde precisa ser refinada. Nao promete validacao juridica, mas evita escolhas fracas, genericas ou pouco versateis.
          </p>
          <a href={whatsappBriefing} target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn--ghost">Pedir analise de marca</a>
        </div>

        <div class="ds-score-board" data-reveal>
          <div class="ds-score-board__head">
            <span>Prototype score</span>
            <strong>86</strong>
          </div>

          <div class="ds-score-list">
            <div class="ds-score-row" style="--score: 91%">
              <span>Versatilidade</span>
              <i></i>
              <strong>91</strong>
            </div>
            <div class="ds-score-row" style="--score: 88%">
              <span>Leitura</span>
              <i></i>
              <strong>88</strong>
            </div>
            <div class="ds-score-row" style="--score: 82%">
              <span>Memorabilidade</span>
              <i></i>
              <strong>82</strong>
            </div>
            <div class="ds-score-row" style="--score: 76%">
              <span>Originalidade</span>
              <i></i>
              <strong>76</strong>
            </div>
            <div class="ds-score-row" style="--score: 69%">
              <span>Favicon readiness</span>
              <i></i>
              <strong>69</strong>
            </div>
            <div class="ds-score-row" style="--score: 94%">
              <span>Print readiness</span>
              <i></i>
              <strong>94</strong>
            </div>
          </div>

          <div class="ds-score-warning">
            <strong>Insight exemplo</strong>
            <span>Funciona bem em aplicacoes grandes; a versao favicon deve ser simplificada para ganhar forca em 16px.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="ds-delivery page-section" id="entrega" aria-labelledby="ds-delivery-title">
      <div class="shell">
        <div class="ds-section-head" data-reveal>
          <span class="ds-eyebrow">Sistema de entrega</span>
          <h2 id="ds-delivery-title">Nao termina no logo. Comeca no pacote de marca.</h2>
          <p>A entrega precisa dar ao cliente seguranca para usar a identidade sem depender de adivinhacao.</p>
        </div>

        <div class="ds-delivery-grid">
          <article class="ds-delivery-card" data-reveal>
            <img src="/assets/studio-logo.webp" alt="" width="80" height="80" loading="lazy" />
            <span>Signa</span>
            <h3>Primeira direcao visual</h3>
            <p>Briefing, conceito, logo inicial, paleta base e orientacao de uso para projetos que precisam sair do zero com presenca.</p>
          </article>

          <article class="ds-delivery-card ds-delivery-card--featured" data-reveal>
            <img src="/assets/volynxstudio.webp" alt="" width="80" height="80" loading="lazy" />
            <span>Brand System</span>
            <h3>Identidade completa</h3>
            <p>Simbolo, wordmark, variacoes, favicon, avatar, paleta, tipografia, mini brand guide, mockups e arquivos finais.</p>
          </article>

          <article class="ds-delivery-card" data-reveal>
            <img src="/assets/builderstudio.webp" alt="" width="80" height="80" loading="lazy" />
            <span>Launch Kit</span>
            <h3>Marca aplicada para vender</h3>
            <p>Identidade conectada a landing, banners, social, QR, apresentacao e assets digitais para lancamento.</p>
          </article>
        </div>

        <div class="ds-export-strip" data-reveal aria-label="Formatos de entrega">
          <span>SVG</span>
          <span>PNG transparente</span>
          <span>PDF print-ready</span>
          <span>Favicon</span>
          <span>Avatar social</span>
          <span>Mini brand guide</span>
        </div>
      </div>
    </section>

    <section class="ds-cta-section" aria-labelledby="ds-cta-title">
      <div class="shell ds-cta__inner" data-reveal>
        <img src="/assets/wordmark-dark.webp" alt="VOLYNX" width="160" height="42" loading="lazy" />
        <span class="ds-eyebrow">Proxima marca</span>
        <h2 id="ds-cta-title">Vamos construir uma identidade que pareca pronta para existir.</h2>
        <p>Comece pelo diagnostico. A partir dele, a VOLYNX define o melhor caminho: Signa, Brand System ou Launch Kit.</p>
        <div class="ds-cta__actions">
          <a href={whatsappBriefing} target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn--primary ds-btn--large">
            Comecar pelo WhatsApp
          </a>
          <a href="#diagnostico" class="ds-btn ds-btn--ghost">Rever diagnostico</a>
        </div>
      </div>
    </section>
  </main>

  <FlagshipFooter />
</FlagshipLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .page-design-studio {
    --ds-bg: #02050a;
    --ds-bg-soft: #06111a;
    --ds-ink: rgba(246, 249, 255, 0.96);
    --ds-muted: rgba(218, 227, 239, 0.68);
    --ds-soft: rgba(246, 249, 255, 0.08);
    --ds-softer: rgba(246, 249, 255, 0.045);
    --ds-line: rgba(246, 249, 255, 0.12);
    --ds-line-strong: rgba(246, 249, 255, 0.22);
    --ds-cyan: #73f1ff;
    --ds-teal: #28d0b5;
    --ds-gold: #f5d06f;
    --ds-rose: #f08fb2;
    --ds-violet: #9ea7ff;
    --ds-shadow: 0 28px 90px rgba(0, 0, 0, 0.42);
    --ds-radius: 26px;
    --ds-radius-lg: 38px;
    --ds-ease: cubic-bezier(0.22, 1, 0.36, 1);
    color: var(--ds-ink);
    background: var(--ds-bg);
  }

  .ds-main {
    position: relative;
    z-index: 1;
    overflow: clip;
    min-height: 100vh;
    background:
      linear-gradient(130deg, rgba(115, 241, 255, 0.11), transparent 28%),
      linear-gradient(220deg, rgba(245, 208, 111, 0.09), transparent 26%),
      linear-gradient(180deg, #02050a 0%, #071019 48%, #02050a 100%);
  }

  .ds-main::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
      linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, transparent, black 18%, black 78%, transparent);
  }

  .ds-main::after {
    content: "";
    position: fixed;
    inset: -20%;
    z-index: -1;
    pointer-events: none;
    opacity: 0.5;
    background:
      conic-gradient(from 160deg at 18% 28%, rgba(115, 241, 255, 0.16), transparent 18%, rgba(245, 208, 111, 0.10), transparent 44%, rgba(240, 143, 178, 0.12), transparent 70%, rgba(115, 241, 255, 0.16)),
      linear-gradient(120deg, transparent, rgba(255,255,255,0.035), transparent);
    filter: blur(36px);
    animation: dsAmbient 18s var(--ds-ease) infinite alternate;
  }

  .shell {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
    position: relative;
    z-index: 2;
  }

  .page-section {
    position: relative;
    padding: clamp(74px, 10vw, 144px) 0;
  }

  .ds-eyebrow,
  .ds-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    color: rgba(222, 246, 255, 0.78);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ds-eyebrow::before,
  .ds-kicker::before {
    content: "";
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, var(--ds-cyan), transparent);
  }

  .ds-section-head,
  .ds-section-copy {
    max-width: 720px;
  }

  .ds-section-head {
    margin: 0 auto clamp(38px, 6vw, 72px);
    text-align: center;
  }

  .ds-section-head .ds-eyebrow {
    justify-content: center;
  }

  .ds-section-head .ds-eyebrow::after {
    content: "";
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--ds-cyan));
  }

  .ds-section-head h2,
  .ds-section-copy h2 {
    margin: 0;
    color: var(--ds-ink);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: clamp(28px, 4.5vw, 56px);
    line-height: 1.02;
    letter-spacing: 0;
  }

  .ds-section-head p,
  .ds-section-copy p {
    margin: 18px 0 0;
    color: var(--ds-muted);
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.75;
  }

  .ds-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 14px 24px;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--ds-ink);
    font-size: 14px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    transition:
      transform 260ms var(--ds-ease),
      border-color 260ms var(--ds-ease),
      background 260ms var(--ds-ease),
      box-shadow 260ms var(--ds-ease);
  }

  .ds-btn--primary {
    color: #031015;
    background: linear-gradient(135deg, #f7ffff 0%, #8bf7ff 42%, #f6d778 100%);
    box-shadow: 0 16px 46px rgba(115, 241, 255, 0.18);
  }

  .ds-btn--ghost {
    color: rgba(235, 249, 255, 0.88);
    background: rgba(255, 255, 255, 0.065);
    border-color: var(--ds-line);
    backdrop-filter: blur(18px);
  }

  .ds-btn--large {
    min-height: 56px;
    padding-inline: 30px;
    font-size: 15px;
  }

  .ds-btn:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.28);
  }

  .ds-btn--primary:hover {
    box-shadow: 0 24px 70px rgba(115, 241, 255, 0.26);
  }

  .ds-hero {
    position: relative;
    min-height: min(920px, 92vh);
    display: grid;
    place-items: center;
    padding: clamp(100px, 12vw, 154px) 0 clamp(82px, 10vw, 132px);
    isolation: isolate;
  }

  .ds-hero__media {
    position: absolute;
    inset: 0;
    z-index: -3;
    overflow: hidden;
    background: #02050a;
  }

  .ds-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ds-hero__video {
    position: absolute;
    inset: 0;
    opacity: 0.82;
    transform: scale(1.02);
    filter: saturate(1.28) contrast(1.12) brightness(1.14);
  }

  .ds-hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(180deg, rgba(2,5,10,0.18) 0%, rgba(2,5,10,0.06) 34%, rgba(2,5,10,0.7) 100%),
      radial-gradient(ellipse at 50% 48%, transparent 0%, transparent 48%, rgba(2,5,10,0.58) 100%);
  }

  .ds-hero__media::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.42;
    background:
      linear-gradient(115deg, transparent 0%, rgba(115,241,255,0.16) 38%, transparent 54%),
      linear-gradient(245deg, transparent 0%, rgba(245,208,111,0.12) 42%, transparent 60%);
    mix-blend-mode: screen;
    animation: dsHeroLight 8s var(--ds-ease) infinite alternate;
  }

  .ds-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(30px, 5vw, 50px);
    border-radius: clamp(34px, 5vw, 60px);
    background: rgba(3, 8, 14, 0.18);
    backdrop-filter: blur(8px);
  }

  .ds-hero h1 {
    max-width: 980px;
    margin: 0;
    color: var(--ds-ink);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: clamp(48px, 9vw, 116px);
    font-weight: 950;
    line-height: 0.92;
    letter-spacing: 0;
    text-wrap: balance;
    text-shadow: 0 26px 90px rgba(0, 0, 0, 0.45);
  }

  .ds-hero__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2px, 1vw, 12px);
  }

  .ds-hero__wordmark {
    display: block;
    width: min(86vw, 760px);
    height: auto;
    margin: 0 auto clamp(-34px, -3.2vw, -18px);
    object-fit: contain;
    filter:
      drop-shadow(0 22px 42px rgba(0, 0, 0, 0.5))
      drop-shadow(0 0 30px rgba(232, 166, 48, 0.2));
  }

  .ds-hero__title-text {
    display: block;
  }

  .ds-hero__lead {
    max-width: 760px;
    margin: 26px auto 0;
    color: rgba(236, 247, 255, 0.78);
    font-size: clamp(17px, 2vw, 22px);
    line-height: 1.65;
    text-wrap: balance;
  }

  .ds-hero__actions,
  .ds-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 34px;
  }

  .ds-hero__signal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: clamp(34px, 7vw, 72px);
  }

  .ds-hero__signal span {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    padding: 8px 14px;
    border: 1px solid rgba(255,255,255,0.13);
    border-radius: 999px;
    color: rgba(240, 249, 255, 0.8);
    background: rgba(4, 12, 18, 0.42);
    backdrop-filter: blur(18px);
    font-size: 12px;
    font-weight: 800;
  }

  .ds-scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 28px;
    width: 1px;
    height: 46px;
    transform: translateX(-50%);
    overflow: hidden;
    background: rgba(255,255,255,0.12);
  }

  .ds-scroll-cue span {
    display: block;
    width: 100%;
    height: 18px;
    background: linear-gradient(var(--ds-cyan), transparent);
    animation: dsScrollCue 1.8s var(--ds-ease) infinite;
  }

  .ds-subnav {
    position: sticky;
    top: 0;
    z-index: 20;
    border-block: 1px solid rgba(255,255,255,0.09);
    background: rgba(2, 5, 10, 0.62);
    backdrop-filter: blur(24px);
  }

  .ds-subnav__inner {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-block: 12px;
    scrollbar-width: none;
  }

  .ds-subnav__inner::-webkit-scrollbar {
    display: none;
  }

  .ds-subnav a {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 8px 14px;
    border-radius: 999px;
    color: rgba(236, 247, 255, 0.74);
    font-size: 12px;
    font-weight: 850;
    text-decoration: none;
    transition: background 220ms var(--ds-ease), color 220ms var(--ds-ease);
  }

  .ds-subnav a:hover {
    color: var(--ds-ink);
    background: rgba(255,255,255,0.08);
  }

  .ds-intro__grid,
  .ds-diagnostic__grid,
  .ds-score__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(340px, 1.05fr);
    gap: clamp(28px, 5vw, 74px);
    align-items: center;
  }

  .ds-principles {
    display: grid;
    gap: 14px;
  }

  .ds-principles article,
  .ds-studio-panel,
  .ds-live-stage,
  .ds-application,
  .ds-score-board,
  .ds-delivery-card {
    position: relative;
    border: 1px solid var(--ds-line);
    background:
      linear-gradient(145deg, rgba(255,255,255,0.105), rgba(255,255,255,0.035)),
      rgba(3, 10, 16, 0.66);
    box-shadow: var(--ds-shadow);
    backdrop-filter: blur(24px);
  }

  .ds-principles article {
    padding: 24px;
    border-radius: var(--ds-radius);
  }

  .ds-principles strong,
  .ds-brief-list strong,
  .ds-live-note strong,
  .ds-application h3,
  .ds-delivery-card h3 {
    display: block;
    color: var(--ds-ink);
    font-size: 15px;
    line-height: 1.3;
  }

  .ds-principles span,
  .ds-brief-list span,
  .ds-live-note span,
  .ds-application p,
  .ds-delivery-card p {
    display: block;
    margin-top: 8px;
    color: var(--ds-muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .ds-studio-panel,
  .ds-live-stage,
  .ds-score-board {
    border-radius: var(--ds-radius-lg);
    overflow: hidden;
  }

  .ds-diagnostic__form {
    padding: clamp(24px, 4vw, 38px);
  }

  .ds-panel-head h2 {
    margin: 0;
    color: var(--ds-ink);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1.05;
  }

  .ds-panel-head p {
    margin: 14px 0 0;
    color: var(--ds-muted);
    line-height: 1.65;
  }

  .ds-field {
    display: grid;
    gap: 10px;
    margin-top: 28px;
  }

  .ds-field span {
    color: rgba(236, 247, 255, 0.72);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ds-field input {
    width: 100%;
    min-height: 58px;
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 18px;
    color: var(--ds-ink);
    background: rgba(255,255,255,0.07);
    padding: 0 18px;
    font: inherit;
    font-size: 18px;
    outline: none;
    transition: border-color 220ms var(--ds-ease), box-shadow 220ms var(--ds-ease);
  }

  .ds-field input:focus {
    border-color: rgba(115, 241, 255, 0.65);
    box-shadow: 0 0 0 4px rgba(115, 241, 255, 0.12);
  }

  .ds-choice-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-top: 18px;
  }

  .ds-choice {
    min-height: 42px;
    border: 1px solid var(--ds-line);
    border-radius: 999px;
    color: rgba(236, 247, 255, 0.75);
    background: rgba(255,255,255,0.055);
    font: inherit;
    font-size: 12px;
    font-weight: 850;
    cursor: pointer;
  }

  .ds-choice.is-active,
  .ds-choice:hover {
    color: #031015;
    background: linear-gradient(135deg, #9bf9ff, #f2d77d);
  }

  .ds-brief-list {
    display: grid;
    gap: 14px;
    margin-top: 24px;
  }

  .ds-brief-list div {
    padding-left: 18px;
    border-left: 1px solid rgba(115, 241, 255, 0.35);
  }

  .ds-live-stage {
    padding: clamp(22px, 4vw, 34px);
    overflow: hidden;
    min-height: 540px;
  }

  .ds-live-stage::before {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    background:
      linear-gradient(140deg, rgba(115,241,255,0.16), transparent 32%),
      linear-gradient(320deg, rgba(245,208,111,0.14), transparent 36%);
    pointer-events: none;
  }

  .ds-live-stage__top,
  .ds-brand-canvas,
  .ds-mini-system,
  .ds-live-note {
    position: relative;
    z-index: 1;
  }

  .ds-live-stage__top {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    color: rgba(236, 247, 255, 0.65);
    font-size: 12px;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .ds-live-stage__top strong {
    color: var(--ds-ink);
    text-align: right;
    text-transform: none;
    letter-spacing: 0;
  }

  .ds-brand-canvas {
    display: grid;
    grid-template-columns: minmax(86px, auto) minmax(0, 1fr);
    gap: 22px;
    align-items: center;
    margin-top: 72px;
    padding: clamp(22px, 4vw, 34px);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 30px;
    background: rgba(1, 7, 12, 0.52);
  }

  .ds-brand-mark,
  .ds-avatar,
  .ds-favicon,
  .ds-card-mark {
    background:
      linear-gradient(135deg, rgba(115,241,255,0.95), rgba(40,208,181,0.82) 44%, rgba(245,208,111,0.92)),
      #73f1ff;
  }

  .ds-brand-mark {
    width: clamp(76px, 12vw, 118px);
    aspect-ratio: 1;
    border-radius: 32% 68% 54% 46% / 44% 34% 66% 56%;
    display: grid;
    place-items: center;
    box-shadow: 0 24px 70px rgba(115, 241, 255, 0.22);
  }

  .ds-brand-mark span {
    width: 42%;
    aspect-ratio: 1;
    border: 3px solid rgba(2, 5, 10, 0.76);
    border-radius: 50%;
  }

  .ds-brand-name {
    margin: 0;
    color: var(--ds-ink);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: clamp(28px, 4.2vw, 50px);
    font-weight: 900;
    line-height: 0.98;
    overflow-wrap: break-word;
    word-break: normal;
    hyphens: none;
    text-wrap: balance;
  }

  .ds-brand-line {
    margin: 12px 0 0;
    color: rgba(236, 247, 255, 0.62);
    font-size: clamp(13px, 1.5vw, 16px);
  }

  .ds-mini-system {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .ds-swatch,
  .ds-font-sample,
  .ds-file-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 42px;
    min-width: 42px;
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 14px;
    color: var(--ds-ink);
    background: rgba(255,255,255,0.07);
    font-weight: 900;
  }

  .ds-swatch--a { background: #73f1ff; }
  .ds-swatch--b { background: #f5d06f; }
  .ds-swatch--c { background: #06111a; }

  .ds-file-pill {
    min-width: 62px;
    padding-inline: 12px;
    border-radius: 999px;
    font-size: 12px;
  }

  .ds-live-note {
    margin-top: 28px;
    padding: 18px;
    border: 1px solid rgba(245, 208, 111, 0.22);
    border-radius: 22px;
    background: rgba(245, 208, 111, 0.07);
  }

  .ds-flow {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .ds-flow article {
    position: relative;
    min-height: 210px;
    padding: 26px;
    border: 1px solid var(--ds-line);
    border-radius: var(--ds-radius);
    background: rgba(255,255,255,0.052);
    overflow: hidden;
  }

  .ds-flow__asset {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 88px;
    height: 88px;
    object-fit: contain;
    z-index: 0;
    opacity: 0.92;
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.42));
    transform: translateY(0) scale(1);
    transition:
      opacity 320ms var(--ds-ease),
      transform 320ms var(--ds-ease),
      filter 320ms var(--ds-ease);
  }

  .ds-flow article:hover .ds-flow__asset {
    opacity: 1;
    transform: translateY(-4px) scale(1.04);
    filter: drop-shadow(0 22px 36px rgba(115, 241, 255, 0.16)) drop-shadow(0 18px 30px rgba(0, 0, 0, 0.44));
  }

  .ds-flow article::after {
    content: "";
    position: absolute;
    inset: auto 20px 18px auto;
    width: 72px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(115,241,255,0.6));
  }

  .ds-flow span {
    position: relative;
    z-index: 1;
    color: var(--ds-gold);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .ds-flow h3 {
    position: relative;
    z-index: 1;
    margin: 46px 0 10px;
    color: var(--ds-ink);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: 20px;
  }

  .ds-flow p {
    position: relative;
    z-index: 1;
    margin: 0;
    color: var(--ds-muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .ds-application-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 16px;
    align-items: stretch;
  }

  .ds-application {
    grid-column: span 4;
    min-height: 360px;
    padding: 22px;
    border-radius: var(--ds-radius);
    overflow: hidden;
  }

  .ds-application--wide {
    grid-column: span 8;
  }

  .ds-application--tall {
    grid-row: span 2;
  }

  .ds-browser-frame,
  .ds-social-preview,
  .ds-card-preview,
  .ds-sign-preview,
  .ds-favicon-row {
    margin-bottom: 22px;
  }

  .ds-browser-frame {
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 22px;
    background: #030910;
  }

  .ds-browser-bar {
    display: flex;
    gap: 6px;
    padding: 12px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .ds-browser-bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255,255,255,0.28);
  }

  .ds-site-preview {
    min-height: 230px;
    padding: 22px;
    background:
      linear-gradient(135deg, rgba(115,241,255,0.15), transparent 34%),
      linear-gradient(315deg, rgba(245,208,111,0.13), transparent 30%),
      #05111a;
  }

  .ds-site-preview header {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;
    color: var(--ds-ink);
  }

  .ds-site-preview nav {
    display: flex;
    gap: 10px;
    color: rgba(236,247,255,0.58);
    font-size: 11px;
  }

  .ds-site-preview p {
    margin: 54px 0 8px;
    color: var(--ds-gold);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .ds-site-preview h3 {
    max-width: 420px;
    margin: 0;
    color: var(--ds-ink);
    font-size: clamp(24px, 4vw, 42px);
    line-height: 1.02;
  }

  .ds-site-preview div > span {
    display: inline-flex;
    margin-top: 24px;
    padding: 10px 14px;
    border-radius: 999px;
    color: #031015;
    background: #f5d06f;
    font-size: 12px;
    font-weight: 900;
  }

  .ds-social-preview {
    display: grid;
    place-items: center;
    min-height: 220px;
    text-align: center;
    border-radius: 24px;
    background: rgba(255,255,255,0.055);
  }

  .ds-avatar {
    width: 82px;
    aspect-ratio: 1;
    border-radius: 50%;
    margin-bottom: 14px;
  }

  .ds-social-preview strong {
    color: var(--ds-ink);
  }

  .ds-social-preview p {
    margin: 4px 0 18px;
    font-size: 12px;
  }

  .ds-social-lines {
    display: grid;
    gap: 6px;
    width: min(160px, 80%);
  }

  .ds-social-lines span {
    height: 7px;
    border-radius: 999px;
    background: rgba(255,255,255,0.12);
  }

  .ds-card-preview {
    display: grid;
    gap: 16px;
    align-content: end;
    min-height: 220px;
    padding: 22px;
    border-radius: 24px;
    color: #06111a;
    background: linear-gradient(145deg, #effaff, #b9f7f0 50%, #f5d06f);
  }

  .ds-card-preview strong {
    color: #06111a;
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: 22px;
    overflow-wrap: anywhere;
  }

  .ds-card-preview small {
    color: rgba(6,17,26,0.68);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .ds-card-mark {
    width: 54px;
    aspect-ratio: 1;
    border-radius: 18px;
    background: #06111a;
  }

  .ds-sign-preview {
    min-height: 420px;
    display: grid;
    place-items: center;
    padding: 26px;
    border-radius: 26px;
    background:
      linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(180deg, #0b1620, #03070d);
    background-size: 34px 34px, 34px 34px, auto;
  }

  .ds-sign-preview span {
    max-width: 100%;
    color: var(--ds-ink);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: clamp(24px, 4vw, 48px);
    font-weight: 950;
    text-align: center;
    text-shadow: 0 0 34px rgba(115,241,255,0.3);
    overflow-wrap: anywhere;
  }

  .ds-favicon-row {
    min-height: 220px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    border-radius: 24px;
    background: rgba(255,255,255,0.055);
  }

  .ds-favicon {
    width: 54px;
    aspect-ratio: 1;
    border-radius: 16px;
  }

  .ds-favicon--two {
    width: 72px;
    border-radius: 24px;
  }

  .ds-favicon--three {
    width: 42px;
    border-radius: 50%;
  }

  .ds-score {
    background:
      linear-gradient(180deg, transparent, rgba(115, 241, 255, 0.035), transparent);
  }

  .ds-score .ds-btn {
    margin-top: 26px;
  }

  .ds-score-board {
    padding: clamp(24px, 4vw, 38px);
  }

  .ds-score-board__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--ds-line);
  }

  .ds-score-board__head span {
    color: rgba(236,247,255,0.62);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ds-score-board__head strong {
    color: var(--ds-ink);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: clamp(64px, 10vw, 112px);
    line-height: 0.82;
  }

  .ds-score-list {
    display: grid;
    gap: 16px;
    margin-top: 28px;
  }

  .ds-score-row {
    display: grid;
    grid-template-columns: minmax(120px, 170px) minmax(80px, 1fr) 34px;
    align-items: center;
    gap: 14px;
  }

  .ds-score-row span,
  .ds-score-row strong {
    color: rgba(236,247,255,0.8);
    font-size: 13px;
    font-weight: 850;
  }

  .ds-score-row i {
    position: relative;
    height: 9px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255,255,255,0.09);
  }

  .ds-score-row i::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--score);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--ds-cyan), var(--ds-teal), var(--ds-gold));
  }

  .ds-score-warning {
    margin-top: 28px;
    padding: 18px;
    border: 1px solid rgba(245, 208, 111, 0.24);
    border-radius: 22px;
    background: rgba(245, 208, 111, 0.075);
  }

  .ds-score-warning strong,
  .ds-score-warning span {
    display: block;
  }

  .ds-score-warning strong {
    color: var(--ds-gold);
  }

  .ds-score-warning span {
    margin-top: 6px;
    color: var(--ds-muted);
    line-height: 1.6;
  }

  .ds-delivery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .ds-delivery-card {
    min-height: 390px;
    padding: 30px;
    border-radius: var(--ds-radius);
  }

  .ds-delivery-card--featured {
    border-color: rgba(115, 241, 255, 0.34);
    transform: translateY(-18px);
  }

  .ds-delivery-card img {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 20px;
    margin-bottom: 34px;
  }

  .ds-delivery-card span {
    display: inline-flex;
    margin-bottom: 12px;
    color: var(--ds-gold);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ds-delivery-card h3 {
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: clamp(22px, 2.4vw, 30px);
