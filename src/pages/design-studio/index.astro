---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";

const whatsappBriefing = `${ROUTES.whatsapp}?text=Olá%20VOLYNX%2C%20gostaria%20de%20solicitar%20um%20orçamento%20para%20o%20Design%20Studio.`;
---

<FlagshipLayout
  title="VOLYNX Design Studio — Identidade Visual e Branding Premium"
  description="Logotipos, sistemas visuais, ícones e assets premium. Marcas construídas para parecerem prontas para vender desde o primeiro dia."
  ogImage="/assets/volynxstudio.webp"
  pageClass="page-design-studio"
>
  <FlagshipHeader current={ROUTES.designStudio} />

  <main class="ds-main">

    <!-- ═══════════════════════════════════════════════════
         HERO — vídeo central + copy + CTAs
    ════════════════════════════════════════════════════ -->
    <section class="ds-hero" aria-label="Hero VOLYNX Design Studio">
      <!-- Camada de luz ambiente -->
      <div class="ds-hero__glow" aria-hidden="true"></div>

      <!-- Vídeo central -->
      <div class="ds-hero__cinema" aria-hidden="true">
        <video
          class="ds-hero__video"
          src="/assets/design-studio-catalog-open.mp4"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-hidden="true"
        ></video>
        <!-- Fallback se o vídeo não carregar -->
        <div class="ds-hero__video-fallback" aria-hidden="true">
          <img src="/assets/volynxstudio.webp" alt="" loading="eager" width="720" height="480" />
        </div>
        <div class="ds-hero__video-vignette" aria-hidden="true"></div>
      </div>

      <!-- Copy principal -->
      <div class="ds-hero__content shell">
        <div class="ds-hero__copy">
          <span class="ds-eyebrow">VOLYNX Design Studio</span>
          <h1 class="ds-hero__headline">
            Sua marca<br />
            <em>pronta para vender</em>
          </h1>
          <p class="ds-hero__sub">
            Logotipos, sistemas visuais, ícones grandes e assets premium para negócios que precisam parecer sérios desde o primeiro contato.
          </p>
          <div class="ds-hero__actions">
            <a
              href={whatsappBriefing}
              target="_blank"
              rel="noopener noreferrer"
              class="ds-btn ds-btn--primary"
            >
              Solicitar orçamento
            </a>
            <a href="#signa" class="ds-btn ds-btn--ghost">
              Conhecer Signa
            </a>
          </div>
        </div>
      </div>

      <!-- Linha decorativa inferior -->
      <div class="ds-hero__rule" aria-hidden="true"></div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         POSICIONAMENTO — strip de atributos
    ════════════════════════════════════════════════════ -->
    <section class="ds-attributes" aria-label="Atributos do estúdio">
      <div class="shell ds-attributes__grid">
        <div class="ds-attr" data-reveal>
          <span class="ds-attr__symbol" aria-hidden="true">◈</span>
          <strong>Identidade visual completa</strong>
          <span>Logotipo, paleta, tipografia, sistema.</span>
        </div>
        <div class="ds-attr" data-reveal>
          <span class="ds-attr__symbol" aria-hidden="true">◇</span>
          <strong>Ícones grandes para seções</strong>
          <span>Assets únicos pensados para cada contexto.</span>
        </div>
        <div class="ds-attr" data-reveal>
          <span class="ds-attr__symbol" aria-hidden="true">◆</span>
          <strong>Entrega estruturada</strong>
          <span>Brief, aprovação, criação, refinamento, entrega.</span>
        </div>
        <div class="ds-attr" data-reveal>
          <span class="ds-attr__symbol" aria-hidden="true">◉</span>
          <strong>Pronto para uso imediato</strong>
          <span>Arquivos organizados, formatos corretos.</span>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         SERVIÇOS PREMIUM
    ════════════════════════════════════════════════════ -->
    <section class="ds-services page-section" id="servicos" aria-labelledby="ds-svc-title">
      <div class="shell">
        <div class="ds-section-head" data-reveal>
          <span class="ds-eyebrow">O que fazemos</span>
          <h2 id="ds-svc-title">Serviços premium</h2>
          <p>Cada projeto é construído com intenção, rigor visual e alinhamento com o que você vende.</p>
        </div>

        <div class="ds-services__grid">

          <article class="ds-svc-card" data-reveal>
            <div class="ds-svc-card__icon" aria-hidden="true">
              <img src="/assets/studio-logo.webp" alt="" loading="lazy" width="64" height="64" />
            </div>
            <h3>Logotipo e identidade visual</h3>
            <p>Sistema completo de marca: símbolo, logotipo, variações, paleta, tipografia e guia de uso. Não é um logo isolado — é o início de um sistema.</p>
          </article>

          <article class="ds-svc-card" data-reveal>
            <div class="ds-svc-card__icon" aria-hidden="true">
              <img src="/assets/bignewicons_03.webp" alt="" loading="lazy" width="64" height="64" />
            </div>
            <h3>Ícones grandes para seções</h3>
            <p>Ilustrações e ícones oversized criados para landing pages e seções de produto — peças únicas que diferenciam seu produto visualmente.</p>
          </article>

          <article class="ds-svc-card" data-reveal>
            <div class="ds-svc-card__icon" aria-hidden="true">
              <img src="/assets/builderstudio.webp" alt="" loading="lazy" width="64" height="64" />
            </div>
            <h3>Assets para landing pages</h3>
            <p>Elementos visuais premium — heroes, mockups, banners, imagens de seção — projetados para converter e comunicar qualidade.</p>
          </article>

          <article class="ds-svc-card" data-reveal>
            <div class="ds-svc-card__icon" aria-hidden="true">
              <img src="/assets/api.webp" alt="" loading="lazy" width="64" height="64" />
            </div>
            <h3>Direção visual para produtos digitais</h3>
            <p>Para apps, SaaS e ferramentas: definição visual da interface — linguagem gráfica, tom, hierarquia, paleta e identidade de produto.</p>
          </article>

          <article class="ds-svc-card" data-reveal>
            <div class="ds-svc-card__icon" aria-hidden="true">
              <img src="/assets/allproducts.webp" alt="" loading="lazy" width="64" height="64" />
            </div>
            <h3>Kits visuais completos</h3>
            <p>Pacotes de assets organizados para marcas, apps e negócios — entregue pronto para usar em qualquer plataforma ou campanha.</p>
          </article>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         SIGNA BY VOLYNX
    ════════════════════════════════════════════════════ -->
    <section class="ds-signa" id="signa" aria-labelledby="ds-signa-title">
      <div class="ds-signa__bg" aria-hidden="true">
        <div class="ds-signa__bg-glow" aria-hidden="true"></div>
      </div>

      <div class="shell ds-signa__inner">

        <div class="ds-signa__badge" data-reveal aria-hidden="true">
          <img src="/assets/volynxstudio.webp" alt="" loading="lazy" width="120" height="120" />
        </div>

        <div class="ds-signa__copy" data-reveal>
          <span class="ds-eyebrow ds-eyebrow--gold">Signa by VOLYNX</span>
          <h2 id="ds-signa-title">Primeiro passo. Com presença.</h2>
          <p class="ds-signa__lead">
            Para projetos em fase inicial, Signa oferece uma primeira direção visual com tecnologia assistida: mais acessível que um projeto completo, mas ainda pensado para começar com presença, clareza e qualidade.
          </p>
          <p>
            Não é um rascunho ou um ponto de partida improvisado. É uma base visual construída com método — para que você já entre no mercado com consistência e intenção.
          </p>

          <div class="ds-signa__deliverables">
            <div class="ds-signa__item">
              <span class="ds-signa__dot" aria-hidden="true"></span>
              <div>
                <strong>Briefing guiado</strong>
                <span>Perguntas certas para revelar o que sua marca precisa comunicar.</span>
              </div>
            </div>
            <div class="ds-signa__item">
              <span class="ds-signa__dot" aria-hidden="true"></span>
              <div>
                <strong>Conceito visual</strong>
                <span>Direção de linguagem: tom, estilo, referências e posicionamento visual.</span>
              </div>
            </div>
            <div class="ds-signa__item">
              <span class="ds-signa__dot" aria-hidden="true"></span>
              <div>
                <strong>Símbolo e marca</strong>
                <span>Um logotipo gerado com direção — pensado para a sua categoria.</span>
              </div>
            </div>
            <div class="ds-signa__item">
              <span class="ds-signa__dot" aria-hidden="true"></span>
              <div>
                <strong>Paleta inicial</strong>
                <span>Cores com lógica — primária, secundária, neutros e estado de marca.</span>
              </div>
            </div>
            <div class="ds-signa__item">
              <span class="ds-signa__dot" aria-hidden="true"></span>
              <div>
                <strong>Pode evoluir</strong>
                <span>Signa é a entrada para o Design Studio completo quando você estiver pronto.</span>
              </div>
            </div>
          </div>

          <div class="ds-signa__actions">
            <a
              href={whatsappBriefing}
              target="_blank"
              rel="noopener noreferrer"
              class="ds-btn ds-btn--gold"
            >
              Solicitar Signa
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         PROCESSO
    ════════════════════════════════════════════════════ -->
    <section class="ds-process page-section" id="processo" aria-labelledby="ds-process-title">
      <div class="shell">
        <div class="ds-section-head" data-reveal>
          <span class="ds-eyebrow">Como acontece</span>
          <h2 id="ds-process-title">Um processo claro, do início ao arquivo final</h2>
          <p>Sem suposições. Cada etapa tem um resultado concreto e você sabe exatamente onde está.</p>
        </div>

        <ol class="ds-steps" aria-label="Etapas do processo">
          <li class="ds-step" data-reveal>
            <div class="ds-step__num" aria-hidden="true">01</div>
            <div class="ds-step__body">
              <h3>Briefing</h3>
              <p>Você preenche ou responde perguntas sobre seu negócio, público, tom e objetivos. Quanto mais contexto, melhor o resultado.</p>
            </div>
          </li>
          <li class="ds-step" data-reveal>
            <div class="ds-step__num" aria-hidden="true">02</div>
            <div class="ds-step__body">
              <h3>Direção visual</h3>
              <p>Antes de criar qualquer arquivo, definimos juntos a linguagem visual: referências, estilo, paleta base e posicionamento da marca.</p>
            </div>
          </li>
          <li class="ds-step" data-reveal>
            <div class="ds-step__num" aria-hidden="true">03</div>
            <div class="ds-step__body">
              <h3>Criação</h3>
              <p>O projeto entra em produção com a direção aprovada. Logotipo, sistema, ícones ou assets — de acordo com o escopo definido.</p>
            </div>
          </li>
          <li class="ds-step" data-reveal>
            <div class="ds-step__num" aria-hidden="true">04</div>
            <div class="ds-step__body">
              <h3>Refinamento</h3>
              <p>Rodada de revisão estruturada. Ajustes dentro do escopo aprovado — sem retrabalho aberto, sem escopo inflado.</p>
            </div>
          </li>
          <li class="ds-step" data-reveal>
            <div class="ds-step__num" aria-hidden="true">05</div>
            <div class="ds-step__body">
              <h3>Entrega</h3>
              <p>Arquivos organizados, em todos os formatos necessários. SVG, PNG, PDF, formatos de uso web e impresso — prontos para usar.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         CTA FINAL
    ════════════════════════════════════════════════════ -->
    <section class="ds-cta-section" aria-labelledby="ds-cta-title">
      <div class="ds-cta__glow" aria-hidden="true"></div>
      <div class="shell ds-cta__inner" data-reveal>
        <div class="ds-cta__wordmark" aria-hidden="true">
          <img src="/assets/wordmark-dark.webp" alt="VOLYNX" loading="lazy" width="160" height="auto" />
        </div>
        <h2 id="ds-cta-title">Pronto para começar?</h2>
        <p>Compartilhe o que você está construindo. VOLYNX cuida da identidade visual.</p>
        <div class="ds-cta__actions">
          <a
            href={whatsappBriefing}
            target="_blank"
            rel="noopener noreferrer"
            class="ds-btn ds-btn--primary ds-btn--large"
          >
            Solicitar orçamento
          </a>
          <a href="#signa" class="ds-btn ds-btn--ghost">
            Conhecer Signa
          </a>
        </div>
      </div>
    </section>

  </main>

  <FlagshipFooter />
</FlagshipLayout>

<!-- ═══════════════════════════════════════════════════════════
     ESTILOS DA PÁGINA
════════════════════════════════════════════════════════════ -->
<style>
  /* ── Tokens locais ──────────────────────────────────────── */
  .page-design-studio {
    --ds-gold:        #f3d97a;
    --ds-gold-dim:    rgba(243, 217, 122, 0.15);
    --ds-chrome:      #d0d8e8;
    --ds-chrome-dim:  rgba(208, 216, 232, 0.12);
    --ds-bg:          #03040a;
    --ds-bg-2:        #060810;
    --ds-panel:       rgba(255, 255, 255, 0.045);
    --ds-panel-hover: rgba(255, 255, 255, 0.07);
    --ds-line:        rgba(255, 255, 255, 0.08);
    --ds-text:        rgba(235, 238, 252, 0.92);
    --ds-muted:       rgba(200, 205, 230, 0.68);
    --ds-radius:      8px;
    --ds-transition:  0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ── Main wrapper ───────────────────────────────────────── */
  .ds-main {
    position: relative;
    z-index: 2;
    overflow: hidden;
  }

  /* ── Shell ──────────────────────────────────────────────── */
  .shell {
    width: min(1200px, calc(100% - 40px));
    margin-inline: auto;
    position: relative;
    z-index: 2;
  }

  /* ── Eyebrow / kicker ───────────────────────────────────── */
  .ds-eyebrow {
    display: inline-block;
    font-family: var(--font-display, "Orbitron", monospace);
    font-size: clamp(10px, 1.5vw, 12px);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ds-chrome);
    opacity: 0.7;
    margin-bottom: 12px;
  }
  .ds-eyebrow--gold {
    color: var(--ds-gold);
    opacity: 0.85;
  }

  /* ── Section head ───────────────────────────────────────── */
  .ds-section-head {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: clamp(48px, 6vw, 80px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .ds-section-head h2 {
    font-family: var(--font-display, "Orbitron", monospace);
    font-size: clamp(24px, 3.6vw, 40px);
    font-weight: 800;
    line-height: 1.12;
    color: var(--ds-text);
    margin: 0 0 16px;
  }
  .ds-section-head p {
    font-size: clamp(14px, 1.6vw, 16px);
    color: var(--ds-muted);
    line-height: 1.7;
    margin: 0;
  }

  /* ── Page section spacing ───────────────────────────────── */
  .page-section {
    padding: clamp(80px, 10vw, 140px) 0;
    position: relative;
  }

  /* ══════════════════════════════════════════════════════════
     HERO
  ═══════════════════════════════════════════════════════════ */
  .ds-hero {
    position: relative;
    min-height: clamp(640px, 90vh, 860px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-top: 80px;
    padding-bottom: 60px;
  }

  /* Luz ambiente hero */
  .ds-hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 40% at 50% 30%, rgba(208, 216, 232, 0.06), transparent 60%),
      radial-gradient(ellipse 80% 60% at 50% 100%, rgba(243, 217, 122, 0.04), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Moldura de vídeo */
  .ds-hero__cinema {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .ds-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.28;
    transition: opacity 1.2s ease;
  }
  .ds-hero__video-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ds-hero__video-fallback img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.12;
  }
  /* Quando o vídeo carrega, esconde o fallback */
  .ds-hero__video:not([error]) ~ .ds-hero__video-fallback {
    opacity: 0;
  }
  /* Vinheta nas bordas */
  .ds-hero__video-vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 100% 100% at 50% 50%,
        transparent 30%,
        rgba(3, 4, 10, 0.6) 70%,
        rgba(3, 4, 10, 0.95) 100%);
    pointer-events: none;
  }

  /* Copy do hero */
  .ds-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 20px;
  }
  .ds-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 780px;
    margin-inline: auto;
  }
  .ds-hero__headline {
    font-family: var(--font-display, "Orbitron", monospace);
    font-size: clamp(36px, 6vw, 76px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ds-text);
    margin: 0 0 24px;
    text-shadow: 0 0 60px rgba(208, 216, 232, 0.12);
  }
  .ds-hero__headline em {
    font-style: normal;
    background: linear-gradient(135deg, var(--ds-chrome) 0%, var(--ds-gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .ds-hero__sub {
    font-size: clamp(15px, 1.8vw, 18px);
    color: var(--ds-muted);
    line-height: 1.7;
    margin: 0 0 36px;
    max-width: 580px;
  }

  /* Hero actions */
  .ds-hero__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Linha inferior do hero */
  .ds-hero__rule {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(600px, 80%);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--ds-line) 30%, var(--ds-line) 70%, transparent);
    z-index: 2;
  }

  /* ══════════════════════════════════════════════════════════
     BOTÕES
  ═══════════════════════════════════════════════════════════ */
  .ds-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--ds-radius);
    font-family: var(--font-body, "Manrope", sans-serif);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    transition: all var(--ds-transition);
    cursor: pointer;
    border: none;
    min-height: 48px;
  }
  .ds-btn--primary {
    background: linear-gradient(135deg, #c8d4e8 0%, #e8edf8 50%, #c0ccdc 100%);
    color: #04050a;
    box-shadow: 0 4px 24px rgba(208, 216, 232, 0.22), 0 1px 0 rgba(255,255,255,0.3) inset;
  }
  .ds-btn--primary:hover {
    background: linear-gradient(135deg, #d8e4f8 0%, #f0f5ff 50%, #d0dcec 100%);
    box-shadow: 0 8px 32px rgba(208, 216, 232, 0.38), 0 1px 0 rgba(255,255,255,0.4) inset;
    transform: translateY(-2px);
  }
  .ds-btn--primary:active { transform: translateY(0); }
  .ds-btn--ghost {
    background: var(--ds-panel);
    border: 1px solid var(--ds-line);
    color: var(--ds-chrome);
  }
  .ds-btn--ghost:hover {
    background: var(--ds-panel-hover);
    border-color: rgba(255,255,255,0.18);
    color: #fff;
    transform: translateY(-1px);
  }
  .ds-btn--gold {
    background: linear-gradient(135deg, #c8a830 0%, #f3d97a 50%, #c8a830 100%);
    color: #04050a;
    box-shadow: 0 4px 24px rgba(243, 217, 122, 0.28);
  }
  .ds-btn--gold:hover {
    box-shadow: 0 8px 32px rgba(243, 217, 122, 0.42);
    transform: translateY(-2px);
    filter: brightness(1.06);
  }
  .ds-btn--large {
    padding: 18px 40px;
    font-size: 16px;
    min-height: 56px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-btn:hover { transform: none; }
  }

  /* ══════════════════════════════════════════════════════════
     ATRIBUTOS
  ═══════════════════════════════════════════════════════════ */
  .ds-attributes {
    padding: clamp(40px, 5vw, 64px) 0;
    border-top: 1px solid var(--ds-line);
    border-bottom: 1px solid var(--ds-line);
    position: relative;
    z-index: 2;
  }
  .ds-attributes__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--ds-line);
    border: 1px solid var(--ds-line);
    border-radius: 12px;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .ds-attributes__grid { grid-template-columns: repeat(4, 1fr); }
  }
  .ds-attr {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 28px 24px;
    background: var(--ds-bg-2);
    transition: background var(--ds-transition);
  }
  .ds-attr:hover { background: var(--ds-panel-hover); }
  .ds-attr__symbol {
    font-size: 20px;
    color: var(--ds-gold);
    opacity: 0.7;
    line-height: 1;
    margin-bottom: 4px;
  }
  .ds-attr strong {
    font-size: 14px;
