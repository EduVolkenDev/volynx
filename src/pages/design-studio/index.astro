  }

  .ds-export-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
  }

  .ds-export-strip span {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    padding: 9px 14px;
    border: 1px solid var(--ds-line);
    border-radius: 999px;
