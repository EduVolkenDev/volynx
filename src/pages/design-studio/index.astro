    aspect-ratio: 1;
    border-radius: 32% 68% 54% 46% / 44% 34% 66% 56%;
    display: grid;
    place-items: center;
    box-shadow: 0 24px 70px rgba(115, 241, 255, 0.22);
  }

  .ds-brand-mark span {
    width: 42%;
    aspect-ratio: 1;
    border: 3px solid rgba(2, 5, 10, 0.76);
    border-radius: 50%;
  }

  .ds-brand-name {
    margin: 0;
    color: var(--ds-ink);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: clamp(28px, 4.2vw, 50px);
    font-weight: 900;
    line-height: 0.98;
    overflow-wrap: break-word;
    word-break: normal;
    hyphens: none;
    text-wrap: balance;
  }

  .ds-brand-line {
    margin: 12px 0 0;
    color: rgba(236, 247, 255, 0.62);
    font-size: clamp(13px, 1.5vw, 16px);
  }

  .ds-mini-system {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .ds-swatch,
  .ds-font-sample,
  .ds-file-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 42px;
    min-width: 42px;
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 14px;
    color: var(--ds-ink);
    background: rgba(255,255,255,0.07);
    font-weight: 900;
  }

  .ds-swatch--a { background: #73f1ff; }
  .ds-swatch--b { background: #f5d06f; }
  .ds-swatch--c { background: #06111a; }

  .ds-file-pill {
    min-width: 62px;
    padding-inline: 12px;
    border-radius: 999px;
    font-size: 12px;
  }

  .ds-live-note {
    margin-top: 28px;
    padding: 18px;
    border: 1px solid rgba(245, 208, 111, 0.22);
    border-radius: 22px;
    background: rgba(245, 208, 111, 0.07);
  }

  .ds-flow {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .ds-flow article {
    position: relative;
    min-height: 210px;
    padding: 26px;
    border: 1px solid var(--ds-line);
    border-radius: var(--ds-radius);
    background: rgba(255,255,255,0.052);
    overflow: hidden;
  }

  .ds-flow__asset {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 88px;
    height: 88px;
    object-fit: contain;
    z-index: 0;
    opacity: 0.92;
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.42));
    transform: translateY(0) scale(1);
    transition:
      opacity 320ms var(--ds-ease),
      transform 320ms var(--ds-ease),
      filter 320ms var(--ds-ease);
  }

  .ds-flow article:hover .ds-flow__asset {
    opacity: 1;
    transform: translateY(-4px) scale(1.04);
    filter: drop-shadow(0 22px 36px rgba(115, 241, 255, 0.16)) drop-shadow(0 18px 30px rgba(0, 0, 0, 0.44));
  }

  .ds-flow article::after {
    content: "";
    position: absolute;
    inset: auto 20px 18px auto;
    width: 72px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(115,241,255,0.6));
  }

  .ds-flow span {
    position: relative;
    z-index: 1;
    color: var(--ds-gold);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .ds-flow h3 {
    position: relative;
    z-index: 1;
    margin: 46px 0 10px;
    color: var(--ds-ink);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: 20px;
  }

  .ds-flow p {
    position: relative;
    z-index: 1;
    margin: 0;
    color: var(--ds-muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .ds-application-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 16px;
    align-items: stretch;
  }

  .ds-application {
    grid-column: span 4;
    min-height: 360px;
    padding: 22px;
    border-radius: var(--ds-radius);
    overflow: hidden;
  }

  .ds-application--wide {
    grid-column: span 8;
  }

  .ds-application--tall {
    grid-row: span 2;
  }

  .ds-browser-frame,
  .ds-social-preview,
  .ds-card-preview,
  .ds-sign-preview,
  .ds-favicon-row {
    margin-bottom: 22px;
  }

  .ds-browser-frame {
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 22px;
    background: #030910;
  }

  .ds-browser-bar {
    display: flex;
    gap: 6px;
    padding: 12px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .ds-browser-bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255,255,255,0.28);
  }

  .ds-site-preview {
    min-height: 230px;
    padding: 22px;
    background:
      linear-gradient(135deg, rgba(115,241,255,0.15), transparent 34%),
      linear-gradient(315deg, rgba(245,208,111,0.13), transparent 30%),
      #05111a;
  }

  .ds-site-preview header {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;
    color: var(--ds-ink);
  }

  .ds-site-preview nav {
    display: flex;
    gap: 10px;
    color: rgba(236,247,255,0.58);
    font-size: 11px;
  }

  .ds-site-preview p {
    margin: 54px 0 8px;
    color: var(--ds-gold);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .ds-site-preview h3 {
    max-width: 420px;
    margin: 0;
    color: var(--ds-ink);
    font-size: clamp(24px, 4vw, 42px);
    line-height: 1.02;
  }

  .ds-site-preview div > span {
    display: inline-flex;
    margin-top: 24px;
    padding: 10px 14px;
    border-radius: 999px;
    color: #031015;
    background: #f5d06f;
    font-size: 12px;
    font-weight: 900;
  }

  .ds-social-preview {
    display: grid;
    place-items: center;
    min-height: 220px;
    text-align: center;
    border-radius: 24px;
    background: rgba(255,255,255,0.055);
  }

  .ds-avatar {
    width: 82px;
    aspect-ratio: 1;
    border-radius: 50%;
    margin-bottom: 14px;
  }

  .ds-social-preview strong {
    color: var(--ds-ink);
  }

  .ds-social-preview p {
    margin: 4px 0 18px;
    font-size: 12px;
  }

  .ds-social-lines {
    display: grid;
    gap: 6px;
    width: min(160px, 80%);
  }

  .ds-social-lines span {
    height: 7px;
    border-radius: 999px;
    background: rgba(255,255,255,0.12);
  }

  .ds-card-preview {
    display: grid;
    gap: 16px;
    align-content: end;
    min-height: 220px;
    padding: 22px;
    border-radius: 24px;
    color: #06111a;
    background: linear-gradient(145deg, #effaff, #b9f7f0 50%, #f5d06f);
  }

  .ds-card-preview strong {
    color: #06111a;
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: 22px;
    overflow-wrap: anywhere;
  }

  .ds-card-preview small {
    color: rgba(6,17,26,0.68);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .ds-card-mark {
    width: 54px;
    aspect-ratio: 1;
    border-radius: 18px;
    background: #06111a;
  }

  .ds-sign-preview {
    min-height: 420px;
    display: grid;
    place-items: center;
    padding: 26px;
    border-radius: 26px;
    background:
      linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(180deg, #0b1620, #03070d);
    background-size: 34px 34px, 34px 34px, auto;
  }

  .ds-sign-preview span {
    max-width: 100%;
    color: var(--ds-ink);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: clamp(24px, 4vw, 48px);
    font-weight: 950;
    text-align: center;
    text-shadow: 0 0 34px rgba(115,241,255,0.3);
    overflow-wrap: anywhere;
  }

  .ds-favicon-row {
    min-height: 220px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    border-radius: 24px;
    background: rgba(255,255,255,0.055);
  }

  .ds-favicon {
    width: 54px;
    aspect-ratio: 1;
    border-radius: 16px;
  }

  .ds-favicon--two {
    width: 72px;
    border-radius: 24px;
  }

  .ds-favicon--three {
    width: 42px;
    border-radius: 50%;
  }

  .ds-tracer {
    background:
      linear-gradient(180deg, transparent, rgba(245, 208, 111, 0.035), transparent),
      linear-gradient(90deg, rgba(115, 241, 255, 0.035), transparent 46%, rgba(245, 208, 111, 0.035));
  }

  .ds-tracer__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(380px, 1.18fr);
    gap: clamp(28px, 5vw, 74px);
    align-items: center;
  }

  .ds-tracer-points {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .ds-tracer-points span,
  .ds-tracer-badge {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 8px 12px;
    border: 1px solid rgba(115, 241, 255, 0.18);
    border-radius: 999px;
    color: rgba(236, 247, 255, 0.78);
    background: rgba(115, 241, 255, 0.07);
    font-size: 12px;
    font-weight: 850;
  }

  .ds-tracer-tool {
    border: 1px solid var(--ds-line);
    border-radius: var(--ds-radius-lg);
    padding: clamp(22px, 4vw, 34px);
    background:
      linear-gradient(145deg, rgba(255,255,255,0.108), rgba(255,255,255,0.035)),
      rgba(3, 10, 16, 0.72);
    box-shadow: var(--ds-shadow);
    backdrop-filter: blur(24px);
  }

  .ds-tracer-tool__head {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: flex-start;
  }

  .ds-tracer-tool h3 {
    margin: 0;
    color: var(--ds-ink);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: clamp(22px, 3vw, 34px);
    line-height: 1.04;
  }

  .ds-tracer-badge {
    flex: 0 0 auto;
    color: #041015;
    background: linear-gradient(135deg, #9bf9ff, #f2d77d);
  }

  .ds-tracer-drop {
    display: grid;
    gap: 8px;
    margin-top: 24px;
    padding: 24px;
    border: 1px dashed rgba(115, 241, 255, 0.32);
    border-radius: 24px;
    color: var(--ds-ink);
    background: rgba(115, 241, 255, 0.055);
    cursor: pointer;
    transition: border-color 220ms var(--ds-ease), background 220ms var(--ds-ease);
  }

  .ds-tracer-drop:hover,
  .ds-tracer-drop.is-dragging {
    border-color: rgba(245, 208, 111, 0.72);
    background: rgba(245, 208, 111, 0.075);
  }

  .ds-tracer-drop input {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .ds-tracer-drop strong {
    font-size: 16px;
  }

  .ds-tracer-drop span {
    color: var(--ds-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .ds-tracer-controls {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
    margin-top: 18px;
  }

  .ds-tracer-controls label {
    display: grid;
    gap: 9px;
    min-width: 0;
    padding: 14px;
    border: 1px solid rgba(255,255,255,0.11);
    border-radius: 18px;
    background: rgba(255,255,255,0.055);
  }

  .ds-tracer-controls label:nth-child(-n + 3) {
    grid-column: span 2;
  }

  .ds-tracer-controls label:nth-child(n + 4) {
    grid-column: span 3;
  }

  .ds-tracer-controls label > span {
    color: rgba(236, 247, 255, 0.68);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ds-tracer-controls output {
    color: var(--ds-gold);
    font: inherit;
  }

  .ds-tracer-controls input[type="range"] {
    width: 100%;
    accent-color: var(--ds-cyan);
  }

  .ds-tracer-controls select {
    width: 100%;
    min-height: 36px;
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 10px;
    padding: 6px 10px;
    color: var(--ds-ink);
    background: #09131c;
  }

  .ds-tracer-toggle {
    align-content: center;
    grid-template-columns: 22px minmax(0, 1fr);
    align-items: center;
  }

  .ds-tracer-toggle input {
    width: 18px;
    height: 18px;
    accent-color: var(--ds-gold);
  }

  .ds-tracer-preview-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 18px;
  }

  .ds-tracer-preview {
    display: grid;
    gap: 10px;
    min-height: 260px;
    padding: 14px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 22px;
    background:
      linear-gradient(45deg, rgba(255,255,255,0.035) 25%, transparent 25% 75%, rgba(255,255,255,0.035) 75%),
      linear-gradient(45deg, rgba(255,255,255,0.035) 25%, transparent 25% 75%, rgba(255,255,255,0.035) 75%),
      rgba(255,255,255,0.045);
    background-position: 0 0, 10px 10px, 0 0;
    background-size: 20px 20px, 20px 20px, auto;
  }

  .ds-tracer-preview > span {
    color: rgba(236, 247, 255, 0.72);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ds-tracer-preview canvas,
  .ds-tracer-svg-preview {
    width: 100%;
    min-height: 208px;
    border-radius: 16px;
    background: rgba(2, 5, 10, 0.54);
  }

  .ds-tracer-preview canvas {
    height: auto;
    object-fit: contain;
  }

  .ds-tracer-svg-preview {
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: 16px;
    background-color: #f5f7f8;
  }

  .ds-tracer-svg-preview svg {
    width: 100%;
    height: 100%;
    max-height: 190px;
  }

  .ds-tracer-output {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 18px;
  }

  .ds-tracer-output p {
    flex: 1 1 240px;
    margin: 0;
    color: var(--ds-muted);
    font-size: 13px;
    line-height: 1.55;
  }

  .ds-tracer-output .ds-btn {
    min-height: 46px;
    padding: 12px 18px;
  }

  .ds-tracer-output .ds-btn:disabled {
    cursor: not-allowed;
    opacity: 0.48;
    transform: none;
  }

  .ds-score {
    background:
      linear-gradient(180deg, transparent, rgba(115, 241, 255, 0.035), transparent);
  }

  .ds-score .ds-btn {
    margin-top: 26px;
  }

  .ds-score-board {
    padding: clamp(24px, 4vw, 38px);
  }

  .ds-score-board__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--ds-line);
  }

  .ds-score-board__head span {
    color: rgba(236,247,255,0.62);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ds-score-board__head strong {
    color: var(--ds-ink);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: clamp(64px, 10vw, 112px);
    line-height: 0.82;
  }

  .ds-score-list {
    display: grid;
    gap: 16px;
    margin-top: 28px;
  }

  .ds-score-row {
    display: grid;
    grid-template-columns: minmax(120px, 170px) minmax(80px, 1fr) 34px;
    align-items: center;
    gap: 14px;
  }

  .ds-score-row span,
  .ds-score-row strong {
    color: rgba(236,247,255,0.8);
    font-size: 13px;
    font-weight: 850;
  }

  .ds-score-row i {
    position: relative;
    height: 9px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255,255,255,0.09);
  }

  .ds-score-row i::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--score);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--ds-cyan), var(--ds-teal), var(--ds-gold));
  }

  .ds-score-warning {
    margin-top: 28px;
    padding: 18px;
    border: 1px solid rgba(245, 208, 111, 0.24);
    border-radius: 22px;
    background: rgba(245, 208, 111, 0.075);
  }

  .ds-score-warning strong,
  .ds-score-warning span {
    display: block;
  }

  .ds-score-warning strong {
    color: var(--ds-gold);
  }

  .ds-score-warning span {
    margin-top: 6px;
    color: var(--ds-muted);
    line-height: 1.6;
  }

  .ds-delivery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .ds-delivery-card {
    min-height: 390px;
    padding: 30px;
    border-radius: var(--ds-radius);
  }

  .ds-delivery-card--featured {
    border-color: rgba(115, 241, 255, 0.34);
    transform: translateY(-18px);
  }

  .ds-delivery-card img {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 20px;
    margin-bottom: 34px;
  }

  .ds-delivery-card span {
    display: inline-flex;
    margin-bottom: 12px;
    color: var(--ds-gold);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ds-delivery-card h3 {
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.05;
  }

  .ds-export-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
  }

  .ds-export-strip span {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    padding: 9px 14px;
    border: 1px solid var(--ds-line);
    border-radius: 999px;
    color: rgba(236,247,255,0.78);
    background: rgba(255,255,255,0.055);
    font-size: 12px;
    font-weight: 850;
  }

  .ds-guidance {
    background:
      linear-gradient(180deg, rgba(245, 208, 111, 0.035), rgba(115, 241, 255, 0.035), transparent);
  }

  .ds-guidance-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .ds-guidance-card,
  .ds-guidance-panel {
    position: relative;
    border: 1px solid var(--ds-line);
    background:
      linear-gradient(145deg, rgba(255,255,255,0.095), rgba(255,255,255,0.032)),
      rgba(3, 10, 16, 0.7);
    box-shadow: var(--ds-shadow);
    backdrop-filter: blur(24px);
  }

  .ds-guidance-card {
    min-height: 300px;
    padding: 28px;
    border-radius: var(--ds-radius);
    overflow: hidden;
  }

  .ds-guidance-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.66;
    background:
      radial-gradient(circle at 20% 16%, rgba(115,241,255,0.16), transparent 34%),
      linear-gradient(145deg, transparent, rgba(245,208,111,0.07));
  }

  .ds-guidance-card--featured {
    border-color: rgba(245, 208, 111, 0.36);
    background:
      linear-gradient(145deg, rgba(245,208,111,0.14), rgba(115,241,255,0.055)),
      rgba(3, 10, 16, 0.78);
  }

  .ds-guidance-card span,
  .ds-guidance-card h3,
  .ds-guidance-card p {
    position: relative;
    z-index: 1;
  }

  .ds-guidance-card span {
    display: inline-flex;
    color: var(--ds-gold);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .ds-guidance-card h3 {
    margin: 58px 0 12px;
    color: var(--ds-ink);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.06;
  }

  .ds-guidance-card p {
    margin: 0;
    color: var(--ds-muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .ds-guidance-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(22px, 4vw, 46px);
    align-items: center;
    margin-top: 18px;
    padding: clamp(24px, 4vw, 38px);
    border-radius: var(--ds-radius-lg);
  }

  .ds-guidance-panel__label {
    display: inline-flex;
    margin-bottom: 12px;
    color: var(--ds-gold);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ds-guidance-panel strong {
    display: block;
    color: var(--ds-ink);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: clamp(24px, 3.2vw, 42px);
    line-height: 1.05;
  }

  .ds-guidance-panel p {
    margin: 0;
    color: var(--ds-muted);
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.75;
  }

  .ds-cta-section {
    position: relative;
    padding: clamp(86px, 11vw, 150px) 0;
    text-align: center;
    overflow: hidden;
  }

  .ds-cta-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.04), transparent 42%),
      linear-gradient(120deg, rgba(115,241,255,0.11), transparent 34%),
      linear-gradient(260deg, rgba(245,208,111,0.12), transparent 34%);
    border-block: 1px solid rgba(255,255,255,0.09);
  }

  .ds-cta__inner {
    display: flex;
    max-width: 780px;
    flex-direction: column;
    align-items: center;
  }

  .ds-cta__inner img {
    width: 150px;
    height: auto;
    margin-bottom: 18px;
    opacity: 0.62;
    filter: brightness(1.4) grayscale(1);
  }

  .ds-cta-section h2 {
    margin: 0;
    color: var(--ds-ink);
    font-family: var(--font-display, "Orbitron", sans-serif);
    font-size: clamp(32px, 5vw, 62px);
    line-height: 1.02;
    text-wrap: balance;
  }

  .ds-cta-section p {
    max-width: 640px;
    margin: 18px 0 0;
    color: var(--ds-muted);
    font-size: clamp(16px, 1.7vw, 19px);
    line-height: 1.7;
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 680ms var(--ds-ease),
      transform 680ms var(--ds-ease);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes dsAmbient {
    0% { transform: translate3d(-1%, -1%, 0) rotate(0deg); }
    100% { transform: translate3d(1%, 1%, 0) rotate(8deg); }
  }

  @keyframes dsHeroLight {
    0% { transform: translate3d(-3%, -1%, 0) scale(1); opacity: 0.28; }
    100% { transform: translate3d(3%, 1%, 0) scale(1.04); opacity: 0.52; }
  }

  @keyframes dsScrollCue {
    0% { transform: translateY(-100%); opacity: 0; }
    30% { opacity: 1; }
    100% { transform: translateY(260%); opacity: 0; }
  }

  @media (max-width: 980px) {
    .ds-intro__grid,
    .ds-diagnostic__grid,
    .ds-tracer__grid,
    .ds-score__grid {
      grid-template-columns: 1fr;
    }

    .ds-flow,
    .ds-guidance-grid,
    .ds-delivery-grid {
      grid-template-columns: 1fr;
    }

    .ds-delivery-card--featured {
      transform: none;
    }

    .ds-guidance-panel {
      grid-template-columns: 1fr;
    }

    .ds-application,
    .ds-application--wide,
    .ds-application--tall {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  @media (max-width: 680px) {
    .shell {
      width: min(100% - 28px, 1180px);
    }

    .ds-hero {
      min-height: 86vh;
    }

    .ds-choice-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ds-brand-canvas {
      grid-template-columns: 1fr;
      text-align: left;
      margin-top: 44px;
    }

    .ds-score-row {
      grid-template-columns: 1fr 36px;
      gap: 8px 12px;
    }

    .ds-score-row i {
      grid-column: 1 / -1;
      order: 2;
    }

    .ds-score-row strong {
      justify-self: end;
    }

    .ds-tracer-tool__head,
    .ds-tracer-output {
      align-items: stretch;
      flex-direction: column;
    }

    .ds-tracer-controls,
    .ds-tracer-preview-grid {
      grid-template-columns: 1fr;
    }

    .ds-tracer-output .ds-btn {
      width: 100%;
    }

    .ds-site-preview header,
    .ds-live-stage__top {
      flex-direction: column;
      align-items: flex-start;
    }

    .ds-site-preview nav {
      flex-wrap: wrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .ds-main::after,
    .ds-hero__media::before,
    .ds-scroll-cue span {
      animation: none;
    }

    .ds-btn:hover,
    .ds-delivery-card--featured {
      transform: none;
    }

    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  :global(.site-footer) {
    position: relative;
    z-index: 2;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
</style>

<script>
  import { BinaryImageConverter } from "vectortracer";

  (() => {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const revealEls = Array.from(document.querySelectorAll("[data-reveal]"));

    if (revealEls.length && "IntersectionObserver" in window && !reduced) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const siblings = Array.from(entry.target.parentElement?.querySelectorAll("[data-reveal]") || []);
          const index = Math.max(0, siblings.indexOf(entry.target));
          window.setTimeout(() => {
            entry.target.classList.add("is-visible");
          }, Math.min(index * 70, 280));
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -48px 0px" });

      revealEls.forEach((el) => observer.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add("is-visible"));
    }

    const input = document.querySelector("[data-brand-input]");
    const outputs = Array.from(document.querySelectorAll("[data-brand-output]"));
    const updateBrandName = () => {
      const value = input?.value?.trim() || "VOLYNX Studio";
      outputs.forEach((node) => {
        node.textContent = value;
      });
    };

    input?.addEventListener("input", updateBrandName);
    updateBrandName();

    document.querySelectorAll(".ds-choice").forEach((choice) => {
      choice.addEventListener("click", () => {
        document.querySelectorAll(".ds-choice").forEach((item) => item.classList.remove("is-active"));
        choice.classList.add("is-active");
      });
    });

    const tracerFile = document.getElementById("signaTracerFile");
    const tracerDrop = document.getElementById("signaTracerDrop");
    const tracerThreshold = document.getElementById("signaTracerThreshold");
    const tracerThresholdValue = document.getElementById("signaTracerThresholdValue");
    const tracerSmoothing = document.getElementById("signaTracerSmoothing");
    const tracerSmoothingValue = document.getElementById("signaTracerSmoothingValue");
    const tracerNoise = document.getElementById("signaTracerNoise");
    const tracerNoiseValue = document.getElementById("signaTracerNoiseValue");
    const tracerDetail = document.getElementById("signaTracerDetail");
    const tracerInvert = document.getElementById("signaTracerInvert");
    const tracerCanvas = document.getElementById("signaTracerCanvas");
    const tracerPreview = document.getElementById("signaTracerSvgPreview");
    const tracerStatus = document.getElementById("signaTracerStatus");
    const tracerDownload = document.getElementById("signaTracerDownload");
    let tracerImage = null;
    let tracerSvg = "";
    let tracerFileName = "signa-tracer-mark";
    let tracerRenderId = 0;
    let tracerTimer = 0;

    const dsText = (key, fallback) => {
      const table = window.VX_TRANS?.[document.documentElement.lang || "pt"] || window.VX_TRANS?.pt || {};
      return table[key] || fallback;
    };

    const slugFileName = (name) => {
      const base = String(name || "signa-tracer-mark").replace(/\.[a-z0-9]+$/i, "");
      return base
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "")
        .slice(0, 48) || "signa-tracer-mark";
    };

    const escapeSvg = (value) => String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");

    const setTracerStatus = (key, fallback) => {
      if (!tracerStatus) return;
      tracerStatus.textContent = dsText(key, fallback);
    };

    const loadTracerImage = (file) => new Promise((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(url);
        resolve(img);
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        reject(new Error("Image load failed."));
      };
      img.src = url;
    });

    const drawTracerSource = () => {
      if (!tracerImage || !tracerCanvas) return null;
      const canvas = tracerCanvas;
      const ctx = canvas.getContext("2d", { willReadFrequently: true });
      if (!ctx) return null;
      const maxSide = Number(tracerDetail?.value || 1024);
      const scale = Math.min(maxSide / tracerImage.width, maxSide / tracerImage.height, 1);
      const width = Math.max(1, Math.round(tracerImage.width * scale));
      const height = Math.max(1, Math.round(tracerImage.height * scale));
      canvas.width = width;
      canvas.height = height;
      ctx.clearRect(0, 0, width, height);
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = "high";
      ctx.drawImage(tracerImage, 0, 0, width, height);
      return { canvas, ctx, width, height };
    };

    const createBinaryImage = (image, threshold, invert) => {
      const data = new Uint8ClampedArray(image.data.length);
      for (let i = 0; i < image.data.length; i += 4) {
        const alpha = image.data[i + 3] / 255;
        const luma = ((image.data[i] * 0.299) + (image.data[i + 1] * 0.587) + (image.data[i + 2] * 0.114)) * alpha + (255 * (1 - alpha));
        const marked = invert ? luma > threshold : luma < threshold;
        const value = marked ? 0 : 255;
        data[i] = value;
        data[i + 1] = value;
        data[i + 2] = value;
        data[i + 3] = 255;
      }
      return new ImageData(data, image.width, image.height);
    };

    const shouldInvertFromBorder = (image) => {
      const { data, width, height } = image;
      const step = Math.max(1, Math.floor(Math.min(width, height) / 80));
      let total = 0;
      let samples = 0;
      const sample = (x, y) => {
        const i = (y * width + x) * 4;
        const alpha = data[i + 3] / 255;
        total += (((data[i] * 0.299) + (data[i + 1] * 0.587) + (data[i + 2] * 0.114)) * alpha) + (255 * (1 - alpha));
        samples += 1;
      };
      for (let x = 0; x < width; x += step) {
        sample(x, 0);
        if (height > 1) sample(x, height - 1);
      }
      for (let y = step; y < height - 1; y += step) {
        sample(0, y);
        if (width > 1) sample(width - 1, y);
      }
      return samples > 0 && (total / samples) < 118;
    };

    const vectorizeImage = (imageData, converterOptions, options, renderId) => new Promise((resolve, reject) => {
      let converter;
      try {
        converter = new BinaryImageConverter(imageData, converterOptions, options);
        converter.init();
      } catch (error) {
        reject(error);
        return;
      }

      const tick = () => {
        if (renderId !== tracerRenderId) {
          converter.free();
          resolve("");
          return;
        }
        try {
          if (converter.tick()) {
            const result = converter.getResult();
            converter.free();
            resolve(result);
            return;
          }
          window.setTimeout(tick, 0);
        } catch (error) {
          converter.free();
          reject(error);
        }
      };
      window.setTimeout(tick, 0);
    });

    const traceToSvg = async () => {
      const source = drawTracerSource();
      if (!source || !tracerPreview || !tracerDownload) return;
      const { ctx, width, height } = source;
      const image = ctx.getImageData(0, 0, width, height);
      const threshold = Number(tracerThreshold?.value || 132);
      const invert = Boolean(tracerInvert?.checked);
      const renderId = ++tracerRenderId;
      tracerDownload.disabled = true;
      setTracerStatus("ds.tracer_status_processing", "Tracing contours and fitting Bézier curves...");

      try {
        const binaryImage = createBinaryImage(image, threshold, invert);
        const smoothing = Number(tracerSmoothing?.value || 6);
        const noise = Number(tracerNoise?.value || 4);
        const rawSvg = await vectorizeImage(binaryImage, {
          debug: false,
          mode: "spline",
          cornerThreshold: 60,
          lengthThreshold: smoothing,
          maxIterations: 10,
          spliceThreshold: 45,
          filterSpeckle: noise,
          pathPrecision: 2
        }, {
          invert: false,
          pathFill: "#101418",
          backgroundColor: "none",
          attributes: ` role="img" aria-label="${escapeSvg(`${tracerFileName} Signa Tracer vector`)}"`,
          scale: 1
        }, renderId);

        if (!rawSvg || renderId !== tracerRenderId) return;
        const parsed = new DOMParser().parseFromString(rawSvg, "image/svg+xml");
        const svgNode = parsed.documentElement;
        const paths = svgNode.querySelectorAll("path").length;
        if (svgNode.nodeName === "parsererror" || !paths) {
          throw new Error("Empty vector output.");
        }
        svgNode.setAttribute("xmlns", "http://www.w3.org/2000/svg");
        svgNode.setAttribute("width", String(width));
        svgNode.setAttribute("height", String(height));
        svgNode.setAttribute("viewBox", `0 0 ${width} ${height}`);
        svgNode.removeAttribute("style");
        const title = parsed.createElementNS("http://www.w3.org/2000/svg", "title");
        title.textContent = `${tracerFileName} Signa Tracer vector`;
        svgNode.prepend(title);
        tracerSvg = new XMLSerializer().serializeToString(svgNode);
        tracerPreview.innerHTML = tracerSvg;
        tracerDownload.disabled = false;
        const message = dsText(
          "ds.tracer_status_ready",
          "Premium vector ready: {paths} editable paths with Bézier curves."
        ).replace("{paths}", String(paths));
        tracerStatus.textContent = message;
      } catch (error) {
        console.error("[Signa Tracer]", error);
        tracerSvg = "";
        tracerPreview.innerHTML = "";
        tracerDownload.disabled = true;
        setTracerStatus("ds.tracer_status_empty_trace", "No clean contour found. Adjust contrast, noise removal or invert the mark.");
      }
    };

    const handleTracerFile = async (file) => {
      if (!file || !file.type.startsWith("image/")) return;
      try {
        tracerFileName = slugFileName(file.name);
        tracerImage = await loadTracerImage(file);
        const source = drawTracerSource();
        if (source && tracerInvert) {
          const sourceImage = source.ctx.getImageData(0, 0, source.width, source.height);
          tracerInvert.checked = shouldInvertFromBorder(sourceImage);
        }
        await traceToSvg();
      } catch {
        tracerSvg = "";
        if (tracerPreview) tracerPreview.innerHTML = "";
        if (tracerDownload) tracerDownload.disabled = true;
        setTracerStatus("ds.tracer_status_error", "Could not read this image. Try a PNG, JPG or WebP logo.");
      }
    };

    tracerFile?.addEventListener("change", (event) => {
      const file = event.target?.files?.[0];
      handleTracerFile(file);
    });

    const syncTracerControlValues = () => {
      if (tracerThresholdValue) tracerThresholdValue.textContent = tracerThreshold?.value || "132";
      if (tracerSmoothingValue) tracerSmoothingValue.textContent = tracerSmoothing?.value || "6";
      if (tracerNoiseValue) tracerNoiseValue.textContent = `${tracerNoise?.value || "4"} px`;
    };

    const scheduleTrace = () => {
      syncTracerControlValues();
      window.clearTimeout(tracerTimer);
      tracerTimer = window.setTimeout(() => {
        if (tracerImage) traceToSvg();
      }, 180);
    };

    [tracerThreshold, tracerSmoothing, tracerNoise, tracerDetail, tracerInvert].forEach((control) => {
      control?.addEventListener("input", () => {
        scheduleTrace();
      });
      control?.addEventListener("change", () => {
        scheduleTrace();
      });
    });
    syncTracerControlValues();

    tracerDrop?.addEventListener("dragover", (event) => {
      event.preventDefault();
      tracerDrop.classList.add("is-dragging");
    });

    tracerDrop?.addEventListener("dragleave", () => {
      tracerDrop.classList.remove("is-dragging");
    });

    tracerDrop?.addEventListener("drop", (event) => {
      event.preventDefault();
      tracerDrop.classList.remove("is-dragging");
      const file = event.dataTransfer?.files?.[0];
      handleTracerFile(file);
    });

    tracerDownload?.addEventListener("click", () => {
      if (!tracerSvg) return;
      const blob = new Blob([tracerSvg], { type: "image/svg+xml;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = `${tracerFileName}-signa-trace.svg`;
      link.click();
      window.setTimeout(() => URL.revokeObjectURL(url), 1200);
    });

    if (!reduced) {
      const heroVideo = document.querySelector(".ds-hero__video");
      let ticking = false;

      const syncHero = () => {
        const y = Math.min(window.scrollY, window.innerHeight);
        const progress = y / Math.max(window.innerHeight, 1);
        if (heroVideo) {
          heroVideo.style.transform = `scale(${1.02 + progress * 0.025}) translateY(${progress * 22}px)`;
          heroVideo.style.opacity = String(0.82 - progress * 0.22);
        }
        ticking = false;
      };

      window.addEventListener("scroll", () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(syncHero);
      }, { passive: true });
    }
  })();
</script>
