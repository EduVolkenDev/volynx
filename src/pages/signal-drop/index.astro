---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import { ROUTES } from "../../data/routes";

const campaignQuery = "utm_source=signal-drop&utm_medium=owned&utm_campaign=signal-drop-01";
const campaignHref = (href: string) => `${href}${href.includes("?") ? "&" : "?"}${campaignQuery}`;
const labHref = campaignHref(ROUTES.lab);
const platformHref = campaignHref(ROUTES.platform);
---

<FlagshipLayout
  title="Signal Drop 01 — VOLYNX"
  description="A primeira experiência editorial do Signal Drop: transforme uma ideia solta em algo que você consegue usar, testar e compartilhar."
  ogImage="/assets/newqrgen.webp"
  pageClass="page-signal-drop"
>
  <FlagshipHeader current={ROUTES.signalDrop} ctaLabel="Open Lab" ctaI18n="nav.open_lab" ctaHref={labHref} />

  <main class="signal-drop-page">
    <section class="signal-hero shell" aria-labelledby="signal-title">
      <div class="signal-hero__copy">
        <p class="signal-kicker"><span aria-hidden="true">●</span> SIGNAL DROP / 01</p>
        <h1 id="signal-title">
          <span class="i18n-en">The moment an idea becomes something you can use.</span>
          <span class="i18n-pt">O momento em que uma ideia vira algo que você consegue usar.</span>
        </h1>
        <p class="signal-hero__intro">
          <span class="i18n-en">VOLYNX turns scattered intent into a clear next move — with tools, systems and visual direction that hold up beyond the first impression.</span>
          <span class="i18n-pt">A VOLYNX transforma intenção dispersa em próximo passo claro — com ferramentas, sistemas e direção visual que continuam funcionando depois da primeira impressão.</span>
        </p>
        <div class="signal-actions">
          <a class="button button--gold" href={labHref} data-campaign-event="hero_lab">
            <span class="i18n-en">Find your signal</span>
            <span class="i18n-pt">Encontre seu sinal</span>
            <span aria-hidden="true">↗</span>
          </a>
          <a class="button button--ghost" href={platformHref} data-campaign-event="hero_platform">
            <span class="i18n-en">See the whole system</span>
            <span class="i18n-pt">Ver o sistema completo</span>
          </a>
        </div>
        <p class="signal-note">
          <span class="i18n-en">Free browser tools · no card to start · your work stays in your hands</span>
          <span class="i18n-pt">Ferramentas gratuitas no navegador · sem cartão para começar · seu trabalho continua nas suas mãos</span>
        </p>
      </div>

      <div class="signal-hero__visual" aria-label="VOLYNX Signal Drop visual">
        <div class="signal-visual__halo" aria-hidden="true"></div>
        <div class="signal-visual__orbit signal-visual__orbit--one" aria-hidden="true"></div>
        <div class="signal-visual__orbit signal-visual__orbit--two" aria-hidden="true"></div>
        <div class="signal-visual__stage">
          <div class="signal-visual__stage-top">
            <span>VOLYNX / LAB</span>
            <span class="signal-live"><i aria-hidden="true"></i> LIVE</span>
          </div>
          <div class="signal-visual__asset-wrap">
            <img
              src="/assets/newqrgen.webp"
              alt="Premium VOLYNX QR Generator visual"
              width="720"
              height="720"
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="signal-visual__stage-bottom">
            <span class="signal-index">01</span>
            <strong><span class="i18n-en">FROM NOISE<br />TO SIGNAL</span><span class="i18n-pt">DO RUÍDO<br />AO SINAL</span></strong>
            <span class="signal-arrow" aria-hidden="true">↗</span>
          </div>
        </div>
        <span class="signal-float signal-float--top" aria-hidden="true">MAKE / TEST / SHARE</span>
        <span class="signal-float signal-float--bottom" aria-hidden="true">DROP 01 · 2026</span>
      </div>
    </section>

    <section class="signal-section signal-proof shell" aria-labelledby="proof-title">
      <div class="signal-section__heading">
        <p class="signal-kicker"><span aria-hidden="true">✦</span> THREE PROOFS</p>
        <h2 id="proof-title">
          <span class="i18n-en">Premium is what survives contact with reality.</span>
          <span class="i18n-pt">Premium é o que continua bom quando encontra a realidade.</span>
        </h2>
      </div>
      <div class="signal-proof__grid">
        <article class="signal-proof__item">
          <span class="signal-proof__number">01</span>
          <h3><span class="i18n-en">Clear before clever</span><span class="i18n-pt">Clareza antes do truque</span></h3>
          <p><span class="i18n-en">Every action has a visible purpose, a readable state and a next step you can trust.</span><span class="i18n-pt">Toda ação tem propósito visível, estado legível e um próximo passo em que você pode confiar.</span></p>
        </article>
        <article class="signal-proof__item signal-proof__item--accent">
          <span class="signal-proof__number">02</span>
          <h3><span class="i18n-en">Beauty with a job</span><span class="i18n-pt">Beleza com função</span></h3>
          <p><span class="i18n-en">The visual system creates desire, then gets out of the way so the work can happen.</span><span class="i18n-pt">O sistema visual cria desejo e depois sai do caminho para o trabalho acontecer.</span></p>
        </article>
        <article class="signal-proof__item">
          <span class="signal-proof__number">03</span>
          <h3><span class="i18n-en">Output you can keep</span><span class="i18n-pt">Resultado que fica</span></h3>
          <p><span class="i18n-en">A good first moment becomes a useful file, a live project or a system you can return to.</span><span class="i18n-pt">Um bom primeiro momento vira arquivo útil, projeto publicado ou sistema ao qual você pode voltar.</span></p>
        </article>
      </div>
    </section>

    <section class="signal-section signal-loop shell" aria-labelledby="loop-title">
      <div class="signal-loop__copy">
        <p class="signal-kicker"><span aria-hidden="true">↻</span> THE DROP LOOP</p>
        <h2 id="loop-title">
          <span class="i18n-en">One useful moment is enough to start a movement.</span>
          <span class="i18n-pt">Um momento útil já é suficiente para começar um movimento.</span>
        </h2>
        <p>
          <span class="i18n-en">Signal Drop is not a burst of posts. It is a repeatable format: show a real tension, resolve it in public, and give people something worth trying themselves.</span>
          <span class="i18n-pt">Signal Drop não é uma explosão de posts. É um formato repetível: mostrar uma tensão real, resolvê-la em público e dar às pessoas algo que vale a pena testar.</span>
        </p>
      </div>
      <ol class="signal-loop__steps">
        <li><span>01</span><strong><span class="i18n-en">Notice</span><span class="i18n-pt">Perceber</span></strong><small><span class="i18n-en">Show the friction.</span><span class="i18n-pt">Mostrar o atrito.</span></small></li>
        <li><span>02</span><strong><span class="i18n-en">Make</span><span class="i18n-pt">Criar</span></strong><small><span class="i18n-en">Build the answer.</span><span class="i18n-pt">Construir a resposta.</span></small></li>
        <li><span>03</span><strong><span class="i18n-en">Share</span><span class="i18n-pt">Compartilhar</span></strong><small><span class="i18n-en">Let people try.</span><span class="i18n-pt">Deixar testar.</span></small></li>
        <li><span>04</span><strong><span class="i18n-en">Return</span><span class="i18n-pt">Voltar</span></strong><small><span class="i18n-en">Ship the next drop.</span><span class="i18n-pt">Publicar o próximo drop.</span></small></li>
      </ol>
    </section>

    <section class="signal-close shell" aria-labelledby="close-title">
      <div>
        <p class="signal-kicker"><span aria-hidden="true">●</span> YOUR TURN</p>
        <h2 id="close-title"><span class="i18n-en">Start with one thing you want to make clearer.</span><span class="i18n-pt">Comece por uma coisa que você quer tornar mais clara.</span></h2>
      </div>
      <a class="signal-close__cta" href={labHref} data-campaign-event="close_lab">
        <span class="i18n-en">Open VOLYNX Lab</span>
        <span class="i18n-pt">Abrir o VOLYNX Lab</span>
        <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>

  <script is:inline>
    (() => {
      const params = new URLSearchParams(window.location.search);
      const keys = ['utm_source', 'utm_medium', 'utm_campaign'];
      const attribution = Object.fromEntries(keys.filter((key) => params.has(key)).map((key) => [key, params.get(key)]));
      if (Object.keys(attribution).length) {
        try { sessionStorage.setItem('volynx_campaign_attribution', JSON.stringify(attribution)); } catch (_) {}
      }
      document.addEventListener('click', (event) => {
        const target = event.target.closest('[data-campaign-event]');
        if (!target) return;
        window.dispatchEvent(new CustomEvent('volynx:campaign-event', {
          detail: { campaign: 'signal-drop-01', event: target.dataset.campaignEvent }
        }));
      });
    })();
  </script>
</FlagshipLayout>

<style>
  .page-signal-drop {
    --signal-teal: #8bfaf0;
    --signal-violet: #b196ff;
    --signal-ink: #080a12;
    background:
      radial-gradient(circle at 18% 12%, rgba(177,150,255,.17), transparent 27%),
      radial-gradient(circle at 86% 21%, rgba(139,250,240,.12), transparent 24%),
      linear-gradient(180deg, #090b14 0%, #05060b 48%, #070812 100%);
  }

  .signal-drop-page { overflow: hidden; padding-bottom: 50px; }
  .signal-drop-page .shell { width: min(var(--shell), calc(100% - (var(--page-pad) * 2))); }
  .signal-hero { min-height: min(760px, calc(100vh - 74px)); display: grid; grid-template-columns: minmax(0, 1fr) minmax(400px, .92fr); align-items: center; gap: clamp(38px, 7vw, 110px); padding-top: clamp(54px, 8vw, 110px); padding-bottom: clamp(74px, 10vw, 138px); }
  .signal-hero__copy { position: relative; z-index: 2; max-width: 720px; }
  .signal-kicker { display: inline-flex; align-items: center; gap: 9px; margin: 0 0 22px; color: var(--signal-teal); font: 700 11px/1.2 var(--display); letter-spacing: .18em; text-transform: uppercase; }
  .signal-kicker span[aria-hidden="true"] { color: var(--signal-violet); text-shadow: 0 0 16px currentColor; }
  .signal-hero h1 { max-width: 10.5ch; margin: 0 0 26px; font: 700 clamp(2.75rem, 6.2vw, 6.2rem)/.98 var(--display); letter-spacing: -.065em; color: #f7f8ff; text-wrap: balance; }
  .signal-hero__intro { max-width: 59ch; margin: 0; color: var(--muted); font-size: clamp(1rem, 1.5vw, 1.2rem); line-height: 1.75; }
  .signal-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 34px; }
  .signal-actions .button { display: inline-flex; align-items: center; gap: 12px; min-height: 52px; }
  .signal-note { margin: 18px 0 0; color: var(--soft); font-size: .78rem; letter-spacing: .02em; }

  .signal-hero__visual { position: relative; min-height: 560px; display: grid; place-items: center; isolation: isolate; }
  .signal-visual__halo { position: absolute; width: min(72vw, 470px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(139,250,240,.18), rgba(139,250,240,.05) 34%, transparent 68%); filter: blur(12px); z-index: -2; }
  .signal-visual__orbit { position: absolute; width: min(84vw, 570px); height: 210px; border: 1px solid rgba(139,250,240,.25); border-radius: 50%; transform: rotate(-27deg); box-shadow: 0 0 26px rgba(139,250,240,.08); z-index: -1; }
  .signal-visual__orbit--two { width: min(75vw, 500px); height: 340px; transform: rotate(49deg); border-color: rgba(177,150,255,.21); }
  .signal-visual__stage { width: min(100%, 480px); padding: 18px; border: 1px solid rgba(255,255,255,.15); border-radius: 32px; background: linear-gradient(145deg, rgba(255,255,255,.12), rgba(255,255,255,.035) 42%, rgba(4,7,18,.9)); box-shadow: 0 34px 100px rgba(0,0,0,.58), 0 0 70px rgba(139,250,240,.08), inset 0 1px 0 rgba(255,255,255,.14); transform: rotate(2.2deg); }
  .signal-visual__stage-top, .signal-visual__stage-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--soft); font: 700 10px/1.2 var(--display); letter-spacing: .15em; }
  .signal-live { display: inline-flex; align-items: center; gap: 7px; color: var(--signal-teal); }
  .signal-live i { width: 6px; height: 6px; border-radius: 50%; background: var(--signal-teal); box-shadow: 0 0 12px var(--signal-teal); }
  .signal-visual__asset-wrap { position: relative; display: grid; place-items: center; aspect-ratio: 1; margin: 16px 0; overflow: hidden; border-radius: 22px; background: radial-gradient(circle at 50% 36%, rgba(139,250,240,.16), transparent 54%), rgba(1,3,11,.56); }
  .signal-visual__asset-wrap::after { content: ""; position: absolute; inset: 10%; border: 1px solid rgba(139,250,240,.17); border-radius: 18px; pointer-events: none; }
  .signal-visual__asset-wrap img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 18px 30px rgba(0,0,0,.4)); }
  .signal-visual__stage-bottom { align-items: flex-end; padding: 0 5px 2px; }
  .signal-index { color: var(--signal-violet); font-size: 13px; }
  .signal-visual__stage-bottom strong { flex: 1; color: #f7f8ff; font: 700 15px/1.1 var(--display); letter-spacing: .08em; }
  .signal-arrow { color: var(--signal-teal); font-size: 25px; }
  .signal-float { position: absolute; color: rgba(245,247,252,.46); font: 700 9px/1.2 var(--display); letter-spacing: .2em; white-space: nowrap; }
  .signal-float--top { top: 13%; right: -8%; transform: rotate(90deg); }
  .signal-float--bottom { bottom: 8%; left: -9%; transform: rotate(-90deg); }

  .signal-section { padding-top: var(--section-gap); }
  .signal-section__heading { display: grid; grid-template-columns: minmax(220px, .75fr) minmax(0, 1.35fr); align-items: end; gap: 38px; margin-bottom: 38px; }
  .signal-section h2, .signal-close h2 { margin: 0; color: #f5f6ff; font: 700 clamp(1.8rem, 3.5vw, 3.2rem)/1.07 var(--display); letter-spacing: -.05em; text-wrap: balance; }
  .signal-proof__grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
  .signal-proof__item { min-height: 250px; padding: 26px 28px 30px 0; border-bottom: 1px solid var(--line); }
  .signal-proof__item + .signal-proof__item { padding-left: 28px; border-left: 1px solid var(--line); }
  .signal-proof__item--accent { background: radial-gradient(circle at 50% 0%, rgba(139,250,240,.12), transparent 68%); }
  .signal-proof__number { display: block; margin-bottom: 42px; color: var(--signal-teal); font: 700 11px/1 var(--display); letter-spacing: .16em; }
  .signal-proof__item h3 { margin: 0 0 11px; color: #f5f6ff; font: 700 1.12rem/1.2 var(--display); letter-spacing: -.02em; }
  .signal-proof__item p, .signal-loop__copy p { max-width: 34ch; margin: 0; color: var(--muted); line-height: 1.7; }

  .signal-loop { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.3fr); align-items: center; gap: clamp(40px, 9vw, 150px); }
  .signal-loop__copy > p:last-child { margin-top: 20px; max-width: 52ch; }
  .signal-loop__steps { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 22px; margin: 0; padding: 0; list-style: none; counter-reset: steps; }
  .signal-loop__steps li { display: grid; grid-template-columns: 42px 1fr; grid-template-rows: auto auto; column-gap: 15px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .signal-loop__steps li > span { grid-row: span 2; color: var(--signal-violet); font: 700 11px/1.4 var(--display); letter-spacing: .1em; }
  .signal-loop__steps strong { color: #f5f6ff; font: 700 1.1rem/1.25 var(--display); }
  .signal-loop__steps small { margin-top: 4px; color: var(--muted); font-size: .85rem; }

  .signal-close { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-top: var(--section-gap); padding-top: 36px; border-top: 1px solid var(--line); }
  .signal-close h2 { max-width: 15ch; }
  .signal-close__cta { display: inline-flex; align-items: center; gap: 14px; flex: 0 0 auto; padding: 18px 22px; color: var(--signal-ink); background: var(--signal-teal); border-radius: 999px; font-weight: 800; box-shadow: 0 14px 40px rgba(139,250,240,.18); transition: transform .2s ease, box-shadow .2s ease; }
  .signal-close__cta:hover { transform: translateY(-2px); box-shadow: 0 18px 50px rgba(139,250,240,.3); }
  .signal-close__cta span:last-child { font-size: 1.2rem; }

  @media (max-width: 920px) {
    .signal-hero { grid-template-columns: 1fr; min-height: auto; padding-top: 70px; }
    .signal-hero__copy { max-width: 760px; }
    .signal-hero h1 { max-width: 12ch; }
    .signal-hero__visual { min-height: 500px; max-width: 580px; width: 100%; margin: 0 auto; }
    .signal-section__heading, .signal-loop { grid-template-columns: 1fr; gap: 22px; }
    .signal-proof__item { min-height: 220px; }
  }

  @media (max-width: 620px) {
    .signal-drop-page { padding-bottom: 24px; }
    .signal-hero { width: min(var(--shell), calc(100% - 32px)); padding-top: 46px; padding-bottom: 70px; }
    .signal-hero h1 { font-size: clamp(2.55rem, 12vw, 4.4rem); }
    .signal-actions { align-items: stretch; flex-direction: column; }
    .signal-actions .button { justify-content: center; width: 100%; }
    .signal-hero__visual { min-height: 390px; margin-top: 14px; }
    .signal-visual__stage { padding: 13px; border-radius: 24px; }
    .signal-visual__asset-wrap { margin: 12px 0; border-radius: 17px; }
    .signal-float { display: none; }
    .signal-section { width: min(var(--shell), calc(100% - 32px)); padding-top: 78px; }
    .signal-section__heading { margin-bottom: 26px; }
    .signal-proof__grid { grid-template-columns: 1fr; }
    .signal-proof__item, .signal-proof__item + .signal-proof__item { min-height: auto; padding: 22px 0 26px; border-left: 0; }
    .signal-proof__number { margin-bottom: 24px; }
    .signal-loop__steps { grid-template-columns: 1fr; }
    .signal-close { width: min(var(--shell), calc(100% - 32px)); align-items: stretch; flex-direction: column; margin-top: 78px; }
    .signal-close__cta { justify-content: center; }
  }
</style>
