---
import "../../styles/products.css";
import PageWidgets from "../../components/PageWidgets.astro";
import SiteFooter from "../../components/SiteFooter.astro";
const pageTitle = "VOLYNX — Products";
const pageDescription = "Hybrid kits (Figma + Code) designed to launch fast, maintain high standards and sell with clarity.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="format-detection" content="telephone=no,date=no,address=no,email=no" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <link rel="preload" as="image" href="/assets/volynx-blue-aurora.webp" />

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/assets/site.webmanifest" />
</head>

<body>
  <!-- Animated Background -->
  <div class="cyber-grid" aria-hidden="true"></div>
  <div class="neon-particles" aria-hidden="true"></div>

  <!-- Header -->
  <header class="top-nav" aria-label="VOLYNX menu">
    <div class="nav-container">
      <div class="nav-logo">
        <svg class="logo-icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M20 2L2 14L20 26L38 14L20 2Z" stroke="currentColor" stroke-width="2" />
          <path d="M2 26L20 38L38 26" stroke="currentColor" stroke-width="2" />
        </svg>
        <span class="logo-text">VOLYNX</span>
      </div>

      <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false" id="menuBtn">
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </button>

      <nav class="nav-links" id="navLinks" aria-label="Primary navigation">
        <a href="/volynx-lab/" class="nav-link">
          <span>Volynx.Lab</span>
          <span class="nav-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/products/" class="nav-link active" aria-current="page">
          <span>Products</span>
          <span class="nav-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/" class="nav-link">
          <span>Home</span>
          <span class="nav-arrow" aria-hidden="true">→</span>
        </a>
      </nav>
    </div>
  </header>

  <!-- Main -->
  <main class="main-content">
    <!-- Hero -->
    <section class="hero-section">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="container">
        <div class="hero-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          <span>DIGITAL PRODUCTS</span>
        </div>

        <h1 class="hero-title">
          <span class="title-line">Products</span>
          <span class="title-gradient">Built for Speed</span>
        </h1>

        <p class="hero-description">
          Hybrid kits (Figma + Code) designed to launch fast,
          maintain high standards and sell with clarity.
        </p>

        <div class="feature-pills">
          <span class="pill">
            <svg class="pill-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1L3 6L8 11L13 6L8 1Z" /></svg>
            Instant download
          </span>
          <span class="pill">
            <svg class="pill-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1L3 6L8 11L13 6L8 1Z" /></svg>
            Static deploy
          </span>
          <span class="pill">
            <svg class="pill-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1L3 6L8 11L13 6L8 1Z" /></svg>
            Tokens + components
          </span>
          <span class="pill">
            <svg class="pill-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1L3 6L8 11L13 6L8 1Z" /></svg>
            Docs included
          </span>
        </div>

        <div class="hero-actions">
          <a href="#kits" class="btn btn-primary">
            <span>Browse Kits</span>
            <svg class="btn-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6 3L11 8L6 13" /></svg>
          </a>
          <a href="/manifesto/" class="btn btn-secondary">
            <span>Why VOLYNX</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Products Section -->
    <section class="products-section" id="kits" aria-label="Product kits">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">
            <span class="title-accent">VOLYNX</span> Kits
          </h2>
          <p class="section-subtitle">
            Pick a kit, update the content, publish. No drama. No hacks.
          </p>
        </div>

        <div class="products-grid">
          <!-- Portfolio Pro Kit -->
          <a href="/products/portfolio-pro-kit/" class="product-card">
            <div class="card-glow" aria-hidden="true"></div>
            <div class="card-header">
              <span class="card-chip">PORTFOLIO</span>
              <div class="card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" />
                  <path d="M9 3v18M15 3v18M3 9h18M3 15h18" />
                </svg>
              </div>
            </div>
            <h3 class="card-title">Portfolio Pro Kit</h3>
            <p class="card-description">
              Premium structure (Figma + Code) to look senior without having to "perform".
            </p>
            <div class="card-footer">
              <span class="card-link">
                Explore Kit
                <svg class="link-arrow" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6 3L11 8L6 13" /></svg>
              </span>
            </div>
          </a>

          <!-- Agency Launch Kit (featured) -->
          <a href="/products/agency-launch-kit/" class="product-card card-featured">
            <div class="card-glow" aria-hidden="true"></div>
            <div class="featured-badge"><span>POPULAR</span></div>
            <div class="card-header">
              <span class="card-chip">AGENCY</span>
              <div class="card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2L2 7L12 12L22 7L12 2Z" />
                  <path d="M2 17L12 22L22 17" />
                  <path d="M2 12L12 17L22 12" />
                </svg>
              </div>
            </div>
            <h3 class="card-title">Agency Launch Kit</h3>
            <p class="card-description">
              Close faster with proposal + SOW + onboarding — and less scope creep.
            </p>
            <div class="card-footer">
              <span class="card-link">
                Explore Kit
                <svg class="link-arrow" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6 3L11 8L6 13" /></svg>
              </span>
            </div>
          </a>

          <!-- SaaS Landing System -->
          <a href="/products/saas-landing-system/" class="product-card">
            <div class="card-glow" aria-hidden="true"></div>
            <div class="card-header">
              <span class="card-chip">LANDING</span>
              <div class="card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                  <line x1="12" y1="22.08" x2="12" y2="12" />
                </svg>
              </div>
            </div>
            <h3 class="card-title">SaaS Landing System</h3>
            <p class="card-description">
              Section-first landing with SEO/copy base to iterate and convert.
            </p>
            <div class="card-footer">
              <span class="card-link">
                Explore Kit
                <svg class="link-arrow" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6 3L11 8L6 13" /></svg>
              </span>
            </div>
          </a>
        </div>

        <!-- Info Note -->
        <div class="info-box" role="note">
          <div class="info-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <path d="M12 16v-4M12 8h.01" />
            </svg>
          </div>
          <p>
            You can start with "Buy via DM" (form/WhatsApp) and add a checkout integration whenever you're ready.
          </p>
        </div>
      </div>
    </section>
  </main>

  <script>
    const menuBtn = document.getElementById('menuBtn');
    const navLinks = document.getElementById('navLinks');

    menuBtn?.addEventListener('click', () => {
      const isOpen = navLinks?.classList.toggle('active');
      menuBtn?.classList.toggle('active');
      menuBtn?.setAttribute('aria-expanded', String(!!isOpen));
    });

    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href') ?? '');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          navLinks?.classList.remove('active');
          menuBtn?.classList.remove('active');
          menuBtn?.setAttribute('aria-expanded', 'false');
        }
      });
    });
  </script>

  <SiteFooter />
  <PageWidgets />
</body>
</html>
