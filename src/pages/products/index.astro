const qrgenProPlan = sitePricing.qrgenPlans.find((plan) => plan.id === 'pro') || qrgenPlans[0];
const qrgenLookupByPlan = {
  launch: 'builder_launch',
  pro: 'builder_pro',
  studio: 'builder_studio',
} as Record<string, string>;
type BuyReadyOffer = {
  label: { en: string; pt: string };
  title: string;
  copy: { en: string; pt: string };
  price: { GBP: string; EUR: string; BRL: string };
  billing: { en: string; pt: string };
  lookup: string;
  href: string;
  cta: { en: string; pt: string };
  image: string;
  featured?: boolean;
  checkout?: boolean;
};

const buyReadyNext = `${ROUTES.products}#buy-now`;
const checkoutOffer = (offer: Omit<BuyReadyOffer, 'href'> & { next?: string }): BuyReadyOffer => {
  const { next, ...item } = offer;
  const needsStoreContext = item.lookup.startsWith('icons_pack_');
  return {
    ...item,
    href: needsStoreContext ? ROUTES.iconsStore : checkoutHref(item.lookup, { next: next || buyReadyNext }),
    checkout: !needsStoreContext,
  };
};

