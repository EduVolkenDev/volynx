---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import PlatformAssistStrip from "../../components/PlatformAssistStrip.astro";
import { ROUTES } from "../../data/routes";

const productAssistItems = [
  { href: ROUTES.pricing, label: { en: "Compare", pt: "Comparar" }, title: { en: "See pricing", pt: "Ver pricing" }, copy: { en: "Compare Builder, Daily, bundles and VX without leaving the platform flow.", pt: "Compare Builder, Daily, bundles e VX sem sair do fluxo da plataforma." }, emphasized: true, iconSrc: "/assets/newpricing1.webp" },
  { href: ROUTES.delivery, label: { en: "Post-purchase", pt: "Pós-compra" }, title: { en: "My products", pt: "Meus produtos" }, copy: { en: "Already bought something? Reopen access, delivery and product recovery here.", pt: "Já comprou algo? Reabra acesso, entrega e recuperação de produto aqui." }, iconSrc: "/assets/mybox.webp" },
  { href: ROUTES.support, label: { en: "Support", pt: "Suporte" }, title: { en: "Need launch help?", pt: "Precisa de ajuda no lançamento?" }, copy: { en: "Route delivery, billing and access issues from the same ecosystem path.", pt: "Direcione entrega, cobrança e acesso pelo mesmo caminho do ecossistema." }, iconSrc: "/assets/support.webp" },
  { href: ROUTES.daily, label: { en: "Workspace", pt: "Workspace" }, title: { en: "Open Daily", pt: "Abrir Daily" }, copy: { en: "Jump from buying tools into the daily workspace where they connect back to use.", pt: "Pule de comprar ferramentas direto para o workspace diário onde elas se conectam ao uso." }, iconSrc: "/assets/daily-icon.webp" },
];
---
<FlagshipLayout title="Products — VOLYNX" description="Premium kits, tools and systems for developers, designers and modern internet businesses." pageClass="page-products">
  <FlagshipHeader current={ROUTES.products} ctaLabel="Open Builder" ctaI18n="nav.open_builder" ctaHref={ROUTES.builder} />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="kicker" data-i18n="prod.kicker">Products · curated</span>
          <h1 data-i18n="prod.hero_title">Kits that ship. Systems that convert. Product lines that feel premium.</h1>
          <p data-i18n="prod.hero_subtitle">Curated kits, tools and systems. Everything you need to launch, build and scale premium digital products.</p>
          <div class="hero-actions">
            <a href="#kits" class="button button--gold" data-i18n="prod.btn_see_kits">See premium kits</a>
            <a href={ROUTES.pricing} class="button button--ghost" data-i18n="prod.btn_compare_plans">Compare plans</a>
          </div>
        </div>
        <div class="hero-visual hero-visual--float">
          <img src="/assets/products.webp" alt="Products" class="hero-float-icon" />
        </div>
      </div>
    </section>

    <PlatformAssistStrip eyebrow={{ en: "Platform assist", pt: "Apoio da plataforma" }} title={{ en: "Choose, buy, recover, continue.", pt: "Escolha, compre, recupere, continue." }} description={{ en: "The public catalog should still feel operational. These paths keep discovery connected to pricing, purchases and support.", pt: "O catálogo público ainda deve ter cara de operacional. Esses caminhos mantêm descoberta conectada a pricing, compras e suporte." }} items={productAssistItems} />

    <!-- ═══ PREMIUM KITS ═══ -->
    <section id="kits" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="prod.eyebrow_kits">Premium kits</span>
        <h2 data-i18n="prod.section_kits_title">Launch-ready systems for real businesses</h2>
        <p data-i18n="prod.section_kits_desc">Each kit includes design, copy, code and deployment logic. Built for speed, conversion and premium perception.</p>
      </div>
      <div class="shell editorial-grid">
        <article class="panel gallery-card gallery-card--xl" style="background-image:url('/assets/newportfolio.webp')">
          <span class="label" data-i18n="prod.kit_portfolio_label">Flagship kit</span>
          <h3 data-i18n="prod.kit_portfolio_title">Portfolio Pro Kit</h3>
          <p data-i18n="prod.kit_portfolio_desc">Premium portfolio system with motion, SEO and conversion-first sections. Launch fast and look expensive.</p>
          <div class="actions">
            <a href={ROUTES.portfolioKit} class="button button--ghost" data-i18n="prod.kit_portfolio_btn">View kit</a>
            <a href={ROUTES.portfolioKitPreview} class="button button--gold">Preview unlocks</a>
          </div>
        </article>
        <article class="panel gallery-card" style="background-image:url('/assets/newlaunch.webp')">
          <span class="label" data-i18n="prod.kit_agency_label">For agencies</span>
          <h3 data-i18n="prod.kit_agency_title">Agency Launch Kit</h3>
          <p data-i18n="prod.kit_agency_desc">Brand, pages, proposal and SOW — everything a studio needs to close with less friction.</p>
          <div class="actions">
            <a href={ROUTES.agencyKit} class="button button--ghost" data-i18n="prod.kit_agency_btn">View kit</a>
            <a href={ROUTES.agencyKitPreview} class="button button--gold">Preview unlocks</a>
          </div>
        </article>
        <article class="panel gallery-card" style="background-image:url('/assets/saasbig.webp')">
          <span class="label" data-i18n="prod.kit_saas_label">For SaaS</span>
          <h3 data-i18n="prod.kit_saas_title">SaaS Landing System</h3>
          <p data-i18n="prod.kit_saas_desc">Conversion-first landing blocks that scale across offers and variant tests.</p>
          <div class="actions">
            <a href={ROUTES.saasSystem} class="button button--ghost" data-i18n="prod.kit_saas_btn">View system</a>
            <a href={ROUTES.saasSystemPreview} class="button button--gold">Preview unlocks</a>
          </div>
        </article>
      </div>
    </section>

    <!-- ═══ PROPERTYFLOW SPOTLIGHT ═══ -->
    <section class="page-section">
      <div class="shell">
        <article class="panel spotlight-card panel--pro">
          <div>
            <span class="label label--pro" data-i18n="prod.spotlight_pf_label">New · Real Estate SaaS</span>
            <h3 data-i18n="prod.spotlight_pf_title">PropertyFlow</h3>
            <p data-i18n="prod.spotlight_pf_desc">Premium property management for real estate agencies — smart catalogue, bilingual interface, live filters and a polished showcase that already feels like its own product line.</p>
          </div>
          <img src="/assets/newproperty.webp" alt="PropertyFlow preview" class="spotlight-img" />
          <div class="hero-actions">
            <a href={ROUTES.propertyflow} class="button button--gold" data-i18n="prod.spotlight_pf_btn">View PropertyFlow</a>
            <a href={`${ROUTES.docs}#propertyflow`} class="button button--ghost">Preview buyer flow</a>
          </div>
        </article>
      </div>
    </section>

    <!-- ═══ TOOLS & STUDIO ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="prod.eyebrow_tools">Tools & studio</span>
        <h2 data-i18n="prod.section_tools_title">Browser-based production tools</h2>
        <p data-i18n="prod.section_tools_desc">Free tools for discovery. Pro tools for serious output. All running locally in the browser.</p>
      </div>
      <div class="shell grid-3">
        <article class="panel product-card product-card--iconic panel--pro">
          <img src="/assets/builder.webp" alt="" class="product-card__float-icon" />
          <div class="head-row">
            <div><span class="label label--pro" data-i18n="prod.tool_builder_label">Main product</span><h3 data-i18n="prod.tool_builder_title">VOLYNX Builder</h3></div>
          </div>
          <p data-i18n="prod.tool_builder_desc">Create and publish premium sites with guided flows, premium kits and one-click deploy. Five plans from Free to Teams.</p>
          <div class="actions"><a href={ROUTES.builder} class="button button--gold" data-i18n="prod.tool_builder_btn">Open Builder</a></div>
        </article>
        <article class="panel product-card product-card--iconic">
          <img src="/assets/volynxlab.webp" alt="" class="product-card__float-icon" />
          <div class="head-row">
            <div><span class="label label--free" data-i18n="prod.tool_lab_label">Free</span><h3 data-i18n="prod.tool_lab_title">VOLYNX Lab</h3></div>
          </div>
          <p data-i18n="prod.tool_lab_desc">Convert, upscale and generate with no upload logic. Free browser tools for discovery. Upgrade to Studio Pro for more power.</p>
          <div class="actions"><a href={ROUTES.lab} class="button button--ghost" data-i18n="prod.tool_lab_btn">Open Lab</a></div>
        </article>
        <article class="panel product-card product-card--iconic">
          <img src="/assets/volynxstudio.webp" alt="" class="product-card__float-icon" />
          <div class="head-row">
            <div><span class="label label--pro" data-i18n="prod.tool_studio_label">Premium tools</span><h3 data-i18n="prod.tool_studio_title">Studio Pro</h3></div>
          </div>
          <p data-i18n="prod.tool_studio_desc">Higher usage limits, batch processing and commercial rights. The premium upgrade for Lab tools.</p>
          <div class="actions"><a href={ROUTES.studio} class="button button--ghost" data-i18n="prod.tool_studio_btn">See Studio Pro</a></div>
        </article>
        <article class="panel product-card product-card--iconic">
          <img src="/assets/cvitae.webp" alt="" class="product-card__float-icon" />
          <div class="head-row">
            <div><span class="label label--free" data-i18n="prod.tool_cvitae_label">Free + AI</span><h3 data-i18n="prod.tool_cvitae_title">CVitae</h3></div>
          </div>
          <p data-i18n="prod.tool_cvitae_desc">AI-assisted CV builder with guided sections, live preview, premium templates and VX-enabled exports where supported.</p>
          <div class="actions"><a href={ROUTES.cvitae} class="button button--ghost" data-i18n="prod.tool_cvitae_btn">Build your CV</a></div>
        </article>
      </div>
    </section>

    <!-- ═══ MORE PRODUCTS ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="prod.eyebrow_more">More from VOLYNX</span>
        <h2 data-i18n="prod.section_more_title">Services and assets</h2>
      </div>
      <div class="shell grid-3">
        <article class="panel product-card product-card--iconic">
          <img src="/assets/icons-store-logo.webp" alt="" class="product-card__float-icon product-card__float-icon--icons-store" />
          <div class="head-row"><div><span class="label" data-i18n="prod.service_icons_label">Icons</span><h3 data-i18n="prod.service_icons_title">Volynx Icons</h3></div></div>
          <p data-i18n="prod.service_icons_desc">A curated icon store: sharp, consistent, brand-ready. Grid, styles and packs.</p>
          <div class="actions">
            <a href={ROUTES.iconsStore} class="button button--ghost" data-i18n="prod.service_icons_btn">Browse Icons</a>
            <a href={`${ROUTES.docs}#icons-store`} class="button button--gold">Preview buyer flow</a>
          </div>
        </article>
        <article class="panel product-card product-card--iconic">
          <img src="/assets/maintenanceplans.webp" alt="" class="product-card__float-icon" />
          <div class="head-row"><div><span class="label" data-i18n="prod.service_maintenance_label">Plans</span><h3 data-i18n="prod.service_maintenance_title">Maintenance Plans</h3></div></div>
          <p data-i18n="prod.service_maintenance_desc">Structured website maintenance and product evolution. Predictable delivery, zero friction.</p>
          <div class="actions"><a href={ROUTES.maintenance} class="button button--ghost" data-i18n="prod.service_maintenance_btn">See Plans</a></div>
        </article>
        <article class="panel product-card product-card--iconic">
          <img src="/assets/saasbig.webp" alt="" class="product-card__float-icon" />
          <div class="head-row"><div><span class="label" data-i18n="prod.service_landing_label">Builder mode</span><h3 data-i18n="prod.service_landing_title">Landing Express</h3></div></div>
          <p data-i18n="prod.service_landing_desc">Guided Builder mode for conversion-focused landing pages. Premium structure, fast setup.</p>
          <div class="actions"><a href={ROUTES.landingExpress} class="button button--ghost" data-i18n="prod.service_landing_btn">Get Started</a></div>
        </article>
      </div>
    </section>

    <!-- ═══ FINAL CTA ═══ -->
    <section class="page-section page-section--last">
      <div class="shell callout panel panel--pro">
        <div>
          <span class="label label--pro" data-i18n="prod.cta_label">Full ecosystem</span>
          <strong data-i18n="prod.cta_tagline">Every product connects. Every tool has a purpose.</strong>
          <p data-i18n="prod.cta_desc">From kits to tools to builder to studio — the VOLYNX ecosystem is designed to work together, not compete for attention.</p>
        </div>
        <div class="hero-actions">
          <a href={ROUTES.pricing} class="button button--gold" data-i18n="prod.cta_pricing_btn">See pricing</a>
          <a href={ROUTES.devHub} class="button button--ghost" data-i18n="prod.cta_devhub_btn">Explore Dev Hub</a>
        </div>
      </div>
    </section>

  </main>
  <FlagshipFooter />
</FlagshipLayout>
