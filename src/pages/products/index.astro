---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VxHeader from "../../components/VxHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/products.v2.css";


const title = "Products — VOLYNX";

const products = [
  {
    name: "Agency Launch Kit",
    slug: "agency-launch-kit",
    badge: "Kit",
    meta: "Brand • Pages • Copy",
    desc: "Launch-ready assets for studios that want speed and consistency.",
    metaKey: "products.alkit.meta",
    descKey: "products.alkit.desc",
  },
  {
    name: "Portfolio Pro Kit",
    slug: "portfolio-pro-kit",
    badge: "Kit",
    meta: "Sections • Motion • SEO",
    desc: "A premium portfolio system designed to convert, not just look pretty.",
    metaKey: "products.ppk.meta",
    descKey: "products.ppk.desc",
  },
  {
    name: "SaaS Landing System",
    slug: "saas-landing-system",
    badge: "System",
    meta: "Blocks • Variants • UI",
    desc: "Conversion-first landing blocks that scale across offers.",
    metaKey: "products.sls.meta",
    descKey: "products.sls.desc",
  },
  {
    name: "Volynx Icons",
    slug: "volynx-icons-store",
    badge: "Icons",
    meta: "Grid • Styles • Packs",
    desc: "A curated icon store: sharp, consistent, brand-ready.",
    metaKey: "products.icons.meta",
    descKey: "products.icons.desc",
  },
  {
    name: "Maintenance Plans",
    slug: "maintenance-plans",
    href: "/maintenance/",
    badge: "Plans",
    meta: "Updates • SEO • Support",
    desc: "Structured website maintenance and product evolution. Predictable delivery, zero friction.",
    metaKey: "products.maintenance.meta",
    descKey: "products.maintenance.desc",
  },
  {
    name: "Landing Express",
    slug: "landing-express",
    href: "/services/landing-express/",
    badge: "Pages",
    meta: "Conversion • Copy • Speed",
    desc: "A serious Landing Page that turns visitors into buyers. Delivered in 48–72h.",
    metaKey: "products.landing.meta",
    descKey: "products.landing.desc",
  },
  {
    name: "Dev Tools",
    slug: "dev-tools",
    href: "/volynx-lab/",
    badge: "Tools",
    meta: "Convert • Scale • Ship",
    desc: "Production-grade tools for developers: image processing, QR generation, converters and more.",
    metaKey: "products.devtools.meta",
    descKey: "products.devtools.desc",
  },
  {
    name: "VOLYNX Builder",
    slug: "builder",
    href: "/builder/",
    badge: "Builder",
    meta: "Sites • JSON • Deploy",
    desc: "Create and manage mini-sites with a JSON editor, magic link auth and one-click publish.",
    metaKey: "products.builder.meta",
    descKey: "products.builder.desc",
  },
  {
    name: "PropertyFlow",
    slug: "propertyflow",
    badge: "Real Estate",
    meta: "Listings • Filters • CMS",
    desc: "Premium property management platform for real estate agencies. Smart catalogue, bilingual interface, and Supabase-ready backend.",
    metaKey: "products.propertyflow.meta",
    descKey: "products.propertyflow.desc",
  },
];
---

<BaseLayout title={title}>
  <VxHeader />

  <main class="shell productsV2">
    <section class="hero">
      <h1 data-i18n="products.title">Products</h1>
      <p class="sub" data-i18n="products.subtitle">
        Kits that ship. Systems that convert. Icons that don’t look like 2014.
      </p>

      <div class="toolbar" role="group" aria-label="Product tools">
        <div class="search" aria-label="Search (UI only)">
          <span class="hint" aria-hidden="true">⌘K</span>
          <input placeholder="Search products…" data-i18n-placeholder="products.search_placeholder" disabled />
        </div>

        <div class="filters" aria-label="Quick links">
          <a class="chip" href="/dev-hub/" data-i18n="products.filter.devhub">Dev Hub</a>
          <a class="chip" href="/pricing/" data-i18n="products.filter.pricing">Pricing</a>
          <a class="chip" href="/contact/" data-i18n="products.filter.contact">Contact</a>
        </div>
      </div>
    </section>

    <section class="grid" aria-label="Product catalog">
      {products.map((p) => (
        <article class="card">
          <div class="cardTop">
            <span class="badge">{p.badge}</span>
            <span class="meta" data-i18n={p.metaKey}>{p.meta}</span>
          </div>

          <h2>{p.name}</h2>
          <p data-i18n={p.descKey}>{p.desc}</p>

          <div class="metaRow">
            <span class="small">Includes: <span data-i18n={p.metaKey}>{p.meta}</span></span>
            <div class="ctaRow">
              <a class="btn" href={p.href ?? `/products/${p.slug}/`} data-i18n="products.view_btn">View</a>
              <a class="btn secondary" href="/contact/" data-i18n="products.buy_btn">Buy</a>
            </div>
          </div>
        </article>
      ))}
    </section>
  </main>

  <SiteFooter />
</BaseLayout>