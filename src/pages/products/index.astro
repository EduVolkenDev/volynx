---

<BaseLayout title={title}>
  <VxHeader />

  <main class="shell productsV2">
    <section class="hero">
      <h1 data-i18n="products.title">Products</h1>
      <p class="sub" data-i18n="products.subtitle">
        Kits that ship. Systems that convert. Icons that don’t look like 2014.
      </p>

      <div class="toolbar" role="group" aria-label="Product tools">
        <div class="search" aria-label="Search (UI only)">
          <span class="hint" aria-hidden="true">⌘K</span>
          <input placeholder="Search products…" data-i18n-placeholder="products.search_placeholder" disabled />
        </div>

        <div class="filters" aria-label="Quick links">
          <a class="chip" href="/dev-hub/" data-i18n="products.filter.devhub">Dev Hub</a>
          <a class="chip" href="/pricing/" data-i18n="products.filter.pricing">Pricing</a>
          <a class="chip" href="/contact/" data-i18n="products.filter.contact">Contact</a>
        </div>
      </div>
    </section>

    <section class="grid" aria-label="Product catalog">
      {products.map((p) => (
        <article class={`card ${p.icon ? 'card--has-icon' : ''} ${p.badge === 'Pro' || p.badge === 'Pro Tool' || p.badge === 'Pro Exclusive' ? 'card--pro' : ''}`}>
          <div class="cardTop">
            {p.icon && <img class="card__icon" src={p.icon} alt="" />}
            <div class="cardTop__text">
              <span class={`badge ${p.badge === 'Pro' || p.badge === 'Pro Tool' || p.badge === 'Pro Exclusive' ? 'badge--pro' : ''}`}>{p.badge}</span>
              <span class="meta" data-i18n={p.metaKey}>{p.meta}</span>
            </div>
          </div>

          <h2>{p.name}</h2>
          <p data-i18n={p.descKey}>{p.desc}</p>

          <div class="metaRow">
            <span class="small">Includes: <span data-i18n={p.metaKey}>{p.meta}</span></span>
            <div class="ctaRow">
              <a class="btn" href={p.href ?? `/products/${p.slug}/`} data-i18n="products.view_btn">View</a>
              <a class="btn secondary" href={p.buyHref ?? '/contact/'}>{p.buyLabel ?? 'Buy'}</a>
            </div>
          </div>
        </article>
      ))}
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* Product card icons */
  .card__icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .card--has-icon .cardTop {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .cardTop__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Pro card styling */
  .card--pro {
    border-color: rgba(109,94,252,.2);
    background: rgba(109,94,252,.03);
  }

  .card--pro:hover {
    border-color: rgba(109,94,252,.35);
    box-shadow: 0 0 24px rgba(109,94,252,.06);
  }

  .badge--pro {
    background: rgba(109,94,252,.15) !important;
    border-color: rgba(109,94,252,.35) !important;
    color: #C4B5FD !important;
  }
</style>