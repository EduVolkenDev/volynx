---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";
---
<FlagshipLayout title="Products — VOLYNX" description="Premium kits, tools and systems for developers, designers and modern internet businesses." pageClass="page-products">
  <FlagshipHeader current={ROUTES.products} ctaLabel="Open the Ecosystem" />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="kicker">Products · curated</span>
          <h1>Kits that ship. Systems that convert. Product lines that feel premium.</h1>
          <p>The products page is editorial, not a flat catalog. It organizes product categories, plan inclusion and upgrade logic with clear visual status.</p>
          <div class="hero-actions">
            <a href="#kits" class="button button--gold">See premium kits</a>
            <a href={ROUTES.pricing} class="button button--ghost">Compare plans</a>
          </div>
        </div>
        <div class="hero-card visual-card">
          <span class="label">Ecosystem map</span>
          <div class="stack">
            <div class="metric">Premium Kits</div>
            <div class="metric">VOLYNX Lab</div>
            <div class="metric">Builder</div>
            <div class="metric">Studio Pro</div>
          </div>
          <img src="/assets/volynx-icon.webp" alt="Ecosystem" />
        </div>
      </div>
    </section>

    <!-- ═══ PREMIUM KITS ═══ -->
    <section id="kits" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow">Premium kits</span>
        <h2>Launch-ready systems for real businesses</h2>
        <p>Each kit includes design, copy, code and deployment logic. Built for speed, conversion and premium perception.</p>
      </div>
      <div class="shell editorial-grid">
        <article class="panel gallery-card gallery-card--xl" style="background-image:url('/assets/newportfolio.webp')">
          <span class="label">Flagship kit</span>
          <h3>Portfolio Pro Kit</h3>
          <p>Premium portfolio system with motion, SEO and conversion-first sections. Launch fast and look expensive.</p>
          <div class="actions"><a href={ROUTES.portfolioKit} class="button button--ghost">View kit</a></div>
        </article>
        <article class="panel gallery-card" style="background-image:url('/assets/newlaunch.webp')">
          <span class="label">For agencies</span>
          <h3>Agency Launch Kit</h3>
          <p>Brand, pages, proposal and SOW — everything a studio needs to close with less friction.</p>
          <div class="actions"><a href={ROUTES.agencyKit} class="button button--ghost">View kit</a></div>
        </article>
        <article class="panel gallery-card" style="background-image:url('/assets/saasbig.webp')">
          <span class="label">For SaaS</span>
          <h3>SaaS Landing System</h3>
          <p>Conversion-first landing blocks that scale across offers and variant tests.</p>
          <div class="actions"><a href={ROUTES.saasSystem} class="button button--ghost">View system</a></div>
        </article>
      </div>
    </section>

    <!-- ═══ PROPERTYFLOW SPOTLIGHT ═══ -->
    <section class="page-section">
      <div class="shell">
        <article class="panel spotlight-card panel--pro">
          <div>
            <span class="label label--pro">New · Real Estate SaaS</span>
            <h3>PropertyFlow</h3>
            <p>Premium property management for real estate agencies — smart catalogue, bilingual interface, live filters and a polished showcase that already feels like its own product line.</p>
          </div>
          <a href={ROUTES.propertyflow} class="button button--gold">View PropertyFlow</a>
        </article>
      </div>
    </section>

    <!-- ═══ TOOLS & STUDIO ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow">Tools & studio</span>
        <h2>Browser-based production tools</h2>
        <p>Free tools for discovery. Pro tools for serious output. All running locally in the browser.</p>
      </div>
      <div class="shell grid-3">
        <article class="panel product-card">
          <div class="head-row">
            <div><span class="label label--free">Free</span><h3>VOLYNX Lab</h3></div>
          </div>
          <p>Convert, upscale and generate with no upload logic. Clean enough for discovery, strong enough to convert into Studio.</p>
          <div class="actions"><a href={ROUTES.lab} class="button button--ghost">Open Lab</a></div>
        </article>
        <article class="panel product-card panel--pro">
          <div class="head-row">
            <div><span class="label label--pro">Included in Pro</span><h3>Studio Pro</h3></div>
            <span class="chip">Production</span>
          </div>
          <p>The layer for users who care about stronger outputs, saved workflows and cleaner delivery. No daily limits, batch processing, commercial rights.</p>
          <div class="actions"><a href={ROUTES.studio} class="button button--gold">See Studio Pro</a></div>
        </article>
        <article class="panel product-card">
          <div class="head-row">
            <div><span class="label">Builder</span><h3>VOLYNX Builder</h3></div>
          </div>
          <p>Create and manage premium mini-sites with JSON editor, magic link auth and one-click publish. Custom domains on Pro.</p>
          <div class="actions"><a href={ROUTES.builder} class="button button--ghost">Open Builder</a></div>
        </article>
      </div>
    </section>

    <!-- ═══ MORE PRODUCTS ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow">More from VOLYNX</span>
        <h2>Services and assets</h2>
      </div>
      <div class="shell grid-3">
        <article class="panel product-card">
          <div class="head-row"><div><span class="label">Icons</span><h3>Volynx Icons</h3></div></div>
          <p>A curated icon store: sharp, consistent, brand-ready. Grid, styles and packs.</p>
          <div class="actions"><a href={ROUTES.iconsStore} class="button button--ghost">Browse Icons</a></div>
        </article>
        <article class="panel product-card">
          <div class="head-row"><div><span class="label">Plans</span><h3>Maintenance Plans</h3></div></div>
          <p>Structured website maintenance and product evolution. Predictable delivery, zero friction.</p>
          <div class="actions"><a href={ROUTES.maintenance} class="button button--ghost">See Plans</a></div>
        </article>
        <article class="panel product-card">
          <div class="head-row"><div><span class="label">Pages</span><h3>Landing Express</h3></div></div>
          <p>A serious landing page that turns visitors into buyers. Delivered in 48-72h.</p>
          <div class="actions"><a href={ROUTES.landingExpress} class="button button--ghost">Get Started</a></div>
        </article>
      </div>
    </section>

    <!-- ═══ FINAL CTA ═══ -->
    <section class="page-section page-section--last">
      <div class="shell callout panel panel--pro">
        <div>
          <span class="label label--pro">Full ecosystem</span>
          <strong>Every product connects. Every tool has a purpose.</strong>
          <p>From kits to tools to builder to studio — the VOLYNX ecosystem is designed to work together, not compete for attention.</p>
        </div>
        <div class="hero-actions">
          <a href={ROUTES.pricing} class="button button--gold">See pricing</a>
          <a href={ROUTES.devHub} class="button button--ghost">Explore Dev Hub</a>
        </div>
      </div>
    </section>

  </main>
  <FlagshipFooter />
</FlagshipLayout>
