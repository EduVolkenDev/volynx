const currencyParam = Astro.url.searchParams.get('currency') || '';
const currentCurrency = (['GBP', 'EUR', 'BRL'] as const).includes(currencyParam as any) ? currencyParam as 'GBP'|'EUR'|'BRL' : 'GBP';
