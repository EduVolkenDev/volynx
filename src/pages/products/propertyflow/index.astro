             data-tpl-when="When one property is the pitch and supporting shots build the dream. Hero image dominates; thumbnails preview the journey."
             data-tpl-strength="Cinematic first impression + frictionless scroll into supporting visuals. Built to convert lifestyle buyers."
             data-tpl-package="Professional">
          <div class="tpl-preview tpl-preview--gallery" aria-hidden="true">
            <div class="tpl-preview__topbar">
              <span class="tpl-dot tpl-dot--active"></span>
