---
import PageWidgets from "../../../components/PageWidgets.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import Topbar from "../../../components/Topbar.astro";
import { ROUTES } from "../../../data/routes";
const pageTitle = "PropertyFlow — VOLYNX Real Estate Platform";
const pageDescription = "Premium property management platform for real estate agencies. Smart catalogue, bilingual interface, filters, and Supabase-ready backend.";
---

<!DOCTYPE html>
<html lang="en" class="is-ready">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#07070b" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <script>document.documentElement.classList.add('js');</script>

  <style>
    :root {
      --bg: #07070b;
      --text: rgba(255,255,255,0.96);
      --muted: rgba(255,255,255,0.62);
      --gold: #d6b36a;
      --gold-soft: #f1deaa;
      --violet: #8b5cf6;
      --blue: #59c3ff;
      --line: rgba(255,255,255,0.10);
      --shadow: 0 20px 80px rgba(0,0,0,0.5);
      --radius: 26px;
      --max: 1100px;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      font-family: 'Inter', system-ui, sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(89,195,255,0.10), transparent 30%),
        radial-gradient(circle at 80% 15%, rgba(139,92,246,0.10), transparent 28%),
        linear-gradient(180deg, #05050a 0%, #090910 100%);
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }
    img { display: block; max-width: 100%; }

    /* ─── Topbar ─── */
    .topbar {
      position: sticky; top: 0; z-index: 50;
      backdrop-filter: blur(18px);
      background: rgba(7,7,11,0.6);
      border-bottom: 1px solid var(--line);
    }
    .topbar__inner {
      max-width: var(--max); margin: 0 auto;
      padding: 0 20px; min-height: 72px;
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
    }
    .brand {
      display: inline-flex; align-items: center; gap: 10px;
      font-weight: 800; font-size: 0.9rem; letter-spacing: 0.02em;
    }
    .brand__mark {
      width: 13px; height: 13px; border-radius: 999px; flex-shrink: 0;
      background: linear-gradient(135deg, var(--blue), var(--violet), var(--gold));
      box-shadow: 0 0 20px rgba(89,195,255,0.4);
    }
    .topbar__back {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 16px; border-radius: 999px;
      border: 1px solid var(--line);
      background: rgba(255,255,255,0.03);
      color: var(--muted); font-size: 0.84rem;
      transition: color 180ms, background 180ms;
    }
    .topbar__back:hover { color: var(--text); background: rgba(255,255,255,0.07); }

    /* ─── Shell ─── */
    .shell { max-width: var(--max); margin: 0 auto; padding: 0 20px 80px; }

    /* ─── Hero ─── */
    .hero {
      padding: 72px 0 56px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: center;
    }
    .hero__badge {
      display: inline-flex; width: fit-content;
      padding: 7px 14px; border-radius: 999px;
      border: 1px solid rgba(214,179,106,0.25);
      background: rgba(214,179,106,0.08);
      color: #ead8aa; font-size: 0.76rem;
      text-transform: uppercase; letter-spacing: 0.06em;
      margin-bottom: 20px;
    }
    .hero h1 {
      margin: 0;
      font-size: clamp(2.6rem, 5.5vw, 4.8rem);
      line-height: 0.96; letter-spacing: -0.05em;
    }
    .hero h1 span {
      display: block;
      background: linear-gradient(135deg, #fff, #e8d49a, #89d7ff);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .hero p {
      margin: 22px 0 0; max-width: 54ch;
      color: var(--muted); line-height: 1.8; font-size: 1.05rem;
    }
    .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

    .btn {
      display: inline-flex; align-items: center; justify-content: center;
      min-height: 48px; padding: 0 22px; border-radius: 999px;
      border: 1px solid var(--line); font-size: 0.9rem; font-weight: 500;
      transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
      cursor: pointer;
    }
    .btn:hover { transform: translateY(-1px); }
    .btn--primary {
      color: #0a0a0f;
      background: linear-gradient(135deg, var(--gold-soft), var(--gold));
      border-color: rgba(255,255,255,0.15);
    }
    .btn--ghost { background: rgba(255,255,255,0.04); color: var(--text); }

    /* ─── Hero visual ─── */
    .hero__visual {
      position: relative; min-height: 480px;
    }
    .hero__glow {
      position: absolute; border-radius: 999px;
      filter: blur(60px); opacity: 0.3; pointer-events: none;
    }
    .hero__glow--a { width: 200px; height: 200px; top: 0; right: 0; background: rgba(89,195,255,0.5); }
    .hero__glow--b { width: 200px; height: 200px; bottom: 30px; left: 0; background: rgba(139,92,246,0.4); }
    .hero__img {
      position: relative; z-index: 1;
      width: 100%; max-width: 560px; height: auto;
      object-fit: contain;
      border-radius: 0;
      border: 0;
      box-shadow: none;
      filter: drop-shadow(0 24px 60px rgba(89,195,255,.4)) drop-shadow(0 0 48px rgba(139,92,246,.3));
      transition: transform .6s ease, filter .6s ease;
    }
    .hero__img:hover {
      transform: translateY(-6px) scale(1.02);
      filter: drop-shadow(0 28px 72px rgba(89,195,255,.55)) drop-shadow(0 0 60px rgba(139,92,246,.42));
    }
    @media (min-width: 960px) {
      .hero__img { max-width: 680px; }
    }

    /* ─── Section ─── */
    .section { padding: 48px 0 24px; }
    .section__head { margin-bottom: 32px; }
    .kicker {
      display: inline-block; padding: 7px 14px; border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03);
      color: #e6d6a8; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.05em;
      margin-bottom: 14px;
    }
    .section h2 {
      margin: 0; font-size: clamp(1.8rem, 3.5vw, 3rem);
      line-height: 1.02; letter-spacing: -0.04em;
    }
    .section p.sub { margin: 14px 0 0; color: var(--muted); line-height: 1.8; max-width: 60ch; }

    /* ─── Feature grid ─── */
    .features {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .feature {
      border-radius: var(--radius); padding: 28px;
      border: 1px solid rgba(255,255,255,0.08);
      background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
      box-shadow: var(--shadow);
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }
    .feature__icon {
      width: 120px;
      height: 120px;
      flex-shrink: 0;
    }
    .feature__icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .feature h3 { margin: 0; font-size: 1rem; }

    .feature p { margin: 0; color: var(--muted); font-size: 0.9rem; line-height: 1.7; }

    /* ─── Stack row ─── */
    .stack { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
    .stack__pill {
      display: inline-flex; padding: 8px 14px; border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.04);
      color: var(--muted); font-size: 0.84rem;
    }

    /* ─── Who it's for ─── */
    .audience { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .audience__card {
      border-radius: var(--radius); padding: 24px;
      border: 1px solid rgba(255,255,255,0.08);
      background: linear-gradient(180deg, rgba(255,255,255,0.04), transparent);
    }
    .audience__card h3 { margin: 0 0 8px; font-size: 1rem; }
    .audience__card p { margin: 0; color: var(--muted); font-size: 0.88rem; line-height: 1.7; }

    /* ─── Pricing ─── */
    .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .price-card {
      border-radius: var(--radius); padding: 28px 24px;
      border: 1px solid rgba(255,255,255,0.08);
      background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
      display: flex; flex-direction: column;
    }
    .price-card--featured {
      border-color: rgba(214,179,106,0.35);
      background: linear-gradient(180deg, rgba(214,179,106,0.08), rgba(255,255,255,0.02));
      box-shadow: 0 0 40px rgba(214,179,106,0.08);
    }
    .price-card__name { font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 8px; }
    .price-card--featured .price-card__name { color: var(--gold); }
    .price-card__price { font-size: 2.2rem; font-weight: 800; letter-spacing: -0.04em; margin-bottom: 4px; }
    .price-card__billing { font-size: 0.82rem; color: var(--muted); margin-bottom: 20px; }
    .price-card__features { list-style: none; padding: 0; margin: 0 0 24px; flex: 1; }
    .price-card__features li { padding: 6px 0; font-size: 0.88rem; color: rgba(255,255,255,0.78); border-bottom: 1px solid rgba(255,255,255,0.05); }
    .price-card__features li::before { content: "✓ "; color: #34D399; font-weight: 700; }
    .price-card__cta { width: 100%; text-align: center; }

    .price-card__badge { position:absolute; top:12px; right:12px; padding:4px 10px; border-radius:999px; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; background:rgba(214,179,106,.2); border:1px solid rgba(214,179,106,.3); color:var(--gold); }
    .price-card--featured { position:relative; }

    /* ─── Template preview grid ─── */
    .template-preview-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }
    .tpl-card {
      border-radius: var(--radius);
      border: 1px solid rgba(255,255,255,.08);
      background: linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.02));
      padding: 16px;
      text-align: center;
      font-size: .85rem;
      font-weight: 600;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow);
    }
    .tpl-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,.04), transparent 42%);
      pointer-events: none;
    }
    .tpl-card--pro {
      border-color: rgba(214,179,106,.18);
      background: linear-gradient(180deg, rgba(214,179,106,.09), rgba(255,255,255,.02));
    }
    .tpl-card > span {
      position: relative;
      z-index: 1;
      display: block;
      margin-top: 10px;
      line-height: 1.25;
    }
    .tpl-card--pro .tpl-pro-tag {
      position: absolute;
      top: 12px;
      right: 12px;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: .65rem;
      font-weight: 700;
      background: rgba(139,92,246,.2);
      border: 1px solid rgba(139,92,246,.3);
      color: #c4b5fd;
      z-index: 2;
    }
    .tpl-preview {
      position: relative;
      min-height: 176px;
      padding: 12px;
      border-radius: 16px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: 10px;
      border: 1px solid rgba(255,255,255,.08);
      background:
        radial-gradient(circle at 18% 18%, rgba(255,255,255,.08), transparent 30%),
        linear-gradient(180deg, rgba(10,10,18,.95), rgba(15,15,24,.88));
    }
    .tpl-preview::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent, rgba(0,0,0,.1));
      pointer-events: none;
    }
    .tpl-preview__topbar,
    .tpl-preview__filterrow {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }
    .tpl-dot {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: rgba(255,255,255,.18);
    }
    .tpl-dot--active {
      background: var(--tpl-accent, #59c3ff);
      box-shadow: 0 0 0 4px rgba(89,195,255,.12);
    }
    .tpl-pill {
      margin-left: auto;
      width: 42px;
      height: 9px;
      border-radius: 999px;
      background: rgba(255,255,255,.12);
    }
    .tpl-chip {
      width: 36px;
      height: 16px;
      border-radius: 999px;
      background: rgba(255,255,255,.12);
    }
    .tpl-chip--active {
      background: rgba(214,179,106,.24);
      border: 1px solid rgba(214,179,106,.22);
    }
    .tpl-mini,
    .tpl-row,
    .tpl-masonry__card,
    .tpl-split__panel,
    .tpl-split__media,
    .tpl-preview__gallery-image,
    .tpl-gallery-card {
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,.08);
      background:
        linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.03));
      box-shadow: inset 0 1px 0 rgba(255,255,255,.04);
    }
    .tpl-mini,
    .tpl-row {
      position: relative;
      z-index: 1;
    }
    .tpl-mini {
      padding: 8px;
      display: flex;
      flex-direction: column;
      gap: 7px;
      min-height: 0;
    }
    .tpl-mini__media {
      display: block;
      height: 54px;
      border-radius: 10px;
      background: linear-gradient(135deg, rgba(89,195,255,.22), rgba(139,92,246,.16));
      border: 1px solid rgba(255,255,255,.06);
    }
    .tpl-mini__media--tall { height: 92px; }
    .tpl-mini__meta {
      display: block;
      height: 7px;
      border-radius: 999px;
      background: rgba(255,255,255,.16);
    }
    .tpl-mini__meta--lg { width: 78%; }
    .tpl-mini__meta--md { width: 56%; }
    .tpl-mini__meta--sm { width: 42%; }
    .tpl-mini--feature { grid-row: span 2; }

    .tpl-preview--classic { --tpl-accent: #59c3ff; }
    .tpl-preview__classic-grid {
      display: grid;
      grid-template-columns: 1.12fr .88fr;
      grid-auto-rows: minmax(0, 1fr);
      gap: 8px;
      flex: 1;
      min-height: 0;
    }
    .tpl-preview__classic-grid .tpl-mini:first-child {
      background: linear-gradient(180deg, rgba(89,195,255,.12), rgba(255,255,255,.03));
    }

    .tpl-preview--magazine { --tpl-accent: #d6b36a; }
    .tpl-preview__mag-layout {
      display: grid;
      grid-template-columns: 1.2fr .92fr;
      gap: 8px;
      flex: 1;
      min-height: 0;
    }
    .tpl-preview__mag-stack {
      display: grid;
      grid-template-rows: repeat(2, 1fr);
      gap: 8px;
      min-height: 0;
    }
    .tpl-preview--magazine .tpl-mini--feature {
      background: linear-gradient(180deg, rgba(214,179,106,.12), rgba(255,255,255,.03));
    }

    .tpl-preview--compact { --tpl-accent: #8b5cf6; }
    .tpl-preview__list {
      display: grid;
      gap: 8px;
      flex: 1;
      min-height: 0;
    }
    .tpl-row {
      display: grid;
      grid-template-columns: 48px minmax(0, 1fr) auto;
      gap: 8px;
      align-items: center;
      padding: 8px;
      border-radius: 12px;
      background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
    }
    .tpl-row__thumb {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,.07);
      background: linear-gradient(135deg, rgba(139,92,246,.22), rgba(89,195,255,.16));
    }
    .tpl-row__copy {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .tpl-row__line {
      display: block;
      height: 6px;
      border-radius: 999px;
      background: rgba(255,255,255,.14);
    }
    .tpl-row__line--lg { width: 82%; }
    .tpl-row__line--md { width: 56%; }
    .tpl-row__line--sm { width: 42%; }
    .tpl-row__price {
      width: 28px;
      height: 28px;
      border-radius: 999px;
      background: rgba(214,179,106,.22);
      border: 1px solid rgba(214,179,106,.16);
      flex-shrink: 0;
    }
    .tpl-preview__filterrow { flex-wrap: wrap; }

    .tpl-preview--gallery { --tpl-accent: #59c3ff; }
    .tpl-preview__gallery-layout {
      display: grid;
      grid-template-rows: 1.22fr .72fr;
      gap: 8px;
      flex: 1;
      min-height: 0;
    }
    .tpl-preview__hero-spot {
      position: relative;
      min-height: 0;
      overflow: hidden;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,.08);
      background:
        radial-gradient(circle at 18% 18%, rgba(89,195,255,.22), transparent 30%),
        linear-gradient(135deg, rgba(89,195,255,.16), rgba(214,179,106,.10));
    }
    .tpl-preview__gallery-image {
      position: absolute;
      inset: 0;
      border-radius: 0;
      background:
        linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02)),
        linear-gradient(135deg, rgba(89,195,255,.12), rgba(139,92,246,.14));
    }
    .tpl-preview__gallery-chip {
      position: absolute;
      left: 12px;
      bottom: 12px;
      width: 56px;
      height: 18px;
      border-radius: 999px;
      background: rgba(7,7,11,.72);
      border: 1px solid rgba(255,255,255,.14);
      z-index: 1;
    }
    .tpl-preview__gallery-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }
    .tpl-gallery-card {
      height: 36px;
      background:
        linear-gradient(135deg, rgba(89,195,255,.18), rgba(255,255,255,.05));
    }

    .tpl-preview--split { --tpl-accent: #d6b36a; }
    .tpl-preview__split-layout {
      display: grid;
      grid-template-columns: .96fr .88fr;
      gap: 8px;
      flex: 1;
      min-height: 0;
    }
    .tpl-split__media {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(circle at 20% 20%, rgba(214,179,106,.16), transparent 26%),
        linear-gradient(135deg, rgba(214,179,106,.18), rgba(89,195,255,.10));
    }
    .tpl-split__media::before {
      content: "";
      position: absolute;
      inset: 12px;
      border-radius: 11px;
      background:
        linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,.04)),
        linear-gradient(135deg, rgba(214,179,106,.10), rgba(89,195,255,.10));
      border: 1px solid rgba(255,255,255,.07);
    }
    .tpl-split__badge,
    .tpl-split__price {
      position: absolute;
      z-index: 1;
      border-radius: 999px;
      background: rgba(7,7,11,.72);
      border: 1px solid rgba(255,255,255,.14);
    }
    .tpl-split__badge {
      left: 12px;
      top: 12px;
      width: 38px;
      height: 16px;
    }
    .tpl-split__price {
      right: 12px;
      bottom: 12px;
      width: 44px;
      height: 18px;
    }
    .tpl-split__panel {
      padding: 10px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
    }
    .tpl-split__bar {
      display: block;
      height: 7px;
      border-radius: 999px;
      background: rgba(255,255,255,.15);
    }
    .tpl-split__bar--wide { width: 80%; }
    .tpl-split__bar--mid { width: 58%; }
    .tpl-split__bar--short { width: 40%; }
    .tpl-split__stats {
      margin-top: auto;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 6px;
    }
    .tpl-split__stats span {
      height: 24px;
      border-radius: 999px;
      background: rgba(214,179,106,.14);
      border: 1px solid rgba(214,179,106,.12);
    }

    .tpl-preview--masonry { --tpl-accent: #f1deaa; }
    .tpl-preview__masonry {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      flex: 1;
      min-height: 0;
    }
    .tpl-masonry__col {
      display: grid;
      gap: 8px;
      align-content: start;
      min-height: 0;
    }
    .tpl-masonry__card {
      border-radius: 12px;
      background:
        linear-gradient(135deg, rgba(214,179,106,.16), rgba(89,195,255,.10));
    }
    .tpl-masonry__card--tall { height: 72px; }
    .tpl-masonry__card--mid { height: 52px; }
    .tpl-masonry__card--short { height: 28px; }
    .tpl-masonry__card--accent {
      background:
        linear-gradient(135deg, rgba(139,92,246,.16), rgba(214,179,106,.10));
    }
    .tpl-pro-tag { position:absolute; top:8px; right:8px; padding:2px 8px; border-radius:999px; font-size:.65rem; font-weight:700; background:rgba(139,92,246,.2); border:1px solid rgba(139,92,246,.3); color:#c4b5fd; }

    /* ─── CTA block ─── */
    .cta-block {
      border-radius: 30px; padding: 40px;
      border: 1px solid rgba(214,179,106,0.2);
      background: linear-gradient(180deg, rgba(214,179,106,0.08), rgba(255,255,255,0.02));
      box-shadow: var(--shadow);
      display: flex; align-items: center; justify-content: space-between; gap: 24px;
    }
    .cta-block h2 { margin: 0; font-size: clamp(1.5rem, 3vw, 2.4rem); letter-spacing: -0.04em; }
    .cta-block p { margin: 10px 0 0; color: var(--muted); line-height: 1.7; }
    .cta-block__actions { display: flex; gap: 12px; flex-shrink: 0; flex-wrap: wrap; }

    /* ─── Responsive ─── */
    @media (min-width: 561px) {
      .features { grid-template-columns: 1fr 1fr; }
      .feature__icon { width: 140px; height: 140px; }
    }
    @media (min-width: 861px) {
      .features { grid-template-columns: 1fr 1fr 1fr; }
      .feature__icon { width: 160px; height: 160px; }
    }
    @media (max-width: 860px) {
      .hero { grid-template-columns: 1fr; }
      .hero__visual { min-height: auto; }
      .pricing-grid { grid-template-columns: 1fr; max-width: 420px; }
      .audience { grid-template-columns: 1fr; }
      .cta-block { flex-direction: column; align-items: flex-start; }
      .template-preview-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 560px) {
      .cta-block { padding: 24px; }
      .template-preview-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>

<body>
  <Topbar rightLinks={[{ href: ROUTES.products, label: "← All products" }]} />

  <main class="shell">
    <div class="hero">
      <div>
        <span class="hero__badge" data-i18n="pf.badge">Real Estate · SaaS</span>
        <h1 data-i18n="pf.title">
          Property management
          <span>done with precision.</span>
        </h1>
        <p data-i18n="pf.desc">
          PropertyFlow is a premium platform for real estate agencies to manage listings,
          showcase properties, and deliver a polished client experience —
          with zero operational friction.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/contact/?product=propertyflow" data-i18n="pf.btn_demo">Request a demo</a>
          <a class="btn btn--ghost" href="/contact/" data-i18n="pf.btn_talk">Talk to us</a>
        </div>
      </div>

      <div class="hero__visual">
        <div class="hero__glow hero__glow--a"></div>
        <div class="hero__glow hero__glow--b"></div>
        <img src="/assets/newproperty.webp" alt="PropertyFlow interface preview" class="hero__img" />
      </div>
    </div>

    <!-- Features -->
    <section class="section">
      <div class="section__head">
        <span class="kicker" data-i18n="pf.features_kicker">What's inside</span>
        <h2 data-i18n="pf.features_title">Everything an agency needs.</h2>
        <p class="sub" data-i18n="pf.features_subtitle">From listing management to client-facing showcase — built for real workflows.</p>
      </div>

      <div class="features">
        <div class="feature">
          <div class="feature__icon"><img src="/assets/smartcatalogue.webp"></div>
          <h3 data-i18n="pf.f1_title">Smart Catalogue</h3>
          <p data-i18n="pf.f1_desc">Property grid with cover images, meta tags, featured badges and detail modals with full gallery.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><img src="/assets/livefilters.webp"></div>
          <h3 data-i18n="pf.f2_title">Live Filters</h3>
          <p data-i18n="pf.f2_desc">Search by name, neighbourhood or city. Filter by purpose (sale / rent), type and price range.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><img src="/assets/bilingual.webp"></div>
          <h3 data-i18n="pf.f3_title">Bilingual by Default</h3>
          <p data-i18n="pf.f3_desc">Full EN / PT-BR interface with one-click language toggle. Every string translated — zero hardcoded text.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><img src="/assets/supabase.webp"></div>
          <h3 data-i18n="pf.f4_title">Supabase-Ready</h3>
          <p data-i18n="pf.f4_desc">Clean data layer architected for a real backend. Swap the static data for live queries in minutes.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><img src="/assets/premiumvisual.webp"></div>
          <h3 data-i18n="pf.f5_title">Premium Visual System</h3>
          <p data-i18n="pf.f5_desc">Dark luxury aesthetic with glassmorphism, gold accents and VOLYNX design tokens throughout.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><img src="/assets/responsive.webp"></div>
          <h3 data-i18n="pf.f6_title">Fully Responsive</h3>
          <p data-i18n="pf.f6_desc">Mobile-first layouts. Filter bar, property grid and modal all adapt cleanly to any screen size.</p>
        </div>
      </div>
    </section>

    <!-- Stack -->
    <section class="section">
      <div class="section__head">
        <span class="kicker" data-i18n="pf.tech_kicker">Tech stack</span>
        <h2 data-i18n="pf.tech_title">Built on modern, reliable tools.</h2>
      </div>
      <div class="stack">
        <span class="stack__pill">React 19</span>
        <span class="stack__pill">Vite 7</span>
        <span class="stack__pill">Supabase</span>
        <span class="stack__pill">Custom i18n (EN / PT-BR)</span>
        <span class="stack__pill">CSS Custom Properties</span>
        <span class="stack__pill">Context API</span>
        <span class="stack__pill">Inter · Google Fonts</span>
      </div>
    </section>

    <!-- Who it's for -->
    <section class="section">
      <div class="section__head">
        <span class="kicker" data-i18n="pf.audience_kicker">Who it's for</span>
        <h2 data-i18n="pf.audience_title">Built for professionals who list, sell and rent.</h2>
      </div>
      <div class="audience">
        <div class="audience__card">
          <h3 data-i18n="pf.aud1_title">Real Estate Agencies</h3>
          <p data-i18n="pf.aud1_desc">Manage hundreds of listings with smart filters, bilingual support and a branded client portal.</p>
        </div>
        <div class="audience__card">
          <h3 data-i18n="pf.aud2_title">Independent Brokers</h3>
          <p data-i18n="pf.aud2_desc">A premium showcase that makes your portfolio look established and trustworthy from day one.</p>
        </div>
        <div class="audience__card">
          <h3 data-i18n="pf.aud3_title">Property Developers</h3>
          <p data-i18n="pf.aud3_desc">Launch projects with dedicated landing pages, gallery views and enquiry capture built in.</p>
        </div>
      </div>
    </section>

    <!-- Template Previews -->
    <section class="section" id="templates">
      <div class="section__head">
        <span class="kicker" data-i18n="pf.templates_kicker">Grid Templates</span>
        <h2 data-i18n="pf.templates_title">Pre-built layouts ready to plug into your site.</h2>
        <p class="sub" data-i18n="pf.templates_desc">Each template is a different property grid layout — optimized for different listing styles, screen sizes, and use cases. Pick your package, pay once, plug it in.</p>
      </div>
      <div class="template-preview-grid">
        <div class="tpl-card">
          <div class="tpl-preview tpl-preview--classic" aria-hidden="true">
            <div class="tpl-preview__topbar">
              <span class="tpl-dot tpl-dot--active"></span>
              <span class="tpl-dot"></span>
              <span class="tpl-dot"></span>
              <span class="tpl-pill"></span>
            </div>
            <div class="tpl-preview__classic-grid">
              <div class="tpl-mini">
                <span class="tpl-mini__media tpl-mini__media--tall"></span>
                <span class="tpl-mini__meta tpl-mini__meta--lg"></span>
                <span class="tpl-mini__meta tpl-mini__meta--md"></span>
              </div>
              <div class="tpl-mini">
                <span class="tpl-mini__media"></span>
                <span class="tpl-mini__meta tpl-mini__meta--md"></span>
                <span class="tpl-mini__meta tpl-mini__meta--sm"></span>
              </div>
              <div class="tpl-mini">
                <span class="tpl-mini__media"></span>
                <span class="tpl-mini__meta tpl-mini__meta--md"></span>
                <span class="tpl-mini__meta tpl-mini__meta--sm"></span>
              </div>
            </div>
          </div>
          <span data-i18n="pf.tpl_classic">Classic Grid</span>
        </div>
        <div class="tpl-card">
          <div class="tpl-preview tpl-preview--magazine" aria-hidden="true">
            <div class="tpl-preview__topbar">
              <span class="tpl-dot tpl-dot--active"></span>
              <span class="tpl-dot"></span>
              <span class="tpl-pill"></span>
            </div>
            <div class="tpl-preview__mag-layout">
              <div class="tpl-mini tpl-mini--feature">
                <span class="tpl-mini__media tpl-mini__media--tall"></span>
                <span class="tpl-mini__meta tpl-mini__meta--lg"></span>
                <span class="tpl-mini__meta tpl-mini__meta--md"></span>
              </div>
              <div class="tpl-preview__mag-stack">
                <div class="tpl-mini">
                  <span class="tpl-mini__media"></span>
                  <span class="tpl-mini__meta tpl-mini__meta--md"></span>
                  <span class="tpl-mini__meta tpl-mini__meta--sm"></span>
                </div>
                <div class="tpl-mini">
                  <span class="tpl-mini__media"></span>
                  <span class="tpl-mini__meta tpl-mini__meta--md"></span>
                  <span class="tpl-mini__meta tpl-mini__meta--sm"></span>
                </div>
              </div>
            </div>
          </div>
          <span data-i18n="pf.tpl_magazine">Magazine</span>
        </div>
        <div class="tpl-card">
          <div class="tpl-preview tpl-preview--compact" aria-hidden="true">
            <div class="tpl-preview__topbar">
              <span class="tpl-dot tpl-dot--active"></span>
              <span class="tpl-dot"></span>
              <span class="tpl-pill"></span>
            </div>
            <div class="tpl-preview__filterrow">
              <span class="tpl-chip tpl-chip--active"></span>
              <span class="tpl-chip"></span>
              <span class="tpl-chip"></span>
              <span class="tpl-chip"></span>
            </div>
            <div class="tpl-preview__list">
              <div class="tpl-row">
                <span class="tpl-row__thumb"></span>
                <span class="tpl-row__copy">
                  <span class="tpl-row__line tpl-row__line--lg"></span>
                  <span class="tpl-row__line tpl-row__line--md"></span>
                </span>
                <span class="tpl-row__price"></span>
              </div>
              <div class="tpl-row">
                <span class="tpl-row__thumb"></span>
                <span class="tpl-row__copy">
                  <span class="tpl-row__line tpl-row__line--lg"></span>
                  <span class="tpl-row__line tpl-row__line--sm"></span>
                </span>
                <span class="tpl-row__price"></span>
              </div>
              <div class="tpl-row">
                <span class="tpl-row__thumb"></span>
                <span class="tpl-row__copy">
                  <span class="tpl-row__line tpl-row__line--md"></span>
                  <span class="tpl-row__line tpl-row__line--sm"></span>
                </span>
                <span class="tpl-row__price"></span>
              </div>
            </div>
          </div>
          <span data-i18n="pf.tpl_compact">Compact List</span>
        </div>
        <div class="tpl-card tpl-card--pro">
          <div class="tpl-preview tpl-preview--gallery" aria-hidden="true">
            <div class="tpl-preview__topbar">
              <span class="tpl-dot tpl-dot--active"></span>
              <span class="tpl-dot"></span>
              <span class="tpl-pill"></span>
            </div>
            <div class="tpl-preview__gallery-layout">
              <div class="tpl-preview__hero-spot">
                <span class="tpl-preview__gallery-image"></span>
                <span class="tpl-preview__gallery-chip"></span>
              </div>
              <div class="tpl-preview__gallery-grid">
                <span class="tpl-gallery-card"></span>
                <span class="tpl-gallery-card"></span>
                <span class="tpl-gallery-card"></span>
              </div>
            </div>
          </div>
          <span data-i18n="pf.tpl_gallery">Gallery Hero</span>
          <span class="tpl-pro-tag">Pro+</span>
        </div>
        <div class="tpl-card tpl-card--pro">
          <div class="tpl-preview tpl-preview--split" aria-hidden="true">
            <div class="tpl-preview__topbar">
              <span class="tpl-dot tpl-dot--active"></span>
              <span class="tpl-pill"></span>
            </div>
            <div class="tpl-preview__split-layout">
              <div class="tpl-split__media">
                <span class="tpl-split__badge"></span>
                <span class="tpl-split__price"></span>
              </div>
              <div class="tpl-split__panel">
                <span class="tpl-split__bar tpl-split__bar--wide"></span>
                <span class="tpl-split__bar"></span>
                <span class="tpl-split__bar tpl-split__bar--mid"></span>
                <span class="tpl-split__bar tpl-split__bar--short"></span>
                <div class="tpl-split__stats">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>
            </div>
          </div>
          <span data-i18n="pf.tpl_split">Split View</span>
          <span class="tpl-pro-tag">Pro+</span>
        </div>
        <div class="tpl-card tpl-card--pro">
          <div class="tpl-preview tpl-preview--masonry" aria-hidden="true">
            <div class="tpl-preview__topbar">
              <span class="tpl-dot tpl-dot--active"></span>
              <span class="tpl-dot"></span>
              <span class="tpl-pill"></span>
            </div>
            <div class="tpl-masonry__col">
              <span class="tpl-masonry__card tpl-masonry__card--tall"></span>
              <span class="tpl-masonry__card tpl-masonry__card--short"></span>
            </div>
            <div class="tpl-masonry__col">
              <span class="tpl-masonry__card tpl-masonry__card--mid"></span>
              <span class="tpl-masonry__card tpl-masonry__card--tall tpl-masonry__card--accent"></span>
            </div>
            <div class="tpl-masonry__col">
              <span class="tpl-masonry__card tpl-masonry__card--short"></span>
              <span class="tpl-masonry__card tpl-masonry__card--mid"></span>
            </div>
          </div>
          <span data-i18n="pf.tpl_masonry">Masonry</span>
          <span class="tpl-pro-tag">Pro+</span>
        </div>
      </div>
      <p class="sub" style="margin-top:16px;font-size:.85rem;opacity:.5;" data-i18n="pf.templates_note">White-Label includes 15 templates with all variations. Preview all templates after purchase.</p>
    </section>

    <!-- Pricing -->
    <section class="section" id="pricing">
      <div class="section__head">
        <span class="kicker" data-i18n="pf.pricing_kicker">Pricing</span>
        <h2 data-i18n="pf.pricing_title">Buy once. Plug in. Done.</h2>
        <p class="sub" data-i18n="pf.pricing_desc">One-time purchase. Full source code. Ready-to-use grid templates. No subscription, no recurring fees.</p>
        <div class="vx-currency-bar" style="margin-top:20px;justify-content:flex-start;"></div>
      </div>
      <div class="pricing-grid">
        <div class="price-card">
          <span class="price-card__name" data-i18n="pf.plan1_name">Starter</span>
          <div class="price-card__price"><span data-price-gbp="£187" data-price-eur="€219" data-price-brl="R$1.290">£187</span></div>
          <div class="price-card__billing" data-i18n="pf.plan1_billing">One-time · 3 templates</div>
          <ul class="price-card__features">
            <li data-i18n="pf.plan1_f1">3 grid layout templates</li>
            <li data-i18n="pf.plan1_f2">Full React source code</li>
            <li data-i18n="pf.plan1_f3">Property catalogue + filters</li>
            <li data-i18n="pf.plan1_f4">Bilingual interface (EN/PT)</li>
            <li data-i18n="pf.plan1_f5">Responsive design</li>
            <li data-i18n="pf.plan1_f6">Static data mode</li>
          </ul>
          <button type="button" class="btn btn--ghost price-card__cta vx-checkout-btn" data-lookup="pf_starter" data-i18n="pf.plan1_cta">Get Starter</button>
        </div>
        <div class="price-card price-card--featured">
          <span class="price-card__name" data-i18n="pf.plan2_name">Professional</span>
          <div class="price-card__badge">Most popular</div>
          <div class="price-card__price"><span data-price-gbp="£447" data-price-eur="€519" data-price-brl="R$3.090">£447</span></div>
          <div class="price-card__billing" data-i18n="pf.plan2_billing">One-time · 6 templates</div>
          <ul class="price-card__features">
            <li data-i18n="pf.plan2_f1">6 grid layout templates</li>
            <li data-i18n="pf.plan2_f2">Everything in Starter</li>
            <li data-i18n="pf.plan2_f3">Supabase backend integration</li>
            <li data-i18n="pf.plan2_f4">Admin dashboard</li>
            <li data-i18n="pf.plan2_f5">Image gallery + modals</li>
            <li data-i18n="pf.plan2_f6">Enquiry capture system</li>
            <li data-i18n="pf.plan2_f7">Deployment guide</li>
          </ul>
          <button type="button" class="btn btn--primary price-card__cta vx-checkout-btn" data-lookup="pf_professional" data-i18n="pf.plan2_cta">Get Professional</button>
        </div>
        <div class="price-card">
          <span class="price-card__name" data-i18n="pf.plan3_name">White-Label</span>
          <div class="price-card__price"><span data-price-gbp="£897" data-price-eur="€1.039" data-price-brl="R$6.190">£897</span></div>
          <div class="price-card__billing" data-i18n="pf.plan3_billing">One-time · 15 templates</div>
          <ul class="price-card__features">
            <li data-i18n="pf.plan3_f1">15 grid layout templates</li>
            <li data-i18n="pf.plan3_f2">Everything in Professional</li>
            <li data-i18n="pf.plan3_f3">Custom branding starter kit</li>
            <li data-i18n="pf.plan3_f4">Priority onboarding</li>
            <li data-i18n="pf.plan3_f5">Data migration support</li>
            <li data-i18n="pf.plan3_f6">Dedicated support channel</li>
          </ul>
          <button type="button" class="btn btn--primary price-card__cta vx-checkout-btn" data-lookup="pf_white_label" data-i18n="pf.plan3_cta">Get White-Label</button>
        </div>
      </div>
      <p class="sub" style="margin-top:20px;font-size:.85rem;text-align:center;opacity:.5;" data-i18n="pf.pricing_note">All packages are one-time purchases. No free updates included. Template updates available at a fixed price — we'll contact you when new layouts are ready.</p>
    </section>

    <!-- CTA -->
    <section class="section">
      <div class="cta-block">
        <div>
          <h2 data-i18n="pf.cta_title">Ready to modernise your property showcase?</h2>
          <p data-i18n="pf.cta_desc">PropertyFlow comes ready to plug into your site. Select your package, pay once, and start showcasing properties in minutes.</p>
        </div>
        <div class="cta-block__actions">
          <a class="btn btn--primary" href="#pricing" data-i18n="pf.cta_btn1">Choose your package</a>
          <a class="btn btn--ghost" href="/contact/?product=propertyflow" data-i18n="pf.cta_btn2">Have questions?</a>
          <a class="btn btn--ghost" href={ROUTES.support + "?product=propertyflow&intent=launch"}>Need launch help?</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <PageWidgets hideUtilBar />
  <script is:inline src="/js/vx-currency.js"></script>
  <script is:inline src="/scripts/kit-checkout.js" defer></script>
</body>
</html>
