---
import PageWidgets from "../../../components/PageWidgets.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import Topbar from "../../../components/Topbar.astro";
import { ROUTES, checkoutHref } from "../../../data/routes";
const pageTitle = "PropertyFlow — VOLYNX Real Estate Platform";
const pageDescription = "Premium property management platform for real estate agencies. Smart catalogue, bilingual interface, filters, and Supabase-ready backend.";
---

<!DOCTYPE html>
<html lang="en" class="is-ready">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#07070b" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <script>document.documentElement.classList.add('js');</script>

  <style>
    :root {
      --bg: #07070b;
      --text: rgba(255,255,255,0.96);
      --muted: rgba(255,255,255,0.62);
      --gold: #d6b36a;
      --gold-soft: #f1deaa;
      --violet: #8b5cf6;
      --blue: #59c3ff;
      --line: rgba(255,255,255,0.10);
      --shadow: 0 20px 80px rgba(0,0,0,0.5);
      --radius: 26px;
      --max: 1100px;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      font-family: 'Inter', system-ui, sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(89,195,255,0.10), transparent 30%),
        radial-gradient(circle at 80% 15%, rgba(139,92,246,0.10), transparent 28%),
        linear-gradient(180deg, #05050a 0%, #090910 100%);
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }
    img { display: block; max-width: 100%; }

    /* ─── Topbar ─── */
    .topbar {
      position: sticky; top: 0; z-index: 50;
      backdrop-filter: blur(18px);
      background: rgba(7,7,11,0.6);
      border-bottom: 1px solid var(--line);
    }
    .topbar__inner {
      max-width: var(--max); margin: 0 auto;
      padding: 0 20px; min-height: 72px;
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
    }
    .brand {
      display: inline-flex; align-items: center; gap: 10px;
      font-weight: 800; font-size: 0.9rem; letter-spacing: 0.02em;
    }
    .brand__mark {
      width: 13px; height: 13px; border-radius: 999px; flex-shrink: 0;
      background: linear-gradient(135deg, var(--blue), var(--violet), var(--gold));
      box-shadow: 0 0 20px rgba(89,195,255,0.4);
    }
    .topbar__back {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 16px; border-radius: 999px;
      border: 1px solid var(--line);
      background: rgba(255,255,255,0.03);
      color: var(--muted); font-size: 0.84rem;
      transition: color 180ms, background 180ms;
    }
    .topbar__back:hover { color: var(--text); background: rgba(255,255,255,0.07); }

    /* ─── Shell ─── */
    .shell { max-width: var(--max); margin: 0 auto; padding: 0 20px 80px; }

    /* ─── Hero ─── */
    .hero {
      padding: 72px 0 56px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: center;
    }
    .hero__badge {
      display: inline-flex; width: fit-content;
      padding: 7px 14px; border-radius: 999px;
      border: 1px solid rgba(214,179,106,0.25);
      background: rgba(214,179,106,0.08);
      color: #ead8aa; font-size: 0.76rem;
      text-transform: uppercase; letter-spacing: 0.06em;
      margin-bottom: 20px;
    }
    .hero h1 {
      margin: 0;
      font-size: clamp(2.6rem, 5.5vw, 4.8rem);
      line-height: 0.96; letter-spacing: -0.05em;
    }
    .hero h1 span {
      display: block;
      background: linear-gradient(135deg, #fff, #e8d49a, #89d7ff);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .hero p {
      margin: 22px 0 0; max-width: 54ch;
      color: var(--muted); line-height: 1.8; font-size: 1.05rem;
    }
    .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

    .btn {
      display: inline-flex; align-items: center; justify-content: center;
      min-height: 48px; padding: 0 22px; border-radius: 999px;
      border: 1px solid var(--line); font-size: 0.9rem; font-weight: 500;
      transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
      cursor: pointer;
    }
    .btn:hover { transform: translateY(-1px); }
    .btn--primary {
      color: #0a0a0f;
      background: linear-gradient(135deg, var(--gold-soft), var(--gold));
      border-color: rgba(255,255,255,0.15);
    }
    .btn--ghost { background: rgba(255,255,255,0.04); color: var(--text); }

    /* ─── Hero visual ─── */
    .hero__visual {
      position: relative; min-height: 480px;
    }
    .hero__glow {
      position: absolute; border-radius: 999px;
      filter: blur(60px); opacity: 0.3; pointer-events: none;
    }
    .hero__glow--a { width: 200px; height: 200px; top: 0; right: 0; background: rgba(89,195,255,0.5); }
    .hero__glow--b { width: 200px; height: 200px; bottom: 30px; left: 0; background: rgba(139,92,246,0.4); }
    .hero__img {
      position: relative; z-index: 1;
      width: 100%; max-width: 560px; height: auto;
      object-fit: contain;
      border-radius: 0;
      border: 0;
      box-shadow: none;
      filter: drop-shadow(0 24px 60px rgba(89,195,255,.4)) drop-shadow(0 0 48px rgba(139,92,246,.3));
      transition: filter .6s ease;
      animation: pf-hero-float 6s ease-in-out infinite;
      will-change: transform;
    }
    .hero__img:hover {
      filter: drop-shadow(0 28px 72px rgba(89,195,255,.55)) drop-shadow(0 0 60px rgba(139,92,246,.42));
    }
    @keyframes pf-hero-float {
      0%, 100% { transform: translateY(0) scale(1); }
      50%      { transform: translateY(-14px) scale(1.012); }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero__img { animation: none; }
    }
    @media (min-width: 960px) {
      .hero__img { max-width: 680px; }
    }

    /* ─── Section ─── */
    .section { padding: 48px 0 24px; }
    .section__head { margin-bottom: 32px; }
    .kicker {
      display: inline-block; padding: 7px 14px; border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03);
      color: #e6d6a8; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.05em;
      margin-bottom: 14px;
    }
    .section h2 {
      margin: 0; font-size: clamp(1.8rem, 3.5vw, 3rem);
      line-height: 1.02; letter-spacing: -0.04em;
    }
    .section p.sub { margin: 14px 0 0; color: var(--muted); line-height: 1.8; max-width: 60ch; }

    /* ─── Feature grid ─── */
    .features {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .feature {
      border-radius: var(--radius); padding: 28px;
      border: 1px solid rgba(255,255,255,0.08);
      background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
      box-shadow: var(--shadow);
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }
    .feature__icon {
      width: 120px;
      height: 120px;
      flex-shrink: 0;
    }
    .feature__icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .feature h3 { margin: 0; font-size: 1rem; }

    .feature p { margin: 0; color: var(--muted); font-size: 0.9rem; line-height: 1.7; }

    /* ─── Stack row ─── */
    .stack { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
    .stack__pill {
      display: inline-flex; padding: 8px 14px; border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.04);
      color: var(--muted); font-size: 0.84rem;
    }

    /* ─── Who it's for ─── */
    .audience { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .audience__card {
      border-radius: var(--radius); padding: 24px;
      border: 1px solid rgba(255,255,255,0.08);
      background: linear-gradient(180deg, rgba(255,255,255,0.04), transparent);
    }
    .audience__card h3 { margin: 0 0 8px; font-size: 1rem; }
    .audience__card p { margin: 0; color: var(--muted); font-size: 0.88rem; line-height: 1.7; }

    /* ─── Pricing ─── */
    .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .price-card {
      border-radius: var(--radius); padding: 28px 24px;
      border: 1px solid rgba(255,255,255,0.08);
      background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
      display: flex; flex-direction: column;
    }
    .price-card--featured {
      border-color: rgba(214,179,106,0.35);
      background: linear-gradient(180deg, rgba(214,179,106,0.08), rgba(255,255,255,0.02));
      box-shadow: 0 0 40px rgba(214,179,106,0.08);
    }
    .price-card__name { font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 8px; }
    .price-card--featured .price-card__name { color: var(--gold); }
    .price-card__price { font-size: 2.2rem; font-weight: 800; letter-spacing: -0.04em; margin-bottom: 4px; }
    .price-card__billing { font-size: 0.82rem; color: var(--muted); margin-bottom: 20px; }
    .price-card__features { list-style: none; padding: 0; margin: 0 0 24px; flex: 1; }
    .price-card__features li { padding: 6px 0; font-size: 0.88rem; color: rgba(255,255,255,0.78); border-bottom: 1px solid rgba(255,255,255,0.05); }
    .price-card__features li::before { content: "✓ "; color: #34D399; font-weight: 700; }
    .price-card__cta { width: 100%; text-align: center; }

    .price-card__badge { position:absolute; top:12px; right:12px; padding:4px 10px; border-radius:999px; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; background:rgba(214,179,106,.2); border:1px solid rgba(214,179,106,.3); color:var(--gold); }
    .price-card--featured { position:relative; }

    /* ─── Template preview grid ─── */
    .template-preview-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }
    .tpl-card {
      border-radius: var(--radius);
      border: 1px solid rgba(255,255,255,.08);
      background: linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.02));
      padding: 16px;
      text-align: center;
      font-size: .85rem;
      font-weight: 600;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow);
    }
    .tpl-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,.04), transparent 42%);
      pointer-events: none;
    }
    .tpl-card--pro {
      border-color: rgba(214,179,106,.18);
      background: linear-gradient(180deg, rgba(214,179,106,.09), rgba(255,255,255,.02));
    }
    .tpl-card > span {
      position: relative;
      z-index: 1;
      display: block;
      margin-top: 10px;
      line-height: 1.25;
    }
    .tpl-card--pro .tpl-pro-tag {
      position: absolute;
      top: 12px;
      right: 12px;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: .65rem;
      font-weight: 700;
      background: rgba(139,92,246,.2);
      border: 1px solid rgba(139,92,246,.3);
      color: #c4b5fd;
      z-index: 2;
    }
    .tpl-preview {
      position: relative;
      min-height: 176px;
      padding: 12px;
      border-radius: 16px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: 10px;
      border: 1px solid rgba(255,255,255,.08);
      background:
        radial-gradient(circle at 18% 18%, rgba(255,255,255,.08), transparent 30%),
        linear-gradient(180deg, rgba(10,10,18,.95), rgba(15,15,24,.88));
    }
    .tpl-preview::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent, rgba(0,0,0,.1));
      pointer-events: none;
    }
    .tpl-preview__topbar,
    .tpl-preview__filterrow {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }
    .tpl-dot {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: rgba(255,255,255,.18);
    }
    .tpl-dot--active {
      background: var(--tpl-accent, #59c3ff);
      box-shadow: 0 0 0 4px rgba(89,195,255,.12);
    }
    .tpl-pill {
      margin-left: auto;
      width: 42px;
      height: 9px;
      border-radius: 999px;
      background: rgba(255,255,255,.12);
    }
    .tpl-chip {
      width: 36px;
      height: 16px;
      border-radius: 999px;
      background: rgba(255,255,255,.12);
    }
    .tpl-chip--active {
      background: rgba(214,179,106,.24);
      border: 1px solid rgba(214,179,106,.22);
    }
    .tpl-mini,
    .tpl-row,
    .tpl-masonry__card,
    .tpl-split__panel,
    .tpl-split__media,
    .tpl-preview__gallery-image,
    .tpl-gallery-card {
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,.08);
      background:
        linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.03));
      box-shadow: inset 0 1px 0 rgba(255,255,255,.04);
    }
    .tpl-mini,
    .tpl-row {
      position: relative;
      z-index: 1;
    }
    .tpl-mini {
      padding: 8px;
      display: flex;
      flex-direction: column;
      gap: 7px;
      min-height: 0;
    }
    .tpl-mini__media {
      display: block;
      height: 54px;
      border-radius: 10px;
      background: linear-gradient(135deg, rgba(89,195,255,.22), rgba(139,92,246,.16));
      border: 1px solid rgba(255,255,255,.06);
    }
    .tpl-mini__media--tall { height: 92px; }
    .tpl-mini__meta {
      display: block;
      height: 7px;
      border-radius: 999px;
      background: rgba(255,255,255,.16);
    }
    .tpl-mini__meta--lg { width: 78%; }
    .tpl-mini__meta--md { width: 56%; }
    .tpl-mini__meta--sm { width: 42%; }
    .tpl-mini--feature { grid-row: span 2; }

    .tpl-preview--classic { --tpl-accent: #59c3ff; }
    .tpl-preview__classic-grid {
      display: grid;
      grid-template-columns: 1.12fr .88fr;
      grid-auto-rows: minmax(0, 1fr);
      gap: 8px;
      flex: 1;
      min-height: 0;
    }
    .tpl-preview__classic-grid .tpl-mini:first-child {
      background: linear-gradient(180deg, rgba(89,195,255,.12), rgba(255,255,255,.03));
    }

    .tpl-preview--magazine { --tpl-accent: #d6b36a; }
    .tpl-preview__mag-layout {
      display: grid;
      grid-template-columns: 1.2fr .92fr;
      gap: 8px;
      flex: 1;
      min-height: 0;
    }
    .tpl-preview__mag-stack {
      display: grid;
      grid-template-rows: repeat(2, 1fr);
      gap: 8px;
      min-height: 0;
    }
    .tpl-preview--magazine .tpl-mini--feature {
      background: linear-gradient(180deg, rgba(214,179,106,.12), rgba(255,255,255,.03));
    }

    .tpl-preview--compact { --tpl-accent: #8b5cf6; }
    .tpl-preview__list {
      display: grid;
      gap: 8px;
      flex: 1;
      min-height: 0;
    }
    .tpl-row {
      display: grid;
      grid-template-columns: 48px minmax(0, 1fr) auto;
      gap: 8px;
      align-items: center;
      padding: 8px;
      border-radius: 12px;
      background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
    }
    .tpl-row__thumb {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,.07);
      background: linear-gradient(135deg, rgba(139,92,246,.22), rgba(89,195,255,.16));
    }
    .tpl-row__copy {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .tpl-row__line {
      display: block;
      height: 6px;
      border-radius: 999px;
      background: rgba(255,255,255,.14);
    }
    .tpl-row__line--lg { width: 82%; }
    .tpl-row__line--md { width: 56%; }
    .tpl-row__line--sm { width: 42%; }
    .tpl-row__price {
      width: 28px;
      height: 28px;
      border-radius: 999px;
      background: rgba(214,179,106,.22);
      border: 1px solid rgba(214,179,106,.16);
      flex-shrink: 0;
    }
    .tpl-preview__filterrow { flex-wrap: wrap; }

    .tpl-preview--gallery { --tpl-accent: #59c3ff; }
    .tpl-preview__gallery-layout {
      display: grid;
      grid-template-rows: 1.22fr .72fr;
      gap: 8px;
      flex: 1;
      min-height: 0;
    }
    .tpl-preview__hero-spot {
      position: relative;
      min-height: 0;
      overflow: hidden;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,.08);
      background:
        radial-gradient(circle at 18% 18%, rgba(89,195,255,.22), transparent 30%),
        linear-gradient(135deg, rgba(89,195,255,.16), rgba(214,179,106,.10));
    }
    .tpl-preview__gallery-image {
      position: absolute;
      inset: 0;
      border-radius: 0;
      background:
        linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02)),
        linear-gradient(135deg, rgba(89,195,255,.12), rgba(139,92,246,.14));
    }
    .tpl-preview__gallery-chip {
      position: absolute;
      left: 12px;
      bottom: 12px;
      width: 56px;
      height: 18px;
      border-radius: 999px;
      background: rgba(7,7,11,.72);
      border: 1px solid rgba(255,255,255,.14);
      z-index: 1;
    }
    .tpl-preview__gallery-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }
    .tpl-gallery-card {
      height: 36px;
      background:
        linear-gradient(135deg, rgba(89,195,255,.18), rgba(255,255,255,.05));
    }

    .tpl-preview--split { --tpl-accent: #d6b36a; }
    .tpl-preview__split-layout {
      display: grid;
      grid-template-columns: .96fr .88fr;
      gap: 8px;
      flex: 1;
      min-height: 0;
    }
    .tpl-split__media {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(circle at 20% 20%, rgba(214,179,106,.16), transparent 26%),
        linear-gradient(135deg, rgba(214,179,106,.18), rgba(89,195,255,.10));
    }
    .tpl-split__media::before {
      content: "";
      position: absolute;
      inset: 12px;
      border-radius: 11px;
      background:
        linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,.04)),
        linear-gradient(135deg, rgba(214,179,106,.10), rgba(89,195,255,.10));
      border: 1px solid rgba(255,255,255,.07);
    }
    .tpl-split__badge,
    .tpl-split__price {
      position: absolute;
      z-index: 1;
      border-radius: 999px;
      background: rgba(7,7,11,.72);
      border: 1px solid rgba(255,255,255,.14);
    }
    .tpl-split__badge {
      left: 12px;
      top: 12px;
      width: 38px;
      height: 16px;
    }
    .tpl-split__price {
      right: 12px;
      bottom: 12px;
      width: 44px;
      height: 18px;
    }
    .tpl-split__panel {
      padding: 10px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
    }
    .tpl-split__bar {
      display: block;
      height: 7px;
      border-radius: 999px;
      background: rgba(255,255,255,.15);
    }
    .tpl-split__bar--wide { width: 80%; }
    .tpl-split__bar--mid { width: 58%; }
    .tpl-split__bar--short { width: 40%; }
    .tpl-split__stats {
      margin-top: auto;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 6px;
    }
    .tpl-split__stats span {
      height: 24px;
      border-radius: 999px;
      background: rgba(214,179,106,.14);
      border: 1px solid rgba(214,179,106,.12);
    }

    .tpl-preview--masonry { --tpl-accent: #f1deaa; }
    .tpl-preview__masonry {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      flex: 1;
      min-height: 0;
    }
    .tpl-masonry__col {
      display: grid;
      gap: 8px;
      align-content: start;
      min-height: 0;
    }
    .tpl-masonry__card {
      border-radius: 12px;
      background:
