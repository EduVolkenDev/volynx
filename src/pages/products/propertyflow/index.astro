</head>

<body>
  <Topbar rightLinks={[{ href: ROUTES.products, label: "← All products" }]} />

  <main class="shell">
    <div class="hero">
      <div>
        <span class="hero__badge" data-i18n="pf.badge">Real Estate · SaaS</span>
        <h1 data-i18n="pf.title">
          Property management
          <span>done with precision.</span>
        </h1>
        <p data-i18n="pf.desc">
          PropertyFlow is a premium platform for real estate agencies to manage listings,
          showcase properties, and deliver a polished client experience —
          with zero operational friction.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/contact/?product=propertyflow" data-i18n="pf.btn_demo">Request a demo</a>
          <a class="btn btn--ghost" href={`${ROUTES.docs}#propertyflow`}>Preview buyer flow</a>
          <a class="btn btn--ghost" href="/contact/" data-i18n="pf.btn_talk">Talk to us</a>
        </div>
      </div>

      <div class="hero__visual">
        <div class="hero__glow hero__glow--a"></div>
        <div class="hero__glow hero__glow--b"></div>
        <img src="/assets/newproperty.webp" alt="PropertyFlow interface preview" class="hero__img" />
      </div>
    </div>

    <!-- Features -->
    <section class="section">
      <div class="section__head">
        <span class="kicker" data-i18n="pf.features_kicker">What's inside</span>
        <h2 data-i18n="pf.features_title">Everything an agency needs.</h2>
        <p class="sub" data-i18n="pf.features_subtitle">From listing management to client-facing showcase — built for real workflows.</p>
      </div>

      <div class="features">
        <div class="feature">
          <div class="feature__icon"><img src="/assets/smartcatalogue.webp"></div>
          <h3 data-i18n="pf.f1_title">Smart Catalogue</h3>
          <p data-i18n="pf.f1_desc">Property grid with cover images, meta tags, featured badges and detail modals with full gallery.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><img src="/assets/livefilters.webp"></div>
          <h3 data-i18n="pf.f2_title">Live Filters</h3>
          <p data-i18n="pf.f2_desc">Search by name, neighbourhood or city. Filter by purpose (sale / rent), type and price range.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><img src="/assets/bilingual.webp"></div>
          <h3 data-i18n="pf.f3_title">Bilingual by Default</h3>
          <p data-i18n="pf.f3_desc">Full EN / PT-BR interface with one-click language toggle. Every string translated — zero hardcoded text.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><img src="/assets/supabase.webp"></div>
          <h3 data-i18n="pf.f4_title">Supabase-Ready</h3>
          <p data-i18n="pf.f4_desc">Clean data layer architected for a real backend. Swap the static data for live queries in minutes.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><img src="/assets/premiumvisual.webp"></div>
          <h3 data-i18n="pf.f5_title">Premium Visual System</h3>
          <p data-i18n="pf.f5_desc">Dark luxury aesthetic with glassmorphism, gold accents and VOLYNX design tokens throughout.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><img src="/assets/responsive.webp"></div>
          <h3 data-i18n="pf.f6_title">Fully Responsive</h3>
          <p data-i18n="pf.f6_desc">Mobile-first layouts. Filter bar, property grid and modal all adapt cleanly to any screen size.</p>
        </div>
      </div>
    </section>

    <!-- Stack -->
    <section class="section">
      <div class="section__head">
        <span class="kicker" data-i18n="pf.tech_kicker">Tech stack</span>
        <h2 data-i18n="pf.tech_title">Built on modern, reliable tools.</h2>
      </div>
      <div class="stack">
        <span class="stack__pill">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="2.5" fill="currentColor"/><ellipse cx="12" cy="12" rx="10" ry="4" stroke="currentColor" stroke-width="1.5"/><ellipse cx="12" cy="12" rx="10" ry="4" stroke="currentColor" stroke-width="1.5" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" stroke="currentColor" stroke-width="1.5" transform="rotate(120 12 12)"/></svg>
          React 19
        </span>
        <span class="stack__pill">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 22 L2 5 L8 5 L12 14 L16 5 L22 5 Z" fill="currentColor" opacity=".4"/><path d="M12 22 L2 5 L8 5 L12 14 L16 5 L22 5 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          Vite 7
        </span>
        <span class="stack__pill">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M11 2 L4 14 L11 14 L11 22 L20 10 L13 10 L13 2 Z" fill="currentColor" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
          Supabase
        </span>
        <span class="stack__pill">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 5h7M3 9h5M3 13h7M14 5h7M14 9h5M14 13h7M6 19h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          Custom i18n (EN / PT-BR)
        </span>
        <span class="stack__pill">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4h16v3H4zM4 10.5h16v3H4zM4 17h16v3H4z" fill="currentColor" opacity=".25"/><path d="M4 4h16v3H4zM4 10.5h16v3H4zM4 17h16v3H4z" stroke="currentColor" stroke-width="1.4"/></svg>
          CSS Custom Properties
        </span>
        <span class="stack__pill">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 3 v18 M3 12 h18" stroke="currentColor" stroke-width="1.2" opacity=".4"/></svg>
          Context API
        </span>
        <span class="stack__pill">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h3v16M16 4h3v16M11 4h2v16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          Inter · Google Fonts
        </span>
      </div>
    </section>

    <!-- Who it's for — scroll-progressive cards -->
    <section class="section" id="audience">
      <div class="section__head">
        <span class="kicker" data-i18n="pf.audience_kicker">Who it's for</span>
        <h2 data-i18n="pf.audience_title">Built for professionals who list, sell and rent.</h2>
        <p class="sub" data-i18n="pf.audience_sub">Each card opens as you scroll past — keep going to see who PropertyFlow was built for.</p>
      </div>
      <div class="audience" data-pf-audience>
        <div class="audience__card" data-pf-audience-card>
          <div class="audience__card__head">
            <span class="audience__card__icon">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 21V10l9-6 9 6v11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 21v-7h6v7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <h3 data-i18n="pf.aud1_title">Real Estate Agencies</h3>
            <svg class="audience__card__chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="audience__card__body">
            <p data-i18n="pf.aud1_desc">Manage hundreds of listings with smart filters, bilingual support and a branded client portal.</p>
            <ul class="audience__card__body__list">
              <li data-i18n="pf.aud1_b1">Centralised catalogue for the entire team</li>
              <li data-i18n="pf.aud1_b2">Filter by purpose, type, neighbourhood, price band</li>
              <li data-i18n="pf.aud1_b3">Branded client portal with EN/PT toggle</li>
            </ul>
          </div>
        </div>
        <div class="audience__card" data-pf-audience-card>
          <div class="audience__card__head">
            <span class="audience__card__icon">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.6"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </span>
            <h3 data-i18n="pf.aud2_title">Independent Brokers</h3>
            <svg class="audience__card__chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="audience__card__body">
            <p data-i18n="pf.aud2_desc">A premium showcase that makes your portfolio look established and trustworthy from day one.</p>
            <ul class="audience__card__body__list">
              <li data-i18n="pf.aud2_b1">Look like a multi-agent shop on day one</li>
              <li data-i18n="pf.aud2_b2">Embed enquiry capture without third-party forms</li>
              <li data-i18n="pf.aud2_b3">Premium dark aesthetic that sets you apart</li>
            </ul>
          </div>
        </div>
        <div class="audience__card" data-pf-audience-card>
          <div class="audience__card__head">
            <span class="audience__card__icon">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 21V5l8-2v18M12 21V9l8-2v14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 9h2M7 13h2M7 17h2M15 12h2M15 16h2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            </span>
            <h3 data-i18n="pf.aud3_title">Property Developers</h3>
            <svg class="audience__card__chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="audience__card__body">
            <p data-i18n="pf.aud3_desc">Launch projects with dedicated landing pages, gallery views and enquiry capture built in.</p>
            <ul class="audience__card__body__list">
              <li data-i18n="pf.aud3_b1">Dedicated landing per project / development</li>
              <li data-i18n="pf.aud3_b2">Gallery hero + floorplans + neighbourhood map</li>
              <li data-i18n="pf.aud3_b3">Capture leads without leaving the page</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Template Previews -->
    <section class="section" id="templates">
      <div class="section__head">
        <span class="kicker" data-i18n="pf.templates_kicker">Grid Templates</span>
        <h2 data-i18n="pf.templates_title">Pre-built layouts ready to plug into your site.</h2>
        <p class="sub" data-i18n="pf.templates_desc">Each layout is engineered for a specific kind of property and a specific kind of buyer. Click any preview to see the live layout, what it's best for, and which package it ships in.</p>
      </div>

      <div class="templates-intro">
        <div class="templates-intro__col">
          <strong data-i18n="pf.templates_intro_a_title">Inventory-heavy listings</strong>
          <span data-i18n="pf.templates_intro_a_desc">Classic, Compact, and Map layouts move buyers through hundreds of properties without overwhelming them. Best for full agencies and developers with deep portfolios.</span>
        </div>
        <div class="templates-intro__col">
          <strong data-i18n="pf.templates_intro_b_title">Premium / boutique stock</strong>
          <span data-i18n="pf.templates_intro_b_desc">Magazine, Gallery Hero, Split View and Story Mode let high-ticket properties breathe. Best for luxury brokers selling on lifestyle, not just floor area.</span>
        </div>
        <div class="templates-intro__col">
          <strong data-i18n="pf.templates_intro_c_title">Discovery-first browsing</strong>
          <span data-i18n="pf.templates_intro_c_desc">Masonry, Tabbed, Carousel and Map-Pin layouts reward exploration. Best for mixed inventory or developments where buyers don't yet know what they want.</span>
        </div>
      </div>

      <div class="template-preview-grid" id="templatesGrid">
        <!-- Classic — Starter -->
        <div class="tpl-card" data-pf-template
             data-tpl-name="Classic Grid"
             data-tpl-tier="Starter"
             data-tpl-best="High-volume agencies, multi-segment portfolios"
             data-tpl-property-type="Standard residential, mid-market apartments, urban inventory"
             data-tpl-when="When buyers know what they want — neighbourhood, beds, budget. Lets them scan dozens of options fast."
             data-tpl-strength="Information density without visual fatigue. Cover image + meta + price reads in under a second per row."
             data-tpl-package="Starter">
          <div class="tpl-preview tpl-preview--classic" aria-hidden="true">
            <div class="tpl-preview__topbar">
              <span class="tpl-dot tpl-dot--active"></span>
              <span class="tpl-dot"></span>
              <span class="tpl-dot"></span>
              <span class="tpl-pill"></span>
