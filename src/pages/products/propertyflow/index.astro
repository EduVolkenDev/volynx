  <script is:inline>
    (function () {
      'use strict';

      // ── Audience scroll-progressive cards ─────────────────────────────
      // Cards open as their centre crosses the viewport's middle band, and
      // close again as the user scrolls past. IntersectionObserver with a
      // 40% / 60% rootMargin gives a comfortable "open while reading" zone.
      var audienceCards = document.querySelectorAll('[data-pf-audience-card]');
      if (audienceCards.length && 'IntersectionObserver' in window) {
        var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) {
          audienceCards.forEach(function (c) { c.classList.add('is-open'); });
        } else {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-open');
              } else {
                entry.target.classList.remove('is-open');
              }
            });
          }, {
            // Top + bottom 40% are excluded → only the middle 20% triggers.
            // That makes each card "open" exactly while the user is on it.
            rootMargin: '-40% 0px -40% 0px',
            threshold: 0,
          });
          audienceCards.forEach(function (c) { io.observe(c); });
        }

        // Tap-to-toggle on mobile / for keyboard users — click the head to
        // expand without waiting for scroll position.
        audienceCards.forEach(function (card) {
          var head = card.querySelector('.audience__card__head');
          if (head) {
            head.style.cursor = 'pointer';
            head.addEventListener('click', function () {
              card.classList.toggle('is-open');
            });
          }
        });
      }

      // ── Templates: see-more toggle ────────────────────────────────────
      var tplToggle = document.getElementById('tplToggle');
      var tplExtra = document.getElementById('tplExtra');
      if (tplToggle && tplExtra) {
        tplToggle.addEventListener('click', function () {
          var isHidden = tplExtra.hasAttribute('hidden');
          if (isHidden) {
            tplExtra.removeAttribute('hidden');
            tplToggle.classList.add('is-open');
            tplToggle.setAttribute('aria-expanded', 'true');
            // Swap label
            var label = tplToggle.querySelector('[data-tpl-toggle-label]');
            if (label) {
              label.innerHTML = '<span class="i18n-en">Hide extra layouts</span><span class="i18n-pt">Esconder layouts extras</span>';
            }
          } else {
            tplExtra.setAttribute('hidden', '');
            tplToggle.classList.remove('is-open');
            tplToggle.setAttribute('aria-expanded', 'false');
            var label2 = tplToggle.querySelector('[data-tpl-toggle-label]');
            if (label2) {
              label2.innerHTML = '<span class="i18n-en">See 4 more layouts</span><span class="i18n-pt">Ver mais 4 layouts</span>';
            }
          }
        });
      }

      // ── Layout preview modal ──────────────────────────────────────────
      var modal = document.getElementById('pfModal');
      var modalClose = document.getElementById('pfModalClose');
      var modalVisual = document.getElementById('pfModalVisual');
      var modalTitle = document.getElementById('pfModalTitle');
      var modalTier = document.getElementById('pfModalTier');
      var modalLead = document.getElementById('pfModalLead');
      var modalBest = document.getElementById('pfModalBest');
      var modalProperty = document.getElementById('pfModalProperty');
      var modalWhen = document.getElementById('pfModalWhen');
      var modalWhy = document.getElementById('pfModalWhy');
      var modalPackage = document.getElementById('pfModalPackage');
      var modalPackagePt = document.getElementById('pfModalPackagePt');

      function openModal(card) {
        if (!modal) return;
        var name = card.getAttribute('data-tpl-name') || 'Layout';
        var tier = card.getAttribute('data-tpl-tier') || 'Starter';
        var best = card.getAttribute('data-tpl-best') || '';
        var property = card.getAttribute('data-tpl-property-type') || '';
        var when = card.getAttribute('data-tpl-when') || '';
        var why = card.getAttribute('data-tpl-strength') || '';
        var pkg = card.getAttribute('data-tpl-package') || tier;

        modalTitle.textContent = name;
        modalTier.textContent = tier;
        modalTier.className = 'pf-modal__tier' + (tier === 'Starter' ? ' pf-modal__tier--core' : '');
        modalLead.textContent = why;
        modalBest.textContent = best;
        modalProperty.textContent = property;
        modalWhen.textContent = when;
        modalWhy.textContent = why;
        modalPackage.textContent = pkg;
        modalPackagePt.textContent = pkg;

        // Clone the actual preview into the modal so the buyer sees the real
        // layout structure at a much larger size — same elements, same gradients.
        var preview = card.querySelector('.tpl-preview');
        if (preview && modalVisual) {
          modalVisual.innerHTML = '';
          var clone = preview.cloneNode(true);
          clone.setAttribute('aria-hidden', 'true');
          modalVisual.appendChild(clone);
        }

        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('pf-modal-locked');
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('pf-modal-locked');
      }

      document.querySelectorAll('[data-pf-template]').forEach(function (card) {
        card.addEventListener('click', function (e) {
          // Don't intercept the Pro+ tag if it's a link in the future
          if (e.target.closest('a, button')) return;
          openModal(card);
        });
        // Keyboard support
        card.setAttribute('tabindex', '0');
        card.setAttribute('role', 'button');
        card.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openModal(card);
          }
        });
      });

      if (modalClose) modalClose.addEventListener('click', closeModal);
      if (modal) {
        modal.addEventListener('click', function (e) {
          if (e.target === modal) closeModal();
        });
      }
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal && modal.classList.contains('is-open')) closeModal();
      });
    })();
  </script>
</body>
