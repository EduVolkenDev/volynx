---
import PageWidgets from "../../../components/PageWidgets.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import Topbar from "../../../components/Topbar.astro";
import { ROUTES } from "../../../data/routes";
const pageTitle = "PropertyFlow — VOLYNX Real Estate Platform";
const pageDescription = "Premium property management platform for real estate agencies. Smart catalogue, bilingual interface, filters, and Supabase-ready backend.";
---

<!DOCTYPE html>
<html lang="en" class="is-ready">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#07070b" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <script>document.documentElement.classList.add('js');</script>

  <style>
    :root {
      --bg: #07070b;
      --text: rgba(255,255,255,0.96);
      --muted: rgba(255,255,255,0.62);
      --gold: #d6b36a;
      --gold-soft: #f1deaa;
      --violet: #8b5cf6;
      --blue: #59c3ff;
      --line: rgba(255,255,255,0.10);
      --shadow: 0 20px 80px rgba(0,0,0,0.5);
      --radius: 26px;
      --max: 1100px;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      font-family: 'Inter', system-ui, sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(89,195,255,0.10), transparent 30%),
        radial-gradient(circle at 80% 15%, rgba(139,92,246,0.10), transparent 28%),
        linear-gradient(180deg, #05050a 0%, #090910 100%);
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }
    img { display: block; max-width: 100%; }

    /* ─── Topbar ─── */
    .topbar {
      position: sticky; top: 0; z-index: 50;
      backdrop-filter: blur(18px);
      background: rgba(7,7,11,0.6);
      border-bottom: 1px solid var(--line);
    }
    .topbar__inner {
      max-width: var(--max); margin: 0 auto;
      padding: 0 20px; min-height: 72px;
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
    }
    .brand {
      display: inline-flex; align-items: center; gap: 10px;
      font-weight: 800; font-size: 0.9rem; letter-spacing: 0.02em;
    }
    .brand__mark {
      width: 13px; height: 13px; border-radius: 999px; flex-shrink: 0;
      background: linear-gradient(135deg, var(--blue), var(--violet), var(--gold));
      box-shadow: 0 0 20px rgba(89,195,255,0.4);
    }
    .topbar__back {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 16px; border-radius: 999px;
      border: 1px solid var(--line);
      background: rgba(255,255,255,0.03);
      color: var(--muted); font-size: 0.84rem;
      transition: color 180ms, background 180ms;
    }
    .topbar__back:hover { color: var(--text); background: rgba(255,255,255,0.07); }

    /* ─── Shell ─── */
    .shell { max-width: var(--max); margin: 0 auto; padding: 0 20px 80px; }

    /* ─── Hero ─── */
    .hero {
      padding: 72px 0 56px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: center;
    }
    .hero__badge {
      display: inline-flex; width: fit-content;
      padding: 7px 14px; border-radius: 999px;
      border: 1px solid rgba(214,179,106,0.25);
      background: rgba(214,179,106,0.08);
      color: #ead8aa; font-size: 0.76rem;
      text-transform: uppercase; letter-spacing: 0.06em;
      margin-bottom: 20px;
    }
    .hero h1 {
      margin: 0;
      font-size: clamp(2.6rem, 5.5vw, 4.8rem);
      line-height: 0.96; letter-spacing: -0.05em;
    }
    .hero h1 span {
      display: block;
      background: linear-gradient(135deg, #fff, #e8d49a, #89d7ff);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .hero p {
      margin: 22px 0 0; max-width: 54ch;
      color: var(--muted); line-height: 1.8; font-size: 1.05rem;
    }
    .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

    .btn {
      display: inline-flex; align-items: center; justify-content: center;
      min-height: 48px; padding: 0 22px; border-radius: 999px;
      border: 1px solid var(--line); font-size: 0.9rem; font-weight: 500;
      transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
      cursor: pointer;
    }
    .btn:hover { transform: translateY(-1px); }
    .btn--primary {
      color: #0a0a0f;
      background: linear-gradient(135deg, var(--gold-soft), var(--gold));
      border-color: rgba(255,255,255,0.15);
    }
    .btn--ghost { background: rgba(255,255,255,0.04); color: var(--text); }

    /* ─── Hero visual ─── */
    .hero__visual {
      position: relative; min-height: 480px;
    }
    .hero__glow {
      position: absolute; border-radius: 999px;
      filter: blur(60px); opacity: 0.3; pointer-events: none;
    }
    .hero__glow--a { width: 200px; height: 200px; top: 0; right: 0; background: rgba(89,195,255,0.5); }
    .hero__glow--b { width: 200px; height: 200px; bottom: 30px; left: 0; background: rgba(139,92,246,0.4); }
    .hero__img {
      position: relative; z-index: 1;
      width: 100%; height: 100%; object-fit: cover;
      border-radius: 30px;
      border: 1px solid rgba(255,255,255,0.08);
      box-shadow: var(--shadow);
    }

    /* ─── Section ─── */
    .section { padding: 48px 0 24px; }
    .section__head { margin-bottom: 32px; }
    .kicker {
      display: inline-block; padding: 7px 14px; border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03);
      color: #e6d6a8; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.05em;
      margin-bottom: 14px;
    }
    .section h2 {
      margin: 0; font-size: clamp(1.8rem, 3.5vw, 3rem);
      line-height: 1.02; letter-spacing: -0.04em;
    }
    .section p.sub { margin: 14px 0 0; color: var(--muted); line-height: 1.8; max-width: 60ch; }

    /* ─── Feature grid ─── */
    .features {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .feature {
      border-radius: var(--radius); padding: 28px;
      border: 1px solid rgba(255,255,255,0.08);
      background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
      box-shadow: var(--shadow);
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }
    .feature__icon {
      width: 120px;
      height: 120px;
      flex-shrink: 0;
    }
    .feature__icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .feature h3 { margin: 0; font-size: 1rem; }

    .feature p { margin: 0; color: var(--muted); font-size: 0.9rem; line-height: 1.7; }

    /* ─── Stack row ─── */
    .stack { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
    .stack__pill {
      display: inline-flex; padding: 8px 14px; border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.04);
      color: var(--muted); font-size: 0.84rem;
    }

    /* ─── Who it's for ─── */
    .audience { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .audience__card {
      border-radius: var(--radius); padding: 24px;
      border: 1px solid rgba(255,255,255,0.08);
      background: linear-gradient(180deg, rgba(255,255,255,0.04), transparent);
    }
    .audience__card h3 { margin: 0 0 8px; font-size: 1rem; }
    .audience__card p { margin: 0; color: var(--muted); font-size: 0.88rem; line-height: 1.7; }

    /* ─── Pricing ─── */
    .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .price-card {
      border-radius: var(--radius); padding: 28px 24px;
      border: 1px solid rgba(255,255,255,0.08);
      background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
      display: flex; flex-direction: column;
    }
    .price-card--featured {
      border-color: rgba(214,179,106,0.35);
      background: linear-gradient(180deg, rgba(214,179,106,0.08), rgba(255,255,255,0.02));
      box-shadow: 0 0 40px rgba(214,179,106,0.08);
    }
    .price-card__name { font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 8px; }
    .price-card--featured .price-card__name { color: var(--gold); }
    .price-card__price { font-size: 2.2rem; font-weight: 800; letter-spacing: -0.04em; margin-bottom: 4px; }
    .price-card__billing { font-size: 0.82rem; color: var(--muted); margin-bottom: 20px; }
    .price-card__features { list-style: none; padding: 0; margin: 0 0 24px; flex: 1; }
    .price-card__features li { padding: 6px 0; font-size: 0.88rem; color: rgba(255,255,255,0.78); border-bottom: 1px solid rgba(255,255,255,0.05); }
    .price-card__features li::before { content: "✓ "; color: #34D399; font-weight: 700; }
    .price-card__cta { width: 100%; text-align: center; }

    .price-card__badge { position:absolute; top:12px; right:12px; padding:4px 10px; border-radius:999px; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; background:rgba(214,179,106,.2); border:1px solid rgba(214,179,106,.3); color:var(--gold); }
    .price-card--featured { position:relative; }

    /* ─── Template preview grid ─── */
    .template-preview-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:14px; }
    .tpl-card { border-radius:var(--radius); border:1px solid rgba(255,255,255,.08); background:rgba(255,255,255,.03); padding:16px; text-align:center; font-size:.85rem; font-weight:600; position:relative; }
    .tpl-card--pro { opacity:.6; }
    .tpl-thumb { height:120px; border-radius:12px; margin-bottom:10px; }
    .tpl-thumb--1 { background:linear-gradient(135deg, rgba(214,179,106,.15), rgba(255,255,255,.05)); background-image:repeating-linear-gradient(0deg, rgba(255,255,255,.06) 0px, rgba(255,255,255,.06) 30px, transparent 30px, transparent 40px), repeating-linear-gradient(90deg, rgba(255,255,255,.06) 0px, rgba(255,255,255,.06) 45%, transparent 45%, transparent 55%); }
    .tpl-thumb--2 { background:linear-gradient(180deg, rgba(214,179,106,.12), rgba(139,92,246,.08)); background-image:linear-gradient(90deg, rgba(255,255,255,.04) 50%, transparent 50%); }
    .tpl-thumb--3 { background:linear-gradient(135deg, rgba(59,130,246,.1), rgba(255,255,255,.03)); background-image:repeating-linear-gradient(0deg, rgba(255,255,255,.05) 0px, rgba(255,255,255,.05) 20px, transparent 20px, transparent 28px); }
    .tpl-thumb--4 { background:linear-gradient(180deg, rgba(214,179,106,.2) 40%, rgba(255,255,255,.03) 40%); }
    .tpl-thumb--5 { background:linear-gradient(90deg, rgba(214,179,106,.12) 50%, rgba(139,92,246,.08) 50%); }
    .tpl-thumb--6 { background:linear-gradient(135deg, rgba(214,179,106,.08), rgba(59,130,246,.08)); background-image:repeating-linear-gradient(0deg, rgba(255,255,255,.05) 0px, rgba(255,255,255,.05) 25px, transparent 25px, transparent 30px), repeating-linear-gradient(90deg, rgba(255,255,255,.05) 0px, rgba(255,255,255,.05) 30%, transparent 30%, transparent 36%); }
    .tpl-pro-tag { position:absolute; top:8px; right:8px; padding:2px 8px; border-radius:999px; font-size:.65rem; font-weight:700; background:rgba(139,92,246,.2); border:1px solid rgba(139,92,246,.3); color:#c4b5fd; }

    /* ─── CTA block ─── */
    .cta-block {
      border-radius: 30px; padding: 40px;
      border: 1px solid rgba(214,179,106,0.2);
      background: linear-gradient(180deg, rgba(214,179,106,0.08), rgba(255,255,255,0.02));
      box-shadow: var(--shadow);
      display: flex; align-items: center; justify-content: space-between; gap: 24px;
    }
    .cta-block h2 { margin: 0; font-size: clamp(1.5rem, 3vw, 2.4rem); letter-spacing: -0.04em; }
    .cta-block p { margin: 10px 0 0; color: var(--muted); line-height: 1.7; }
    .cta-block__actions { display: flex; gap: 12px; flex-shrink: 0; flex-wrap: wrap; }

    /* ─── Responsive ─── */
    @media (min-width: 561px) {
      .features { grid-template-columns: 1fr 1fr; }
      .feature__icon { width: 140px; height: 140px; }
    }
    @media (min-width: 861px) {
      .features { grid-template-columns: 1fr 1fr 1fr; }
      .feature__icon { width: 160px; height: 160px; }
    }
    @media (max-width: 860px) {
      .hero { grid-template-columns: 1fr; }
      .hero__visual { min-height: auto; }
      .pricing-grid { grid-template-columns: 1fr; max-width: 420px; }
      .audience { grid-template-columns: 1fr; }
      .cta-block { flex-direction: column; align-items: flex-start; }
      .template-preview-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 560px) {
      .cta-block { padding: 24px; }
      .template-preview-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>

<body>
  <Topbar rightLinks={[{ href: ROUTES.products, label: "← All products" }]} />

  <main class="shell">
    <div class="hero">
      <div>
        <span class="hero__badge" data-i18n="pf.badge">Real Estate · SaaS</span>
        <h1 data-i18n="pf.title">
          Property management
          <span>done with precision.</span>
        </h1>
        <p data-i18n="pf.desc">
          PropertyFlow is a premium platform for real estate agencies to manage listings,
          showcase properties, and deliver a polished client experience —
          with zero operational friction.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/contact/?product=propertyflow" data-i18n="pf.btn_demo">Request a demo</a>
          <a class="btn btn--ghost" href="/contact/" data-i18n="pf.btn_talk">Talk to us</a>
        </div>
      </div>

      <div class="hero__visual">
        <div class="hero__glow hero__glow--a"></div>
        <div class="hero__glow hero__glow--b"></div>
        <img src="/assets/propertyflow2.webp" alt="PropertyFlow interface preview" class="hero__img" />
      </div>
    </div>

    <!-- Features -->
    <section class="section">
      <div class="section__head">
        <span class="kicker" data-i18n="pf.features_kicker">What's inside</span>
        <h2 data-i18n="pf.features_title">Everything an agency needs.</h2>
        <p class="sub" data-i18n="pf.features_subtitle">From listing management to client-facing showcase — built for real workflows.</p>
      </div>

      <div class="features">
        <div class="feature">
          <div class="feature__icon"><img src="/assets/smartcatalogue.webp"></div>
          <h3 data-i18n="pf.f1_title">Smart Catalogue</h3>
          <p data-i18n="pf.f1_desc">Property grid with cover images, meta tags, featured badges and detail modals with full gallery.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><img src="/assets/livefilters.webp"></div>
          <h3 data-i18n="pf.f2_title">Live Filters</h3>
          <p data-i18n="pf.f2_desc">Search by name, neighbourhood or city. Filter by purpose (sale / rent), type and price range.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><img src="/assets/bilingual.webp"></div>
          <h3 data-i18n="pf.f3_title">Bilingual by Default</h3>
          <p data-i18n="pf.f3_desc">Full EN / PT-BR interface with one-click language toggle. Every string translated — zero hardcoded text.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><img src="/assets/supabase.webp"></div>
          <h3 data-i18n="pf.f4_title">Supabase-Ready</h3>
          <p data-i18n="pf.f4_desc">Clean data layer architected for a real backend. Swap the static data for live queries in minutes.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><img src="/assets/premiumvisual.webp"></div>
          <h3 data-i18n="pf.f5_title">Premium Visual System</h3>
          <p data-i18n="pf.f5_desc">Dark luxury aesthetic with glassmorphism, gold accents and VOLYNX design tokens throughout.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><img src="/assets/responsive.webp"></div>
          <h3 data-i18n="pf.f6_title">Fully Responsive</h3>
          <p data-i18n="pf.f6_desc">Mobile-first layouts. Filter bar, property grid and modal all adapt cleanly to any screen size.</p>
        </div>
      </div>
    </section>

    <!-- Stack -->
    <section class="section">
      <div class="section__head">
        <span class="kicker" data-i18n="pf.tech_kicker">Tech stack</span>
        <h2 data-i18n="pf.tech_title">Built on modern, reliable tools.</h2>
      </div>
      <div class="stack">
        <span class="stack__pill">React 19</span>
        <span class="stack__pill">Vite 7</span>
        <span class="stack__pill">Supabase</span>
        <span class="stack__pill">Custom i18n (EN / PT-BR)</span>
        <span class="stack__pill">CSS Custom Properties</span>
        <span class="stack__pill">Context API</span>
        <span class="stack__pill">Inter · Google Fonts</span>
      </div>
    </section>

    <!-- Who it's for -->
    <section class="section">
      <div class="section__head">
        <span class="kicker" data-i18n="pf.audience_kicker">Who it's for</span>
        <h2 data-i18n="pf.audience_title">Built for professionals who list, sell and rent.</h2>
      </div>
      <div class="audience">
        <div class="audience__card">
          <h3 data-i18n="pf.aud1_title">Real Estate Agencies</h3>
          <p data-i18n="pf.aud1_desc">Manage hundreds of listings with smart filters, bilingual support and a branded client portal.</p>
        </div>
        <div class="audience__card">
          <h3 data-i18n="pf.aud2_title">Independent Brokers</h3>
          <p data-i18n="pf.aud2_desc">A premium showcase that makes your portfolio look established and trustworthy from day one.</p>
        </div>
        <div class="audience__card">
          <h3 data-i18n="pf.aud3_title">Property Developers</h3>
          <p data-i18n="pf.aud3_desc">Launch projects with dedicated landing pages, gallery views and enquiry capture built in.</p>
        </div>
      </div>
    </section>

    <!-- Template Previews -->
    <section class="section" id="templates">
      <div class="section__head">
        <span class="kicker" data-i18n="pf.templates_kicker">Grid Templates</span>
        <h2 data-i18n="pf.templates_title">Pre-built layouts ready to plug into your site.</h2>
        <p class="sub" data-i18n="pf.templates_desc">Each template is a different property grid layout — optimized for different listing styles, screen sizes, and use cases. Pick your package, pay once, plug it in.</p>
      </div>
      <div class="template-preview-grid">
        <div class="tpl-card"><div class="tpl-thumb tpl-thumb--1"></div><span>Classic Grid</span></div>
        <div class="tpl-card"><div class="tpl-thumb tpl-thumb--2"></div><span>Magazine</span></div>
        <div class="tpl-card"><div class="tpl-thumb tpl-thumb--3"></div><span>Compact List</span></div>
        <div class="tpl-card tpl-card--pro"><div class="tpl-thumb tpl-thumb--4"></div><span>Gallery Hero</span><span class="tpl-pro-tag">Pro+</span></div>
        <div class="tpl-card tpl-card--pro"><div class="tpl-thumb tpl-thumb--5"></div><span>Split View</span><span class="tpl-pro-tag">Pro+</span></div>
        <div class="tpl-card tpl-card--pro"><div class="tpl-thumb tpl-thumb--6"></div><span>Masonry</span><span class="tpl-pro-tag">Pro+</span></div>
      </div>
      <p class="sub" style="margin-top:16px;font-size:.85rem;opacity:.5;" data-i18n="pf.templates_note">Enterprise includes 15 templates with all variations. Preview all templates after purchase.</p>
    </section>

    <!-- Pricing -->
    <section class="section" id="pricing">
      <div class="section__head">
        <span class="kicker" data-i18n="pf.pricing_kicker">Pricing</span>
        <h2 data-i18n="pf.pricing_title">Buy once. Plug in. Done.</h2>
        <p class="sub" data-i18n="pf.pricing_desc">One-time purchase. Full source code. Ready-to-use grid templates. No subscription, no recurring fees.</p>
        <div class="vx-currency-bar" style="margin-top:20px;justify-content:flex-start;"></div>
      </div>
      <div class="pricing-grid">
        <div class="price-card">
          <span class="price-card__name" data-i18n="pf.plan1_name">Starter</span>
          <div class="price-card__price"><span data-price-gbp="£149" data-price-eur="€179" data-price-brl="R$1.049">£149</span></div>
          <div class="price-card__billing" data-i18n="pf.plan1_billing">One-time · 3 templates</div>
          <ul class="price-card__features">
            <li data-i18n="pf.plan1_f1">3 grid layout templates</li>
            <li data-i18n="pf.plan1_f2">Full React source code</li>
            <li data-i18n="pf.plan1_f3">Property catalogue + filters</li>
            <li data-i18n="pf.plan1_f4">Bilingual interface (EN/PT)</li>
            <li data-i18n="pf.plan1_f5">Responsive design</li>
            <li data-i18n="pf.plan1_f6">Static data mode</li>
          </ul>
          <button type="button" class="btn btn--ghost price-card__cta pf-checkout" data-lookup="pf_starter" data-i18n="pf.plan1_cta">Buy Starter — £149</button>
        </div>
        <div class="price-card price-card--featured">
          <span class="price-card__name" data-i18n="pf.plan2_name">Professional</span>
          <div class="price-card__badge">Most popular</div>
          <div class="price-card__price"><span data-price-gbp="£349" data-price-eur="€419" data-price-brl="R$2.449">£349</span></div>
