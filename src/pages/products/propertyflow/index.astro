          </div>
          <span class="tpl-card__hint" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>

        <!-- Compact List — Starter -->
        <div class="tpl-card" data-pf-template
             data-tpl-name="Compact List"
             data-tpl-tier="Starter"
             data-tpl-best="High-density inventory, rentals, commercial"
             data-tpl-property-type="Rentals, commercial spaces, dense urban listings"
             data-tpl-when="When the buyer is filtering and comparing — beds, area, price — not browsing for inspiration."
