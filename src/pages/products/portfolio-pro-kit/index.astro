  <script is:inline>
    (function () {
      var root = document.documentElement;
      var fire = function () { requestAnimationFrame(function () { root.classList.add('is-ready'); }); };
      if (document.readyState === 'complete') fire();
      else window.addEventListener('load', fire, { once: true });
    })();
  </script>
