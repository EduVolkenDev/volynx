            <p class="single-modal-kicker">${format} · ${escHtml(category)}</p>
            <h3 class="single-modal-title">${escHtml(label)}</h3>
            <p class="single-modal-text">${bodyCopy}</p>
            <div class="single-modal-price-row">
              <span class="single-modal-price"><strong>${escHtml(item.priceVX || "24 VX")}</strong><small>VX</small></span>
              ${(() => { const m = localizedMoney(item.checkoutLookup) || item.money; return m ? `<span class="single-modal-price single-modal-price--cash"><strong>${escHtml(m)}</strong><small>${L === "pt" ? "dinheiro" : "cash"}</small></span>` : ""; })()}
            </div>
            <div class="single-modal-actions">
              <button class="modal-btn modal-btn--primary" type="button" id="singleCheckoutBtn">${buyCopy}</button>
              <a class="modal-btn modal-btn--ghost" href="${requestHref}">${L === "pt" ? "Pedir manualmente" : "Manual request"}</a>
              ${hasPack ? `<button class="modal-btn modal-btn--secondary" type="button" id="singleRelatedPackBtn">${packCopy}</button>` : ""}
              <button class="modal-btn modal-btn--ghost" type="button" id="singleCloseBtn">${closeCopy}</button>
            </div>
          </div>
        </div>
      `, "single");

      document.getElementById("singleCheckoutBtn")?.addEventListener("click", (event) => {
        startIconCheckout(checkoutLookup, event.currentTarget as HTMLElement, item);
      });
      document.getElementById("singleRelatedPackBtn")?.addEventListener("click", () => {
        showPackModal(relatedCollection);
      });
      document.getElementById("singleCloseBtn")?.addEventListener("click", closeModal);
    }

    function showPackModal(collection: string) {
      const icons = allIcons.filter((icon) => icon.collection === collection);
      if (!icons.length) return;
      const L = storeLang();
      const freeCount = icons.filter((icon) => icon.plan === "free").length;
      const isFree = freeCount === icons.length;
      const firstCategory = CATEGORY_CONFIG.find(c => c.key === icons[0]?.category)?.label || icons[0]?.category || "Icon Pack";
      const packPrice = packPriceForCollection(collection, icons);
      const planLabel = isFree
        ? (L === "pt" ? "Pack grátis" : "Free pack")
        : collection.toLowerCase().includes("hyper")
          ? (L === "pt" ? "Pack Hyper 5000px" : "Hyper 5000px pack")
          : freeCount === 0
            ? (L === "pt" ? "Pack premium" : "Premium pack")
            : (L === "pt" ? "Pack misto" : "Mixed pack");
      const packMoney = localizedMoney(packPrice.lookup);
      const priceLabel = isFree
        ? (L === "pt" ? "Grátis com cadastro" : "Free with signup")
        : (packPrice.vx && packMoney ? `${packPrice.vx} · ${packMoney}` : packPrice.label);
      const modalIcons = icons.map((icon, index) => `
        <button type="button" class="pack-modal-icon" style="${collectionStyle(collection)}" data-pack-icon-index="${index}">
          <img src="${icon.path}" alt="" loading="lazy" />
          ${isPremiumIcon(icon) ? '<span>Premium</span>' : '<span>Free</span>'}
        </button>
      `).join("");

      openModal(`
        <div class="pack-modal-shell">
          <header class="pack-modal-header" style="${collectionStyle(collection)}">
            <div>
              <p class="pack-modal-kicker">${escHtml(planLabel)} · ${escHtml(firstCategory)}</p>
              <h3 class="pack-modal-title">${escHtml(collection)}</h3>
              <p class="pack-modal-meta">${icons.length.toLocaleString(L === "pt" ? "pt-BR" : "en")} ${L === "pt" ? "ícones no pack. Toque em qualquer ícone para ver preço avulso e prévia maior." : "icons in this pack. Tap any icon to see the single price and a larger preview."}</p>
            </div>
            <div class="pack-modal-price">${escHtml(priceLabel)}</div>
          </header>
          <div class="pack-modal-grid">
            ${modalIcons}
          </div>
          <footer class="pack-modal-footer">
            <button class="modal-btn modal-btn--primary" type="button" id="packCheckoutBtn">${L === "pt" ? "Comprar pack" : "Buy pack"}</button>
            <button class="modal-btn modal-btn--ghost" type="button" id="packCloseBtn">${L === "pt" ? "Continuar vendo packs" : "Keep browsing packs"}</button>
          </footer>
        </div>
      `, "pack");

      document.getElementById("packCheckoutBtn")?.addEventListener("click", (event) => {
        startIconCheckout(packPrice.lookup, event.currentTarget as HTMLElement, {
          label: collection,
          collection,
        });
      });
      document.querySelectorAll<HTMLButtonElement>(".pack-modal-icon").forEach((button) => {
        button.addEventListener("click", () => {
          const index = Number(button.dataset.packIconIndex || 0);
          showSingleIconModal(iconToSingleItem(icons[index]));
        });
      });
      document.getElementById("packCloseBtn")?.addEventListener("click", closeModal);
    }

    // ===== PREVIEW MODAL =====
    function showPreviewModal(icon: any) {
      const isPremium = icon.plan === "premium" || icon.plan === "paid";
      const closeLabel = storeLang() === "pt" ? "Fechar" : "Close";
      openModal(`
        <div style="display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 15% 15%,rgba(124,77,255,.18),transparent 30%),radial-gradient(circle at 85% 15%,rgba(79,195,247,.2),transparent 28%),linear-gradient(145deg,rgba(255,255,255,.98),rgba(243,247,255,.94));border:1px solid rgba(124,77,255,.12);border-radius:18px;padding:24px;margin-bottom:1.25rem;min-height:180px;box-shadow:inset 0 1px 0 rgba(255,255,255,.8);">
          <img src="${icon.path}" alt="" style="width:160px;height:160px;object-fit:contain;display:block;" />
        </div>
        <p style="color:rgba(255,255,255,.5);font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:1.25rem;">${escHtml(icon.category)}</p>
        <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;">
          <button id="previewDownloadBtn" style="padding:.75rem 2rem;background:linear-gradient(135deg,#00f0ff,#0066ff);color:#000;font-weight:700;border-radius:10px;border:none;font-size:.9rem;cursor:pointer;">
            ${isPremium ? storeText("openPack") : storeText("download")}
          </button>
          <button id="previewCancelBtn" style="padding:.75rem 1.25rem;background:transparent;color:rgba(255,255,255,.6);border:1px solid rgba(255,255,255,.15);border-radius:10px;font-size:.9rem;cursor:pointer;">${closeLabel}</button>
        </div>
      `);
      document.getElementById("previewDownloadBtn")?.addEventListener("click", () => {
        closeModal();
        if (isPremium) {
          openPack(icon.collection || icon.category);
          return;
        }
        handleDownload(icon);
      });
      document.getElementById("previewCancelBtn")?.addEventListener("click", closeModal);
    }

    window.addEventListener("vx:lang-changed", () => {
      updateGalleryHeading();
      renderGallery();
      renderCollections();
    });

    // Re-render price-bearing UI whenever the user flips GBP/EUR/BRL.
    // Without this, Single Icons keeps the currency it was rendered with on
    // page load — and the checkout, which reads checkoutCurrency() at click
    // time, can diverge (display shows £ while checkout charges €).
    window.addEventListener("vx:currency-changed", () => {
      renderSingleIcons();
      renderCollections();
      // If a modal is open (single-icon, pack, featured), close it so the
      // next open picks the new currency. Cheaper + safer than patching in
      // place.
      const openModalEl = document.querySelector(".vx-modal.is-open") as HTMLElement | null;
      if (openModalEl) {
        const closeBtn = document.getElementById("vxModalClose") as HTMLButtonElement | null;
        closeBtn?.click();
      }
    });

    // ===== DOWNLOAD LOGIC =====
    function handleDownload(icon: any) {
      if (icon.plan === "premium" || icon.plan === "paid") {
        showPremiumModal(icon);
        return;
      }
      // Free icon — requires login
      if (!isLoggedIn) {
        showLoginModal(icon);
        return;
      }
      triggerDownload(icon);
    }

    function triggerDownload(icon: any) {
      const a = document.createElement("a");
      a.href = icon.path;
      a.download = icon.file || icon.name || "icon";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      const prefix = storeLang() === "pt" ? "Baixado" : "Downloaded";
      showNotification(`${prefix}: ${icon.name || icon.file || "icon"}`);
    }

    // ===== LOAD MORE =====
    document.getElementById("loadMoreBtn")?.addEventListener("click", () => {
      visibleCount += initialPageSize();
      renderGallery();
    });

    // ===== FILTERS =====
    function initFilters() {
      const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
      filterBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          filterBtns.forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          currentCollection = null;
          currentFilter = btn.dataset.filter ?? "all";
          visibleCount = initialPageSize();
          updateGalleryHeading();
          renderGallery();
        });
      });

      const singleFormatBtns = document.querySelectorAll<HTMLButtonElement>(".single-format-btn");
      singleFormatBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          singleFormatBtns.forEach(item => item.classList.remove("active"));
          btn.classList.add("active");
          singleFormatFilter = btn.dataset.singleFormat || "all";
          renderSingleIcons();
        });
      });

      // Featured Icons → open inline-SVG preview modal (NOT scroll to gallery)
      document.querySelectorAll<HTMLButtonElement>(".featured-card[data-featured-filter]").forEach(card => {
        card.addEventListener("click", (e) => {
          // Ignore clicks that originated from the "show more" button or toggle
          if ((e.target as HTMLElement).closest(".featured-toggle")) return;
          showFeaturedPreviewModal(card);
        });
      });

      // Featured Icons toggle (show 12 initially, expand to all 40)
      const featuredGrid = document.getElementById("featuredGrid");
      const featuredToggleBtn = document.getElementById("featuredToggleBtn");
      if (featuredGrid && featuredToggleBtn) {
        const labelEl = featuredToggleBtn.querySelector(".featured-toggle-label") as HTMLElement | null;
        const LABELS = {
          en: { show: "Show all featured icons", hide: "Show fewer" },
          pt: { show: "Ver todos os ícones em destaque", hide: "Ver menos" },
        };
        const syncLabel = () => {
          if (!labelEl) return;
          const expanded = featuredGrid.dataset.expanded === "true";
          labelEl.textContent = expanded ? LABELS[storeLang()].hide : LABELS[storeLang()].show;
        };
        syncLabel();
        featuredToggleBtn.addEventListener("click", () => {
          const expanded = featuredGrid.dataset.expanded === "true";
          featuredGrid.dataset.expanded = expanded ? "false" : "true";
          featuredToggleBtn.setAttribute("aria-expanded", String(!expanded));
          syncLabel();
        });
        window.addEventListener("vx:lang-changed", syncLabel);
      }
    }

    // ===== MODAL =====
    function initModal() {
      document.getElementById("vxModalClose")?.addEventListener("click", closeModal);
      document.getElementById("vxModal")?.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).id === "vxModal") closeModal();
      });
    }

    function openModal(html: string, variant = "default") {
      const modal = document.getElementById("vxModal") as HTMLElement;
      const panel = document.getElementById("vxModalPanel") as HTMLElement;
      const content = document.getElementById("vxModalContent") as HTMLElement;
      window.clearTimeout(Number(modal.dataset.closeTimer || 0));
      content.innerHTML = html;
      panel.className = `vx-modal-panel vx-modal-panel--${variant}`;
      modal.setAttribute("aria-hidden", "false");
      modal.style.display = "flex";
      document.body.classList.add("vx-modal-open");
      requestAnimationFrame(() => modal.classList.add("is-open"));
    }

    function closeModal() {
      const modal = document.getElementById("vxModal") as HTMLElement;
      const content = document.getElementById("vxModalContent") as HTMLElement;
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("vx-modal-open");
      const timer = window.setTimeout(() => {
        modal.style.display = "none";
        content.innerHTML = "";
      }, 220);
      modal.dataset.closeTimer = String(timer);
    }

