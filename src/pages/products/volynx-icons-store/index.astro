        <button type="button" class="featured-card purple" data-featured-filter="purple">
          <div class="featured-svg-wrap">
            <svg width="54" height="54" viewBox="0 0 54 54" fill="none" aria-hidden="true">
              <defs><radialGradient id="fbg8" cx="50%" cy="30%" r="70%"><stop offset="0%" stop-color="#160a2a"/><stop offset="100%" stop-color="#080412"/></radialGradient></defs>
              <rect width="54" height="54" rx="14" fill="url(#fbg8)"/>
              <path d="M27 15 C20 15 15 20 15 27 C15 34 20 39 27 39 C34 39 39 34 39 27" stroke="#ce93d8" stroke-width="1.4" fill="none" stroke-linecap="round"/>
              <path d="M27 19 C22 19 19 23 19 27 C19 31 22 35 27 35 C32 35 35 31 35 27" stroke="#7c4dff" stroke-width="1.4" fill="none" stroke-linecap="round"/>
              <path d="M27 23 C24 23 23 25 23 27 C23 29 24 31 27 31 C30 31 31 29 31 27 C31 25 30 23 27 23" stroke="#ce93d8" stroke-width="1.3" fill="none" stroke-linecap="round"/>
              <circle cx="27" cy="27" r="2" fill="#7c4dff"/>
