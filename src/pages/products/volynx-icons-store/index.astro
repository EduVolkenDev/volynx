---
import "../../../styles/icons-store.css";
import PageWidgets from "../../../components/PageWidgets.astro";
const pageTitle = "Volynx Icons Store - Premium SVG Icons & Design Assets";
const pageDescription = "Premium SVG icons and design assets for developers. Build faster, design better.";
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content="/assets/volynx-icon.webp" />
  <meta property="og:url" content="https://volynx.world/products/volynx-icons-store/" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/assets/site.webmanifest" />
</head>

<body class="fx-grid">
  <nav class="nav-header">
    <div class="nav-container">
      <!-- Logo -->
      <div class="brand">
        <div class="brand-icon">
          <img src="/assets/volynx-icon.webp" alt="Volynx Icon" aria-hidden="true" />
        </div>
        <div class="brand-name">
          <img src="/assets/wordmark.webp" alt="Volynx Wordmark" aria-hidden="true" />
        </div>
      </div>

      <!-- Desktop Navigation -->
      <div class="nav-links desktop-nav">
        <a href="/products/volynx-icons-store/" class="nav-link active">Gallery</a>
        <a href="#" class="nav-link" id="collectionsBtn">Collections</a>
        <a href="#" class="nav-link" id="favoritesBtn">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
          Favorites
        </a>
        <a href="#" class="btn-upgrade" id="upgradeBtn">Upgrade</a>
      </div>

      <!-- Auth Buttons -->
      <div class="nav-actions">
        <a class="btn btn-primary" id="signInBtn" href="/login/?return=/products/volynx-icons-store/">Sign In</a>

        <!-- User Menu (hidden by default) -->
        <div class="user-menu" id="userMenu" style="display: none;">
          <button class="user-btn" id="userMenuBtn">
            <svg class="user-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <span id="userName">User</span>
          </button>

          <div class="dropdown-menu" id="dropdownMenu">
            <div class="dropdown-item user-info">
              <div class="user-details">
                <span class="user-name-full" id="userNameFull">John Doe</span>
                <span class="user-email" id="userEmail">john@example.com</span>
              </div>
            </div>
            <div class="dropdown-divider"></div>
            <a href="#" class="dropdown-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
              </svg>
              My Favorites
            </a>
            <a href="#" class="dropdown-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                <line x1="3" y1="6" x2="21" y2="6" />
                <path d="M16 10a4 4 0 0 1-8 0" />
              </svg>
              Upgrade Plan
            </a>
            <div class="dropdown-divider"></div>
            <button class="dropdown-item logout-btn" id="logoutBtn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
              </svg>
              Logout
            </button>
          </div>
        </div>

        <!-- Mobile Menu Button -->
        <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle menu">
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
      <a href="/products/volynx-icons-store/" class="mobile-menu-item active">Gallery</a>
      <a href="#" class="mobile-menu-item" id="mobileCollectionsBtn">Collections</a>
      <a href="#" class="mobile-menu-item" id="mobileFavoritesBtn">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
        </svg>
        Favorites
      </a>
      <a href="#" class="mobile-menu-item upgrade" id="mobileUpgradeBtn">Upgrade to Pro</a>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="main-content">
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="hero-brand">
          <img src="/assets/long-logo-icons.webp" class="hero-long-logo" alt="Volynx Icons Store" />
        </div>
        <h1 class="hero-title">
          Premium Design Assets
          <span class="gradient-text">For Modern Developers</span>
        </h1>
        <p class="hero-description">
          Thousands of premium SVG icons, UI kits, and design assets.
          Download instantly and build beautiful products faster.
        </p>
        <div class="hero-actions">
          <a href="#gallery" class="btn btn-primary btn-lg">Browse Gallery</a>
          <a href="#" class="btn btn-secondary btn-lg" id="pricingBtn">View Pricing</a>
        </div>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-number">3K+</span>
            <span class="stat-label">Icons</span>
          </div>
          <div class="stat">
            <span class="stat-number">100+</span>
            <span class="stat-label">Collections</span>
          </div>
          <div class="stat">
            <span class="stat-number">10K+</span>
            <span class="stat-label">Downloads</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Gallery Section -->
    <section class="gallery-section" id="gallery">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Featured Icons</h2>
          <div class="filters">
            <button class="filter-btn active" data-filter="all">All</button>
            <button class="filter-btn" data-filter="pink">Pink</button>
            <button class="filter-btn" data-filter="futuristic">Futuristic</button>
            <button class="filter-btn" data-filter="green">Green</button>
            <button class="filter-btn" data-filter="simple">Simple</button>
            <button class="filter-btn" data-filter="draw">Draw</button>
            <button class="filter-btn" data-filter="metal">Metal</button>
            <button class="filter-btn" data-filter="blue">Blue</button>
            <button class="filter-btn" data-filter="purple">Purple</button>
          </div>
        </div>

        <div class="gallery-grid" id="galleryGrid">
          <!-- icons generated by JS -->
        </div>

        <div class="load-more-container">
          <button class="btn btn-secondary" id="loadMoreBtn" style="display:none;">Load More</button>
        </div>
      </div>
    </section>

    <!-- Collections Preview -->
    <section class="collections-preview">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Popular Collections</h2>
          <a href="#" class="view-all" id="viewAllBtn">
            View All
            <svg viewBox="0 0 20 20" fill="currentColor">
              <path d="M7 3l7 7-7 7" />
            </svg>
          </a>
        </div>

        <div class="collections-grid" id="collectionsGrid"></div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-box">
          <h2 class="cta-title">Ready to upgrade?</h2>
          <p class="cta-description">
            Get unlimited downloads, premium collections, and commercial license.
          </p>
          <a href="#" class="btn btn-primary btn-lg" id="ctaPricingBtn">View Pricing Plans</a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <div class="footer-brand">
            <div class="brand-icon-footer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 2 7 12 12 22 7 12 2" />
                <polyline points="2 17 12 22 22 17" />
                <polyline points="2 12 12 17 22 12" />
              </svg>
            </div>
            <span class="brand-name-footer">Volynx Icons Store</span>
          </div>
          <p class="footer-description">
            Premium SVG icons and design assets for developers. Build faster, design better.
          </p>
        </div>

        <div class="footer-col">
          <h4 class="footer-title">Product</h4>
          <ul class="footer-links">
            <li><a href="/products/volynx-icons-store/">Gallery</a></li>
            <li><a href="#">Collections</a></li>
            <li><a href="#">Pricing</a></li>
            <li><a href="#">Documentation</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-title">Support</h4>
          <ul class="footer-links">
            <li><a href="#">Help Center</a></li>
            <li><a href="#">API Reference</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="#">License</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-title">Company</h4>
          <ul class="footer-links">
            <li><a href="/about/">About</a></li>
            <li><a href="#">Blog</a></li>
            <li><a href="#">Careers</a></li>
            <li><a href="#">Press Kit</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p class="footer-copyright">© <span id="y"></span> Volynx Icons Store. All rights reserved.</p>
        <div class="footer-legal">
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="/disclaimer/">License</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Download modal for premium/login gate -->
  <div id="vxModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.75);backdrop-filter:blur(8px);align-items:center;justify-content:center;">
    <div style="background:#0d0d18;border:1px solid rgba(255,255,255,.15);border-radius:20px;padding:2rem;max-width:420px;width:90%;text-align:center;position:relative;">
      <button id="vxModalClose" style="position:absolute;top:1rem;right:1rem;background:none;border:none;color:#fff;font-size:1.25rem;cursor:pointer;">✕</button>
      <div id="vxModalContent"></div>
    </div>
  </div>


  <script>
    // ===== STATE =====
    let isLoggedIn = false;
    let currentUser: { name: string; email: string } | null = null;
    let currentFilter = "all";

    let allIcons: any[] = [];
    let visibleCount = 48;

    // ===== INIT =====
    document.addEventListener("DOMContentLoaded", async () => {
      initNavigation();
      initModal();
      initFilters();
      checkAuth();

      const y = document.getElementById("y");
      if (y) y.textContent = String(new Date().getFullYear());

      await loadCatalog();
    });

    // ===== NAVIGATION =====
    function initNavigation() {
      const mobileMenuBtn = document.getElementById("mobileMenuBtn");
      const mobileMenu = document.getElementById("mobileMenu");
      const userMenuBtn = document.getElementById("userMenuBtn");
      const dropdownMenu = document.getElementById("dropdownMenu");

      if (mobileMenuBtn && mobileMenu) {
        mobileMenuBtn.addEventListener("click", () => {
          mobileMenuBtn.classList.toggle("active");
          mobileMenu.classList.toggle("show");
        });
      }

      if (userMenuBtn && dropdownMenu) {
        userMenuBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          dropdownMenu.classList.toggle("show");
        });
        document.addEventListener("click", (e) => {
          if (!userMenuBtn.contains(e.target as Node) && !dropdownMenu.contains(e.target as Node)) {
            dropdownMenu.classList.remove("show");
          }
        });
      }

      const signInBtn = document.getElementById("signInBtn");
      const logoutBtn = document.getElementById("logoutBtn");
      if (logoutBtn) logoutBtn.addEventListener("click", logout);
    }

    // ===== CATALOG =====
    async function loadCatalog() {
      try {
        const res = await fetch("/assets/icons-store/catalog.json");
        allIcons = await res.json();
        renderGallery();
        updateStats();
      } catch (e) {
        console.error("Erro ao carregar catálogo:", e);
      }
    }

    function updateStats() {
      const total = allIcons.length;
      const statEls = document.querySelectorAll<HTMLElement>(".stat-number");
      if (statEls[0]) statEls[0].textContent = total + "+";
      if (statEls[1]) statEls[1].textContent = "23";
      if (statEls[2]) statEls[2].textContent = "10K+";
      renderCollections();
    }

    // ===== FEATURED COLLECTIONS =====
    // Uses CATEGORY_CONFIG defined later; rendered after catalog loads
    function renderCollections() {
      const grid = document.getElementById("collectionsGrid");
      if (!grid || !allIcons.length) return;

      CATEGORY_CONFIG.forEach(col => {
        const icons = allIcons.filter(i => i.category === col.key).slice(0, 4);
        if (!icons.length) return;
        const allCatIcons = allIcons.filter(i => i.category === col.key);
        const count = allCatIcons.length;
        const freeCount = allCatIcons.filter(i => i.plan === "free").length;
        const isPremium = freeCount === 0;

        const card = document.createElement("div");
        card.className = "collection-card" + (isPremium ? " collection-card--premium" : "");
        card.style.cursor = "pointer";

        const previews = icons.map(i =>
          `<div class="preview-icon" style="background:#fff;border-radius:8px;display:flex;align-items:center;justify-content:center;padding:4px;">
            <img src="${i.path}" alt="" style="width:100%;height:100%;object-fit:contain;" loading="lazy" />
          </div>`
        ).join("");

        card.innerHTML = `
          ${isPremium ? `<span style="position:absolute;top:12px;right:12px;font-size:9px;font-weight:800;letter-spacing:.07em;padding:3px 8px;border-radius:99px;background:linear-gradient(135deg,#8b5cf6,#ff006e);color:#fff;text-transform:uppercase;">PRO</span>` : ""}
          <div class="collection-preview">${previews}</div>
          <h3 class="collection-title">${col.label}</h3>
          <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
            <p class="collection-count">${count} ícones</p>
            ${isPremium
            ? '<span style="font-size:.75rem;font-weight:700;color:rgba(200,150,255,.9);">PREMIUM</span>'
            : freeCount === count
              ? '<span style="font-size:.75rem;color:rgba(0,240,255,.7);font-weight:600;">FREE</span>'
              : '<span style="font-size:.75rem;color:rgba(255,183,77,.8);font-weight:600;">MIXED</span>'}
          </div>
        `;
        card.style.position = "relative";

        card.addEventListener("click", () => {
          currentFilter = col.key;
          document.querySelectorAll<HTMLButtonElement>(".filter-btn").forEach(b => {
            b.classList.toggle("active", b.dataset.filter === col.key);
          });
          visibleCount = 48;
          renderGallery();
          document.getElementById("gallery")?.scrollIntoView({ behavior: "smooth" });
        });

        grid.appendChild(card);
      });
    }

    // ===== CATEGORY CONFIG =====
    const CATEGORY_CONFIG = [
      { key: "pink",       label: "Pink Icons",       color: "#f48fb1", glow: "rgba(244,143,177,0.2)" },
      { key: "futuristic", label: "Futuristic Icons",  color: "#00f0ff", glow: "rgba(0,240,255,0.2)"   },
      { key: "green",      label: "Green Icons",       color: "#66bb6a", glow: "rgba(102,187,106,0.2)" },
      { key: "simple",     label: "Simple Icons",      color: "#e8eaf6", glow: "rgba(232,234,246,0.15)" },
      { key: "draw",       label: "Draw Icons",        color: "#ffb74d", glow: "rgba(255,183,77,0.2)"  },
      { key: "metal",      label: "Metal Icons",       color: "#90a4ae", glow: "rgba(144,164,174,0.2)" },
      { key: "blue",       label: "Blue Icons",        color: "#4fc3f7", glow: "rgba(79,195,247,0.2)"  },
      { key: "purple",     label: "Purple Icons",      color: "#b39ddb", glow: "rgba(179,157,219,0.2)" },
    ];

    function getFilteredIcons() {
      if (currentFilter === "all") return allIcons;
      return allIcons.filter(i => i.category === currentFilter);
    }

    function renderGallery() {
      const grid = document.getElementById("galleryGrid");
      if (!grid) return;
      grid.innerHTML = "";
      const filtered = getFilteredIcons();
      filtered.slice(0, visibleCount).forEach(icon => grid.appendChild(createIconCard(icon)));
      const btn = document.getElementById("loadMoreBtn");
      if (btn) btn.style.display = filtered.length > visibleCount ? "inline-flex" : "none";
    }

    function createIconCard(icon: any) {
      const isPaid = icon.plan === "premium" || icon.plan === "paid";
      const card = document.createElement("div");
      card.className = "icon-card icon-card--" + icon.category + (isPaid ? " icon-card--premium" : "");
      card.dataset.category = icon.category;
      card.dataset.plan = icon.plan;
      card.innerHTML = `
        ${isPaid ? '<span class="icon-pro-badge">' + (icon.plan === "paid" ? "PAID" : "PRO") + '</span>' : ""}
        <div class="icon-img-wrap">
          <img src="${icon.path}" alt="${icon.collection ?? icon.category}" loading="lazy" />
        </div>
        <span class="icon-collection-label">${icon.collection ?? icon.category}</span>
      `;
      card.addEventListener("click", () => showPreviewModal(icon));
      return card;
    }

    // ===== AUTH =====
    function checkAuth() {
      try {
        const token = localStorage.getItem("volynx_access_token");
        const sessionRaw = localStorage.getItem("volynx_session");
        if (token && sessionRaw) {
          const session = JSON.parse(sessionRaw);
          isLoggedIn = true;
          currentUser = {
            name: session?.user?.user_metadata?.full_name || session?.user?.email?.split("@")[0] || "User",
            email: session?.user?.email || ""
          };
          updateAuthUI();
        }
      } catch (e) {}
    }

    function logout() {
      currentUser = null;
      isLoggedIn = false;
      localStorage.removeItem("volynx_access_token");
      localStorage.removeItem("volynx_refresh_token");
      localStorage.removeItem("volynx_session");
      localStorage.removeItem("volynx_user_email");
      updateAuthUI();
      document.getElementById("dropdownMenu")?.classList.remove("show");
    }

    function updateAuthUI() {
      const signInBtn = document.getElementById("signInBtn");
      const userMenu = document.getElementById("userMenu");
      const userName = document.getElementById("userName");
      const userNameFull = document.getElementById("userNameFull");
      const userEmail = document.getElementById("userEmail");

      if (isLoggedIn && currentUser) {
        if (signInBtn) signInBtn.style.display = "none";
        if (userMenu) userMenu.style.display = "block";
        const displayName = currentUser.name.split(" ")[0];
        if (userName) userName.textContent = displayName;
        if (userNameFull) userNameFull.textContent = currentUser.name;
        if (userEmail) userEmail.textContent = currentUser.email;
      } else {
        if (signInBtn) signInBtn.style.display = "inline-flex";
        if (userMenu) userMenu.style.display = "none";
      }
    }

    // ===== PREVIEW MODAL =====
    function showPreviewModal(icon: any) {
      const isPremium = icon.plan === "premium";
      openModal(`
        <div style="display:flex;align-items:center;justify-content:center;background:#fff;border-radius:16px;padding:24px;margin-bottom:1.25rem;min-height:180px;">
          <img src="${icon.path}" alt="" style="width:160px;height:160px;object-fit:contain;display:block;" />
        </div>
        <p style="color:rgba(255,255,255,.5);font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:1.25rem;">${icon.category}</p>
        <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;">
          <button id="previewDownloadBtn" style="padding:.75rem 2rem;background:linear-gradient(135deg,#00f0ff,#0066ff);color:#000;font-weight:700;border-radius:10px;border:none;font-size:.9rem;cursor:pointer;">
            ${isPremium ? "Adquirir" : "Download"}
          </button>
          <button id="previewCancelBtn" style="padding:.75rem 1.25rem;background:transparent;color:rgba(255,255,255,.6);border:1px solid rgba(255,255,255,.15);border-radius:10px;font-size:.9rem;cursor:pointer;">Fechar</button>
        </div>
      `);
      document.getElementById("previewDownloadBtn")?.addEventListener("click", () => {
        closeModal();
        handleDownload(icon);
      });
      document.getElementById("previewCancelBtn")?.addEventListener("click", closeModal);
    }

    // ===== DOWNLOAD LOGIC =====
    function handleDownload(icon: any) {
      if (icon.plan === "premium") {
        showPremiumModal(icon);
        return;
      }
      // Free icon — requires login
      if (!isLoggedIn) {
        showLoginModal(icon);
        return;
      }
      triggerDownload(icon);
    }

    function triggerDownload(icon: any) {
      const a = document.createElement("a");
      a.href = icon.path;
      a.download = icon.file;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      showNotification(`Downloaded: ${icon.name}`);
    }

    // ===== LOAD MORE =====
    document.getElementById("loadMoreBtn")?.addEventListener("click", () => {
      visibleCount += 48;
      renderGallery();
    });

    // ===== FILTERS =====
    function initFilters() {
      const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
      filterBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          filterBtns.forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          currentFilter = btn.dataset.filter ?? "all";
          visibleCount = 48;
          renderGallery();
        });
      });
    }

    // ===== MODAL =====
    function initModal() {
      document.getElementById("vxModalClose")?.addEventListener("click", closeModal);
      document.getElementById("vxModal")?.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).id === "vxModal") closeModal();
      });
    }

    function openModal(html: string) {
      const modal = document.getElementById("vxModal") as HTMLElement;
      const content = document.getElementById("vxModalContent") as HTMLElement;
      content.innerHTML = html;
      modal.style.display = "flex";
    }

    function closeModal() {
      const modal = document.getElementById("vxModal") as HTMLElement;
      modal.style.display = "none";
    }

    function showLoginModal(icon: any) {
      openModal(`
        <div style="font-size:2.5rem;margin-bottom:1rem;">🔒</div>
        <h3 style="color:#fff;margin-bottom:.5rem;">Login necessário</h3>
        <p style="color:rgba(255,255,255,.7);font-size:.9rem;margin-bottom:1.5rem;">
          Faça login para baixar ícones gratuitos — é rápido e grátis.
        </p>
        <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;">
          <a href="/login/?return=/products/volynx-icons-store/" style="padding:.75rem 1.5rem;background:linear-gradient(135deg,#00f0ff,#0066ff);color:#000;font-weight:700;border-radius:10px;text-decoration:none;font-size:.9rem;">Entrar</a>
          <a href="/signup/?return=/products/volynx-icons-store/" style="padding:.75rem 1.5rem;background:transparent;color:#fff;font-weight:700;border-radius:10px;text-decoration:none;font-size:.9rem;border:1px solid rgba(255,255,255,.3);">Criar conta grátis</a>
        </div>
      `);
    }

    function showPremiumModal(icon: any) {
      const colPrice = (icon as any).collectionPrice || "£4.99";
      openModal(`
        <img src="${icon.path}" alt="" style="width:80px;height:80px;object-fit:contain;background:#fff;border-radius:12px;padding:8px;margin:0 auto 1rem;display:block;" />
        <p style="color:rgba(200,150,255,.9);font-size:.75rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;margin-bottom:.5rem;">Coleção Premium</p>
        <h3 style="color:#fff;font-size:1.25rem;margin-bottom:1.25rem;">${icon.collection}</h3>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:1.5rem;">
          <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:1rem;text-align:center;">
            <div style="color:rgba(255,255,255,.5);font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.25rem;">Coleção individual</div>
            <div style="color:#fff;font-size:1.5rem;font-weight:900;">${colPrice}</div>
          </div>
          <div style="background:linear-gradient(135deg,rgba(139,92,246,.2),rgba(255,0,110,.15));border:1px solid rgba(139,92,246,.4);border-radius:12px;padding:1rem;text-align:center;">
            <div style="color:rgba(200,150,255,.8);font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.25rem;">Combo completo</div>
            <div style="color:#fff;font-size:1.5rem;font-weight:900;">£19.99</div>
            <div style="color:rgba(200,150,255,.7);font-size:.65rem;margin-top:.15rem;">Todas as coleções premium</div>
          </div>
        </div>

        <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;">
          <a href="/pricing/" style="padding:.75rem 1.5rem;background:linear-gradient(135deg,#8b5cf6,#ff006e);color:#fff;font-weight:700;border-radius:10px;text-decoration:none;font-size:.875rem;">Adquirir esta coleção</a>
          <a href="/pricing/" style="padding:.75rem 1.5rem;background:transparent;color:#fff;font-weight:700;border-radius:10px;text-decoration:none;font-size:.875rem;border:1px solid rgba(255,255,255,.2);">Ver combo</a>
        </div>
      `);
    }

    // ===== NOTIFICATIONS =====
    function showNotification(message: string) {
      const n = document.createElement("div");
      n.className = "notification";
      n.textContent = message;
      document.body.appendChild(n);
      setTimeout(() => {
        n.classList.add("fade-out");
        setTimeout(() => { if (document.body.contains(n)) document.body.removeChild(n); }, 300);
      }, 3000);
    }

    // ===== SMOOTH SCROLL =====
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener("click", function (this: HTMLAnchorElement, e) {
        const href = this.getAttribute("href");
        if (!href || href === "#") return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    });
  </script>

  <PageWidgets />
</body>
</html>
