              <rect x="38" y="25" width="6" height="18" rx="2" fill="#7c4dff" opacity="0.6"/>
              <path d="M11 34 L23 28 L32 20 L41 25" stroke="#4fc3f7" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="11" cy="34" r="2" fill="#4fc3f7"/>
              <circle cx="23" cy="28" r="2" fill="#7c4dff"/>
              <circle cx="32" cy="20" r="2" fill="#4fc3f7"/>
              <circle cx="41" cy="25" r="2" fill="#7c4dff"/>
            </svg>
          </div>
          <span class="featured-label">Analytics</span>
