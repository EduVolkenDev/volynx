                    <rect x="10" y="18" width="34" height="22" rx="4" fill="none" stroke="#ffb74d" stroke-width="1.5"/>
                    <rect x="10" y="22" width="34" height="6" fill="#ffb74d" opacity="0.15"/>
                    <rect x="35" y="24" width="10" height="10" rx="3" fill="#ffb74d" opacity="0.2" stroke="#ffb74d" stroke-width="1"/>
