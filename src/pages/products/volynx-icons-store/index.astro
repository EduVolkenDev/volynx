            <svg width="54" height="54" viewBox="0 0 54 54" fill="none" aria-hidden="true">
              <defs><radialGradient id="fbg9" cx="50%" cy="30%" r="70%"><stop offset="0%" stop-color="#081828"/><stop offset="100%" stop-color="#020810"/></radialGradient></defs>
              <rect width="54" height="54" rx="14" fill="url(#fbg9)"/>
              <rect x="23" y="23" width="8" height="8" rx="2" fill="#4fc3f7" opacity="0.3" stroke="#4fc3f7" stroke-width="1.2"/>
              <rect x="13" y="24.5" width="10" height="5" rx="1.5" fill="#4fc3f7" opacity="0.5"/>
              <rect x="31" y="24.5" width="10" height="5" rx="1.5" fill="#4fc3f7" opacity="0.5"/>
              <rect x="24.5" y="13" width="5" height="10" rx="1.5" fill="#4fc3f7" opacity="0.5"/>
              <circle cx="38" cy="16" r="1.5" fill="#4fc3f7" opacity="0.8"/>
              <path d="M37 26 C41 30 41 34 38 37" stroke="#4fc3f7" stroke-width="1.2" fill="none" stroke-linecap="round" opacity="0.4"/>
            </svg>
