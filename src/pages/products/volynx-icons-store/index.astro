        <button type="button" class="featured-card coral" data-featured-filter="food">
          <div class="featured-svg-wrap">
            <svg width="54" height="54" viewBox="0 0 54 54" fill="none" aria-hidden="true">
              <defs><radialGradient id="fbg11" cx="50%" cy="30%" r="70%"><stop offset="0%" stop-color="#1a0a04"/><stop offset="100%" stop-color="#0a0400"/></radialGradient></defs>
              <rect width="54" height="54" rx="14" fill="url(#fbg11)"/>
              <path d="M9 20 L9 37 C9 38.6 10.3 40 12 40 L42 40 C43.7 40 45 38.6 45 37 L45 20 C45 18.3 43.7 17 42 17 L36 17 L34 14 L20 14 L18 17 L12 17 C10.3 17 9 18.3 9 20Z" fill="none" stroke="#ff7043" stroke-width="1.3"/>
              <circle cx="27" cy="28" r="7" fill="none" stroke="#ff7043" stroke-width="1.3"/>
              <circle cx="27" cy="28" r="4" fill="none" stroke="#ff7043" stroke-width="1" opacity="0.7"/>
              <circle cx="27" cy="28" r="1.5" fill="#ff7043" opacity="0.9"/>
            </svg>
          </div>
          <span class="featured-label">Camera</span>
        </button>

        <button type="button" class="featured-card" data-featured-filter="futuristic">
          <span class="featured-badge hot">HOT</span>
          <div class="featured-svg-wrap">
            <svg width="54" height="54" viewBox="0 0 54 54" fill="none" aria-hidden="true">
              <defs><radialGradient id="fbg12" cx="50%" cy="30%" r="70%"><stop offset="0%" stop-color="#0a0f1e"/><stop offset="100%" stop-color="#040710"/></radialGradient></defs>
              <rect width="54" height="54" rx="14" fill="url(#fbg12)"/>
              <path d="M27 10 C27 10 20 18 20 28 L20 34 L27 38 L34 34 L34 28 C34 18 27 10 27 10Z" fill="none" stroke="#4fc3f7" stroke-width="1.4"/>
              <path d="M22 28 C22 28 18 30 16 36 L20 34" fill="none" stroke="#7c4dff" stroke-width="1.2" stroke-linecap="round"/>
              <path d="M32 28 C32 28 36 30 38 36 L34 34" fill="none" stroke="#7c4dff" stroke-width="1.2" stroke-linecap="round"/>
              <circle cx="27" cy="22" r="3" fill="none" stroke="#4fc3f7" stroke-width="1.2"/>
              <circle cx="27" cy="22" r="1" fill="#4fc3f7" opacity="0.8"/>
              <path d="M24 38 Q27 44 30 38" stroke="#ff7043" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.8"/>
            </svg>
          </div>
          <span class="featured-label">Rocket</span>
        </button>
      </div>
    </section>

    <!-- Gallery Section -->
    <section class="gallery-section" id="gallery">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title" id="iconsGalleryTitle" data-i18n="icons.gallery_title">Icon Vault</h2>
          <p class="pack-meta" id="iconsGalleryMeta">Browse all curated icons or open a pack below.</p>
          <button class="pack-reset" id="packResetBtn" type="button" hidden>Show all icons</button>
          <div class="filters">
            <button class="filter-btn active" data-filter="all">All</button>
            <button class="filter-btn" data-filter="pink">Pink</button>
            <button class="filter-btn" data-filter="futuristic">Futuristic</button>
            <button class="filter-btn" data-filter="green">Green</button>
            <button class="filter-btn" data-filter="simple">Simple</button>
            <button class="filter-btn" data-filter="draw">Draw</button>
            <button class="filter-btn" data-filter="metal">Metal</button>
            <button class="filter-btn" data-filter="blue">Blue</button>
            <button class="filter-btn" data-filter="purple">Purple</button>
            <button class="filter-btn" data-filter="food">Food ⭐</button>
          </div>
        </div>

        <div class="gallery-grid" id="galleryGrid">
          <article class="soon-panel">
            <p class="soon-kicker">Loading vault</p>
            <h3>Icon packs are loading.</h3>
            <p>Open any pack to see the rest of its icons here, without leaving the store.</p>
          </article>
        </div>

        <div class="load-more-container">
          <button class="btn btn-secondary" id="loadMoreBtn" style="display:none;">Load More</button>
        </div>
      </div>
    </section>

    <!-- Collections Preview -->
    <section class="collections-preview" id="collections">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title" data-i18n="icons.coll_title">Icon Packs</h2>
          <a href="#gallery" class="view-all" id="viewAllBtn">
            <span data-i18n="icons.coll_view_all">View All Icons</span>
            <svg viewBox="0 0 20 20" fill="currentColor">
              <path d="M7 3l7 7-7 7" />
            </svg>
          </a>
        </div>

        <div class="collections-grid" id="collectionsGrid"></div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <div class="footer-brand">
            <div class="brand-icon-footer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 2 7 12 12 22 7 12 2" />
                <polyline points="2 17 12 22 22 17" />
                <polyline points="2 12 12 17 22 12" />
              </svg>
            </div>
            <span class="brand-name-footer">Volynx Icons Store</span>
          </div>
          <p class="footer-description">
            Curated icon packs for builders, creators, products, and interfaces.
          </p>
        </div>

        <div class="footer-col">
          <h4 class="footer-title">Product</h4>
          <ul class="footer-links">
            <li><a href={ROUTES.iconsStore}>Vault</a></li>
            <li><a href={ROUTES.products} id="collectionsFooterBtn">Products</a></li>
            <li><a href={ROUTES.pricing}>Pricing</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-title">Navigate</h4>
          <ul class="footer-links">
            <li><a href={ROUTES.home}>Home</a></li>
            <li><a href={ROUTES.products}>Products</a></li>
            <li><a href={ROUTES.contact}>Contact</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p class="footer-copyright">© <span id="y"></span> Volynx Icons Store. All rights reserved.</p>
        <div class="footer-legal">
          <a href={ROUTES.privacy}>Privacy</a>
          <a href={ROUTES.terms}>Terms</a>
          <a href={ROUTES.disclaimer}>Disclaimer</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Download modal for premium/login gate -->
  <div id="vxModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.75);backdrop-filter:blur(8px);align-items:center;justify-content:center;">
    <div style="background:#0d0d18;border:1px solid rgba(255,255,255,.15);border-radius:20px;padding:2rem;max-width:420px;width:90%;text-align:center;position:relative;">
      <button id="vxModalClose" style="position:absolute;top:1rem;right:1rem;background:none;border:none;color:#fff;font-size:1.25rem;cursor:pointer;">✕</button>
      <div id="vxModalContent"></div>
    </div>
  </div>


  <script>
    // ===== STATE =====
    let isLoggedIn = false;
    let currentUser: { name: string; email: string } | null = null;
    let currentFilter = "all";
    let currentCollection: string | null = null;

    let allIcons: any[] = [];
    let visibleCount = 48;

    const STORE_TEXT = {
      en: {
        openPack: "Open pack",
        download: "Download",
        showAll: "Show all icons",
        allMeta: "Browse all curated icons or open a pack below.",
        packMeta: (count: number) => `${count.toLocaleString()} icons in this pack. Select any icon to preview it.`,
        categoryMeta: (count: number, label: string) => `${count.toLocaleString()} icons in ${label}.`,
        emptyKicker: "No icons found",
        emptyTitle: "This pack is empty.",
        emptyText: "Choose another pack or reset the gallery.",
      },
      pt: {
        openPack: "Abrir pack",
        download: "Baixar",
        showAll: "Ver todos os ícones",
        allMeta: "Veja todos os ícones curados ou abra um pack abaixo.",
        packMeta: (count: number) => `${count.toLocaleString("pt-BR")} ícones neste pack. Selecione qualquer ícone para visualizar.`,
        categoryMeta: (count: number, label: string) => `${count.toLocaleString("pt-BR")} ícones em ${label}.`,
        emptyKicker: "Nenhum ícone encontrado",
        emptyTitle: "Este pack está vazio.",
        emptyText: "Escolha outro pack ou redefina a galeria.",
      },
    };

    function storeLang() {
      return localStorage.getItem("volynx_lang") === "pt" ? "pt" : "en";
    }

    function storeText(key: keyof typeof STORE_TEXT.en) {
      return STORE_TEXT[storeLang()][key] as string;
    }

    // ===== INIT =====
    document.addEventListener("DOMContentLoaded", async () => {
      initNavigation();
      initModal();
      initFilters();
      checkAuth();
      await loadCatalog();

      const y = document.getElementById("y");
      if (y) y.textContent = String(new Date().getFullYear());

      // Catalog is browsable by pack; gated downloads still use the modal flow.
    });

    // ===== NAVIGATION =====
    function initNavigation() {
      const mobileMenuBtn = document.getElementById("mobileMenuBtn");
      const mobileMenu = document.getElementById("mobileMenu");
      const userMenuBtn = document.getElementById("userMenuBtn");
      const dropdownMenu = document.getElementById("dropdownMenu");

      if (mobileMenuBtn && mobileMenu) {
        mobileMenuBtn.addEventListener("click", () => {
          mobileMenuBtn.classList.toggle("active");
          mobileMenu.classList.toggle("show");
        });
      }

      if (userMenuBtn && dropdownMenu) {
        userMenuBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          dropdownMenu.classList.toggle("show");
        });
        document.addEventListener("click", (e) => {
          if (!userMenuBtn.contains(e.target as Node) && !dropdownMenu.contains(e.target as Node)) {
            dropdownMenu.classList.remove("show");
          }
        });
      }

      const signInBtn = document.getElementById("signInBtn");
      const logoutBtn = document.getElementById("logoutBtn");
      if (logoutBtn) logoutBtn.addEventListener("click", logout);

      // Favorites links — no favorites section exists on this page yet
      const favoritesLinks = [
        document.getElementById("dropdownFavoritesBtn"),
        document.getElementById("favoritesBtn"),
        document.getElementById("mobileFavoritesBtn"),
      ];
      favoritesLinks.forEach(el => {
        if (!el) return;
        el.addEventListener("click", (e) => {
          e.preventDefault();
          document.getElementById("dropdownMenu")?.classList.remove("show");
          // Close mobile menu if open
          document.getElementById("mobileMenu")?.classList.remove("show");
          document.getElementById("mobileMenuBtn")?.classList.remove("active");
          if (isLoggedIn) {
            showNotification(storeLang() === "pt" ? "Favoritos em desenvolvimento." : "Favorites are in development.");
          } else {
            showNotification(storeLang() === "pt" ? "Entre para salvar favoritos." : "Sign in to save favorites.");
          }
        });
      });

      // "View All" collections button — scroll to gallery and reset to every icon
      const viewAllBtn = document.getElementById("viewAllBtn");
      if (viewAllBtn) {
        viewAllBtn.addEventListener("click", (e) => {
          e.preventDefault();
          clearPackSelection(true);
        });
      }

      document.getElementById("packResetBtn")?.addEventListener("click", () => {
        clearPackSelection(false);
      });
    }

    // ===== CATALOG =====
    async function loadCatalog() {
      try {
        const res = await fetch("/assets/icons-store/catalog.json");
        allIcons = await res.json();
        updateGalleryHeading();
        renderGallery();
        updateStats();
      } catch (e) {
        console.error("Error loading catalog:", e);
        const grid = document.getElementById("galleryGrid");
        if (grid) {
          grid.innerHTML = `
            <article class="soon-panel">
              <p class="soon-kicker">Vault unavailable</p>
              <h3>Icon packs could not load.</h3>
              <p>Please refresh the page or try again in a moment.</p>
            </article>
          `;
        }
      }
    }

    function updateStats() {
      const total = allIcons.length;
      const collections = new Set(allIcons.map(i => i.collection)).size;
      const heroCount = document.getElementById('heroIconCount');
      if (heroCount) heroCount.textContent = total.toLocaleString() + '+';
      const statEls = document.querySelectorAll<HTMLElement>(".stat-number");
      if (statEls[0]) statEls[0].textContent = total.toLocaleString() + '+';
      if (statEls[1]) statEls[1].textContent = String(collections);
      renderCollections();
    }

    // ===== FEATURED COLLECTIONS =====
    function escHtml(value: unknown) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function getCollectionGroups() {
      const groups = new Map<string, any[]>();
      allIcons.forEach(icon => {
        const name = icon.collection || icon.category || "Icon Pack";
        if (!groups.has(name)) groups.set(name, []);
        groups.get(name)?.push(icon);
      });

      return Array.from(groups.entries())
        .map(([name, icons]) => ({ name, icons }))
        .sort((a, b) => a.name.localeCompare(b.name));
    }

    function renderCollections() {
      const grid = document.getElementById("collectionsGrid");
      if (!grid || !allIcons.length) return;
      grid.innerHTML = "";

      getCollectionGroups().forEach(pack => {
        const previews = pack.icons.slice(0, 4).map(i =>
          `<div class="preview-icon">
            <img src="${i.path}" alt="" style="width:100%;height:100%;object-fit:contain;" loading="lazy" />
          </div>`
        ).join("");

        const count = pack.icons.length;
        const freeCount = pack.icons.filter(i => i.plan === "free").length;
        const isPremium = freeCount === 0;
        const isFree = freeCount === count;
        const firstCategory = CATEGORY_CONFIG.find(c => c.key === pack.icons[0]?.category)?.label || pack.icons[0]?.category || "Icon Pack";
        const planLabel = isPremium ? "PRO" : isFree ? "FREE" : "MIXED";
        const planClass = isPremium ? "pro" : isFree ? "free" : "mixed";

        const card = document.createElement("article");
        card.className = "collection-card" + (isPremium ? " collection-card--premium" : "");
        card.tabIndex = 0;
        card.dataset.collection = pack.name;
        card.style.cursor = "pointer";
        card.innerHTML = `
          <span class="collection-plan-badge collection-plan-badge--${planClass}">${planLabel}</span>
          <div class="collection-preview">${previews}</div>
          <div class="collection-meta-row">
            <span class="collection-category">${escHtml(firstCategory)}</span>
            <p class="collection-count">${count} icons</p>
          </div>
          <h3 class="collection-title">${escHtml(pack.name)}</h3>
          <button class="collection-open-btn" type="button">${storeText("openPack")}</button>
        `;

        const open = () => openPack(pack.name);
        card.addEventListener("click", open);
        card.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            open();
          }
        });
        card.querySelector("button")?.addEventListener("click", (e) => {
          e.stopPropagation();
          open();
        });

        grid.appendChild(card);
      });
    }

    // ===== CATEGORY CONFIG =====
    const CATEGORY_CONFIG = [
      { key: "pink",       label: "Pink Icons",       color: "#f48fb1", glow: "rgba(244,143,177,0.2)" },
      { key: "futuristic", label: "Futuristic Icons",  color: "#00f0ff", glow: "rgba(0,240,255,0.2)"   },
      { key: "green",      label: "Green Icons",       color: "#66bb6a", glow: "rgba(102,187,106,0.2)" },
      { key: "simple",     label: "Simple Icons",      color: "#e8eaf6", glow: "rgba(232,234,246,0.15)" },
      { key: "draw",       label: "Draw Icons",        color: "#ffb74d", glow: "rgba(255,183,77,0.2)"  },
      { key: "metal",      label: "Metal Icons",       color: "#90a4ae", glow: "rgba(144,164,174,0.2)" },
      { key: "blue",       label: "Blue Icons",        color: "#4fc3f7", glow: "rgba(79,195,247,0.2)"  },
      { key: "purple",     label: "Purple Icons",      color: "#b39ddb", glow: "rgba(179,157,219,0.2)" },
      { key: "food",       label: "Food Icons",        color: "#ff8a65", glow: "rgba(255,138,101,0.2)"  },
    ];

    function getFilteredIcons() {
      if (currentCollection) return allIcons.filter(i => i.collection === currentCollection);
      if (currentFilter === "all") return allIcons;
      return allIcons.filter(i => i.category === currentFilter);
    }

    function updateGalleryHeading() {
      const title = document.getElementById("iconsGalleryTitle");
      const meta = document.getElementById("iconsGalleryMeta");
      const reset = document.getElementById("packResetBtn") as HTMLButtonElement | null;
      const filtered = getFilteredIcons();

      if (currentCollection) {
        if (title) title.textContent = currentCollection;
        if (meta) meta.textContent = STORE_TEXT[storeLang()].packMeta(filtered.length);
        if (reset) {
          reset.textContent = storeText("showAll");
          reset.hidden = false;
        }
        return;
      }

      const label = CATEGORY_CONFIG.find(c => c.key === currentFilter)?.label;
      if (title) title.textContent = label || "Icon Vault";
      if (meta) meta.textContent = currentFilter === "all"
        ? storeText("allMeta")
        : STORE_TEXT[storeLang()].categoryMeta(filtered.length, label || currentFilter);
      if (reset) {
        reset.textContent = storeText("showAll");
        reset.hidden = true;
      }
    }

    function openPack(collection: string) {
      currentCollection = collection;
      currentFilter = "all";
      visibleCount = Number.MAX_SAFE_INTEGER;
      document.querySelectorAll<HTMLButtonElement>(".filter-btn").forEach(b => {
        b.classList.toggle("active", b.dataset.filter === "all");
      });
      updateGalleryHeading();
      renderGallery();
      document.getElementById("gallery")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function clearPackSelection(scrollToGallery = false) {
      currentCollection = null;
      currentFilter = "all";
      visibleCount = 48;
      document.querySelectorAll<HTMLButtonElement>(".filter-btn").forEach(b => {
        b.classList.toggle("active", b.dataset.filter === "all");
      });
      updateGalleryHeading();
      renderGallery();
      if (scrollToGallery) document.getElementById("gallery")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function renderGallery() {
      const grid = document.getElementById("galleryGrid");
      if (!grid) return;
      grid.innerHTML = "";
      const filtered = getFilteredIcons();

      if (!filtered.length) {
        grid.innerHTML = `
          <article class="soon-panel">
            <p class="soon-kicker">${storeText("emptyKicker")}</p>
            <h3>${storeText("emptyTitle")}</h3>
            <p>${storeText("emptyText")}</p>
          </article>
        `;
      } else {
        filtered.slice(0, visibleCount).forEach(icon => grid.appendChild(createIconCard(icon)));
      }

      const btn = document.getElementById("loadMoreBtn");
      if (btn) btn.style.display = !currentCollection && filtered.length > visibleCount ? "inline-flex" : "none";
    }

    function createIconCard(icon: any) {
      const isPaid = icon.plan === "premium" || icon.plan === "paid";
      const card = document.createElement("div");
      card.className = "icon-card icon-card--" + icon.category + (isPaid ? " icon-card--premium" : "");
      card.dataset.category = icon.category;
      card.dataset.plan = icon.plan;
      card.innerHTML = `
        ${isPaid ? '<span class="icon-pro-badge">' + (icon.plan === "paid" ? "PAID" : "PRO") + '</span>' : ""}
        <div class="icon-img-wrap">
          <img src="${icon.path}" alt="${icon.collection ?? icon.category}" loading="lazy" />
        </div>
        <span class="icon-collection-label">${icon.collection ?? icon.category}</span>
      `;
      card.addEventListener("click", () => showPreviewModal(icon));
      return card;
    }

    // ===== AUTH =====
    function checkAuth() {
      try {
        const token = localStorage.getItem("volynx_access_token");
        const sessionRaw = localStorage.getItem("volynx_session");
        if (token && sessionRaw) {
          const session = JSON.parse(sessionRaw);
          const meta = session?.user?.user_metadata || {};
          isLoggedIn = true;
          currentUser = {
            name: meta.full_name || meta.username || meta.name || session?.user?.email?.split("@")[0] || "User",
            email: session?.user?.email || ""
          };
          updateAuthUI();
          // Also try to fetch profile for latest name/username
          fetchProfileName(token);
        }
      } catch (e) {}
    }

    async function fetchProfileName(token: string) {
      try {
        const res = await fetch("/config.json", { cache: "no-store" });
        if (!res.ok) return;
        const cfg = await res.json();
        const payload = JSON.parse(atob(token.split(".")[1]));
        const uid = payload.sub;
        if (!uid || !cfg.supabaseUrl) return;
        const r = await fetch(cfg.supabaseUrl + "/rest/v1/profiles?select=full_name,username&id=eq." + uid, {
          headers: { apikey: cfg.supabaseAnonKey, Authorization: "Bearer " + token, Accept: "application/json" }
        });
        if (!r.ok) return;
        const rows = await r.json();
        const profile = rows?.[0];
        if (profile && currentUser) {
          const name = profile.full_name || profile.username || currentUser.name;
          if (name !== currentUser.name) {
            currentUser.name = name;
            updateAuthUI();
          }
        }
      } catch (e) {}
    }

    function logout() {
      currentUser = null;
      isLoggedIn = false;
      localStorage.removeItem("volynx_access_token");
      localStorage.removeItem("volynx_refresh_token");
      localStorage.removeItem("volynx_session");
      localStorage.removeItem("volynx_user_email");
      updateAuthUI();
      document.getElementById("dropdownMenu")?.classList.remove("show");
    }

    function updateAuthUI() {
      const signInBtn = document.getElementById("signInBtn");
      const userMenu = document.getElementById("userMenu");
      const userName = document.getElementById("userName");
      const userNameFull = document.getElementById("userNameFull");
      const userEmail = document.getElementById("userEmail");
      const favoritesBtn = document.getElementById("favoritesBtn");
      const mobileFavoritesBtn = document.getElementById("mobileFavoritesBtn");
      const upgradeBtn = document.getElementById("upgradeBtn");
      const mobileUpgradeBtn = document.getElementById("mobileUpgradeBtn");

      if (isLoggedIn && currentUser) {
        if (signInBtn) signInBtn.style.display = "none";
        if (userMenu) userMenu.style.display = "block";
        if (favoritesBtn) favoritesBtn.style.display = "flex";
        if (mobileFavoritesBtn) mobileFavoritesBtn.style.display = "flex";
        if (upgradeBtn) upgradeBtn.style.display = "inline-flex";
        if (mobileUpgradeBtn) mobileUpgradeBtn.style.display = "block";
        const displayName = currentUser.name.split(" ")[0];
        if (userName) userName.textContent = displayName;
        if (userNameFull) userNameFull.textContent = currentUser.name;
        if (userEmail) userEmail.textContent = currentUser.email;
      } else {
        if (signInBtn) signInBtn.style.display = "inline-flex";
        if (userMenu) userMenu.style.display = "none";
        if (favoritesBtn) favoritesBtn.style.display = "none";
        if (mobileFavoritesBtn) mobileFavoritesBtn.style.display = "none";
        if (upgradeBtn) upgradeBtn.style.display = "none";
        if (mobileUpgradeBtn) mobileUpgradeBtn.style.display = "none";
      }
    }

    // ===== PREVIEW MODAL =====
    function showPreviewModal(icon: any) {
      const isPremium = icon.plan === "premium" || icon.plan === "paid";
      openModal(`
        <div style="display:flex;align-items:center;justify-content:center;background:#fff;border-radius:16px;padding:24px;margin-bottom:1.25rem;min-height:180px;">
          <img src="${icon.path}" alt="" style="width:160px;height:160px;object-fit:contain;display:block;" />
        </div>
        <p style="color:rgba(255,255,255,.5);font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:1.25rem;">${icon.category}</p>
        <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;">
          <button id="previewDownloadBtn" style="padding:.75rem 2rem;background:linear-gradient(135deg,#00f0ff,#0066ff);color:#000;font-weight:700;border-radius:10px;border:none;font-size:.9rem;cursor:pointer;">
            ${isPremium ? storeText("openPack") : storeText("download")}
          </button>
          <button id="previewCancelBtn" style="padding:.75rem 1.25rem;background:transparent;color:rgba(255,255,255,.6);border:1px solid rgba(255,255,255,.15);border-radius:10px;font-size:.9rem;cursor:pointer;">Close</button>
        </div>
      `);
      document.getElementById("previewDownloadBtn")?.addEventListener("click", () => {
        closeModal();
        if (isPremium) {
          openPack(icon.collection || icon.category);
          return;
        }
        handleDownload(icon);
      });
      document.getElementById("previewCancelBtn")?.addEventListener("click", closeModal);
    }

    window.addEventListener("vx:lang-changed", () => {
      updateGalleryHeading();
      renderGallery();
      renderCollections();
    });

    // ===== DOWNLOAD LOGIC =====
    function handleDownload(icon: any) {
      if (icon.plan === "premium" || icon.plan === "paid") {
        showPremiumModal(icon);
        return;
      }
      // Free icon — requires login
      if (!isLoggedIn) {
        showLoginModal(icon);
        return;
      }
      triggerDownload(icon);
    }

    function triggerDownload(icon: any) {
      const a = document.createElement("a");
      a.href = icon.path;
      a.download = icon.file;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      showNotification(`Downloaded: ${icon.name}`);
    }

    // ===== LOAD MORE =====
    document.getElementById("loadMoreBtn")?.addEventListener("click", () => {
      visibleCount += 48;
      renderGallery();
    });

    // ===== FILTERS =====
    function initFilters() {
      const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
      filterBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          filterBtns.forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          currentCollection = null;
          currentFilter = btn.dataset.filter ?? "all";
          visibleCount = 48;
          updateGalleryHeading();
          renderGallery();
        });
      });

      // Featured Icons → scroll to gallery filtered by category
      document.querySelectorAll<HTMLButtonElement>(".featured-card[data-featured-filter]").forEach(card => {
        card.addEventListener("click", () => {
          const target = card.dataset.featuredFilter ?? "all";
          const match = document.querySelector<HTMLButtonElement>(`.filter-btn[data-filter="${target}"]`);
          if (match) {
            match.click();
            document.getElementById("gallery")?.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        });
      });
    }

    // ===== MODAL =====
    function initModal() {
      document.getElementById("vxModalClose")?.addEventListener("click", closeModal);
      document.getElementById("vxModal")?.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).id === "vxModal") closeModal();
      });
    }

    function openModal(html: string) {
      const modal = document.getElementById("vxModal") as HTMLElement;
      const content = document.getElementById("vxModalContent") as HTMLElement;
      content.innerHTML = html;
      modal.style.display = "flex";
    }

    function closeModal() {
      const modal = document.getElementById("vxModal") as HTMLElement;
      modal.style.display = "none";
    }

    function showLoginModal(icon: any) {
      openModal(`
        <div style="font-size:2.5rem;margin-bottom:1rem;">🔒</div>
        <h3 style="color:#fff;margin-bottom:.5rem;">Login required</h3>
        <p style="color:rgba(255,255,255,.7);font-size:.9rem;margin-bottom:1.5rem;">
          Sign in to download free icons — it's quick and free.
        </p>
        <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;">
          <a href="${ROUTES.login}?return=${ROUTES.iconsStore}" style="padding:.75rem 1.5rem;background:linear-gradient(135deg,#00f0ff,#0066ff);color:#000;font-weight:700;border-radius:10px;text-decoration:none;font-size:.9rem;">Sign in</a>
          <a href="${ROUTES.signup}?return=${ROUTES.iconsStore}" style="padding:.75rem 1.5rem;background:transparent;color:#fff;font-weight:700;border-radius:10px;text-decoration:none;font-size:.9rem;border:1px solid rgba(255,255,255,.3);">Create free account</a>
        </div>
      `);
    }

    function showPremiumModal(icon: any) {
      const colPrice = (icon as any).collectionPrice || "£4.99";
      openModal(`
        <img src="${icon.path}" alt="" style="width:80px;height:80px;object-fit:contain;background:#fff;border-radius:12px;padding:8px;margin:0 auto 1rem;display:block;" />
        <p style="color:rgba(200,150,255,.9);font-size:.75rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;margin-bottom:.5rem;">Premium Collection</p>
        <h3 style="color:#fff;font-size:1.25rem;margin-bottom:1.25rem;">${icon.collection}</h3>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:1.5rem;">
          <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:1rem;text-align:center;">
            <div style="color:rgba(255,255,255,.5);font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.25rem;">Individual collection</div>
            <div style="color:#fff;font-size:1.5rem;font-weight:900;">${colPrice}</div>
          </div>
          <div style="background:linear-gradient(135deg,rgba(139,92,246,.2),rgba(255,0,110,.15));border:1px solid rgba(139,92,246,.4);border-radius:12px;padding:1rem;text-align:center;">
            <div style="color:rgba(200,150,255,.8);font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.25rem;">Full combo</div>
            <div style="color:#fff;font-size:1.5rem;font-weight:900;">£19.99</div>
            <div style="color:rgba(200,150,255,.7);font-size:.65rem;margin-top:.15rem;">All premium collections</div>
          </div>
        </div>

        <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;">
          <a href="/contact/?product=volynx-icons-store&intent=collection-access" style="padding:.75rem 1.5rem;background:linear-gradient(135deg,#8b5cf6,#ff006e);color:#fff;font-weight:700;border-radius:10px;text-decoration:none;font-size:.875rem;">Request collection access</a>
          <a href="/products/volynx-icons-store/" style="padding:.75rem 1.5rem;background:transparent;color:#fff;font-weight:700;border-radius:10px;text-decoration:none;font-size:.875rem;border:1px solid rgba(255,255,255,.2);">Back to vault</a>
        </div>
      `);
    }

    // ===== NOTIFICATIONS =====
    function showNotification(message: string) {
      const n = document.createElement("div");
      n.className = "notification";
      n.textContent = message;
      document.body.appendChild(n);
      setTimeout(() => {
        n.classList.add("fade-out");
        setTimeout(() => { if (document.body.contains(n)) document.body.removeChild(n); }, 300);
      }, 3000);
    }

    // ===== SMOOTH SCROLL =====
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener("click", function (this: HTMLAnchorElement, e) {
        const href = this.getAttribute("href");
        if (!href || href === "#") return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: "smooth", block: "start" });
          // Close mobile menu if open
          document.getElementById("mobileMenu")?.classList.remove("show");
          document.getElementById("mobileMenuBtn")?.classList.remove("active");
        }
      });
    });
  </script>

  <PageWidgets hideUtilBar={true} />
</body>
</html>
