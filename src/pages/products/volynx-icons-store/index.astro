---
import "../../../styles/icons-store.css";
import PageWidgets from "../../../components/PageWidgets.astro";
import { ROUTES } from "../../../data/routes";
// PageWidgets provides floating lang/login — hide its util bar since icons store has its own nav auth

const pageTitle = "VOLYNX Icon Vault";
const pageDescription = "Browse curated VOLYNX icon packs, preview every collection, and open each pack without leaving the store.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content="/assets/volynx-icon.webp" />
  <meta property="og:url" content="https://volynx.world/products/volynx-icons-store/" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="VOLYNX" />
  <link rel="manifest" href="/site.webmanifest" />
  <style>
    /* ── Loading / empty state panel ── */
    .soon-panel {
      grid-column: 1 / -1;
      max-width: 760px;
      margin: 0 auto;
      padding: 32px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 8px;
      background: linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.025));
      text-align: center;
    }
    .soon-kicker {
      margin: 0 0 10px;
      color: rgba(0,240,255,.86);
      font-size: .78rem;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .soon-panel h3 { margin: 0 0 12px; color: #fff; font-size: clamp(1.35rem, 3vw, 2rem); }
    .soon-panel p:not(.soon-kicker) { margin: 0 auto 18px; max-width: 620px; color: rgba(255,255,255,.66); line-height: 1.7; }

    /* ── Featured Icons showcase (neon premium cards) ── */
    .featured-section { padding: clamp(40px,6vw,64px) 0 clamp(24px,4vw,40px); position: relative; }
    .featured-section .section-header { display: flex; flex-direction: column; gap: 8px; align-items: center; text-align: center; margin-bottom: clamp(24px,4vw,40px); }
    .featured-brand { font-size: 11px; font-weight: 700; letter-spacing: 8px; color: #4fc3f7; text-transform: uppercase; opacity: 0.8; margin: 0; }
    .featured-title { font-size: clamp(24px,4vw,32px); font-weight: 900; background: linear-gradient(135deg, #fff 0%, #4fc3f7 50%, #7c4dff 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin: 0; }
    .featured-subtitle { font-size: 12px; color: #546e7a; letter-spacing: 2px; text-transform: uppercase; margin: 0; }

    .featured-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 14px; max-width: 1100px; margin: 0 auto; padding: 0 clamp(12px,3vw,24px); }
    .featured-card {
      position: relative;
      background: linear-gradient(145deg, #0d1117 0%, #111827 100%);
      border: 1px solid #1a2744;
      border-radius: 16px;
      padding: 22px 12px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      overflow: hidden;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .featured-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(79,195,247,0.4), transparent); }
    .featured-card:hover {
      transform: translateY(-4px);
      border-color: rgba(79, 195, 247, 0.4);
      background: linear-gradient(145deg, #0d1117 0%, #152035 100%);
      box-shadow: 0 8px 32px rgba(79, 195, 247, 0.12), 0 0 0 1px rgba(79,195,247,0.15);
    }
    .featured-card.purple::before { background: linear-gradient(90deg, transparent, rgba(124,77,255,0.45), transparent); }
    .featured-card.purple:hover { border-color: rgba(124,77,255,0.4); box-shadow: 0 8px 32px rgba(124,77,255,0.15); }
    .featured-card.amber::before { background: linear-gradient(90deg, transparent, rgba(255,183,77,0.45), transparent); }
    .featured-card.amber:hover { border-color: rgba(255,183,77,0.4); box-shadow: 0 8px 32px rgba(255,183,77,0.15); }
    .featured-card.green::before { background: linear-gradient(90deg, transparent, rgba(102,187,106,0.45), transparent); }
    .featured-card.green:hover { border-color: rgba(102,187,106,0.4); box-shadow: 0 8px 32px rgba(102,187,106,0.15); }
    .featured-card.coral::before { background: linear-gradient(90deg, transparent, rgba(255,112,67,0.45), transparent); }
    .featured-card.coral:hover { border-color: rgba(255,112,67,0.4); box-shadow: 0 8px 32px rgba(255,112,67,0.15); }

    .featured-svg-wrap { width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; border-radius: 18px; position: relative; }
    .featured-svg-wrap svg { display: block; }
    .featured-label { font-size: 11px; color: #546e7a; letter-spacing: 0.5px; text-align: center; line-height: 1.3; font-weight: 500; transition: color 0.25s; }
    .featured-card:hover .featured-label { color: #4fc3f7; }
    .featured-card.purple:hover .featured-label { color: #b39ddb; }
    .featured-card.amber:hover .featured-label { color: #ffb74d; }
    .featured-card.green:hover .featured-label { color: #66bb6a; }
    .featured-card.coral:hover .featured-label { color: #ff8a65; }

    .featured-badge { position: absolute; top: 8px; right: 8px; font-size: 8px; font-weight: 800; letter-spacing: 0.5px; padding: 2px 6px; border-radius: 4px; }
    .featured-badge.new { background: rgba(79,195,247,0.15); color: #4fc3f7; border: 1px solid rgba(79,195,247,0.3); }
    .featured-badge.hot { background: rgba(255,112,67,0.15); color: #ff7043; border: 1px solid rgba(255,112,67,0.3); }
    .featured-badge.pro { background: rgba(255,183,77,0.15); color: #ffb74d; border: 1px solid rgba(255,183,77,0.3); }
  </style>
</head>

<body class="fx-grid">
  <nav class="nav-header">
    <div class="nav-container">
      <!-- Logo -->
      <div class="brand">
        <div class="brand-icon">
          <img src="/assets/volynx-icon.webp" alt="VOLYNX Icon" aria-hidden="true" />
        </div>
        <div class="brand-name">
          <img src="/assets/wordmark.webp" alt="VOLYNX Wordmark" aria-hidden="true" />
        </div>
      </div>

      <!-- Desktop Navigation -->
      <div class="nav-links desktop-nav">
        <a href={ROUTES.iconsStore} class="nav-link active">Vault</a>
        <a href={ROUTES.products} class="nav-link" id="collectionsBtn">Products</a>
        <a href={`${ROUTES.login}?return=${ROUTES.iconsStore}`} class="nav-link" id="favoritesBtn" style="display:none;">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
          Favorites
        </a>
        <a href={ROUTES.pricing} class="btn-upgrade" id="upgradeBtn" style="display:none;">Upgrade</a>
      </div>

      <!-- Auth Buttons -->
      <div class="nav-actions">
        <a class="btn btn-primary" id="signInBtn" href={`${ROUTES.login}?return=${ROUTES.iconsStore}`} data-i18n="icons.signin">Sign In</a>

        <!-- User Menu (hidden by default) -->
        <div class="user-menu" id="userMenu" style="display: none;">
          <button class="user-btn" id="userMenuBtn">
            <svg class="user-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <span id="userName">User</span>
          </button>

          <div class="dropdown-menu" id="dropdownMenu">
            <div class="dropdown-item user-info">
              <div class="user-details">
                <span class="user-name-full" id="userNameFull"></span>
                <span class="user-email" id="userEmail"></span>
              </div>
            </div>
            <div class="dropdown-divider"></div>
            <a href="#favorites" class="dropdown-item" id="dropdownFavoritesBtn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
              </svg>
              My Favorites
            </a>
            <a href={ROUTES.pricing} class="dropdown-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                <line x1="3" y1="6" x2="21" y2="6" />
                <path d="M16 10a4 4 0 0 1-8 0" />
              </svg>
              Upgrade Plan
            </a>
            <div class="dropdown-divider"></div>
            <button class="dropdown-item logout-btn" id="logoutBtn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
              </svg>
              Logout
            </button>
          </div>
        </div>

        <!-- Mobile Menu Button -->
        <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle menu">
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
      <a href={ROUTES.iconsStore} class="mobile-menu-item active">Vault</a>
      <a href={ROUTES.products} class="mobile-menu-item" id="mobileCollectionsBtn">Products</a>
      <a href={`${ROUTES.login}?return=${ROUTES.iconsStore}`} class="mobile-menu-item" id="mobileFavoritesBtn" style="display:none;">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
        </svg>
        Favorites
      </a>
      <a href={ROUTES.pricing} class="mobile-menu-item upgrade" id="mobileUpgradeBtn" style="display:none;">Upgrade to Pro</a>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="main-content">
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="hero-brand">
          <img src="/assets/long-logo-icons.webp" class="hero-long-logo" alt="Volynx Icons Store" />
        </div>
        <h1 class="hero-title">
          <span data-i18n="icons.hero_title_lead">VOLYNX</span>
          <span class="gradient-text" data-i18n="icons.hero_title_accent">Icon Vault</span>
        </h1>
        <p class="hero-description" data-i18n="icons.hero_desc">
          Browse curated icon packs, preview each collection, and open the full pack without leaving the store.
        </p>
        <div class="hero-actions">
          <a href="#collections" class="btn btn-primary btn-lg" data-i18n="icons.btn_browse">Browse Icon Packs</a>
          <a href="#gallery" class="btn btn-secondary btn-lg" data-i18n="icons.btn_gallery">View all icons</a>
        </div>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-number" id="heroIconCount">Curated</span>
            <span class="stat-label">Library</span>
          </div>
          <div class="stat">
            <span class="stat-number">SVG-first</span>
            <span class="stat-label">Packs</span>
          </div>
          <div class="stat">
            <span class="stat-number">Premium</span>
            <span class="stat-label">Access</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Icons (inline SVG neon cards — premium showcase) -->
    <section class="featured-section" id="featured">
      <div class="section-header">
        <p class="featured-brand" data-i18n="icons.featured_brand">Volynx Studio</p>
        <h2 class="featured-title" data-i18n="icons.featured_title">Featured icons</h2>
        <p class="featured-subtitle" data-i18n="icons.featured_subtitle">Premium · Textured · Futuristic</p>
      </div>
      <div class="featured-grid">
        <button type="button" class="featured-card" data-featured-filter="futuristic">
          <span class="featured-badge new">NEW</span>
          <div class="featured-svg-wrap">
            <svg width="54" height="54" viewBox="0 0 54 54" fill="none" aria-hidden="true">
              <defs><radialGradient id="fbg1" cx="50%" cy="30%" r="70%"><stop offset="0%" stop-color="#1a237e"/><stop offset="100%" stop-color="#0a0e24"/></radialGradient></defs>
              <rect width="54" height="54" rx="14" fill="url(#fbg1)"/>
              <ellipse cx="27" cy="28" rx="13" ry="11" stroke="#4fc3f7" stroke-width="1.5" fill="none" opacity="0.9"/>
              <path d="M20 24 Q27 20 34 24" stroke="#7c4dff" stroke-width="1.2" fill="none" opacity="0.8"/>
              <path d="M19 28 Q27 32 35 28" stroke="#4fc3f7" stroke-width="1.2" fill="none" opacity="0.6"/>
              <circle cx="27" cy="28" r="3.5" fill="#4fc3f7" opacity="0.9"/>
              <line x1="27" y1="17" x2="27" y2="14" stroke="#4fc3f7" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="27" cy="13" r="2" fill="#7c4dff"/>
              <line x1="14" y1="28" x2="11" y2="28" stroke="#4fc3f7" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="10" cy="28" r="2" fill="#4fc3f7" opacity="0.7"/>
              <line x1="40" y1="28" x2="43" y2="28" stroke="#4fc3f7" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="44" cy="28" r="2" fill="#4fc3f7" opacity="0.7"/>
              <circle cx="20" cy="24" r="1.5" fill="#7c4dff"/>
              <circle cx="34" cy="24" r="1.5" fill="#7c4dff"/>
              <circle cx="20" cy="32" r="1.5" fill="#4fc3f7" opacity="0.6"/>
              <circle cx="34" cy="32" r="1.5" fill="#4fc3f7" opacity="0.6"/>
            </svg>
          </div>
          <span class="featured-label">AI Brain</span>
        </button>

        <button type="button" class="featured-card amber" data-featured-filter="draw">
          <div class="featured-svg-wrap">
            <svg width="54" height="54" viewBox="0 0 54 54" fill="none" aria-hidden="true">
              <defs><radialGradient id="fbg2" cx="50%" cy="30%" r="70%"><stop offset="0%" stop-color="#2d1b00"/><stop offset="100%" stop-color="#0d0900"/></radialGradient></defs>
              <rect width="54" height="54" rx="14" fill="url(#fbg2)"/>
              <rect x="10" y="18" width="34" height="22" rx="4" fill="none" stroke="#ffb74d" stroke-width="1.5"/>
              <rect x="10" y="22" width="34" height="6" fill="#ffb74d" opacity="0.15"/>
              <rect x="35" y="24" width="10" height="10" rx="3" fill="#ffb74d" opacity="0.2" stroke="#ffb74d" stroke-width="1"/>
              <circle cx="40" cy="29" r="2.5" fill="#ffb74d" opacity="0.9"/>
              <line x1="10" y1="22" x2="44" y2="22" stroke="#ffb74d" stroke-width="1" opacity="0.4"/>
              <rect x="14" y="27" width="10" height="1.5" rx="1" fill="#ffb74d" opacity="0.5"/>
              <rect x="14" y="31" width="7" height="1.5" rx="1" fill="#ffb74d" opacity="0.3"/>
              <path d="M18 14 L36 14" stroke="#ffb74d" stroke-width="1.2" stroke-linecap="round" opacity="0.4"/>
            </svg>
          </div>
          <span class="featured-label">Wallet</span>
        </button>

        <button type="button" class="featured-card purple" data-featured-filter="purple">
          <span class="featured-badge pro">PRO</span>
          <div class="featured-svg-wrap">
            <svg width="54" height="54" viewBox="0 0 54 54" fill="none" aria-hidden="true">
              <defs><radialGradient id="fbg3" cx="50%" cy="30%" r="70%"><stop offset="0%" stop-color="#1a0a2e"/><stop offset="100%" stop-color="#080512"/></radialGradient></defs>
              <rect width="54" height="54" rx="14" fill="url(#fbg3)"/>
              <path d="M27 11 L39 16 L39 28 C39 35 33 40 27 43 C21 40 15 35 15 28 L15 16 Z" fill="none" stroke="#7c4dff" stroke-width="1.5"/>
              <path d="M27 13.5 L37 17.8 L37 28 C37 33.5 32.5 37.8 27 40.5 C21.5 37.8 17 33.5 17 28 L17 17.8 Z" fill="#7c4dff" opacity="0.12"/>
              <rect x="22" y="26" width="10" height="9" rx="2" fill="none" stroke="#ce93d8" stroke-width="1.2"/>
              <path d="M24 26 L24 23 C24 21.3 25.3 20 27 20 C28.7 20 30 21.3 30 23 L30 26" stroke="#ce93d8" stroke-width="1.2" fill="none"/>
              <circle cx="27" cy="30.5" r="1.5" fill="#7c4dff" opacity="0.9"/>
              <line x1="27" y1="30.5" x2="27" y2="33" stroke="#7c4dff" stroke-width="1.2"/>
            </svg>
          </div>
          <span class="featured-label">Shield Lock</span>
        </button>

        <button type="button" class="featured-card" data-featured-filter="blue">
          <div class="featured-svg-wrap">
            <svg width="54" height="54" viewBox="0 0 54 54" fill="none" aria-hidden="true">
              <defs><radialGradient id="fbg4" cx="50%" cy="30%" r="70%"><stop offset="0%" stop-color="#0a1a2e"/><stop offset="100%" stop-color="#050c1a"/></radialGradient></defs>
              <rect width="54" height="54" rx="14" fill="url(#fbg4)"/>
              <path d="M18 32 C14 32 11 29 11 25.5 C11 22.5 13 20 16 19.5 C16.5 16.5 19.5 14 23 14 C25.5 14 27.7 15.2 29 17 C30 16.4 31.2 16 32.5 16 C36.5 16 39.5 19 39.5 23 C39.5 23.3 39.5 23.7 39.4 24 C42.5 24.5 44 26.8 44 29 C44 31.5 41.8 33.5 39 33.5 L18 32Z" fill="none" stroke="#4fc3f7" stroke-width="1.4"/>
              <circle cx="27" cy="33" r="6" fill="none" stroke="#4fc3f7" stroke-width="1.4" opacity="0.8"/>
              <path d="M24 33 L27 30 L30 33" stroke="#4fc3f7" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              <path d="M30 33 L27 36 L24 33" stroke="#4fc3f7" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.5"/>
            </svg>
          </div>
          <span class="featured-label">Cloud Sync</span>
        </button>

        <button type="button" class="featured-card green" data-featured-filter="green">
          <span class="featured-badge hot">HOT</span>
          <div class="featured-svg-wrap">
            <svg width="54" height="54" viewBox="0 0 54 54" fill="none" aria-hidden="true">
              <defs><radialGradient id="fbg5" cx="50%" cy="30%" r="70%"><stop offset="0%" stop-color="#0a1f0a"/><stop offset="100%" stop-color="#040d04"/></radialGradient></defs>
              <rect width="54" height="54" rx="14" fill="url(#fbg5)"/>
              <path d="M8 27 L15 27 L18 20 L22 34 L26 23 L29 31 L32 27 L46 27" stroke="#66bb6a" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="8" cy="27" r="2" fill="#66bb6a" opacity="0.5"/>
              <circle cx="46" cy="27" r="2" fill="#66bb6a" opacity="0.5"/>
              <rect x="8" y="16" width="38" height="22" rx="2" fill="none" stroke="#66bb6a" stroke-width="0.5" opacity="0.15"/>
            </svg>
          </div>
          <span class="featured-label">Pulse</span>
        </button>

        <button type="button" class="featured-card amber" data-featured-filter="draw">
          <div class="featured-svg-wrap">
            <svg width="54" height="54" viewBox="0 0 54 54" fill="none" aria-hidden="true">
              <defs><radialGradient id="fbg6" cx="50%" cy="30%" r="70%"><stop offset="0%" stop-color="#1a1000"/><stop offset="100%" stop-color="#0a0600"/></radialGradient>
              <linearGradient id="fbatt" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#ffb74d" stop-opacity="0.9"/><stop offset="100%" stop-color="#f57c00" stop-opacity="0.7"/></linearGradient></defs>
              <rect width="54" height="54" rx="14" fill="url(#fbg6)"/>
              <rect x="14" y="18" width="26" height="18" rx="4" fill="none" stroke="#ffb74d" stroke-width="1.5"/>
              <rect x="40" y="23" width="4" height="8" rx="2" fill="#ffb74d" opacity="0.6"/>
              <rect x="17" y="21" width="6" height="12" rx="2" fill="url(#fbatt)" opacity="0.9"/>
              <rect x="25" y="21" width="6" height="12" rx="2" fill="url(#fbatt)" opacity="0.65"/>
              <rect x="33" y="21" width="5" height="12" rx="2" fill="url(#fbatt)" opacity="0.35"/>
            </svg>
          </div>
          <span class="featured-label">Battery</span>
        </button>

        <button type="button" class="featured-card" data-featured-filter="futuristic">
          <span class="featured-badge new">NEW</span>
          <div class="featured-svg-wrap">
            <svg width="54" height="54" viewBox="0 0 54 54" fill="none" aria-hidden="true">
              <defs><radialGradient id="fbg7" cx="50%" cy="30%" r="70%"><stop offset="0%" stop-color="#0f1a2e"/><stop offset="100%" stop-color="#060c18"/></radialGradient></defs>
              <rect width="54" height="54" rx="14" fill="url(#fbg7)"/>
