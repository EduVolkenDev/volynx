          <div class="featured-svg-wrap">
            <svg aria-hidden="true" width="54" height="54" viewBox="0 0 54 54" fill="none">
                    <defs><radialGradient id="fic5_bg5" cx="50%" cy="30%" r="70%"><stop offset="0%" stop-color="#0a1f0a"/><stop offset="100%" stop-color="#040d04"/></radialGradient></defs>
