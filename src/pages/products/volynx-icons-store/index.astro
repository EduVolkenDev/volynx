        <button type="button" class="featured-card green" data-featured-filter="green">
          <span class="featured-badge pro">PRO</span>
          <div class="featured-svg-wrap">
            <svg width="54" height="54" viewBox="0 0 54 54" fill="none" aria-hidden="true">
              <defs><radialGradient id="fbg10" cx="50%" cy="30%" r="70%"><stop offset="0%" stop-color="#0a160a"/><stop offset="100%" stop-color="#040a04"/></radialGradient></defs>
              <rect width="54" height="54" rx="14" fill="url(#fbg10)"/>
              <rect x="10" y="14" width="34" height="26" rx="5" fill="none" stroke="#66bb6a" stroke-width="1.3" opacity="0.7"/>
              <path d="M10 20 L44 20" stroke="#66bb6a" stroke-width="1" opacity="0.3"/>
              <circle cx="16" cy="17" r="1.5" fill="#66bb6a" opacity="0.5"/>
              <circle cx="21" cy="17" r="1.5" fill="#66bb6a" opacity="0.35"/>
              <circle cx="26" cy="17" r="1.5" fill="#66bb6a" opacity="0.2"/>
              <path d="M16 26 L20 29 L16 32" stroke="#66bb6a" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="23" y1="32" x2="32" y2="32" stroke="#66bb6a" stroke-width="1.5" stroke-linecap="round" opacity="0.8"/>
            </svg>
