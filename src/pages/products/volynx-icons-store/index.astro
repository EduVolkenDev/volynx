        <h3 style="color:#fff;font-size:1.25rem;margin-bottom:1.25rem;">${escHtml(icon.collection)}</h3>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:1.5rem;">
          <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:1rem;text-align:center;">
            <div style="color:rgba(255,255,255,.5);font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.25rem;">${colLabel}</div>
            <div style="color:#fff;font-size:1.5rem;font-weight:900;">${premiumMoney}</div>
          </div>
          <div style="background:linear-gradient(135deg,rgba(139,92,246,.2),rgba(255,0,110,.15));border:1px solid rgba(139,92,246,.4);border-radius:12px;padding:1rem;text-align:center;">
            <div style="color:rgba(200,150,255,.8);font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.25rem;">${comboLabel}</div>
            <div style="color:#fff;font-size:1.5rem;font-weight:900;">${hyperMoney}</div>
            <div style="color:rgba(200,150,255,.7);font-size:.65rem;margin-top:.15rem;">${comboHint}</div>
          </div>
        </div>

        <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;">
          <button id="premiumCollectionCheckoutBtn" style="padding:.75rem 1.5rem;background:linear-gradient(135deg,#8b5cf6,#ff006e);color:#fff;font-weight:700;border-radius:10px;border:none;font-size:.875rem;cursor:pointer;">${checkoutCollectionLabel}</button>
          <button id="premiumComboCheckoutBtn" style="padding:.75rem 1.5rem;background:linear-gradient(135deg,#00f0ff,#8b5cf6);color:#020617;font-weight:800;border-radius:10px;border:none;font-size:.875rem;cursor:pointer;">${checkoutComboLabel}</button>
          <a href="/products/volynx-icons-store/" style="padding:.75rem 1.5rem;background:transparent;color:#fff;font-weight:700;border-radius:10px;text-decoration:none;font-size:.875rem;border:1px solid rgba(255,255,255,.2);">${backLabel}</a>
        </div>
      `);
      document.getElementById("premiumCollectionCheckoutBtn")?.addEventListener("click", () => {
        startIconCheckout(ICON_PACK_PRICES.premium.lookup, document.getElementById("premiumCollectionCheckoutBtn"), {
          label: icon.collection,
          collection: icon.collection,
        });
      });
      document.getElementById("premiumComboCheckoutBtn")?.addEventListener("click", () => {
        startIconCheckout(ICON_PACK_PRICES.hyper.lookup, document.getElementById("premiumComboCheckoutBtn"), {
          label: storeLang() === "pt" ? "Combo premium completo" : "Full premium combo",
          collection: "__all_premium__",
        });
      });
    }

    // ===== NOTIFICATIONS =====
    function showNotification(message: string) {
      const n = document.createElement("div");
      n.className = "notification";
      n.textContent = message;
      document.body.appendChild(n);
      setTimeout(() => {
        n.classList.add("fade-out");
        setTimeout(() => { if (document.body.contains(n)) document.body.removeChild(n); }, 300);
      }, 3000);
    }

    // ===== SMOOTH SCROLL =====
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener("click", function (this: HTMLAnchorElement, e) {
        const href = this.getAttribute("href");
        if (!href || href === "#") return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: "smooth", block: "start" });
          // Close mobile menu if open
          document.getElementById("mobileMenu")?.classList.remove("show");
          document.getElementById("mobileMenuBtn")?.classList.remove("active");
        }
      });
    });
  </script>

