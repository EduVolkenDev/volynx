        return `<div class="single-modal-art single-modal-art--svg">${svg}</div>`;
      }
      return `
        <div class="single-modal-art">
          <img src="${escHtml(item.path)}" alt="" />
        </div>
      `;
    }

    function showSingleIconModal(item: any) {
      if (!item) return;
      const L = storeLang();
      const label = item.label || "Volynx Icon";
      const collection = item.collection || "Icon";
      // Only trust relatedCollection when the icon is a REAL catalog entry
      // (item.icon.collection exists in allIcons). Featured SVGs and asset
      // showcase SVGs carry a synthetic relatedCollection picked by category
      // fallback, which led clicks to the wrong pack (e.g. Wallet icon →
      // "Neon Icons" pack). For those decorative SVGs we hide the button.
      const catalogCollection = item.icon?.collection;
      const relatedCollection = (catalogCollection && allIcons.some((i) => i.collection === catalogCollection))
        ? catalogCollection
        : "";
      const hasPack = Boolean(relatedCollection);
      const requestHref = `${STORE_ROUTES.contact}?product=volynx-icons-store&intent=single-icon&icon=${encodeURIComponent(label)}&collection=${encodeURIComponent(collection)}`;
      const category = item.category || (item.icon?.category ?? "Icon");
      const checkoutLookup = item.checkoutLookup || ICON_PRICE_TIERS.standard.lookup;
      const buyCopy = L === "pt" ? "Comprar este ícone" : "Buy this icon";
      const packCopy = L === "pt" ? "Ver pack relacionado" : "Open related pack";
      const closeCopy = L === "pt" ? "Continuar olhando" : "Keep browsing";
      const format = item.type === "svg" ? "SVG" : "PNG";
      const bodyCopy = L === "pt"
        ? "Licencie este ícone sozinho com VX ou checkout Stripe. Se ele fizer parte de um pack, você também pode abrir a coleção completa sem sair da página."
        : "License this icon by itself with VX or Stripe checkout. If it belongs to a pack, you can also open the full collection without leaving this page.";

      openModal(`
        <div class="single-modal-shell">
          ${singleVisualMarkup(item)}
