  <script>
    // ===== STATE =====
    let isLoggedIn = false;
    let currentUser: { name: string; email: string } | null = null;
    let currentFilter = "all";
    let currentCollection: string | null = null;

    let allIcons: any[] = [];
    let assetSingles: any[] = [];
    let singleFormatFilter = "all";

    // Responsive page size: mobile 12, tablet 24, desktop 48.
    // Kept small to prevent a giant endless scroll on phones.
    function initialPageSize() {
      const w = window.innerWidth;
      if (w < 640) return 12;
      if (w < 1024) return 24;
      return 48;
    }
    let visibleCount = initialPageSize();
    // Catalog is deduped at generation time (see scripts/regenerate-icons-catalog.mjs).
    // Two disk folders can map to the same collection name — totals merge in the catalog.
    const DUPLICATE_COLLECTIONS = new Set();

    const STORE_TEXT = {
      en: {
        openPack: "Open pack",
        buySingle: "Buy single",
        download: "Download",
        showAll: "Show all icons",
        allMeta: "Browse all curated icons or open a pack below.",
        packMeta: (count: number) => `${count.toLocaleString()} icons in this pack. Select any icon to preview it.`,
        categoryMeta: (count: number, label: string) => `${count.toLocaleString()} icons in ${label}.`,
        emptyKicker: "No icons found",
        emptyTitle: "This pack is empty.",
        emptyText: "Choose another pack or reset the gallery.",
      },
      pt: {
        openPack: "Abrir pack",
        buySingle: "Comprar avulso",
        download: "Baixar",
        showAll: "Ver todos os ícones",
        allMeta: "Veja todos os ícones curados ou abra um pack abaixo.",
        packMeta: (count: number) => `${count.toLocaleString("pt-BR")} ícones neste pack. Selecione qualquer ícone para visualizar.`,
        categoryMeta: (count: number, label: string) => `${count.toLocaleString("pt-BR")} ícones em ${label}.`,
        emptyKicker: "Nenhum ícone encontrado",
        emptyTitle: "Este pack está vazio.",
        emptyText: "Escolha outro pack ou redefina a galeria.",
      },
    };

    const STORE_ROUTES = {
      contact: "/contact/",
      login: "/login/",
      signup: "/signup/",
      iconsStore: "/products/volynx-icons-store/",
    };

    const ICON_PRICE_TIERS = {
      free: { vx: "0 VX", money: "", lookup: "", label: "Free" },
      budget: { vx: "9 VX", money: "£0.80", lookup: "icons_single_budget", label: "Budget single" },
      standard: { vx: "24 VX", money: "£1.70", lookup: "icons_single_standard", label: "Standard single" },
      premium: { vx: "45 VX", money: "£2.90", lookup: "icons_single_premium", label: "Premium single" },
      hyper: { vx: "120 VX", money: "£7.50", lookup: "icons_single_hyper", label: "Hyper 5000px single" },
    } as const;

    const ICON_PACK_PRICES = {
      free: { label: "Free with signup", lookup: "", display: "", vx: "" },
      mixed: { label: "90 VX · £6.40", lookup: "icons_pack_mixed", display: "90 VX · £6.40", vx: "90 VX" },
      premium: { label: "260 VX · £14", lookup: "icons_pack_premium", display: "260 VX · £14", vx: "260 VX" },
      hyper: { label: "5000px Hyper pack · £48", lookup: "icons_pack_hyper", display: "820 VX · £48", vx: "820 VX" },
    } as const;

    // Mirrors scripts/stripe-catalog-setup.ts (amounts in cents)
    const ICON_MONEY_CENTS: Record<string, { gbp: number; eur: number; brl: number }> = {
      icons_single_budget:   { gbp: 80,   eur: 95,   brl: 550   },
      icons_single_standard: { gbp: 170,  eur: 195,  brl: 1190  },
      icons_single_premium:  { gbp: 290,  eur: 340,  brl: 1890  },
      icons_single_hyper:    { gbp: 750,  eur: 870,  brl: 4900  },
      icons_pack_mixed:      { gbp: 640,  eur: 750,  brl: 4200  },
      icons_pack_premium:    { gbp: 1400, eur: 1600, brl: 9200  },
      icons_pack_hyper:      { gbp: 4800, eur: 5600, brl: 32000 },
    };

    function localizedMoney(lookup: string | undefined | null) {
      if (!lookup) return "";
      const cents = ICON_MONEY_CENTS[lookup];
      if (!cents) return "";
      const cur = checkoutCurrency() as "gbp" | "eur" | "brl";
      const amount = (cents[cur] || 0) / 100;
      if (cur === "brl") return "R$" + amount.toFixed(2).replace(".", ",");
      if (cur === "eur") return "€" + amount.toFixed(2);
      return "£" + amount.toFixed(2);
    }

    function storeLang() {
      return localStorage.getItem("volynx_lang") === "pt" ? "pt" : "en";
    }

    function storeText(key: keyof typeof STORE_TEXT.en) {
      return STORE_TEXT[storeLang()][key] as string;
    }

    function checkoutCurrency() {
      const value = new URLSearchParams(window.location.search).get("currency") || localStorage.getItem("volynx_currency") || "gbp";
      return ["gbp", "eur", "brl"].includes(value.toLowerCase()) ? value.toLowerCase() : "gbp";
    }

    async function freshAccessToken() {
      let token = localStorage.getItem("volynx_access_token") || "";
      const refreshToken = localStorage.getItem("volynx_refresh_token") || "";
      if (!token || !refreshToken) return token;
      try {
        const cfg = await fetch("/config.json", { cache: "no-store" }).then(r => r.ok ? r.json() : null);
        if (!cfg?.supabaseUrl || !cfg?.supabaseAnonKey) return token;
        const rr = await fetch(cfg.supabaseUrl + "/auth/v1/token?grant_type=refresh_token", {
          method: "POST",
          headers: { apikey: cfg.supabaseAnonKey, "Content-Type": "application/json" },
          body: JSON.stringify({ refresh_token: refreshToken }),
        });
        if (!rr.ok) return token;
        const sess = await rr.json();
        if (sess.access_token) {
          token = sess.access_token;
          localStorage.setItem("volynx_access_token", sess.access_token);
          if (sess.refresh_token) localStorage.setItem("volynx_refresh_token", sess.refresh_token);
        }
      } catch (e) {}
      return token;
    }

    async function startIconCheckout(lookupPrefix: string, trigger?: HTMLElement | null, iconItem?: any) {
      if (!lookupPrefix) {
        window.location.href = `${STORE_ROUTES.signup}?next=${encodeURIComponent(STORE_ROUTES.iconsStore)}`;
        return;
      }

      const token = await freshAccessToken();
      if (!token) {
        window.location.href = `${STORE_ROUTES.login}?next=${encodeURIComponent(STORE_ROUTES.iconsStore)}`;
        return;
      }

      const originalText = trigger?.textContent || "";
      try {
        if (trigger) {
          trigger.textContent = storeLang() === "pt" ? "Abrindo checkout..." : "Opening checkout...";
          trigger.style.pointerEvents = "none";
        }
        const cfg = await fetch("/config.json", { cache: "no-store" }).then(r => r.ok ? r.json() : null);
        const apiBase = String(cfg?.functionsUrl || cfg?.apiBaseUrl || "").replace(/\/$/, "");
        if (!apiBase) throw new Error("Checkout endpoint is not configured.");
        const lookupKey = `${lookupPrefix}_${checkoutCurrency()}`;
        // Pass the specific icon metadata so the webhook can record exactly
        // what was purchased and later power a deliverable (download / email).
        const iconMeta: Record<string, string> = {};
        if (iconItem) {
          if (iconItem.icon?.id) iconMeta.icon_id = String(iconItem.icon.id);
          else if (iconItem.label) iconMeta.icon_id = `inline-${String(iconItem.label).toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
          if (iconItem.label) iconMeta.icon_label = String(iconItem.label).slice(0, 200);
          if (iconItem.path || iconItem.icon?.path) iconMeta.icon_path = String(iconItem.path || iconItem.icon.path).slice(0, 400);
          if (iconItem.collection) iconMeta.icon_collection = String(iconItem.collection).slice(0, 120);
        }
        const res = await fetch(`${apiBase}/create-checkout-session`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify({
            lookup_key: lookupKey,
            success_url: `${window.location.origin}/profile/?payment=success&product=icons-store`,
            cancel_url: `${window.location.origin}${STORE_ROUTES.iconsStore}?payment=cancelled`,
            ...iconMeta,
          }),
        });
        const data = await res.json();
        if (data.url) {
          window.location.href = data.url;
          return;
        }
        throw new Error(data.error || data.message || "Checkout failed.");
      } catch (e) {
        console.error("[icons-store] checkout failed:", e);
        showNotification(e instanceof Error ? e.message : "Checkout failed.");
        if (trigger) {
          trigger.textContent = originalText || (storeLang() === "pt" ? "Tentar novamente" : "Try again");
          trigger.style.pointerEvents = "";
        }
      }
    }

    // ===== INIT =====
    document.addEventListener("DOMContentLoaded", async () => {
      initNavigation();
      initModal();
      initFilters();
      checkAuth();
      await loadCatalog();
      await loadAssetShowcase();
      harvestFeaturedSingles();
      renderSingleIcons();

      const y = document.getElementById("y");
      if (y) y.textContent = String(new Date().getFullYear());

      // Catalog is browsable by pack; gated downloads still use the modal flow.
    });

    // ===== NAVIGATION =====
    function initNavigation() {
      const mobileMenuBtn = document.getElementById("mobileMenuBtn");
      const mobileMenu = document.getElementById("mobileMenu");
      const userMenuBtn = document.getElementById("userMenuBtn");
      const dropdownMenu = document.getElementById("dropdownMenu");

      if (mobileMenuBtn && mobileMenu) {
        mobileMenuBtn.addEventListener("click", () => {
          mobileMenuBtn.classList.toggle("active");
          mobileMenu.classList.toggle("show");
        });
      }

      if (userMenuBtn && dropdownMenu) {
        userMenuBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          dropdownMenu.classList.toggle("show");
        });
        document.addEventListener("click", (e) => {
          if (!userMenuBtn.contains(e.target as Node) && !dropdownMenu.contains(e.target as Node)) {
            dropdownMenu.classList.remove("show");
          }
        });
      }

      const signInBtn = document.getElementById("signInBtn");
      const logoutBtn = document.getElementById("logoutBtn");
      if (logoutBtn) logoutBtn.addEventListener("click", logout);

      // Favorites links — no favorites section exists on this page yet
      const favoritesLinks = [
        document.getElementById("dropdownFavoritesBtn"),
        document.getElementById("favoritesBtn"),
        document.getElementById("mobileFavoritesBtn"),
      ];
      favoritesLinks.forEach(el => {
        if (!el) return;
        el.addEventListener("click", (e) => {
          e.preventDefault();
          document.getElementById("dropdownMenu")?.classList.remove("show");
          // Close mobile menu if open
          document.getElementById("mobileMenu")?.classList.remove("show");
          document.getElementById("mobileMenuBtn")?.classList.remove("active");
          if (isLoggedIn) {
            showNotification(storeLang() === "pt" ? "Favoritos em desenvolvimento." : "Favorites are in development.");
          } else {
            showNotification(storeLang() === "pt" ? "Entre para salvar favoritos." : "Sign in to save favorites.");
          }
        });
      });

      // "View All" collections button — scroll to gallery and reset to every icon
      const viewAllBtn = document.getElementById("viewAllBtn");
      if (viewAllBtn) {
        viewAllBtn.addEventListener("click", (e) => {
          e.preventDefault();
          clearPackSelection(true);
        });
      }

      document.getElementById("packResetBtn")?.addEventListener("click", () => {
        clearPackSelection(false);
      });
    }

    // Pull the 40 inline neon SVG cards from the Featured section into the
    // single-icons SVG pool so they surface under the "SVG" filter.
    function harvestFeaturedSingles() {
      const cards = document.querySelectorAll<HTMLButtonElement>(".featured-card[data-featured-filter]");
      const items = Array.from(cards).map((card) => {
        const svgEl = card.querySelector(".featured-svg-wrap svg");
        const label = card.querySelector(".featured-label")?.textContent?.trim() || "Neon Icon";
        const filterKey = card.dataset.featuredFilter || "futuristic";
        return {
          type: "svg",
          label,
          number: "",
          svg: svgEl ? svgEl.outerHTML : "",
          category: "Neon Essentials",
          collection: "Neon Essentials",
          relatedCollection: findCollectionForCategory(filterKey) || "Neon Icons",
          priceVX: ICON_PRICE_TIERS.standard.vx,
          money: ICON_PRICE_TIERS.standard.money,
          checkoutLookup: ICON_PRICE_TIERS.standard.lookup,
          priceTier: ICON_PRICE_TIERS.standard.label,
        };
      }).filter((item) => item.svg);
      // Prepend neon essentials so they render first in the SVG filter
      assetSingles = [...items, ...assetSingles];
    }

    async function loadAssetShowcase() {
      const mount = document.getElementById("assetShowcaseGrid");
      if (!mount) return;

      try {
        const res = await fetch("/assets/icons-store/volynx-icons-gallery.html", { cache: "no-store" });
        if (!res.ok) throw new Error(`HTTP ${res.status} fetching volynx-icons-gallery.html`);

        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, "text/html");
        const defsSvg = doc.querySelector('svg[width="0"][height="0"]');
        const categories = Array.from(doc.querySelectorAll(".category")).map((section, index) => {
          const title = section.querySelector(".category-name")?.textContent?.trim() || `Category ${index + 1}`;
          const count = section.querySelector(".category-count")?.textContent?.trim() || "";
          const cards = Array.from(section.querySelectorAll(".card")).map((card) => ({
            label: card.querySelector(".card-label")?.textContent?.trim() || "Icon",
            number: card.querySelector(".card-num")?.textContent?.trim() || "",
            svg: card.querySelector(".icon-wrap svg")?.outerHTML || "",
          })).filter((card) => card.svg);
          return { title, count, cards };
        }).filter((category) => category.cards.length);

        if (!categories.length) throw new Error("No categories found in source gallery HTML");
        assetSingles = categories.flatMap((category) => category.cards.map((card) => ({
          type: "svg",
          label: card.label,
          number: card.number,
          svg: card.svg,
          category: category.title,
          collection: "SVG Essentials",
          relatedCollection: findCollectionForCategory("futuristic") || "Neon Icons",
          priceVX: ICON_PRICE_TIERS.budget.vx,
          money: ICON_PRICE_TIERS.budget.money,
          checkoutLookup: ICON_PRICE_TIERS.budget.lookup,
          priceTier: ICON_PRICE_TIERS.budget.label,
        })));

        mount.innerHTML = `
          ${defsSvg ? `<div class="asset-showcase-defs" aria-hidden="true">${defsSvg.outerHTML}</div>` : ""}
          ${categories.map((category) => `
            <section class="asset-category" data-category="${escHtml(category.title)}">
              <div class="asset-category-head">
                <h3 class="asset-category-title">${escHtml(category.title)}</h3>
                <span class="asset-category-count">${escHtml(category.count)}</span>
              </div>
              <div class="asset-category-grid">
                ${category.cards.map((card) => `
                  <button type="button" class="asset-card" data-label="${escHtml(card.label)}" data-number="${escHtml(card.number)}">
                    <span class="asset-card-icon">${card.svg}</span>
                    <span class="asset-card-label">${escHtml(card.label)}</span>
                    <span class="asset-card-number">${escHtml(card.number)}</span>
                  </button>
                `).join("")}
              </div>
            </section>
          `).join("")}
        `;

        mount.querySelectorAll<HTMLButtonElement>(".asset-card").forEach((card) => {
          card.addEventListener("click", () => {
            const item = assetSingles.find((single) => single.label === card.dataset.label && single.number === card.dataset.number);
            showSingleIconModal(item || assetCardToSingleItem(card));
          });
        });
      } catch (e) {
        console.error("[icons-store] asset showcase load failed:", e);
        mount.innerHTML = `
          <article class="soon-panel">
            <p class="soon-kicker">Asset showcase unavailable</p>
            <h3>The new asset HTML could not be loaded.</h3>
            <p>${e instanceof Error ? e.message : "Unknown error."}</p>
          </article>
        `;
      }
    }

    // ===== CATALOG =====
    async function loadCatalog() {
      try {
        const res = await fetch("/assets/icons-store/catalog.json", { cache: "no-store" });
        if (!res.ok) throw new Error(`HTTP ${res.status} fetching catalog.json`);
        const parsed = await res.json();
        if (!Array.isArray(parsed)) throw new Error("catalog.json is not an array");
        allIcons = parsed;
        console.info(`[icons-store] catalog loaded: ${allIcons.length} icons across ${new Set(allIcons.map(i => i.collection)).size} packs`);
        updateGalleryHeading();
        renderGallery();
        updateStats();
      } catch (e) {
        console.error("[icons-store] catalog load failed:", e);
        const grid = document.getElementById("galleryGrid");
        if (grid) {
          grid.innerHTML = `
            <article class="soon-panel">
              <p class="soon-kicker">Vault unavailable</p>
              <h3>Icon packs could not load.</h3>
              <p>Check browser console for details. ${e instanceof Error ? e.message : ""}</p>
            </article>
          `;
        }
      }
    }

    function updateStats() {
      const total = allIcons.length;
      const packs = new Set(allIcons.map(packFolder)).size;
      const heroCount = document.getElementById('heroIconCount');
      if (heroCount) heroCount.textContent = total.toLocaleString() + '+';
      const statEls = document.querySelectorAll<HTMLElement>(".stat-number");
      if (statEls[0]) statEls[0].textContent = total.toLocaleString() + '+';
      if (statEls[1]) statEls[1].textContent = String(packs);
      renderCollections();
    }

    function packFolder(icon: any) {
      const match = String(icon?.path || "").match(/^\/assets\/icons-store\/([^/]+)\//);
      return match?.[1] || icon?.collection || icon?.category || "unknown";
    }

    // ===== FEATURED COLLECTIONS =====
    function escHtml(value: unknown) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    const COLLECTION_PALETTES = [
      { match: "Abstract", accent: "#ff5ec4", soft: "rgba(255,94,196,0.16)", bg: "#211021", border: "rgba(255,94,196,0.34)" },
      { match: "Big Icons", accent: "#ffd166", soft: "rgba(255,209,102,0.16)", bg: "#221a0c", border: "rgba(255,209,102,0.32)" },
      { match: "Chromed", accent: "#b8d8ff", soft: "rgba(184,216,255,0.16)", bg: "#121821", border: "rgba(184,216,255,0.32)" },
      { match: "Day by Day", accent: "#7dd3fc", soft: "rgba(125,211,252,0.15)", bg: "#0d1b24", border: "rgba(125,211,252,0.32)" },
      { match: "Glass", accent: "#a5f3fc", soft: "rgba(165,243,252,0.16)", bg: "#0d1f22", border: "rgba(165,243,252,0.32)" },
      { match: "Greens", accent: "#86efac", soft: "rgba(134,239,172,0.16)", bg: "#0d2016", border: "rgba(134,239,172,0.32)" },
      { match: "Hyper", accent: "#38bdf8", soft: "rgba(56,189,248,0.18)", bg: "#0a1724", border: "rgba(56,189,248,0.35)" },
      { match: "Iridescent", accent: "#f0abfc", soft: "rgba(240,171,252,0.16)", bg: "#211328", border: "rgba(240,171,252,0.32)" },
      { match: "Metal", accent: "#cbd5e1", soft: "rgba(203,213,225,0.15)", bg: "#141923", border: "rgba(203,213,225,0.28)" },
      { match: "Nature", accent: "#bef264", soft: "rgba(190,242,100,0.14)", bg: "#18210e", border: "rgba(190,242,100,0.3)" },
      { match: "Neon", accent: "#00f0ff", soft: "rgba(0,240,255,0.18)", bg: "#071c25", border: "rgba(0,240,255,0.35)" },
      { match: "Pink", accent: "#fb7185", soft: "rgba(251,113,133,0.15)", bg: "#241018", border: "rgba(251,113,133,0.32)" },
      { match: "Polygon", accent: "#f97316", soft: "rgba(249,115,22,0.14)", bg: "#23170d", border: "rgba(249,115,22,0.32)" },
      { match: "Purple", accent: "#c084fc", soft: "rgba(192,132,252,0.16)", bg: "#1b1228", border: "rgba(192,132,252,0.34)" },
      { match: "Purples", accent: "#a78bfa", soft: "rgba(167,139,250,0.16)", bg: "#18122a", border: "rgba(167,139,250,0.34)" },
      { match: "SVG", accent: "#78dcff", soft: "rgba(120,220,255,0.18)", bg: "#0a1824", border: "rgba(120,220,255,0.34)" },
    ];

    function collectionPalette(collection = "") {
      return COLLECTION_PALETTES.find((palette) => collection.includes(palette.match))
        || COLLECTION_PALETTES[Math.abs(hashString(collection)) % COLLECTION_PALETTES.length];
    }

    function hashString(value: string) {
      return Array.from(value || "volynx").reduce((hash, char) => ((hash << 5) - hash) + char.charCodeAt(0), 0);
    }

    function collectionStyle(collection = "") {
      const p = collectionPalette(collection);
      return `--collection-accent:${p.accent};--collection-soft:${p.soft};--collection-bg:${p.bg};--collection-border:${p.border};`;
    }

    function isPremiumIcon(icon: any) {
      return icon?.plan === "premium" || icon?.plan === "paid";
    }

    function isHyperIcon(icon: any) {
      const haystack = [
        icon?.collection,
        icon?.category,
        icon?.path,
        icon?.file,
        icon?.label,
        icon?.name,
      ].join(" ").toLowerCase();
      return haystack.includes("hyper");
    }

    function displayIconName(icon: any) {
      const raw = String(icon?.name || icon?.file || "Icon")
        .replace(/\.[a-z0-9]+$/i, "")
        .replace(/[-_]+/g, " ")
        .replace(/\b(icon|icons|premium|refactored)\b/gi, "")
        .replace(/\s+/g, " ")
        .trim();
      if (!raw) return icon?.collection || "Volynx Icon";
      return raw.replace(/\b\w/g, (letter) => letter.toUpperCase());
    }

    function singlePriceForIcon(icon: any) {
      if (!icon) return ICON_PRICE_TIERS.standard;
      if (isHyperIcon(icon)) return ICON_PRICE_TIERS.hyper;
      if (isPremiumIcon(icon)) {
        // Every premium-plan icon ships at the premium single-icon tier.
        // Previous logic forked by collection name (chromed/iridescent/metal
        // got premium; Soft Blue / Glow / Vintage / Purple Icons fell to
        // standard or budget) — that made newer premium packs look underpriced.
        return ICON_PRICE_TIERS.premium;
      }
      return ICON_PRICE_TIERS.budget;
    }

    function iconToSingleItem(icon: any) {
      const price = singlePriceForIcon(icon);
      return {
        type: "png",
        icon,
        label: displayIconName(icon),
        category: CATEGORY_CONFIG.find(c => c.key === icon.category)?.label || icon.category || "Icon",
        collection: icon.collection || "Icon Pack",
        relatedCollection: icon.collection || "",
        path: icon.path,
        priceVX: price.vx,
        money: price.money,
        checkoutLookup: price.lookup,
        priceTier: price.label,
      };
    }

    function packPriceForCollection(collection: string, icons: any[]) {
      const freeCount = icons.filter((icon) => icon.plan === "free").length;
      if (freeCount === icons.length) return ICON_PACK_PRICES.free;
      if (collection.toLowerCase().includes("hyper")) return ICON_PACK_PRICES.hyper;
      if (freeCount === 0) return ICON_PACK_PRICES.premium;
      return ICON_PACK_PRICES.mixed;
    }

    function pickEvenly(items: any[], count: number) {
      if (items.length <= count) return items;
      if (count <= 1) return items.slice(0, count);
      const last = items.length - 1;
      return Array.from({ length: count }, (_, i) => items[Math.round((last / (count - 1)) * i)]);
    }

    function getCuratedPngSingles() {
      const preferred = ["Metal Chrome", "Iridescent", "Glow", "Hyper Icons", "Glass Icons", "Vintage", "Purple Icons", "Soft Blue", "Soft Dark Blue", "Soft Green", "Soft Orange", "Soft Red", "Polygon", "Neon Icons"];
      const picks: any[] = [];
      preferred.forEach((collection) => {
        const icons = allIcons.filter((icon) => icon.collection === collection);
        if (!icons.length) return;
        // 4 per collection gives every pack a fair showcase regardless of size
        picks.push(...pickEvenly(icons, 4));
      });
      // Previous slice(0, 30) dropped the last ~4 packs (Soft Orange/Red,
      // Polygon, Neon). Lift the cap so every green/purple-tagged pack lands
      // at least one representative icon in the Single Icons PNG filter.
      return picks.filter(Boolean).slice(0, 80).map(iconToSingleItem);
    }

    function getSingleIconItems() {
      const png = getCuratedPngSingles();
      const svg = assetSingles;
      const merged = [...png, ...svg];
      if (singleFormatFilter === "png") return png;
      if (singleFormatFilter === "svg") return svg;
      return merged;
    }

    function assetCardToSingleItem(card: HTMLButtonElement) {
      const svgEl = card.querySelector(".asset-card-icon svg");
      const category = card.closest(".asset-category")?.getAttribute("data-category") || "SVG Essentials";
      return {
        type: "svg",
        label: card.dataset.label || "SVG Icon",
        number: card.dataset.number || "",
        svg: svgEl ? svgEl.outerHTML : "",
        category,
        collection: "SVG Essentials",
        relatedCollection: findCollectionForCategory("futuristic") || "Neon Icons",
        priceVX: ICON_PRICE_TIERS.standard.vx,
        money: ICON_PRICE_TIERS.standard.money,
        checkoutLookup: ICON_PRICE_TIERS.standard.lookup,
        priceTier: ICON_PRICE_TIERS.standard.label,
      };
    }

    function singleCardMarkup(item: any, index: number) {
      const isSvg = item.type === "svg";
      const visual = isSvg
        ? `<span class="single-icon-visual single-icon-visual--svg">${item.svg || ""}</span>`
        : `<span class="single-icon-visual"><img src="${escHtml(item.path)}" alt="" loading="lazy" /></span>`;
      const money = localizedMoney(item.checkoutLookup) || item.money || "";
      return `
        <button type="button" class="single-icon-card single-icon-card--${isSvg ? "svg" : "png"}" style="${collectionStyle(item.collection)}" data-single-index="${index}">
          <span class="single-icon-format">${isSvg ? "SVG" : "PNG"}</span>
          ${visual}
          <span class="single-icon-name">${escHtml(item.label)}</span>
          <span class="single-icon-collection">${escHtml(item.collection)}</span>
          <span class="single-icon-price">${escHtml(item.priceVX)}${money ? ` · ${escHtml(money)}` : ""}</span>
        </button>
      `;
    }

    function renderSingleIcons() {
      const grid = document.getElementById("singleIconsGrid");
      if (!grid) return;
      const items = getSingleIconItems();
      if (!items.length) {
        grid.innerHTML = `
          <article class="soon-panel">
            <p class="soon-kicker">${storeLang() === "pt" ? "Singles carregando" : "Singles loading"}</p>
            <h3>${storeLang() === "pt" ? "A galeria premium está sendo preparada." : "The premium gallery is being prepared."}</h3>
            <p>${storeLang() === "pt" ? "Os melhores PNG e SVG aparecerão aqui." : "The best PNG and SVG singles will appear here."}</p>
          </article>
        `;
        return;
      }

      grid.innerHTML = items.map((item, index) => singleCardMarkup(item, index)).join("");
      grid.querySelectorAll<HTMLButtonElement>(".single-icon-card").forEach((card) => {
        card.addEventListener("click", () => {
          const index = Number(card.dataset.singleIndex || 0);
          showSingleIconModal(items[index]);
        });
      });
    }

    function findCollectionForCategory(category: string) {
      const groups = getCollectionGroups().filter((group) => group.icons.some((icon) => icon.category === category));
      if (!groups.length) return "";
      groups.sort((a, b) => {
        const premiumDelta = Number(b.icons.some(isPremiumIcon)) - Number(a.icons.some(isPremiumIcon));
        if (premiumDelta) return premiumDelta;
        return b.icons.length - a.icons.length;
      });
      return groups[0].name;
    }

    function getCollectionGroups() {
      const groups = new Map<string, any[]>();
      allIcons.forEach(icon => {
        const name = icon.collection || icon.category || "Icon Pack";
        if (!groups.has(name)) groups.set(name, []);
        groups.get(name)?.push(icon);
      });

      return Array.from(groups.entries())
        .map(([name, icons]) => ({ name, icons }))
        .sort((a, b) => a.name.localeCompare(b.name));
    }

    function renderCollections() {
      const grid = document.getElementById("collectionsGrid");
      if (!grid || !allIcons.length) return;
      grid.innerHTML = "";

      getCollectionGroups().forEach(pack => {
        const previews = pack.icons.slice(0, 4).map(i =>
          `<div class="preview-icon">
            <img src="${i.path}" alt="" style="width:100%;height:100%;object-fit:contain;" loading="lazy" />
          </div>`
        ).join("");

        const count = pack.icons.length;
        const freeCount = pack.icons.filter(i => i.plan === "free").length;
        const isPremium = freeCount === 0;
        const isFree = freeCount === count;
        const firstCategory = CATEGORY_CONFIG.find(c => c.key === pack.icons[0]?.category)?.label || pack.icons[0]?.category || "Icon Pack";
        const planLabel = isPremium ? "PREMIUM" : isFree ? "FREE" : "MIXED";
        const planClass = isPremium ? "premium" : isFree ? "free" : "mixed";

        const card = document.createElement("article");
        card.className = "collection-card" + (isPremium ? " collection-card--premium" : "");
        card.tabIndex = 0;
        card.dataset.collection = pack.name;
        card.setAttribute("style", collectionStyle(pack.name));
        card.style.cursor = "pointer";
        card.innerHTML = `
          <span class="collection-plan-badge collection-plan-badge--${planClass}">${planLabel}</span>
          <div class="collection-preview">${previews}</div>
          <div class="collection-meta-row">
            <span class="collection-category">${escHtml(firstCategory)}</span>
            <p class="collection-count">${count} icons</p>
          </div>
          <h3 class="collection-title">${escHtml(pack.name)}</h3>
          <button class="collection-open-btn" type="button">${storeText("openPack")}</button>
        `;

        const open = () => openPack(pack.name);
        card.addEventListener("click", open);
        card.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            open();
          }
        });
        card.querySelector("button")?.addEventListener("click", (e) => {
          e.stopPropagation();
          open();
        });

        grid.appendChild(card);
      });
    }

    // ===== CATEGORY CONFIG =====
    const CATEGORY_CONFIG = [
      { key: "pink",       label: "Pink Icons",       color: "#f48fb1", glow: "rgba(244,143,177,0.2)" },
      { key: "futuristic", label: "Futuristic Icons",  color: "#00f0ff", glow: "rgba(0,240,255,0.2)"   },
      { key: "green",      label: "Green Icons",       color: "#66bb6a", glow: "rgba(102,187,106,0.2)" },
      { key: "simple",     label: "Simple Icons",      color: "#e8eaf6", glow: "rgba(232,234,246,0.15)" },
      { key: "draw",       label: "Draw Icons",        color: "#ffb74d", glow: "rgba(255,183,77,0.2)"  },
      { key: "metal",      label: "Metal Icons",       color: "#90a4ae", glow: "rgba(144,164,174,0.2)" },
      { key: "blue",       label: "Blue Icons",        color: "#4fc3f7", glow: "rgba(79,195,247,0.2)"  },
      { key: "purple",     label: "Purple Icons",      color: "#b39ddb", glow: "rgba(179,157,219,0.2)" },
      { key: "food",       label: "Food Icons",        color: "#ff8a65", glow: "rgba(255,138,101,0.2)"  },
    ];

    function getFilteredIcons() {
      if (currentCollection) return allIcons.filter(i => i.collection === currentCollection);
      if (currentFilter === "all") return allIcons;
      return allIcons.filter(i => i.category === currentFilter);
    }

    function updateGalleryHeading() {
      const title = document.getElementById("iconsGalleryTitle");
      const meta = document.getElementById("iconsGalleryMeta");
      const reset = document.getElementById("packResetBtn") as HTMLButtonElement | null;
      const filtered = getFilteredIcons();

      if (currentCollection) {
        if (title) title.textContent = currentCollection;
        if (meta) meta.textContent = STORE_TEXT[storeLang()].packMeta(filtered.length);
        if (reset) {
          reset.textContent = storeText("showAll");
          reset.hidden = false;
        }
        return;
      }

      const label = CATEGORY_CONFIG.find(c => c.key === currentFilter)?.label;
      if (title) title.textContent = label || "Icon Vault";
      if (meta) meta.textContent = currentFilter === "all"
        ? storeText("allMeta")
        : STORE_TEXT[storeLang()].categoryMeta(filtered.length, label || currentFilter);
      if (reset) {
        reset.textContent = storeText("showAll");
        reset.hidden = true;
      }
    }

    function openPack(collection: string) {
      showPackModal(collection);
    }

    function clearPackSelection(scrollToGallery = false) {
      currentCollection = null;
      currentFilter = "all";
      visibleCount = initialPageSize();
      document.querySelectorAll<HTMLButtonElement>(".filter-btn").forEach(b => {
        b.classList.toggle("active", b.dataset.filter === "all");
      });
      updateGalleryHeading();
      renderGallery();
      if (scrollToGallery) document.getElementById("gallery")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function renderGallery() {
      const grid = document.getElementById("galleryGrid");
      if (!grid) return;
      grid.innerHTML = "";
      const filtered = getFilteredIcons();

      if (!filtered.length) {
        grid.innerHTML = `
          <article class="soon-panel">
            <p class="soon-kicker">${storeText("emptyKicker")}</p>
            <h3>${storeText("emptyTitle")}</h3>
            <p>${storeText("emptyText")}</p>
          </article>
        `;
      } else {
        filtered.slice(0, visibleCount).forEach(icon => grid.appendChild(createIconCard(icon)));
      }

      const btn = document.getElementById("loadMoreBtn");
      const count = document.getElementById("loadMoreCount");
      const shown = Math.min(visibleCount, filtered.length);
      const total = filtered.length;
      const hasMore = !currentCollection && total > visibleCount;
      if (btn) btn.style.display = hasMore ? "inline-flex" : "none";
      if (count) {
        if (!total) { count.textContent = ""; }
        else {
          const L = storeLang();
          count.textContent = L === "pt"
            ? `${shown} de ${total} ícones`
            : `${shown} of ${total} icons`;
        }
      }
    }

    function createIconCard(icon: any) {
      const isPaid = icon.plan === "premium" || icon.plan === "paid";
      const card = document.createElement("div");
      card.className = "icon-card icon-card--" + icon.category + (isPaid ? " icon-card--premium" : "");
      card.dataset.category = icon.category;
      card.dataset.plan = icon.plan;
      card.setAttribute("style", collectionStyle(icon.collection || icon.category));
      card.innerHTML = `
        ${isPaid ? '<span class="icon-pro-badge">' + (icon.plan === "paid" ? "PAID" : "PREMIUM") + '</span>' : ""}
        <div class="icon-img-wrap">
          <img src="${icon.path}" alt="${icon.collection ?? icon.category}" loading="lazy" />
        </div>
        <span class="icon-collection-label">${icon.collection ?? icon.category}</span>
      `;
      card.addEventListener("click", () => showSingleIconModal(iconToSingleItem(icon)));
      return card;
    }

    // ===== AUTH =====
    function checkAuth() {
      try {
        const token = localStorage.getItem("volynx_access_token");
        const sessionRaw = localStorage.getItem("volynx_session");
        if (token && sessionRaw) {
          const session = JSON.parse(sessionRaw);
          const meta = session?.user?.user_metadata || {};
          isLoggedIn = true;
          currentUser = {
            name: meta.full_name || meta.username || meta.name || session?.user?.email?.split("@")[0] || "User",
            email: session?.user?.email || ""
          };
          updateAuthUI();
          // Also try to fetch profile for latest name/username
          fetchProfileName(token);
        }
      } catch (e) {}
    }

    async function fetchProfileName(token: string) {
      try {
        const res = await fetch("/config.json", { cache: "no-store" });
        if (!res.ok) return;
        const cfg = await res.json();
        const payload = JSON.parse(atob(token.split(".")[1]));
        const uid = payload.sub;
        if (!uid || !cfg.supabaseUrl) return;
        const r = await fetch(cfg.supabaseUrl + "/rest/v1/profiles?select=full_name,username&id=eq." + uid, {
          headers: { apikey: cfg.supabaseAnonKey, Authorization: "Bearer " + token, Accept: "application/json" }
        });
        if (!r.ok) return;
        const rows = await r.json();
        const profile = rows?.[0];
        if (profile && currentUser) {
          const name = profile.full_name || profile.username || currentUser.name;
          if (name !== currentUser.name) {
            currentUser.name = name;
            updateAuthUI();
          }
        }
      } catch (e) {}
    }

    function logout() {
      currentUser = null;
      isLoggedIn = false;
      localStorage.removeItem("volynx_access_token");
      localStorage.removeItem("volynx_refresh_token");
      localStorage.removeItem("volynx_session");
      localStorage.removeItem("volynx_user_email");
      updateAuthUI();
      document.getElementById("dropdownMenu")?.classList.remove("show");
    }

    function updateAuthUI() {
      const signInBtn = document.getElementById("signInBtn");
      const userMenu = document.getElementById("userMenu");
      const userName = document.getElementById("userName");
      const userNameFull = document.getElementById("userNameFull");
      const userEmail = document.getElementById("userEmail");
      const favoritesBtn = document.getElementById("favoritesBtn");
      const mobileFavoritesBtn = document.getElementById("mobileFavoritesBtn");
      const upgradeBtn = document.getElementById("upgradeBtn");
      const mobileUpgradeBtn = document.getElementById("mobileUpgradeBtn");

      if (isLoggedIn && currentUser) {
        if (signInBtn) signInBtn.style.display = "none";
        if (userMenu) userMenu.style.display = "block";
        if (favoritesBtn) favoritesBtn.style.display = "flex";
        if (mobileFavoritesBtn) mobileFavoritesBtn.style.display = "flex";
        if (upgradeBtn) upgradeBtn.style.display = "inline-flex";
        if (mobileUpgradeBtn) mobileUpgradeBtn.style.display = "block";
        const displayName = currentUser.name.split(" ")[0];
        if (userName) userName.textContent = displayName;
        if (userNameFull) userNameFull.textContent = currentUser.name;
        if (userEmail) userEmail.textContent = currentUser.email;
      } else {
