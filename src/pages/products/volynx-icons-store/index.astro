---
import "../../../styles/icons-store.css";
import FlagshipLayout from "../../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../../components/FlagshipFooter.astro";
import { ROUTES } from "../../../data/routes";

const pageTitle = "VOLYNX Icon Vault";
const pageDescription = "Browse curated VOLYNX icon packs, preview every collection, and open each pack without leaving the store.";
---

<FlagshipLayout
  title={pageTitle}
  description={pageDescription}
  ogImage="/assets/volynx-icon.webp"
  pageClass="page-icons-store fx-grid"
>
  <FlagshipHeader current={ROUTES.iconsStore} ctaLabel="Go Pro" ctaHref={ROUTES.pricing} ctaI18n="nav.go_pro" />

  <!-- Main Content -->
  <main class="main-content">
    <!-- Hero Section -->
    <section class="hero">
      <div class="container hero-shell">
        <div class="hero-copy">
          <p class="hero-kicker" data-i18n="icons.hero_kicker">Premium Design Assets</p>
          <div class="hero-brand">
            <img src="/assets/icons-store-logo.webp" class="hero-long-logo" alt="Volynx Icons Store" />
          </div>
          <p class="hero-description" data-i18n="icons.hero_desc">
            Premium icon packs, standout neon singles, and full collection previews in one storefront.
          </p>
          <div class="hero-actions">
            <a href={`${ROUTES.contact}?product=volynx-icons-store&intent=icons`} class="btn btn-primary btn-lg" data-i18n="icons.btn_contact">Start an icon request</a>
            <a href="#single-icons" class="btn btn-secondary btn-lg" data-i18n="icons.btn_single_gallery">Browse single icons</a>
          </div>
          <div class="hero-proof-list">
            <span class="hero-proof" data-i18n="icons.hero_proof_1">Open packs without leaving the vault</span>
            <span class="hero-proof" data-i18n="icons.hero_proof_2">Request standout neon icons individually</span>
            <span class="hero-proof" data-i18n="icons.hero_proof_3">Preview every collection before checkout</span>
          </div>
          <div class="hero-stats">
            <div class="stat">
              <span class="stat-number" id="heroIconCount">0</span>
              <span class="stat-label" data-i18n="icons.hero_stat_library">Icons</span>
            </div>
            <div class="stat">
              <span class="stat-number">0</span>
              <span class="stat-label" data-i18n="icons.hero_stat_packs">Packs</span>
            </div>
            <div class="stat">
              <span class="stat-number" data-i18n="icons.hero_stat_single_value">Neon</span>
              <span class="stat-label" data-i18n="icons.hero_stat_single_label">Singles</span>
            </div>
          </div>
        </div>

        <div class="hero-scene" aria-hidden="true">
          <div class="hero-scene-card hero-scene-card--center">
            <img src="/assets/icons-store/Hyper-Icons-Premium/premium.png" alt="" loading="eager" />
          </div>
          <div class="hero-scene-card hero-scene-card--top">
            <img src="/assets/icons-store/Hyper-Icons-Premium/diamond.png" alt="" loading="eager" />
          </div>
          <div class="hero-scene-card hero-scene-card--left">
            <img src="/assets/icons-store/Hyper-Icons-Premium/infinity.png" alt="" loading="eager" />
          </div>
          <div class="hero-scene-card hero-scene-card--right">
            <img src="/assets/icons-store/Hyper-Icons-Premium/lightning.png" alt="" loading="eager" />
          </div>
          <div class="hero-scene-caption">
            <span data-i18n="icons.hero_scene_label">Premium Packs + Single Icons</span>
          </div>
        </div>
      </div>
    </section>

    <section class="asset-showcase" id="asset-showcase">
      <div class="container">
        <div class="asset-showcase-head">
          <div class="asset-showcase-copy">
            <p class="asset-showcase-kicker" data-i18n="icons.asset_kicker">Latest Assets</p>
            <h2 class="asset-showcase-title" data-i18n="icons.asset_title">Metal + glass essentials</h2>
            <p class="asset-showcase-desc" data-i18n="icons.asset_desc">
              Loaded directly from the new HTML source inside the assets folder, so the storefront reflects the latest icon batch instead of leaving it hidden.
            </p>
          </div>
          <a href="#single-icons" class="btn btn-secondary asset-showcase-link" data-i18n="icons.asset_link">See SVG singles</a>
        </div>
        <div class="asset-showcase-grid" id="assetShowcaseGrid">
          <article class="soon-panel">
            <p class="soon-kicker">Loading latest assets</p>
            <h3>Preparing the new glass showcase.</h3>
            <p>The new icons from the asset HTML will appear here.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Featured Icons (inline SVG neon cards — premium showcase) -->
    <section class="featured-section" id="featured">
      <div class="container">
        <div class="featured-shell">
          <div class="featured-intro">
            <p class="featured-brand" data-i18n="icons.featured_brand">Neon Singles</p>
            <h2 class="featured-title" data-i18n="icons.featured_title">Standalone premium icons</h2>
            <p class="featured-subtitle" data-i18n="icons.featured_subtitle">Purple and blue gradients, SVG showcase art, and one-off icon requests.</p>
            <p class="featured-deck" data-i18n="icons.featured_desc">
              This section brings back the neon showcase cards as their own storefront lane. Use them for standout hero assets, campaign pieces, or single-icon licensing before you open the full pack.
            </p>
            <div class="featured-pills">
              <span class="featured-pill" data-i18n="icons.featured_pill_1">Single icon requests</span>
              <span class="featured-pill" data-i18n="icons.featured_pill_2">Gradient neon backgrounds</span>
              <span class="featured-pill" data-i18n="icons.featured_pill_3">Related packs below</span>
            </div>
            <div class="featured-actions">
              <a href="#single-icons" class="btn btn-primary" data-i18n="icons.featured_cta_primary">Open Single Gallery</a>
              <a href="#collections" class="btn btn-secondary" data-i18n="icons.featured_cta_secondary">Open Full Packs</a>
            </div>
          </div>

          <div class="featured-stage">
            <p class="featured-stage-note" data-i18n="icons.featured_stage_note">Tap any neon card to request it individually or jump to the related pack.</p>
            <div class="featured-grid" id="featuredGrid" data-expanded="false">
        <button type="button" class="featured-card" data-featured-filter="futuristic">
          <span class="featured-badge new">NEW</span>
          <div class="featured-svg-wrap">
            <svg aria-hidden="true" width="54" height="54" viewBox="0 0 54 54" fill="none">
                    <defs>
                      <radialGradient id="fic1_bg1" cx="50%" cy="30%" r="70%"><stop offset="0%" stop-color="#1a237e"/><stop offset="100%" stop-color="#0a0e24"/></radialGradient>
                      <radialGradient id="fic1_glow1" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#4fc3f7" stop-opacity="0.6"/><stop offset="100%" stop-color="#4fc3f7" stop-opacity="0"/></radialGradient>
                    </defs>
                    <rect width="54" height="54" rx="14" fill="url(#fic1_bg1)"/>
                    <ellipse cx="27" cy="28" rx="13" ry="11" stroke="#4fc3f7" stroke-width="1.5" fill="none" opacity="0.9"/>
                    <path d="M20 24 Q27 20 34 24" stroke="#7c4dff" stroke-width="1.2" fill="none" opacity="0.8"/>
                    <path d="M19 28 Q27 32 35 28" stroke="#4fc3f7" stroke-width="1.2" fill="none" opacity="0.6"/>
                    <circle cx="27" cy="28" r="3.5" fill="#4fc3f7" opacity="0.9"/>
                    <line x1="27" y1="17" x2="27" y2="14" stroke="#4fc3f7" stroke-width="1.5" stroke-linecap="round"/>
