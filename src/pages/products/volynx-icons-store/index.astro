            <svg aria-hidden="true" width="54" height="54" viewBox="0 0 54 54" fill="none">
                    <defs><radialGradient id="fic6_bg6" cx="50%" cy="30%" r="70%"><stop offset="0%" stop-color="#1a1000"/><stop offset="100%" stop-color="#0a0600"/></radialGradient>
