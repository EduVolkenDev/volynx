---
import PageWidgets from "../../../components/PageWidgets.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { ROUTES } from "../../../data/routes";
const pageTitle = "VOLYNX — Landing Express";
const pageDescription = "Premium conversion-focused landing page, delivered as a live Builder project. Instant Stripe checkout, premium structure, mobile-first.";
---

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="format-detection" content="telephone=no,date=no,address=no,email=no" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:type" content="product" />
  <meta property="og:url" content="https://volynx.world/products/landing-express/" />
  <link rel="canonical" href="https://volynx.world/products/landing-express/" />

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/site.webmanifest" />

  <style>
    :root {
      --bg-primary: #0a0a0f; --bg-secondary: #131318; --bg-card: rgba(19, 19, 24, 0.6);
      --neon-cyan: #00f3ff; --neon-purple: #b400ff; --neon-pink: #ff00ff;
      --neon-blue: #0066ff; --neon-green: #00ff88; --neon-orange: #ff6b00;
      --text-primary: #ffffff; --text-secondary: rgba(255,255,255,0.75); --text-muted: rgba(255,255,255,0.5);
      --border-color: rgba(0,243,255,0.2); --border-glow: rgba(0,243,255,0.5);
      --space-xs: 8px; --space-sm: 12px; --space-md: 16px; --space-lg: 24px;
      --space-xl: 32px; --space-2xl: 48px; --space-3xl: 64px; --space-4xl: 96px;
      --font-base: system-ui, -apple-system, 'Segoe UI', sans-serif;
      --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      --glow-sm: 0 0 10px currentColor; --glow-md: 0 0 20px currentColor; --glow-lg: 0 0 40px currentColor;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { overflow-x: hidden; scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
    body { font-family: var(--font-base); background: var(--bg-primary); color: var(--text-primary); line-height: 1.6; overflow-x: hidden; min-height: 100vh; }

    .cyber-grid { position: fixed; inset: 0; z-index: 0; pointer-events: none; background-image: linear-gradient(rgba(0,243,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(0,243,255,0.05) 1px, transparent 1px); background-size: 40px 40px; animation: gridPulse 3s ease-in-out infinite; }
    @keyframes gridPulse { 0%, 100% { opacity: 0.3; } 50% { opacity: 0.6; } }

    .neon-orbs { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
    .orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.3; animation: float 20s ease-in-out infinite; }
    .orb-1 { width: 400px; height: 400px; background: radial-gradient(circle, var(--neon-cyan), transparent); top: 10%; left: 10%; }
    .orb-2 { width: 500px; height: 500px; background: radial-gradient(circle, var(--neon-purple), transparent); top: 50%; right: 10%; animation-delay: 7s; }
    .orb-3 { width: 350px; height: 350px; background: radial-gradient(circle, var(--neon-pink), transparent); bottom: 10%; left: 50%; animation-delay: 14s; }
    @keyframes float { 0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.3; } 33% { transform: translate(50px, -30px) scale(1.1); opacity: 0.4; } 66% { transform: translate(-30px, 40px) scale(0.9); opacity: 0.35; } }

    .top-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; background: rgba(10,10,15,0.85); backdrop-filter: blur(24px); border-bottom: 1px solid var(--border-color); box-shadow: 0 4px 32px rgba(0,243,255,0.15); }
    .nav-container { max-width: 1400px; margin: 0 auto; padding: var(--space-md) var(--space-lg); display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); }
    .nav-logo { display: flex; align-items: center; gap: var(--space-sm); z-index: 1001; }
    .logo-icon { width: 32px; height: 32px; color: var(--neon-cyan); filter: drop-shadow(0 0 8px var(--neon-cyan)); }
    .logo-text { font-size: 18px; font-weight: 900; letter-spacing: 2px; background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .mobile-menu-btn { display: flex; flex-direction: column; gap: 5px; background: transparent; border: none; cursor: pointer; padding: var(--space-xs); z-index: 1001; }
    .menu-bar { width: 24px; height: 2px; background: var(--neon-cyan); border-radius: 2px; transition: var(--transition); box-shadow: 0 0 10px currentColor; }
    .mobile-menu-btn.active .menu-bar:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
    .mobile-menu-btn.active .menu-bar:nth-child(2) { opacity: 0; }
    .mobile-menu-btn.active .menu-bar:nth-child(3) { transform: rotate(-45deg) translate(7px, -7px); }
    .nav-links { position: fixed; top: 70px; left: 0; right: 0; background: rgba(10,10,15,0.98); backdrop-filter: blur(24px); border-bottom: 1px solid var(--border-color); padding: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-sm); transform: translateY(-100%); opacity: 0; transition: var(--transition); pointer-events: none; }
    .nav-links.active { transform: translateY(0); opacity: 1; pointer-events: all; }
    .nav-link { display: flex; align-items: center; justify-content: space-between; padding: var(--space-md); background: rgba(255,255,255,0.02); border: 1px solid rgba(0,243,255,0.15); border-radius: 12px; color: var(--text-primary); text-decoration: none; font-size: 16px; font-weight: 500; transition: var(--transition); }
    .nav-link:hover { background: rgba(0,243,255,0.08); border-color: var(--neon-cyan); box-shadow: 0 0 24px rgba(0,243,255,0.25); }
    .nav-arrow { color: var(--neon-cyan); font-size: 20px; transition: var(--transition); }
    .nav-link:hover .nav-arrow { transform: translateX(4px); }

    .main-content { position: relative; z-index: 10; padding-top: 70px; }
    .container { max-width: 1400px; margin: 0 auto; padding: 0 var(--space-lg); }

    .hero-section { position: relative; padding: var(--space-4xl) 0 var(--space-3xl); overflow: hidden; }
    .hero-glow { position: absolute; top: -100px; left: 50%; transform: translateX(-50%); width: 400px; height: 400px; background: radial-gradient(circle, rgba(0,243,255,0.85) 30%, transparent 100%); filter: blur(100px); pointer-events: none; animation: glowPulse 5s ease-in-out infinite; }
    @keyframes glowPulse { 0%, 100% { opacity: 0.3; transform: translateX(-50%) scale(1); } 50% { opacity: 0.5; transform: translateX(-50%) scale(1.2); } }

    .breadcrumb { display: flex; align-items: center; gap: var(--space-sm); font-size: 14px; color: var(--text-muted); margin-bottom: var(--space-lg); }
    .breadcrumb a { color: var(--neon-cyan); text-decoration: none; transition: var(--transition); }
    .breadcrumb a:hover { color: var(--text-primary); text-shadow: 0 0 10px currentColor; }
    .breadcrumb-sep { color: var(--text-muted); }

    .product-badge { display: inline-flex; align-items: center; gap: var(--space-sm); padding: var(--space-sm) var(--space-lg); background: rgba(0,243,255,0.08); border: 2px solid rgba(0,243,255,0.3); border-radius: 100px; font-size: 13px; font-weight: 700; letter-spacing: 2px; color: var(--neon-cyan); margin-bottom: var(--space-xl); box-shadow: 0 0 30px rgba(0,243,255,0.3); }
    .badge-icon { width: 20px; height: 20px; color: var(--neon-cyan); animation: spin 8s linear infinite; }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

    .hero-title { font-size: clamp(40px, 10vw, 80px); font-weight: 900; line-height: 1.1; margin-bottom: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-xs); }
    .title-main { color: var(--text-primary); text-shadow: 0 0 20px rgba(255,255,255,0.3); }
    .title-gradient { background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple), var(--neon-pink)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; filter: drop-shadow(0 0 40px var(--neon-cyan)); animation: gradientShift 5s ease infinite; }
    @keyframes gradientShift { 0%, 100% { filter: drop-shadow(0 0 40px var(--neon-cyan)); } 50% { filter: drop-shadow(0 0 40px var(--neon-purple)); } }

    .hero-description { font-size: clamp(16px, 3vw, 22px); color: var(--text-secondary); max-width: 700px; margin-bottom: var(--space-xl); line-height: 1.7; }

    .feature-pills { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-bottom: var(--space-xl); }
    .pill { display: inline-flex; align-items: center; gap: var(--space-xs); padding: var(--space-sm) var(--space-md); background: rgba(255,255,255,0.03); border: 1px solid rgba(0,243,255,0.2); border-radius: 100px; font-size: 13px; font-weight: 500; color: var(--text-secondary); transition: var(--transition); }
    .pill:hover { background: rgba(0,243,255,0.1); border-color: var(--neon-cyan); color: var(--neon-cyan); box-shadow: 0 0 20px rgba(0,243,255,0.3); transform: translateY(-2px); }
    .pill-icon { width: 14px; height: 14px; color: var(--neon-cyan); }

    .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-md); margin-bottom: var(--space-2xl); }

    .btn { display: inline-flex; align-items: center; gap: var(--space-sm); padding: var(--space-md) var(--space-xl); border-radius: 12px; font-size: 16px; font-weight: 700; text-decoration: none; transition: var(--transition); cursor: pointer; border: 2px solid transparent; position: relative; overflow: hidden; }
    .btn::before { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent); transform: translateX(-100%); transition: transform 0.6s; }
    .btn:hover::before { transform: translateX(100%); }
    .btn-primary { background: linear-gradient(135deg, var(--neon-cyan), var(--neon-blue)); color: #000; box-shadow: 0 4px 32px rgba(0,243,255,0.5); }
    .btn-primary:hover { box-shadow: 0 8px 48px rgba(0,243,255,0.7); transform: translateY(-3px); }
    .btn-secondary { background: transparent; border-color: var(--border-color); color: var(--text-primary); }
    .btn-secondary:hover { border-color: var(--neon-cyan); background: rgba(0,243,255,0.1); box-shadow: 0 0 24px rgba(0,243,255,0.3); }
    .btn-icon { width: 16px; height: 16px; transition: var(--transition); }
    .btn:hover .btn-icon { transform: translateX(4px); }

    .highlights-section, .problem-section, .solution-section, .scope-section, .proof-section, .licenses-section, .faq-section { padding: var(--space-4xl) 0; position: relative; }
    .section-header { text-align: center; margin-bottom: var(--space-3xl); }
    .section-title { font-size: clamp(32px, 6vw, 56px); font-weight: 900; margin-bottom: var(--space-md); position: relative; display: inline-block; }
    .title-line { position: absolute; bottom: -8px; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, transparent, var(--neon-cyan), transparent); box-shadow: 0 0 10px var(--neon-cyan); }
    .section-subtitle { font-size: clamp(16px, 3vw, 18px); color: var(--text-secondary); max-width: 700px; margin: 0 auto; line-height: 1.7; }

    .highlights-grid, .problem-grid, .solution-grid, .proof-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-xl); }
    .scope-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-xl); }

    .highlight-card, .problem-card, .solution-card, .proof-card, .scope-card { position: relative; background: var(--bg-card); backdrop-filter: blur(10px); border: 1px solid rgba(0,243,255,0.2); border-radius: 24px; padding: var(--space-2xl); transition: var(--transition); overflow: hidden; }
    .card-glow { position: absolute; inset: -100%; background: radial-gradient(circle at center, rgba(0,243,255,0.15) 0%, transparent 60%); opacity: 0; transition: opacity 0.6s; pointer-events: none; }
    .highlight-card:hover .card-glow, .problem-card:hover .card-glow, .solution-card:hover .card-glow, .proof-card:hover .card-glow, .scope-card:hover .card-glow { opacity: 1; }
    .highlight-card:hover, .problem-card:hover, .solution-card:hover, .proof-card:hover, .scope-card:hover { border-color: var(--neon-cyan); box-shadow: 0 0 40px rgba(0,243,255,0.3), inset 0 0 80px rgba(0,243,255,0.05); transform: translateY(-6px); }

    .card-icon-wrapper { width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; background: rgba(0,243,255,0.1); border: 2px solid rgba(0,243,255,0.3); border-radius: 16px; margin-bottom: var(--space-lg); transition: var(--transition); }
    .card-icon { width: 32px; height: 32px; color: var(--neon-cyan); transition: var(--transition); }
    .highlight-card:hover .card-icon-wrapper, .problem-card:hover .card-icon-wrapper, .solution-card:hover .card-icon-wrapper, .scope-card:hover .card-icon-wrapper { background: rgba(0,243,255,0.15); border-color: var(--neon-cyan); box-shadow: 0 0 30px rgba(0,243,255,0.4); }
    .highlight-card:hover .card-icon, .problem-card:hover .card-icon, .solution-card:hover .card-icon, .scope-card:hover .card-icon { transform: scale(1.1) rotate(5deg); filter: drop-shadow(0 0 10px currentColor); }

    .card-title { font-size: clamp(22px, 4vw, 28px); font-weight: 800; margin-bottom: var(--space-md); }
    .card-description { color: var(--text-secondary); font-size: clamp(15px, 2.5vw, 17px); line-height: 1.6; }
    .card-list { list-style: none; display: flex; flex-direction: column; gap: var(--space-md); }
    .card-list li { display: flex; align-items: flex-start; gap: var(--space-sm); color: var(--text-secondary); font-size: clamp(15px, 2.5vw, 17px); line-height: 1.6; }
    .check-icon { width: 20px; height: 20px; color: var(--neon-green); flex-shrink: 0; margin-top: 2px; filter: drop-shadow(0 0 8px var(--neon-green)); }

    .proof-metric { font-size: clamp(36px, 7vw, 56px); font-weight: 900; background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; line-height: 1; margin-bottom: var(--space-md); }
    .proof-logo-row { margin-top: var(--space-2xl); display: flex; justify-content: center; }
    .proof-logo-pill { display: inline-flex; align-items: center; gap: var(--space-sm); padding: var(--space-md) var(--space-xl); background: rgba(255,255,255,0.03); border: 1px solid rgba(0,243,255,0.2); border-radius: 100px; color: var(--text-primary); text-decoration: none; font-weight: 600; transition: var(--transition); }
    .proof-logo-pill:hover { border-color: var(--neon-cyan); color: var(--neon-cyan); background: rgba(0,243,255,0.05); box-shadow: 0 0 24px rgba(0,243,255,0.3); }

    .licenses-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-xl); }
    .license-card { position: relative; background: var(--bg-card); backdrop-filter: blur(10px); border: 2px solid rgba(0,243,255,0.2); border-radius: 24px; padding: var(--space-2xl); transition: var(--transition); overflow: hidden; display: flex; flex-direction: column; }
    .license-card:hover { border-color: var(--neon-cyan); box-shadow: 0 0 50px rgba(0,243,255,0.4), inset 0 0 100px rgba(0,243,255,0.05); transform: translateY(-8px); }
    .license-featured { border-color: var(--neon-purple); background: linear-gradient(135deg, rgba(180,0,255,0.05), rgba(255,0,255,0.03)); }
    .license-featured:hover { border-color: var(--neon-pink); box-shadow: 0 0 60px rgba(255,0,255,0.5), inset 0 0 120px rgba(255,0,255,0.08); }
    .popular-badge { position: absolute; top: var(--space-lg); right: var(--space-lg); display: flex; align-items: center; gap: var(--space-xs); padding: var(--space-xs) var(--space-md); background: linear-gradient(135deg, var(--neon-purple), var(--neon-pink)); border-radius: 100px; font-size: 11px; font-weight: 800; letter-spacing: 1px; box-shadow: 0 0 30px rgba(255,0,255,0.6); animation: badgePulse 2s ease-in-out infinite; }
    @keyframes badgePulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    .popular-badge svg { width: 14px; height: 14px; }
    .license-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-lg); }
    .license-badge { padding: var(--space-xs) var(--space-md); background: rgba(0,243,255,0.1); border: 1px solid rgba(0,243,255,0.3); border-radius: 100px; font-size: 12px; font-weight: 800; letter-spacing: 1.5px; color: var(--neon-cyan); }
    .license-price { display: flex; align-items: baseline; gap: 4px; }
    .amount { font-size: clamp(32px, 5vw, 42px); font-weight: 900; background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .license-name { font-size: clamp(24px, 4vw, 32px); font-weight: 800; margin-bottom: var(--space-lg); }
    .license-features { list-style: none; display: flex; flex-direction: column; gap: var(--space-md); margin-bottom: var(--space-xl); flex: 1; }
    .license-features li { display: flex; align-items: flex-start; gap: var(--space-sm); color: var(--text-secondary); font-size: clamp(15px, 2.5vw, 17px); line-height: 1.6; }
    .btn-license { width: 100%; justify-content: center; padding: var(--space-lg) var(--space-xl); background: rgba(0,243,255,0.1); border: 2px solid var(--neon-cyan); color: var(--neon-cyan); }
    .btn-license:hover { background: linear-gradient(135deg, var(--neon-cyan), var(--neon-blue)); color: #000; box-shadow: 0 8px 48px rgba(0,243,255,0.6); }
    .btn-featured { background: linear-gradient(135deg, var(--neon-purple), var(--neon-pink)); border-color: var(--neon-pink); color: #000; box-shadow: 0 4px 32px rgba(255,0,255,0.4); }
    .btn-featured:hover { box-shadow: 0 8px 56px rgba(255,0,255,0.7); }

    .faq-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); max-width: 900px; margin: 0 auto; }
    .faq-item { display: flex; gap: var(--space-lg); padding: var(--space-xl); background: rgba(255,255,255,0.02); border: 1px solid rgba(0,243,255,0.15); border-radius: 20px; transition: var(--transition); }
    .faq-item:hover { background: rgba(0,243,255,0.05); border-color: var(--neon-cyan); box-shadow: 0 0 30px rgba(0,243,255,0.2); transform: translateX(4px); }
    .faq-icon { width: 40px; height: 40px; color: var(--neon-cyan); flex-shrink: 0; filter: drop-shadow(0 0 10px currentColor); }
    .faq-content { flex: 1; }
    .faq-question { font-size: clamp(17px, 3vw, 20px); font-weight: 700; margin-bottom: var(--space-sm); }
    .faq-answer { color: var(--text-secondary); font-size: clamp(15px, 2.5vw, 17px); line-height: 1.6; margin: 0; }

    .cta-section { padding: var(--space-4xl) 0; position: relative; overflow: hidden; }
    .cta-content { position: relative; text-align: center; padding: var(--space-4xl) var(--space-xl); background: linear-gradient(135deg, rgba(0,243,255,0.08), rgba(180,0,255,0.05)); border: 2px solid rgba(0,243,255,0.3); border-radius: 32px; backdrop-filter: blur(10px); overflow: hidden; }
    .cta-glow { position: absolute; top: -50%; left: 50%; transform: translateX(-50%); width: 500px; height: 500px; background: radial-gradient(circle, rgba(0,243,255,0.3) 0%, transparent 70%); filter: blur(80px); pointer-events: none; animation: ctaGlow 5s ease-in-out infinite; }
    @keyframes ctaGlow { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.7; } }
    .cta-title { font-size: clamp(32px, 7vw, 56px); font-weight: 900; margin-bottom: var(--space-md); background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple), var(--neon-pink)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .cta-description { font-size: clamp(16px, 3vw, 20px); color: var(--text-secondary); max-width: 600px; margin: 0 auto var(--space-xl); line-height: 1.7; }
    .btn-cta { background: linear-gradient(135deg, var(--neon-cyan), var(--neon-blue)); color: #000; font-size: 18px; padding: var(--space-lg) var(--space-2xl); box-shadow: 0 8px 48px rgba(0,243,255,0.5); }
    .btn-cta:hover { box-shadow: 0 12px 64px rgba(0,243,255,0.8); transform: translateY(-4px) scale(1.05); }

    @media (min-width: 768px) {
      .mobile-menu-btn { display: none; }
      .nav-links { position: static; flex-direction: row; gap: var(--space-sm); transform: none; opacity: 1; pointer-events: all; padding: 0; background: transparent; border: none; }
      .nav-link { padding: var(--space-sm) var(--space-md); font-size: 14px; }
      .highlights-grid { grid-template-columns: repeat(2, 1fr); }
      .problem-grid, .solution-grid, .proof-grid { grid-template-columns: repeat(3, 1fr); }
      .scope-grid { grid-template-columns: repeat(2, 1fr); }
      .faq-grid { grid-template-columns: repeat(2, 1fr); }
      .licenses-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (min-width: 1024px) {
      .hero-section { padding: 120px 0 var(--space-4xl); }
      .licenses-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; } }
    *:focus-visible { outline: 2px solid var(--neon-cyan); outline-offset: 4px; border-radius: 4px; }
  </style>
</head>

<body>
  <div class="cyber-grid" aria-hidden="true"></div>
  <div class="neon-orbs" aria-hidden="true">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>

  <header class="top-nav" aria-label="VOLYNX menu">
    <div class="nav-container">
      <div class="nav-logo">
        <svg class="logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
