---
import SiteFooter from "../../components/SiteFooter.astro";
import FaviconHead from "../../components/FaviconHead.astro";
import PageWidgets from "../../components/PageWidgets.astro";
import Topbar from "../../components/Topbar.astro";
import { ROUTES } from "../../data/routes";
const pageTitle = "Why VOLYNX? — Manifesto";
const pageDescription = "VOLYNX exists to democratize intelligent technology with premium design and measurable social impact — ethical, accessible, and built to scale good.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <link rel="preload" as="image" href="/assets/lucid-big.webp" />

  <FaviconHead />

  <style>
    :root {
      --sans: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
      --display: "Orbitron", var(--sans);
      --txt: rgba(231, 233, 255, .92);
      --muted: rgba(199, 195, 255, .68);
      --line: rgba(255, 255, 255, .10);
      --line2: rgba(167, 139, 250, .20);
      --glass: rgba(8, 6, 22, .52);
      --a: rgba(130, 220, 255, .9);
      --b: rgba(210, 140, 255, .9);
      --r-lg: 22px;
      --r-md: 16px;
      --r-pill: 999px;
      --pad: clamp(14px, 4vw, 28px);
      --max: 1040px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }

    html, body {
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--sans);
      color: var(--txt);
      background: #02040d url("/assets/lucid-big.webp") center / cover no-repeat fixed;
      min-height: 100svh;
    }

    a { color: inherit; text-decoration: none; -webkit-tap-highlight-color: transparent; }

    /* ===== OVERLAY ===== */
    .bg {
      position: fixed;
      inset: 0;
      background: rgba(2, 4, 13, 0.62);
      z-index: 0;
      pointer-events: none;
    }

    /* ===== TOPBAR ===== */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(0, 0, 0, .38);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--line);
    }

    .topbar__inner {
      max-width: var(--max);
      margin: 0 auto;
      padding: 13px var(--pad);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
    }

    .topbar__logo {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .10em;
      color: rgba(200, 200, 255, .55);
      text-transform: uppercase;
    }

    .topbar__right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .pill-back {
      padding: 8px 14px;
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      background: rgba(255, 255, 255, .04);
      font-size: 12px;
      font-weight: 600;
      color: var(--txt);
      transition: background .18s ease, border-color .18s ease;
    }

    .pill-back:hover {
      background: rgba(255, 255, 255, .08);
      border-color: rgba(255, 255, 255, .20);
    }

    /* ===== LANG BUTTONS ===== */
    .lang {
      display: flex;
      gap: 4px;
      border-left: 1px solid var(--line);
      padding-left: 10px;
      margin-left: 2px;
    }

    .langBtn {
      appearance: none;
      border: 1px solid var(--line);
      background: rgba(10, 8, 24, .40);
      color: var(--muted);
      font-weight: 700;
      letter-spacing: .10em;
      text-transform: uppercase;
      font-size: 11px;
      padding: 7px 10px;
      border-radius: var(--r-pill);
      cursor: pointer;
      font-family: var(--sans);
      transition: color .18s ease, border-color .18s ease, background .18s ease;
    }

    .langBtn:hover {
      color: var(--txt);
      border-color: var(--line2);
    }

    .langBtn.is-on {
      color: var(--txt);
      border-color: rgba(245, 231, 145, .45);
      background: rgba(245, 231, 145, .06);
    }

    /* ===== MAIN WRAP ===== */
    .shell {
      position: relative;
      z-index: 1;
      max-width: var(--max);
      margin: 0 auto;
      padding: 48px var(--pad) 64px;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    /* ===== HERO ===== */
    .hero {
      display: flex;
      align-items: center;
      gap: 28px;
      flex-wrap: wrap;
    }

    .hero__eye {
     width: clamp(64px,70vw,350px);
  height: clamp(64px,70vw,350px);
  flex: 0 0 auto;
  filter: drop-shadow(0 0 20px rgba(126, 44, 225, 0.77)) drop-shadow(0 0 32px rgba(30, 192, 210, 0.78));
    }

    .hero__eye img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .hero__text {
      flex: 1;
      min-width: 220px;
    }

    .hero__label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--a);
      margin-bottom: 12px;
    }

    .hero__dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--a);
      box-shadow: 0 0 8px var(--a);
    }

    .hero__title {
      margin: 0 0 14px;
      font-size: clamp(30px, 4.5vw, 56px);
      font-weight: 800;
      letter-spacing: -.02em;
      line-height: 1.1;
      color: var(--txt);
    }

    .hero__title span {
      background: linear-gradient(90deg, var(--a), var(--b));
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero__lead {
      margin: 0;
      color: var(--muted);
      font-size: clamp(14px, 1.4vw, 17px);
      line-height: 1.75;
      max-width: 68ch;
    }

    /* ===== PILLARS ===== */
    .pillRow {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      padding: 7px 14px;
      border-radius: var(--r-pill);
      border: 1px solid var(--line2);
      background: rgba(10, 8, 24, .50);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--muted);
      backdrop-filter: blur(8px);
    }

    /* ===== CARD CONTAINER ===== */
    .card {
      border-radius: var(--r-lg);
      border: 1px solid rgba(255, 255, 255, .10);
      background: linear-gradient(135deg, rgba(255,255,255,.06) 0%, rgba(255,255,255,.02) 100%);
      box-shadow:
        0 20px 60px rgba(0, 0, 0, .55),
        0 0 0 1px rgba(255, 255, 255, .05) inset;
      backdrop-filter: blur(18px) saturate(140%);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
      overflow: hidden;
    }

    .card__inner {
      padding: 32px var(--pad) 28px;
    }

    .card__section-title {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 0 0 20px;
    }

    /* ===== BOX GRID ===== */
    .grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .box {
      border-radius: var(--r-md);
      padding: 20px;
      background: rgba(7, 8, 20, .40);
      border: 1px solid var(--line2);
      transition: transform .20s ease, border-color .20s ease, box-shadow .20s ease;
    }

    .box:hover {
      transform: translateY(-2px);
      border-color: rgba(167, 139, 250, .35);
      box-shadow: 0 12px 32px rgba(0, 0, 0, .40);
    }

    .box h3 {
      margin: 0 0 10px;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: .02em;
      color: var(--a);
    }

    .box p, .box .list {
      margin: 0;
      color: var(--muted);
      line-height: 1.65;
      font-size: 13.5px;
    }

    .list {
      padding-left: 16px;
    }

    .list li {
      margin: 6px 0;
    }

    /* ===== DIVIDER ===== */
    .divider {
      border: none;
      border-top: 1px solid var(--line);
      margin: 24px 0;
    }

    /* ===== CTAs ===== */
    .ctaRow {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 11px 20px;
      border-radius: var(--r-pill);
      border: 1px solid var(--line);
      background: rgba(10, 8, 24, .60);
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      font-size: 12px;
      color: var(--txt);
      backdrop-filter: blur(8px);
      transition: transform .18s ease, filter .18s ease, border-color .18s ease, box-shadow .18s ease;
    }

    .btn:hover {
      transform: translateY(-1px);
      filter: brightness(1.10);
      border-color: var(--line2);
      box-shadow: 0 12px 28px rgba(0, 0, 0, .45);
    }

    .btn.primary {
      background: radial-gradient(120% 200% at 50% 0%, rgba(255, 225, 39, .75), rgba(167, 139, 250, .16) 55%, rgba(0, 0, 0, .80) 100%);
      border-color: rgba(245, 231, 145, .40);
    }

    /* ===== CLOSING LINE ===== */
    .closing {
      margin: 24px 0 0;
      padding-top: 18px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      line-height: 1.7;
      font-size: 14px;
      font-style: italic;
      max-width: 90ch;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 900px) {
      .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 600px) {
      .grid { grid-template-columns: 1fr; }
      .hero { flex-direction: column; align-items: flex-start; gap: 18px; }
      .hero__eye { width: 72px; height: 72px; }
      .ctaRow { flex-direction: column; }
      .btn { width: 100%; justify-content: center; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition: none !important; }
    }

    /* ===== COOKIE BANNER ===== */
    .vx-cookie {
      position: fixed;
      inset: auto 18px 18px 18px;
      z-index: 999;
      display: grid;
      place-items: end center;
    }

    .vx-cookie__card {
      width: min(540px, 100%);
      border-radius: 18px;
      border: 1px solid rgba(255, 255, 255, .12);
      background: rgba(8, 6, 22, .80);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 24px 52px rgba(0, 0, 0, .80), 0 0 28px rgba(167, 139, 250, .12);
      transform: translateY(12px);
      opacity: 0;
      transition: transform .18s ease, opacity .18s ease;
    }

    .vx-cookie.is-on .vx-cookie__card {
      transform: translateY(0);
      opacity: 1;
    }

    .vx-cookie__head {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 16px 0;
    }

    .vx-cookie__badge {
      font-weight: 800;
      letter-spacing: .14em;
      font-size: 10px;
      padding: 6px 10px;
      border-radius: var(--r-pill);
      border: 1px solid rgba(160, 252, 252, .18);
      background: rgba(4, 6, 13, .50);
      color: var(--a);
      text-transform: uppercase;
    }

    .vx-cookie__title {
      font-weight: 700;
      font-size: 14px;
      color: var(--txt);
      letter-spacing: .04em;
    }

    .vx-cookie__text {
      padding: 10px 16px 0;
      margin: 0;
      color: var(--muted);
      line-height: 1.55;
      font-size: 13px;
    }

    .vx-cookie__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 12px 16px;
    }

    .vx-btn {
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      font-size: 11px;
      padding: 9px 14px;
      border-radius: var(--r-pill);
      border: 1px solid var(--line);
      background: rgba(10, 8, 24, .60);
      color: var(--txt);
      cursor: pointer;
      font-family: var(--sans);
      transition: filter .18s ease, border-color .18s ease;
    }

    .vx-btn:hover { filter: brightness(1.10); border-color: var(--line2); }
    .vx-btn--primary { background: rgba(245, 231, 145, .12); border-color: rgba(245, 231, 145, .35); }
    .vx-btn--soft { border-color: rgba(160, 252, 252, .20); }
    .vx-btn--ghost { background: transparent; }

    .vx-cookie__link {
      display: inline-block;
      padding: 0 16px 12px;
      font-size: 12px;
      color: rgba(200, 245, 255, .65);
      text-decoration: underline;
    }

    .vx-cookie__prefs { padding: 0 16px 14px; }

    .vx-cookie__prefsTitle {
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      font-size: 11px;
      color: var(--muted);
      margin: 4px 0 10px;
    }

    .vx-toggle {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 0;
      color: var(--muted);
      font-size: 13px;
      cursor: pointer;
    }

    .vx-toggle input { position: absolute; opacity: 0; pointer-events: none; }

    .vx-toggle__ui {
      width: 40px;
      height: 24px;
      border-radius: var(--r-pill);
      background: rgba(255, 255, 255, .08);
      border: 1px solid var(--line);
      position: relative;
      flex: 0 0 auto;
    }

    .vx-toggle__ui::after {
      content: "";
      position: absolute;
      width: 16px;
      height: 16px;
      top: 50%;
      left: 3px;
      transform: translateY(-50%);
      border-radius: 50%;
      background: rgba(255, 255, 255, .70);
      transition: left .16s ease;
    }

    .vx-toggle input:checked + .vx-toggle__ui {
      background: rgba(4, 229, 255, .12);
      border-color: rgba(160, 252, 252, .25);
    }

    .vx-toggle input:checked + .vx-toggle__ui::after {
      left: 20px;
      background: rgba(245, 231, 145, .85);
    }

    .vx-cookie__prefsActions {
      display: flex;
      justify-content: flex-end;
      padding-top: 8px;
    }

    @media (max-width: 480px) {
      .vx-cookie { inset: auto 12px 12px 12px; }
    }
  </style>
</head>

<body>
  <div class="bg" aria-hidden="true"></div>

  <Topbar rightLinks={[{ href: ROUTES.home, label: "← Back" }]} />

  <main class="shell">
    <div class="hero">
      <div class="hero__eye" aria-hidden="true">
        <img src="/assets/logo-icon-version.webp" alt="" />
      </div>
      <div class="hero__text">
        <div class="hero__label">
          <span class="hero__dot" aria-hidden="true"></span>
          <span data-i18n="heroLabel">Manifesto</span>
        </div>
        <h1 class="hero__title">
          <span data-i18n="titleLine1">Why</span>
          <span> <span data-i18n="titleLine2">VOLYNX?</span></span>
        </h1>
        <p class="hero__lead" data-i18n="lead">
          VOLYNX exists to democratize intelligent technology with a premium aesthetic and a real
          commitment to social impact. We build products and experiences that help people and
          organizations take action — with clarity, ethics and scale.
        </p>
      </div>
    </div>

    <div class="pillRow" aria-label="Pillars">
      <span class="pill" data-i18n="pillImpact">Real impact</span>
      <span class="pill" data-i18n="pillEthics">Ethics &amp; privacy</span>
      <span class="pill" data-i18n="pillSust">Sustainability</span>
      <span class="pill" data-i18n="pillAccess">Accessible</span>
      <span class="pill" data-i18n="pillNetwork">Network effects</span>
    </div>

    <div class="card">
      <div class="card__inner">
        <p class="card__section-title" data-i18n="sectionTitle">Our principles</p>

        <div class="grid">
          <article class="box">
            <h3 data-i18n="purposeTitle">Purpose</h3>
            <p data-i18n="purposeText">
              Make advanced technology accessible so more people can create, collaborate and solve
              real problems — with a focus on social causes, support, well-being and sustainability.
            </p>
          </article>

          <article class="box">
            <h3 data-i18n="whatTitle">What we build</h3>
            <p data-i18n="whatText">
              Tools, kits and experiences that combine impeccable design and applied intelligence —
              built for creators, devs and organizations that need speed, quality and trust.
            </p>
          </article>

          <article class="box">
            <h3 data-i18n="forTitle">Who it's for</h3>
            <ul class="list">
              <li data-i18n="for1">NGOs and social projects that need clarity and less operational friction.</li>
              <li data-i18n="for2">Creators and professionals building useful things without becoming hostage to complexity.</li>
              <li data-i18n="for3">Teams that value privacy, accessibility and solid engineering.</li>
            </ul>
          </article>

          <article class="box">
            <h3 data-i18n="impactTitle">How impact happens</h3>
            <ul class="list">
              <li data-i18n="impact1">Simple tools that reduce repetitive work and free energy for the mission.</li>
              <li data-i18n="impact2">Fast, responsive experiences that reach more people on any device.</li>
              <li data-i18n="impact3">Products that connect people and resources, strengthening communities.</li>
            </ul>
          </article>

          <article class="box">
            <h3 data-i18n="principlesTitle">Principles</h3>
            <ul class="list">
              <li data-i18n="p1">Clarity over noise.</li>
              <li data-i18n="p2">Consent-first privacy and minimal data by default.</li>
              <li data-i18n="p3">Accessibility as a standard, not an extra.</li>
              <li data-i18n="p4">Performance and stability: trust is built in milliseconds.</li>
              <li data-i18n="p5">Sustainability: efficiency is responsibility.</li>
            </ul>
          </article>

          <article class="box">
            <h3 data-i18n="transparencyTitle">Transparency</h3>
            <p data-i18n="transparencyText">
              VOLYNX prioritizes privacy and clear choices. If analytics are used, it will only be
              with consent — to improve the experience and measure impact responsibly.
            </p>
          </article>
        </div>

        <hr class="divider" />

        <div class="ctaRow" aria-label="Next steps">
          <a class="btn primary" href={ROUTES.lab} data-i18n="ctaTools">Explore tools</a>
          <a class="btn" href={ROUTES.services} data-i18n="ctaServices">Services</a>
          <a class="btn" href={ROUTES.home} data-i18n="ctaMain">Back to main</a>
        </div>

        <p class="closing" data-i18n="closing">
          We start impeccable and simple. We iterate fast with rigor. We measure impact.
          Every pixel, every millisecond and every word carries the VOLYNX standard: useful, beautiful and inevitable.
        </p>
      </div>
    </div>
  </main>

  <Fragment set:html={'<script src="/manifesto-lang.js" defer></script>'} />


  <!-- Cookie Banner -->
  <div class="vx-cookie" id="vxCookie" role="dialog" aria-modal="true" aria-label="Cookie preferences" hidden>
    <div class="vx-cookie__card">
      <div class="vx-cookie__head">
        <span class="vx-cookie__badge">VOLYNX</span>
        <span class="vx-cookie__title" data-i18n="cookieTitle">Cookies &amp; Privacy</span>
      </div>
      <p class="vx-cookie__text" data-i18n="cookieText">
        We use essential cookies for the platform to work. With your permission, we use analytics
        cookies to improve the experience and track impact responsibly. You are in control.
      </p>
      <div class="vx-cookie__actions">
        <button class="vx-btn vx-btn--ghost" id="vxCookiePrefs" type="button" data-i18n="cookiePrefs">Preferences</button>
        <button class="vx-btn vx-btn--soft" id="vxCookieReject" type="button" data-i18n="cookieReject">Reject</button>
        <button class="vx-btn vx-btn--primary" id="vxCookieAccept" type="button" data-i18n="cookieAccept">Accept</button>
      </div>
      <a class="vx-cookie__link" href={ROUTES.privacy} rel="noopener" data-i18n="cookieLink">Privacy policy</a>
      <div class="vx-cookie__prefs" id="vxCookiePanel" hidden>
        <div class="vx-cookie__prefsTitle" data-i18n="cookiePrefsTitle">Preferences</div>
        <label class="vx-toggle">
          <input type="checkbox" checked disabled />
          <span class="vx-toggle__ui"></span>
          <span><span data-i18n="cookieEssential">Essential</span> — <small data-i18n="cookieEssentialSub">Always on</small></span>
        </label>
        <label class="vx-toggle">
          <input type="checkbox" id="vxConsentAnalytics" />
          <span class="vx-toggle__ui"></span>
          <span><span data-i18n="cookieAnalytics">Analytics</span> — <small data-i18n="cookieAnalyticsSub">Helps improve the experience</small></span>
        </label>
        <div class="vx-cookie__prefsActions">
          <button class="vx-btn vx-btn--soft" id="vxCookieSave" type="button" data-i18n="cookieSave">Save</button>
        </div>
      </div>
    </div>
  </div>

  <SiteFooter />
  <PageWidgets hideUtilBar />
</body>
</html>
