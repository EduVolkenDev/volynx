---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VxHeader from "../../components/VxHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { ROUTES } from "../../data/routes";

const title = "Tools — VOLYNX";
const description = "Premium tools with a free Lab lane, plan-gated Studio features, and VX only on actions that are wired to the token system.";

const tools = [
  {
    id: "converter",
    icon: "/assets/converterbig.webp",
    iconAlt: "VOLYNX Converter",
    glow: "blue",
    tag: "Image",
    name: "Converter",
    descEn: "Convert images between formats fast — PNG, JPG, WebP, AVIF. Quality preserved, batches supported.",
    descPt: "Converta imagens entre formatos rapidamente — PNG, JPG, WebP, AVIF. Qualidade preservada, lotes suportados.",
    labHref: ROUTES.labConverter,
    studioHref: ROUTES.labConverter,
  },
  {
    id: "scaler",
    icon: "/assets/newimagescaler.webp",
    iconAlt: "VOLYNX Image Scaler",
    glow: "violet",
    tag: "Image",
    name: "Image Scaler",
    descEn: "Resize without losing sharpness. Lab covers basic resizing; Studio runs the upscaler with neural detail recovery.",
    descPt: "Redimensione sem perder nitidez. Lab faz o resize básico; Studio roda o upscaler com recuperação neural de detalhe.",
    labHref: ROUTES.labImageScaler,
    studioHref: ROUTES.labImageScaler,
  },
  {
    id: "suite",
    icon: "/assets/newimagesuite.webp",
    iconAlt: "VOLYNX iMage Suite",
    glow: "gold",
    tag: "Pro-ready",
    name: "iMage Suite",
    descEn: "Batch optimise, export, compress. The full image pipeline — for whole shoots, full inventories, repeated workflows.",
    descPt: "Otimize, exporte e comprima em lote. Pipeline completo de imagem — pra ensaios inteiros, catálogos completos, workflows repetidos.",
    labHref: ROUTES.labImageSuite,
    studioHref: ROUTES.labImageSuite,
  },
  {
    id: "qr",
    icon: "/assets/newqrgen.webp",
    iconAlt: "VOLYNX QR Generator",
    glow: "teal",
    tag: "Utility",
    name: "QR Generator",
    descEn: "Premium QR codes in seconds: static exports, managed dynamic links, branding, logo overlay and vector output.",
    descPt: "QR codes premium em segundos: exports estáticos, links dinâmicos gerenciados, branding, logo no centro e saída vetorial.",
    labHref: ROUTES.qrgen,
    studioHref: ROUTES.qrgen,
  },
];
---

<BaseLayout title={title} description={description}>
  <VxHeader />

  <main class="shell tools-page">
    <section class="tools-hero">
      <span class="tools-kicker"><span class="i18n-en">All tools, two lanes</span><span class="i18n-pt">Todas as tools, dois caminhos</span></span>
      <h1 class="tools-title" data-i18n="tools.title">
        <span class="i18n-en">Premium tools.<span class="tools-title__accent">Free where it counts.</span></span>
        <span class="i18n-pt">Tools premium.<span class="tools-title__accent">Grátis onde importa.</span></span>
      </h1>
      <p class="tools-sub" data-i18n="tools.subtitle">
        <span class="i18n-en">One catalog, two honest lanes. Lab is free and runs locally in your browser. Studio features are plan-gated, and VX appears only on actions already wired to the token system.</span>
        <span class="i18n-pt">Um catálogo, dois caminhos honestos. Lab é grátis e roda local no seu browser. Recursos Studio são liberados por plano, e VX só aparece em ações já conectadas ao sistema de saldo.</span>
      </p>

      <div class="tools-tiers">
        <div class="tools-tier">
          <span class="tools-tier__badge tools-tier__badge--lab">Lab</span>
          <strong><span class="i18n-en">Free, browser-local</span><span class="i18n-pt">Grátis, no browser</span></strong>
          <span><span class="i18n-en">No account required for most tools.</span><span class="i18n-pt">Maioria sem conta.</span></span>
        </div>
        <div class="tools-tier">
          <span class="tools-tier__badge tools-tier__badge--studio">Studio</span>
          <strong><span class="i18n-en">Plan-gated, premium</span><span class="i18n-pt">Premium por plano</span></strong>
          <span><span class="i18n-en">Selected wired actions can also use VX.</span><span class="i18n-pt">Algumas ações conectadas também usam VX.</span></span>
        </div>
      </div>
    </section>

    <section class="tools-grid">
      {tools.map((tool) => (
        <article class={`tool-card tool-card--${tool.glow}`} data-tool={tool.id}>
          <div class="tool-card__visual">
            <span class={`vx-glow-container vx-glow-container--${tool.glow} vx-glow-container--strong vx-glow-container--xl`}>
              <img src={tool.icon} alt={tool.iconAlt} loading="lazy" />
            </span>
          </div>
          <div class="tool-card__body">
            <span class="tool-card__tag">{tool.tag}</span>
            <h2 class="tool-card__name">{tool.name}</h2>
            <p class="tool-card__desc">
              <span class="i18n-en">{tool.descEn}</span>
              <span class="i18n-pt">{tool.descPt}</span>
            </p>
          </div>
          <div class="tool-card__actions">
            <a class="tool-card__btn tool-card__btn--lab" href={tool.labHref}>
              <span class="tool-card__btn-tier">Lab</span>
              <span class="i18n-en">Open free</span><span class="i18n-pt">Abrir grátis</span>
            </a>
            <a class="tool-card__btn tool-card__btn--studio" href={tool.studioHref}>
              <span class="tool-card__btn-tier">Studio</span>
              <span class="i18n-en">Open Studio</span><span class="i18n-pt">Abrir Studio</span>
            </a>
          </div>
        </article>
      ))}
    </section>

    <section class="tools-footer">
      <div class="tools-footer__signal">
        <span class="tools-footer__dot"></span>
        <span><span class="i18n-en">VX is charged only when a tool explicitly says it will spend VX — Lab stays free forever.</span><span class="i18n-pt">VX só é cobrado quando a ferramenta avisa explicitamente que vai gastar VX — Lab segue grátis pra sempre.</span></span>
      </div>
      <div class="tools-footer__actions">
        <a class="tools-footer__link" href={ROUTES.recarregar}>
          <span class="i18n-en">Top up VX →</span><span class="i18n-pt">Recarregar VX →</span>
        </a>
        <a class="tools-footer__link tools-footer__link--ghost" href={ROUTES.pricing + "#vx-packs"}>
          <span class="i18n-en">See VX packs</span><span class="i18n-pt">Ver packs VX</span>
        </a>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .tools-page { padding: 0 20px 80px; max-width: 1200px; margin: 0 auto; }

  /* ── Hero ───────────────────────────────────────────────── */
  .tools-hero {
    padding: 56px 0 32px;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }
  .tools-kicker {
    display: inline-block;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid rgba(214,179,106,0.25);
    background: rgba(214,179,106,0.08);
    color: #ead8aa;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 18px;
  }
  .tools-title {
    margin: 0 0 18px;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 800;
  }
  .tools-title__accent {
    display: block;
    background: linear-gradient(135deg, #fff, #e8d49a, #89d7ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .tools-sub {
    margin: 0 auto 32px;
    color: rgba(255,255,255,0.62);
    font-size: 1.02rem;
    line-height: 1.75;
    max-width: 640px;
  }

  .tools-tiers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: 640px;
    margin: 0 auto;
  }
  .tools-tier {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.03);
    text-align: left;
  }
  .tools-tier__badge {
    display: inline-flex;
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 6px;
  }
  .tools-tier__badge--lab {
    background: rgba(89,195,255,0.14);
    border: 1px solid rgba(89,195,255,0.28);
    color: #89d7ff;
  }
  .tools-tier__badge--studio {
    background: rgba(214,179,106,0.16);
    border: 1px solid rgba(214,179,106,0.32);
    color: #e8d49a;
  }
  .tools-tier strong { font-size: 0.92rem; color: #fafafa; }
  .tools-tier span:last-child { font-size: 0.82rem; color: rgba(255,255,255,0.55); line-height: 1.55; }

  /* ── Grid ───────────────────────────────────────────────── */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
    margin: 24px 0;
  }

  /* ── Cards ──────────────────────────────────────────────── */
  .tool-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 28px 26px;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,0.08);
    background:
      radial-gradient(circle at 20% 0%, rgba(255,255,255,0.04), transparent 50%),
      linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
    backdrop-filter: blur(12px);
    overflow: hidden;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .tool-card::before {
    content: "";
    position: absolute;
    top: -40%; left: 50%;
    transform: translateX(-50%);
    width: 480px; height: 480px;
    border-radius: 50%;
    opacity: 0.15;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
    transition: opacity .35s ease;
  }
  .tool-card--blue::before    { background: radial-gradient(circle, rgba(89,195,255,1), transparent 60%); }
  .tool-card--violet::before  { background: radial-gradient(circle, rgba(139,92,246,1), transparent 60%); }
  .tool-card--gold::before    { background: radial-gradient(circle, rgba(214,179,106,1), transparent 60%); }
  .tool-card--teal::before    { background: radial-gradient(circle, rgba(45,212,191,1), transparent 60%); }
  .tool-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255,255,255,0.18);
    box-shadow: 0 24px 60px rgba(0,0,0,0.5);
  }
  .tool-card:hover::before { opacity: 0.28; }
  .tool-card > * { position: relative; z-index: 1; }

  /* ── Icon ───────────────────────────────────────────────── */
  .tool-card__visual {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 160px;
  }
  .tool-card__visual .vx-glow-container { width: 160px; height: 160px; }
  .tool-card__visual img {
    width: 100%; height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 16px 36px rgba(0,0,0,0.6));
    transition: transform .35s ease, filter .35s ease;
    animation: tool-icon-float 5.5s ease-in-out infinite;
  }
  .tool-card:hover .tool-card__visual img {
    transform: translateY(-4px) scale(1.04);
    filter: drop-shadow(0 22px 48px rgba(0,0,0,0.7));
  }
  @keyframes tool-icon-float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tool-card__visual img { animation: none; }
  }

  /* ── Body ───────────────────────────────────────────────── */
  .tool-card__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: center;
    flex: 1;
  }
  .tool-card__tag {
    display: inline-flex;
    align-self: center;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.10);
    color: rgba(255,255,255,0.7);
  }
  .tool-card__name {
    margin: 4px 0 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fafafa;
  }
  .tool-card__desc {
    margin: 0;
    color: rgba(255,255,255,0.62);
    line-height: 1.7;
    font-size: 0.92rem;
    max-width: 42ch;
    margin: 0 auto;
  }

  /* ── Actions ────────────────────────────────────────────── */
  .tool-card__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: auto;
  }
  .tool-card__btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12px 14px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.10);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
    transition: background .15s ease, border-color .15s ease, transform .15s ease;
    cursor: pointer;
  }
  .tool-card__btn:hover { transform: translateY(-1px); }
  .tool-card__btn-tier {
    display: block;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    margin-bottom: 2px;
  }
  .tool-card__btn--lab {
    background: rgba(89,195,255,0.06);
    border-color: rgba(89,195,255,0.22);
    color: #89d7ff;
  }
  .tool-card__btn--lab:hover {
    background: rgba(89,195,255,0.12);
    border-color: rgba(89,195,255,0.4);
  }
  .tool-card__btn--lab .tool-card__btn-tier { color: rgba(137,215,255,0.7); }
  .tool-card__btn--studio {
    background: linear-gradient(135deg, rgba(241,222,170,0.12), rgba(214,179,106,0.18));
    border-color: rgba(214,179,106,0.4);
    color: #f1deaa;
  }
  .tool-card__btn--studio:hover {
    background: linear-gradient(135deg, rgba(241,222,170,0.20), rgba(214,179,106,0.28));
    border-color: rgba(214,179,106,0.6);
  }
  .tool-card__btn--studio .tool-card__btn-tier { color: rgba(232,212,154,0.8); }

  /* ── Footer band ────────────────────────────────────────── */
  .tools-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin: 32px 0 0;
    padding: 22px 26px;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,0.06);
    background: rgba(255,255,255,0.02);
  }
  .tools-footer__signal {
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgba(255,255,255,0.7);
    font-size: 0.88rem;
  }
  .tools-footer__dot {
    width: 8px; height: 8px;
    border-radius: 999px;
    background: #34D399;
    box-shadow: 0 0 10px rgba(52,211,153,0.6);
    animation: tools-pulse 1.8s ease-in-out infinite;
  }
  @keyframes tools-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%      { transform: scale(1.4); opacity: 0.5; }
  }
  .tools-footer__actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .tools-footer__link {
    display: inline-flex;
    padding: 10px 18px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--gold-soft, #f1deaa), var(--gold, #d6b36a));
    color: #0a0a0f;
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
    transition: transform .15s ease;
  }
  .tools-footer__link:hover { transform: translateY(-1px); }
  .tools-footer__link--ghost {
    background: rgba(255,255,255,0.04);
    color: rgba(255,255,255,0.85);
    border: 1px solid rgba(255,255,255,0.1);
  }

  @media (max-width: 860px) {
    .tools-grid { grid-template-columns: 1fr; }
    .tools-tiers { grid-template-columns: 1fr; }
    .tools-footer { flex-direction: column; align-items: flex-start; }
  }
</style>
