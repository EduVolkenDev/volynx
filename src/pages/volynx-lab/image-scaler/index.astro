---
import "../../../styles/image-scaler.css";
import LabBg from "../../../components/LabBg.astro";
import FaviconHead from "../../../components/FaviconHead.astro";
import PageWidgets from "../../../components/PageWidgets.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import LabUpgradeBanner from "../../../components/LabUpgradeBanner.astro";
import Topbar from "../../../components/Topbar.astro";
import LabToolShell from "../../../components/LabToolShell.astro";

const pageTitle = "VOLYNX Lab • Image Scaler";
const pageDescription = "Upscale images 2×, 3× or 4× directly in your browser — no upload, no server, 100% local processing.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#080610" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <FaviconHead />
</head>

<body>
  <LabBg />

  <Topbar rightLinks={[{ href: "/volynx-lab/", label: "← Back", i18n: "scaler.back" }]} />
  <LabToolShell active="scaler" />

  <main class="wrap">
    <h1 class="tool-hero-title" aria-label="Image Scaler">
      <span class="tool-hero-stage" aria-hidden="true">
        <span class="tool-hero-orbit tool-hero-orbit--a"></span>
        <span class="tool-hero-orbit tool-hero-orbit--b"></span>
        <span class="tool-hero-beam"></span>
        <span class="tool-hero-shell">
          <img src="/assets/newimagescaler.webp" alt="" class="tool-hero-logo scaler-hero-logo" aria-hidden="true" />
        </span>
      </span>
      <span class="sr-only" data-i18n="scaler.title">High-Quality Upscaling</span>
    </h1>

    <div class="grid">
      <!-- Left card: controls -->
      <div class="card">
        <div class="cardHead">
          <h2 data-i18n="scaler.card_upload">Upload &amp; Settings</h2>
          <label id="pickBtn" for="file" class="btn secondary" role="button" tabindex="0" data-i18n="scaler.btn_select" style="cursor:pointer;display:inline-flex;align-items:center;justify-content:center;">Select</label>
          <input id="file" type="file" accept="image/*" multiple aria-label="Select images" style="position:absolute;opacity:0;pointer-events:none;width:0;height:0;overflow:hidden;" />
        </div>

        <div class="cardBody">
          <label for="file" id="drop" class="drop" aria-label="Drop zone">
            <span class="icon">⬆</span>
            <p data-i18n="scaler.drop_text">Drop images here or click to select</p>
          </label>

          <div class="field-row">
            <label>
              <span data-i18n="scaler.scale_label">Scale</span>
              <select id="scale" aria-label="Scale factor">
                <option value="2">2×</option>
                <option value="3">3×</option>
                <option value="4" selected>4×</option>
              </select>
            </label>

            <label>
              <span data-i18n="scaler.format_label">Output format</span>
              <select id="format" aria-label="Output format">
                <option value="image/png">PNG</option>
                <option value="image/webp">WebP</option>
                <option value="image/jpeg">JPG</option>
              </select>
            </label>

            <label>
              <input id="smooth" type="checkbox" checked aria-label="High quality smoothing" />
              <span data-i18n="scaler.smooth_label">High-quality smoothing</span>
            </label>
          </div>

          <button id="runBtn" class="btn" type="button" disabled style="margin-top:18px;width:100%" data-i18n="scaler.btn_upscale">Upscale</button>

          <div class="kpis">
            <div class="kpi">
              <b data-i18n="scaler.original_label">Original</b>
              <span id="origMeta">—</span>
            </div>
            <div class="kpi">
              <b data-i18n="scaler.result_label">Result</b>
              <span id="outMeta">—</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right card: preview -->
      <div class="card">
        <div class="cardHead">
          <h2 data-i18n="scaler.card_preview">Preview</h2>
          <button id="downloadBtn" class="btn" type="button" disabled data-i18n="scaler.btn_download">Download</button>
        </div>
        <div class="cardBody">
          <img id="preview" class="preview" alt="Upscaled preview" />
        </div>
      </div>
    </div>
  </main>

  <script is:inline src="/js/vx-file-metrics.js"></script>
  <script is:inline src="/js/vx-auth-bridge.js"></script>
  <script is:inline src="/scripts/vx-lab-workspace.js?v=20260610-memory-manager"></script>
  <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>

  <script is:inline>
    const FREE_LIMIT = 5;
    const STORAGE_KEY = "volynx_scaler_usage";

    function todayKey() {
      const d = new Date();
      return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
    }

    function getLocalUsage() {
      const raw = localStorage.getItem(STORAGE_KEY);
      const today = todayKey();
      if (!raw) { const data = { date: today, used: 0 }; localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); return data; }
      try {
        const data = JSON.parse(raw);
        if (data.date !== today) { const reset = { date: today, used: 0 }; localStorage.setItem(STORAGE_KEY, JSON.stringify(reset)); return reset; }
        return data;
      } catch { const reset = { date: today, used: 0 }; localStorage.setItem(STORAGE_KEY, JSON.stringify(reset)); return reset; }
    }

    function incrementLocalUsage(n) {
      const data = getLocalUsage();
      data.used += n;
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    }

    async function getConfig() {
      try { return await fetch('/config.json', { cache: 'no-store' }).then(r => r.json()); }
      catch { return {}; }
    }

    async function checkToolPermission(toolName, count) {
      const cfg = await getConfig();
      const apiBase = (cfg.functionsUrl || cfg.apiBaseUrl || '').replace(/\/$/, '');
      const token = localStorage.getItem('volynx_access_token') || '';
      if (apiBase && token) {
        try {
          const ctrl = new AbortController();
          const t = setTimeout(() => ctrl.abort(), 8000);
          const res = await fetch(`${apiBase}/check-permission`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) },
            body: JSON.stringify({ tool: toolName }),
            signal: ctrl.signal,
          });
          clearTimeout(t);
          if (res.ok) {
            const perm = await res.json();
            if (!perm.useLocalStorage) return { allowed: perm.remaining === -1 || perm.remaining >= count, plan: perm.plan, remaining: perm.remaining, limit: perm.limit, source: 'server' };
          }
        } catch (_) {}
      }
      const usage = getLocalUsage();
      const remaining = Math.max(0, FREE_LIMIT - usage.used);
      return { allowed: remaining >= count, plan: 'free', remaining, limit: FREE_LIMIT, source: 'local' };
    }

    async function logToolUsage(toolName, amount) {
      const cfg = await getConfig();
      const apiBase = (cfg.functionsUrl || cfg.apiBaseUrl || '').replace(/\/$/, '');
      const token = localStorage.getItem('volynx_access_token') || '';
      if (apiBase && token) {
        fetch(`${apiBase}/log-usage`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ tool: toolName, amount }),
        }).catch(() => {});
      }
      incrementLocalUsage(amount);
    }

    function $(id) { return document.getElementById(id); }

    function labNotify(title, message, tone = "warn") {
      if (window.VxLab?.notify) {
        VxLab.notify({
          tool: "image-scaler",
          event: tone === "error" ? "error_notice" : "notice",
          icon: tone === "error" ? "!" : "i",
          title,
          message,
          primaryLabel: "OK",
          cancelLabel: "Close",
        });
      } else {
        alert(message || title);
      }
    }

    function valueExists(select, value) {
      return Boolean(select && Array.from(select.options).some((option) => option.value === value));
    }

    function setDropMessage(message) {
      const text = dropEl?.querySelector("p");
      if (!text) return;
      text.removeAttribute("data-i18n");
      text.textContent = message;
    }

    const fileEl      = $("file");
    const pickBtn     = $("pickBtn");
    const dropEl      = $("drop");
    const runBtn      = $("runBtn");
    const downloadBtn = $("downloadBtn");
    const previewEl   = $("preview");
    const scaleEl     = $("scale");
    const fmtEl       = $("format");
    const smoothEl    = $("smooth");
    const origMeta    = $("origMeta");
    const outMeta     = $("outMeta");

    let loadedImages = [];
    let processedResults = [];
    let singleBlob = null;

    function applyScalerPreset(values = {}) {
      const scale = String(values.scale || "").replace(/x$/i, "");
      if (valueExists(scaleEl, scale)) scaleEl.value = scale;

      const format = String(values.format || "");
      const mime = format.includes("/") ? format : (format ? `image/${format === "jpg" ? "jpeg" : format}` : "");
      if (valueExists(fmtEl, mime)) fmtEl.value = mime;

      if (values.smoothing) smoothEl.checked = values.smoothing !== "off";
      scaleEl.dispatchEvent(new Event("change", { bubbles: true }));
      fmtEl.dispatchEvent(new Event("change", { bubbles: true }));
      smoothEl.dispatchEvent(new Event("change", { bubbles: true }));
    }

    if (window.VxLab?.renderToolPresets) {
      VxLab.renderToolPresets("image-scaler", {
        anchor: ".field-row",
        apply: applyScalerPreset,
        emptyText: "Upscale an image once and your scale preset appears here.",
      });
    }
    window.VxLab?.restorePresetFromUrl?.("image-scaler", applyScalerPreset, {
      onSuccess: () => { setDropMessage("Saved Image Scaler preset restored."); },
      onMissing: () => { setDropMessage("Saved Image Scaler preset was not found in this browser."); },
    });

    function resetPreview() {
      if (previewEl) previewEl.removeAttribute("src");
      if (outMeta) outMeta.textContent = "—";
      if (downloadBtn) downloadBtn.disabled = true;
      processedResults = [];
      singleBlob = null;
    }

    async function fileToImage(file) {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.src = url;
      await img.decode();
      URL.revokeObjectURL(url);
      return img;
    }

    async function loadFiles(files) {
      const valid = files.filter(f => f && f.type && f.type.startsWith("image/"));
      loadedImages = [];
      resetPreview();
      if (!valid.length) {
        labNotify("No valid images", "Select a PNG, JPG, WebP or another browser-readable image.");
        return;
      }

      runBtn.disabled = true;
      dropEl.querySelector("p").textContent = `Loading ${valid.length} file(s)...`;

      for (const f of valid) {
        const img = await fileToImage(f);
        loadedImages.push({ file: f, img, baseName: f.name.replace(/\.[^/.]+$/, "") });
      }

      const totalBytes = valid.reduce((s, f) => s + f.size, 0);
      origMeta.textContent = `${valid.length} file(s) · ${(totalBytes / 1024 / 1024).toFixed(2)} MB`;
      dropEl.querySelector("p").textContent = `${valid.length} file(s) ready`;
      runBtn.disabled = false;
      if (window.VxLab) VxLab.recordEvent("image-scaler", "upload", `${valid.length} file(s) selected`);
    }

    function canvasToBlob(canvas, mime, quality) {
      return new Promise((res, rej) => {
        canvas.toBlob(blob => blob ? res(blob) : rej(new Error("Blob generation failed")), mime, quality);
      });
    }

    async function upscaleOne(item, scale, mime, useSmooth) {
      const { img, file, baseName } = item;
      const canvas = document.createElement("canvas");
      canvas.width  = img.width  * scale;
      canvas.height = img.height * scale;
      const ctx = canvas.getContext("2d");
      ctx.imageSmoothingEnabled = useSmooth;
      if (useSmooth) ctx.imageSmoothingQuality = "high";
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      const blob = await canvasToBlob(canvas, mime, 0.95);
      return { baseName, originalFile: file, blob, width: canvas.width, height: canvas.height };
    }

    function triggerFilePicker() {
      if (fileEl) fileEl.click();
    }

    function handlePickerKeydown(event) {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        triggerFilePicker();
      }
    }

    pickBtn?.addEventListener("keydown", handlePickerKeydown);
    dropEl?.addEventListener("keydown", handlePickerKeydown);

    fileEl.addEventListener("change", async () => {
      const files = Array.from(fileEl.files || []);
      fileEl.value = "";
      if (files.length) await loadFiles(files);
    });
    dropEl.addEventListener("dragover", e => e.preventDefault());
    dropEl.addEventListener("drop", async e => {
      e.preventDefault();
      const files = Array.from((e.dataTransfer && e.dataTransfer.files) || []);
      if (files.length) await loadFiles(files);
    });

    runBtn.addEventListener("click", async () => {
      if (!loadedImages.length) return;

      const perm = await checkToolPermission("image-scaler", loadedImages.length);
      if (!perm.allowed) {
        const isFreeUser = window.VxPlan ? !window.VxPlan.isPaid(perm.plan) : (perm.plan === 'free');
        if (window.VxLab?.shouldSendToLogin(perm)) {
          VxLab.confirmLogin(
            VxLab.currentReturnPath(),
            "Sign in to continue upscaling. You will return to Image Scaler after login."
          );
        } else if (isFreeUser && window.VxLab) {
          VxLab.confirmUpgrade(`Daily limit reached (${perm.limit}). Upgrade to Pro for more.\n\nClick OK to see upgrade options.`);
        } else {
          labNotify("Daily limit reached", `You have used today's Image Scaler allowance (${perm.limit}). Try again tomorrow.`, "warn");
        }
        return;
      }

      const scale  = parseInt(scaleEl.value, 10);
      const mime   = fmtEl.value;
      const smooth = smoothEl.checked;

      runBtn.disabled = true;
      downloadBtn.disabled = true;
      processedResults = [];
      singleBlob = null;

      try {
        for (let i = 0; i < loadedImages.length; i++) {
          dropEl.querySelector("p").textContent = `Processing ${i + 1}/${loadedImages.length}...`;
          const result = await upscaleOne(loadedImages[i], scale, mime, smooth);
          processedResults.push(result);
          if (i === 0) previewEl.src = URL.createObjectURL(result.blob);
        }

        const totalOut = processedResults.reduce((s, r) => s + r.blob.size, 0);
        outMeta.textContent = `${processedResults.length} file(s) · ${(totalOut / 1024 / 1024).toFixed(2)} MB`;
        if (processedResults.length === 1) singleBlob = processedResults[0].blob;
        logToolUsage("image-scaler", processedResults.length);
        if (window.VxLab) {
          VxLab.recordEvent("image-scaler", "upscale", `${processedResults.length} file(s) upscaled at ${scale}x`);
          VxLab.savePreset("image-scaler", {
            scale: `${scale}x`,
            format: mime.split("/")[1],
            smoothing: smooth ? "high" : "off",
          });
        }
        dropEl.querySelector("p").textContent = `${processedResults.length} file(s) upscaled`;
        downloadBtn.disabled = false;
      } catch (err) {
        console.error(err);
        labNotify("Processing failed", "Image Scaler could not process this image. Try a smaller file or another format.", "error");
        dropEl.querySelector("p").textContent = "Error — please try again";
      } finally {
        runBtn.disabled = false;
      }
    });

    downloadBtn.addEventListener("click", async () => {
      if (!processedResults.length) return;
      const ext = fmtEl.value.split("/")[1];

      if (processedResults.length === 1 && singleBlob) {
        const a = document.createElement("a");
        a.href = URL.createObjectURL(singleBlob);
        a.download = `${processedResults[0].baseName}-${scaleEl.value}x.${ext}`;
        a.click();
        if (window.VxLab) VxLab.recordEvent("image-scaler", "download", a.download);
        return;
      }

      if (!window.JSZip) {
        labNotify("ZIP export unavailable", "The ZIP library did not load. Reload the page and try again.", "error");
        return;
      }
      const zip = new window.JSZip();
      for (const r of processedResults) {
        zip.file(`${r.baseName}-${scaleEl.value}x.${ext}`, r.blob);
      }
      const zipBlob = await zip.generateAsync({ type: "blob" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(zipBlob);
      a.download = "volynx-scaler-batch.zip";
      a.click();
      if (window.VxLab) VxLab.recordEvent("image-scaler", "download", "Batch ZIP downloaded");
    });
  </script>

  <LabUpgradeBanner />
  <SiteFooter />
  <PageWidgets hideUtilBar />
</body>
</html>
