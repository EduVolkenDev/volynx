---
import "../../../styles/image-suite.css";
import PageWidgets from "../../../components/PageWidgets.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import LabUpgradeBanner from "../../../components/LabUpgradeBanner.astro";

const pageTitle = "VOLYNX Lab • iMage Suite";
const pageDescription = "Free image suite — upscale, compress and convert images directly in your browser, no upload required.";
---

<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#080610" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/assets/site.webmanifest" />
</head>

<body>
  <div class="bg" aria-hidden="true"></div>

  <header class="topbar">
    <div class="topbar__inner">
      <a class="pill-back" href="/volynx-lab/">← Voltar</a>
    </div>
  </header>

  <main class="wrap">
    <h1>iMage Suite</h1>

    <div class="grid">
      <div class="card">
        <div class="cardHead">
          <strong>Upload &amp; Config</strong>
          <button id="pickBtn" class="btn secondary" type="button">Selecionar</button>
          <input id="file" type="file" accept="image/*" multiple hidden aria-label="Select images" />
        </div>

        <div class="cardBody">
          <div id="drop" class="drop" role="button" tabindex="0" aria-label="Drop zone">
            Arraste imagens aqui ou clique para selecionar
          </div>

          <div class="field-group">
            <label class="field">
              Ferramenta
              <select id="tool" aria-label="Tool">
                <option value="upscale" selected>Upscale</option>
                <option value="compress">Compress</option>
                <option value="convert">Convert</option>
              </select>
            </label>

            <label class="field">
              Escala (Upscale)
              <select id="scale" aria-label="Scale">
                <option value="2">2x</option>
                <option value="3">3x</option>
                <option value="4" selected>4x</option>
              </select>
            </label>

            <label class="field">
              Formato
              <select id="format" aria-label="Output format">
                <option value="image/png">PNG</option>
                <option value="image/webp">WebP</option>
                <option value="image/jpeg">JPG</option>
              </select>
            </label>

            <label class="field">
              Qualidade (Compress)
              <input id="quality" type="range" min="0.3" max="1" step="0.05" value="0.85" aria-label="Quality" />
              <em id="qualityVal" style="font-style:normal;font-size:12px;color:rgba(255,255,255,.68)">0.85</em>
            </label>
          </div>

          <button id="runBtn" class="btn" type="button" disabled style="margin-top:16px">Processar</button>

          <hr />

          <div class="license-row">
            <input
              id="licenseKey"
              class="license-input"
              placeholder="Enter PRO License"
              type="text"
              aria-label="License key"
            />
            <button id="activateBtn" class="btn secondary" type="button">Activate</button>
          </div>

          <div id="proStatus" class="pro-status" aria-live="polite"></div>

          <div class="kpis">
            <div class="kpi">
              <strong>Original</strong>
              <div id="origMeta">—</div>
            </div>
            <div class="kpi">
              <strong>Resultado</strong>
              <div id="outMeta">—</div>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="cardHead">
          <strong>Resultado</strong>
          <button id="downloadBtn" class="btn" type="button" disabled>Baixar</button>
        </div>
        <div class="cardBody">
          <img id="preview" class="preview" alt="Result preview" />
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>

  <script is:inline>
    const FREE_LIMIT = 3;
    const VALID_LICENSES = ["VOLYNX-PRO-2026", "VOLYNX-LIFETIME-001"];

    function todayKey() {
      const d = new Date();
      return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
    }

    function getUsage() {
      const raw = localStorage.getItem("volynx_usage");
      const today = todayKey();

      if (!raw) {
        const data = { date: today, used: 0 };
        localStorage.setItem("volynx_usage", JSON.stringify(data));
        return data;
      }

      try {
        const data = JSON.parse(raw);

        if (data.date !== today) {
          const reset = { date: today, used: 0 };
          localStorage.setItem("volynx_usage", JSON.stringify(reset));
          return reset;
        }

        return data;
      } catch (err) {
        const reset = { date: today, used: 0 };
        localStorage.setItem("volynx_usage", JSON.stringify(reset));
        return reset;
      }
    }

    function incrementUsage(amount = 1) {
      const data = getUsage();
      data.used += amount;
      localStorage.setItem("volynx_usage", JSON.stringify(data));
    }

    function $(id) {
      return document.getElementById(id);
    }

    const fileEl = $("file");
    const pickBtn = $("pickBtn");
    const dropEl = $("drop");
    const runBtn = $("runBtn");
    const downloadBtn = $("downloadBtn");
    const previewEl = $("preview");
    const toolEl = $("tool");
    const scaleEl = $("scale");
    const fmtEl = $("format");
    const qualityEl = $("quality");
    const qualityValEl = $("qualityVal");
    const origMeta = $("origMeta");
    const outMeta = $("outMeta");
    const licenseInput = $("licenseKey");
    const activateBtn = $("activateBtn");
    const proStatus = $("proStatus");

    let isPro = localStorage.getItem("volynx_pro") === "true";
    let loadedImages = [];
    let processedResults = [];
    let singleOutBlob = null;

    function updateProUI() {
      proStatus.textContent = isPro ? "PRO Activated ✔ Unlimited access enabled" : "";
    }

    function resetPreview() {
      if (previewEl) previewEl.removeAttribute("src");
      if (outMeta) outMeta.textContent = "—";
      if (downloadBtn) downloadBtn.disabled = true;
      processedResults = [];
      singleOutBlob = null;
    }

    async function fileToImage(file) {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.src = url;
      await img.decode();
      URL.revokeObjectURL(url);
      return img;
    }

    async function loadFiles(files) {
      const validFiles = files.filter((file) => file && file.type && file.type.startsWith("image/"));

      loadedImages = [];
      resetPreview();

      if (!validFiles.length) {
        alert("Nenhuma imagem válida encontrada.");
        return;
      }

      runBtn.disabled = true;
      dropEl.textContent = `Carregando ${validFiles.length} arquivo(s)...`;

      for (const file of validFiles) {
        const img = await fileToImage(file);
        loadedImages.push({
          file,
          img,
          baseName: file.name.replace(/\.[^/.]+$/, "")
        });
      }

      const totalBytes = validFiles.reduce((sum, file) => sum + file.size, 0);
      origMeta.textContent = `${validFiles.length} arquivo(s) • ${(totalBytes / 1024 / 1024).toFixed(2)}MB`;
      dropEl.textContent = `${validFiles.length} arquivo(s) pronto(s) para processar`;
      runBtn.disabled = false;
    }

    function canvasToBlob(canvas, mime, quality) {
      return new Promise((resolve, reject) => {
        canvas.toBlob((blob) => {
          if (!blob) {
            reject(new Error("Falha ao gerar arquivo."));
            return;
          }
          resolve(blob);
        }, mime, quality);
      });
    }

    async function processOne(item, tool, scale, mime, quality) {
      const img = item.img;
      const file = item.file;
      const baseName = item.baseName;

      const w = img.width;
      const h = img.height;

      const canvas = document.createElement("canvas");
      const ctx = canvas.getContext("2d");

      if (!ctx) {
        throw new Error("Falha ao criar contexto do canvas.");
      }

      if (tool === "upscale") {
        canvas.width = w * scale;
        canvas.height = h * scale;
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = "high";
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      } else {
        canvas.width = w;
        canvas.height = h;
        ctx.drawImage(img, 0, 0);
      }

      const blob = await canvasToBlob(
        canvas,
        mime,
        tool === "compress" ? quality : 0.95
      );

      return {
        baseName,
        originalFile: file,
        blob,
        width: canvas.width,
        height: canvas.height
      };
    }

    activateBtn.addEventListener("click", () => {
      const key = licenseInput.value.trim();

      if (VALID_LICENSES.includes(key)) {
        localStorage.setItem("volynx_pro", "true");
        isPro = true;
        updateProUI();
        alert("PRO Activated Successfully!");
      } else {
        alert("Invalid License Key");
      }
    });

    updateProUI();

    qualityEl.addEventListener("input", () => {
      qualityValEl.textContent = qualityEl.value;
    });

    pickBtn.addEventListener("click", () => {
      fileEl.click();
    });

    dropEl.addEventListener("click", () => {
      fileEl.click();
    });

    dropEl.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        fileEl.click();
      }
    });

    fileEl.addEventListener("change", async () => {
      const files = Array.from(fileEl.files || []);
      if (!files.length) return;
      await loadFiles(files);
    });

    dropEl.addEventListener("dragover", (e) => {
      e.preventDefault();
    });

    dropEl.addEventListener("drop", async (e) => {
      e.preventDefault();
      const files = Array.from((e.dataTransfer && e.dataTransfer.files) || []);
      if (!files.length) return;
      await loadFiles(files);
    });

    runBtn.addEventListener("click", async () => {
      if (!loadedImages.length) return;

      const usage = getUsage();
      const tool = toolEl.value;
      const scale = parseInt(scaleEl.value, 10);
      const mime = fmtEl.value;
      const quality = parseFloat(qualityEl.value);

      if (!isPro && usage.used + loadedImages.length > FREE_LIMIT) {
        alert(`No plano free você pode processar até ${FREE_LIMIT} imagens por dia. O lote atual excede esse limite.`);
        return;
      }

      runBtn.disabled = true;
      downloadBtn.disabled = true;
      processedResults = [];
      singleOutBlob = null;

      try {
        for (let i = 0; i < loadedImages.length; i++) {
          dropEl.textContent = `Processando ${i + 1}/${loadedImages.length}...`;

          const result = await processOne(loadedImages[i], tool, scale, mime, quality);
          processedResults.push(result);

          if (i === 0) {
            const url = URL.createObjectURL(result.blob);
            previewEl.src = url;
          }
        }

        const totalOutBytes = processedResults.reduce((sum, result) => sum + result.blob.size, 0);
        outMeta.textContent = `${processedResults.length} arquivo(s) • ${(totalOutBytes / 1024 / 1024).toFixed(2)}MB`;

        if (processedResults.length === 1) {
          singleOutBlob = processedResults[0].blob;
        }

        if (!isPro) {
          incrementUsage(processedResults.length);
        }

        dropEl.textContent = `${processedResults.length} arquivo(s) processado(s) com sucesso`;
        downloadBtn.disabled = false;
      } catch (error) {
        console.error(error);
        alert("Ocorreu um erro ao processar as imagens.");
        dropEl.textContent = "Erro ao processar arquivos";
      } finally {
        runBtn.disabled = false;
      }
    });

    downloadBtn.addEventListener("click", async () => {
      if (!processedResults.length) return;

      const ext = fmtEl.value.split("/")[1];

      if (processedResults.length === 1 && singleOutBlob) {
        const a = document.createElement("a");
        a.href = URL.createObjectURL(singleOutBlob);
        a.download = `${processedResults[0].baseName}.${ext}`;
        a.click();
        return;
      }

      if (!window.JSZip) {
        alert("JSZip não carregado.");
        return;
      }

      const zip = new window.JSZip();

      for (const result of processedResults) {
        zip.file(`${result.baseName}.${ext}`, result.blob);
      }

      const zipBlob = await zip.generateAsync({ type: "blob" });

      const a = document.createElement("a");
      a.href = URL.createObjectURL(zipBlob);
      a.download = "volynx-image-suite-batch.zip";
      a.click();
    });
  </script>

  <LabUpgradeBanner />
  <SiteFooter />
  <PageWidgets />
</body>
</html>