---
import "../../../styles/image-suite.css";
import LabBg from "../../../components/LabBg.astro";
import FaviconHead from "../../../components/FaviconHead.astro";
import PageWidgets from "../../../components/PageWidgets.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import LabUpgradeBanner from "../../../components/LabUpgradeBanner.astro";
import Topbar from "../../../components/Topbar.astro";
import LabToolShell from "../../../components/LabToolShell.astro";

const pageTitle = "VOLYNX Lab • Image Suite";
const pageDescription = "Local-first image suite — upscale, compress, convert and remove backgrounds directly in your browser, no upload required.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#080610" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <FaviconHead />
  <script is:inline src="/js/vx-file-metrics.js"></script>
</head>

<body>
  <LabBg />

  <Topbar rightLinks={[{ href: "/volynx-lab/", label: "← Back", i18n: "suite.back" }]} />
  <LabToolShell active="suite" />

  <main class="wrap">
    <h1 class="tool-hero-title suite-logo-title" aria-label="Image Suite">
      <span class="tool-hero-stage suite-hero-stage" aria-hidden="true">
        <span class="tool-hero-orbit tool-hero-orbit--a suite-hero-orbit suite-hero-orbit--a"></span>
        <span class="tool-hero-orbit tool-hero-orbit--b suite-hero-orbit suite-hero-orbit--b"></span>
        <span class="tool-hero-beam suite-hero-beam"></span>
        <span class="tool-hero-shell suite-logo-shell">
          <img src="/assets/newimagesuite.webp" alt="" class="suite-logo" aria-hidden="true" />
        </span>
      </span>
      <span class="sr-only" data-i18n="suite.title">Image Suite</span>
    </h1>

    <div class="suite-grid">
      <div class="card">
        <div class="cardHead">
          <strong data-i18n="suite.card_upload">Upload &amp; Config</strong>
          <label
            id="pickBtn"
            for="file"
            class="btn secondary"
            role="button"
            tabindex="0"
            data-i18n="suite.btn_select"
          >
            Select
          </label>
          <input
            id="file"
            type="file"
            accept="image/*"
            multiple
            aria-label="Select images"
            style="position:absolute;opacity:0;pointer-events:none;width:0;height:0;overflow:hidden;"
          />
        </div>

        <div class="cardBody">
          <label for="file" id="drop" class="drop" aria-label="Drop zone" tabindex="0">
            <span class="icon" aria-hidden="true">⬆</span>
            <p data-i18n="suite.drop_text">Drag images here or click to select</p>
          </label>

          <div class="field-group">
            <label class="field">
              <span data-i18n="suite.tool_label">Ferramenta</span>
              <select id="tool" aria-label="Tool">
                <option value="upscale" selected data-i18n="suite.tool_upscale">Upscale</option>
                <option value="compress" data-i18n="suite.tool_compress">Compress</option>
                <option value="convert" data-i18n="suite.tool_convert">Convert</option>
                <option value="bg-remove" data-i18n="suite.tool_bg_remove" data-pro="true">Remove BG</option>
              </select>
            </label>

            <label class="field" id="scaleGroup">
              <span data-i18n="suite.scale_label">Escala (Upscale)</span>
              <select id="scale" aria-label="Scale">
                <option value="2">2x</option>
                <option value="3">3x</option>
                <option value="4" selected>4x</option>
              </select>
            </label>

            <label class="field" id="formatGroup">
              <span data-i18n="suite.format_label">Formato</span>
              <select id="format" aria-label="Output format">
                <option value="image/png">PNG</option>
                <option value="image/webp">WebP</option>
                <option value="image/jpeg">JPG</option>
              </select>
            </label>

            <label class="field" id="qualityGroup">
              <span data-i18n="suite.quality_label">Qualidade (Compress)</span>
              <input id="quality" type="range" min="0.3" max="1" step="0.05" value="0.85" aria-label="Quality" />
              <em id="qualityVal" style="font-style:normal;font-size:12px;color:rgba(255,255,255,.68)">0.85</em>
            </label>
          </div>

          <div class="field-group" id="bgRemoveGroup" hidden>
            <label class="field">
              <span data-i18n="suite.bg_format_label">Output Format</span>
              <select id="bgFormat" aria-label="Background removal output format">
                <option value="image/png" data-i18n="suite.bg_fmt_png">PNG (transparent)</option>
                <option value="image/webp" data-i18n="suite.bg_fmt_webp">WebP (transparent)</option>
              </select>
            </label>

            <label class="field">
              <span data-i18n="suite.bg_fill_label">Background Fill</span>
              <div class="bg-fill-row">
                <select id="bgFill" aria-label="Background fill">
                  <option value="transparent" data-i18n="suite.bg_fill_none">None (transparent)</option>
                  <option value="white" data-i18n="suite.bg_fill_white">White</option>
                  <option value="black" data-i18n="suite.bg_fill_black">Black</option>
                  <option value="custom" data-i18n="suite.bg_fill_custom">Custom color</option>
                </select>
                <input
                  type="color"
                  id="bgFillColor"
                  value="#ffffff"
                  hidden
                  aria-label="Custom background color"
                  data-i18n-aria="suite.bg_fill_color_aria"
                />
              </div>
            </label>

            <div class="bg-progress" id="bgProgress" hidden>
              <span class="bg-progress__label" id="bgProgressLabel" data-i18n="suite.bg_progress">Loading AI model...</span>
              <div class="bg-progress__bar" aria-hidden="true">
                <div class="bg-progress__fill" id="bgProgressFill" style="width:0%"></div>
              </div>
            </div>
          </div>

          <p id="fmtHint" class="fmt-hint" hidden></p>
          <button id="runBtn" class="btn" type="button" disabled style="margin-top:16px" data-i18n="suite.btn_process">Process</button>

          <div id="proStatus" class="pro-status" aria-live="polite"></div>

          <div class="kpis">
            <div class="kpi">
              <strong data-i18n="suite.original_label">Original</strong>
              <div id="origMeta">—</div>
            </div>
            <div class="kpi">
              <strong data-i18n="suite.result_label">Resultado</strong>
              <div id="outMeta">—</div>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="cardHead">
          <strong data-i18n="suite.card_result">Resultado</strong>
          <button id="downloadBtn" class="btn" type="button" disabled data-i18n="suite.btn_download">Baixar</button>
        </div>
        <div class="cardBody cardBody--preview">
          <div id="previewShell" class="preview-shell" data-state="empty">
            <img id="preview" class="preview" alt="Result preview" />
            <p class="preview-empty">Process the first file to see the preview here.</p>
          </div>
          <p id="resultHint" class="result-hint" hidden></p>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
  <script is:inline src="/scripts/vx-lab-workspace.js?v=20260604-lab-modal"></script>

  <script is:inline>
    const FREE_LIMIT = 3;
    const STORAGE_KEY = "volynx_suite_usage";
    // Background removal: U²-Net portable (Apache-2.0) running fully local via onnxruntime-web.
    // Replaces the previous @imgly/background-removal (AGPL-3.0) integration so the
    // pipeline stays commercial-safe without paying a copyleft license fee.
    const ORT_VERSION = "1.21.0";
    const ORT_BASE = `https://cdn.jsdelivr.net/npm/onnxruntime-web@${ORT_VERSION}/dist/`;
    const BG_MODEL_URL = "/models/u2netp.onnx";
    const BG_MODEL_INPUT_SIZE = 320;
    const BG_REMOVAL_META = {
      model: "u2netp",
      lib: `onnxruntime-web@${ORT_VERSION} + u2netp (Apache-2.0)`
    };
    // License keys removed — plan is checked server-side via check-permission API

    function todayKey() {
      const d = new Date();
      return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
    }

    function getLocalUsage() {
      const raw = localStorage.getItem(STORAGE_KEY);
      const today = todayKey();
      if (!raw) { const data = { date: today, used: 0 }; localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); return data; }
      try {
        const data = JSON.parse(raw);
        if (data.date !== today) { const reset = { date: today, used: 0 }; localStorage.setItem(STORAGE_KEY, JSON.stringify(reset)); return reset; }
        return data;
      } catch { const reset = { date: today, used: 0 }; localStorage.setItem(STORAGE_KEY, JSON.stringify(reset)); return reset; }
    }

    function incrementLocalUsage(amount = 1) {
      const data = getLocalUsage();
      data.used += amount;
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    }

    async function getConfig() {
      try { return await fetch('/config.json', { cache: 'no-store' }).then(r => r.json()); }
      catch { return {}; }
    }

    async function checkToolPermission(toolName, count, options = {}) {
      const { allowLocalFallback = true } = options;
      const cfg = await getConfig();
      const apiBase = (cfg.functionsUrl || cfg.apiBaseUrl || '').replace(/\/$/, '');
      const token = localStorage.getItem('volynx_access_token') || '';
      if (apiBase) {
        try {
          const ctrl = new AbortController();
          const t = setTimeout(() => ctrl.abort(), 8000);
          const res = await fetch(`${apiBase}/check-permission`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) },
            body: JSON.stringify({ tool: toolName }),
            signal: ctrl.signal,
          });
          clearTimeout(t);
          if (res.ok) {
            const perm = await res.json();
            const normalized = {
              allowed: perm.remaining === -1 || perm.remaining >= count,
              plan: perm.plan,
              remaining: perm.remaining,
              limit: perm.limit,
              source: 'server',
            };
            // Anonymous/free Image Suite usage still relies on the local daily
            // counter. Some deployments return limit=0 until a user token is
            // present, which made the compressor look broken because "Process"
            // immediately hit a confirm instead of falling back to the local
            // free allowance.
            const shouldUseAnonymousFallback =
              allowLocalFallback &&
              !token &&
              perm.limit === 0 &&
              (!perm.plan || perm.plan === 'free');
            if (!perm.useLocalStorage || !allowLocalFallback || (perm.limit === 0 && !shouldUseAnonymousFallback)) {
              return normalized;
            }
          }
        } catch (_) {}
      }
      if (!allowLocalFallback) {
        const cachedPlan = window.VxPlan?.getCached()?.plan || (isPro ? "pro" : "free");
        const cachedPaid = window.VxPlan
          ? window.VxPlan.isPaid(cachedPlan)
          : (cachedPlan !== "free" && cachedPlan !== "");
        return {
          allowed: cachedPaid,
          plan: cachedPlan,
          remaining: cachedPaid ? -1 : 0,
          limit: cachedPaid ? -1 : 0,
          source: cachedPaid ? "cache" : "local",
        };
      }
      const usage = getLocalUsage();
      const remaining = Math.max(0, FREE_LIMIT - usage.used);
      return { allowed: remaining >= count, plan: 'free', remaining, limit: FREE_LIMIT, source: 'local' };
    }

    async function logToolUsage(toolName, amount) {
      const cfg = await getConfig();
      const apiBase = (cfg.functionsUrl || cfg.apiBaseUrl || '').replace(/\/$/, '');
      const token = localStorage.getItem('volynx_access_token') || '';
      if (apiBase && token) {
        fetch(`${apiBase}/log-usage`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ tool: toolName, amount }),
        }).catch(() => {});
      }
      incrementLocalUsage(amount);
    }

    function $(id) {
      return document.getElementById(id);
    }

    function labNotify(title, message, tone = "warn") {
      if (window.VxLab?.notify) {
        VxLab.notify({
          tool: "image-suite",
          event: tone === "error" ? "error_notice" : "notice",
          icon: tone === "error" ? "!" : "i",
          title,
          message,
          primaryLabel: "OK",
          cancelLabel: "Close",
        });
      } else {
        alert(message || title);
      }
    }

    const fileEl = $("file");
    const dropEl = $("drop");
    const pickBtn = $("pickBtn");
    const runBtn = $("runBtn");
    const downloadBtn = $("downloadBtn");
    const previewEl = $("preview");
    const previewShell = $("previewShell");
    const toolEl = $("tool");
    const scaleEl = $("scale");
    const fmtEl = $("format");
    const qualityEl = $("quality");
    const qualityValEl = $("qualityVal");
    const scaleGroup = $("scaleGroup");
    const formatGroup = $("formatGroup");
    const qualityGroup = $("qualityGroup");
    const bgRemoveGroup = $("bgRemoveGroup");
    const bgFormatEl = $("bgFormat");
    const bgFillEl = $("bgFill");
    const bgFillColorEl = $("bgFillColor");
    const bgProgress = $("bgProgress");
    const bgProgressLabel = $("bgProgressLabel");
    const bgProgressFill = $("bgProgressFill");
    const origMeta = $("origMeta");
    const outMeta = $("outMeta");
    const proStatus = $("proStatus");
    const resultHint = $("resultHint");

    function suiteReturnPath() {
      return window.VxLab
        ? VxLab.currentReturnPath({ tool: toolEl?.value || "upscale" })
        : window.location.pathname + window.location.search + window.location.hash;
    }

    function syncToolToUrl() {
      if (!toolEl || !window.history?.replaceState) return;
      const url = new URL(window.location.href);
      url.searchParams.set("tool", toolEl.value);
      history.replaceState({}, "", url.pathname + url.search + url.hash);
    }

    // isPro determined by server-side plan check, not localStorage
    let isPro = false;
    let loadedImages = [];
    let processedResults = [];
    let singleOutBlob = null;
    let previewUrl = "";

    function t(key, fallback) {
      const lang = ((localStorage.getItem("volynx_lang") || "en").toLowerCase().startsWith("pt")) ? "pt" : "en";
      return window.VX_TRANS?.[lang]?.[key] || fallback;
    }

    function copy(key, fallback, replacements = {}) {
      return String(t(key, fallback)).replace(/\{(\w+)\}/g, (_, token) => {
        return Object.prototype.hasOwnProperty.call(replacements, token) ? replacements[token] : `{${token}}`;
      });
    }

    function fileCountLabel(count) {
      const noun = t(count === 1 ? "suite.file_one" : "suite.file_other", count === 1 ? "file" : "files");
      return `${count} ${noun}`;
    }

    function formatBytesLabel(bytes) {
      const M = window.VxFileMetrics;
      return M ? M.formatBytes(bytes) : `${(bytes / 1024 / 1024).toFixed(2)}MB`;
    }

    function formatDeltaLabel(inputBytes, outputBytes) {
      const M = window.VxFileMetrics;
      if (!M) return "";
      const delta = M.calcDelta(inputBytes, outputBytes);
      if (delta.direction === "smaller") {
        return copy("suite.delta_smaller", "{pct}% smaller", { pct: delta.absPct });
      }
      if (delta.direction === "larger") {
        return copy("suite.delta_larger", "{pct}% larger", { pct: delta.absPct });
      }
      return copy("suite.delta_same", "no change");
    }

    function formatSingleResultMeta(result) {
      const M = window.VxFileMetrics;
      const parts = [];
      if (result.width && result.height) {
        parts.push(M ? M.formatDimensions(result.width, result.height) : `${result.width} × ${result.height}`);
      }
      parts.push(formatBytesLabel(result.blob.size));
      if (result.keptOriginal) {
        parts.push(t("suite.meta_original_preserved", "original preserved"));
      } else {
        const deltaLabel = formatDeltaLabel(result.inputBytes, result.blob.size);
        if (deltaLabel) parts.push(deltaLabel);
      }
      return parts.join(" • ");
    }

    function setResultHint(message, tone = "warning") {
      if (!resultHint) return;
      if (!message) {
        resultHint.hidden = true;
        resultHint.textContent = "";
        delete resultHint.dataset.tone;
        return;
      }
      resultHint.hidden = false;
      resultHint.dataset.tone = tone;
      resultHint.textContent = message;
    }

    function fileExtFromName(name) {
      const match = (name || "").match(/\.([a-z0-9]+)$/i);
      return match ? match[1].toLowerCase() : "";
    }

    function mimeToExtension(mime, fallbackName = "") {
      if (mime === "image/jpeg") return "jpg";
      if (mime === "image/png") return "png";
      if (mime === "image/webp") return "webp";
      return fileExtFromName(fallbackName) || (mime.split("/")[1] || "png");
    }

    function setBgProgressHidden(hidden) {
      if (!bgProgress) return;
      bgProgress.hidden = hidden;
      if (hidden && bgProgressFill) {
        bgProgressFill.style.width = "0%";
      }
    }

    function updateProgressUI(pct, key) {
      if (!bgProgress || !bgProgressLabel || !bgProgressFill) return;

      const safePct = Math.max(0, Math.min(100, Number.isFinite(pct) ? pct : 0));
      bgProgress.hidden = false;
      bgProgress.dataset.active = "true";
      bgProgressFill.style.width = `${safePct}%`;

      // While we have no real progress yet (pct≤0) show an indeterminate
      // shimmer on the bar so the UI never reads as frozen.
      const bar = bgProgressFill.parentElement;
      if (bar) {
        bar.dataset.indeterminate = safePct <= 0 ? "true" : "false";
      }

      // 100% always wins regardless of key — fixes the bug where the label
      // got stuck on "Loading AI model..." after the image was already
      // processed because key="done" or key="process" with pct=100 fell into
      // the wrong branch.
      if (safePct >= 100) {
        bgProgressLabel.textContent = t("suite.bg_done", "Done!");
        if (bar) bar.dataset.indeterminate = "false";
        bgProgress.dataset.active = "false";
        window.setTimeout(() => {
          if (bgProgress) bgProgress.hidden = true;
        }, 900);
        return;
      }

      if (key?.startsWith("fetch")) {
        bgProgressLabel.textContent = safePct > 0
          ? `${t("suite.bg_downloading", "Downloading model...")} ${safePct}%`
          : t("suite.bg_downloading", "Downloading model...");
      } else if (key === "compute:inference" || key === "process" || key === "compute") {
        bgProgressLabel.textContent = safePct > 0
          ? `${t("suite.bg_removing", "Removing background...")} ${safePct}%`
          : t("suite.bg_removing", "Removing background...");
      } else if (key === "upscale") {
        bgProgressLabel.textContent = safePct > 0
          ? `${t("suite.upscaling", "AI upscaling...")} ${safePct}%`
          : t("suite.upscaling", "AI upscaling...");
      } else if (key === "encode") {
        bgProgressLabel.textContent = t("suite.encoding", "Encoding...");
      } else if (key === "compress") {
        bgProgressLabel.textContent = t("suite.compressing", "Compressing...");
      } else if (key === "scale") {
        bgProgressLabel.textContent = t("suite.scaling", "Resizing...");
      } else {
        bgProgressLabel.textContent = t("suite.bg_progress", "Loading AI model...");
      }
    }

    function createCanvasSurface(width, height) {
      if (typeof OffscreenCanvas === "function") {
        return new OffscreenCanvas(width, height);
      }
      const canvas = document.createElement("canvas");
      canvas.width = width;
      canvas.height = height;
      return canvas;
    }

    async function surfaceToBlob(surface, mime, quality) {
      if (typeof surface.convertToBlob === "function") {
        return surface.convertToBlob({ type: mime, quality });
      }
      return canvasToBlob(surface, mime, quality);
    }

    // ── Background removal pipeline (U²-Net portable + onnxruntime-web) ────────
    let _ortRuntime = null;
    let _bgSession = null;

    async function loadOrtOnce() {
      if (_ortRuntime) return _ortRuntime;
      await loadScriptOnce(`${ORT_BASE}ort.min.js`);
      if (!window.ort) throw new Error("onnxruntime-web failed to load");
      // Pin WASM artifacts to the same CDN folder so dev + prod resolve them
      // without needing a Vite plugin or local copy.
      window.ort.env.wasm.wasmPaths = ORT_BASE;
      _ortRuntime = window.ort;
      return _ortRuntime;
    }

    async function fetchModelWithProgress(url, onProgress) {
      const response = await fetch(url, { cache: "force-cache" });
      if (!response.ok) throw new Error(`Model fetch failed: ${response.status}`);
      const total = Number(response.headers.get("content-length")) || 4574861;
      if (!response.body || typeof response.body.getReader !== "function") {
        // Older browsers — single-shot
        const buf = await response.arrayBuffer();
        onProgress?.(100);
        return new Uint8Array(buf);
      }
      const reader = response.body.getReader();
      const chunks = [];
      let received = 0;
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        chunks.push(value);
        received += value.length;
        onProgress?.(Math.min(95, Math.round((received / total) * 95)));
      }
      const out = new Uint8Array(received);
      let off = 0;
      for (const c of chunks) { out.set(c, off); off += c.length; }
      return out;
    }

    async function loadBgSession() {
      if (_bgSession) return _bgSession;
      const ort = await loadOrtOnce();
      updateProgressUI(0, "fetch:model");
      const modelBytes = await fetchModelWithProgress(BG_MODEL_URL, (pct) => {
        updateProgressUI(pct, "fetch:model");
      });
      updateProgressUI(98, "fetch:model");
      _bgSession = await ort.InferenceSession.create(modelBytes.buffer, {
        executionProviders: ["wasm"],
        graphOptimizationLevel: "all",
      });
      return _bgSession;
    }

    // Kept for callers that still expect a function reference; routes through the
    // new local pipeline. Never returns the legacy imgly callback.
    async function loadBgRemoval() {
      await loadBgSession();
      return removeBackgroundLocalToCanvas;
    }

    async function removeBackgroundLocalToCanvas(srcImage, onProgress) {
      const session = await loadBgSession();
      const ort = await loadOrtOnce();

      const W = srcImage.naturalWidth || srcImage.width;
      const H = srcImage.naturalHeight || srcImage.height;
      const N = BG_MODEL_INPUT_SIZE;

      onProgress?.(40, "process");

      // Preprocess — resize to N×N, normalise to ImageNet stats, NCHW float32
      const inCanvas = document.createElement("canvas");
      inCanvas.width = N;
      inCanvas.height = N;
      const inCtx = inCanvas.getContext("2d");
      if (!inCtx) throw new Error("Failed to create preprocess canvas context.");
      inCtx.imageSmoothingEnabled = true;
      inCtx.imageSmoothingQuality = "high";
      inCtx.drawImage(srcImage, 0, 0, N, N);
      const pixels = inCtx.getImageData(0, 0, N, N).data;

      const tensorData = new Float32Array(3 * N * N);
      const HW = N * N;
      const mean = [0.485, 0.456, 0.406];
      const std = [0.229, 0.224, 0.225];
      for (let i = 0; i < HW; i++) {
        const p = i * 4;
        tensorData[i]            = ((pixels[p]     / 255) - mean[0]) / std[0];
        tensorData[i + HW]       = ((pixels[p + 1] / 255) - mean[1]) / std[1];
        tensorData[i + HW + HW]  = ((pixels[p + 2] / 255) - mean[2]) / std[2];
      }

      onProgress?.(55, "process");

      const inputTensor = new ort.Tensor("float32", tensorData, [1, 3, N, N]);
      const inputName = session.inputNames[0];
      const feeds = { [inputName]: inputTensor };

      const results = await session.run(feeds);
      const outputName = session.outputNames[0];
      const maskTensor = results[outputName];
      const maskData = maskTensor.data; // U²-Net's d0 is post-sigmoid in [0,1]

      onProgress?.(80, "process");

      // Robust normalisation — rembg uses (x - min) / (max - min) before α
      let mi = Infinity;
      let ma = -Infinity;
      for (let i = 0; i < maskData.length; i++) {
        const v = maskData[i];
        if (v < mi) mi = v;
        if (v > ma) ma = v;
      }
      const range = ma - mi || 1;

      // Build mask canvas at N×N as RGBA where alpha == mask probability
      const maskCanvas = document.createElement("canvas");
      maskCanvas.width = N;
      maskCanvas.height = N;
      const maskCtx = maskCanvas.getContext("2d");
      if (!maskCtx) throw new Error("Failed to create mask canvas context.");
      const maskImage = maskCtx.createImageData(N, N);
      for (let i = 0; i < maskData.length; i++) {
        const a = Math.round(((maskData[i] - mi) / range) * 255);
        const idx = i * 4;
        maskImage.data[idx]     = 255;
        maskImage.data[idx + 1] = 255;
        maskImage.data[idx + 2] = 255;
        maskImage.data[idx + 3] = a;
      }
      maskCtx.putImageData(maskImage, 0, 0);

      // Output canvas at the original resolution — quality preserved
      const outCanvas = document.createElement("canvas");
      outCanvas.width = W;
      outCanvas.height = H;
      const outCtx = outCanvas.getContext("2d");
      if (!outCtx) throw new Error("Failed to create output canvas context.");
      outCtx.imageSmoothingEnabled = true;
      outCtx.imageSmoothingQuality = "high";
      outCtx.drawImage(srcImage, 0, 0, W, H);
      // Apply the up-scaled mask as the alpha channel
      outCtx.globalCompositeOperation = "destination-in";
      outCtx.drawImage(maskCanvas, 0, 0, W, H);
      outCtx.globalCompositeOperation = "source-over";

      onProgress?.(100, "done");
      return outCanvas;
    }
    // ────────────────────────────────────────────────────────────────────────────

    function hasPaidPlan() {
      if (isPro) return true;
      if (!window.VxPlan) return false;
      const cached = window.VxPlan.getCached();
      return Boolean(cached?.plan && window.VxPlan.isPaid(cached.plan));
    }

    function isBgRemoveLocked() {
      return !hasPaidPlan();
    }

    function syncRunAvailability() {
      if (!runBtn) return;
      runBtn.disabled = !loadedImages.length || (toolEl?.value === "bg-remove" && isBgRemoveLocked());
    }

    function syncBgFillColorVisibility() {
      if (!bgFillColorEl) return;
      bgFillColorEl.hidden = bgFillEl?.value !== "custom";
    }

    function renderToolStatus() {
      if (!proStatus) return;
      if (toolEl?.value === "bg-remove" && isBgRemoveLocked()) {
        proStatus.innerHTML = t(
          "suite.bg_upgrade_html",
          'Remove BG is a <strong>Pro</strong> feature — <a href="/pricing/">Upgrade</a>'
        );
        return;
      }
      proStatus.textContent = isPro ? t("suite.pro_status", "PRO Activated ✔ Unlimited access enabled") : "";
    }

    function checkFmtHint() {
      if (!fmtHint) return;
      const isCompress = toolEl.value === "compress";
      const isPng = fmtEl.value === "image/png";
      if (isCompress && isPng) {
        fmtHint.textContent = t(
          "suite.fmt_hint_compress_png",
          "Tip: PNG is lossless — switch to WebP or JPG for smaller files."
        );
        fmtHint.hidden = false;
      } else {
        fmtHint.hidden = true;
      }
    }

    function updateFieldVisibility(tool) {
      [scaleGroup, qualityGroup, formatGroup, bgRemoveGroup].forEach((group) => {
        if (group) group.hidden = true;
      });

      if (tool === "upscale") {
        scaleGroup.hidden = false;
        formatGroup.hidden = false;
        setBgProgressHidden(true);
      } else if (tool === "compress") {
        qualityGroup.hidden = false;
        formatGroup.hidden = false;
        if (fmtEl.value === "image/png") {
          fmtEl.value = "image/webp";
        }
        setBgProgressHidden(true);
      } else if (tool === "convert") {
        formatGroup.hidden = false;
        setBgProgressHidden(true);
      } else if (tool === "bg-remove") {
        bgRemoveGroup.hidden = false;
        syncBgFillColorVisibility();
        if (isBgRemoveLocked()) {
          setBgProgressHidden(true);
        } else {
          loadBgRemoval().catch(() => {});
        }
      }

      checkFmtHint();
      renderToolStatus();
      syncRunAvailability();
    }

    function setDropMessage(message) {
      const textEl = dropEl && dropEl.querySelector("p");

      if (textEl) {
        textEl.textContent = message;
        return;
      }

      if (dropEl) {
        dropEl.textContent = message;
      }
    }

    function setPreviewBlob(blob) {
      if (!previewEl || !blob) return;

      if (previewUrl) {
        URL.revokeObjectURL(previewUrl);
      }

      previewUrl = URL.createObjectURL(blob);
      previewEl.src = previewUrl;
      if (previewShell) previewShell.dataset.state = "ready";
    }

    function updateProUI() {
      renderToolStatus();
    }

    function resetPreview() {
      if (previewUrl) {
        URL.revokeObjectURL(previewUrl);
        previewUrl = "";
      }
      if (previewEl) previewEl.removeAttribute("src");
      if (previewShell) previewShell.dataset.state = "empty";
      if (outMeta) outMeta.textContent = "—";
      if (downloadBtn) downloadBtn.disabled = true;
      processedResults = [];
      singleOutBlob = null;
      setResultHint("");
      setBgProgressHidden(true);
    }

    async function fileToImage(file) {
      const url = URL.createObjectURL(file);
      const img = new Image();
      const waitForLoad = new Promise((resolve, reject) => {
        img.onload = () => resolve();
        img.onerror = () => reject(new Error(`Failed to load ${file.name}`));
      });

      img.src = url;

      try {
        if (typeof img.decode === "function") {
          await img.decode();
        } else {
          await waitForLoad;
        }
      } catch (_) {
        await waitForLoad;
      } finally {
        URL.revokeObjectURL(url);
      }

      return img;
    }

    async function loadFiles(files) {
      const validFiles = files.filter((file) => file && file.type && file.type.startsWith("image/"));

      loadedImages = [];
      resetPreview();

      if (!validFiles.length) {
        labNotify("No valid images", t("suite.alert_no_valid", "Select a PNG, JPG, WebP or another browser-readable image."));
        return;
      }

      runBtn.disabled = true;
      setDropMessage(copy("suite.drop_loading", "Loading {files}...", {
        files: fileCountLabel(validFiles.length),
      }));

      for (const file of validFiles) {
        const img = await fileToImage(file);
        loadedImages.push({
          file,
          img,
          baseName: file.name.replace(/\.[^/.]+$/, "")
        });
      }
      if (window.VxLab) {
        VxLab.recordEvent("image-suite", "upload", `${validFiles.length} file(s) selected`);
      }

      const totalBytes = validFiles.reduce((sum, file) => sum + file.size, 0);
      origMeta.textContent = `${fileCountLabel(validFiles.length)} • ${formatBytesLabel(totalBytes)}`;
      setDropMessage(copy("suite.drop_ready", "{files} ready to process", {
        files: fileCountLabel(validFiles.length),
      }));
      syncRunAvailability();
    }

    // ── AI Upscaler (Real-ESRGAN via UpscalerJS + TF.js, lazy-loaded) ──────────
    let _aiUpscaler = null;

    function loadScriptOnce(src) {
      if (document.querySelector(`script[src="${src}"]`)) return Promise.resolve();
      return new Promise((res, rej) => {
        const s = document.createElement('script');
        s.src = src; s.onload = res; s.onerror = rej;
        document.head.appendChild(s);
      });
    }

    async function initAIUpscaler() {
      if (_aiUpscaler) return _aiUpscaler;
      setDropMessage('Loading AI model (first time ~3 MB, cached after)…');
      await loadScriptOnce('https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.22.0/dist/tf.min.js');
      await loadScriptOnce('https://cdn.jsdelivr.net/npm/upscaler@1.0.0-beta.19/dist/browser/umd/upscaler.min.js');
      _aiUpscaler = new window.Upscaler({
        model: {
          path: 'https://cdn.jsdelivr.net/npm/@upscalerjs/esrgan-slim@1.0.0-beta.1/models/2x/model.json',
          scale: 2
        }
      });
      return _aiUpscaler;
    }

    async function aiUpscaleToCanvas(img, targetScale) {
      try {
        const upscaler = await initAIUpscaler();
        setDropMessage('AI upscaling… 0%');
        updateProgressUI(0, 'upscale');
        const base64 = await upscaler.upscale(img, {
          output: 'base64',
          patchSize: 64,
          padding: 4,
          progress: (pct) => {
            const p = Math.round(pct * 100);
            setDropMessage(`AI upscaling… ${p}%`);
            updateProgressUI(p, 'upscale');
          }
        });
        const upscaledImg = new Image();
        upscaledImg.src = base64;
        await upscaledImg.decode();
        const canvas = document.createElement('canvas');
        if (targetScale <= 2) {
          canvas.width = upscaledImg.width;
          canvas.height = upscaledImg.height;
          canvas.getContext('2d').drawImage(upscaledImg, 0, 0);
        } else {
          // AI did 2x, canvas does the remaining scale (3x → ×1.5, 4x → ×2)
          const rem = targetScale / 2;
          canvas.width = upscaledImg.width * rem;
          canvas.height = upscaledImg.height * rem;
          const ctx2 = canvas.getContext('2d');
          ctx2.imageSmoothingEnabled = true;
          ctx2.imageSmoothingQuality = 'high';
          ctx2.drawImage(upscaledImg, 0, 0, canvas.width, canvas.height);
        }
        return canvas;
      } catch (e) {
        console.warn('[AI upscale] failed, falling back to canvas:', e);
        return null;
      }
    }
    // ────────────────────────────────────────────────────────────────────────────

    function canvasToBlob(canvas, mime, quality) {
      return new Promise((resolve, reject) => {
        canvas.toBlob((blob) => {
          if (!blob) {
            reject(new Error("Failed to generate file."));
            return;
          }
          resolve(blob);
        }, mime, quality);
      });
    }

    async function processOne(item, tool, scale, mime, quality) {
      if (tool === "bg-remove") {
        const bgMime = bgFormatEl?.value || "image/png";
        const fillValue = bgFillEl?.value || "transparent";
        const fillColor = bgFillColorEl?.value || "#ffffff";

        const cutoutCanvas = await removeBackgroundLocalToCanvas(item.img, (pct, key) => {
          updateProgressUI(pct, key);
        });

        // Compose the chosen background fill (or keep transparent) on top of the cutout
        let finalCanvas = cutoutCanvas;
        if (fillValue !== "transparent") {
          const composed = createCanvasSurface(cutoutCanvas.width, cutoutCanvas.height);
          const ctx = composed.getContext("2d");
          if (!ctx) throw new Error("Failed to create background removal canvas context.");
          ctx.fillStyle = fillValue === "custom" ? fillColor : fillValue;
          ctx.fillRect(0, 0, composed.width, composed.height);
          ctx.drawImage(cutoutCanvas, 0, 0);
          finalCanvas = composed;
        }

        const finalBlob = await surfaceToBlob(finalCanvas, bgMime, 1);

        updateProgressUI(100, "done");
        return {
          baseName: `${item.baseName}-no-bg`,
          originalFile: item.file,
          blob: finalBlob,
          width: item.img.width,
          height: item.img.height,
          inputBytes: item.file.size,
          keptOriginal: false,
          mimeType: bgMime,
          extension: mimeToExtension(bgMime, item.file.name),
        };
      }

      const img = item.img;
      const file = item.file;
      const baseName = item.baseName;

      const w = img.width;
      const h = img.height;

      const canvas = document.createElement("canvas");
      const ctx = canvas.getContext("2d");

      if (!ctx) {
        throw new Error("Failed to create canvas context.");
      }

      // Surface activity for non-AI tools too — even sub-second ops need feedback.
      if (tool === "compress") updateProgressUI(0, "compress");
      else if (tool !== "upscale") updateProgressUI(0, "scale");

      if (tool === "upscale") {
        const aiCanvas = await aiUpscaleToCanvas(img, scale);
        if (aiCanvas) {
          canvas.width = aiCanvas.width;
          canvas.height = aiCanvas.height;
          ctx.drawImage(aiCanvas, 0, 0);
        } else {
          // Fallback: canvas interpolation
          canvas.width = w * scale;
          canvas.height = h * scale;
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = "high";
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        }
      } else {
        canvas.width = w;
        canvas.height = h;
        ctx.drawImage(img, 0, 0);
      }

      updateProgressUI(70, "encode");
      const blob = await canvasToBlob(
        canvas,
        mime,
        tool === "compress" ? quality : 0.95
      );
      updateProgressUI(100, "done");

      // Compress protection: if output grew, preserve original
      const M = window.VxFileMetrics;
      let finalBlob = blob;
      let kept = false;
      if (tool === "compress" && M && !M.isCompressionEffective(file.size, blob.size)) {
        finalBlob = file.slice(0, file.size, file.type);
        kept = true;
      }

      const finalMime = kept ? (file.type || mime) : mime;

      return {
        baseName,
        originalFile: file,
        blob: finalBlob,
        width: canvas.width,
        height: canvas.height,
        inputBytes: file.size,
        keptOriginal: kept,
        mimeType: finalMime,
        extension: kept
          ? (fileExtFromName(file.name) || mimeToExtension(finalMime, file.name))
          : mimeToExtension(finalMime, file.name),
      };
    }

    // Detect pro status from server-side check (await to avoid race condition)
    async function detectPro() {
      try {
        // Check VxPlan cache first for instant result
        if (window.VxPlan) {
          const cached = window.VxPlan.getCached();
          if (cached && cached.plan && window.VxPlan.isPaid(cached.plan)) {
            isPro = true;
          }
        }
        const perm = await checkToolPermission("image-suite", 0);
        const plan = window.VxPlan ? window.VxPlan.normalize(perm.plan) : (perm.plan || 'free');
        const hasPaidAccess = window.VxPlan
          ? window.VxPlan.isPaid(plan)
          : (plan !== "free" && plan !== "");
        if (hasPaidAccess) {
          isPro = true;
          if (window.VxPlan) window.VxPlan.cache(plan);
        }
      } catch {}
      updateProUI();
      updateFieldVisibility(toolEl?.value || "upscale");
    }
    function applyInitialToolFromUrl() {
      try {
        const requestedTool = new URLSearchParams(window.location.search).get("tool");
        if (!requestedTool || !toolEl) return;
        const hasOption = Array.from(toolEl.options).some((option) => option.value === requestedTool);
        if (hasOption) toolEl.value = requestedTool;
      } catch {}
    }

    applyInitialToolFromUrl();
    const proReady = detectPro();

    qualityEl.addEventListener("input", () => {
      qualityValEl.textContent = qualityEl.value;
    });

    const fmtHint = $("fmtHint");
    toolEl.addEventListener("change", () => {
      updateFieldVisibility(toolEl.value);
      syncToolToUrl();
    });
    fmtEl.addEventListener("change", checkFmtHint);
    bgFillEl?.addEventListener("change", syncBgFillColorVisibility);
    window.addEventListener("vx:lang-changed", () => {
      renderToolStatus();
      if (!bgProgress?.hidden && bgProgressLabel && !bgProgressFill?.style.width) {
        bgProgressLabel.textContent = t("suite.bg_progress", "Loading AI model...");
      }
    });
    updateFieldVisibility(toolEl.value);

    function triggerFilePicker() {
      if (fileEl) fileEl.click();
    }

    function handlePickerKeydown(event) {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        triggerFilePicker();
      }
    }

    pickBtn?.addEventListener("keydown", handlePickerKeydown);
    dropEl?.addEventListener("keydown", handlePickerKeydown);

    fileEl.addEventListener("change", async () => {
      const files = Array.from(fileEl.files || []);
      fileEl.value = "";
      if (!files.length) return;
      await loadFiles(files);
    });

    dropEl.addEventListener("dragover", (e) => {
      e.preventDefault();
      dropEl.classList.add("drag");
    });

    dropEl.addEventListener("dragleave", () => {
      dropEl.classList.remove("drag");
    });

    dropEl.addEventListener("drop", async (e) => {
      e.preventDefault();
      dropEl.classList.remove("drag");
      const files = Array.from((e.dataTransfer && e.dataTransfer.files) || []);
      if (!files.length) return;
      await loadFiles(files);
    });

    runBtn.addEventListener("click", async () => {
      if (!loadedImages.length) return;

      await proReady;

      const tool = toolEl.value;
      const scale = parseInt(scaleEl.value, 10);
      const mime = fmtEl.value;
      const quality = parseFloat(qualityEl.value);

      const permissionTool = tool === "bg-remove" ? "bg-remove" : "image-suite";
      const shouldCheckPermission = tool === "bg-remove" ? !hasPaidPlan() : !isPro;

      if (shouldCheckPermission) {
        const perm = await checkToolPermission(permissionTool, loadedImages.length, {
          allowLocalFallback: tool !== "bg-remove",
        });
        if (!perm.allowed) {
          const isFreeUser = window.VxPlan ? !window.VxPlan.isPaid(perm.plan) : (perm.plan === 'free');
          const returnPath = suiteReturnPath();
          syncToolToUrl();
          if (window.VxLab?.shouldSendToLogin(perm)) {
            VxLab.confirmLogin(
              returnPath,
              "Sign in to continue in Image Suite. You will return to this exact tool after login."
            );
            return;
          }
          
          // Show only paths that are actually wired for this tool.
          if (tool === "bg-remove") {
            const confirmMsg = t("suite.bg_upgrade_alert", "Remove BG is available on paid plans. Upgrade to unlock it.");
            if (window.VxLab) {
              VxLab.confirmUpgrade(confirmMsg + "\n\nClick OK to see upgrade options.");
            } else {
              labNotify("Upgrade required", confirmMsg, "warn");
            }
            return;
          }
          
          // Daily limits are plan-gated here; VX is not a bypass unless the
          // action explicitly calls the token spending helper.
          const limitMsg = `Daily limit reached (${perm.limit}).`;
          const upgradeMsg = isFreeUser 
            ? "\n\nUpgrade to Pro for higher limits and Studio access.\n\nClick OK to see options."
            : "\n\nYou've used your daily allowance. Try again tomorrow or manage your plan.\n\nClick OK to see options.";
          
          if (isFreeUser && window.VxLab) {
            VxLab.confirmUpgrade(limitMsg + upgradeMsg);
          } else {
            labNotify("Daily limit reached", `${limitMsg}\n\nYou've used your daily allowance. Try again tomorrow.`, "warn");
          }
          return;
        }
      }

      runBtn.disabled = true;
      downloadBtn.disabled = true;
      processedResults = [];
      singleOutBlob = null;

      try {
        for (let i = 0; i < loadedImages.length; i++) {
          setDropMessage(copy("suite.drop_processing", "Processing {current}/{total}...", {
            current: i + 1,
            total: loadedImages.length,
          }));

          const result = await processOne(loadedImages[i], tool, scale, mime, quality);
          processedResults.push(result);

          if (i === 0) {
            setPreviewBlob(result.blob);
          }
        }

        const totalOutBytes = processedResults.reduce((sum, result) => sum + result.blob.size, 0);
        const totalInBytes = processedResults.reduce((sum, result) => sum + result.inputBytes, 0);
        const M = window.VxFileMetrics;
        const keptCount = processedResults.filter((result) => result.keptOriginal).length;
        if (processedResults.length === 1) {
          outMeta.textContent = formatSingleResultMeta(processedResults[0]);
        } else {
          let metaText = `${fileCountLabel(processedResults.length)} • ${formatBytesLabel(totalOutBytes)}`;
          if (M) {
            const delta = M.calcDelta(totalInBytes, totalOutBytes);
            if (delta.direction !== "same") {
              metaText += ` • ${formatDeltaLabel(totalInBytes, totalOutBytes)}`;
            }
          }
          if (keptCount > 0) {
            metaText += ` • ${copy(
              keptCount === 1 ? "suite.meta_kept_one" : "suite.meta_kept_many",
              keptCount === 1 ? "1 kept original" : "{count} kept original",
              { count: keptCount }
            )}`;
          }
          outMeta.textContent = metaText;
        }

        if (processedResults.length === 1) {
          singleOutBlob = processedResults[0].blob;
        }

        if (tool === "compress" && keptCount > 0) {
          if (keptCount === processedResults.length) {
            setResultHint(
              keptCount === 1
                ? t(
                    "suite.compress_notice_all_kept_one",
                    "Original file kept because the compressed version was larger. Try lower quality or switch format."
                  )
                : copy(
                    "suite.compress_notice_all_kept_many",
                    "{count} files kept the original because the compressed version was larger. Try lower quality or switch format.",
                    { count: keptCount }
                  )
            );
            setDropMessage(
              keptCount === 1
                ? t("suite.compress_drop_all_kept_one", "No smaller version found, so the original file was kept.")
                : copy(
                    "suite.compress_drop_all_kept_many",
                    "No smaller versions found, so {count} original files were kept.",
                    { count: keptCount }
                  )
            );
          } else {
            setResultHint(
              copy(
                keptCount === 1 ? "suite.compress_notice_some_one" : "suite.compress_notice_some_many",
                keptCount === 1
                  ? "1 file kept the original because recompression was larger. Try lower quality or switch format."
                  : "{count} files kept the original because recompression was larger. Try lower quality or switch format.",
                { count: keptCount }
              )
            );
            setDropMessage(
              copy(
                keptCount === 1 ? "suite.compress_drop_some_one" : "suite.compress_drop_some_many",
                keptCount === 1
                  ? "Processed with 1 original file preserved."
                  : "Processed with {count} original files preserved.",
                { count: keptCount }
              )
            );
          }
        } else {
          setResultHint("");
          setDropMessage(copy("suite.drop_done", "{files} processed successfully", {
            files: fileCountLabel(processedResults.length),
          }));
        }

        // Log ALL users (free + pro) — pro just doesn't get a quota check.
        // We still need per-tool call counts for analytics + total API calls.
        logToolUsage("image-suite", processedResults.length);
        if (window.VxLab) {
          VxLab.recordEvent("image-suite", tool, `${processedResults.length} file(s) processed`);
          VxLab.savePreset("image-suite", {
            tool,
            scale: tool === "upscale" ? `${scale}x` : "",
            format: tool === "bg-remove" ? (bgFormatEl?.value || "image/png").split("/")[1] : mime.split("/")[1],
            quality: tool === "compress" ? quality : "",
            fill: tool === "bg-remove" ? (bgFillEl?.value || "transparent") : "",
          });
        }

        if (tool === "bg-remove") {
          const totalBgBytes = processedResults.reduce((sum, result) => sum + result.inputBytes, 0);
          const cfg = await getConfig();
          const apiBase = (cfg.functionsUrl || cfg.apiBaseUrl || '').replace(/\/$/, '');
          const token = localStorage.getItem('volynx_access_token') || '';
          const cachedPlan = window.VxPlan?.getCached()?.plan;
          if (apiBase && token) {
            fetch(`${apiBase}/track-tool-usage`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Authorization: `Bearer ${token}`,
              },
              body: JSON.stringify({
                tool: "bg-remove",
                input_bytes: totalBgBytes,
                plan_at_time: cachedPlan || "free",
                metadata: {
                  ...BG_REMOVAL_META,
                  files: processedResults.length,
                  output_format: bgFormatEl?.value || "image/png",
                  fill: bgFillEl?.value || "transparent",
                },
              }),
            }).catch(() => {});
          }
        }

        downloadBtn.disabled = false;
      } catch (error) {
        console.error(error);
        labNotify("Processing failed", t("suite.alert_process_error", "Image Suite could not process this image. Try a smaller file or another format."), "error");
        setDropMessage(t("suite.drop_error", "Error processing files"));
        setResultHint("");
      } finally {
        runBtn.disabled = false;
        // Always release the progress widget — without this, errors mid-
        // process or any path that didn't reach updateProgressUI(100,"done")
        // left "Loading AI model..." stuck on screen even after the image
        // was visibly processed.
        setBgProgressHidden(true);
      }
    });

    downloadBtn.addEventListener("click", async () => {
      if (!processedResults.length) return;

      if (processedResults.length === 1 && singleOutBlob) {
        const a = document.createElement("a");
        const url = URL.createObjectURL(singleOutBlob);
        a.href = url;
        a.download = `${processedResults[0].baseName}.${processedResults[0].extension}`;
        a.click();
        if (window.VxLab) VxLab.recordEvent("image-suite", "download", a.download);
        window.setTimeout(() => URL.revokeObjectURL(url), 1500);
        return;
      }

      if (!window.JSZip) {
        labNotify("ZIP export unavailable", "The ZIP library did not load. Reload the page and try again.", "error");
        return;
      }

      const zip = new window.JSZip();

      for (const result of processedResults) {
        zip.file(`${result.baseName}.${result.extension}`, result.blob);
      }

      const zipBlob = await zip.generateAsync({ type: "blob" });

      const a = document.createElement("a");
      const url = URL.createObjectURL(zipBlob);
      a.href = url;
      a.download = "volynx-image-suite-batch.zip";
      a.click();
      if (window.VxLab) VxLab.recordEvent("image-suite", "download", "Batch ZIP downloaded");
      window.setTimeout(() => URL.revokeObjectURL(url), 1500);
    });
  </script>

  <LabUpgradeBanner />
  <SiteFooter />
  <PageWidgets hideUtilBar />
</body>
</html>
