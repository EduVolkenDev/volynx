---
import "../../../../styles/converter.css";
import LabBg from "../../../../components/LabBg.astro";
import PageWidgets from "../../../../components/PageWidgets.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import VxHeader from "../../../../components/VxHeader.astro";
import { ROUTES } from "../../../../data/routes";
const pageTitle = "VOLYNX Lab • Converter";
const pageDescription = "Free image converter — convert to WebP, JPG, PNG or AVIF with quality control and resize options.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/site.webmanifest" />
</head>

<body>
  <LabBg />
  <VxHeader />
  <div id="vx-upgrade-banner" style="display:none;background:rgba(108,10,228,.18);border-bottom:1px solid rgba(108,10,228,.35);padding:10px 20px;text-align:center;font-size:.85em;">
    You're on the free plan. <a href={ROUTES.pricing} style="color:#59c6e8;font-weight:700;">Upgrade to Pro</a> to unlock batch processing and commercial use.
  </div>

  <nav class="vx-back">
    <a class="pill" href={ROUTES.lab} data-i18n="converter.back">← Back</a>
  </nav>

  <div class="brand-logo" aria-hidden="true">
    <img src="/assets/wordmark.webp" alt="" class="brand-logo-img" />
  </div>

  <div class="brand-icon" aria-hidden="true">
    <img src="/assets/volynx-icon.webp" alt="" class="volynx-eye-img" />
  </div>

  <main class="wrap">
    <section class="card" aria-label="Image converter">
      <div class="card__head">
        <h1 data-i18n="converter.title">Converter</h1>
      </div>

      <div id="drop" class="drop" role="region" aria-label="Drop zone">
        <input id="file" type="file" accept="image/*" multiple aria-label="Select images" />
        <div class="drop__inner" aria-hidden="true">
          <div class="drop__title" data-i18n="converter.drop_title">Drag images here</div>
          <div class="drop__hint" data-i18n="converter.drop_hint">or click to select</div>
        </div>
      </div>

      <div class="controls">
        <label class="field">
          <span data-i18n="converter.format_label">Formato</span>
          <select id="format" aria-label="Output format">
            <option value="webp" selected>WebP (recomendado)</option>
            <option value="jpg">JPG</option>
            <option value="png">PNG</option>
            <option value="avif">AVIF (se suportado)</option>
          </select>
        </label>

        <label class="field">
          <span data-i18n="converter.quality_label">Qualidade</span>
          <input id="quality" type="range" min="40" max="95" value="82" aria-label="Quality" />
          <em id="qualityVal" aria-live="polite">82</em>
        </label>

        <label class="field">
          <span data-i18n="converter.resize_label">Resize (largura máx)</span>
          <select id="maxw" aria-label="Max width">
            <option value="0" selected data-i18n="converter.resize_original">Original</option>
            <option value="3840">3840</option>
            <option value="2560">2560</option>
            <option value="1920">1920</option>
            <option value="1280">1280</option>
            <option value="1080">1080</option>
          </select>
        </label>

        <div class="actions">
          <button id="convert" class="btn" data-i18n="converter.btn_convert">Converter</button>
          <button id="zip" class="btn" disabled data-i18n="converter.btn_zip">Baixar ZIP</button>
          <button id="clear" class="btn" data-i18n="converter.btn_clear">Limpar</button>
        </div>
      </div>

      <div class="listHead">
        <div data-i18n="converter.files_label">Arquivos</div>
        <div id="stats" class="stats" aria-live="polite"></div>
      </div>

      <ul id="list" class="list" aria-label="File list"></ul>
    </section>
  </main>

  <Fragment set:html={'<script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js" defer></script><script type="module" src="/volynx-lab/app.js"></script>'} />

  <SiteFooter />
  <PageWidgets />
  <script is:inline>window.__vxTool = 'converter';</script>
  <script is:inline src="/scripts/vx-auth-gate.js"></script>
</body>
</html>
