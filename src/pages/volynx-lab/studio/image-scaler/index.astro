---
import "../../../../styles/image-scaler.css";
import LabBg from "../../../../components/LabBg.astro";
import PageWidgets from "../../../../components/PageWidgets.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import VxHeader from "../../../../components/VxHeader.astro";
import { ROUTES } from "../../../../data/routes";
const pageTitle = "VOLYNX Lab • Image Scaler";
const pageDescription = "Free image upscaler — amplify small images with high smoothing and optional sharpening, locally in your browser.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#080610" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/site.webmanifest" />
</head>

<body>
  <LabBg />
  <VxHeader />
  <div id="vx-upgrade-banner" style="display:none;background:rgba(108,10,228,.18);border-bottom:1px solid rgba(108,10,228,.35);padding:10px 20px;text-align:center;font-size:.85em;">
    You're on the free plan. <a href={ROUTES.pricing} style="color:#59c6e8;font-weight:700;">Upgrade to Pro</a> to unlock 4x upscale and commercial use.
  </div>

  <nav class="vx-back">
    <a class="pill-back" href={ROUTES.lab} data-i18n="scaler.back">← Back</a>
  </nav>

  <img src="/assets/wordmark.webp" alt="" class="brand-logo-img" aria-hidden="true" />

  <main class="wrap">
    <div class="wrap-header">
      <span class="hero-pill" data-i18n="scaler.pill">iMAGE.Scaler</span>

      <div class="hero-text">
        <h1 data-i18n="scaler.title">Amplie imagens pequenas com qualidade</h1>
        <p data-i18n="scaler.desc">
          Upscale local (browser) com suavização de alta qualidade e nitidez opcional.
          Processamento 100% local — suas imagens nunca saem do dispositivo.
        </p>
      </div>
    </div>

    <div class="grid">
      <div class="card">
        <div class="cardHead">
          <h2 data-i18n="scaler.card_upload">Upload</h2>
          <div class="field-row">
            <button id="pickBtn" class="btn secondary" type="button" data-i18n="scaler.btn_select">Select file</button>
            <input id="file" type="file" accept="image/*" multiple hidden aria-label="Select image files" />
          </div>
        </div>
        <div class="cardBody">
          <div
            id="drop"
            class="drop"
            role="button"
            tabindex="0"
            aria-label="Drag and drop image here"
          >
            <div class="icon">☁︎</div>
            <p data-i18n="scaler.drop_text"><b>Drag and drop</b> or click "Select file"</p>
            <p data-i18n="scaler.desc2">Suporta PNG/JPG/WebP. Processamento local (não envia nada).</p>
          </div>

          <div class="field-row" style="margin-top:14px">
            <label for="scale" data-i18n="scaler.scale_label">Escala</label>
            <select id="scale" aria-label="Upscale factor">
              <option value="2">2x</option>
              <option value="3">3x</option>
              <option value="4" selected>4x</option>
            </select>

            <label for="format" data-i18n="scaler.format_label">Formato</label>
            <select id="format" aria-label="Output format">
              <option value="image/png" selected>PNG</option>
              <option value="image/webp">WebP</option>
              <option value="image/jpeg">JPG</option>
            </select>

            <label class="field-row" style="gap:8px">
              <input id="sharpen" type="checkbox" checked aria-label="Apply sharpening" />
              Nitidez (sharpen)
            </label>

            <label class="field-row" style="gap:8px">
              <input id="smooth" type="checkbox" checked aria-label="High smoothing" />
              <span data-i18n="scaler.smooth_label">Suavização alta</span>
            </label>

            <button id="runBtn" class="btn" type="button" disabled data-i18n="scaler.btn_upscale">Generate image</button>
          </div>

          <div class="kpis">
            <div class="kpi"><b data-i18n="scaler.original_label">Original</b><span id="origMeta">—</span></div>
            <div class="kpi"><b data-i18n="scaler.result_label">Saída</b><span id="outMeta">—</span></div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="cardHead">
          <h2 data-i18n="scaler.card_preview">Resultado</h2>
          <div class="field-row">
            <button id="downloadBtn" class="btn" type="button" disabled data-i18n="scaler.btn_download">Baixar</button>
          </div>
        </div>
        <div class="cardBody">
          <img id="preview" class="preview" alt="Prévia do resultado" />
        </div>
      </div>
    </div>
  </main>

  <script is:inline src="/js/vx-file-metrics.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
  <Fragment set:html={'<script src="/volynx-lab/image-scaler.js" defer></script>'} />

  <SiteFooter />
  <PageWidgets />
  <script is:inline>window.__vxTool = 'image-scaler';</script>
  <script is:inline src="/scripts/vx-auth-gate.js"></script>
</body>
</html>
