---
import "../../../../styles/image-suite.css";
import LabBg from "../../../../components/LabBg.astro";
import PageWidgets from "../../../../components/PageWidgets.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import VxHeader from "../../../../components/VxHeader.astro";
import { ROUTES } from "../../../../data/routes";
const pageTitle = "VOLYNX Studio • Image Suite";
const pageDescription = "Pro-exclusive multi-tool: upscale, compress, convert, resize, crop, rotate and watermark — all in one interface.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#080610" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>
  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/site.webmanifest" />
  <script is:inline src="/js/vx-file-metrics.js"></script>
</head>

<body>
  <LabBg />
  <VxHeader />
  <div id="vx-upgrade-banner" style="display:none;background:rgba(108,10,228,.18);border-bottom:1px solid rgba(108,10,228,.35);padding:10px 20px;text-align:center;font-size:.85em;">
    You're on the free plan — Image Suite is Pro exclusive. <a href={ROUTES.pricing} style="color:#59c6e8;font-weight:700;">Upgrade to Pro</a>
  </div>

  <nav class="vx-back">
    <a class="pill-back" href="/volynx-lab/studio/" data-i18n="suite.back">← Studio</a>
  </nav>

  <main class="wrap">
    <h1 class="suite-title">Image Suite <span class="suite-pro-tag">PRO</span></h1>
    <p class="suite-sub">All-in-one image processing. Choose a tool, configure, process.</p>

    <div class="suite-layout">

      <!-- LEFT: Upload + Tools -->
      <div class="suite-panel">
        <!-- Upload -->
        <div class="suite-section">
          <div class="suite-section__head">
            <strong>Upload</strong>
            <button id="pickBtn" class="suite-btn-sm" type="button">Select file</button>
            <input id="file" type="file" accept="image/*" hidden />
          </div>
          <div id="drop" class="suite-drop" role="button" tabindex="0">
            <span class="suite-drop__icon">↑</span>
            <span>Drop image here or click to select</span>
          </div>
          <div class="suite-meta" id="origMeta">No file loaded</div>
        </div>

        <!-- Tool selector -->
        <div class="suite-section">
          <strong class="suite-section__label">Tool</strong>
          <div class="suite-tools" id="toolPicker">
            <button class="suite-tool-btn suite-tool-btn--active" data-tool="upscale">
              <span class="suite-tool-btn__icon">⬆</span>
              <span>Upscale</span>
            </button>
            <button class="suite-tool-btn" data-tool="compress">
              <span class="suite-tool-btn__icon">📦</span>
              <span>Compress</span>
            </button>
            <button class="suite-tool-btn" data-tool="convert">
              <span class="suite-tool-btn__icon">🔄</span>
              <span>Convert</span>
            </button>
            <button class="suite-tool-btn" data-tool="resize">
              <span class="suite-tool-btn__icon">📐</span>
              <span>Resize</span>
            </button>
            <button class="suite-tool-btn" data-tool="rotate">
              <span class="suite-tool-btn__icon">↻</span>
              <span>Rotate</span>
            </button>
            <button class="suite-tool-btn" data-tool="watermark">
              <span class="suite-tool-btn__icon">💧</span>
              <span>Watermark</span>
            </button>
          </div>
        </div>

        <!-- Config panels (one per tool, toggled by JS) -->
        <div class="suite-section suite-config" id="cfg-upscale">
          <strong class="suite-section__label">Upscale settings</strong>
          <div class="suite-fields">
            <label class="suite-field">
              <span>Scale</span>
              <select id="scale">
                <option value="2">2×</option>
                <option value="3">3×</option>
                <option value="4" selected>4×</option>
              </select>
            </label>
            <label class="suite-field">
              <span>Output format</span>
              <select id="format">
                <option value="image/png" selected>PNG</option>
                <option value="image/webp">WebP</option>
                <option value="image/jpeg">JPG</option>
              </select>
            </label>
            <label class="suite-field suite-field--row">
              <input id="smooth" type="checkbox" checked />
              <span>High quality smoothing</span>
            </label>
          </div>
        </div>

        <div class="suite-section suite-config" id="cfg-compress" hidden>
          <strong class="suite-section__label">Compression settings</strong>
          <div class="suite-fields">
            <label class="suite-field">
              <span>Quality — <strong id="qualityVal">85</strong>%</span>
              <input id="quality" type="range" min="10" max="100" step="1" value="85" />
            </label>
            <label class="suite-field">
              <span>Output format</span>
              <select id="compressFmt">
                <option value="image/webp" selected>WebP (best)</option>
                <option value="image/jpeg">JPG</option>
              </select>
            </label>
          </div>
        </div>

        <div class="suite-section suite-config" id="cfg-convert" hidden>
          <strong class="suite-section__label">Convert settings</strong>
          <div class="suite-fields">
            <label class="suite-field">
              <span>Target format</span>
              <select id="convertFmt">
                <option value="image/webp">WebP</option>
                <option value="image/jpeg">JPG</option>
                <option value="image/png" selected>PNG</option>
                <option value="image/avif">AVIF</option>
              </select>
            </label>
            <label class="suite-field">
              <span>Quality — <strong id="convertQualVal">92</strong>%</span>
              <input id="convertQual" type="range" min="40" max="100" step="1" value="92" />
            </label>
          </div>
        </div>

        <div class="suite-section suite-config" id="cfg-resize" hidden>
          <strong class="suite-section__label">Resize settings</strong>
          <div class="suite-fields">
            <label class="suite-field">
              <span>Width (px)</span>
              <input id="resizeW" type="number" placeholder="Auto" min="1" max="10000" />
            </label>
            <label class="suite-field">
              <span>Height (px)</span>
              <input id="resizeH" type="number" placeholder="Auto" min="1" max="10000" />
            </label>
            <label class="suite-field suite-field--row">
              <input id="resizeLock" type="checkbox" checked />
              <span>Lock aspect ratio</span>
            </label>
            <label class="suite-field">
              <span>Output format</span>
              <select id="resizeFmt">
                <option value="image/png" selected>PNG</option>
                <option value="image/webp">WebP</option>
                <option value="image/jpeg">JPG</option>
              </select>
            </label>
          </div>
        </div>

        <div class="suite-section suite-config" id="cfg-rotate" hidden>
          <strong class="suite-section__label">Rotate / Flip</strong>
          <div class="suite-fields">
            <label class="suite-field">
              <span>Rotation</span>
              <select id="rotateDeg">
                <option value="90">90° clockwise</option>
                <option value="180">180°</option>
                <option value="270">90° counter-clockwise</option>
              </select>
            </label>
            <label class="suite-field suite-field--row">
              <input id="flipH" type="checkbox" />
              <span>Flip horizontal</span>
            </label>
            <label class="suite-field suite-field--row">
              <input id="flipV" type="checkbox" />
              <span>Flip vertical</span>
            </label>
          </div>
        </div>

        <div class="suite-section suite-config" id="cfg-watermark" hidden>
          <strong class="suite-section__label">Watermark settings</strong>
          <div class="suite-fields">
            <label class="suite-field">
              <span>Text</span>
              <input id="wmText" type="text" placeholder="© Your Brand" value="" />
            </label>
            <label class="suite-field">
              <span>Position</span>
              <select id="wmPos">
                <option value="br" selected>Bottom-right</option>
                <option value="bl">Bottom-left</option>
                <option value="tr">Top-right</option>
                <option value="tl">Top-left</option>
                <option value="center">Center</option>
              </select>
            </label>
            <label class="suite-field">
              <span>Opacity — <strong id="wmOpVal">70</strong>%</span>
              <input id="wmOp" type="range" min="10" max="100" step="5" value="70" />
            </label>
            <label class="suite-field">
              <span>Size</span>
              <select id="wmSize">
                <option value="small">Small</option>
                <option value="medium" selected>Medium</option>
                <option value="large">Large</option>
              </select>
            </label>
          </div>
        </div>

        <!-- Process button -->
        <button id="runBtn" class="suite-run-btn" type="button" disabled>Process image</button>
      </div>

      <!-- RIGHT: Preview + Download -->
      <div class="suite-panel suite-panel--preview">
        <div class="suite-section__head">
          <strong>Result</strong>
          <button id="downloadBtn" class="suite-btn-sm" type="button" disabled>Download</button>
        </div>
        <div class="suite-preview-area">
          <img id="preview" class="suite-preview-img" alt="Result preview" />
          <div class="suite-preview-empty" id="previewEmpty">Process an image to see the result</div>
        </div>
        <div class="suite-meta" id="outMeta">—</div>
      </div>

    </div>
  </main>

  <script>
    const $ = (id: string) => document.getElementById(id);

    // ── Tool picker ──────────────────────────────────────────
    let activeTool = "upscale";
    const allConfigs = ["cfg-upscale", "cfg-compress", "cfg-convert", "cfg-resize", "cfg-rotate", "cfg-watermark"];

    document.querySelectorAll(".suite-tool-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        activeTool = (btn as HTMLElement).dataset.tool!;
        document.querySelectorAll(".suite-tool-btn").forEach(b => b.classList.remove("suite-tool-btn--active"));
        btn.classList.add("suite-tool-btn--active");
        allConfigs.forEach(id => { const el = $(id) as HTMLElement; if (el) el.hidden = id !== `cfg-${activeTool}`; });
      });
    });

    // ── File upload ──────────────────────────────────────────
    const fileEl = $("file") as HTMLInputElement;
    const pickBtn = $("pickBtn") as HTMLButtonElement;
    const dropEl = $("drop") as HTMLElement;
    const runBtn = $("runBtn") as HTMLButtonElement;
    const downloadBtn = $("downloadBtn") as HTMLButtonElement;
    const previewEl = $("preview") as HTMLImageElement;
    const previewEmpty = $("previewEmpty") as HTMLElement;
    const origMeta = $("origMeta") as HTMLElement;
    const outMeta = $("outMeta") as HTMLElement;

    let srcImg: HTMLImageElement | null = null;
    let srcFile: File | null = null;
    let outBlob: Blob | null = null;
    let srcName = "image";

    pickBtn.addEventListener("click", () => fileEl.click());
    dropEl.addEventListener("click", () => fileEl.click());
    dropEl.addEventListener("keydown", (e: KeyboardEvent) => { if (e.key === "Enter" || e.key === " ") fileEl.click(); });
    dropEl.addEventListener("dragover", (e: DragEvent) => { e.preventDefault(); dropEl.classList.add("suite-drop--active"); });
    dropEl.addEventListener("dragleave", () => dropEl.classList.remove("suite-drop--active"));
    dropEl.addEventListener("drop", (e: DragEvent) => { e.preventDefault(); dropEl.classList.remove("suite-drop--active"); const f = e.dataTransfer?.files[0]; if (f) loadFile(f); });
    fileEl.addEventListener("change", () => { const f = fileEl.files?.[0]; if (f) loadFile(f); });

    async function loadFile(file: File) {
      srcFile = file;
      srcName = file.name.replace(/\.[^/.]+$/, "");
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.src = url;
      await img.decode();
      URL.revokeObjectURL(url);
      srcImg = img;
      const M = (window as any).VxFileMetrics;
      origMeta.textContent = M
        ? M.formatResultMeta({ width: img.width, height: img.height, outputBytes: file.size })
        : `${img.width} × ${img.height} · ${(file.size / 1024).toFixed(0)} KB`;
      runBtn.disabled = false;
      dropEl.innerHTML = `<span style="opacity:.6">Loaded: ${file.name}</span>`;

      // Pre-fill resize with current dimensions
      ($("resizeW") as HTMLInputElement).value = String(img.width);
      ($("resizeH") as HTMLInputElement).value = String(img.height);
    }

    // ── Range displays ───────────────────────────────────────
    $("quality")?.addEventListener("input", () => { ($("qualityVal") as HTMLElement).textContent = ($("quality") as HTMLInputElement).value; });
    $("convertQual")?.addEventListener("input", () => { ($("convertQualVal") as HTMLElement).textContent = ($("convertQual") as HTMLInputElement).value; });
    $("wmOp")?.addEventListener("input", () => { ($("wmOpVal") as HTMLElement).textContent = ($("wmOp") as HTMLInputElement).value; });

    // ── Resize lock ratio ────────────────────────────────────
    $("resizeW")?.addEventListener("input", () => {
      if (!srcImg || !($("resizeLock") as HTMLInputElement).checked) return;
      const w = parseInt(($("resizeW") as HTMLInputElement).value) || 0;
      if (w > 0) ($("resizeH") as HTMLInputElement).value = String(Math.round(w * (srcImg.height / srcImg.width)));
    });
    $("resizeH")?.addEventListener("input", () => {
      if (!srcImg || !($("resizeLock") as HTMLInputElement).checked) return;
      const h = parseInt(($("resizeH") as HTMLInputElement).value) || 0;
      if (h > 0) ($("resizeW") as HTMLInputElement).value = String(Math.round(h * (srcImg.width / srcImg.height)));
    });

    // ── Process ──────────────────────────────────────────────
    runBtn.addEventListener("click", async () => {
      if (!srcImg || !srcFile) return;
      runBtn.disabled = true;
      runBtn.textContent = "Processing…";

      try {
        const canvas = document.createElement("canvas");
        const ctx = canvas.getContext("2d")!;

        if (activeTool === "upscale") {
          const scale = parseInt(($("scale") as HTMLSelectElement).value);
          canvas.width = srcImg.width * scale;
          canvas.height = srcImg.height * scale;
          ctx.imageSmoothingEnabled = ($("smooth") as HTMLInputElement).checked;
          if (ctx.imageSmoothingEnabled) ctx.imageSmoothingQuality = "high";
          ctx.drawImage(srcImg, 0, 0, canvas.width, canvas.height);
          const fmt = ($("format") as HTMLSelectElement).value;
          outBlob = await toBlob(canvas, fmt, 0.95);

        } else if (activeTool === "compress") {
          canvas.width = srcImg.width;
          canvas.height = srcImg.height;
          ctx.drawImage(srcImg, 0, 0);
          const q = parseInt(($("quality") as HTMLInputElement).value) / 100;
          const fmt = ($("compressFmt") as HTMLSelectElement).value;
          outBlob = await toBlob(canvas, fmt, q);

        } else if (activeTool === "convert") {
          canvas.width = srcImg.width;
          canvas.height = srcImg.height;
          ctx.drawImage(srcImg, 0, 0);
          const q = parseInt(($("convertQual") as HTMLInputElement).value) / 100;
          const fmt = ($("convertFmt") as HTMLSelectElement).value;
          outBlob = await toBlob(canvas, fmt, q);

        } else if (activeTool === "resize") {
          const w = parseInt(($("resizeW") as HTMLInputElement).value) || srcImg.width;
          const h = parseInt(($("resizeH") as HTMLInputElement).value) || srcImg.height;
          canvas.width = w;
          canvas.height = h;
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = "high";
          ctx.drawImage(srcImg, 0, 0, w, h);
          const fmt = ($("resizeFmt") as HTMLSelectElement).value;
          outBlob = await toBlob(canvas, fmt, 0.95);

        } else if (activeTool === "rotate") {
          const deg = parseInt(($("rotateDeg") as HTMLSelectElement).value);
          const flipH = ($("flipH") as HTMLInputElement).checked;
          const flipV = ($("flipV") as HTMLInputElement).checked;
          const isVertical = deg === 90 || deg === 270;
          canvas.width = isVertical ? srcImg.height : srcImg.width;
          canvas.height = isVertical ? srcImg.width : srcImg.height;
          ctx.save();
          ctx.translate(canvas.width / 2, canvas.height / 2);
          ctx.rotate((deg * Math.PI) / 180);
          ctx.scale(flipH ? -1 : 1, flipV ? -1 : 1);
          ctx.drawImage(srcImg, -srcImg.width / 2, -srcImg.height / 2);
          ctx.restore();
          outBlob = await toBlob(canvas, "image/png", 0.95);

        } else if (activeTool === "watermark") {
          canvas.width = srcImg.width;
          canvas.height = srcImg.height;
          ctx.drawImage(srcImg, 0, 0);

          const text = ($("wmText") as HTMLInputElement).value || "© Watermark";
          const pos = ($("wmPos") as HTMLSelectElement).value;
          const opacity = parseInt(($("wmOp") as HTMLInputElement).value) / 100;
          const sizeMap: Record<string, number> = { small: 0.02, medium: 0.035, large: 0.05 };
          const fontSize = Math.max(14, Math.round(Math.min(canvas.width, canvas.height) * (sizeMap[($("wmSize") as HTMLSelectElement).value] || 0.035)));

          ctx.save();
          ctx.globalAlpha = opacity;
          ctx.font = `bold ${fontSize}px system-ui, sans-serif`;
          ctx.fillStyle = "#ffffff";
          ctx.shadowColor = "rgba(0,0,0,.5)";
          ctx.shadowBlur = 4;

          const m = ctx.measureText(text);
          const pad = fontSize;
          let x = pad, y = canvas.height - pad;
          if (pos.includes("r")) x = canvas.width - m.width - pad;
          if (pos.includes("t")) y = pad + fontSize;
          if (pos === "center") { x = (canvas.width - m.width) / 2; y = canvas.height / 2; }

          ctx.fillText(text, x, y);
          ctx.restore();
          outBlob = await toBlob(canvas, "image/png", 0.95);
        }

        if (outBlob) {
          const M = (window as any).VxFileMetrics;
          const delta = M.calcDelta(srcFile.size, outBlob.size);

          // Compress protection: if output grew, warn user and offer original
          if (activeTool === "compress" && delta.direction === "larger") {
            outMeta.textContent = M.formatResultMeta({ width: canvas.width, height: canvas.height, outputBytes: srcFile.size, inputBytes: srcFile.size })
              + " · kept original (compression not effective)";
            // Preserve original file instead of the larger blob
            outBlob = srcFile.slice(0, srcFile.size, srcFile.type) as unknown as Blob;
            previewEl.src = URL.createObjectURL(srcFile);
          } else {
            outMeta.textContent = M.formatResultMeta({ width: canvas.width, height: canvas.height, outputBytes: outBlob.size, inputBytes: srcFile.size });
            previewEl.src = URL.createObjectURL(outBlob);
          }

          previewEl.style.display = "block";
          previewEmpty.style.display = "none";
          downloadBtn.disabled = false;
        }
      } catch (err: any) {
        console.error(err);
        outMeta.textContent = "Error: " + (err?.message || "Processing failed");
      } finally {
        runBtn.disabled = false;
        runBtn.textContent = "Process image";
      }
    });

    function toBlob(canvas: HTMLCanvasElement, mime: string, quality: number): Promise<Blob | null> {
      return new Promise(res => canvas.toBlob(res, mime, quality));
    }

    // ── Download ─────────────────────────────────────────────
    downloadBtn.addEventListener("click", () => {
      if (!outBlob) return;
      const extMap: Record<string, string> = { "image/png": "png", "image/jpeg": "jpg", "image/webp": "webp", "image/avif": "avif" };
      const ext = extMap[outBlob.type] || "png";
      const a = document.createElement("a");
      a.href = URL.createObjectURL(outBlob);
      a.download = `${srcName}-${activeTool}.${ext}`;
      a.click();
      URL.revokeObjectURL(a.href);
    });
  </script>

  <SiteFooter />
  <PageWidgets />
  <script is:inline>window.__vxTool = 'image-suite';</script>
  <script is:inline src="/scripts/vx-auth-gate.js"></script>
</body>
</html>

<style>
  .suite-title {
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 800;
    letter-spacing: -.03em;
    margin-bottom: 4px;
  }
  .suite-pro-tag {
    font-size: 11px;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(109,94,252,.15);
    border: 1px solid rgba(109,94,252,.35);
    color: #C4B5FD;
    vertical-align: middle;
    letter-spacing: .1em;
    font-weight: 700;
  }
  .suite-sub {
    font-size: 15px;
    opacity: .5;
    margin-bottom: 24px;
  }

  .suite-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .suite-panel {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .suite-section {
    padding: 18px 20px;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,.06);
    background: rgba(255,255,255,.03);
    backdrop-filter: blur(8px);
  }

  .suite-section__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
    font-size: 14px;
    font-weight: 700;
  }

  .suite-section__label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: .4;
    margin-bottom: 10px;
  }

  .suite-btn-sm {
    padding: 6px 14px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,.1);
    background: rgba(255,255,255,.04);
    color: rgba(255,255,255,.7);
    font-size: 12px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: all .2s;
  }
  .suite-btn-sm:hover {
    border-color: rgba(109,94,252,.3);
    color: #C4B5FD;
  }
  .suite-btn-sm:disabled {
    opacity: .3;
    cursor: not-allowed;
  }

  /* Drop zone */
  .suite-drop {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 28px 16px;
    border-radius: 12px;
    border: 2px dashed rgba(255,255,255,.08);
    background: rgba(0,0,0,.15);
    cursor: pointer;
    transition: all .2s;
    font-size: 13px;
    color: rgba(255,255,255,.4);
    text-align: center;
  }
  .suite-drop:hover, .suite-drop--active {
    border-color: rgba(109,94,252,.3);
    background: rgba(109,94,252,.04);
  }
  .suite-drop__icon { font-size: 22px; opacity: .3; }

  .suite-meta {
    font-size: 12px;
    color: rgba(255,255,255,.35);
    margin-top: 8px;
    font-family: ui-monospace, monospace;
  }

  /* Tool picker */
  .suite-tools {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .suite-tool-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 12px 8px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,.06);
    background: rgba(255,255,255,.02);
    color: rgba(255,255,255,.5);
    cursor: pointer;
    font-family: inherit;
    font-size: 11px;
    font-weight: 600;
    transition: all .2s;
  }
  .suite-tool-btn:hover {
    border-color: rgba(109,94,252,.25);
    color: rgba(255,255,255,.8);
    background: rgba(109,94,252,.04);
  }
  .suite-tool-btn--active {
    border-color: rgba(109,94,252,.4);
    background: rgba(109,94,252,.1);
    color: #C4B5FD;
    box-shadow: 0 0 12px rgba(109,94,252,.08);
  }
