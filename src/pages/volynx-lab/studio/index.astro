---
import "../../../styles/lab.css";
import LabBg from "../../../components/LabBg.astro";
import PageWidgets from "../../../components/PageWidgets.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import Topbar from "../../../components/Topbar.astro";
const pageTitle = "Volynx Studio Pro — Professional Browser Tools";
const pageDescription = "Volynx Studio Pro: unlimited image processing, batch mode, commercial rights. No install, no server.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>
  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/site.webmanifest" />
</head>

<body>
  <LabBg />
  <Topbar leftLinks={[{ href: "/volynx-lab/", label: "← Free Lab", i18n: "studio.nav_back" }, { href: "/pricing/", label: "See pricing", i18n: "studio.nav_pricing" }]} />

  <main class="wrap">

    <!-- ═══════════════════════════════════════════════ -->
    <!-- PRO DASHBOARD (hidden by default, shown for pro users) -->
    <!-- ═══════════════════════════════════════════════ -->
    <div id="proDash" style="display:none">

      <!-- Studio logo -->
      <div class="pro-logo">
        <img src="/assets/studio-logo.webp" alt="Volynx Studio Pro" class="pro-logo-img" />
      </div>

      <!-- Pro header -->
      <div class="pro-header">
        <div class="pro-header__left">
          <div class="pro-badge-glow"></div>
          <span class="pro-badge">Pro</span>
          <div>
            <h1 class="pro-title">Welcome back, <span id="proName">—</span></h1>
            <p class="pro-sub">Your Studio is ready. All tools unlocked, no limits.</p>
          </div>
        </div>
        <div class="pro-header__right">
          <span class="pro-plan-pill" id="proPlan">pro</span>
          <a href="/profile/" class="pro-profile-link">Profile ↗</a>
        </div>
      </div>

      <!-- Usage overview strip -->
      <div class="usage-strip">
        <div class="usage-strip__label">Today's usage</div>
        <div class="usage-strip__items" id="usageStrip">
          <div class="usage-pill"><span class="usage-pill__name">Loading...</span></div>
        </div>
      </div>

      <!-- Tool cards grid -->
      <div class="pro-tools-grid">

        <a href="/volynx-lab/studio/converter/" class="pro-tool-card" data-tool="converter">
          <div class="pro-tool-card__glow" style="--glow:#6D5EFC"></div>
          <div class="pro-tool-card__head">
            <div class="pro-tool-card__icon"><img src="/assets/proconverter.webp" alt="Converter" width="52" height="52" /></div>
            <div class="pro-tool-card__usage">
              <span class="pro-tool-card__count" data-tool-count="converter">—</span>
              <span class="pro-tool-card__limit" data-tool-limit="converter">/ —</span>
            </div>
          </div>
          <h2 class="pro-tool-card__title">Converter</h2>
          <p class="pro-tool-card__desc">WebP, JPG, PNG, AVIF — batch convert with quality control and resize.</p>
          <div class="pro-tool-card__bar"><div class="pro-tool-card__fill" data-tool-bar="converter"></div></div>
          <span class="pro-tool-card__link">Open tool →</span>
        </a>

        <a href="/volynx-lab/studio/image-scaler/" class="pro-tool-card" data-tool="image-scaler">
          <div class="pro-tool-card__glow" style="--glow:#3B82F6"></div>
          <div class="pro-tool-card__head">
            <div class="pro-tool-card__icon"><img src="/assets/proscaler.webp" alt="Image Scaler" width="52" height="52" /></div>
            <div class="pro-tool-card__usage">
              <span class="pro-tool-card__count" data-tool-count="image-scaler">—</span>
              <span class="pro-tool-card__limit" data-tool-limit="image-scaler">/ —</span>
            </div>
          </div>
          <h2 class="pro-tool-card__title">Image Scaler</h2>
          <p class="pro-tool-card__desc">Upscale 2×, 3×, 4× — maximum resolution, zero quality loss.</p>
          <div class="pro-tool-card__bar"><div class="pro-tool-card__fill" data-tool-bar="image-scaler"></div></div>
          <span class="pro-tool-card__link">Open tool →</span>
        </a>

        <a href="/volynx-lab/studio/image-suite/" class="pro-tool-card" data-tool="image-suite">
          <div class="pro-tool-card__glow" style="--glow:#8B5CF6"></div>
          <div class="pro-tool-card__head">
            <div class="pro-tool-card__icon"><img src="/assets/prosuite.webp" alt="Image Suite" width="52" height="52" /></div>
            <div class="pro-tool-card__usage">
              <span class="pro-tool-card__count" data-tool-count="image-suite">—</span>
              <span class="pro-tool-card__limit" data-tool-limit="image-suite">/ —</span>
            </div>
          </div>
          <h2 class="pro-tool-card__title">Image Suite</h2>
          <p class="pro-tool-card__desc">Upscale, compress, convert — all in one interface. Pro exclusive.</p>
          <div class="pro-tool-card__bar"><div class="pro-tool-card__fill" data-tool-bar="image-suite"></div></div>
          <span class="pro-tool-card__link">Open tool →</span>
        </a>

        <a href="/volynx-lab/studio/qr-gen/" class="pro-tool-card" data-tool="qr-gen">
          <div class="pro-tool-card__glow" style="--glow:#EC4899"></div>
          <div class="pro-tool-card__head">
            <div class="pro-tool-card__icon"><img src="/assets/proqrgen.webp" alt="QR Generator" width="52" height="52" /></div>
            <div class="pro-tool-card__usage">
              <span class="pro-tool-card__count" data-tool-count="qr-gen">—</span>
              <span class="pro-tool-card__limit" data-tool-limit="qr-gen">/ —</span>
            </div>
          </div>
          <h2 class="pro-tool-card__title">QR Generator</h2>
          <p class="pro-tool-card__desc">Styled QR codes with logos, gradients, and high-res export.</p>
          <div class="pro-tool-card__bar"><div class="pro-tool-card__fill" data-tool-bar="qr-gen"></div></div>
          <span class="pro-tool-card__link">Open tool →</span>
        </a>

      </div>

      <!-- Pro features strip -->
      <div class="pro-perks">
        <div class="pro-perk"><span>∞</span> No daily limits</div>
        <div class="pro-perk"><span>⚡</span> Batch + ZIP</div>
        <div class="pro-perk"><span>✓</span> Commercial rights</div>
        <div class="pro-perk"><span>🔒</span> 100% local</div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- SALES PAGE (shown for free/anonymous users)    -->
    <!-- ═══════════════════════════════════════════════ -->
    <div id="salesPage">

      <div class="hero">
        <div class="hero__logo">
          <img src="/assets/studio-logo.webp" alt="Volynx Studio Pro" class="hero__logo-img" />
        </div>
        <div class="hero__badge"><span class="studio-badge">Studio Pro</span></div>
        <h1 class="hero__title" data-i18n="studio.hero_title">
          Your production<br><span class="hero__title-accent">pipeline. In the browser.</span>
        </h1>
        <p class="hero__desc" data-i18n="studio.hero_desc">
          No installs. No file size anxiety. No daily limits hitting you mid-project.
          Studio Pro unlocks the full suite with batch processing and commercial rights — for the price of a coffee a week.
        </p>
        <div class="hero__actions">
          <a class="btn-primary" href="/signup/" data-i18n="studio.btn_start">Start Studio Pro — £19/month</a>
          <a class="btn-ghost" href="/pricing/" data-i18n="studio.btn_plans">Compare plans</a>
        </div>
        <p class="hero__note" data-i18n="studio.hero_note">Cancel anytime. No contracts.</p>
      </div>

      <section class="why-section">
        <div class="why-label" data-i18n="studio.why_label">Why upgrade</div>
        <div class="why-grid">
          <div class="why-card"><div class="why-icon">∞</div><h3>No limits</h3><p>Process as many files as you need. No daily cap, no throttling.</p></div>
          <div class="why-card"><div class="why-icon">⚡</div><h3>Batch + ZIP</h3><p>Drop 50 images, convert them all, download a clean ZIP.</p></div>
          <div class="why-card"><div class="why-icon">✓</div><h3>Commercial rights</h3><p>Use outputs in client work, products, and campaigns.</p></div>
          <div class="why-card"><div class="why-icon">🔒</div><h3>Local processing</h3><p>Files never leave your device. Fast, private, yours.</p></div>
        </div>
      </section>

      <section class="tools-section">
        <div class="section-label" data-i18n="studio.tools_label">What's included</div>
        <div class="tools-grid">
          <a href="/volynx-lab/studio/converter/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
            <div class="tool-card__icon"><img src="/assets/proconverter.webp" alt="" loading="lazy" /></div>
            <h2 class="tool-card__title">Converter</h2>
            <p class="tool-card__desc">Convert to WebP, JPG, PNG, or AVIF with quality control and resize. Batch mode + ZIP download.</p>
            <div class="tool-tag">Batch · No limits · 4 formats</div>
            <span class="tool-card__link">Open tool →</span>
          </a>
          <a href="/volynx-lab/studio/image-scaler/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
            <div class="tool-card__icon"><img src="/assets/proscaler.webp" alt="" loading="lazy" /></div>
            <h2 class="tool-card__title">Image Scaler</h2>
            <p class="tool-card__desc">Upscale to 2×, 3×, or 4× with maximum output resolution. No daily limit.</p>
            <div class="tool-tag">Up to 4× · Unlimited · Local</div>
            <span class="tool-card__link">Open tool →</span>
          </a>
          <a href="/volynx-lab/studio/image-suite/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
            <div class="tool-card__icon"><img src="/assets/prosuite.webp" alt="" loading="lazy" /></div>
            <h2 class="tool-card__title">Image Suite</h2>
            <p class="tool-card__desc">Upscale, compress, and convert inside a single interface. Studio Pro exclusive.</p>
            <div class="tool-tag pro-only">Pro exclusive</div>
            <span class="tool-card__link">Open tool →</span>
          </a>
          <a href="/volynx-lab/studio/qr-gen/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
            <div class="tool-card__icon"><img src="/assets/proqrgen.webp" alt="" loading="lazy" /></div>
            <h2 class="tool-card__title">QR Generator</h2>
            <p class="tool-card__desc">Generate styled QR codes, save history, and export at high resolution.</p>
            <div class="tool-tag">High-res · History · Styled</div>
            <span class="tool-card__link">Open tool →</span>
          </a>
        </div>
      </section>

      <section class="price-strip">
        <div class="price-strip__inner">
          <div class="price-strip__left">
            <div class="price-strip__amount">£19<span>/month</span></div>
            <p class="price-strip__desc">All Studio tools. No limits. Commercial rights. Cancel anytime.</p>
          </div>
          <div class="price-strip__right">
            <a class="btn-primary" href="/signup/">Start Studio Pro</a>
            <a class="btn-ghost" href="/login/">Sign in</a>
          </div>
        </div>
      </section>

      <section class="faq-section">
        <div class="section-label">FAQ</div>
        <div class="faq-grid">
          <details class="faq-item"><summary>Do my files get uploaded?</summary><p>No. All processing happens locally in your browser. Files never leave your device.</p></details>
          <details class="faq-item"><summary>Can I cancel anytime?</summary><p>Yes. One click from your account settings. Access continues until end of paid period.</p></details>
          <details class="faq-item"><summary>Lab vs Studio?</summary><p>Lab is free with daily limits. Studio Pro removes all limits, adds batch mode and commercial rights.</p></details>
          <details class="faq-item"><summary>Commercial use?</summary><p>Yes. Studio Pro includes commercial rights for all outputs.</p></details>
        </div>
      </section>
    </div>

  </main>

  <SiteFooter />
  <PageWidgets />
</body>
</html>

<script is:inline type="module">
  const TOOLS = ["converter", "image-scaler", "image-suite", "qr-gen"];

  async function boot() {
    const token = localStorage.getItem("volynx_access_token");
    const refresh = localStorage.getItem("volynx_refresh_token");
    if (!token || !refresh) return; // not logged in → show sales

    let cfg;
    try { cfg = await fetch("/config.json", { cache: "no-store" }).then(r => r.json()); }
    catch { return; }

    const apiBase = (cfg.apiBaseUrl || "").replace(/\/$/, "");
    if (!apiBase) return;

    // Check permission for first tool to get plan info
    let plan = "free";
    let userName = "";
    try {
      const res = await fetch(`${apiBase}/api/check-permission`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
        body: JSON.stringify({ tool: "converter" }),
      });
      if (res.ok) {
        const perm = await res.json();
        plan = perm.plan || "free";
      }
    } catch { return; }

    // Only show dashboard for pro+ users
    if (plan !== "pro" && plan !== "enterprise") return;

    // Get user name from profile
    try {
      const { createClient } = await import("https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm");
      const supa = createClient(cfg.supabaseUrl, cfg.supabaseAnonKey);
      await supa.auth.setSession({ access_token: token, refresh_token: refresh });
      const { data: authData } = await supa.auth.getUser();
      if (authData?.user?.id) {
        const { data: profile } = await supa.from("profiles").select("full_name,username").eq("id", authData.user.id).single();
        userName = profile?.full_name || profile?.username || authData.user.email?.split("@")[0] || "";
      }
    } catch {}

    // Switch to Pro dashboard
    document.getElementById("salesPage").style.display = "none";
    document.getElementById("proDash").style.display = "block";
    document.getElementById("proName").textContent = userName || "Pro user";
    document.getElementById("proPlan").textContent = plan;

    // Fetch usage for each tool
    const usageStripEl = document.getElementById("usageStrip");
    let stripHtml = "";

    for (const tool of TOOLS) {
      try {
        const res = await fetch(`${apiBase}/api/check-permission`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify({ tool }),
        });
        if (!res.ok) continue;
        const perm = await res.json();

        const used = perm.used || 0;
        const limit = perm.limit === -1 ? "∞" : perm.limit;
        const remaining = perm.remaining === -1 ? "∞" : perm.remaining;
        const pct = perm.limit === -1 ? 0 : Math.min(100, (used / perm.limit) * 100);

        // Update card
        const countEl = document.querySelector(`[data-tool-count="${tool}"]`);
        const limitEl = document.querySelector(`[data-tool-limit="${tool}"]`);
        const barEl = document.querySelector(`[data-tool-bar="${tool}"]`);
        if (countEl) countEl.textContent = String(used);
        if (limitEl) limitEl.textContent = `/ ${limit}`;
        if (barEl) {
          barEl.style.width = perm.limit === -1 ? "0%" : `${pct}%`;
          if (pct > 80) barEl.style.background = "linear-gradient(90deg, #F59E0B, #EF4444)";
        }

        // Usage strip
        const toolName = tool.replace(/-/g, " ").replace(/\b\w/g, c => c.toUpperCase());
        stripHtml += `<div class="usage-pill"><span class="usage-pill__name">${toolName}</span><span class="usage-pill__val">${used} <small>/ ${limit}</small></span></div>`;
      } catch {}
    }

    if (usageStripEl && stripHtml) usageStripEl.innerHTML = stripHtml;
  }

  boot();
</script>

<style>
  /* ══════════════════════════════════════════════════════ */
  /* PRO DASHBOARD                                         */
  /* ══════════════════════════════════════════════════════ */

  .pro-logo {
    display: flex;
    justify-content: center;
    padding: 32px 0 8px;
  }
  .pro-logo-img {
    width: min(480px, 75vw);
    height: auto;
    display: block;
    filter: drop-shadow(0 0 30px rgba(109,94,252,.25));
  }

  .pro-header {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; flex-wrap: wrap;
    padding: 16px 0 24px;
  }
  .pro-header__left { display: flex; align-items: center; gap: 16px; position: relative; }
  .pro-header__right { display: flex; align-items: center; gap: 12px; }

  .pro-badge {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 6px 16px; border-radius: 999px;
    font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase;
    background: linear-gradient(135deg, rgba(109,94,252,.25), rgba(139,92,246,.2));
    border: 1px solid rgba(109,94,252,.5);
    color: #C4B5FD;
    position: relative; z-index: 1;
  }
  .pro-badge-glow {
    position: absolute; left: 0; top: 50%; transform: translateY(-50%);
    width: 60px; height: 60px; border-radius: 50%;
    background: radial-gradient(circle, rgba(109,94,252,.25), transparent 70%);
    filter: blur(8px); pointer-events: none;
  }

  .pro-title {
    font-size: clamp(20px, 3vw, 28px); font-weight: 800;
    letter-spacing: -.02em; margin: 0;
  }
  .pro-title span { color: #C4B5FD; }
  .pro-sub { font-size: 14px; opacity: .5; margin: 4px 0 0; }

  .pro-plan-pill {
    font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    padding: 4px 12px; border-radius: 999px;
    background: rgba(52,211,153,.1); border: 1px solid rgba(52,211,153,.3); color: #34D399;
  }
  .pro-profile-link {
    font-size: 13px; font-weight: 600; color: rgba(255,255,255,.5);
    text-decoration: none; transition: color .2s;
  }
  .pro-profile-link:hover { color: #C4B5FD; }

  /* Usage strip */
  .usage-strip {
    padding: 20px 24px; border-radius: 16px; margin-bottom: 24px;
    background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.06);
    backdrop-filter: blur(8px);
  }
  .usage-strip__label {
    font-size: 11px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase;
    opacity: .35; margin-bottom: 12px;
  }
  .usage-strip__items { display: flex; gap: 10px; flex-wrap: wrap; }

  .usage-pill {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 16px; border-radius: 12px;
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.06);
    font-size: 13px;
    margin: 10px 80px 10px 15px;
  }
  .usage-pill__name { font-weight: 900; opacity: .6; margin-right: 15px; }
  .usage-pill__val { font-weight: 800; color: #C4B5FD; }
  .usage-pill__val small { font-weight: 500; opacity: .4; color: rgba(255,255,255,.6); }

  /* Tool cards */
  .pro-tools-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 16px; margin-bottom: 24px;
  }

  .pro-tool-card {
    position: relative; overflow: hidden;
    padding: 28px 24px 20px; border-radius: 20px;
    background: rgba(255,255,255,.03);
    border: 1px solid rgba(255,255,255,.07);
    backdrop-filter: blur(8px);
    text-decoration: none; color: inherit;
    transition: all .3s;
    display: flex; flex-direction: column;
  }
  .pro-tool-card:hover {
    border-color: rgba(109,94,252,.3);
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(0,0,0,.2);
  }
  .pro-tool-card__glow {
    position: absolute; top: -20px; right: -20px;
    width: 100px; height: 100px; border-radius: 50%;
    background: radial-gradient(circle, var(--glow, #6D5EFC), transparent 70%);
    opacity: .08; filter: blur(20px); pointer-events: none;
    transition: opacity .3s;
  }
  .pro-tool-card:hover .pro-tool-card__glow { opacity: .18; }

  .pro-tool-card__head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 14px;
  }
  .pro-tool-card__icon {
    width: 52px; height: 52px; border-radius: 14px; overflow: hidden;
    background: rgba(109,94,252,.08); border: 1px solid rgba(109,94,252,.12);
    flex-shrink: 0; position: relative;
  }
  .pro-tool-card__icon img {
    width: 52px; height: 52px; object-fit: cover; display: block;
    border-radius: 14px;
  }

  .pro-tool-card__usage { display: flex; align-items: baseline; gap: 2px; }
  .pro-tool-card__count { font-size: 28px; font-weight: 800; letter-spacing: -.02em; color: #C4B5FD; }
  .pro-tool-card__limit { font-size: 14px; opacity: .3; font-weight: 500; }

  .pro-tool-card__title { font-size: 18px; font-weight: 700; margin: 0 0 6px; }
