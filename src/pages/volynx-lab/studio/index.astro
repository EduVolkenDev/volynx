---
import "../../../styles/lab.css";
import PageWidgets from "../../../components/PageWidgets.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import VxHeader from "../../../components/VxHeader.astro";
const pageTitle = "VOLYNX Studio — Pro Tools";
const pageDescription = "Professional browser-based tools by VOLYNX Studio — image processing, QR generation and more with higher limits and pro features.";
---

<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/assets/site.webmanifest" />
</head>

<body>
  <VxHeader />
  <div class="bg" aria-hidden="true"></div>

  <main class="wrap">
    <div class="hero">
      <div class="hero__badge">
        <span class="hero__badge-dot" aria-hidden="true"></span>
        VOLYNX Studio
      </div>
      <h1 class="hero__title">
        Pro <span class="hero__title-accent">Studio Tools</span>
      </h1>
      <p class="hero__desc">
        Ferramentas profissionais para produção em escala.
        Limites maiores, batch processing e uso comercial.
      </p>
    </div>

    <div class="tools-grid">
      <a href="/volynx-lab/studio/converter/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
        <span class="tool-card__free" style="background:rgba(109,94,252,.18);border-color:rgba(109,94,252,.35)">PRO</span>
        <span class="tool-card__chip">Converter</span>
        <div class="tool-card__icon" aria-hidden="true">🔄</div>
        <h2 class="tool-card__title">Converter</h2>
        <p class="tool-card__desc">
          Converta imagens para WebP, JPG, PNG ou AVIF com limites maiores,
          batch processing e download ZIP em escala.
        </p>
        <span class="tool-card__link">
          Abrir Studio
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/volynx-lab/studio/image-scaler/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
        <span class="tool-card__free" style="background:rgba(109,94,252,.18);border-color:rgba(109,94,252,.35)">PRO</span>
        <span class="tool-card__chip">Upscaler</span>
        <div class="tool-card__icon" aria-hidden="true">🔍</div>
        <h2 class="tool-card__title">Image Scaler</h2>
        <p class="tool-card__desc">
          Amplie imagens em 2x, 3x ou 4x com nitidez máxima.
          Sem limite diário — processamento local, produção em escala.
        </p>
        <span class="tool-card__link">
          Abrir Studio
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/volynx-lab/studio/image-suite/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
        <span class="tool-card__free" style="background:rgba(109,94,252,.18);border-color:rgba(109,94,252,.35)">PRO</span>
        <span class="tool-card__chip">Suite</span>
        <div class="tool-card__icon" aria-hidden="true">🎨</div>
        <h2 class="tool-card__title">iMage Suite</h2>
        <p class="tool-card__desc">
          Upscale, compressão e conversão numa interface única.
          Desbloqueio PRO completo — sem restrições.
        </p>
        <span class="tool-card__link">
          Abrir Studio
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/volynx-lab/studio/qr-gen/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
        <span class="tool-card__free" style="background:rgba(109,94,252,.18);border-color:rgba(109,94,252,.35)">PRO</span>
        <span class="tool-card__chip">QR</span>
        <div class="tool-card__icon" aria-hidden="true">📱</div>
        <h2 class="tool-card__title">QR Generator</h2>
        <p class="tool-card__desc">
          Gere QR codes estilizados, salve histórico e exporte em alta resolução.
          Perfeito para campanhas e materiais impressos.
        </p>
        <span class="tool-card__link">
          Abrir Studio
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

    </div>
  </main>

  <SiteFooter />
  <PageWidgets />
</body>
</html>
