---
import "../../../styles/lab.css";
import PageWidgets from "../../../components/PageWidgets.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
const pageTitle = "VOLYNX Studio — Pro Tools";
const pageDescription = "Professional browser-based tools by VOLYNX Studio — image processing, QR generation and more with higher limits and pro features.";
---

<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/assets/site.webmanifest" />
</head>

<body>
  <div class="bg" aria-hidden="true"></div>

  <header class="topbar">
    <div class="topbar__inner">
      <a class="topbar__logo" href="/">VOLYNX</a>
      <a class="pill-back" href="/">← Home</a>
    </div>
  </header>

  <main class="wrap">
    <div class="hero">
      <div class="hero__badge">
        <span class="hero__badge-dot" aria-hidden="true"></span>
        <img src="/assets/oficial-volynx-logo.webp" alt="VOLYNX Studio" loading="eager" decoding="async" style="height:20px;width:auto" />
      </div>
      <h1 class="hero__title">
        Pro <span class="hero__title-accent">Studio Tools</span>
      </h1>
      <p class="hero__desc">
        Professional tools for scale production.
        Higher limits, batch processing and commercial use.
      </p>
    </div>

    <div class="tools-grid">
      <a href="/volynx-lab/studio/converter/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
        <div class="tool-card__icon" aria-hidden="true"><img src="/assets/proconverter.webp" alt="" loading="lazy" decoding="async" /></div>
        <h2 class="tool-card__title">Converter</h2>
        <p class="tool-card__desc">
          Convert Images to WebP, JPG, PNG or AVIF with bigger limits,
          batch processing and download ZIP at scale.
        </p>
        <span class="tool-card__link">
          Subscribe &amp; Open Studio
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/volynx-lab/studio/image-scaler/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
        <div class="tool-card__icon" aria-hidden="true"><img src="/assets/proscaler.webp" alt="" loading="lazy" decoding="async" /></div>
        <h2 class="tool-card__title">Image Scaler</h2>
        <p class="tool-card__desc">
          Image Upscale to 2x, 3x or 4x with maximum resolution.
          No daily limit — local processing, scale production.
        </p>
        <span class="tool-card__link">
          Subscribe &amp; Open Studio
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/volynx-lab/studio/image-suite/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
        <div class="tool-card__icon" aria-hidden="true"><img src="/assets/prosuite.webp" alt="" loading="lazy" decoding="async" /></div>
        <h2 class="tool-card__title">Image Suite</h2>
        <p class="tool-card__desc">
          Upscale, compression and conversion inside a unique interface.
          Become Full PRO  — No Restrictions.
        </p>
        <span class="tool-card__link">
          Subscribe &amp; Open Studio
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/volynx-lab/studio/qr-gen/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
        <div class="tool-card__icon" aria-hidden="true"><img src="/assets/proqrgen.webp" alt="" loading="lazy" decoding="async" /></div>
        <h2 class="tool-card__title">QR Generator</h2>
        <p class="tool-card__desc">
          Generate styled QR codes, save history and export at high resolution.
          Perfect for campaigns and printed materials.
        </p>
        <span class="tool-card__link">
          Subscribe &amp; Open Studio
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

    </div>
  </main>

  <SiteFooter />
  <PageWidgets />
</body>
</html>
