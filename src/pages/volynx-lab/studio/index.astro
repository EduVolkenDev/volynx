---
import "../../../styles/lab.css";
import LabBg from "../../../components/LabBg.astro";
import PageWidgets from "../../../components/PageWidgets.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
const pageTitle = "Volynx Studio Pro — Professional Browser Tools";
const pageDescription = "Volynx Studio Pro: unlimited image processing, batch mode, commercial rights. No install, no server. £19/month.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/assets/site.webmanifest" />
</head>

<body>
  <LabBg />

  <header class="topbar">
    <div class="topbar__inner">
      <a class="topbar__logo" href="/">VOLYNX</a>
      <nav style="display:flex;align-items:center;gap:10px">
        <a class="pill-back" href="/volynx-lab/">← Free Lab</a>
        <a class="pill-cta" href="/pricing/">See pricing</a>
      </nav>
    </div>
  </header>

  <main class="wrap">

    <!-- HERO -->
    <div class="hero">
      <div class="hero__logo">
        <img src="/assets/studio-logo.webp" alt="Volynx Studio Pro" class="hero__logo-img" />
      </div>

      <div class="hero__badge">
        <span class="studio-badge">Studio Pro</span>
      </div>

      <h1 class="hero__title">
        Your production<br><span class="hero__title-accent">pipeline. In the browser.</span>
      </h1>
      <p class="hero__desc">
        No installs. No file size anxiety. No daily limits hitting you mid-project.
        Studio Pro unlocks the full suite with batch processing and commercial rights — for the price of a coffee a week.
      </p>

      <div class="hero__actions">
        <a class="btn-primary" href="/signup/">Start Studio Pro — £19/month</a>
        <a class="btn-ghost" href="/pricing/">Compare plans</a>
      </div>

      <p class="hero__note">Cancel anytime. No contracts.</p>
    </div>

    <!-- WHY UPGRADE -->
    <section class="why-section">
      <div class="why-label">Why upgrade</div>
      <div class="why-grid">
        <div class="why-card">
          <div class="why-icon">∞</div>
          <h3>No limits</h3>
          <p>Process as many files as you need. No daily cap, no throttling mid-batch.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">⚡</div>
          <h3>Batch + ZIP</h3>
          <p>Drop 50 images, convert them all, download a clean ZIP. Built for scale workflows.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">✓</div>
          <h3>Commercial rights</h3>
          <p>Use outputs in client work, products, and campaigns. Covered under Studio Pro licence.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">🔒</div>
          <h3>Local processing</h3>
          <p>Files never leave your device. Everything runs in-browser — fast, private, yours.</p>
        </div>
      </div>
    </section>

    <!-- TOOLS -->
    <section class="tools-section">
      <div class="section-label">What's included</div>
      <div class="tools-grid">
        <a href="/volynx-lab/studio/converter/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
          <div class="tool-card__icon"><img src="/assets/proconverter.webp" alt="" loading="lazy" decoding="async" /></div>
          <h2 class="tool-card__title">Converter</h2>
          <p class="tool-card__desc">
            Convert to WebP, JPG, PNG, or AVIF with quality control and resize.
            Batch mode + ZIP download at scale.
          </p>
          <div class="tool-tag">Batch · No limits · 4 formats</div>
          <span class="tool-card__link">Open tool <span class="tool-card__link-arrow">→</span></span>
        </a>

        <a href="/volynx-lab/studio/image-scaler/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
          <div class="tool-card__icon"><img src="/assets/proscaler.webp" alt="" loading="lazy" decoding="async" /></div>
          <h2 class="tool-card__title">Image Scaler</h2>
          <p class="tool-card__desc">
            Upscale to 2×, 3×, or 4× with maximum output resolution.
            No daily limit — local processing for scale production.
          </p>
          <div class="tool-tag">Up to 4× · Unlimited · Local</div>
          <span class="tool-card__link">Open tool <span class="tool-card__link-arrow">→</span></span>
        </a>

        <a href="/volynx-lab/studio/image-suite/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
          <div class="tool-card__icon"><img src="/assets/prosuite.webp" alt="" loading="lazy" decoding="async" /></div>
          <h2 class="tool-card__title">Image Suite</h2>
          <p class="tool-card__desc">
            Upscale, compress, and convert inside a single interface.
            Studio Pro exclusive — no restrictions.
          </p>
          <div class="tool-tag pro-only">Pro exclusive</div>
          <span class="tool-card__link">Open tool <span class="tool-card__link-arrow">→</span></span>
        </a>

        <a href="/volynx-lab/studio/qr-gen/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
          <div class="tool-card__icon"><img src="/assets/proqrgen.webp" alt="" loading="lazy" decoding="async" /></div>
          <h2 class="tool-card__title">QR Generator</h2>
          <p class="tool-card__desc">
            Generate styled QR codes, save history, and export at high resolution.
            Built for campaigns and printed materials.
          </p>
          <div class="tool-tag">High-res · History · Styled</div>
          <span class="tool-card__link">Open tool <span class="tool-card__link-arrow">→</span></span>
        </a>
      </div>
    </section>

    <!-- PRICING STRIP -->
    <section class="price-strip">
      <div class="price-strip__inner">
        <div class="price-strip__left">
          <div class="price-strip__amount">£19<span>/month</span></div>
          <p class="price-strip__desc">All Studio tools. No limits. Commercial rights. Cancel anytime.</p>
        </div>
        <div class="price-strip__right">
          <a class="btn-primary" href="/signup/">Start Studio Pro</a>
          <a class="btn-ghost" href="/login/">Sign in</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section">
      <div class="section-label">FAQ</div>
      <div class="faq-grid">
        <details class="faq-item">
          <summary>Do my files get uploaded to a server?</summary>
          <p>No. All processing happens locally in your browser using WebAssembly. Your files never leave your device.</p>
        </details>
        <details class="faq-item">
          <summary>Can I cancel anytime?</summary>
          <p>Yes. Cancel from your account settings with one click. Access continues until the end of the paid period — no partial refunds.</p>
        </details>
        <details class="faq-item">
          <summary>What's the difference between Lab and Studio?</summary>
          <p>Lab is free with fair-use limits — great for testing. Studio Pro removes all limits, adds batch mode, commercial rights, and exclusive tools like Image Suite.</p>
        </details>
        <details class="faq-item">
          <summary>Is output suitable for client and commercial work?</summary>
          <p>Yes. Studio Pro includes commercial usage rights. Use outputs in client projects, products, and campaigns without restriction.</p>
        </details>
      </div>
    </section>

  </main>

  <SiteFooter />
  <PageWidgets />
</body>
</html>

<style>
  /* Studio-specific additions on top of lab.css */

  .hero__logo {
    display: flex;
    justify-content: center;
    margin-bottom: 32px;
  }

  .hero__logo-img {
    width: min(560px, 80vw);
    height: auto;
    display: block;
    filter: drop-shadow(0 0 40px rgba(109,94,252,.35));
  }

  .studio-badge {
    display: inline-block;
    padding: 5px 14px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    background: rgba(109, 94, 252, .15);
    border: 1px solid rgba(109, 94, 252, .4);
    color: rgba(180, 160, 255, .9);
    margin-bottom: 22px;
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .hero__note {
    font-size: 12px;
    opacity: 0.4;
    margin-top: 12px;
    text-align: center;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 13px 24px;
    border-radius: 12px;
    background: rgba(109, 94, 252, .2);
    border: 1px solid rgba(109, 94, 252, .5);
    color: rgba(200, 185, 255, .95);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn-primary:hover {
    background: rgba(109, 94, 252, .32);
    border-color: rgba(130, 110, 255, .7);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 13px 20px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, .1);
    color: rgba(255, 255, 255, .65);
    font-size: 15px;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn-ghost:hover { border-color: rgba(255, 255, 255, .2); color: rgba(255,255,255,.85); }

  .pill-cta {
    text-decoration: none;
    color: rgba(200, 185, 255, .85);
    padding: 8px 14px;
    border: 1px solid rgba(109, 94, 252, .35);
    border-radius: 999px;
    background: rgba(109, 94, 252, .1);
    font-size: 13px;
    transition: background 0.18s ease;
  }
  .pill-cta:hover { background: rgba(109, 94, 252, .2); }

  /* Why section */
  .why-section {
    margin: 20px 0 60px;
  }
  .why-label, .section-label {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.4;
    margin-bottom: 20px;
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .why-card {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 16px;
    padding: 22px 20px;
    backdrop-filter: blur(10px);
  }
  .why-icon {
    font-size: 22px;
    margin-bottom: 12px;
    opacity: 0.8;
  }
  .why-card h3 {
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 8px;
  }
  .why-card p {
    font-size: 13px;
    opacity: 0.6;
    line-height: 1.6;
    margin: 0;
  }

  /* Tools section */
  .tools-section { margin-bottom: 60px; }

  .tool-tag {
    display: inline-block;
    font-size: 11px;
    opacity: 0.5;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 999px;
    padding: 3px 10px;
    margin: 8px 0 12px;
    letter-spacing: 0.5px;
  }
  .tool-tag.pro-only {
    opacity: 1;
    color: rgba(180, 160, 255, .85);
    border-color: rgba(109, 94, 252, .35);
    background: rgba(109, 94, 252, .1);
  }

  /* Price strip */
  .price-strip {
    background: rgba(109, 94, 252, .08);
    border: 1px solid rgba(109, 94, 252, .2);
    border-radius: 20px;
    padding: 32px 36px;
    margin-bottom: 60px;
  }
  .price-strip__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .price-strip__amount {
    font-size: 42px;
    font-weight: 800;
    line-height: 1;
    color: rgba(200, 185, 255, .9);
  }
  .price-strip__amount span {
    font-size: 18px;
    opacity: 0.5;
    font-weight: 400;
  }
  .price-strip__desc {
    font-size: 14px;
    opacity: 0.55;
    margin: 6px 0 0;
  }
  .price-strip__right { display: flex; gap: 12px; flex-wrap: wrap; }

  /* FAQ */
  .faq-section { margin-bottom: 20px; }
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .faq-item {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 14px;
    padding: 16px 20px;
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 14px;
    list-style: none;
  }
  .faq-item summary::marker, .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: " +";
    opacity: 0.4;
  }
  .faq-item[open] summary::after { content: " −"; }
  .faq-item p {
    font-size: 13px;
    opacity: 0.6;
    line-height: 1.65;
    margin: 12px 0 0;
  }

  @media (max-width: 860px) {
    .why-grid { grid-template-columns: 1fr 1fr; }
    .faq-grid { grid-template-columns: 1fr; }
    .price-strip__inner { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 520px) {
    .why-grid { grid-template-columns: 1fr; }
    .price-strip { padding: 24px 20px; }
    .hero__actions { flex-direction: column; align-items: center; }
  }
</style>
