---
import "../../styles/lab.css";
import LabBg from "../../components/LabBg.astro";
import PageWidgets from "../../components/PageWidgets.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Topbar from "../../components/Topbar.astro";
const pageTitle = "VOLYNX Lab — Free Image Tools";
const pageDescription = "Free browser-based image tools by VOLYNX — convert, upscale and process images locally. No upload, no server required.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/site.webmanifest" />
</head>

<body>
  <LabBg />

  <Topbar rightLinks={[{ href: "/", label: "← Home" }]} />

  <main class="wrap">
    <div class="hero">
      <div class="hero__badge">
        <img src="/assets/goldenlogoofi.webp" alt="VOLYNX Lab" loading="eager" decoding="async" />
      </div>
      <h1 class="hero__title" data-i18n="lab.title">
        Free <span class="hero__title-accent">Image Tools</span>
      </h1>
      <p class="hero__desc" data-i18n="lab.subtitle">
        Browser-based tools that run entirely on your device.
        No uploads, no server, no limits on what you can try.
      </p>
    </div>

    <div class="tools-grid">
      <a href="/volynx-lab/converter/" class="tool-card">
        <img src="/assets/convertericonofi.webp" alt="Converter" loading="lazy" decoding="async" />
        <span class="tool-card__free" data-i18n="lab.free_badge">FREE</span>
        <p class="tool-card__desc" data-i18n="lab.converter.desc">
          Convert images to WebP, JPG, PNG, or AVIF with quality control and resize.
          Batch mode and ZIP download included.
        </p>
        <span class="tool-card__link">
          Open tool
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/volynx-lab/image-scaler/" class="tool-card">
        <img src="/assets/scalericonofi.webp" alt="Image Scaler" loading="lazy" decoding="async" />
        <span class="tool-card__free" data-i18n="lab.free_badge">FREE</span>
        <p class="tool-card__desc" data-i18n="lab.scaler.desc">
          High-quality upscaling with detail preservation and artifact reduction.
          100% local processing. 2×, 3×, and 4× modes.
        </p>
        <span class="tool-card__link">
          Open tool
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/volynx-lab/image-suite/" class="tool-card">
        <img src="/assets/suiteiconofi.webp" alt="Image Suite" loading="lazy" decoding="async" />
        <span class="tool-card__free" data-i18n="lab.free_badge">FREE</span>
        <p class="tool-card__desc" data-i18n="lab.suite.desc">
          Upscale, compress, and convert inside a single interface.
          Daily limit on free tier — upgrade to Studio Pro to unlock.
        </p>
        <span class="tool-card__link">
          Open tool
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/volynx-lab/qr-gen/" class="tool-card">
        <img src="/assets/qrgeniconofi.webp" alt="QR Generator" loading="lazy" decoding="async" />
        <span class="tool-card__free" data-i18n="lab.free_badge">FREE</span>
        <p class="tool-card__desc" data-i18n="lab.qr.desc">
          Generate styled QR codes and campaign-ready links.
          Export in multiple sizes, free of charge.
        </p>
        <span class="tool-card__link">
          Open tool
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/volynx-lab/studio/" class="tool-card" style="border-color:rgba(109,94,252,.3)">
        <img src="/assets/studioiconofi.webp" alt="VOLYNX Studio" loading="lazy" decoding="async" />
        <span class="tool-card__free pro">Studio Pro</span>
        <p class="tool-card__desc" data-i18n="lab.studio.desc">
          No limits. Batch processing. Commercial rights.
          The full suite for production workflows — £19/month.
        </p>
        <span class="tool-card__link" style="color:rgba(180,160,255,.85)">
          Explore Studio
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </main>

  <SiteFooter />
  <PageWidgets />
</body>
</html>

<style>
  .tool-card__free.pro {
    color: rgba(180, 160, 255, .9);
    background: rgba(109, 94, 252, .12);
    border: 2px solid rgba(109, 94, 252, .4);
  }
</style>
