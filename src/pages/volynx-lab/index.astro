---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import LabToolShell from "../../components/LabToolShell.astro";
import { ROUTES } from "../../data/routes";
---
<FlagshipLayout title="VOLYNX Lab — Free Image Tools" description="Free browser-based image tools by VOLYNX — convert, upscale and process images locally." pageClass="page-lab">
  <FlagshipHeader current={ROUTES.lab} ctaLabel="Unlock Studio Pro" />
  <main>
    <LabToolShell active="home" />

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="kicker" data-i18n="lab2.kicker">Local-first tools</span>
          <h1 data-i18n="lab2.hero_title">One premium workspace for image, knowledge and QR production.</h1>
          <p data-i18n="lab2.hero_subtitle">Converter, Image Scaler, Image Suite, Lumina and QRGen now share a cleaner workflow: use the tool, keep the preset, return from profile, and upgrade only when the limit is real.</p>
          <div class="hero-actions">
            <a href="#tools" class="button button--gold" data-i18n="lab2.btn_browse_tools">Browse tools</a>
            <a href={ROUTES.labImageSuite} class="button button--ghost" data-i18n="lab2.btn_see_pro">Open Image Suite</a>
          </div>
        </div>
        <div class="hero-visual hero-visual--float">
          <img src="/assets/labicon.webp" alt="VOLYNX Lab" class="hero-float-icon" />
        </div>
      </div>
    </section>

    <section class="page-section lab-flow-section" aria-label="Lab workflow">
      <div class="shell lab-flow">
        <div class="lab-flow__copy">
          <span class="kicker">Workspace memory</span>
          <h2>Work should survive the login wall.</h2>
          <p>Every key Lab action now records recent activity and presets locally for the profile. Login-required states return to the exact tool instead of dumping the user into pricing.</p>
        </div>
        <div class="lab-flow__steps">
          <div><strong>1</strong><span>Choose a tool</span></div>
          <div><strong>2</strong><span>Upload or write</span></div>
          <div><strong>3</strong><span>Export cleanly</span></div>
          <div><strong>4</strong><span>Resume in profile</span></div>
        </div>
      </div>
    </section>

    <!-- ═══ FREE TOOLS ═══ -->
    <section id="tools" class="page-section">
      <div class="shell section-head">
        <h2 data-i18n="lab2.section_tools_title">Free tools that build trust</h2>
        <p data-i18n="lab2.section_tools_desc">Each free tool gets real use value, while the Pro state adds power and comfort instead of simply locking everything behind a wall.</p>
      </div>
      <div class="shell tool-grid">
        <article class="panel tool-card tool-card--converter">
          <div class="tool-icon"><img src="/assets/converterbig.webp" alt="" /></div>
          <div class="head-row">
            <div><span class="label label--free" data-i18n="lab2.tool_converter_label">Free</span><h3 data-i18n="lab2.tool_converter_title">Converter</h3></div>
            <a href={ROUTES.labConverter} class="button button--ghost" data-i18n="lab2.tool_converter_btn">Open</a>
          </div>
          <p data-i18n="lab2.tool_converter_desc">Convert images to WebP, JPG, PNG or AVIF with clean defaults.</p>
          <div class="mini-stats"><span class="chip">Free</span><span class="chip">Local</span><span class="chip">ZIP</span><span class="chip" data-i18n="lab2.tool_converter_chip2">Basic presets</span></div>
        </article>
        <article class="panel tool-card tool-card--scaler">
          <div class="tool-icon"><img src="/assets/newimagescaler.webp" alt="" /></div>
          <div class="head-row">
            <div><span class="label label--free" data-i18n="lab2.tool_scaler_label">Free</span><h3 data-i18n="lab2.tool_scaler_title">Image Scaler</h3></div>
            <a href={ROUTES.labImageScaler} class="button button--ghost" data-i18n="lab2.tool_scaler_btn">Open</a>
          </div>
          <p data-i18n="lab2.tool_scaler_desc">Upscale with clearer controls and a stronger before/after experience in Pro.</p>
          <div class="mini-stats"><span class="chip">Free</span><span class="chip">Local</span><span class="chip" data-i18n="lab2.tool_scaler_chip1">2x / 3x base modes</span><span class="chip" data-i18n="lab2.tool_scaler_chip2">Preview-first</span></div>
        </article>
        <article class="panel tool-card panel--pro tool-card--suite">
          <div class="tool-icon"><img src="/assets/newimagesuite.webp" alt="" /></div>
          <div class="head-row">
            <div><span class="label label--pro" data-i18n="lab2.tool_suite_label">Free + Pro</span><h3 data-i18n="lab2.tool_suite_title">Image Suite</h3></div>
            <a href={ROUTES.studioImageSuite} class="button button--gold" data-i18n="lab2.tool_suite_btn">Open Suite</a>
          </div>
          <p data-i18n="lab2.tool_suite_desc">Upscale, compress, convert and remove backgrounds with saved presets and clear plan states.</p>
          <div class="mini-stats"><span class="chip">Free</span><span class="chip">Pro</span><span class="chip">Local AI</span><span class="chip" data-i18n="lab2.tool_suite_chip2">Profile presets</span></div>
        </article>
        <article class="panel tool-card tool-card--lumina">
          <div class="tool-icon"><img src="/assets/education.webp" alt="" /></div>
          <div class="head-row">
            <div><span class="label label--free">Free + Pro</span><h3>Volynx Lumina</h3></div>
            <a href={ROUTES.labLumina} class="button button--ghost">Open</a>
          </div>
          <p>Transform complex scientific, technical and educational content into clear, human and multilingual explanations.</p>
          <div class="mini-stats"><span class="chip">Free</span><span class="chip">AI</span><span class="chip">Local fallback</span><span class="chip">Export</span></div>
        </article>
        <article class="panel tool-card tool-card--qrgen">
          <div class="tool-icon"><img src="/assets/newqrgen.webp" alt="" /></div>
          <div class="head-row">
            <div><span class="label label--free" data-i18n="lab2.tool_qr_label">Free</span><h3 data-i18n="lab2.tool_qr_title">QR Generator</h3></div>
            <a href={ROUTES.labQrGen} class="button button--ghost" data-i18n="lab2.tool_qr_btn">Open</a>
          </div>
          <p data-i18n="lab2.tool_qr_desc">Campaign-ready codes with stronger brand control and export packs for Pro.</p>
          <div class="mini-stats"><span class="chip">Free</span><span class="chip">Launch</span><span class="chip">Pro</span><span class="chip">Projects</span></div>
        </article>
      </div>
    </section>

    <!-- ═══ STUDIO PRO CALLOUT ═══ -->
    <section id="studio" class="page-section page-section--last">
      <div class="shell callout callout--split panel panel--pro">
        <div>
          <span class="studio-badge" data-i18n="lab2.cta_label"><img src="/assets/volynxstudio.webp" alt="" />Studio Pro</span>
          <strong data-i18n="lab2.cta_tagline">Build faster. Export better. Operate like a studio.</strong>
          <p data-i18n="lab2.cta_desc">Pro unlocks batch workflows, saved presets, premium export modes and priority features. Work faster with tools built for serious production.</p>
          <a href={ROUTES.studio} class="button button--gold studio-cta" data-i18n="lab2.cta_btn">Open Studio</a>
        </div>
        <div class="stats-row">
          <div class="stat-block stat-block--queue">
            <div class="stat-icon-wrap" aria-hidden="true">
              <img src="/assets/queue.webp" alt="" class="stat-icon stat-icon--queue" />
            </div>
            <b data-i18n="lab2.stat_queue_title">Queue</b>
            <span data-i18n="lab2.stat_queue_desc">Batch workflows with less manual friction.</span>
          </div>
          <div class="stat-block stat-block--memory">
            <div class="stat-icon-wrap" aria-hidden="true">
              <img src="/assets/memory.webp" alt="" class="stat-icon stat-icon--memory" />
            </div>
            <b data-i18n="lab2.stat_memory_title">Memory</b>
            <span data-i18n="lab2.stat_memory_desc">Saved presets, history and brand defaults.</span>
          </div>
          <div class="stat-block stat-block--quality">
            <div class="stat-icon-wrap" aria-hidden="true">
              <img src="/assets/quality.webp" alt="" class="stat-icon stat-icon--quality" />
            </div>
            <b data-i18n="lab2.stat_quality_title">Quality</b>
            <span data-i18n="lab2.stat_quality_desc">Premium export modes and stronger control.</span>
          </div>
          <div class="stat-block stat-block--status">
            <div class="stat-icon-wrap" aria-hidden="true">
              <img src="/assets/status.webp" alt="" class="stat-icon stat-icon--status" />
            </div>
            <b data-i18n="lab2.stat_status_title">Status</b>
            <span data-i18n="lab2.stat_status_desc">Cleaner workspace and earlier access.</span>
          </div>
        </div>
      </div>
    </section>

  </main>
  <script is:inline src="/scripts/vx-lab-workspace.js?v=20260603-lab-workspace"></script>
  <FlagshipFooter />
</FlagshipLayout>

<style is:global>
  .page-lab .lab-flow-section {
    padding-top: 12px;
  }
  .page-lab .lab-flow {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    align-items: stretch;
    gap: 18px;
    padding: 22px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 8px;
    background:
      radial-gradient(circle at top left, rgba(125,249,255,.12), transparent 42%),
      linear-gradient(135deg, rgba(255,255,255,.06), rgba(255,255,255,.025));
    box-shadow: 0 24px 80px rgba(0,0,0,.24);
  }
  .page-lab .lab-flow__copy h2 {
    margin: 6px 0 8px;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1;
    letter-spacing: 0;
  }
  .page-lab .lab-flow__copy p {
    margin: 0;
    min-height: 0;
    color: rgba(255,255,255,.66);
    line-height: 1.6;
  }
  .page-lab .lab-flow__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  .page-lab .lab-flow__steps div {
    min-height: 132px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    padding: 16px;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 8px;
    background: rgba(255,255,255,.045);
  }
  .page-lab .lab-flow__steps strong {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(125,249,255,.18), rgba(214,168,79,.14));
    color: #fff;
    font-size: 14px;
  }
  .page-lab .lab-flow__steps span {
    color: rgba(255,255,255,.82);
    font-size: 13px;
    font-weight: 900;
    line-height: 1.25;
  }
  .page-lab .tool-grid {
    align-items: stretch;
  }
  .page-lab .tool-card {
    height: 100%;
    transition: transform .22s ease, filter .22s ease, background .22s ease, border-color .22s ease;
    will-change: transform, filter;
  }
  .page-lab .tool-card--qrgen { order: 1; }
  .page-lab .tool-card--lumina { order: 2; }
  .page-lab .tool-card--suite { order: 3; }
  .page-lab .tool-card--converter { order: 4; }
  .page-lab .tool-card--scaler { order: 5; }
  .page-lab .tool-card--qrgen,
  .page-lab .tool-card--lumina {
    border-color: rgba(125,249,255,.18);
    background:
      linear-gradient(135deg, rgba(125,249,255,.08), rgba(214,168,79,.05)),
      rgba(255,255,255,.035);
  }
  .page-lab .tool-card:hover,
  .page-lab .tool-card:focus-within {
    filter: drop-shadow(0px 0px 46px white);
    transform: translateY(-10px);
    background: linear-gradient(175deg, black, cadetblue);
  }
  .page-lab .tool-card .head-row {
    min-height: 92px;
  }
  .page-lab .tool-card .head-row > div {
    flex: 1 1 auto;
    min-width: 0;
  }
  .page-lab .tool-card p {
    margin: 0;
    min-height: 5.5rem;
  }
  .page-lab .tool-card .mini-stats {
    margin-top: auto;
  }
  .page-lab .tool-icon {
    display: grid;
    place-items: end center;
    width: 100%;
    min-height: clamp(240px, 26vw, 320px);
    margin-bottom: 10px;
    background: none;
    border: none;
    border-radius: 12px;
  }
  .page-lab .tool-icon img {
    width: min(100%, 420px);
    max-height: clamp(220px, 24vw, 300px);
    height: 100%;
    object-fit: contain;
    border-radius: 12px;
    filter: drop-shadow(0 0 7px);
    display: block;
  }
  .page-lab .tool-card--suite .tool-icon img {
    width: min(100%, 452px);
    max-height: clamp(232px, 25vw, 312px);
  }
  .page-lab .studio-badge img {
    width: 16px;
    height: 16px;
    object-fit: contain;
    display: block;
    flex: 0 0 auto;
  }
  .page-lab .stats-row {
    align-items: stretch;
  }
  .page-lab .stat-block {
    --stat-glow: rgba(132, 201, 255, .18);
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 100%;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03)),
      radial-gradient(circle at top, var(--stat-glow), transparent 68%);
    transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
  }
  .page-lab .stat-block--queue {
    --stat-glow: rgba(92, 204, 255, .18);
  }
  .page-lab .stat-block--memory {
    --stat-glow: rgba(106, 164, 255, .16);
  }
  .page-lab .stat-block--quality {
    --stat-glow: rgba(196, 109, 255, .14);
  }
  .page-lab .stat-block--status {
    --stat-glow: rgba(105, 255, 209, .14);
  }
  .page-lab .stat-icon-wrap {
    position: relative;
    display: grid;
    place-items: end center;
    min-height: clamp(190px, 19vw, 242px);
    margin: -4px -2px 2px;
    padding: 10px 8px 30px;
    border-radius: 22px;
    background:
      radial-gradient(circle at 50% 22%, rgba(255,255,255,.12), transparent 34%),
      linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
    border: 1px solid rgba(255,255,255,.08);
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
  }
  .page-lab .stat-icon-wrap::before {
    content: "";
    position: absolute;
    inset: auto 10% 4% 10%;
    height: 26%;
    border-radius: 999px;
    background: radial-gradient(circle, var(--stat-glow), transparent 72%);
    filter: blur(16px);
    opacity: .95;
    pointer-events: none;
    transition: opacity 0.22s ease, filter 0.22s ease, transform 0.22s ease;
  }
  .page-lab .stat-icon {
    width: min(100%, 244px);
    max-height: clamp(178px, 18vw, 228px);
    object-fit: contain;
    object-position: center bottom;
    display: block;
    position: relative;
    z-index: 1;
    filter:
      drop-shadow(0 20px 28px rgba(0, 0, 0, .28))
      drop-shadow(0 0 18px rgba(255, 255, 255, .08));
    transition: filter 0.22s ease;
  }
  .page-lab .stat-block:hover {
    transform: translateY(-4px);
    box-shadow:
      0 18px 40px rgba(0, 0, 0, .22),
      0 0 24px rgba(130, 220, 255, .06);
    background:
      linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.04)),
      radial-gradient(circle at top, var(--stat-glow), transparent 72%);
  }
  .page-lab .stat-block:hover .stat-icon-wrap {
    transform: translateY(-2px);
    border-color: rgba(130,220,255,.18);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.07),
      0 16px 30px rgba(0, 0, 0, .18);
    background:
      radial-gradient(circle at 50% 22%, rgba(255,255,255,.15), transparent 36%),
      linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.03));
  }
  .page-lab .stat-block:hover .stat-icon-wrap::before {
    filter: blur(20px);
    transform: scale(1.05);
  }
  .page-lab .stat-block:hover .stat-icon {
    filter:
      drop-shadow(0 22px 30px rgba(0, 0, 0, .3))
      drop-shadow(0 0 22px rgba(255, 255, 255, .11));
  }
  .page-lab .stat-icon--queue {
    width: min(100%, 246px);
    transform: translateY(10px) scale(1.03);
  }
  .page-lab .stat-icon--memory {
    width: min(100%, 226px);
    transform: translateY(8px) scale(1.01);
  }
  .page-lab .stat-icon--quality {
    width: min(100%, 232px);
    transform: translateY(12px) scale(1.06);
  }
  .page-lab .stat-icon--status {
    width: min(100%, 228px);
    transform: translateY(12px) scale(1.07);
  }
  .page-lab .stat-block b,
  .page-lab .stat-block span {
    position: relative;
    z-index: 1;
  }
  @media (max-width: 900px) {
    .page-lab .lab-flow {
      grid-template-columns: 1fr;
    }
    .page-lab .lab-flow__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .page-lab .tool-icon {
      min-height: clamp(220px, 54vw, 300px);
    }
    .page-lab .tool-icon img {
      width: min(100%, 400px);
      max-height: clamp(205px, 50vw, 280px);
    }
    .page-lab .tool-card--suite .tool-icon img {
      width: min(100%, 428px);
      max-height: clamp(216px, 52vw, 292px);
    }
    .page-lab .stat-icon-wrap {
      min-height: clamp(178px, 52vw, 228px);
      padding: 10px 10px 30px;
    }
    .page-lab .stat-icon {
      max-height: clamp(166px, 46vw, 216px);
    }
    .page-lab .stat-icon--queue {
      width: min(100%, 238px);
      transform: translateY(8px) scale(1.02);
    }
    .page-lab .stat-icon--memory {
      width: min(100%, 214px);
      transform: translateY(8px);
    }
    .page-lab .stat-icon--quality {
      width: min(100%, 222px);
      transform: translateY(10px) scale(1.05);
    }
    .page-lab .stat-icon--status {
      width: min(100%, 220px);
      transform: translateY(10px) scale(1.06);
    }
  }
  @media (max-width: 560px) {
    .page-lab .lab-flow__steps {
      grid-template-columns: 1fr;
    }
    .page-lab .lab-flow__steps div {
      min-height: 92px;
    }
  }
</style>
