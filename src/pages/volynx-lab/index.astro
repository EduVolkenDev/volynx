---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";
---
<FlagshipLayout title="VOLYNX Lab — Free Image Tools" description="Free browser-based image tools by VOLYNX — convert, upscale and process images locally." pageClass="page-lab">
  <FlagshipHeader current={ROUTES.lab} ctaLabel="Unlock Studio Pro" />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="kicker">Local-first tools</span>
          <h1>Free tools for discovery. A Pro pipeline for real work.</h1>
          <p>The Lab feels generous and clean. Studio Pro is an upgrade in operating quality: more comfort, more memory, better output and stronger workflow confidence.</p>
          <div class="hero-actions">
            <a href="#tools" class="button button--gold">Browse tools</a>
            <a href="#studio" class="button button--ghost">See Pro benefits</a>
          </div>
        </div>
        <div class="hero-card visual-card">
          <span class="label label--free">Runs in the browser</span>
          <img src="/assets/volynx-icon.webp" alt="Lab" />
          <div class="chip-row">
            <span class="chip">No upload logic where possible</span>
            <span class="chip">Fast discovery</span>
            <span class="chip">Clear upgrade path</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ FREE TOOLS ═══ -->
    <section id="tools" class="page-section">
      <div class="shell section-head">
        <h2>Free tools that build trust</h2>
        <p>Each free tool gets real use value, while the Pro state adds power and comfort instead of simply locking everything behind a wall.</p>
      </div>
      <div class="shell tool-grid">
        <article class="panel tool-card">
          <div class="head-row">
            <div><span class="label label--free">Free</span><h3>Converter</h3></div>
            <a href={ROUTES.studioConverter} class="button button--ghost">Open</a>
          </div>
          <p>Convert images to WebP, JPG, PNG or AVIF with clean defaults.</p>
          <div class="mini-stats"><span class="chip">Single or small batch</span><span class="chip">Basic presets</span></div>
        </article>
        <article class="panel tool-card">
          <div class="head-row">
            <div><span class="label label--free">Free</span><h3>Image Scaler</h3></div>
            <a href={ROUTES.studioImageScaler} class="button button--ghost">Open</a>
          </div>
          <p>Upscale with clearer controls and a stronger before/after experience in Pro.</p>
          <div class="mini-stats"><span class="chip">2x / 3x base modes</span><span class="chip">Preview-first</span></div>
        </article>
        <article class="panel tool-card panel--pro">
          <div class="head-row">
            <div><span class="label label--pro">Pro</span><h3>Image Suite</h3></div>
            <a href={ROUTES.studioImageSuite} class="button button--gold">See Pro tool</a>
          </div>
          <p>The place where the premium workspace should feel unmistakably better.</p>
          <div class="mini-stats"><span class="chip">Multi-step recipe</span><span class="chip">Save presets</span></div>
        </article>
        <article class="panel tool-card">
          <div class="head-row">
            <div><span class="label label--free">Free</span><h3>QR Generator</h3></div>
            <a href={ROUTES.studioQrGen} class="button button--ghost">Open</a>
          </div>
          <p>Campaign-ready codes with stronger brand control and export packs for Pro.</p>
          <div class="mini-stats"><span class="chip">Custom colors</span><span class="chip">Logo embed</span></div>
        </article>
      </div>
    </section>

    <!-- ═══ STUDIO PRO CALLOUT ═══ -->
    <section id="studio" class="page-section page-section--last">
      <div class="shell callout callout--split panel panel--pro">
        <div>
          <span class="label label--pro">Studio Pro</span>
          <strong>Build faster. Export better. Operate like a studio.</strong>
          <p>V3 turns the Pro pitch into a flagship block instead of a small upsell card.</p>
        </div>
        <div class="stats-row">
          <div class="stat-block"><b>Queue</b><span>Batch workflows with less manual friction.</span></div>
          <div class="stat-block"><b>Memory</b><span>Saved presets, history and brand defaults.</span></div>
          <div class="stat-block"><b>Quality</b><span>Premium export modes and stronger control.</span></div>
          <div class="stat-block"><b>Status</b><span>Cleaner workspace and earlier access.</span></div>
        </div>
      </div>
    </section>

  </main>
  <FlagshipFooter />
</FlagshipLayout>
