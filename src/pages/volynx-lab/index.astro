---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import LabToolShell from "../../components/LabToolShell.astro";
import { ROUTES } from "../../data/routes";

const toolCards = [
  {
    id: "qrgen",
    i18n: "qrgen",
    title: "QRGen",
    label: "Benchmark",
    href: ROUTES.labQrGen,
    cta: "Open QRGen",
    image: "/assets/newqrgen.webp",
    description: "Brand-ready QR projects with strong preview, export paths and campaign structure.",
    promise: "Best first paid signal for the Lab: projects, exports, brand control and recovery.",
    states: ["Free start", "Pro exports", "Projects", "Profile recovery"],
    details: [
      ["Free", "Create and test QR campaigns"],
      ["Pro", "Premium export packs and saved project depth"],
      ["VX", "Ready for token actions when dynamic campaigns are wired"],
      ["Local", "Preview and design controls run immediately"],
    ],
  },
  {
    id: "lumina",
    i18n: "lumina",
    title: "Lumina",
    label: "AI + Local",
    href: ROUTES.labLumina,
    cta: "Open Lumina",
    image: "/assets/lumina-icon-transparent.webp",
    description: "Turn complex scientific, technical and educational content into clear explanations.",
    promise: "The knowledge product: AI when available, local fallback when not, history and export.",
    states: ["Free quota", "AI", "Local fallback", "Export"],
    details: [
      ["Free", "Daily starter usage with useful local fallback"],
      ["Pro", "Higher capacity and deeper knowledge workflows"],
      ["VX", "No token spend unless a specific AI action is wired"],
      ["Local", "Fallback answer, history and TXT export stay usable"],
    ],
  },
  {
    id: "image-suite",
    i18n: "suite",
    title: "iMage Suite",
    label: "Studio Pro",
    href: ROUTES.labImageSuite,
    cta: "Open Suite",
    image: "/assets/newimagesuite.webp",
    description: "Upscale, compress, convert and remove backgrounds with reusable recipes.",
    promise: "Production surface for creators and operators who process assets repeatedly.",
    states: ["Free tools", "Pro BG remove", "Recipes", "Batch-ready"],
    details: [
      ["Free", "Compress, convert and resize browser-side"],
      ["Pro", "Background removal, higher limits and richer exports"],
      ["VX", "Reserved for paid compute actions, not basic local work"],
      ["Local", "Most image work stays in this browser"],
    ],
  },
  {
    id: "converter",
    i18n: "converter",
    title: "Converter",
    label: "Local Utility",
    href: ROUTES.labConverter,
    cta: "Open Converter",
    image: "/assets/converterbig.webp",
    description: "Fast WebP, JPG, PNG and AVIF conversion with quality and width presets.",
    promise: "The trust builder: simple, fast, useful, with ZIP export and saved format recipes.",
    states: ["Free", "Local", "ZIP", "Presets"],
    details: [
      ["Free", "Convert real files without account friction"],
      ["Pro", "Natural path when volume and batch needs grow"],
      ["VX", "No VX spend for basic conversion"],
      ["Local", "Files are processed in the browser"],
    ],
  },
  {
    id: "image-scaler",
    i18n: "scaler",
    title: "Image Scaler",
    label: "Preview-first",
    href: ROUTES.labImageScaler,
    cta: "Open Scaler",
    image: "/assets/newimagescaler.webp",
    description: "Upscale assets with clear scale controls, smoothing and saved scale presets.",
    promise: "A focused before/after workflow that should feel safe for non-technical users.",
    states: ["Free", "Local", "Preview", "Pro capacity"],
    details: [
      ["Free", "2x/3x/4x local scale modes"],
      ["Pro", "Higher limits and advanced processing path"],
      ["VX", "Only when compute-backed upscale is explicitly connected"],
      ["Local", "Current scaling stays browser-side"],
    ],
  },
];

const workflowSteps = [
  ["1", "Start with QRGen", "Create a campaign asset people can inspect immediately."],
  ["2", "Use Lumina for clarity", "Turn technical material into copy, briefs or explainers."],
  ["3", "Polish assets", "Run iMage Suite, Converter or Scaler depending on the job."],
  ["4", "Resume from profile", "History and presets bring the user back to the exact context."],
];

const memorySteps = [
  ["1", "Select", "Choose a tool", "Your current route and task stay attached to the session.", "/assets/chooseatool.webp"],
  ["2", "Create", "Upload or write", "Files, prompts and useful presets remain close to the work.", "/assets/uploadorwrite.webp"],
  ["3", "Deliver", "Export cleanly", "Finish the action with a clear output and recovery path.", "/assets/exportcleanly.webp"],
  ["4", "Continue", "Resume in profile", "Return to the exact workspace instead of starting again.", "/assets/resumeinprofile.webp"],
];
---
<FlagshipLayout title="VOLYNX Lab — Free Image Tools" description="Free browser-based image tools by VOLYNX — convert, upscale and process images locally." pageClass="page-lab">
  <FlagshipHeader current={ROUTES.lab} ctaLabel="Unlock Studio Pro" ctaI18n="lab2.header_cta" />
  <main>
    <LabToolShell active="home" />

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="kicker" data-i18n="lab2.kicker">Local-first tools</span>
          <h1 data-i18n="lab2.hero_title">One premium workspace for image, knowledge and QR production.</h1>
          <p data-i18n="lab2.hero_subtitle">Converter, Image Scaler, iMage Suite, Lumina and QRGen now share a cleaner workflow: use the tool, keep the preset, return from profile, and upgrade only when the limit is real.</p>
          <div class="hero-actions">
            <a href="#tools" class="button button--gold" data-i18n="lab2.btn_browse_tools">Browse tools</a>
            <a href={ROUTES.labImageSuite} class="button button--ghost" data-i18n="lab2.btn_see_pro">Open iMage Suite</a>
          </div>
        </div>
        <div class="hero-visual hero-visual--float">
          <img src="/assets/labicon.webp" alt="VOLYNX Lab" class="hero-float-icon" />
        </div>
      </div>
    </section>

    <section class="page-section lab-flow-section" aria-label="Lab workflow">
      <div class="shell lab-flow">
        <div class="lab-flow__copy">
          <span class="kicker" data-i18n="lab2.memory_kicker">Workspace memory</span>
          <h2 data-i18n="lab2.memory_title">Work should survive the login wall.</h2>
          <p data-i18n="lab2.memory_desc">Every key Lab action now records recent activity and presets locally for the profile. Login-required states return to the exact tool instead of dumping the user into pricing.</p>
        </div>
        <div class="lab-flow__steps">
          {memorySteps.map(([number, state, title, copy, iconSrc]) => (
            <article>
              <div class="lab-flow__step-top">
                <strong>{number}</strong>
                <em data-i18n={`lab2.memory_step${number}_state`}>{state}</em>
              </div>
              <div class="lab-flow__step-art" aria-hidden="true">
                <img src={iconSrc} alt="" loading="lazy" decoding="async" />
              </div>
              <div class="lab-flow__step-copy">
                <span data-i18n={`lab2.memory_step${number}_title`}>{title}</span>
                <p data-i18n={`lab2.memory_step${number}_desc`}>{copy}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ LAB VITRINE ═══ -->
    <section id="tools" class="page-section">
      <div class="shell section-head">
        <span class="kicker" data-i18n="lab2.stack_kicker">Premium Lab stack</span>
        <h2 data-i18n="lab2.stack_title">Free should feel useful. Pro should feel obvious.</h2>
        <p data-i18n="lab2.stack_desc">Each tool now explains its contract before the user hits a wall: what runs free, what becomes Pro, what can use VX later, and what stays local in the browser.</p>
      </div>
      <div class="shell tool-grid">
        {toolCards.map((tool) => (
          <article class:list={["panel", "tool-card", `tool-card--${tool.id}`]}>
            <div class="tool-card__media">
              <span data-i18n={`lab2.tool_${tool.i18n}_label`}>{tool.label}</span>
              <div class="tool-icon"><img src={tool.image} alt="" loading="lazy" /></div>
            </div>
            <div class="head-row">
              <div>
                <span class="label label--free" data-i18n={`lab2.tool_${tool.i18n}_label`}>{tool.label}</span>
                <h3>{tool.title}</h3>
              </div>
              <a href={tool.href} class:list={["button", tool.id === "qrgen" || tool.id === "image-suite" ? "button--gold" : "button--ghost"]} data-i18n={`lab2.tool_${tool.i18n}_btn`}>{tool.cta}</a>
            </div>
            <p data-i18n={`lab2.tool_${tool.i18n}_desc`}>{tool.description}</p>
            <strong class="tool-card__promise" data-i18n={`lab2.tool_${tool.i18n}_promise`}>{tool.promise}</strong>
            <div class="mini-stats" aria-label={`${tool.title} access states`}>
              {tool.states.map((state, index) => <span class="chip" data-i18n={`lab2.tool_${tool.i18n}_state${index + 1}`}>{state}</span>)}
            </div>
            <dl class="tool-card__matrix">
              {tool.details.map(([label, text], index) => (
                <div>
                  <dt data-i18n={`lab2.detail_${label.toLowerCase()}`}>{label}</dt>
                  <dd data-i18n={`lab2.tool_${tool.i18n}_detail${index + 1}`}>{text}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </section>

    <section class="page-section lab-workflow-section" aria-label="Recommended Lab workflow">
      <div class="shell lab-workflow">
        <div class="lab-workflow__head">
          <span class="kicker" data-i18n="lab2.workflow_kicker">Recommended workflow</span>
          <h2 data-i18n="lab2.workflow_title">Lead with the tool people can understand fastest.</h2>
          <p data-i18n="lab2.workflow_desc">QRGen is the commercial benchmark, Lumina adds intellectual value, and the image tools make the workspace practical for daily production.</p>
        </div>
        <div class="lab-workflow__grid">
          {workflowSteps.map(([number, title, copy]) => (
            <div>
              <strong>{number}</strong>
              <span data-i18n={`lab2.workflow_step${number}_title`}>{title}</span>
              <p data-i18n={`lab2.workflow_step${number}_desc`}>{copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ STUDIO PRO CALLOUT ═══ -->
    <section id="studio" class="page-section page-section--last">
      <div class="shell callout callout--split panel panel--pro">
        <div>
          <span class="studio-badge" data-i18n="lab2.cta_label"><img src="/assets/volynxstudio.webp" alt="" />Studio Pro</span>
          <strong data-i18n="lab2.cta_tagline">Build faster. Export better. Operate like a studio.</strong>
          <p data-i18n="lab2.cta_desc">Pro unlocks batch workflows, saved presets, premium export modes and priority features. Work faster with tools built for serious production.</p>
          <a href={ROUTES.studio} class="button button--gold studio-cta" data-i18n="lab2.cta_btn">Open Studio</a>
        </div>
        <div class="stats-row">
          <div class="stat-block stat-block--queue">
            <div class="stat-icon-wrap" aria-hidden="true">
              <img src="/assets/queue.webp" alt="" class="stat-icon stat-icon--queue" />
            </div>
            <b data-i18n="lab2.stat_queue_title">Queue</b>
            <span data-i18n="lab2.stat_queue_desc">Batch workflows with less manual friction.</span>
          </div>
          <div class="stat-block stat-block--memory">
            <div class="stat-icon-wrap" aria-hidden="true">
              <img src="/assets/memory.webp" alt="" class="stat-icon stat-icon--memory" />
            </div>
            <b data-i18n="lab2.stat_memory_title">Memory</b>
            <span data-i18n="lab2.stat_memory_desc">Saved presets, history and brand defaults.</span>
          </div>
          <div class="stat-block stat-block--quality">
            <div class="stat-icon-wrap" aria-hidden="true">
              <img src="/assets/quality.webp" alt="" class="stat-icon stat-icon--quality" />
            </div>
            <b data-i18n="lab2.stat_quality_title">Quality</b>
            <span data-i18n="lab2.stat_quality_desc">Premium export modes and stronger control.</span>
          </div>
          <div class="stat-block stat-block--status">
            <div class="stat-icon-wrap" aria-hidden="true">
              <img src="/assets/status.webp" alt="" class="stat-icon stat-icon--status" />
            </div>
            <b data-i18n="lab2.stat_status_title">Status</b>
            <span data-i18n="lab2.stat_status_desc">Cleaner workspace and earlier access.</span>
          </div>
        </div>
      </div>
    </section>

  </main>
  <script is:inline src="/js/vx-auth-bridge.js"></script>
  <script is:inline src="/scripts/vx-lab-workspace.js?v=20260604-lab-cloud"></script>
  <FlagshipFooter />
</FlagshipLayout>

<style is:global>
  .page-lab .lab-flow-section {
    padding-top: 12px;
  }
  .page-lab .lab-flow {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    align-items: stretch;
    gap: 18px;
    padding: 22px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 8px;
    background:
      radial-gradient(circle at top left, rgba(125,249,255,.12), transparent 42%),
      linear-gradient(135deg, rgba(255,255,255,.06), rgba(255,255,255,.025));
    box-shadow: 0 24px 80px rgba(0,0,0,.24);
  }
  .page-lab .lab-flow__copy h2 {
    margin: 6px 0 8px;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1;
    letter-spacing: 0;
  }
  .page-lab .lab-flow__copy p {
    margin: 0;
    min-height: 0;
    color: rgba(255,255,255,.66);
    line-height: 1.6;
  }
  .page-lab .lab-flow__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  .page-lab .lab-flow__steps article {
    min-height: 222px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    padding: 16px;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.025)),
      rgba(255,255,255,.025);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.04);
  }
  .page-lab .lab-flow__step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .page-lab .lab-flow__steps strong {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(125,249,255,.18), rgba(214,168,79,.14));
    color: #fff;
    font-size: 14px;
  }
  .page-lab .lab-flow__steps em {
    color: rgba(125,249,255,.72);
    font-size: 9px;
    font-style: normal;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .page-lab .lab-flow__step-copy {
    display: grid;
    gap: 8px;
  }
  .page-lab .lab-flow__step-art {
    min-height: 78px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background:
      radial-gradient(circle at 50% 42%, rgba(125,249,255,.14), transparent 58%),
      rgba(255,255,255,.025);
    overflow: hidden;
  }
  .page-lab .lab-flow__step-art img {
    width: min(100%, 165px);
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 18px 28px rgba(0,0,0,.34));
  }
  .page-lab .lab-flow__steps span {
    color: rgba(255,255,255,.82);
    font-size: 14px;
    font-weight: 900;
    line-height: 1.25;
  }
  .page-lab .lab-flow__steps p {
    margin: 0;
    color: rgba(255,255,255,.5);
    font-size: 11px;
    line-height: 1.5;
  }
  .page-lab .tool-grid {
    align-items: stretch;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .page-lab .tool-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow: hidden;
    transition: transform .22s ease, filter .22s ease, background .22s ease, border-color .22s ease;
    will-change: transform, filter;
  }
  .page-lab .tool-card--qrgen { order: 1; }
  .page-lab .tool-card--lumina { order: 2; }
  .page-lab .tool-card--image-suite { order: 3; }
  .page-lab .tool-card--converter { order: 4; }
  .page-lab .tool-card--image-scaler { order: 5; }
  .page-lab .tool-card--qrgen,
  .page-lab .tool-card--lumina {
    border-color: rgba(125,249,255,.18);
    background:
      linear-gradient(135deg, rgba(125,249,255,.08), rgba(214,168,79,.05)),
      rgba(255,255,255,.035);
  }
  .page-lab .tool-card:hover,
  .page-lab .tool-card:focus-within {
    filter: drop-shadow(0 18px 42px rgba(125,249,255,.12));
    transform: translateY(-6px);
    border-color: rgba(125,249,255,.24);
    background:
      linear-gradient(150deg, rgba(125,249,255,.09), rgba(214,168,79,.055)),
      rgba(255,255,255,.04);
  }
  .page-lab .tool-card__media {
    position: relative;
    display: grid;
    min-height: clamp(254px, 27vw, 334px);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.02)),
      rgba(0,0,0,.14);
    overflow: hidden;
  }
  .page-lab .tool-card__media > span {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    max-width: calc(100% - 24px);
    min-height: 28px;
    display: inline-flex;
    align-items: center;
    padding: 0 10px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 999px;
    background: rgba(3,8,18,.62);
    color: rgba(255,255,255,.84);
    font-size: 11px;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: .08em;
  }
  .page-lab .tool-card .head-row {
    min-height: 82px;
  }
  .page-lab .tool-card .head-row > div {
    flex: 1 1 auto;
    min-width: 0;
  }
  .page-lab .tool-card p {
    margin: 0;
    min-height: 4.9rem;
  }
  .page-lab .tool-card__promise {
    display: block;
    min-height: 4.2rem;
    padding: 12px;
    border-left: 2px solid rgba(214,168,79,.58);
    border-radius: 8px;
    background: rgba(214,168,79,.055);
    color: rgba(255,255,255,.88);
    font-size: 13px;
    font-weight: 900;
    line-height: 1.42;
  }
  .page-lab .tool-card .mini-stats {
    margin-top: 0;
  }
  .page-lab .tool-card__matrix {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    margin: auto 0 0;
  }
  .page-lab .tool-card__matrix div {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    min-height: 44px;
    padding: 9px 10px;
    border: 1px solid rgba(255,255,255,.075);
    border-radius: 8px;
    background: rgba(255,255,255,.035);
  }
  .page-lab .tool-card__matrix dt {
    color: #7df9ff;
    font-size: 11px;
    font-weight: 950;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: .08em;
  }
  .page-lab .tool-card__matrix dd {
    margin: 0;
    color: rgba(255,255,255,.66);
    font-size: 12px;
    font-weight: 650;
    line-height: 1.35;
  }
  .page-lab .tool-icon {
    display: grid;
    place-items: end center;
    width: 100%;
    min-height: 100%;
    margin: 0;
    background: none;
    border: none;
    border-radius: 12px;
  }
  .page-lab .tool-icon img {
    width: min(100%, 420px);
    max-height: clamp(220px, 24vw, 300px);
    height: 100%;
    object-fit: contain;
    border-radius: 12px;
    filter: drop-shadow(0 0 7px);
    display: block;
  }
  .page-lab .tool-card--image-suite .tool-icon img {
    width: min(100%, 452px);
    max-height: clamp(232px, 25vw, 312px);
  }
  .page-lab .lab-workflow-section {
    padding-top: 10px;
  }
  .page-lab .lab-workflow {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: 18px;
    align-items: stretch;
    padding: 22px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(255,255,255,.055), rgba(255,255,255,.025)),
      rgba(0,0,0,.1);
  }
  .page-lab .lab-workflow__head h2 {
    margin: 6px 0 8px;
    font-size: clamp(28px, 4vw, 46px);
    line-height: 1;
    letter-spacing: 0;
  }
  .page-lab .lab-workflow__head p {
    margin: 0;
    color: rgba(255,255,255,.66);
    line-height: 1.6;
  }
  .page-lab .lab-workflow__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .page-lab .lab-workflow__grid div {
    min-height: 154px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 8px;
    background: rgba(255,255,255,.04);
  }
  .page-lab .lab-workflow__grid strong {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: rgba(125,249,255,.12);
    color: #fff;
    font-size: 13px;
  }
  .page-lab .lab-workflow__grid span {
    color: rgba(255,255,255,.9);
    font-size: 15px;
    font-weight: 950;
    line-height: 1.2;
  }
  .page-lab .lab-workflow__grid p {
    margin: 0;
    color: rgba(255,255,255,.62);
    font-size: 13px;
    line-height: 1.48;
  }
  .page-lab .studio-badge img {
    width: 16px;
    height: 16px;
    object-fit: contain;
    display: block;
    flex: 0 0 auto;
  }
  .page-lab .stats-row {
    align-items: stretch;
  }
  .page-lab .stat-block {
    --stat-glow: rgba(132, 201, 255, .18);
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 100%;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03)),
      radial-gradient(circle at top, var(--stat-glow), transparent 68%);
    transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
  }
  .page-lab .stat-block--queue {
    --stat-glow: rgba(92, 204, 255, .18);
  }
