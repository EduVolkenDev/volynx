---
import "../../../styles/converter.css";
import "../../../styles/lab-runtime-status.css";
import LabBg from "../../../components/LabBg.astro";
import FaviconHead from "../../../components/FaviconHead.astro";
import PageWidgets from "../../../components/PageWidgets.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import LabUpgradeBanner from "../../../components/LabUpgradeBanner.astro";
import Topbar from "../../../components/Topbar.astro";
import LabToolShell from "../../../components/LabToolShell.astro";
const pageTitle = "VOLYNX Lab • Converter";
const pageDescription = "Free image converter — convert to WebP, JPG, PNG or AVIF with quality control and resize options.";
const canonicalUrl = "https://volynx.world/volynx-lab/converter/";
const socialImage = "https://volynx.world/assets/converterbig.webp";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:alt" content="VOLYNX Lab Converter" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={socialImage} />
  <meta name="twitter:image:alt" content="VOLYNX Lab Converter" />
  <title>{pageTitle}</title>

  <FaviconHead />
</head>

<body>
  <LabBg />

  <Topbar rightLinks={[{ href: "/volynx-lab/", label: "← Back", i18n: "converter.back" }]} />
  <LabToolShell active="converter" />

  <div class="brand-logo" aria-hidden="true">
  </div>

  <main class="wrap">
    <h1 class="tool-hero-title" aria-label="Converter">
      <span class="tool-hero-stage" aria-hidden="true">
        <span class="tool-hero-orbit tool-hero-orbit--a"></span>
        <span class="tool-hero-orbit tool-hero-orbit--b"></span>
        <span class="tool-hero-beam"></span>
        <span class="tool-hero-shell">
          <img src="/assets/converterbig.webp" alt="" class="tool-hero-logo converter-hero-logo" aria-hidden="true" />
        </span>
      </span>
      <span class="sr-only" data-i18n="converter.title">Converter</span>
    </h1>

    <section class="card" aria-label="Image converter">
      <div class="card__head">
        <h2 data-i18n="converter.title">Converter</h2>
        <div class="lab-runtime-mini" data-lab-runtime-mini data-lab-runtime-tool="converter" data-state="checking" aria-live="polite">
          <span class="lab-runtime-mini__dot" aria-hidden="true"></span>
          <span class="lab-runtime-mini__label" data-lab-runtime-mini-label>Local converter</span>
          <strong class="lab-runtime-mini__state" data-lab-runtime-mini-state data-i18n="lab2.runtime_checking">Checking</strong>
        </div>
      </div>

      <div id="drop" class="drop" role="region" aria-label="Drop zone">
        <input id="file" type="file" accept="image/*,.heic,.heif" multiple aria-label="Select images" />
        <div class="drop__inner" aria-hidden="true">
          <div class="drop__title" data-i18n="converter.drop_title">Drag images here</div>
          <div class="drop__hint" data-i18n="converter.drop_hint">or click to select</div>
        </div>
      </div>

      <div class="controls">
        <label class="field">
          <span data-i18n="converter.format_label">Formato</span>
          <select id="format" aria-label="Output format">
            <option value="webp" selected>WebP (recomendado)</option>
            <option value="jpg">JPG</option>
            <option value="png">PNG</option>
            <option value="avif">AVIF (se suportado)</option>
          </select>
        </label>

        <label class="field">
          <span data-i18n="converter.quality_label">Qualidade</span>
          <input id="quality" type="range" min="40" max="95" value="82" aria-label="Quality" />
          <em id="qualityVal" aria-live="polite">82</em>
        </label>

        <label class="field">
          <span data-i18n="converter.resize_label">Resize (largura máx)</span>
          <select id="maxw" aria-label="Max width">
            <option value="0" selected data-i18n="converter.resize_original">Original</option>
            <option value="3840">3840</option>
            <option value="2560">2560</option>
            <option value="1920">1920</option>
            <option value="1280">1280</option>
            <option value="1080">1080</option>
          </select>
        </label>

        <div class="actions">
          <button id="convert" class="btn" data-i18n="converter.btn_convert">Converter</button>
          <button id="zip" class="btn" disabled data-i18n="converter.btn_zip">Baixar ZIP</button>
          <button id="clear" class="btn" data-i18n="converter.btn_clear">Limpar</button>
        </div>
      </div>

      <div class="listHead">
        <div data-i18n="converter.files_label">Arquivos</div>
        <div id="stats" class="stats" aria-live="polite"></div>
      </div>

      <ul id="list" class="list" aria-label="File list"></ul>
    </section>
  </main>

  <script is:inline src="/js/vx-file-metrics.js"></script>
  <script is:inline src="/js/vx-auth-bridge.js"></script>
  <script is:inline src="/scripts/vx-lab-workspace.js?v=20260621-modal-system"></script>
  <script is:inline src="/js/vx-lab-runtime.js"></script>
  <script is:inline src="/vendor/jszip-3.10.1/jszip.min.js" defer></script>
  <script is:inline src="/vendor/heic2any-0.0.4/heic2any.min.js" defer></script>
  <script is:inline type="module" src="/volynx-lab/app.js"></script>

  <LabUpgradeBanner />
  <SiteFooter />
  <PageWidgets hideUtilBar />
</body>
</html>
