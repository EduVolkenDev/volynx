---
import FlagshipLayout from "../../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../../components/FlagshipFooter.astro";
import { ROUTES } from "../../../data/routes";
---

<FlagshipLayout
  title="VOLYNX Education Lab — Learn by building"
  description="Free educational paths from VOLYNX for developers and learners who want to build, understand and ship real work."
  pageClass="page-lab-education"
>
  <FlagshipHeader current={ROUTES.labEducation} ctaLabel="Open Dev Journey" ctaHref={ROUTES.devJourney} />
  <main>
    <section class="education-hero">
      <div class="shell education-hero__grid">
        <div class="education-hero__copy">
          <span class="kicker"><span class="i18n-en">VOLYNX Education Lab</span><span class="i18n-pt">VOLYNX Education Lab</span></span>
          <h1><span class="i18n-en">Learn the move. Build the thing. Keep the proof.</span><span class="i18n-pt">Aprenda o movimento. Construa de verdade. Guarde a prova.</span></h1>
          <p><span class="i18n-en">Free learning paths for developers and curious people who want more than theory: clearer decisions, better fundamentals and work they can actually show.</span><span class="i18n-pt">Trilhas gratuitas para desenvolvedores e pessoas curiosas que querem mais do que teoria: decisões mais claras, fundamentos melhores e trabalho que podem realmente mostrar.</span></p>
          <div class="education-hero__actions">
            <a class="button button--gold" href={ROUTES.devJourney}><span class="i18n-en">Start Dev Journey</span><span class="i18n-pt">Começar Dev Journey</span><span aria-hidden="true">↗</span></a>
            <a class="button button--ghost" href={ROUTES.cheatcodes}><span class="i18n-en">Explore Cheatcodes</span><span class="i18n-pt">Explorar Cheatcodes</span><span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="education-hero__signal" aria-hidden="true">
          <span class="education-hero__orb"></span>
          <span class="education-hero__code">01 / LEARN<br />02 / BUILD<br />03 / PROVE</span>
          <img src="/assets/devjourney/devjourneyicon18.webp" alt="" width="180" height="180" loading="eager" decoding="async" />
        </div>
      </div>
    </section>

    <section class="page-section education-programs" aria-labelledby="education-programs-title">
      <div class="shell">
        <div class="section-heading">
          <span class="kicker"><span class="i18n-en">The first two paths</span><span class="i18n-pt">As duas primeiras trilhas</span></span>
          <h2 id="education-programs-title"><span class="i18n-en">Two ways in. One standard: make it real.</span><span class="i18n-pt">Dois caminhos para começar. Um padrão: tornar real.</span></h2>
          <p><span class="i18n-en">One is a guided journey from first click to published project. The other is a fast reference for the moments where developers get stuck.</span><span class="i18n-pt">Uma é uma jornada guiada do primeiro clique ao projeto publicado. A outra é uma referência rápida para os momentos em que desenvolvedores travam.</span></p>
        </div>
        <div class="education-programs__grid">
          <article class="education-card education-card--journey">
            <span class="education-card__number">01</span>
            <span class="education-card__label"><span class="i18n-en">Guided path</span><span class="i18n-pt">Caminho guiado</span></span>
            <h3>Dev Journey</h3>
            <p><span class="i18n-en">Learn HTML, CSS, JavaScript, APIs and delivery by building visible projects with checklists and honest evidence.</span><span class="i18n-pt">Aprenda HTML, CSS, JavaScript, APIs e entrega construindo projetos visíveis com checklists e evidências honestas.</span></p>
            <ul><li><span class="i18n-en">Beginner-friendly</span><span class="i18n-pt">Para começar do zero</span></li><li><span class="i18n-en">Real projects</span><span class="i18n-pt">Projetos reais</span></li><li><span class="i18n-en">Free starting track</span><span class="i18n-pt">Trilha inicial gratuita</span></li></ul>
            <a href={ROUTES.devJourney}><span class="i18n-en">Open Dev Journey</span><span class="i18n-pt">Abrir Dev Journey</span><span aria-hidden="true">↗</span></a>
          </article>
          <article class="education-card education-card--cheatcodes">
            <span class="education-card__number">02</span>
            <span class="education-card__label"><span class="i18n-en">Fast reference</span><span class="i18n-pt">Referência rápida</span></span>
            <h3>Cheatcodes <em>for Devs &amp; Learners</em></h3>
            <p><span class="i18n-en">Compact mental models, debugging moves, command patterns and practical explanations for learning faster without skipping the fundamentals.</span><span class="i18n-pt">Modelos mentais compactos, movimentos de debugging, padrões de comando e explicações práticas para aprender mais rápido sem pular os fundamentos.</span></p>
            <ul><li><span class="i18n-en">Quick to scan</span><span class="i18n-pt">Rápido de consultar</span></li><li><span class="i18n-en">Useful under pressure</span><span class="i18n-pt">Útil quando trava</span></li><li><span class="i18n-en">Free by default</span><span class="i18n-pt">Gratuito por padrão</span></li></ul>
            <a href={ROUTES.cheatcodes}><span class="i18n-en">Open Cheatcodes</span><span class="i18n-pt">Abrir Cheatcodes</span><span aria-hidden="true">↗</span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="education-principles" aria-label="VOLYNX education principles">
      <div class="shell education-principles__grid">
        <div><span class="kicker"><span class="i18n-en">The method</span><span class="i18n-pt">O método</span></span><h2><span class="i18n-en">No empty theory. No fake certainty.</span><span class="i18n-pt">Sem teoria vazia. Sem certeza fingida.</span></h2></div>
        <div class="education-principles__list"><p><strong>01</strong><span class="i18n-en">Understand the why before memorising the how.</span><span class="i18n-pt">Entenda o porquê antes de decorar o como.</span></p><p><strong>02</strong><span class="i18n-en">Build small enough to finish, real enough to matter.</span><span class="i18n-pt">Construa pequeno o bastante para terminar e real o bastante para importar.</span></p><p><strong>03</strong><span class="i18n-en">Name what worked, what failed and what remains unknown.</span><span class="i18n-pt">Nomeie o que funcionou, o que falhou e o que ainda não se sabe.</span></p></div>
      </div>
    </section>

    <section class="education-boundary" aria-label="Educational content terms">
      <div class="shell"><p><span class="i18n-en">Learning resources are free to access. They are protected VOLYNX material: do not copy, resell, redistribute or turn them into a competing product.</span><span class="i18n-pt">Os recursos educacionais são gratuitos para acessar. Eles são materiais protegidos da VOLYNX: não copie, revenda, redistribua nem transforme o conteúdo em produto concorrente.</span></p></div>
    </section>
  </main>
  <FlagshipFooter />
</FlagshipLayout>

<style>
  .page-lab-education { --education-green: #b8f77b; --education-cyan: #6ee7f9; }
  .education-hero { position: relative; overflow: hidden; padding: clamp(76px, 11vw, 150px) 0 clamp(70px, 9vw, 120px); background: radial-gradient(circle at 76% 38%, rgba(110,231,249,.13), transparent 25%), radial-gradient(circle at 92% 84%, rgba(184,247,123,.1), transparent 24%), #090b18; }
  .education-hero::before { position: absolute; inset: 0; background: linear-gradient(115deg, transparent 30%, rgba(167,139,250,.07), transparent 67%); content: ""; pointer-events: none; }
  .education-hero__grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(280px, .85fr); align-items: center; gap: clamp(30px, 8vw, 110px); }
  .education-hero__copy { max-width: 750px; }
  .education-hero h1 { max-width: 780px; margin: 18px 0 22px; font-size: clamp(3rem, 7vw, 6.8rem); line-height: .93; letter-spacing: -.07em; }
  .education-hero p { max-width: 640px; color: rgba(238,241,255,.72); font-size: clamp(1rem, 1.6vw, 1.2rem); line-height: 1.65; }
  .education-hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .education-hero__actions .button { display: inline-flex; gap: 12px; align-items: center; }
  .education-hero__signal { position: relative; display: grid; min-height: 360px; place-items: center; border: 1px solid rgba(110,231,249,.2); border-radius: 28px; background: linear-gradient(145deg, rgba(22,31,58,.72), rgba(30,20,52,.52)); box-shadow: 0 30px 80px rgba(0,0,0,.28), inset 0 1px rgba(255,255,255,.1); }
  .education-hero__signal img { position: relative; z-index: 1; width: min(52%, 180px); height: auto; filter: drop-shadow(0 24px 30px rgba(0,0,0,.42)); }
  .education-hero__orb { position: absolute; width: 65%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(110,231,249,.18), transparent 66%); filter: blur(2px); }
  .education-hero__code { position: absolute; top: 24px; left: 26px; color: rgba(184,247,123,.7); font: 700 .67rem/1.8 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .12em; }
  .section-heading { max-width: 760px; margin-bottom: 38px; }
  .section-heading h2, .education-principles h2 { max-width: 760px; margin: 12px 0 14px; font-size: clamp(2rem, 4vw, 4rem); line-height: .98; letter-spacing: -.055em; }
  .section-heading p { max-width: 650px; color: rgba(226,232,240,.68); line-height: 1.6; }
  .education-programs__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .education-card { position: relative; min-height: 410px; padding: clamp(24px, 4vw, 44px); overflow: hidden; border: 1px solid rgba(255,255,255,.12); border-radius: 24px; background: rgba(255,255,255,.035); }
  .education-card::after { position: absolute; right: -70px; bottom: -100px; width: 260px; height: 260px; border-radius: 50%; background: radial-gradient(circle, rgba(110,231,249,.2), transparent 68%); content: ""; pointer-events: none; }
  .education-card--cheatcodes::after { background: radial-gradient(circle, rgba(184,247,123,.18), transparent 68%); }
  .education-card__number { display: block; color: var(--education-green); font: 700 .72rem ui-monospace, monospace; letter-spacing: .18em; }
  .education-card__label { display: block; margin-top: 48px; color: rgba(226,232,240,.55); font-size: .72rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .education-card h3 { margin: 10px 0 15px; font-size: clamp(1.8rem, 3vw, 3rem); letter-spacing: -.05em; }
  .education-card h3 em { display: block; color: var(--education-cyan); font-size: .48em; font-style: normal; letter-spacing: -.01em; }
  .education-card p { max-width: 520px; color: rgba(226,232,240,.7); line-height: 1.6; }
  .education-card ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 25px 0; padding: 0; list-style: none; }
  .education-card li { padding: 7px 10px; border: 1px solid rgba(255,255,255,.13); border-radius: 999px; color: rgba(238,241,255,.8); font-size: .72rem; }
  .education-card a { position: relative; z-index: 1; display: inline-flex; gap: 12px; align-items: center; color: var(--education-green); font-weight: 800; text-decoration: none; }
  .education-principles { padding: clamp(70px, 10vw, 130px) 0; background: linear-gradient(180deg, rgba(110,231,249,.06), transparent); }
  .education-principles__grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(30px, 8vw, 120px); }
  .education-principles__list { display: grid; gap: 0; }
  .education-principles__list p { display: grid; grid-template-columns: 42px 1fr; gap: 18px; margin: 0; padding: 20px 0; border-bottom: 1px solid rgba(255,255,255,.12); color: rgba(238,241,255,.78); line-height: 1.5; }
  .education-principles__list strong { color: var(--education-green); font: 700 .72rem ui-monospace, monospace; }
  .education-boundary { padding: 0 0 60px; }
  .education-boundary p { margin: 0; padding: 18px 22px; border: 1px solid rgba(184,247,123,.2); border-radius: 14px; color: rgba(238,241,255,.58); font-size: .78rem; line-height: 1.6; }
  @media (max-width: 780px) { .education-hero__grid, .education-principles__grid, .education-programs__grid { grid-template-columns: 1fr; } .education-hero__signal { min-height: 260px; } .education-card { min-height: 0; } }
  @media (max-width: 520px) { .education-hero h1 { font-size: clamp(2.7rem, 14vw, 4.4rem); } .education-hero__actions { display: grid; grid-template-columns: 1fr; } .education-hero__actions .button { justify-content: center; } }
</style>
