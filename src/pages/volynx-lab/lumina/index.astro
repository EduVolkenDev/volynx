---
import FaviconHead from "../../../components/FaviconHead.astro";
import LabBg from "../../../components/LabBg.astro";
import LabToolShell from "../../../components/LabToolShell.astro";
import LabUpgradeBanner from "../../../components/LabUpgradeBanner.astro";
import PageWidgets from "../../../components/PageWidgets.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import Topbar from "../../../components/Topbar.astro";
import { ROUTES, checkoutHref } from "../../../data/routes";

const proHref = checkoutHref("volynx_pro", { currency: "gbp", next: ROUTES.labLumina });

const features = [
  ["Simplificar conhecimento", "Transforma textos densos, acadêmicos ou técnicos em linguagem clara e direta, sem perder precisão.", "cyan"],
  ["Analisar artigos", "Extrai ideias centrais, métodos, conclusões e limites de papers, relatórios e publicações.", "violet"],
  ["Traduzir e adaptar", "Adapta contexto, exemplos e idioma para públicos em português, inglês e espanhol.", "blue"],
  ["Criar guias práticos", "Converte qualquer conhecimento em roteiros de ação, checklists e próximos passos concretos.", "gold"],
  ["Comparar ideias", "Coloca conceitos e abordagens lado a lado para revelar diferenças, convergências e riscos.", "cyan"],
  ["Explorar temas", "Organiza qualquer área do conhecimento com contexto, perguntas e conexões multidisciplinares.", "violet"],
  ["Gerar conteúdo educativo", "Produz posts, aulas, roteiros, apresentações e materiais didáticos a partir de uma fonte.", "blue"],
  ["Verificar cuidados", "Sinaliza incompletude, incerteza e pontos que precisam de verificação externa.", "gold"],
];

const plans = [
  {
    name: "Lumina Free",
    price: "R$0",
    description: "Para começar a iluminar. Sem cartão, sem fricção.",
    cta: "Começar gratuitamente",
    href: "#lumina-workbench",
    tone: "free",
    features: [
      "Resumos simples e generosos",
      "Explicações em linguagem clara",
      "Modo Claro completo",
      "5 usos gratuitos locais",
      "Português, inglês e espanhol",
      "Fallback local quando a IA estiver indisponível",
    ],
  },
  {
    name: "Lumina Pro",
    price: "Pro",
    description: "Profundidade, escala e criação para quem transforma conhecimento em trabalho real.",
    cta: "Usar com Pro",
    href: proHref,
    tone: "pro",
    features: [
      "Análises profundas com mais contexto",
      "PDF, link e documentos como evolução natural",
      "Comparação entre textos e estudos",
      "Guias práticos completos",
      "Modo Criador para posts, aulas e roteiros",
      "Exportação e trilhas de estudo como próximos upgrades",
    ],
  },
];
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Volynx Lumina transforma ciência, tecnologia e educação em explicações claras, humanas, multilíngues e aplicáveis." />
  <title>Volynx Lumina — Conhecimento não é privilégio. É luz.</title>
  <FaviconHead />
</head>
<body class="lumina-page">
  <LabBg />
  <Topbar rightLinks={[{ href: ROUTES.lab, label: "← Lab" }, { href: proHref, label: "Upgrade Pro" }]} />
  <LabToolShell active="lumina" />

  <main class="lumina-shell">
    <section class="lumina-hero" aria-labelledby="lumina-title">
      <div class="lumina-hero__copy">
        <span class="lumina-pill"><i></i> Volynx Lumina · v0.1</span>
        <h1 id="lumina-title" data-i18n-html="lumina.hero_title"><span>Conhecimento</span> não é privilégio. <em>É luz.</em></h1>
        <p class="lumina-subtitle" data-i18n="lumina.hero_copy">Transforme conteúdos científicos, técnicos e educacionais em explicações claras, humanas e multilíngues.</p>
        <div class="lumina-hero-actions">
          <a href="#lumina-workbench" class="lumina-btn lumina-btn--primary" data-i18n="lumina.hero_start">Começar gratuitamente</a>
          <a href="#funcionalidades" class="lumina-btn lumina-btn--ghost" data-i18n="lumina.hero_features">Ver capacidades</a>
        </div>
      </div>
      <div class="lumina-crystal" aria-hidden="true">
        <div class="lumina-crystal__halo"></div>
        <svg viewBox="0 0 420 480" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <radialGradient id="luminaOrbGrad" cx="38%" cy="30%" r="65%">
              <stop offset="0%" stop-color="#c0eeff" stop-opacity=".95" />
              <stop offset="30%" stop-color="#62b8ff" stop-opacity=".8" />
              <stop offset="60%" stop-color="#1e3a8a" stop-opacity=".9" />
              <stop offset="100%" stop-color="#071228" stop-opacity=".96" />
            </radialGradient>
            <radialGradient id="luminaInnerGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#00d8ff" stop-opacity=".55" />
              <stop offset="48%" stop-color="#7a35ff" stop-opacity=".28" />
              <stop offset="100%" stop-color="transparent" stop-opacity="0" />
            </radialGradient>
            <linearGradient id="luminaCrystalEdge" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#d6a84f" stop-opacity=".8" />
              <stop offset="50%" stop-color="#f8faff" stop-opacity=".45" />
              <stop offset="100%" stop-color="#7a35ff" stop-opacity=".62" />
            </linearGradient>
            <linearGradient id="luminaFaceTop" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#e8f6ff" stop-opacity=".9" />
              <stop offset="100%" stop-color="#4a90d9" stop-opacity=".52" />
            </linearGradient>
            <linearGradient id="luminaFaceLeft" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#1e3a8a" stop-opacity=".92" />
              <stop offset="100%" stop-color="#2a5bb5" stop-opacity=".74" />
            </linearGradient>
            <linearGradient id="luminaFaceRight" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#0d2050" stop-opacity=".96" />
              <stop offset="100%" stop-color="#122a70" stop-opacity=".82" />
            </linearGradient>
            <filter id="luminaGlow">
              <feGaussianBlur stdDeviation="3" result="coloredBlur" />
              <feMerge><feMergeNode in="coloredBlur" /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
            <clipPath id="luminaOrbClip"><ellipse cx="210" cy="210" rx="180" ry="180" /></clipPath>
          </defs>
          <ellipse cx="210" cy="440" rx="120" ry="18" fill="rgba(0,0,0,.35)" />
          <ellipse cx="210" cy="210" rx="180" ry="180" fill="url(#luminaOrbGrad)" />
          <ellipse cx="210" cy="210" rx="180" ry="180" fill="url(#luminaInnerGlow)" />
          <ellipse cx="158" cy="155" rx="55" ry="32" fill="rgba(255,255,255,.22)" transform="rotate(-20 158 155)" class="lumina-crystal__blur" />
          <ellipse cx="148" cy="148" rx="20" ry="10" fill="rgba(255,255,255,.55)" transform="rotate(-20 148 148)" />
          <g clip-path="url(#luminaOrbClip)" filter="url(#luminaGlow)">
            <polygon points="210,90 280,170 210,190 140,170" fill="url(#luminaFaceTop)" opacity=".9" stroke="rgba(255,255,255,.3)" stroke-width=".8" />
            <polygon points="210,190 140,170 130,280 210,310" fill="url(#luminaFaceLeft)" opacity=".85" stroke="rgba(0,216,255,.22)" stroke-width=".8" />
            <polygon points="210,190 280,170 290,280 210,310" fill="url(#luminaFaceRight)" opacity=".9" stroke="rgba(122,53,255,.32)" stroke-width=".8" />
            <polygon points="130,280 210,310 290,280 210,330" fill="#0a1840" opacity=".8" stroke="rgba(214,168,79,.25)" stroke-width=".8" />
            <polygon points="130,280 210,330 210,390" fill="#071228" opacity=".72" stroke="rgba(0,216,255,.15)" stroke-width=".5" />
            <polygon points="290,280 210,330 210,390" fill="#091530" opacity=".82" stroke="rgba(122,53,255,.16)" stroke-width=".5" />
            <line x1="210" y1="90" x2="130" y2="280" stroke="url(#luminaCrystalEdge)" stroke-width="1.2" opacity=".72" />
            <line x1="210" y1="90" x2="290" y2="280" stroke="url(#luminaCrystalEdge)" stroke-width="1.2" opacity=".72" />
            <line x1="210" y1="90" x2="210" y2="390" stroke="rgba(214,168,79,.42)" stroke-width=".8" opacity=".55" />
          </g>
          <ellipse cx="210" cy="210" rx="200" ry="55" fill="none" stroke="rgba(0,216,255,.16)" stroke-width="1" stroke-dasharray="8 6" transform="rotate(-15 210 210)" />
          <ellipse cx="210" cy="210" rx="200" ry="55" fill="none" stroke="rgba(122,53,255,.12)" stroke-width="1" stroke-dasharray="4 10" transform="rotate(25 210 210)" />
          <circle cx="90" cy="130" r="2.5" fill="#00d8ff" opacity=".76" />
          <circle cx="340" cy="95" r="1.8" fill="#d6a84f" opacity=".78" />
          <circle cx="55" cy="300" r="2.5" fill="#7a35ff" opacity=".82" />
          <circle cx="360" cy="320" r="1.8" fill="#00d8ff" opacity=".84" />
          <circle cx="210" cy="50" r="2.5" fill="#d6a84f" opacity=".88" />
          <circle cx="130" cy="380" r="1.8" fill="#7a35ff" opacity=".9" />
          <circle cx="300" cy="370" r="2.5" fill="#00d8ff" opacity=".92" />
          <ellipse cx="210" cy="210" rx="180" ry="180" fill="none" stroke="rgba(0,216,255,.22)" stroke-width="1.5" />
          <ellipse cx="210" cy="210" rx="176" ry="176" fill="none" stroke="rgba(214,168,79,.12)" stroke-width=".8" />
        </svg>
        <span data-i18n="lumina.mode_clear">Claro</span>
        <span data-i18n="lumina.mode_deep">Profundo</span>
        <span data-i18n="lumina.mode_practical">Prático</span>
      </div>
    </section>

    <section class="lumina-workbench" id="lumina-workbench" aria-label="Área de trabalho do Lumina" data-i18n-aria="lumina.workspace_aria">
      <div class="lumina-input-panel">
        <div class="lumina-panel-head">
          <div>
            <span class="lumina-kicker" data-i18n="lumina.input_kicker">Entrada</span>
            <h2 data-i18n="lumina.input_title">Ilumine um conteúdo complexo</h2>
          </div>
          <span class="lumina-free-counter" id="luminaFreeCounter" data-i18n="lumina.free_counter">Grátis: 5 usos</span>
        </div>

        <label class="lumina-field">
          <span data-i18n="lumina.input_label">Texto, artigo, link ou ideia</span>
          <textarea id="luminaInput" rows="12" placeholder="Cole aqui um texto, artigo, link ou ideia complexa..." data-i18n-placeholder="lumina.input_placeholder"></textarea>
        </label>

        <div class="lumina-controls">
          <label class="lumina-select">
            <span data-i18n="lumina.language">Idioma</span>
            <select id="luminaLanguage">
              <option value="pt">Português</option>
              <option value="en">English</option>
              <option value="es">Español</option>
            </select>
          </label>
          <label class="lumina-select">
            <span data-i18n="lumina.mode">Modo</span>
            <select id="luminaMode">
              <option value="clear" data-i18n="lumina.mode_clear">Claro</option>
              <option value="deep" data-i18n="lumina.mode_deep">Profundo</option>
              <option value="practical" data-i18n="lumina.mode_practical">Prático</option>
              <option value="multilingual" data-i18n="lumina.mode_multilingual">Multilíngue</option>
              <option value="creator" data-i18n="lumina.mode_creator">Criador</option>
            </select>
          </label>
        </div>

        <div class="lumina-actions" aria-label="Ações do Lumina" data-i18n-aria="lumina.actions_aria">
          <button type="button" data-mode="clear" data-i18n="lumina.action_simplify">Simplificar</button>
          <button type="button" data-mode="deep" data-i18n="lumina.action_summarize">Resumir</button>
          <button type="button" data-mode="multilingual" data-i18n="lumina.action_translate">Traduzir</button>
          <button type="button" data-mode="clear" data-i18n="lumina.action_teacher">Explicar como professor</button>
          <button type="button" data-mode="practical" data-i18n="lumina.action_guide">Transformar em guia prático</button>
        </div>
        <div class="lumina-examples" aria-label="Lumina ready examples">
          <button type="button" data-example="paper" data-i18n="lumina.example_paper">Exemplo: artigo científico</button>
          <button type="button" data-example="tech" data-i18n="lumina.example_tech">Exemplo: tecnologia</button>
          <button type="button" data-example="strategy" data-i18n="lumina.example_strategy">Exemplo: estratégia</button>
        </div>
      </div>

      <div class="lumina-result-panel">
        <div class="lumina-panel-head">
          <div>
            <span class="lumina-kicker" data-i18n="lumina.output_kicker">Saída</span>
            <h2 data-i18n="lumina.output_title">Resposta do Lumina</h2>
          </div>
          <span class="lumina-status" id="luminaStatus" data-i18n="lumina.status_ready">Pronto</span>
        </div>
        <div class="lumina-output-actions" aria-label="Lumina output actions">
          <button type="button" id="luminaCopyBtn" disabled data-i18n="lumina.copy">Copiar resposta</button>
          <button type="button" id="luminaExportBtn" disabled data-i18n="lumina.export">Exportar .txt</button>
        </div>

        <div class="lumina-output" id="luminaOutput">
          <article class="lumina-output-card is-empty">
            <span data-i18n="lumina.empty_title">Resumo essencial</span>
            <p data-i18n="lumina.empty_copy">A resposta aparecerá aqui em cartões organizados: resumo, explicação simples, conceitos, impacto prático e perguntas para continuar aprendendo.</p>
          </article>
        </div>
        <div class="lumina-history" aria-label="Lumina local history">
          <strong data-i18n="lumina.history">Histórico do Lumina</strong>
          <div id="luminaHistoryList" class="lumina-history__list"></div>
        </div>
      </div>
    </section>

    <section class="lumina-section" id="funcionalidades">
      <div class="lumina-section-head">
        <span class="lumina-kicker" data-i18n="lumina.features_kicker">Capacidades</span>
        <h2 data-i18n="lumina.features_title">O que o Lumina faz</h2>
        <p data-i18n="lumina.features_copy">Da simplificação à criação: um conjunto coeso de capacidades para transformar conhecimento em clareza.</p>
      </div>
      <div class="lumina-features">
        {features.map(([title, copy, tone], index) => (
          <article class:list={["lumina-feature", `lumina-feature--${tone}`]}>
            <div class="lumina-feature__icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none">
                <path d="M16 4L28 10V22L16 28L4 22V10L16 4Z" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity=".08" />
                <circle cx="16" cy="16" r="4" fill="currentColor" fill-opacity=".82" />
              </svg>
            </div>
            <h3 data-i18n={`lumina.feature_${index + 1}_title`}>{title}</h3>
            <p data-i18n={`lumina.feature_${index + 1}_copy`}>{copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="lumina-modes" aria-label="Lumina modes">
      {[
        ["Modo Claro", "Simplicidade que ilumina", "Explica de forma simples, direta e humana."],
        ["Modo Profundo", "Análise sem superficialidade", "Mantém a complexidade, mas organiza melhor."],
        ["Modo Prático", "Conhecimento em ação", "Transforma conhecimento em plano, decisão e próximos passos."],
        ["Modo Multilíngue", "Sem fronteiras de idioma", "Traduz e adapta o conteúdo sem perder contexto."],
        ["Modo Criador", "Conhecimento que se transforma", "Transforma estudos em post, aula, roteiro ou página."],
      ].map(([title, subtitle, copy], index) => (
        <article>
          <h3 data-i18n={`lumina.mode_card_${index + 1}_title`}>{title}</h3>
          <strong data-i18n={`lumina.mode_card_${index + 1}_subtitle`}>{subtitle}</strong>
          <p data-i18n={`lumina.mode_card_${index + 1}_copy`}>{copy}</p>
        </article>
      ))}
    </section>

    <section class="lumina-plans" id="planos">
      <div class="lumina-section-head">
        <span class="lumina-kicker" data-i18n="lumina.plans_kicker">Acesso</span>
        <h2 data-i18n-html="lumina.plans_title">O gratuito deve ser generoso. <em>O Pro deve ser o próximo passo natural.</em></h2>
        <p data-i18n="lumina.plans_copy">A versão gratuita precisa ajudar de verdade. O Pro amplia profundidade, escala e produtividade.</p>
      </div>
      <div class="lumina-plan-grid">
        {plans.map((plan) => (
          <article class:list={["lumina-plan", `lumina-plan--${plan.tone}`]}>
            <div class="lumina-plan__bar"></div>
            {plan.tone === "pro" && <span class="lumina-plan__badge" data-i18n="lumina.plan_popular">Mais popular</span>}
            <span class="lumina-kicker">{plan.name}</span>
            <h3>{plan.price}</h3>
            <p data-i18n={`lumina.plan_${plan.tone}_copy`}>{plan.description}</p>
            <ul>
              {plan.features.map((item, index) => (
                <li><span aria-hidden="true"></span><span data-i18n={`lumina.plan_${plan.tone}_feature_${index + 1}`}>{item}</span></li>
              ))}
            </ul>
            <a href={plan.href} class:list={["lumina-btn", plan.tone === "pro" ? "lumina-btn--gold" : "lumina-btn--ghost"]} data-i18n={`lumina.plan_${plan.tone}_cta`}>{plan.cta}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="lumina-stats" aria-label="Lumina proof points">
      {[
        ["3", "idiomas iniciais"],
        ["5", "modos de análise"],
        ["∞", "tipos de conteúdo"],
        ["1", "missão: clareza"],
      ].map(([value, label], index) => (
        <div>
          <strong>{value}</strong>
          <span data-i18n={`lumina.stat_${index + 1}`}>{label}</span>
        </div>
      ))}
    </section>

    <section class="lumina-manifesto" id="manifesto">
      <span class="lumina-kicker" data-i18n="lumina.manifesto_kicker">Manifesto</span>
      <h2 data-i18n="lumina.manifesto_title">Queremos construir pontes</h2>
      <p data-i18n="lumina.manifesto_copy_1">O VOLYNX Lumina nasce da ideia de que o conhecimento não deve ficar preso atrás de linguagem difícil, barreiras sociais, limitações financeiras ou sistemas feitos apenas para poucos.</p>
      <p data-i18n="lumina.manifesto_copy_2">Acreditamos que o conhecimento só muda o mundo quando pode ser entendido, compartilhado e usado. Entender o mundo é o primeiro passo para transformá-lo.</p>
      <div class="lumina-upgrade">
        <strong data-i18n="lumina.manifesto_principle">O gratuito deve ser generoso. O Pro deve ser o próximo passo natural.</strong>
        <a href={proHref} data-i18n="lumina.plan_pro_cta">Usar com Pro</a>
      </div>
    </section>

    <section class="lumina-final">
      <div>
        <span class="lumina-kicker" data-i18n="lumina.final_kicker">Comece agora</span>
        <h2 data-i18n-html="lumina.final_title">Comece iluminando <em>uma ideia</em></h2>
        <p data-i18n="lumina.final_copy">Cole um texto, artigo ou conceito complexo e deixe o Lumina transformar complexidade em clareza, gratuitamente.</p>
        <div class="lumina-hero-actions">
          <a href="#lumina-workbench" class="lumina-btn lumina-btn--primary" data-i18n="lumina.final_try">Experimentar o Lumina</a>
          <a href="#manifesto" class="lumina-btn lumina-btn--ghost" data-i18n="lumina.final_manifesto">Ler manifesto</a>
          <a href={proHref} class="lumina-btn lumina-btn--gold" data-i18n="lumina.final_pro">Explorar Pro</a>
        </div>
      </div>
    </section>
  </main>

  <LabUpgradeBanner />
  <SiteFooter />
  <PageWidgets hideUtilBar />
  <script is:inline src="/js/vx-auth-bridge.js"></script>
  <script is:inline src="/scripts/vx-lab-workspace.js?v=20260621-modal-system"></script>
  <script type="module" src="/volynx-lab/lumina.js"></script>
</body>
</html>

<style>
  :root {
    --lumina-bg: #06142e;
    --lumina-text: rgba(255,255,255,.92);
    --lumina-muted: rgba(255,255,255,.62);
    --lumina-line: rgba(255,255,255,.12);
    --lumina-a: #00d8ff;
    --lumina-b: #d6a84f;
    --lumina-c: #7a35ff;
    --lumina-blue: #1e6bff;
  }

  html { background: var(--lumina-bg); }
  body.lumina-page {
    min-height: 100vh;
    margin: 0;
    color: var(--lumina-text);
    font-family: "Manrope", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background:
      radial-gradient(circle at 18% 8%, rgba(122,53,255,.2), transparent 30%),
      radial-gradient(circle at 84% 10%, rgba(0,216,255,.13), transparent 32%),
      radial-gradient(circle at 50% 70%, rgba(30,107,255,.1), transparent 42%),
      linear-gradient(180deg, rgba(6,20,46,.96), #05070d 74%);
  }

  .lumina-shell {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 42px 0 100px;
  }

  .lumina-hero {
    min-height: 620px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 520px);
    align-items: center;
    gap: clamp(32px, 7vw, 86px);
  }

  .lumina-kicker {
    display: inline-flex;
    color: var(--lumina-a);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .lumina-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 30px;
    padding: 8px 18px;
    border: 1px solid rgba(0,216,255,.2);
    border-radius: 999px;
    background: rgba(0,216,255,.06);
    color: var(--lumina-a);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .lumina-pill i {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--lumina-a);
    box-shadow: 0 0 10px var(--lumina-a);
  }

  .lumina-hero h1 {
    margin: 0;
    font-size: clamp(50px, 7.4vw, 92px);
    line-height: .96;
    letter-spacing: 0;
    max-width: 760px;
  }

  .lumina-hero h1 span {
    background: linear-gradient(90deg, #f8faff 0%, #00d8ff 30%, #7a35ff 68%, #f8faff 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
