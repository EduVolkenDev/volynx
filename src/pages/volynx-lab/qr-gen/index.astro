---
import VxHeader from "../../../components/VxHeader.astro";
import VxFooter from "../../../components/VxFooter.astro";
import FaviconHead from "../../../components/FaviconHead.astro";
import PageWidgets from "../../../components/PageWidgets.astro";
import LabUpgradeBanner from "../../../components/LabUpgradeBanner.astro";
import { ROUTES, checkoutHref } from "../../../data/routes";

const qrConciergeHref = `${ROUTES.whatsapp}?text=${encodeURIComponent("Hi VOLYNX, I need a banner-safe dynamic QR for a client. Please help me create and keep it online.")}`;
const launchCheckoutHref = checkoutHref("volynx_launch", { currency: "gbp", next: ROUTES.labQrGen });
const proCheckoutHref = checkoutHref("volynx_pro", { currency: "gbp", next: ROUTES.labQrGen });
const studioCheckoutHref = checkoutHref("volynx_studio", { currency: "gbp", next: ROUTES.labQrGen });
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VOLYNX QR Generator — Lab</title>
  <meta name="description" content="Generate styled QR Codes with logos, gradients and more. Sign in to save." />
  <FaviconHead />

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    @keyframes gradientShift {
      0%   { background-position: 0% 50%; }
      50%  { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50%       { transform: translateY(-10px); }
    }
    @keyframes glow {
      0%, 100% { box-shadow: 0 0 20px rgba(108,10,228,.3), 0 0 40px rgba(89,198,232,.2); }
      50%       { box-shadow: 0 0 30px rgba(108,10,228,.5), 0 0 60px rgba(89,198,232,.3); }
    }

    html, body { height: 100%; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
      background: linear-gradient(135deg, #0a0a1f 0%, #1a1a3e 25%, #0f0f2e 50%, #1e1e4f 75%, #0a0a1f 100%);
      background-size: 400% 400%;
      animation: gradientShift 15s ease infinite;
      color: #e0e0e0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      padding-top: 0;
    }

    body::before {
      content: '';
      position: fixed;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: radial-gradient(ellipse, rgb(20,142,169) 1px, #003768a6 20px, #7d46beba 0px, rgb(89,148,225) 35px);
      background-size: 40px 40px;
      animation: float 4s ease-in-out infinite;
      pointer-events: none;
      z-index: 0;
    }

    .qr-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 22px;
      padding: 24px 20px 76px;
      position: relative;
      z-index: 1;
      margin-top: 84px;
    }

    .lab-tool-rail {
      width: min(1120px, 100%);
      display: grid;
      grid-template-columns: minmax(180px, .7fr) minmax(0, 1.8fr);
      align-items: center;
      gap: 14px;
      padding: 12px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 8px;
      background:
        linear-gradient(135deg, rgba(125,249,255,.09), rgba(198,255,143,.045)),
        rgba(4,8,18,.74);
      box-shadow: 0 20px 70px rgba(0,0,0,.28);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      margin-top: 0;
    }

    .lab-tool-rail__brand {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
      padding: 8px 10px;
      border-radius: 8px;
      background: rgba(255,255,255,.045);
      border: 1px solid rgba(255,255,255,.08);
    }

    .lab-tool-rail__brand img {
      width: 48px;
      height: 48px;
      object-fit: contain;
      border-radius: 8px;
      filter: drop-shadow(0 0 14px rgba(125,249,255,.26));
      flex: 0 0 auto;
    }

    .lab-tool-rail__eyebrow {
      display: block;
      color: rgba(125,249,255,.82);
      font-size: 10px;
      font-weight: 900;
      letter-spacing: .16em;
      text-transform: uppercase;
      margin-bottom: 3px;
    }

    .lab-tool-rail__title {
      display: block;
      color: #fff;
      font-size: 15px;
      font-weight: 900;
      letter-spacing: 0;
      line-height: 1.1;
    }

    .lab-tool-rail__links {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 8px;
    }

    .lab-tool-link {
      display: grid;
      grid-template-columns: 34px minmax(0, 1fr);
      align-items: center;
      gap: 8px;
      min-height: 54px;
      padding: 8px;
      border-radius: 8px;
      border: 1px solid rgba(255,255,255,.09);
      background: rgba(255,255,255,.045);
      color: rgba(255,255,255,.82);
      text-decoration: none;
      overflow: hidden;
      transition: transform .2s ease, border-color .2s ease, color .2s ease, background .2s ease;
    }

    .lab-tool-link img {
      width: 34px;
      height: 34px;
      object-fit: contain;
      border-radius: 7px;
      filter: drop-shadow(0 0 10px rgba(255,255,255,.16));
    }

    .lab-tool-link span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 0;
      line-height: 1.1;
    }

    .lab-tool-link:hover {
      transform: translateY(-2px);
      border-color: rgba(125,249,255,.4);
      color: #fff;
      background: rgba(125,249,255,.08);
    }

    .lab-tool-link.is-active {
      color: #fff;
      border-color: rgba(125,249,255,.55);
      background:
        linear-gradient(135deg, rgba(125,249,255,.22), rgba(198,255,143,.12)),
        rgba(255,255,255,.06);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.16), 0 0 24px rgba(125,249,255,.12);
    }

    .container {
      background: #ffffff08;
      backdrop-filter: blur(20px) saturate(180%);
      border-radius: 30px;
      padding: 70px 40px;
      box-shadow: 0 8px 32px #0006, inset 0 1px #ffffff1a;
      border: 1px solid rgba(255,255,255,.08);
      max-width: 600px;
      width: 100%;
      text-align: center;
      position: relative;
      animation: glow 4s ease-in-out infinite;
      margin: 80px auto;
    }

    .qr-commerce {
      width: min(1120px, 100%);
      display: grid;
      gap: 18px;
    }

    .qr-commerce-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 18px;
      align-items: end;
      padding: 24px;
      border-radius: 8px;
      border: 1px solid rgba(255,255,255,.1);
      background:
        linear-gradient(135deg, rgba(125,249,255,.09), rgba(198,255,143,.055)),
        rgba(4,8,18,.68);
      box-shadow: 0 24px 80px rgba(0,0,0,.26);
      backdrop-filter: blur(16px);
    }

    .qr-commerce-kicker {
      display: inline-block;
      margin-bottom: 8px;
      color: rgba(198,255,143,.9);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: .16em;
      text-transform: uppercase;
    }

    .qr-commerce h2 {
      margin: 0 0 8px;
      color: #fff;
      font-size: clamp(28px, 5vw, 54px);
      line-height: .98;
      letter-spacing: 0;
    }

    .qr-commerce p {
      margin: 0;
      color: rgba(255,255,255,.66);
      line-height: 1.55;
    }

    .qr-commerce-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .qr-commerce-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 10px 14px;
      border-radius: 8px;
      border: 1px solid rgba(255,255,255,.12);
      background: rgba(255,255,255,.06);
      color: #fff;
      text-decoration: none;
      font-size: 13px;
      font-weight: 900;
      white-space: nowrap;
    }

    .qr-commerce-btn.primary {
      color: #061016;
      border-color: transparent;
      background: linear-gradient(135deg, #7df9ff, #c6ff8f);
    }

    .qr-price-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .qr-price-card {
      display: flex;
      flex-direction: column;
      gap: 14px;
      min-height: 100%;
      padding: 22px;
      border-radius: 8px;
      border: 1px solid rgba(255,255,255,.1);
      background: rgba(4,8,18,.68);
      backdrop-filter: blur(14px);
      box-shadow: 0 20px 70px rgba(0,0,0,.22);
    }

    .qr-price-card.featured {
      border-color: rgba(125,249,255,.42);
      background:
        linear-gradient(180deg, rgba(125,249,255,.11), rgba(4,8,18,.72)),
        rgba(4,8,18,.72);
    }

    .qr-price-card small {
      color: rgba(255,255,255,.5);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .qr-price-card strong {
      color: #fff;
      font-size: 21px;
      letter-spacing: 0;
    }

    .qr-price {
      display: flex;
      align-items: baseline;
      gap: 5px;
      color: #fff;
      font-size: 34px;
      font-weight: 950;
      letter-spacing: 0;
    }

    .qr-price span {
      color: rgba(255,255,255,.56);
      font-size: 13px;
      font-weight: 800;
    }

    .qr-price-card ul {
      display: grid;
      gap: 9px;
      padding: 0;
      margin: 0 0 4px;
      list-style: none;
      color: rgba(255,255,255,.68);
      font-size: 14px;
      line-height: 1.45;
    }

    .qr-price-card li {
      position: relative;
      padding-left: 16px;
    }

    .qr-price-card li::before {
      content: "";
      position: absolute;
      left: 0;
      top: .68em;
      width: 5px;
      height: 5px;
      border-radius: 999px;
      background: #7df9ff;
    }

    .qr-price-card .qr-commerce-btn {
      margin-top: auto;
      width: 100%;
    }

    .tool-hero-title {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
    }

    .tool-hero-stage {
      position: relative;
      display: grid;
      place-items: center;
      width: min(100%, 560px);
      min-height: clamp(300px, 42vw, 420px);
      padding: clamp(20px, 4vw, 32px);
      isolation: isolate;
    }

    .tool-hero-stage::before,
    .tool-hero-stage::after {
      content: '';
      position: absolute;
      inset: 6% 8%;
      border-radius: 36px;
      pointer-events: none;
    }

    .tool-hero-stage::before {
      background:
        radial-gradient(circle at 50% 32%, rgba(255,255,255,.18), transparent 28%),
        radial-gradient(circle at 18% 24%, rgba(67,127,255,.24), transparent 42%),
        radial-gradient(circle at 82% 22%, rgba(196,82,255,.2), transparent 40%),
        linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.02));
      border: 1px solid rgba(255,255,255,.12);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,.08),
        0 30px 80px rgba(0,0,0,.28);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    .tool-hero-stage::after {
      inset: auto 16% 4% 16%;
      height: 26%;
      border-radius: 999px;
      background: radial-gradient(circle, rgba(96,163,255,.24), rgba(96,163,255,0) 72%);
      filter: blur(18px);
      opacity: .95;
    }

    .tool-hero-orbit {
      position: absolute;
      inset: 50%;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.12);
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    .tool-hero-orbit--a {
      width: clamp(260px, 46vw, 430px);
      height: clamp(260px, 46vw, 430px);
      opacity: .55;
      box-shadow: 0 0 0 1px rgba(115,187,255,.08);
    }

    .tool-hero-orbit--b {
      width: clamp(320px, 58vw, 520px);
      height: clamp(220px, 34vw, 320px);
      opacity: .28;
      transform: translate(-50%, -50%) rotate(-12deg);
    }

    .tool-hero-beam {
      position: absolute;
      top: 4%;
      left: 50%;
      width: 72%;
      height: 72%;
      transform: translateX(-50%);
      background: linear-gradient(180deg, rgba(255,255,255,.18), rgba(255,255,255,0));
      clip-path: polygon(50% 0, 100% 100%, 0 100%);
      opacity: .24;
      filter: blur(14px);
      pointer-events: none;
    }

    .tool-hero-shell {
      position: relative;
      display: grid;
      place-items: center;
      padding: clamp(18px, 3vw, 24px);
      border-radius: 30px;
      background:
        linear-gradient(180deg, rgba(255,255,255,.18), rgba(255,255,255,.06)),
        linear-gradient(135deg, rgba(82,133,255,.2), rgba(199,71,255,.18));
      border: 1px solid rgba(255,255,255,.16);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,.18),
        0 24px 60px rgba(6,10,24,.45);
      z-index: 1;
    }

    .tool-hero-shell::before,
    .tool-hero-shell::after {
      content: '';
      position: absolute;
      inset: 10px;
      border-radius: 22px;
      pointer-events: none;
    }

    .tool-hero-shell::before {
      border: 1px solid rgba(255,255,255,.12);
      opacity: .75;
    }

    .tool-hero-shell::after {
      inset: auto 14% -10%;
      height: 24%;
      border-radius: 999px;
      background: radial-gradient(circle, rgba(208,108,255,.22), rgba(208,108,255,0) 68%);
      filter: blur(16px);
    }

    .tool-hero-logo {
      width: clamp(300px, 50vw, 500px);
      max-width: 100%;
      height: auto;
      object-fit: contain;
      border-radius: 18px;
      filter:
        drop-shadow(0 18px 30px rgba(0,0,0,.34))
        drop-shadow(0 0 22px rgba(255,255,255,.08));
      display: block;
      position: relative;
      z-index: 1;
      animation: toolHeroFloat 4.6s ease-in-out infinite;
    }

    .qr-hero-logo {
      width: clamp(320px, 52vw, 520px);
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .wordmark {
      max-width: 100vw; width: 100%;
      display: grid; justify-content: center;
      filter: drop-shadow(0 0 20px rgba(26,174,219,.46));
      align-content: flex-start;
      position: relative; margin: 4px auto 0;
    }
    .wordmark img { width: 100%; max-width: 400px; height: auto; display: block; margin: 0 auto; }

    h1 {
      font-size: 2.5em; font-weight: 700; margin-bottom: 40px;
      background: linear-gradient(135deg, #6c0ae4, #59c6e8, #a108f7, #12ddf8);
      background-size: 300% 300%;
      background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      animation: gradientShift 6s ease infinite;
      letter-spacing: -.5px; position: relative;
    }
    h1::after {
      content: ''; position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%);
      width: 100px; height: 3px;
      background: linear-gradient(90deg, transparent, #6c0ae4, transparent);
      border-radius: 2px;
    }

    .input-wrapper { position: relative; margin-bottom: 30px; }

    input[type="text"] {
      width: 100%; padding: 18px 20px;
      border: 2px inset rgba(255,255,255,.4);
      border-radius: 15px;
      background: rgba(255,255,255,.05);
      color: #e0e0e0; font-size: 1em; outline: none;
      transition: all .3s cubic-bezier(.4,0,.2,1);
    }
    input[type="text"]::placeholder { color: rgba(255,255,255,.3); }
    input[type="text"]:focus {
      background: rgba(255,255,255,.08);
      border-color: rgba(108,10,228,.5);
      box-shadow: 0 0 0 3px rgba(108,10,228,.1), 0 8px 20px rgba(0,0,0,.3);
      transform: translateY(-2px);
    }

    .options-section {
      background: rgba(108,14,162,.76);
      border-radius: 20px; padding: 25px; margin: 30px 0;
      border: 2px inset rgba(255,255,255,.45);
    }
    .section-title {
      font-size: .85em; font-weight: 600; text-transform: uppercase;
      letter-spacing: 1.5px; color: rgba(255,255,255,.5);
      margin-bottom: 20px; text-align: left;
    }
    .options { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
    .option-group { display: flex; flex-direction: column; align-items: flex-start; text-align: left; }
    .option-group label { font-size: .85em; font-weight: 500; margin-bottom: 8px; color: rgba(255,255,255,.7); letter-spacing: .3px; }

    .option-group select,
    .option-group input[type="range"] {
      width: 100%; padding: 10px 12px;
      border: 1px solid rgba(255,255,255,.1); border-radius: 10px;
      background: rgba(255,255,255,.05); color: #e0e0e0;
      font-size: .9em; outline: none; transition: all .3s ease; cursor: pointer;
    }
    .option-group select:hover,
    .option-group select:focus { background: rgba(255,255,255,.08); border-color: rgba(108,10,228,.3); }

    .option-group input[type="color"] {
      width: 100%; height: 50px; padding: 5px;
      border: 1px solid rgba(255,255,255,.1); border-radius: 10px;
      background: rgba(255,255,255,.05); cursor: pointer; transition: all .3s ease;
    }
    .option-group input[type="color"]:hover { border-color: rgba(108,10,228,.3); transform: scale(1.02); }

    .option-group input[type="file"] {
      width: 100%; padding: 10px;
      border: 1px solid rgba(255,255,255,.1); border-radius: 10px;
      background: rgba(255,255,255,.05); color: #e0e0e0;
      font-size: .85em; cursor: pointer; transition: all .3s ease;
    }
    .option-group input[type="file"]:hover { background: rgba(255,255,255,.08); }

    .option-group input[type="range"] {
      padding: 0; height: 6px; -webkit-appearance: none; appearance: none;
    }
    .option-group input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none; appearance: none;
      width: 18px; height: 18px; border-radius: 50%;
      background: linear-gradient(135deg, #6c0ae4, #59c6e8); cursor: pointer;
      box-shadow: 0 2px 10px rgba(108,10,228,.5); transition: all .2s ease;
    }
    .option-group input[type="range"]::-webkit-slider-thumb:hover { transform: scale(1.2); box-shadow: 0 4px 15px rgba(108,10,228,.7); }
    .option-group input[type="range"]::-moz-range-thumb {
      width: 18px; height: 18px; border: none; border-radius: 50%;
      background: linear-gradient(135deg, #6c0ae4, #59c6e8); cursor: pointer;
      box-shadow: 0 2px 10px rgba(108,10,228,.5); transition: all .2s ease;
    }

    button {
      width: 100%; padding: 18px; border: none; border-radius: 15px;
      background: linear-gradient(135deg, #6c0ae4 0%, #210df7 50%, #12ddf8 100%);
      background-size: 200% 200%;
      color: white; font-size: 1.05em; font-weight: 600; cursor: pointer;
      transition: all .4s cubic-bezier(.4,0,.2,1);
      margin-bottom: 25px; position: relative; overflow: hidden;
      text-transform: uppercase; letter-spacing: 1px;
      box-shadow: 0 0 30px 10px inset darkturquoise;
    }
    button::before {
      content: ''; position: absolute; top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.2), transparent);
      transition: left .5s;
    }
    button:hover::before { left: 100%; }
    button:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 30px rgba(108,10,228,.5), 0 5px 15px rgba(18,221,248,.3);
      background-position: 100% 0;
    }
    button:active { transform: translateY(-1px); }

    #qr-container {
      margin: 30px 0; max-width: 100%; padding: 20px;
      background: rgba(255,255,255,.9); border-radius: 20px;
      box-shadow: 0 10px 40px rgba(0,0,0,.3); display: inline-block;
    }

    #downloadBtn {
      background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
      color: white; border: none; padding: 15px 30px; border-radius: 15px;
      font-weight: 600; font-size: 1em; cursor: pointer;
      transition: all .3s cubic-bezier(.4,0,.2,1);
      text-transform: uppercase; letter-spacing: .5px;
      position: relative; overflow: hidden;
    }
    #downloadBtn::before {
      content: ''; position: absolute; top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.2), transparent);
      transition: left .5s;
    }
    #downloadBtn:hover::before { left: 100%; }
    #downloadBtn:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(255,107,107,.5); }

    :global(.vx-authed .login-hint[data-auth="out"]) {
      display: none;
    }

    .login-hint {
      margin-top: 24px;
      font-size: .82em;
      color: rgba(255,255,255,.4);
      line-height: 1.5;
    }
    .login-hint a {
      color: rgba(89,198,232,.75);
      text-decoration: none;
      font-weight: 600;
      transition: color .2s;
    }
    .login-hint a:hover { color: rgba(89,198,232,1); }

    #logoPreview {
      margin-top: 15px; padding: 15px;
      background: rgba(255,255,255,.05); border-radius: 10px;
      border: 1px solid rgba(255,255,255,.1);
    }
    #logoImg { max-width: 100px; max-height: 100px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,.3); height: auto; display: block; margin: 0 auto; }

    @media (max-width: 768px) {
      .lab-tool-rail,
      .qr-commerce-head {
        align-items: stretch;
        grid-template-columns: 1fr;
      }
      .lab-tool-rail__links,
      .qr-commerce-actions {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .lab-tool-link,
      .qr-commerce-btn {
        flex: 1 1 auto;
      }
      .qr-price-grid {
        grid-template-columns: 1fr;
      }
      .container { padding: 30px 16px; margin: 20px auto; }
      .tool-hero-stage {
        width: 100%;
        max-width: 100%;
        overflow: hidden;
        min-height: clamp(320px, 92vw, 460px);
        padding: 12px;
      }
      .tool-hero-orbit--a,
      .tool-hero-orbit--b {
        max-width: calc(100vw - 44px);
      }
      .tool-hero-stage::before,
      .tool-hero-stage::after { inset-inline: 2%; }
      .tool-hero-stage::before {
        inset-block-start: 3%;
        inset-block-end: 8%;
      }
      .tool-hero-shell {
        padding: 10px;
        border-radius: 24px;
      }
      .tool-hero-shell::before,
      .tool-hero-shell::after {
        inset: 6px;
        border-radius: 18px;
      }
      .tool-hero-shell::after {
        inset: auto 12% -8%;
        height: 22%;
      }
      .qr-hero-logo { width: min(100%, 560px); }
      h1 { font-size: 1.8em; margin-bottom: 24px; }
      .options { grid-template-columns: 1fr; gap: 15px; }
      .options-section { padding: 18px 14px; }
      button { padding: 14px; font-size: .95em; }
    }
    @media (max-width: 480px) {
      .container { padding: 20px 14px; border-radius: 20px; }
      h1 { font-size: 1.5em; }
    }

    @keyframes toolHeroFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }

    /* === Mode toggle (Static | Dynamic) === */
    .qr-mode-toggle {
      display: inline-flex;
      gap: 4px;
      padding: 4px;
      margin: 0 auto 22px;
      background: rgba(255,255,255,.04);
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 999px;
      backdrop-filter: blur(8px);
    }
    .qr-mode-btn {
      width: auto !important;
      padding: 8px 22px !important;
      border: none !important;
      border-radius: 999px !important;
      background: transparent !important;
      color: rgba(255,255,255,.55) !important;
      font-size: .82em !important;
      font-weight: 500 !important;
      letter-spacing: .3px !important;
      text-transform: none !important;
      cursor: pointer;
      transition: all .2s ease;
      box-shadow: none !important;
      margin: 0 !important;
    }
    .qr-mode-btn:hover { color: rgba(255,255,255,.85) !important; transform: none !important; }
    .qr-mode-btn::before { content: none !important; }
    .qr-mode-btn.is-active {
      background: linear-gradient(135deg, #6c0ae4, #210df7) !important;
      color: #fff !important;
      box-shadow: 0 4px 14px rgba(108,10,228,.35) !important;
    }

    /* === Dynamic section === */
    .qr-dyn-section {
      background: rgba(89,198,232,.06);
      border: 1px solid rgba(89,198,232,.18);
      border-radius: 18px;
      padding: 22px;
      margin-bottom: 26px;
      text-align: left;
    }
    .qr-dyn-intro {
      font-size: .9em;
      color: rgba(255,255,255,.7);
      line-height: 1.5;
      margin-bottom: 18px;
    }
    .qr-dyn-login-cta {
      text-align: center;
      padding: 24px 12px;
    }
    .qr-dyn-login-cta p {
      color: rgba(255,255,255,.75);
      margin-bottom: 16px;
    }
    .qr-dyn-login-cta a {
      display: inline-block;
      padding: 12px 28px;
      border-radius: 12px;
      background: linear-gradient(135deg, #6c0ae4, #59c6e8);
      color: #fff;
      text-decoration: none;
      font-weight: 600;
      box-shadow: 0 6px 18px rgba(108,10,228,.35);
    }
    .qr-dyn-quota {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 999px;
      font-size: .78em;
      color: rgba(255,255,255,.7);
      margin-bottom: 16px;
    }
    .qr-dyn-quota .dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: #4ade80;
    }
    .qr-dyn-quota.is-full .dot { background: #f87171; }
    .qr-dyn-section input[type="text"],
    .qr-dyn-section input[type="url"] {
      margin-bottom: 14px;
    }
    .qr-dyn-label {
      display: block;
      font-size: .8em;
      font-weight: 500;
      color: rgba(255,255,255,.55);
      margin-bottom: 6px;
      letter-spacing: .3px;
    }
    .qr-dyn-success {
      margin-top: 16px;
      padding: 14px 16px;
      background: rgba(74,222,128,.08);
      border: 1px solid rgba(74,222,128,.25);
      border-radius: 12px;
      font-size: .9em;
      color: rgba(255,255,255,.85);
    }
    .qr-dyn-success code {
      display: inline-block;
      padding: 2px 8px;
      background: rgba(0,0,0,.3);
      border-radius: 6px;
      font-family: 'SF Mono', Menlo, monospace;
      font-size: .9em;
      color: #59c6e8;
      user-select: all;
    }
    .qr-dyn-success a {
      display: inline-block;
      margin-top: 8px;
      color: #59c6e8;
      text-decoration: none;
      font-size: .85em;
    }
    .qr-dyn-error {
      margin-top: 14px;
      padding: 12px 14px;
      background: rgba(248,113,113,.08);
      border: 1px solid rgba(248,113,113,.25);
      border-radius: 10px;
      font-size: .88em;
      color: #fca5a5;
    }
    .qr-dyn-free-warning {
      margin-top: 14px;
      font-size: .78em;
      color: rgba(255,200,80,.75);
      text-align: center;
    }
    .is-dynamic-mode .qr-static-input { display: none; }
    .is-dynamic-mode #generateBtn { display: none; }
    .is-static-mode .qr-dyn-section { display: none; }
  </style>
</head>

<body>
  <VxHeader primaryCtaLabel="Sign in" primaryCtaI18n="header.cta_signin" primaryCtaHref={`${ROUTES.login}?next=${ROUTES.labQrGen}`} primaryCtaAuth="out" />

  <main class="qr-main">
    <nav class="lab-tool-rail" aria-label="VOLYNX Lab tools">
      <a class="lab-tool-rail__brand" href={ROUTES.lab} aria-label="Open VOLYNX Lab home">
        <img src="/assets/labicon.webp" alt="" loading="eager" decoding="async" />
        <span>
          <span class="lab-tool-rail__eyebrow">VOLYNX Lab</span>
          <span class="lab-tool-rail__title">Tool switcher</span>
        </span>
      </a>
      <div class="lab-tool-rail__links">
        <a class="lab-tool-link" href={ROUTES.lab}>
          <img src="/assets/labicon.webp" alt="" loading="lazy" decoding="async" />
          <span>Lab Home</span>
        </a>
        <a class="lab-tool-link" href={ROUTES.labConverter}>
          <img src="/assets/converterbig.webp" alt="" loading="lazy" decoding="async" />
          <span>Converter</span>
        </a>
        <a class="lab-tool-link" href={ROUTES.labImageScaler}>
          <img src="/assets/newimagescaler.webp" alt="" loading="lazy" decoding="async" />
          <span>Image Scaler</span>
        </a>
        <a class="lab-tool-link" href={ROUTES.labImageSuite}>
          <img src="/assets/newimagesuite.webp" alt="" loading="lazy" decoding="async" />
          <span>Image Suite</span>
        </a>
        <a class="lab-tool-link is-active" href={ROUTES.labQrGen} aria-current="page">
          <img src="/assets/newqrgen.webp" alt="" loading="lazy" decoding="async" />
          <span>QR Generator</span>
        </a>
      </div>
    </nav>

    <div class="container">
      <h1 class="tool-hero-title" aria-label="QR Generator">
        <span class="tool-hero-stage" aria-hidden="true">
          <span class="tool-hero-orbit tool-hero-orbit--a"></span>
          <span class="tool-hero-orbit tool-hero-orbit--b"></span>
          <span class="tool-hero-beam"></span>
          <span class="tool-hero-shell">
            <img src="/assets/qrgen.webp" alt="" class="tool-hero-logo qr-hero-logo" aria-hidden="true" />
          </span>
        </span>
        <span class="sr-only" data-i18n="qr.title">QR Generator</span>
      </h1>
      <div class="wordmark">
        <img src="/assets/wordmark.webp" alt="VOLYNX" />
      </div>

      <div class="qr-mode-toggle" role="tablist" aria-label="QR mode">
        <button type="button" class="qr-mode-btn is-active" data-mode="static" role="tab" data-i18n="qr.toggle_static">Static</button>
        <button type="button" class="qr-mode-btn" data-mode="dynamic" role="tab" data-i18n="qr.toggle_dynamic">Dynamic</button>
      </div>

      <div class="qr-dyn-section" id="qr-dyn-section" hidden>
        <p class="qr-dyn-intro" data-i18n="qr.dynamic_intro">
          Dynamic QRs let you change the destination URL anytime, even after printing.
        </p>

        <div class="qr-dyn-login-cta" id="qr-dyn-login-cta" hidden>
          <p data-i18n="qr.dynamic_login_required">Sign in to create dynamic QRs that you can edit later.</p>
          <a href={`${ROUTES.login}?next=${ROUTES.labQrGen}`}>Sign in</a>
        </div>

        <div id="qr-dyn-form" hidden>
          <div class="qr-dyn-quota" id="qr-dyn-quota" aria-live="polite">
            <span class="dot"></span>
            <span id="qr-dyn-quota-text">— / —</span>
          </div>

          <label class="qr-dyn-label" for="qr-dyn-target" data-i18n="qr.dynamic_target_label">Destination URL</label>
          <input type="url" id="qr-dyn-target" placeholder="https://example.com" data-i18n-placeholder="qr.dynamic_target_placeholder" autocomplete="url" />

          <label class="qr-dyn-label" for="qr-dyn-label-input" data-i18n="qr.dynamic_label_label">Internal label (optional)</label>
          <input type="text" id="qr-dyn-label-input" placeholder="Vitrine janeiro, cartão de visita..." data-i18n-placeholder="qr.dynamic_label_placeholder" maxlength="100" />

          <div class="qr-dyn-success" id="qr-dyn-success" hidden>
            <span data-i18n="qr.dynamic_success">Dynamic QR created. Short URL:</span>
            <code id="qr-dyn-short-url"></code>
            <br />
            <a href={ROUTES.profileQrCodes} data-i18n="qr.dynamic_manage">Manage in /profile/qr-codes/</a>
          </div>
          <div class="qr-dyn-error" id="qr-dyn-error" hidden></div>
          <p class="qr-dyn-free-warning" id="qr-dyn-free-warning" hidden data-i18n="qr.free_expiry_warning">Free plan QRs expire after 30 days.</p>
        </div>
      </div>

      <div class="input-wrapper qr-static-input">
        <input type="text" id="text" placeholder="Enter text or URL to generate QR" data-i18n-placeholder="qr.input_placeholder" />
      </div>

      <div class="options-section">
        <div class="section-title" data-i18n="qr.style_section">⚙️ Configurações de Estilo</div>
        <div class="options">
          <div class="option-group">
            <label data-i18n="qr.size_label">Tamanho</label>
            <select id="size">
              <option value="300" data-i18n="qr.size_small">Pequeno (300px)</option>
              <option value="400" selected data-i18n="qr.size_medium">Médio (400px)</option>
              <option value="500" data-i18n="qr.size_large">Grande (500px)</option>
            </select>
          </div>
          <div class="option-group">
            <label data-i18n="qr.dots_label">Estilo dos Pontos</label>
            <select id="dotsType">
              <option value="square" data-i18n="qr.dots_square">Quadrado</option>
              <option value="dots" data-i18n="qr.dots_round">Bolotas</option>
              <option value="rounded" data-i18n="qr.dots_rounded">Arredondado</option>
            </select>
          </div>
          <div class="option-group">
            <label data-i18n="qr.color_type_label">Tipo de Cor</label>
            <select id="dotsColorType">
              <option value="solid" data-i18n="qr.color_solid">Sólida</option>
              <option value="gradient" data-i18n="qr.color_gradient">Gradiente</option>
              <option value="metallic" data-i18n="qr.color_metallic">Metálico</option>
            </select>
          </div>
          <div class="option-group" id="dotsColorGroup">
            <label data-i18n="qr.qr_color_label">Cor do QR</label>
            <input type="color" id="dotsColor" value="#000000" />
          </div>
          <div class="option-group" id="dotsGradientGroup" style="display:none;">
            <label>Gradiente — Cor 1</label>
            <input type="color" id="dotsColor1" value="#000000" />
          </div>
          <div class="option-group" id="dotsGradientGroup2" style="display:none;">
            <label>Gradiente — Cor 2</label>
            <input type="color" id="dotsColor2" value="#ffffff" />
          </div>
          <div class="option-group">
            <label data-i18n="qr.bg_color_label">Cor de Fundo</label>
            <input type="color" id="backgroundColor" value="#ffffff" />
          </div>
          <div class="option-group">
            <label data-i18n="qr.radius_label">Border Radius</label>
            <input type="range" id="borderRadius" min="0" max="50" step="5" value="10" />
          </div>
        </div>
      </div>

      <div class="options-section">
        <div class="section-title" data-i18n="qr.logo_section">🖼️ Configurações de Logo</div>
        <div class="options">
          <div class="option-group">
            <label>Imagem do Logo</label>
            <input type="file" id="logo" accept="image/*" />
            <div id="logoPreview" style="display:none;">
              <img id="logoImg" alt="Logo Preview" />
            </div>
          </div>
          <div class="option-group">
            <label>Tamanho do Logo</label>
            <input type="range" id="logoSize" min="0.1" max="0.5" step="0.1" value="0.4" />
          </div>
          <div class="option-group">
            <label>Margem do Logo</label>
            <input type="range" id="logoMargin" min="5" max="20" step="1" value="10" />
          </div>
        </div>
      </div>

      <button id="generateBtn" data-i18n="qr.btn_generate">Gerar QR Code</button>
      <button id="qr-dyn-create-btn" hidden data-i18n="qr.dynamic_btn_create">Create dynamic QR</button>
      <div id="qr-container"></div>
      <button id="downloadBtn" style="display:none;" data-i18n="qr.btn_download">📥 Baixar QR Code</button>

      <p class="login-hint" data-auth="out" data-i18n="qr.login_hint">
        Want to save your QR Codes?
        <a href={`${ROUTES.login}?next=${ROUTES.labQrGen}`}>Sign in</a> or <a href={`${ROUTES.signup}?next=${ROUTES.labQrGen}`}>create a free account</a>.
      </p>
    </div>

    <section id="qr-pricing" class="qr-commerce" aria-label="QR pricing">
      <div class="qr-commerce-head">
        <div>
          <span class="qr-commerce-kicker">Banner-safe QR</span>
          <h2>Do not print a QR that can disappear.</h2>
          <p>Static QR is fine for quick assets. For banners, buildings and paid media, use a dynamic VOLYNX short link so the destination can be edited and kept online after print.</p>
        </div>
        <div class="qr-commerce-actions">
          <a class="qr-commerce-btn" href={ROUTES.profileQrCodes}>Manage existing QRs</a>
          <a class="qr-commerce-btn primary" href={qrConciergeHref}>Ask for banner setup</a>
        </div>
      </div>

      <div class="qr-price-grid">
        <article class="qr-price-card">
          <small>Per unit</small>
          <strong>Static branded QR</strong>
          <div class="qr-price">£12 <span>/ QR</span></div>
          <ul>
            <li>One finished PNG/SVG-style export for print</li>
            <li>Logo, colors and high error correction</li>
            <li>Destination is fixed inside the QR image</li>
          </ul>
          <a class="qr-commerce-btn" href="#text">Create static QR</a>
        </article>

        <article class="qr-price-card featured">
          <small>Best for banners</small>
          <strong>Dynamic QR setup</strong>
          <div class="qr-price">£29 <span>/ QR</span></div>
          <ul>
            <li>VOLYNX short link on qr.volynx.world</li>
            <li>Editable destination after the banner is printed</li>
            <li>Includes first 30 days online on free accounts</li>
          </ul>
          <a class="qr-commerce-btn primary" href="#qr-dyn-section">Create dynamic QR</a>
        </article>

        <article class="qr-price-card">
          <small>Keep online</small>
          <strong>Monthly QR hosting</strong>
          <div class="qr-price">from £11 <span>/ month</span></div>
          <ul>
            <li>Launch: 5 active dynamic QRs</li>
            <li>Pro: 20 active dynamic QRs</li>
            <li>Studio: 50 active dynamic QRs</li>
          </ul>
          <a class="qr-commerce-btn" href={launchCheckoutHref}>Start Launch</a>
        </article>
      </div>

      <div class="qr-price-grid">
        <article class="qr-price-card">
          <small>Launch</small>
          <strong>Small campaigns</strong>
          <div class="qr-price">£11 <span>/ month</span></div>
          <ul>
            <li>5 active dynamic QRs</li>
            <li>No automatic expiry while plan is active</li>
            <li>Good for menus, flyers and a first client</li>
          </ul>
          <a class="qr-commerce-btn" href={launchCheckoutHref}>Activate Launch</a>
        </article>

        <article class="qr-price-card featured">
          <small>Pro</small>
          <strong>Client work</strong>
          <div class="qr-price">£24 <span>/ month</span></div>
          <ul>
            <li>20 active dynamic QRs</li>
            <li>Better fit for agencies and recurring campaigns</li>
            <li>Includes broader VOLYNX Pro access</li>
          </ul>
          <a class="qr-commerce-btn primary" href={proCheckoutHref}>Activate Pro</a>
        </article>

        <article class="qr-price-card">
          <small>Studio</small>
          <strong>Production volume</strong>
          <div class="qr-price">£54 <span>/ month</span></div>
          <ul>
            <li>50 active dynamic QRs</li>
            <li>For multiple clients, locations or campaigns</li>
            <li>Designed for ongoing studio operations</li>
          </ul>
          <a class="qr-commerce-btn" href={studioCheckoutHref}>Activate Studio</a>
        </article>
      </div>
    </section>
  </main>

  <LabUpgradeBanner />
  <VxFooter />
  <PageWidgets hideUtilBar />

  <script is:inline src="/js/vx-auth-bridge.js"></script>
  <script is:inline src="/js/vx-token-refresh.js?v=20260515-qr-dynamic-auth"></script>
  <script is:inline src="https://unpkg.com/qr-code-styling@1.6.0-rc.1/lib/qr-code-styling.js"></script>
  <script is:inline src="/scripts/qr-gen.js"></script>
  <script is:inline src="/scripts/qr-gen-dynamic.js?v=20260515-qr-dynamic-auth"></script>
</body>
</html>
