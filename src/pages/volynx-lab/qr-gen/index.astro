---
const destination = "/qrgen/";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <title>Opening VOLYNX QRGen…</title>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </head>
  <body>
    <p>Opening the new VOLYNX QRGen. <a href={destination}>Continue</a>.</p>
  </body>
</html>
