---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import VxHeader from "../../../components/VxHeader.astro";
import VxFooter from "../../../components/VxFooter.astro";
import PageWidgets from "../../../components/PageWidgets.astro";
import { ROUTES } from "../../../data/routes";

const title = "Admin · Vouchers — VOLYNX";
---

<BaseLayout title={title}>
  <VxHeader primaryCtaLabel="Sign out" primaryCtaI18n="djs.sign_out" primaryCtaHref="/login/?logout=1" primaryCtaAuth="in" />
  <PageWidgets hideUtilBar />

  <main class="admin-shell">
    <div class="container">
      <!-- Loading state -->
      <section id="adminLoading" class="admin-state">
        <p class="admin-state__text">Loading admin context...</p>
      </section>

      <!-- Not logged in -->
      <section id="adminLoggedOut" class="admin-state" hidden>
        <h1>Sign in required</h1>
        <p class="muted">The voucher admin is gated to platform admins.</p>
        <a class="btn primary" href="/login/?next=/admin/vouchers/">Sign in</a>
      </section>

      <!-- Not admin -->
      <section id="adminForbidden" class="admin-state" hidden>
        <h1>Forbidden</h1>
        <p class="muted">Your account does not have admin privileges. If this is a mistake, contact support.</p>
        <a class="btn ghost" href="/">Back to home</a>
      </section>

      <!-- Admin UI -->
      <section id="adminUI" class="admin-ui" hidden>
        <header class="admin-head">
          <div>
            <span class="kicker">Admin · Vouchers</span>
            <h1>Issue invites, discounts, kit unlocks &amp; token grants</h1>
            <p class="muted">Each voucher is a single record in the <code>vouchers</code> table. Black Diamond invites generate a personalized URL ready to share.</p>
          </div>
          <button id="refreshBtn" class="btn ghost" type="button">Refresh list</button>
        </header>

        <!-- Create form -->
        <article class="panel admin-create">
          <h2>Create voucher</h2>
          <form id="createForm" class="admin-form">

            <!-- QUICK FILL PRESETS -->
            <fieldset class="grants quick-fill">
              <legend>Quick fill</legend>
              <p class="grant-help">Pre-fill common combinations. You can still override anything below.</p>
              <div class="quick-fill__row">
                <button type="button" class="btn ghost btn-sm" data-preset="black_diamond">◆ Black Diamond pack</button>
                <button type="button" class="btn ghost btn-sm" data-preset="vx_80">+ 80 VX bonus</button>
                <button type="button" class="btn ghost btn-sm" data-preset="diamond_only">Daily Diamond 90d</button>
                <button type="button" class="btn ghost btn-sm" data-preset="pro_perm">Pro plan (permanent)</button>
                <button type="button" class="btn ghost btn-sm" data-preset="reset">↺ Reset all</button>
              </div>
            </fieldset>

            <!-- 1) GRANTS — à la carte. Toggle each section independently. -->
            <fieldset class="grants">
              <legend>What does this voucher unlock? <small>(check what applies — combine freely)</small></legend>

              <!-- BD BADGE -->
              <div class="grant-section" data-section="bd">
                <label class="grant-section__head">
                  <input type="checkbox" data-section-toggle="bd" />
                  <span class="grant-section__title">◆ Black Diamond marker</span>
                  <span class="grant-section__hint">Sets <code>is_black_diamond=true</code> on profile.</span>
                </label>
              </div>

              <!-- PLAN UPGRADE -->
              <div class="grant-section" data-section="plan">
                <label class="grant-section__head">
                  <input type="checkbox" data-section-toggle="plan" />
                  <span class="grant-section__title">📈 Plan upgrade</span>
                  <span class="grant-section__hint">Updates <code>profiles.plan</code> / <code>builder_plan</code> / <code>daily_plan</code>.</span>
                </label>
                <div class="grant-section__body">
                  <div class="form-row">
                    <label class="field">
                      <span>Plan</span>
                      <select name="grant_plan">
                        <option value="launch">Launch</option>
                        <option value="business">Business</option>
                        <option value="pro" selected>Pro</option>
                        <option value="diamond">Diamond</option>
                        <option value="studio">Studio</option>
                        <option value="teams">Teams</option>
                      </select>
                    </label>
                    <label class="field">
                      <span>Affects</span>
                      <select name="grant_plan_scope">
                        <option value="plan" selected>profiles.plan (global)</option>
                        <option value="builder_plan">builder_plan only</option>
                        <option value="daily_plan">daily_plan only</option>
                        <option value="both_apps">builder + daily</option>
                      </select>
                    </label>
                  </div>
                  <label class="field field--checkbox">
                    <input type="checkbox" name="grant_plan_expires_enable" />
                    <span>Expires after a fixed number of days <small>(unchecked = permanent)</small></span>
                  </label>
                  <label class="field" data-show-if="grant_plan_expires_enable">
                    <span>Duration (days)</span>
                    <input type="number" name="grant_plan_expires_days" min="1" max="3650" value="90" />
                  </label>
                </div>
              </div>

              <!-- VX TOKENS -->
              <div class="grant-section" data-section="tokens">
                <label class="grant-section__head">
                  <input type="checkbox" data-section-toggle="tokens" />
                  <span class="grant-section__title">🪙 VX tokens</span>
                  <span class="grant-section__hint">Credits VX balance via <code>credit_tokens_atomic</code>.</span>
                </label>
                <div class="grant-section__body">
                  <label class="field">
                    <span>VX amount</span>
                    <div class="quick-presets">
                      <input type="number" name="grant_tokens" min="1" max="100000" value="80" />
                      <button type="button" class="btn ghost btn-sm" data-preset-tokens="12">+12</button>
                      <button type="button" class="btn ghost btn-sm" data-preset-tokens="32">+32</button>
                      <button type="button" class="btn ghost btn-sm" data-preset-tokens="80">+80</button>
                      <button type="button" class="btn ghost btn-sm" data-preset-tokens="200">+200</button>
                    </div>
                  </label>
                </div>
              </div>

              <!-- KIT (multi) -->
              <div class="grant-section" data-section="kits">
                <label class="grant-section__head">
                  <input type="checkbox" data-section-toggle="kits" />
                  <span class="grant-section__title">📦 Kit unlocks <small>(multi)</small></span>
                  <span class="grant-section__hint warn">⚠️ Captured in voucher. Auto-delivery in Phase 2.</span>
                </label>
                <div class="grant-section__body">
                  <fieldset class="check-grid">
                    <label><input type="checkbox" name="grant_kit" value="portfolio-pro-kit"> Portfolio Pro Kit</label>
                    <label><input type="checkbox" name="grant_kit" value="agency-launch-kit"> Agency Launch Kit</label>
                    <label><input type="checkbox" name="grant_kit" value="saas-landing-system"> SaaS Landing System</label>
                  </fieldset>
                </div>
              </div>

              <!-- ICON PACKS (multi) -->
              <div class="grant-section" data-section="icons">
                <label class="grant-section__head">
                  <input type="checkbox" data-section-toggle="icons" />
                  <span class="grant-section__title">🎨 Icon packs <small>(multi)</small></span>
                  <span class="grant-section__hint warn">⚠️ Captured in voucher. Auto-delivery in Phase 2.</span>
                </label>
                <div class="grant-section__body">
                  <fieldset class="check-grid">
                    <legend>Premium</legend>
                    <label><input type="checkbox" name="grant_icon_pack" value="Hyper-Icons-Premium"> Hyper Icons Premium</label>
                    <label><input type="checkbox" name="grant_icon_pack" value="Poligon-Premium"> Poligon Premium</label>
                    <label><input type="checkbox" name="grant_icon_pack" value="metal-chrome-premium"> Metal Chrome Premium</label>
                    <label><input type="checkbox" name="grant_icon_pack" value="Icons-Glass-Premium"> Icons Glass Premium</label>
                    <label><input type="checkbox" name="grant_icon_pack" value="Iridescent-Premium"> Iridescent Premium</label>
                    <label><input type="checkbox" name="grant_icon_pack" value="glow-premium"> Glow Premium</label>
                    <label><input type="checkbox" name="grant_icon_pack" value="purple-icons-premium"> Purple Icons Premium</label>
                    <label><input type="checkbox" name="grant_icon_pack" value="vintage-premium"> Vintage Premium</label>
                  </fieldset>
                  <fieldset class="check-grid check-grid--free">
                    <legend>Free</legend>
                    <label><input type="checkbox" name="grant_icon_pack" value="Abstract-Free"> Abstract Free</label>
                    <label><input type="checkbox" name="grant_icon_pack" value="Day-By-Day-free"> Day By Day Free</label>
                    <label><input type="checkbox" name="grant_icon_pack" value="Neon-Icons-Free"> Neon Icons Free</label>
                  </fieldset>
                </div>
              </div>

              <!-- DEV JOURNEY -->
              <div class="grant-section" data-section="devjourney">
                <label class="grant-section__head">
                  <input type="checkbox" data-section-toggle="devjourney" />
                  <span class="grant-section__title">🎓 Dev Journey tier</span>
                  <span class="grant-section__hint warn">⚠️ Captured in voucher. Auto-enrollment in Phase 2.</span>
                </label>
                <div class="grant-section__body">
                  <label class="field">
                    <span>Tier</span>
                    <select name="grant_devjourney_tier">
                      <option value="social">Social Sprint</option>
                      <option value="pro" selected>Pro</option>
                      <option value="bundle">Bundle</option>
                    </select>
                  </label>
                </div>
              </div>

              <!-- DISCOUNT -->
              <div class="grant-section" data-section="discount">
                <label class="grant-section__head">
                  <input type="checkbox" data-section-toggle="discount" />
                  <span class="grant-section__title">💰 Discount %</span>
                  <span class="grant-section__hint warn">⚠️ Captured in voucher. Stripe checkout wiring in Phase 2.</span>
                </label>
                <div class="grant-section__body">
                  <div class="form-row">
                    <label class="field">
                      <span>Discount %</span>
                      <input type="number" name="grant_discount_pct" min="1" max="100" value="20" />
                    </label>
                    <label class="field">
                      <span>Stripe coupon ID <small>(optional)</small></span>
                      <input type="text" name="grant_stripe_coupon_id" placeholder="coupon_xxx" />
                    </label>
                  </div>
                </div>
              </div>

              <!-- CUSTOM JSON -->
              <div class="grant-section" data-section="custom">
                <label class="grant-section__head">
                  <input type="checkbox" data-section-toggle="custom" />
                  <span class="grant-section__title">🧩 Custom grants JSON</span>
                  <span class="grant-section__hint">Merged into the final grants payload. Use only if you know what redeem-voucher consumes.</span>
                </label>
                <div class="grant-section__body">
                  <label class="field">
                    <span>Raw JSON</span>
                    <textarea name="grant_json" rows="4" placeholder='{"feature":"early_access"}'></textarea>
                  </label>
                </div>
              </div>

              <!-- Hidden input — type column auto-detected from grants -->
              <input type="hidden" id="type" name="type" value="generic" />
            </fieldset>

            <!-- 2) WHO is this for? -->
            <fieldset class="grants">
              <legend>Who is this for?</legend>
              <div class="form-row">
                <label class="field">
                  <span>Recipient name <small>(goes into the personalized URL ?to=)</small></span>
                  <input id="recipient_name" name="recipient_name" type="text" maxlength="80" placeholder="Maria Silva" />
                </label>
                <label class="field">
                  <span>Target email <small>(optional gate — locks redemption to this email)</small></span>
                  <input id="target_email" name="target_email" type="email" maxlength="320" placeholder="maria@example.com" />
                </label>
              </div>
              <label class="field">
                <span>Label <small>(auto-suggested from selection — edit if needed)</small></span>
                <input id="label" name="label" type="text" maxlength="200" placeholder="Auto-filled when you pick a category" />
              </label>
            </fieldset>

            <!-- 3) WHEN does it work? -->
            <fieldset class="grants">
              <legend>When does it work?</legend>
              <div class="form-row">
                <label class="field">
                  <span>Max uses</span>
                  <input id="max_uses" name="max_uses" type="number" min="1" max="100000" value="1" required />
                </label>
                <label class="field">
                  <span>Expires at <small>(optional)</small></span>
                  <input id="expires_at" name="expires_at" type="datetime-local" />
                </label>
                <label class="field field--checkbox">
                  <input id="transferable" name="transferable" type="checkbox" checked />
                  <span>Transferable (anyone with code can redeem)</span>
                </label>
              </div>
            </fieldset>

            <div class="form-actions">
              <button id="submitBtn" type="submit" class="btn primary">Create voucher</button>
              <span id="formMsg" class="form-msg" aria-live="polite"></span>
            </div>
          </form>
        </article>

        <!-- Result panel — hidden until a voucher is created -->
        <article id="resultPanel" class="panel admin-result" hidden>
          <h2>Voucher created</h2>
          <div class="result-grid">
            <div>
              <h3>Code</h3>
              <div class="code-row">
                <code id="resultCode" class="code-badge">—</code>
                <button class="btn ghost btn-sm" data-copy="code" type="button">Copy</button>
              </div>
              <h3>Personalized URL</h3>
              <div class="code-row">
                <input id="resultUrl" type="text" readonly />
                <button class="btn ghost btn-sm" data-copy="url" type="button">Copy</button>
              </div>
              <p class="muted" id="resultMeta">—</p>
            </div>
            <div class="qr-shell">
              <h3>QR code</h3>
              <canvas id="resultQR" width="220" height="220" aria-label="Personalized invite QR"></canvas>
              <button class="btn ghost btn-sm" id="downloadQR" type="button">Download PNG</button>
            </div>
          </div>
        </article>

        <!-- List -->
        <article class="panel admin-list">
          <h2>Recent vouchers</h2>
          <div class="table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Code</th>
                  <th>Type</th>
                  <th>Label</th>
                  <th>Target</th>
                  <th>Used</th>
                  <th>Status</th>
                  <th>Expires</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="vouchersBody">
                <tr><td colspan="8" class="muted">Loading…</td></tr>
              </tbody>
            </table>
          </div>
        </article>
      </section>
    </div>
  </main>

  <VxFooter />

  <script type="module">
    import QRCode from "https://cdn.jsdelivr.net/npm/qrcode@1.5.3/+esm";

    const FN_URL = "https://zdmpzrderifgqmqivjoy.supabase.co/functions/v1/admin-vouchers";
    const SITE_URL = location.origin;

    const $ = (id) => document.getElementById(id);
    const els = {
      loading: $("adminLoading"),
      loggedOut: $("adminLoggedOut"),
      forbidden: $("adminForbidden"),
      ui: $("adminUI"),
      form: $("createForm"),
      submitBtn: $("submitBtn"),
      formMsg: $("formMsg"),
      result: $("resultPanel"),
      resultCode: $("resultCode"),
      resultUrl: $("resultUrl"),
      resultMeta: $("resultMeta"),
      resultQR: $("resultQR"),
      downloadQR: $("downloadQR"),
      tbody: $("vouchersBody"),
      refresh: $("refreshBtn"),
    };

    function getToken() {
      try { return localStorage.getItem("volynx_access_token") || ""; } catch (_) { return ""; }
    }

    function showOnly(el) {
      [els.loading, els.loggedOut, els.forbidden, els.ui].forEach((e) => { if (e) e.hidden = e !== el; });
    }

    async function callApi(payload) {
      const token = getToken();
      const res = await fetch(FN_URL, {
        method: "POST",
        headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const text = await res.text();
      let data; try { data = JSON.parse(text); } catch (_) { data = { error: "non_json", raw: text }; }
      return { status: res.status, data };
    }

    function fmtDate(iso) {
      if (!iso) return "—";
      try { return new Date(iso).toLocaleString(); } catch (_) { return iso; }
    }

    const KIT_NAMES = {
      "portfolio-pro-kit": "Portfolio Pro Kit",
      "agency-launch-kit": "Agency Launch Kit",
      "saas-landing-system": "SaaS Landing System",
    };
    const ICON_NAMES = {
      "Hyper-Icons-Premium": "Hyper Icons Premium",
      "Icons-Glass-Premium": "Icons Glass Premium",
      "Iridescent-Premium": "Iridescent Premium",
      "Poligon-Premium": "Poligon Premium",
      "glow-premium": "Glow Premium",
      "metal-chrome-premium": "Metal Chrome Premium",
      "purple-icons-premium": "Purple Icons Premium",
      "vintage-premium": "Vintage Premium",
      "Abstract-Free": "Abstract (free)",
      "Day-By-Day-free": "Day By Day (free)",
      "Neon-Icons-Free": "Neon Icons (free)",
    };
    const PLAN_NAMES = { launch: "Launch", business: "Business", pro: "Pro", diamond: "Diamond", studio: "Studio", teams: "Teams" };
    const DJ_NAMES = { social: "Social Sprint", pro: "Pro", bundle: "Bundle" };

    function isSectionOn(name) {
      const cb = els.form.querySelector(`[data-section-toggle="${name}"]`);
      return !!(cb && cb.checked);
    }

    function buildGrants() {
      const fd = new FormData(els.form);
      const grants = {};

      // Black Diamond marker
      if (isSectionOn("bd")) {
        grants.badge = "black_diamond";
      }

      // Plan upgrade
      if (isSectionOn("plan")) {
        const plan = String(fd.get("grant_plan") || "pro");
        const scope = String(fd.get("grant_plan_scope") || "plan");
        if (scope === "plan") grants.plan = plan;
        else if (scope === "builder_plan") grants.builder_plan = plan;
        else if (scope === "daily_plan") grants.daily_plan = plan;
        else if (scope === "both_apps") { grants.builder_plan = plan; grants.daily_plan = plan; }
        if (fd.get("grant_plan_expires_enable") === "on") {
          const days = Number(fd.get("grant_plan_expires_days")) || 0;
          if (days > 0) grants.daily_plan_expires_in_days = days;
        }
      }

      // VX tokens
      if (isSectionOn("tokens")) {
        const n = Number(fd.get("grant_tokens")) || 0;
        if (n > 0) grants.tokens = n;
      }

      // Kit unlocks (multi)
      if (isSectionOn("kits")) {
        const ids = Array.from(els.form.querySelectorAll('input[name="grant_kit"]:checked')).map((el) => el.value);
        if (ids.length === 1) {
          grants.kit_id = ids[0];
          if (KIT_NAMES[ids[0]]) grants.kit_name = KIT_NAMES[ids[0]];
        } else if (ids.length > 1) {
          grants.kit_ids = ids;
        }
      }

      // Icon packs (multi)
      if (isSectionOn("icons")) {
        const ids = Array.from(els.form.querySelectorAll('input[name="grant_icon_pack"]:checked')).map((el) => el.value);
        if (ids.length > 0) grants.icon_pack_grants = ids;
      }

      // Dev Journey tier
      if (isSectionOn("devjourney")) {
        grants.devjourney_tier = String(fd.get("grant_devjourney_tier") || "pro");
      }

      // Discount %
      if (isSectionOn("discount")) {
        const pct = Number(fd.get("grant_discount_pct")) || 0;
        if (pct > 0) grants.discount_pct = pct;
        const c = String(fd.get("grant_stripe_coupon_id") || "").trim();
        if (c) grants.stripe_coupon_id = c;
      }

      // Custom JSON (merged on top — last-write wins)
      if (isSectionOn("custom")) {
        try {
          const extra = JSON.parse(String(fd.get("grant_json") || "{}"));
          if (extra && typeof extra === "object") Object.assign(grants, extra);
        } catch (_) { /* invalid JSON — ignore */ }
      }

      return grants;
    }

    function detectType(grants) {
      if (grants.badge === "black_diamond") return "black_diamond";
      if (grants.plan || grants.builder_plan || grants.daily_plan) return "plan";
      if (grants.tokens && Object.keys(grants).length === 1) return "tokens";
      if (grants.kit_id || grants.kit_ids) return "kit";
      if (grants.icon_pack_grants) return "icons";
      if (grants.devjourney_tier) return "devjourney";
      if (grants.discount_pct || grants.stripe_coupon_id) return "discount";
      return "generic";
    }

    function suggestLabel() {
      const labelInput = document.getElementById("label");
      if (!labelInput) return;
      if (labelInput.dataset.userEdited === "1") return;

      const fd = new FormData(els.form);
      const recipient = String(fd.get("recipient_name") || "").trim();
      const recipientSuffix = recipient ? ` — ${recipient}` : "";
      const grants = buildGrants();
      const parts = [];

      if (grants.badge === "black_diamond") parts.push("Black Diamond");
      const plan = grants.plan || grants.builder_plan || grants.daily_plan;
      if (plan) parts.push(`${PLAN_NAMES[plan] || plan} plan`);
      if (grants.tokens) parts.push(`${grants.tokens} VX`);
      if (grants.kit_ids?.length) parts.push(`${grants.kit_ids.length} kits`);
      else if (grants.kit_id) parts.push(`${KIT_NAMES[grants.kit_id] || "Kit"}`);
      if (grants.icon_pack_grants?.length) parts.push(`${grants.icon_pack_grants.length} icon pack${grants.icon_pack_grants.length > 1 ? "s" : ""}`);
      if (grants.devjourney_tier) parts.push(`DJ ${DJ_NAMES[grants.devjourney_tier] || grants.devjourney_tier}`);
      if (grants.discount_pct) parts.push(`${grants.discount_pct}% off`);

      const base = parts.length ? parts.join(" + ") : "Empty voucher";
      labelInput.value = base + recipientSuffix;
    }

    function syncSectionBodies() {
      // Hide each section body unless its toggle is checked
      els.form.querySelectorAll("[data-section]").forEach((sec) => {
        const name = sec.getAttribute("data-section");
        const on = isSectionOn(name);
        sec.classList.toggle("is-on", on);
      });
      // Inline conditional fields (data-show-if)
      els.form.querySelectorAll("[data-show-if]").forEach((el) => {
        const flag = el.getAttribute("data-show-if");
        const driver = els.form.querySelector(`[name="${flag}"]`);
        const on = !!(driver && driver.checked);
        el.hidden = !on;
      });
      suggestLabel();
    }

    // Quick-fill presets
    function applyPreset(preset) {
      function setToggle(name, on) {
        const cb = els.form.querySelector(`[data-section-toggle="${name}"]`);
        if (cb) cb.checked = !!on;
      }
      function setVal(name, value) {
        const el = els.form.querySelector(`[name="${name}"]`);
        if (!el) return;
        if (el.type === "checkbox") el.checked = !!value;
        else el.value = String(value);
      }
      function setPacks(values) {
        els.form.querySelectorAll('input[name="grant_icon_pack"]').forEach((el) => {
          el.checked = values.includes(el.value);
        });
      }
      function resetAll() {
        // Toggle off every section
        els.form.querySelectorAll("[data-section-toggle]").forEach((cb) => { cb.checked = false; });
        // Clear icon packs + kits
        els.form.querySelectorAll('input[name="grant_icon_pack"], input[name="grant_kit"]').forEach((el) => { el.checked = false; });
      }

      if (preset === "reset") {
        resetAll();
      } else if (preset === "black_diamond") {
        resetAll();
        setToggle("bd", true);
        setToggle("plan", true);
        setVal("grant_plan", "diamond");
        setVal("grant_plan_scope", "daily_plan");
        setVal("grant_plan_expires_enable", true);
        setVal("grant_plan_expires_days", 90);
        setToggle("tokens", true);
        setVal("grant_tokens", 80);
        setToggle("icons", true);
        setPacks(["Hyper-Icons-Premium", "Poligon-Premium", "metal-chrome-premium"]);
      } else if (preset === "vx_80") {
        resetAll();
        setToggle("tokens", true);
        setVal("grant_tokens", 80);
      } else if (preset === "diamond_only") {
        resetAll();
        setToggle("plan", true);
        setVal("grant_plan", "diamond");
        setVal("grant_plan_scope", "daily_plan");
        setVal("grant_plan_expires_enable", true);
        setVal("grant_plan_expires_days", 90);
      } else if (preset === "pro_perm") {
        resetAll();
        setToggle("plan", true);
        setVal("grant_plan", "pro");
        setVal("grant_plan_scope", "plan");
        setVal("grant_plan_expires_enable", false);
      }

      // Reset auto-label tracking so suggestion regenerates
      const labelInput = document.getElementById("label");
      if (labelInput) labelInput.dataset.userEdited = "";

      syncSectionBodies();
    }

    async function loadList() {
      const { status, data } = await callApi({ action: "list", limit: 100 });
      if (status === 401) { showOnly(els.loggedOut); return; }
      if (status === 403) { showOnly(els.forbidden); return; }
      if (!data?.ok) { els.tbody.innerHTML = `<tr><td colspan="8" class="muted">Error: ${data?.error || status}</td></tr>`; return; }
      showOnly(els.ui);
      renderList(data.items || []);
    }

    function renderList(items) {
      if (items.length === 0) {
        els.tbody.innerHTML = `<tr><td colspan="8" class="muted">No vouchers yet. Create one above.</td></tr>`;
        return;
      }
      els.tbody.innerHTML = items.map((v) => {
        const expired = v.expires_at && new Date(v.expires_at) < new Date();
        const exhausted = v.times_used >= v.max_uses;
        const status = !v.active
          ? `<span class="pill pill--off">revoked</span>`
          : expired
          ? `<span class="pill pill--off">expired</span>`
          : exhausted
          ? `<span class="pill pill--off">exhausted</span>`
          : `<span class="pill pill--on">active</span>`;
        return `<tr>
          <td><code>${escapeHtml(v.code)}</code></td>
          <td>${escapeHtml(v.type)}</td>
          <td>${escapeHtml(v.label || "—")}</td>
          <td>${escapeHtml(v.target_email || "—")}</td>
          <td>${v.times_used}/${v.max_uses}</td>
          <td>${status}</td>
          <td>${fmtDate(v.expires_at)}</td>
          <td><button class="btn ghost btn-sm" data-action="revoke" data-id="${escapeHtml(v.id)}" ${!v.active ? "disabled" : ""}>Revoke</button></td>
        </tr>`;
      }).join("");
    }

    function escapeHtml(s) {
      return String(s ?? "").replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#039;"}[c]));
    }

    async function submitCreate(e) {
      e.preventDefault();
      els.submitBtn.disabled = true;
      els.formMsg.textContent = "Creating…";
      els.formMsg.className = "form-msg form-msg--info";

      const fd = new FormData(els.form);
      const grants = buildGrants();
      if (Object.keys(grants).length === 0) {
        els.submitBtn.disabled = false;
        els.formMsg.textContent = "Pick at least one grant section above.";
        els.formMsg.className = "form-msg form-msg--err";
        return;
      }
      const detectedType = detectType(grants);
      const payload = {
        action: "create",
        type: detectedType,
        label: fd.get("label") || null,
        description: null,
        recipient_name: fd.get("recipient_name") || null,
        target_email: fd.get("target_email") || null,
        max_uses: Number(fd.get("max_uses")) || 1,
        transferable: fd.get("transferable") === "on",
        expires_at: fd.get("expires_at") || null,
        grants,
      };

      const { status, data } = await callApi(payload);
      els.submitBtn.disabled = false;

      if (!data?.ok) {
        els.formMsg.textContent = `Error: ${data?.error || status} ${data?.detail ? "— " + data.detail : ""}`;
        els.formMsg.className = "form-msg form-msg--err";
        return;
      }

      els.formMsg.textContent = "Created.";
      els.formMsg.className = "form-msg form-msg--ok";

      const v = data.voucher;
      const url = data.invite_url || `${SITE_URL}/invite/black-diamond/?code=${encodeURIComponent(v.code)}`;
      els.resultCode.textContent = v.code;
      els.resultUrl.value = url;
      els.resultMeta.textContent = `Type: ${v.type} · max uses: ${v.max_uses} · expires: ${fmtDate(v.expires_at)} · grants: ${JSON.stringify(v.grants)}`;
      els.result.hidden = false;

      try {
        await QRCode.toCanvas(els.resultQR, url, {
          width: 220,
          margin: 1,
          color: { dark: "#0a0a14", light: "#ffffff" },
        });
      } catch (err) {
        console.warn("QR render failed:", err);
      }

      els.result.scrollIntoView({ behavior: "smooth", block: "center" });
      loadList();
    }

    async function revokeVoucher(id) {
      if (!confirm("Revoke this voucher? Existing redemptions are kept; the code stops working.")) return;
      const { data } = await callApi({ action: "revoke", id });
      if (data?.ok) loadList();
      else alert("Revoke failed: " + (data?.error || "unknown"));
    }

    function copyText(text) {
      try {
        navigator.clipboard.writeText(text);
      } catch (_) {
        const ta = document.createElement("textarea");
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand("copy"); } catch (_) {}
        document.body.removeChild(ta);
      }
    }

    // Wire events
    els.form.addEventListener("submit", submitCreate);
    els.refresh.addEventListener("click", loadList);

    // Section toggles + inline conditional fields (data-show-if)
    els.form.addEventListener("change", (e) => {
      const t = e.target;
      if (!t) return;
      // Re-sync sections + suggest label whenever any input/select changes
      syncSectionBodies();
    });

    // Recipient name → re-suggest label
    document.getElementById("recipient_name")?.addEventListener("input", suggestLabel);

    // Track manual label edits so suggestion stops overwriting
    const labelInput = document.getElementById("label");
    if (labelInput) {
      labelInput.addEventListener("input", () => {
        labelInput.dataset.userEdited = "1";
      });
    }

    // Quick-fill preset buttons
    document.querySelectorAll("[data-preset]").forEach((btn) => {
      btn.addEventListener("click", () => {
        applyPreset(btn.getAttribute("data-preset"));
      });
    });

    // VX quick token presets (+12/+32/+80/+200)
    document.querySelectorAll("[data-preset-tokens]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const amt = parseInt(btn.getAttribute("data-preset-tokens"), 10);
        const input = els.form.querySelector('input[name="grant_tokens"]');
        if (input) {
          input.value = amt;
          // Make sure the tokens section is on
          const cb = els.form.querySelector('[data-section-toggle="tokens"]');
          if (cb) cb.checked = true;
          syncSectionBodies();
        }
      });
    });

    // Copy buttons (code + url)
    document.querySelectorAll("[data-copy]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.getAttribute("data-copy");
        const text = target === "code" ? els.resultCode.textContent : els.resultUrl.value;
        copyText(text);
        btn.textContent = "Copied";
        setTimeout(() => { btn.textContent = "Copy"; }, 1400);
      });
    });

    // Revoke button delegation
    els.tbody.addEventListener("click", (e) => {
      const btn = e.target.closest('[data-action="revoke"]');
      if (btn) revokeVoucher(btn.getAttribute("data-id"));
    });

    // Download QR
    els.downloadQR.addEventListener("click", () => {
      try {
        const link = document.createElement("a");
        link.download = `voucher-${els.resultCode.textContent}.png`;
        link.href = els.resultQR.toDataURL("image/png");
        link.click();
      } catch (err) { console.warn(err); }
    });

    // Boot
    if (!getToken()) { showOnly(els.loggedOut); }
    else { syncSectionBodies(); loadList(); }
  </script>

