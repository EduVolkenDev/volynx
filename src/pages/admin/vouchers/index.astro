---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import VxHeader from "../../../components/VxHeader.astro";
import VxFooter from "../../../components/VxFooter.astro";
import PageWidgets from "../../../components/PageWidgets.astro";
import { ROUTES } from "../../../data/routes";

const title = "Admin · Vouchers — VOLYNX";
---

<BaseLayout title={title}>
  <VxHeader primaryCtaLabel="Sign out" primaryCtaI18n="djs.sign_out" primaryCtaHref="/login/?logout=1" />
  <PageWidgets />

  <main class="admin-shell">
    <div class="container">
      <!-- Loading state -->
      <section id="adminLoading" class="admin-state">
        <p class="admin-state__text">Loading admin context...</p>
      </section>

      <!-- Not logged in -->
      <section id="adminLoggedOut" class="admin-state" hidden>
        <h1>Sign in required</h1>
        <p class="muted">The voucher admin is gated to platform admins.</p>
        <a class="btn primary" href="/login/?next=/admin/vouchers/">Sign in</a>
      </section>

      <!-- Not admin -->
      <section id="adminForbidden" class="admin-state" hidden>
        <h1>Forbidden</h1>
        <p class="muted">Your account does not have admin privileges. If this is a mistake, contact support.</p>
        <a class="btn ghost" href="/">Back to home</a>
      </section>

      <!-- Admin UI -->
      <section id="adminUI" class="admin-ui" hidden>
        <header class="admin-head">
          <div>
            <span class="kicker">Admin · Vouchers</span>
            <h1>Issue invites, discounts, kit unlocks &amp; token grants</h1>
            <p class="muted">Each voucher is a single record in the <code>vouchers</code> table. Black Diamond invites generate a personalized URL ready to share.</p>
          </div>
          <button id="refreshBtn" class="btn ghost" type="button">Refresh list</button>
        </header>

        <!-- Create form -->
        <article class="panel admin-create">
          <h2>Create voucher</h2>
          <form id="createForm" class="admin-form">
            <!-- 1) WHAT does the voucher unlock? -->
            <fieldset class="grants">
              <legend>What does this voucher unlock?</legend>

              <label class="field">
                <span>Category</span>
                <select id="type" name="type" required>
                  <option value="black_diamond">Black Diamond invite — private invitation pack</option>
                  <option value="plan">Plan upgrade — change tier</option>
                  <option value="tokens">VX tokens — credit balance</option>
                  <option value="kit">Kit unlock — Portfolio / Agency / SaaS</option>
                  <option value="icons">Icon pack unlock — premium icon set</option>
                  <option value="devjourney">Dev Journey tier — Social / Pro / Bundle</option>
                  <option value="discount">Discount % — Stripe checkout</option>
                  <option value="generic">Custom grants — raw JSON</option>
                </select>
              </label>

              <!-- BLACK DIAMOND -->
              <div class="grant-block" data-grant-for="black_diamond">
                <p class="grant-help">Private invitation pack. On redemption: sets <code>is_black_diamond=true</code>, grants 80 VX, Daily Diamond for 90 days, and 3 premium icon packs. Builder is not included. Defaults below — override per voucher.</p>
                <div class="form-row">
                  <label class="field">
                    <span>Daily plan</span>
                    <select name="grant_daily_plan_bd">
                      <option value="diamond" selected>Daily Diamond</option>
                      <option value="pro">Daily Pro</option>
                    </select>
                  </label>
                  <label class="field">
                    <span>Daily duration (days)</span>
                    <input type="number" name="grant_daily_expires_days" min="1" max="3650" value="90" />
                  </label>
                  <label class="field">
                    <span>VX tokens</span>
                    <input type="number" name="grant_bd_tokens" min="0" max="10000" value="80" />
                  </label>
                </div>
                <fieldset class="bd-packs">
                  <legend>Icon packs (3 by default)</legend>
                  <label><input type="checkbox" name="bd_pack" value="Hyper-Icons-Premium" checked> Hyper Icons Premium</label>
                  <label><input type="checkbox" name="bd_pack" value="Poligon-Premium" checked> Poligon Premium</label>
                  <label><input type="checkbox" name="bd_pack" value="metal-chrome-premium" checked> Metal Chrome Premium</label>
                  <label><input type="checkbox" name="bd_pack" value="Icons-Glass-Premium"> Icons Glass Premium</label>
                  <label><input type="checkbox" name="bd_pack" value="Iridescent-Premium"> Iridescent Premium</label>
                  <label><input type="checkbox" name="bd_pack" value="glow-premium"> Glow Premium</label>
                  <label><input type="checkbox" name="bd_pack" value="purple-icons-premium"> Purple Icons Premium</label>
                  <label><input type="checkbox" name="bd_pack" value="vintage-premium"> Vintage Premium</label>
                </fieldset>
              </div>

              <!-- PLAN -->
              <div class="grant-block" data-grant-for="plan" hidden>
                <p class="grant-help">Upgrades <code>profiles.plan</code> on redemption. Use Black Diamond if you want the BD badge too.</p>
                <div class="form-row">
                  <label class="field">
                    <span>Plan</span>
                    <select name="grant_plan">
                      <option value="launch">Launch</option>
                      <option value="business">Business</option>
                      <option value="pro" selected>Pro</option>
                      <option value="diamond">Diamond</option>
                      <option value="studio">Studio</option>
                      <option value="teams">Teams</option>
                    </select>
                  </label>
                  <label class="field">
                    <span>Affects</span>
                    <select name="grant_plan_scope">
                      <option value="plan" selected>profiles.plan (global)</option>
                      <option value="builder_plan">builder_plan only</option>
                      <option value="daily_plan">daily_plan only</option>
                      <option value="both_apps">builder + daily</option>
                    </select>
                  </label>
                </div>
              </div>

              <!-- VX TOKENS -->
              <div class="grant-block" data-grant-for="tokens" hidden>
                <p class="grant-help">Credits VX directly to the user balance. Standard packs: 12 / 32 / 80 / 200.</p>
                <label class="field">
                  <span>VX amount</span>
                  <div class="quick-presets">
                    <input type="number" name="grant_tokens" min="1" max="100000" value="32" />
                    <button type="button" class="btn ghost btn-sm" data-preset-tokens="12">+12</button>
                    <button type="button" class="btn ghost btn-sm" data-preset-tokens="32">+32</button>
                    <button type="button" class="btn ghost btn-sm" data-preset-tokens="80">+80</button>
                    <button type="button" class="btn ghost btn-sm" data-preset-tokens="200">+200</button>
                  </div>
                </label>
              </div>

              <!-- KIT -->
              <div class="grant-block" data-grant-for="kit" hidden>
                <p class="grant-help warn">⚠️ Captured in voucher. Auto-delivery via redeem-voucher ships in Phase 2 — for now, mark the user as kit owner manually after redemption.</p>
                <label class="field">
                  <span>Kit</span>
                  <select name="grant_kit_id">
                    <option value="portfolio-pro-kit">Portfolio Pro Kit</option>
                    <option value="agency-launch-kit">Agency Launch Kit</option>
                    <option value="saas-landing-system">SaaS Landing System</option>
                  </select>
                </label>
              </div>

              <!-- ICON PACK -->
              <div class="grant-block" data-grant-for="icons" hidden>
                <p class="grant-help warn">⚠️ Captured in voucher. Auto-delivery via redeem-voucher ships in Phase 2.</p>
                <label class="field">
                  <span>Icon pack</span>
                  <select name="grant_icon_pack_id">
                    <optgroup label="Premium">
                      <option value="Hyper-Icons-Premium">Hyper Icons Premium</option>
                      <option value="Icons-Glass-Premium">Icons Glass Premium</option>
                      <option value="Iridescent-Premium">Iridescent Premium</option>
                      <option value="Poligon-Premium">Poligon Premium</option>
                      <option value="glow-premium">Glow Premium</option>
                      <option value="metal-chrome-premium">Metal Chrome Premium</option>
                      <option value="purple-icons-premium">Purple Icons Premium</option>
                      <option value="vintage-premium">Vintage Premium</option>
                    </optgroup>
                    <optgroup label="Free (gift access)">
                      <option value="Abstract-Free">Abstract Free</option>
                      <option value="Day-By-Day-free">Day By Day Free</option>
                      <option value="Neon-Icons-Free">Neon Icons Free</option>
                    </optgroup>
                  </select>
                </label>
              </div>

              <!-- DEV JOURNEY -->
              <div class="grant-block" data-grant-for="devjourney" hidden>
                <p class="grant-help warn">⚠️ Captured in voucher. Auto-enrollment via redeem-voucher ships in Phase 2 (use SQL upsert into <code>devjourney_enrollments</code> manually for now).</p>
                <label class="field">
                  <span>Tier</span>
                  <select name="grant_devjourney_tier">
                    <option value="social">Social Sprint (free, but explicit grant)</option>
                    <option value="pro" selected>Pro</option>
                    <option value="bundle">Bundle</option>
                  </select>
                </label>
              </div>

              <!-- DISCOUNT -->
              <div class="grant-block" data-grant-for="discount" hidden>
                <p class="grant-help warn">⚠️ Captured in voucher. Stripe checkout integration ships in Phase 2 — to apply now, also create a matching coupon in Stripe and paste the ID.</p>
                <div class="form-row">
                  <label class="field">
                    <span>Discount %</span>
                    <input type="number" name="grant_discount_pct" min="1" max="100" value="20" />
                  </label>
                  <label class="field">
                    <span>Stripe coupon ID <small>(optional)</small></span>
                    <input type="text" name="grant_stripe_coupon_id" placeholder="coupon_xxx" />
                  </label>
                </div>
              </div>

              <!-- CUSTOM JSON -->
              <div class="grant-block" data-grant-for="generic" hidden>
                <p class="grant-help">Raw JSON. Use only if you know what redeem-voucher consumes (<code>tokens</code>, <code>plan</code>, <code>builder_plan</code>, <code>daily_plan</code>, <code>badge</code>).</p>
                <label class="field">
                  <span>Custom grants JSON</span>
                  <textarea name="grant_json" rows="4" placeholder='{"feature":"early_access"}'></textarea>
                </label>
              </div>

              <!-- Bonus tokens (combo with any category) -->
              <label class="field field--checkbox grant-bonus-toggle">
                <input id="grantBonusTokens" type="checkbox" />
                <span>Include bonus VX tokens with this voucher</span>
              </label>
              <div class="grant-block" data-grant-for="bonus_tokens" hidden>
                <label class="field">
                  <span>Bonus VX</span>
                  <input type="number" id="grantBonusAmount" min="1" max="100000" value="20" />
                </label>
              </div>
            </fieldset>

            <!-- 2) WHO is this for? -->
            <fieldset class="grants">
              <legend>Who is this for?</legend>
              <div class="form-row">
                <label class="field">
                  <span>Recipient name <small>(goes into the personalized URL ?to=)</small></span>
                  <input id="recipient_name" name="recipient_name" type="text" maxlength="80" placeholder="Maria Silva" />
                </label>
                <label class="field">
                  <span>Target email <small>(optional gate — locks redemption to this email)</small></span>
                  <input id="target_email" name="target_email" type="email" maxlength="320" placeholder="maria@example.com" />
                </label>
              </div>
              <label class="field">
                <span>Label <small>(auto-suggested from selection — edit if needed)</small></span>
                <input id="label" name="label" type="text" maxlength="200" placeholder="Auto-filled when you pick a category" />
              </label>
            </fieldset>

            <!-- 3) WHEN does it work? -->
            <fieldset class="grants">
              <legend>When does it work?</legend>
              <div class="form-row">
                <label class="field">
                  <span>Max uses</span>
                  <input id="max_uses" name="max_uses" type="number" min="1" max="100000" value="1" required />
                </label>
                <label class="field">
                  <span>Expires at <small>(optional)</small></span>
                  <input id="expires_at" name="expires_at" type="datetime-local" />
                </label>
                <label class="field field--checkbox">
                  <input id="transferable" name="transferable" type="checkbox" checked />
                  <span>Transferable (anyone with code can redeem)</span>
                </label>
              </div>
            </fieldset>

            <div class="form-actions">
              <button id="submitBtn" type="submit" class="btn primary">Create voucher</button>
              <span id="formMsg" class="form-msg" aria-live="polite"></span>
            </div>
          </form>
        </article>

        <!-- Result panel — hidden until a voucher is created -->
        <article id="resultPanel" class="panel admin-result" hidden>
          <h2>Voucher created</h2>
          <div class="result-grid">
            <div>
              <h3>Code</h3>
              <div class="code-row">
                <code id="resultCode" class="code-badge">—</code>
                <button class="btn ghost btn-sm" data-copy="code" type="button">Copy</button>
              </div>
              <h3>Personalized URL</h3>
              <div class="code-row">
                <input id="resultUrl" type="text" readonly />
                <button class="btn ghost btn-sm" data-copy="url" type="button">Copy</button>
              </div>
              <p class="muted" id="resultMeta">—</p>
            </div>
            <div class="qr-shell">
              <h3>QR code</h3>
              <canvas id="resultQR" width="220" height="220" aria-label="Personalized invite QR"></canvas>
              <button class="btn ghost btn-sm" id="downloadQR" type="button">Download PNG</button>
            </div>
          </div>
        </article>

        <!-- List -->
        <article class="panel admin-list">
          <h2>Recent vouchers</h2>
          <div class="table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Code</th>
                  <th>Type</th>
                  <th>Label</th>
                  <th>Target</th>
                  <th>Used</th>
                  <th>Status</th>
                  <th>Expires</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="vouchersBody">
                <tr><td colspan="8" class="muted">Loading…</td></tr>
              </tbody>
            </table>
          </div>
        </article>
      </section>
    </div>
  </main>

  <VxFooter />

  <script type="module">
    import QRCode from "https://cdn.jsdelivr.net/npm/qrcode@1.5.3/+esm";

    const FN_URL = "https://zdmpzrderifgqmqivjoy.supabase.co/functions/v1/admin-vouchers";
    const SITE_URL = location.origin;

    const $ = (id) => document.getElementById(id);
    const els = {
      loading: $("adminLoading"),
      loggedOut: $("adminLoggedOut"),
      forbidden: $("adminForbidden"),
      ui: $("adminUI"),
      typeSelect: $("type"),
      grantsRoot: document.querySelector(".grants"),
      form: $("createForm"),
      submitBtn: $("submitBtn"),
      formMsg: $("formMsg"),
      result: $("resultPanel"),
      resultCode: $("resultCode"),
      resultUrl: $("resultUrl"),
      resultMeta: $("resultMeta"),
      resultQR: $("resultQR"),
      downloadQR: $("downloadQR"),
      tbody: $("vouchersBody"),
      refresh: $("refreshBtn"),
    };

    function getToken() {
      try { return localStorage.getItem("volynx_access_token") || ""; } catch (_) { return ""; }
    }

    function showOnly(el) {
      [els.loading, els.loggedOut, els.forbidden, els.ui].forEach((e) => { if (e) e.hidden = e !== el; });
    }

    async function callApi(payload) {
      const token = getToken();
      const res = await fetch(FN_URL, {
        method: "POST",
        headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const text = await res.text();
      let data; try { data = JSON.parse(text); } catch (_) { data = { error: "non_json", raw: text }; }
      return { status: res.status, data };
    }

    function fmtDate(iso) {
      if (!iso) return "—";
      try { return new Date(iso).toLocaleString(); } catch (_) { return iso; }
    }

    const KIT_NAMES = {
      "portfolio-pro-kit": "Portfolio Pro Kit",
      "agency-launch-kit": "Agency Launch Kit",
      "saas-landing-system": "SaaS Landing System",
    };
    const ICON_NAMES = {
      "Hyper-Icons-Premium": "Hyper Icons Premium",
      "Icons-Glass-Premium": "Icons Glass Premium",
      "Iridescent-Premium": "Iridescent Premium",
      "Poligon-Premium": "Poligon Premium",
      "glow-premium": "Glow Premium",
      "metal-chrome-premium": "Metal Chrome Premium",
      "purple-icons-premium": "Purple Icons Premium",
      "vintage-premium": "Vintage Premium",
      "Abstract-Free": "Abstract (free)",
      "Day-By-Day-free": "Day By Day (free)",
      "Neon-Icons-Free": "Neon Icons (free)",
    };
    const PLAN_NAMES = { launch: "Launch", business: "Business", pro: "Pro", diamond: "Diamond", studio: "Studio", teams: "Teams" };
    const DJ_NAMES = { social: "Social Sprint", pro: "Pro", bundle: "Bundle" };

    function buildGrants() {
      const type = els.typeSelect.value;
      const fd = new FormData(els.form);
      let grants = {};

      if (type === "black_diamond") {
        // BD must include badge:'black_diamond' to trigger redeem-voucher's BD path.
        // Default pack: 80 VX + Daily Diamond 90 days + 3 premium icon packs. Builder NOT included.
        const dailyPlan = String(fd.get("grant_daily_plan_bd") || "diamond");
        const days = Number(fd.get("grant_daily_expires_days")) || 90;
        const tokensBd = Number(fd.get("grant_bd_tokens")) || 0;
        const packs = Array.from(els.form.querySelectorAll('input[name="bd_pack"]:checked')).map((el) => el.value);
        grants = {
          badge: "black_diamond",
          daily_plan: dailyPlan,
          daily_plan_expires_in_days: days,
          icon_pack_grants: packs,
        };
        if (tokensBd > 0) grants.tokens = tokensBd;
      } else if (type === "plan") {
        const plan = String(fd.get("grant_plan") || "pro");
        const scope = String(fd.get("grant_plan_scope") || "plan");
        if (scope === "plan") grants.plan = plan;
        else if (scope === "builder_plan") grants.builder_plan = plan;
        else if (scope === "daily_plan") grants.daily_plan = plan;
        else if (scope === "both_apps") { grants.builder_plan = plan; grants.daily_plan = plan; }
      } else if (type === "tokens") {
        grants.tokens = Number(fd.get("grant_tokens")) || 0;
      } else if (type === "kit") {
        const id = String(fd.get("grant_kit_id") || "").trim();
        grants.kit_id = id;
        if (KIT_NAMES[id]) grants.kit_name = KIT_NAMES[id];
      } else if (type === "icons") {
        const id = String(fd.get("grant_icon_pack_id") || "").trim();
        grants.icon_pack_id = id;
        if (ICON_NAMES[id]) grants.icon_pack_name = ICON_NAMES[id];
      } else if (type === "devjourney") {
        grants.devjourney_tier = String(fd.get("grant_devjourney_tier") || "pro");
      } else if (type === "discount") {
        grants.discount_pct = Number(fd.get("grant_discount_pct")) || 0;
        const c = String(fd.get("grant_stripe_coupon_id") || "").trim();
        if (c) grants.stripe_coupon_id = c;
      } else if (type === "generic") {
        try { grants = JSON.parse(String(fd.get("grant_json") || "{}")); } catch (_) { grants = {}; }
      }

      // Optional bonus tokens combo
      const bonusOn = document.getElementById("grantBonusTokens")?.checked;
      const bonusAmt = Number(document.getElementById("grantBonusAmount")?.value || 0);
      if (bonusOn && bonusAmt > 0) {
        grants.tokens = (grants.tokens || 0) + bonusAmt;
      }

      return grants;
    }

    function suggestLabel() {
      const labelInput = document.getElementById("label");
      if (!labelInput) return;
      // Don't overwrite if admin already typed something
      if (labelInput.dataset.userEdited === "1") return;

      const type = els.typeSelect.value;
      const fd = new FormData(els.form);
      const recipient = String(fd.get("recipient_name") || "").trim();
      const recipientSuffix = recipient ? ` — ${recipient}` : "";
      let base = "";

      if (type === "black_diamond") base = "Black Diamond";
      else if (type === "plan") {
        const plan = String(fd.get("grant_plan") || "pro");
        base = `${PLAN_NAMES[plan] || plan} plan`;
      } else if (type === "tokens") {
        const n = Number(fd.get("grant_tokens")) || 0;
        base = `${n} VX bonus`;
      } else if (type === "kit") {
        const id = String(fd.get("grant_kit_id") || "");
        base = `${KIT_NAMES[id] || "Kit"} unlock`;
      } else if (type === "icons") {
        const id = String(fd.get("grant_icon_pack_id") || "");
        base = `${ICON_NAMES[id] || "Icon pack"}`;
      } else if (type === "devjourney") {
        const t = String(fd.get("grant_devjourney_tier") || "pro");
        base = `Dev Journey ${DJ_NAMES[t] || t}`;
      } else if (type === "discount") {
        const pct = Number(fd.get("grant_discount_pct")) || 0;
        base = `${pct}% discount`;
      } else if (type === "generic") {
        base = "Custom voucher";
      }

      labelInput.value = base + recipientSuffix;
    }

    function syncGrantBlocks() {
      const t = els.typeSelect.value;
      els.grantsRoot.querySelectorAll("[data-grant-for]").forEach((el) => {
        const cat = el.getAttribute("data-grant-for");
        if (cat === "bonus_tokens") return; // handled by checkbox toggle
        el.hidden = cat !== t;
      });
      suggestLabel();
    }

    async function loadList() {
      const { status, data } = await callApi({ action: "list", limit: 100 });
      if (status === 401) { showOnly(els.loggedOut); return; }
      if (status === 403) { showOnly(els.forbidden); return; }
      if (!data?.ok) { els.tbody.innerHTML = `<tr><td colspan="8" class="muted">Error: ${data?.error || status}</td></tr>`; return; }
      showOnly(els.ui);
      renderList(data.items || []);
    }

    function renderList(items) {
      if (items.length === 0) {
        els.tbody.innerHTML = `<tr><td colspan="8" class="muted">No vouchers yet. Create one above.</td></tr>`;
        return;
      }
      els.tbody.innerHTML = items.map((v) => {
        const expired = v.expires_at && new Date(v.expires_at) < new Date();
        const exhausted = v.times_used >= v.max_uses;
        const status = !v.active
          ? `<span class="pill pill--off">revoked</span>`
          : expired
          ? `<span class="pill pill--off">expired</span>`
          : exhausted
          ? `<span class="pill pill--off">exhausted</span>`
          : `<span class="pill pill--on">active</span>`;
        return `<tr>
          <td><code>${escapeHtml(v.code)}</code></td>
          <td>${escapeHtml(v.type)}</td>
          <td>${escapeHtml(v.label || "—")}</td>
          <td>${escapeHtml(v.target_email || "—")}</td>
          <td>${v.times_used}/${v.max_uses}</td>
          <td>${status}</td>
          <td>${fmtDate(v.expires_at)}</td>
          <td><button class="btn ghost btn-sm" data-action="revoke" data-id="${escapeHtml(v.id)}" ${!v.active ? "disabled" : ""}>Revoke</button></td>
        </tr>`;
      }).join("");
    }

    function escapeHtml(s) {
      return String(s ?? "").replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#039;"}[c]));
    }

    async function submitCreate(e) {
      e.preventDefault();
      els.submitBtn.disabled = true;
      els.formMsg.textContent = "Creating…";
      els.formMsg.className = "form-msg form-msg--info";

      const fd = new FormData(els.form);
      const payload = {
        action: "create",
        type: els.typeSelect.value,
        label: fd.get("label") || null,
        description: null,
        recipient_name: fd.get("recipient_name") || null,
        target_email: fd.get("target_email") || null,
        max_uses: Number(fd.get("max_uses")) || 1,
        transferable: fd.get("transferable") === "on",
        expires_at: fd.get("expires_at") || null,
        grants: buildGrants(),
      };

      const { status, data } = await callApi(payload);
      els.submitBtn.disabled = false;

      if (!data?.ok) {
        els.formMsg.textContent = `Error: ${data?.error || status} ${data?.detail ? "— " + data.detail : ""}`;
        els.formMsg.className = "form-msg form-msg--err";
        return;
      }

      els.formMsg.textContent = "Created.";
      els.formMsg.className = "form-msg form-msg--ok";

      const v = data.voucher;
      const url = data.invite_url || `${SITE_URL}/invite/black-diamond/?code=${encodeURIComponent(v.code)}`;
      els.resultCode.textContent = v.code;
      els.resultUrl.value = url;
      els.resultMeta.textContent = `Type: ${v.type} · max uses: ${v.max_uses} · expires: ${fmtDate(v.expires_at)} · grants: ${JSON.stringify(v.grants)}`;
      els.result.hidden = false;

      try {
        await QRCode.toCanvas(els.resultQR, url, {
          width: 220,
          margin: 1,
          color: { dark: "#0a0a14", light: "#ffffff" },
        });
      } catch (err) {
        console.warn("QR render failed:", err);
      }

      els.result.scrollIntoView({ behavior: "smooth", block: "center" });
      loadList();
    }

    async function revokeVoucher(id) {
      if (!confirm("Revoke this voucher? Existing redemptions are kept; the code stops working.")) return;
      const { data } = await callApi({ action: "revoke", id });
      if (data?.ok) loadList();
      else alert("Revoke failed: " + (data?.error || "unknown"));
    }

    function copyText(text) {
      try {
        navigator.clipboard.writeText(text);
      } catch (_) {
        const ta = document.createElement("textarea");
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand("copy"); } catch (_) {}
        document.body.removeChild(ta);
      }
    }

    // Wire events
    els.typeSelect.addEventListener("change", syncGrantBlocks);
    els.form.addEventListener("submit", submitCreate);
    els.refresh.addEventListener("click", loadList);

    // Auto-suggest label whenever recipient or relevant grant fields change
    document.getElementById("recipient_name")?.addEventListener("input", suggestLabel);
    els.form.addEventListener("change", (e) => {
      const t = e.target;
      if (!t || !t.name) return;
      if (t.name.startsWith("grant_") || t.id === "type") suggestLabel();
    });

    // Track manual label edits so suggestion stops overwriting
    const labelInput = document.getElementById("label");
    if (labelInput) {
      labelInput.addEventListener("input", () => {
        labelInput.dataset.userEdited = "1";
      });
    }

    // Bonus tokens toggle
    const bonusToggle = document.getElementById("grantBonusTokens");
    const bonusBlock = els.grantsRoot.querySelector('[data-grant-for="bonus_tokens"]');
    if (bonusToggle && bonusBlock) {
      bonusToggle.addEventListener("change", () => {
        bonusBlock.hidden = !bonusToggle.checked;
      });
    }

    // VX quick presets
    document.querySelectorAll("[data-preset-tokens]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const amt = parseInt(btn.getAttribute("data-preset-tokens"), 10);
        const input = els.form.querySelector('input[name="grant_tokens"]');
        if (input) { input.value = amt; suggestLabel(); }
      });
    });
    document.querySelectorAll("[data-copy]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.getAttribute("data-copy");
        const text = target === "code" ? els.resultCode.textContent : els.resultUrl.value;
        copyText(text);
        btn.textContent = "Copied";
        setTimeout(() => { btn.textContent = "Copy"; }, 1400);
      });
    });
    els.tbody.addEventListener("click", (e) => {
      const btn = e.target.closest('[data-action="revoke"]');
      if (btn) revokeVoucher(btn.getAttribute("data-id"));
    });
    els.downloadQR.addEventListener("click", () => {
      try {
        const link = document.createElement("a");
        link.download = `voucher-${els.resultCode.textContent}.png`;
        link.href = els.resultQR.toDataURL("image/png");
        link.click();
      } catch (err) { console.warn(err); }
    });

    // Boot
    if (!getToken()) { showOnly(els.loggedOut); }
    else { syncGrantBlocks(); loadList(); }
  </script>

