              <label class="codes-check codes-check--inline">
                <input type="checkbox" data-voucher-field="transferable" ${voucher.transferable ? "checked" : ""} />
                <span>${escapeHtml(t("admin.codes.transferable_label", "Transferable"))}</span>
              </label>
            </div>
            <div class="codes-row-actions">
              <button class="codes-btn ghost" type="button" data-copy-value="${escapeHtml(voucher.code)}">${escapeHtml(t("admin.codes.copy", "Copy"))}</button>
              <button class="codes-btn primary" type="button" data-voucher-action="save">${escapeHtml(t("admin.codes.save_controls", "Save controls"))}</button>
              <button class="codes-btn ghost" type="button" data-voucher-action="never">${escapeHtml(t("admin.codes.no_expiry", "No expiry"))}</button>
              <button class="codes-btn ${inactive ? "ghost" : "danger"}" type="button" data-voucher-action="toggle-active">${escapeHtml(inactive ? t("admin.codes.reactivate", "Reactivate") : t("admin.codes.revoke", "Revoke"))}</button>
            </div>
          </article>`;
      }).join("");
    }

    function voucherPatchFromRow(row) {
      const maxUses = Number(row.querySelector('[data-voucher-field="max_uses"]')?.value || 1);
      return {
        label: String(row.querySelector('[data-voucher-field="label"]')?.value || "").trim() || null,
        target_email: String(row.querySelector('[data-voucher-field="target_email"]')?.value || "").trim().toLowerCase() || null,
        max_uses: Number.isFinite(maxUses) ? maxUses : 1,
        expires_at: inputToIso(row.querySelector('[data-voucher-field="expires_at"]')?.value || ""),
        transferable: row.querySelector('[data-voucher-field="transferable"]')?.checked === true,
      };
    }

    async function updateVoucher(id, patch) {
      const data = await voucherApi({ action: "update", id, ...patch });
      if (!data?.ok) throw new Error(data?.detail || data?.error || t("admin.codes.err_update_voucher", "Could not update voucher."));
      await loadVouchers();
      renderRecent();
    }

    async function revokeVoucher(id) {
      const voucher = lastVoucherRows.find((item) => item.id === id);
      const name = voucher?.label || voucher?.code || t("admin.codes.this_code", "this code");
      const ok = confirm(t("admin.codes.confirm_revoke_voucher", `Delete/revoke "{name}"? The access code will stop working. Existing redemption history is kept.`, { name }));
      if (!ok) return;
      const data = await voucherApi({ action: "revoke", id });
      if (!data?.ok) throw new Error(data?.detail || data?.error || t("admin.codes.err_revoke_voucher", "Could not revoke voucher."));
      await loadVouchers();
      renderRecent();
    }

    function renderRecent() {
      const entries = [
        ...lastQrRows.slice(0, 5).map((qr) => ({ kind: "QR", label: qr.label || qr.slug, detail: `${QR_HOST}/${qr.slug}`, status: qr.status })),
        ...lastVoucherRows.slice(0, 5).map((voucher) => ({ kind: t("admin.codes.voucher", "Voucher"), label: voucher.label || voucher.type, detail: voucher.code, status: voucher.active ? "active" : "inactive" })),
      ].slice(0, 10);
      if (!entries.length) {
        el.recentRows.innerHTML = `<div class="codes-empty">${escapeHtml(t("admin.codes.no_recent", "No recent codes loaded yet."))}</div>`;
        updateTabCounts();
        return;
      }
      el.recentRows.innerHTML = entries.map((item) => `
        <article class="codes-row">
          <div class="codes-row-main">
            <span class="codes-pill codes-pill--neutral">${escapeHtml(item.kind)}</span>
            <strong>${escapeHtml(item.label)}</strong>
            <code>${escapeHtml(item.detail)}</code>
          </div>
          <div class="codes-row-meta">
            <span>${escapeHtml(statusLabel(item.status))}</span>
          </div>
        </article>
      `).join("");
      updateTabCounts();
    }

    async function copyText(value) {
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        const textarea = document.createElement("textarea");
        textarea.value = value;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand("copy");
        textarea.remove();
      }
    }

    function downloadCanvas(canvas, name) {
      const link = document.createElement("a");
      link.download = name;
      link.href = canvas.toDataURL("image/png");
      link.click();
    }

    async function downloadCreatedQr() {
      const shortUrl = el.qrCanvas.dataset.qrUrl || el.qrShortUrl.value || lastGeneratedQrUrl;
      if (!shortUrl) return;
      await QRCode.toCanvas(el.qrCanvas, shortUrl, QR_CANVAS_OPTIONS);
      downloadCanvas(el.qrCanvas, `volynx-qr-${Date.now()}.png`);
    }

    function activateTab(tab, updateUrl = true) {
      const allowed = new Set(["qr", "vouchers", "recent"]);
      const nextTab = allowed.has(tab) ? tab : "qr";
      document.querySelectorAll("[data-tab]").forEach((item) => item.classList.toggle("is-active", item.dataset.tab === nextTab));
      document.querySelectorAll("[data-panel]").forEach((panel) => panel.classList.toggle("is-active", panel.dataset.panel === nextTab));
      if (updateUrl) {
        const url = new URL(location.href);
        url.searchParams.set("tab", nextTab);
        history.replaceState(null, "", url);
      }
    }

    function bindTabs() {
      document.querySelectorAll("[data-tab], [data-tab-jump]").forEach((button) => {
        button.addEventListener("click", () => {
          activateTab(button.dataset.tab || button.dataset.tabJump || "qr");
        });
      });
      const initialTab = new URLSearchParams(location.search).get("tab") || (location.hash || "").replace("#", "");
      activateTab(initialTab, false);
    }

    function bindEvents() {
      bindTabs();
      let searchTimer = null;
      el.qrCreateForm.addEventListener("submit", createQr);
      el.qrLoadBtn.addEventListener("click", loadQrs);
      el.qrRefreshList.addEventListener("click", loadQrs);
      el.qrRows.addEventListener("click", handleQrAction);
      el.qrStatusFilter.addEventListener("change", loadQrs);
      el.qrSearch.addEventListener("input", () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(loadQrs, 350);
      });
      el.qrSearch.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          clearTimeout(searchTimer);
          loadQrs();
        }
      });
      el.qrDownloadPng.addEventListener("click", downloadCreatedQr);
      el.voucherForm.addEventListener("submit", createVoucher);
      el.voucherLoadBtn.addEventListener("click", loadVouchers);
      el.voucherRows.addEventListener("click", async (event) => {
        const button = event.target.closest("[data-copy-value]");
        if (button) await copyText(button.dataset.copyValue || "");
        const actionButton = event.target.closest("[data-voucher-action]");
        if (actionButton) {
          actionButton.disabled = true;
          try {
            const row = actionButton.closest("[data-voucher-id]");
            const id = row?.dataset.voucherId || "";
            const voucher = lastVoucherRows.find((item) => item.id === id);
            if (actionButton.dataset.voucherAction === "save") {
              await updateVoucher(id, voucherPatchFromRow(row));
            } else if (actionButton.dataset.voucherAction === "never") {
              await updateVoucher(id, { expires_at: null });
            } else if (actionButton.dataset.voucherAction === "toggle-active") {
              if (voucher?.active) {
                await revokeVoucher(id);
              } else {
                const ok = confirm(t("admin.codes.confirm_reactivate_voucher", `Reactivate "{name}"?`, { name: voucher?.label || voucher?.code || t("admin.codes.this_code", "this code") }));
                if (!ok) return;
                await updateVoucher(id, { active: true });
              }
            }
          } catch (err) {
            alert(err.message || String(err));
          } finally {
            actionButton.disabled = false;
          }
        }
      });
      document.addEventListener("click", async (event) => {
        const targetId = event.target.closest("[data-copy-target]")?.dataset.copyTarget;
        const value = targetId ? $(targetId)?.value : "";
        if (value) await copyText(value);
        const raw = event.target.closest("[data-copy-value]")?.dataset.copyValue;
        if (raw) await copyText(raw);
      });
      el.voucherDownloadPng.addEventListener("click", () => downloadCanvas(el.voucherCanvas, `voucher-${el.voucherCode.textContent}.png`));
      el.recentRefresh.addEventListener("click", async () => {
        await Promise.allSettled([loadQrs(), loadVouchers()]);
        renderRecent();
      });
      window.addEventListener("vx:lang-changed", () => {
        renderQrs(lastQrRows);
        renderVouchers(lastVoucherRows);
        renderRecent();
        updateTabCounts();
      });
    }

    async function init() {
      bindEvents();
      const role = await checkAdmin();
      if (role === "logged_out") {
        showOnly(el.loggedOut);
        return;
      }
      if (role !== "admin") {
        showOnly(el.forbidden);
        return;
      }
      showOnly(el.console);
      await Promise.allSettled([loadQrs(), loadVouchers()]);
      renderRecent();
    }

    init().catch((err) => {
      console.error("[codes-console]", err);
      showOnly(el.forbidden);
    });
  </script>

