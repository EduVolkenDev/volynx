---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import VxHeader from "../../../components/VxHeader.astro";
import VxFooter from "../../../components/VxFooter.astro";
import PageWidgets from "../../../components/PageWidgets.astro";
import { ROUTES } from "../../../data/routes";

const title = "Admin · Codes — VOLYNX";
const description = "Unified admin console for dynamic QR codes, voucher links and access codes.";
---

<BaseLayout title={title} description={description}>
  <VxHeader primaryCtaLabel="Sign out" primaryCtaI18n="djs.sign_out" primaryCtaHref="/login/?logout=1" primaryCtaAuth="in" />
  <PageWidgets hideUtilBar />

  <main class="codes-shell">
    <section id="codesLoading" class="codes-state">
      <p data-i18n="admin.codes.loading_console">Loading access console...</p>
    </section>

    <section id="codesLoggedOut" class="codes-state" hidden>
      <h1 data-i18n="admin.codes.login_required">Sign in required</h1>
      <p data-i18n="admin.codes.login_msg">The access console is gated to platform admins.</p>
      <a class="codes-btn primary" href={`${ROUTES.login}?next=${ROUTES.adminCodes}`} data-i18n="admin.codes.sign_in">Sign in</a>
    </section>

    <section id="codesForbidden" class="codes-state" hidden>
      <h1 data-i18n="admin.codes.forbidden">Forbidden</h1>
      <p data-i18n="admin.codes.forbidden_msg">Your account does not have admin privileges.</p>
      <a class="codes-btn ghost" href={ROUTES.home} data-i18n="admin.codes.back_home">Back to home</a>
    </section>

    <section id="codesConsole" class="codes-console" hidden>
      <header class="codes-hero">
        <div class="codes-hero-main">
          <span class="codes-appmark" aria-hidden="true">AC</span>
          <div>
            <span class="codes-kicker" data-i18n="admin.codes.hero_kicker">Admin · Codes</span>
            <h1 data-i18n="admin.codes.hero_title">Access Console</h1>
            <p data-i18n="admin.codes.hero_subtitle">QR links, vouchers and client handoff codes in one operational surface.</p>
          </div>
        </div>
        <div class="codes-hero-actions">
          <a class="codes-btn ghost" href={ROUTES.qrgen} data-i18n="admin.codes.action_designer">Styled QR designer</a>
          <button class="codes-btn ghost" type="button" data-tab-jump="qr" data-i18n="admin.codes.action_qr_workspace">QR workspace</button>
          <button class="codes-btn ghost" type="button" data-tab-jump="vouchers" data-i18n="admin.codes.action_voucher_workspace">Voucher workspace</button>
        </div>
      </header>

      <nav class="codes-tabs" aria-label="Code admin sections" data-i18n-aria="admin.codes.tabs_aria">
        <button class="codes-tab is-active" type="button" data-tab="qr">
          <span class="codes-tab__icon" aria-hidden="true">QR</span>
          <span><strong data-i18n="admin.codes.tab_qr">QR Codes</strong><small data-count-for="qr" data-i18n="admin.codes.tab_qr_desc">Dynamic links</small></span>
        </button>
        <button class="codes-tab" type="button" data-tab="vouchers">
          <span class="codes-tab__icon" aria-hidden="true">GR</span>
          <span><strong data-i18n="admin.codes.tab_vouchers">Vouchers</strong><small data-count-for="vouchers" data-i18n="admin.codes.tab_vouchers_desc">Invites & grants</small></span>
        </button>
        <button class="codes-tab" type="button" data-tab="recent">
          <span class="codes-tab__icon" aria-hidden="true">IN</span>
          <span><strong data-i18n="admin.codes.tab_recent">Recent</strong><small data-count-for="recent" data-i18n="admin.codes.tab_recent_desc">Snapshot</small></span>
        </button>
      </nav>

      <section class="codes-status-grid" aria-label="Access console status" data-i18n-aria="admin.codes.status_aria">
        <div class="codes-status-card">
          <span data-i18n="admin.codes.status_admin">Admin</span>
          <strong id="codesAdminName" data-i18n="admin.codes.checking">Checking...</strong>
        </div>
        <div class="codes-status-card">
          <span data-i18n="admin.codes.status_qr">QR state</span>
          <strong id="codesQrState" data-i18n="admin.codes.idle">Idle</strong>
        </div>
        <div class="codes-status-card">
          <span data-i18n="admin.codes.status_voucher">Voucher state</span>
          <strong id="codesVoucherState" data-i18n="admin.codes.idle">Idle</strong>
        </div>
        <div class="codes-status-card">
          <span data-i18n="admin.codes.status_refresh">Last refresh</span>
          <strong id="codesLastRefresh" data-i18n="admin.codes.not_loaded">Not loaded</strong>
        </div>
      </section>

      <section class="codes-panel is-active" data-panel="qr">
        <div class="codes-grid codes-grid--primary">
          <article class="codes-card codes-card--create">
            <div class="codes-card-head">
              <span data-i18n="admin.codes.dynamic_qr">Dynamic QR</span>
              <strong data-i18n="admin.codes.print_safe">Print-safe link</strong>
            </div>
            <form id="qrCreateForm" class="codes-form">
              <label>
                <span data-i18n="admin.codes.destination_url">Destination URL</span>
                <input id="qrTarget" type="text" placeholder="client-site.com" data-i18n-placeholder="admin.codes.ph_client_site" autocomplete="url" inputmode="url" required />
              </label>
              <div class="codes-form-row">
                <label>
                  <span data-i18n="admin.codes.label">Label</span>
                  <input id="qrLabel" type="text" maxlength="100" placeholder="Client banner" data-i18n-placeholder="admin.codes.ph_client_banner" />
                </label>
                <label>
                  <span data-i18n="admin.codes.custom_slug">Custom slug</span>
                  <input id="qrSlug" type="text" maxlength="32" placeholder="optional" data-i18n-placeholder="admin.codes.ph_optional" />
                </label>
              </div>
              <label>
                <span data-i18n="admin.codes.qr_validity">QR validity</span>
                <select id="qrValidity">
                  <option value="1m" data-i18n="admin.codes.qr_validity_1_month" selected>1 month</option>
                  <option value="3m" data-i18n="admin.codes.qr_validity_3_months">3 months</option>
                  <option value="6m" data-i18n="admin.codes.qr_validity_6_months">6 months</option>
                  <option value="1y" data-i18n="admin.codes.qr_validity_1_year">1 year</option>
                  <option value="never" data-i18n="admin.codes.never_expires">Never expires</option>
                </select>
              </label>
              <button id="qrCreateBtn" class="codes-btn primary" type="submit" data-i18n="admin.codes.create_qr">Create QR</button>
              <p id="qrCreateMsg" class="codes-msg" aria-live="polite"></p>
            </form>
          </article>

          <article id="qrResult" class="codes-card codes-card--result" hidden>
            <div class="codes-card-head">
              <span data-i18n="admin.codes.ready">Ready</span>
              <strong data-i18n="admin.codes.test_before_print">Test before print</strong>
            </div>
            <div class="codes-result-url">
              <input id="qrShortUrl" type="text" readonly />
              <button class="codes-btn ghost" type="button" data-copy-target="qrShortUrl" data-i18n="admin.codes.copy">Copy</button>
            </div>
            <div class="codes-preview">
              <canvas id="qrCanvas" width="360" height="360" aria-label="Generated QR code" data-i18n-aria="admin.codes.generated_qr_aria"></canvas>
            </div>
            <div class="codes-result-actions">
              <a id="qrOpenLink" class="codes-btn ghost" href="#" target="_blank" rel="noopener" data-i18n="admin.codes.open">Open</a>
              <button id="qrDownloadPng" class="codes-btn ghost" type="button" data-i18n="admin.codes.download_png">Download PNG</button>
              <button id="qrRefreshList" class="codes-btn ghost" type="button" data-i18n="admin.codes.refresh_list">Refresh list</button>
            </div>
          </article>
        </div>

        <article class="codes-card">
          <div class="codes-list-head">
            <div>
              <span class="codes-kicker" data-i18n="admin.codes.qr_inventory">QR Inventory</span>
              <h2 data-i18n="admin.codes.live_qr_codes">Live QR codes</h2>
            </div>
            <div class="codes-filter">
              <select id="qrStatusFilter">
                <option value="" data-i18n="admin.codes.filter_all">All</option>
                <option value="active" data-i18n="admin.codes.status_active">Active</option>
                <option value="paused" data-i18n="admin.codes.status_paused">Paused</option>
                <option value="grace" data-i18n="admin.codes.status_grace">Grace</option>
                <option value="expired" data-i18n="admin.codes.status_expired">Expired</option>
                <option value="admin_blocked" data-i18n="admin.codes.status_blocked">Blocked</option>
              </select>
              <input id="qrSearch" type="search" placeholder="slug, label, URL or owner" data-i18n-placeholder="admin.codes.ph_search" />
              <button id="qrLoadBtn" class="codes-btn ghost" type="button" data-i18n="admin.codes.refresh">Refresh</button>
            </div>
          </div>
          <div id="qrRows" class="codes-rows"></div>
        </article>
      </section>

      <section class="codes-panel" data-panel="vouchers">
        <div class="codes-grid">
          <article class="codes-card">
            <div class="codes-card-head">
              <span data-i18n="admin.codes.voucher">Voucher</span>
              <strong data-i18n="admin.codes.quick_issue">Quick issue</strong>
            </div>
            <form id="voucherForm" class="codes-form">
              <label>
                <span data-i18n="admin.codes.preset">Preset</span>
                <select id="voucherPreset">
                  <option value="black_diamond" data-i18n="admin.codes.preset_black_diamond">Black Diamond pack</option>
                  <option value="vx_80" data-i18n="admin.codes.preset_vx_80">80 VX bonus</option>
                  <option value="pro_perm" data-i18n="admin.codes.preset_pro_perm">Pro plan permanent</option>
                  <option value="diamond_90" data-i18n="admin.codes.preset_diamond_90">Daily Diamond 90d</option>
                </select>
              </label>
              <div class="codes-form-row">
                <label>
                  <span data-i18n="admin.codes.recipient">Recipient</span>
                  <input id="voucherRecipient" type="text" maxlength="80" placeholder="Client name" data-i18n-placeholder="admin.codes.ph_client_name" />
                </label>
                <label>
                  <span data-i18n="admin.codes.email_gate">Email gate</span>
                  <input id="voucherEmail" type="email" maxlength="320" placeholder="optional" data-i18n-placeholder="admin.codes.ph_optional" />
                </label>
              </div>
              <label>
                <span data-i18n="admin.codes.label">Label</span>
                <input id="voucherLabel" type="text" maxlength="200" placeholder="Auto-generated if empty" data-i18n-placeholder="admin.codes.ph_auto_label" />
              </label>
              <button id="voucherCreateBtn" class="codes-btn primary" type="submit" data-i18n="admin.codes.create_voucher">Create voucher</button>
              <p id="voucherMsg" class="codes-msg" aria-live="polite"></p>
            </form>
          </article>

          <article id="voucherResult" class="codes-card codes-card--result" hidden>
            <div class="codes-card-head">
              <span data-i18n="admin.codes.voucher_created">Voucher created</span>
              <strong data-i18n="admin.codes.share_link">Share link</strong>
            </div>
            <div class="codes-result-url">
              <input id="voucherUrl" type="text" readonly />
              <button class="codes-btn ghost" type="button" data-copy-target="voucherUrl" data-i18n="admin.codes.copy">Copy</button>
            </div>
            <div class="codes-preview">
              <canvas id="voucherCanvas" width="320" height="320" aria-label="Voucher QR code" data-i18n-aria="admin.codes.voucher_qr_aria"></canvas>
            </div>
            <div class="codes-result-actions">
              <code id="voucherCode" class="codes-code">-</code>
              <button id="voucherDownloadPng" class="codes-btn ghost" type="button" data-i18n="admin.codes.download_png">Download PNG</button>
            </div>
          </article>
        </div>

        <article class="codes-card">
          <div class="codes-list-head">
            <div>
              <span class="codes-kicker" data-i18n="admin.codes.voucher_inventory">Voucher Inventory</span>
              <h2 data-i18n="admin.codes.recent_vouchers">Recent vouchers</h2>
            </div>
            <button id="voucherLoadBtn" class="codes-btn ghost" type="button" data-i18n="admin.codes.refresh">Refresh</button>
          </div>
          <div id="voucherRows" class="codes-rows"></div>
        </article>
      </section>

      <section class="codes-panel" data-panel="recent">
        <article class="codes-card">
          <div class="codes-list-head">
            <div>
              <span class="codes-kicker" data-i18n="admin.codes.recent">Recent</span>
              <h2 data-i18n="admin.codes.operational_snapshot">Operational snapshot</h2>
            </div>
            <button id="recentRefresh" class="codes-btn ghost" type="button" data-i18n="admin.codes.refresh_all">Refresh all</button>
          </div>
          <div id="recentRows" class="codes-rows"></div>
        </article>
      </section>
    </section>
  </main>

  <VxFooter />

  <script is:inline src="/js/vx-auth-bridge.js"></script>
  <script is:inline src="/js/vx-token-refresh.js?v=20260515-codes-console"></script>
  <script>
    import QRCode from "qrcode";

    const QR_HOST = "https://qr.volynx.world";
    const VOUCHER_FN_URL = "https://zdmpzrderifgqmqivjoy.supabase.co/functions/v1/admin-vouchers";
    const SLUG_ALPHABET = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    const $ = (id) => document.getElementById(id);

    let cfg = null;
    let currentUser = null;
    let isAdmin = false;
    let lastQrRows = [];
    let lastVoucherRows = [];
    let lastGeneratedQrUrl = "";

    const QR_CANVAS_OPTIONS = {
      width: 360,
      margin: 2,
      errorCorrectionLevel: "H",
      color: { dark: "#05060a", light: "#ffffff" },
    };

    const el = {
      loading: $("codesLoading"),
      loggedOut: $("codesLoggedOut"),
      forbidden: $("codesForbidden"),
      console: $("codesConsole"),
      qrCreateForm: $("qrCreateForm"),
      qrTarget: $("qrTarget"),
      qrLabel: $("qrLabel"),
      qrSlug: $("qrSlug"),
      qrValidity: $("qrValidity"),
      qrCreateBtn: $("qrCreateBtn"),
      qrCreateMsg: $("qrCreateMsg"),
      qrResult: $("qrResult"),
      qrShortUrl: $("qrShortUrl"),
      qrCanvas: $("qrCanvas"),
      qrOpenLink: $("qrOpenLink"),
      qrDownloadPng: $("qrDownloadPng"),
      qrLoadBtn: $("qrLoadBtn"),
      qrRefreshList: $("qrRefreshList"),
      qrRows: $("qrRows"),
      qrStatusFilter: $("qrStatusFilter"),
      qrSearch: $("qrSearch"),
      voucherForm: $("voucherForm"),
      voucherPreset: $("voucherPreset"),
      voucherRecipient: $("voucherRecipient"),
      voucherEmail: $("voucherEmail"),
      voucherLabel: $("voucherLabel"),
      voucherCreateBtn: $("voucherCreateBtn"),
      voucherMsg: $("voucherMsg"),
      voucherResult: $("voucherResult"),
      voucherUrl: $("voucherUrl"),
      voucherCode: $("voucherCode"),
      voucherCanvas: $("voucherCanvas"),
      voucherDownloadPng: $("voucherDownloadPng"),
      voucherLoadBtn: $("voucherLoadBtn"),
      voucherRows: $("voucherRows"),
      recentRows: $("recentRows"),
      recentRefresh: $("recentRefresh"),
      codesAdminName: $("codesAdminName"),
      codesQrState: $("codesQrState"),
      codesVoucherState: $("codesVoucherState"),
      codesLastRefresh: $("codesLastRefresh"),
    };

    function t(key, fallback, vars = {}) {
      const raw = window.VxI18n?.t ? window.VxI18n.t(key, fallback) : fallback;
      return String(raw).replace(/\{(\w+)\}/g, (_, name) => (
        Object.prototype.hasOwnProperty.call(vars, name) ? String(vars[name]) : `{${name}}`
      ));
    }

    function statusLabel(status) {
      const key = String(status || "neutral").replace(/[^a-z0-9_]/gi, "_");
      return t(`admin.codes.status_${key}`, String(status || "").replace("_", " "));
    }

    function voucherPresetLabel(preset) {
      const map = {
        black_diamond: "admin.codes.preset_black_diamond",
        vx_80: "admin.codes.preset_vx_80",
        pro_perm: "admin.codes.preset_pro_perm",
        diamond_90: "admin.codes.preset_diamond_90",
      };
      return t(map[preset] || "admin.codes.preset_diamond_90", preset);
    }

    function showOnly(node) {
      [el.loading, el.loggedOut, el.forbidden, el.console].forEach((item) => {
        if (item) item.hidden = item !== node;
      });
    }

    function setMsg(node, message, tone = "") {
      if (!node) return;
      node.textContent = message || "";
      node.dataset.tone = tone;
    }

    function setState(node, message) {
      if (node) node.textContent = message;
    }

    function markRefresh() {
      setState(el.codesLastRefresh, new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }));
    }

    function updateTabCounts() {
      const qrCount = document.querySelector('[data-count-for="qr"]');
      const voucherCount = document.querySelector('[data-count-for="vouchers"]');
      const recentCount = document.querySelector('[data-count-for="recent"]');
      if (qrCount) qrCount.textContent = lastQrRows.length
        ? t("admin.codes.count_qr", "{count} dynamic links", { count: lastQrRows.length })
        : t("admin.codes.tab_qr_desc", "Dynamic links");
      if (voucherCount) voucherCount.textContent = lastVoucherRows.length
        ? t("admin.codes.count_vouchers", "{count} vouchers", { count: lastVoucherRows.length })
        : t("admin.codes.tab_vouchers_desc", "Invites & grants");
      if (recentCount) recentCount.textContent = Math.min(lastQrRows.length + lastVoucherRows.length, 10)
        ? t("admin.codes.count_loaded", "{count} loaded", { count: Math.min(lastQrRows.length + lastVoucherRows.length, 10) })
        : t("admin.codes.tab_recent_desc", "Snapshot");
    }

    function escapeHtml(value) {
      return String(value ?? "").replace(/[&<>"']/g, (c) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
      }[c]));
    }

    function toInputValue(iso) {
      if (!iso) return "";
      const date = new Date(iso);
      if (Number.isNaN(date.getTime())) return "";
      const shifted = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
      return shifted.toISOString().slice(0, 16);
    }

    function inputToIso(value) {
      if (!value) return null;
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? null : date.toISOString();
    }

    function decodeJwtPayload(jwt) {
      try {
        const part = String(jwt || "").split(".")[1];
        if (!part) return null;
        const norm = part.replace(/-/g, "+").replace(/_/g, "/");
        return JSON.parse(atob(norm.padEnd(norm.length + (4 - norm.length % 4) % 4, "=")));
      } catch {
        return null;
      }
    }

    async function loadConfig() {
      if (cfg) return cfg;
      const res = await fetch("/config.json", { cache: "no-store" });
      const json = await res.json();
      cfg = {
        url: (json.supabaseUrl || json.supabase_url || "").replace(/\/$/, ""),
        anon: json.supabaseAnonKey || json.anonKey || "",
      };
      return cfg;
    }

    async function getSession() {
      if (window.VxAuthBridge?.hydrate) window.VxAuthBridge.hydrate();
      if (window.vxEnsureFreshToken) await window.vxEnsureFreshToken().catch(() => null);

      const raw = localStorage.getItem("volynx_session");
      const stored = raw ? JSON.parse(raw) : {};
      const accessToken = localStorage.getItem("volynx_access_token") || stored.access_token || "";
      if (!accessToken) return null;

      const payload = decodeJwtPayload(accessToken);
      const userId = stored?.user?.id || payload?.sub || "";
      if (!userId) return null;

      return {
        ...stored,
        access_token: accessToken,
        refresh_token: localStorage.getItem("volynx_refresh_token") || stored.refresh_token || "",
        user: {
          ...(stored.user || {}),
          id: userId,
          email: stored?.user?.email || localStorage.getItem("volynx_user_email") || payload?.email || "",
        },
      };
    }

    async function authHeaders() {
      const session = await getSession();
      const c = await loadConfig();
      if (!session) throw new Error("Not signed in");
      return {
        apikey: c.anon,
        Authorization: `Bearer ${session.access_token}`,
        "Content-Type": "application/json",
      };
    }

    function generateSlug() {
      const buf = new Uint8Array(7);
      crypto.getRandomValues(buf);
      let out = "";
      for (let i = 0; i < buf.length; i++) out += SLUG_ALPHABET[buf[i] % SLUG_ALPHABET.length];
      return out;
    }

    function normalizeSlug(value) {
      return String(value || "").trim().replace(/[^a-zA-Z0-9_-]/g, "");
    }

    function addCalendarMonths(date, months) {
      const next = new Date(date);
      const day = next.getUTCDate();
      next.setUTCDate(1);
      next.setUTCMonth(next.getUTCMonth() + months);
      const lastDay = new Date(Date.UTC(next.getUTCFullYear(), next.getUTCMonth() + 1, 0)).getUTCDate();
      next.setUTCDate(Math.min(day, lastDay));
      return next;
    }

    function qrValidityDates(value) {
      if (value === "never") return { expires_at: null, grace_until: null };
      const months = { "1m": 1, "3m": 3, "6m": 6, "1y": 12 }[value] || 1;
      const expiresAt = addCalendarMonths(new Date(), months);
      const graceUntil = new Date(expiresAt);
      graceUntil.setUTCDate(graceUntil.getUTCDate() + 7);
      return { expires_at: expiresAt.toISOString(), grace_until: graceUntil.toISOString() };
    }

    function qrValidityOptions(selected = "1m") {
      const options = [
        ["1m", "admin.codes.qr_validity_1_month", "1 month"],
        ["3m", "admin.codes.qr_validity_3_months", "3 months"],
        ["6m", "admin.codes.qr_validity_6_months", "6 months"],
        ["1y", "admin.codes.qr_validity_1_year", "1 year"],
        ["never", "admin.codes.never_expires", "Never expires"],
      ];
      return options.map(([value, key, fallback]) => (
        `<option value="${value}" ${value === selected ? "selected" : ""}>${escapeHtml(t(key, fallback))}</option>`
      )).join("");
    }

    function normalizeTargetUrl(value) {
      const raw = String(value || "").trim();
      if (!raw) return "";
      if (/^[a-z][a-z0-9+.-]*:\/\//i.test(raw)) return raw;
      return `https://${raw}`;
    }

    function isValidHttpUrl(value) {
      try {
        const url = new URL(value);
        return url.protocol === "http:" || url.protocol === "https:";
      } catch {
        return false;
      }
    }

    async function postgrest(path, options = {}) {
      const c = await loadConfig();
      const headers = await authHeaders();
      const res = await fetch(`${c.url}/rest/v1/${path}`, {
        ...options,
        headers: { ...headers, ...(options.headers || {}) },
      });
      const text = await res.text();
      let data = null;
      try { data = text ? JSON.parse(text) : null; } catch { data = { raw: text }; }
      if (!res.ok) {
        const err = new Error((data && (data.message || data.error || data.code || data.raw)) || `HTTP ${res.status}`);
        err.status = res.status;
        err.data = data;
        throw err;
      }
      return data;
    }

    async function rpc(name, body) {
      return await postgrest(`rpc/${name}`, {
        method: "POST",
        body: JSON.stringify(body || {}),
      });
    }

    async function checkAdmin() {
      const session = await getSession();
      if (!session) return "logged_out";
      const c = await loadConfig();
      const res = await fetch(`${c.url}/rest/v1/profiles?id=eq.${encodeURIComponent(session.user.id)}&select=is_admin,email,plan`, {
        headers: {
          apikey: c.anon,
          Authorization: `Bearer ${session.access_token}`,
        },
      });
      if (!res.ok) return "forbidden";
      const rows = await res.json();
      currentUser = { ...session.user, ...(rows?.[0] || {}) };
      isAdmin = !!rows?.[0]?.is_admin;
      setState(el.codesAdminName, currentUser.email || currentUser.id || "Admin");
      return isAdmin ? "admin" : "forbidden";
    }

    async function createQr(event) {
      event.preventDefault();
      setMsg(el.qrCreateMsg, "");
      el.qrCreateBtn.disabled = true;
      el.qrCreateBtn.textContent = t("admin.codes.creating", "Creating...");
      try {
        const session = await getSession();
        if (!session) throw new Error(t("admin.codes.err_signin_qr", "Sign in again before creating a QR."));

        const target = normalizeTargetUrl(el.qrTarget.value);
        const label = el.qrLabel.value.trim();
        const requestedSlug = normalizeSlug(el.qrSlug.value);
        const validity = qrValidityDates(el.qrValidity.value);
        el.qrTarget.value = target;
        if (!isValidHttpUrl(target)) {
          el.qrTarget.focus({ preventScroll: true });
          throw new Error(t("admin.codes.err_valid_url", "Enter a valid destination URL."));
        }
        if (requestedSlug && (requestedSlug.length < 4 || requestedSlug.length > 32)) {
          throw new Error(t("admin.codes.err_slug_length", "Custom slug must be 4 to 32 characters."));
        }

        let created = null;
        for (let attempt = 0; attempt < 4; attempt++) {
          const slug = requestedSlug || generateSlug();
          try {
            const rows = await postgrest("qr_codes", {
              method: "POST",
              headers: { Prefer: "return=representation" },
              body: JSON.stringify({
                owner_id: session.user.id,
                slug,
                target_url: target,
                label: label || null,
                ...validity,
              }),
            });
            created = rows?.[0] || null;
            break;
          } catch (err) {
            const raw = JSON.stringify(err.data || {});
            if (!requestedSlug && (raw.includes("23505") || raw.includes("qr_codes_slug_key"))) continue;
            throw err;
          }
        }
        if (!created) throw new Error(t("admin.codes.err_create_qr", "Could not create QR."));

        if (validity.expires_at === null && isAdmin) {
          await rpc("admin_update_qr_validity", {
            p_qr_id: created.id,
            p_status: "active",
            p_clear_expiry: true,
            p_clear_grace: true,
          }).catch(() => null);
        }

        const shortUrl = `${QR_HOST}/${created.slug}`;
        lastGeneratedQrUrl = shortUrl;
        el.qrShortUrl.value = shortUrl;
        el.qrOpenLink.href = shortUrl;
        el.qrCanvas.dataset.qrUrl = shortUrl;
        el.qrResult.hidden = false;
        await QRCode.toCanvas(el.qrCanvas, shortUrl, QR_CANVAS_OPTIONS);
        setMsg(el.qrCreateMsg, t("admin.codes.qr_created_msg", "QR created. Test the link before sending to print."), "ok");
        el.qrTarget.value = "";
        el.qrLabel.value = "";
        el.qrSlug.value = "";
        await loadQrs();
        renderRecent();
      } catch (err) {
        setMsg(el.qrCreateMsg, err.message || String(err), "error");
      } finally {
        el.qrCreateBtn.disabled = false;
        el.qrCreateBtn.textContent = t("admin.codes.create_qr", "Create QR");
      }
    }

