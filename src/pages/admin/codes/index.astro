        el.voucherRows.innerHTML = `<div class="codes-empty is-error">${escapeHtml(t("admin.codes.err_load_vouchers", "Could not load vouchers:"))} ${escapeHtml(err.message || err)}</div>`;
        setState(el.codesVoucherState, t("admin.codes.error", "Error"));
        updateTabCounts();
      }
    }

