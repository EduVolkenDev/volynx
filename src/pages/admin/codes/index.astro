    async function renderQrPreviews() {
      const canvases = Array.from(el.qrRows.querySelectorAll("[data-qr-preview]"));
      await Promise.allSettled(canvases.map((canvas) => (
        QRCode.toCanvas(canvas, canvas.dataset.qrUrl || "", {
          width: 128,
          margin: 1,
          errorCorrectionLevel: "H",
          color: { dark: "#05060a", light: "#ffffff" },
        })
      )));
    }

    async function downloadSavedQr(qr) {
      const canvas = document.createElement("canvas");
      const shortUrl = `${QR_HOST}/${qr.slug}`;
      await QRCode.toCanvas(canvas, shortUrl, QR_CANVAS_OPTIONS);
      const safeName = String(qr.label || qr.slug || "qr")
        .trim()
        .replace(/[^a-z0-9_-]+/gi, "-")
        .replace(/^-+|-+$/g, "")
        .slice(0, 60) || "qr";
      downloadCanvas(canvas, `volynx-qr-${safeName}.png`);
    }

    async function updateQrDestination(id, row) {
      const targetInput = row.querySelector('[data-qr-field="target_url"]');
      const labelInput = row.querySelector('[data-qr-field="label"]');
      const target = normalizeTargetUrl(targetInput?.value || "");
      const label = String(labelInput?.value || "").trim();

      if (targetInput) targetInput.value = target;
      if (!isValidHttpUrl(target)) {
        targetInput?.focus({ preventScroll: true });
        throw new Error(t("admin.codes.err_valid_url", "Enter a valid destination URL."));
      }

      await postgrest(`qr_codes?id=eq.${encodeURIComponent(id)}`, {
        method: "PATCH",
        body: JSON.stringify({
          target_url: target,
          label: label || null,
        }),
      });
    }

    async function updateQrFounderControl(qr) {
      const next = qr.founder_controlled !== true;
      const ok = confirm(next
        ? t("admin.codes.confirm_founder_on", `Put "{name}" under founder control? The recipient can edit destination, but cannot pause, delete or transfer it.`, { name: qr.label || qr.slug })
        : t("admin.codes.confirm_founder_off", `Release founder control for "{name}"? The owner will regain full QR controls.`, { name: qr.label || qr.slug }));
      if (!ok) return false;
      await postgrest(`qr_codes?id=eq.${encodeURIComponent(qr.id)}`, {
        method: "PATCH",
        body: JSON.stringify({ founder_controlled: next }),
      });
      return true;
    }

    async function transferQrOwner(id, row, qr) {
      const emailInput = row.querySelector('[data-qr-field="transfer_email"]');
      const email = String(emailInput?.value || "").trim().toLowerCase();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        emailInput?.focus({ preventScroll: true });
        throw new Error(t("admin.codes.err_transfer_email", "Enter the customer's account email before transferring."));
      }
      const name = qr.label || qr.slug;
      const ok = confirm(t("admin.codes.confirm_transfer_qr", `Transfer QR "{name}" to {email}? The short URL stays the same, but this customer will manage destination edits from their profile.`, { name, email }));
      if (!ok) return false;
      await rpc("admin_transfer_qr_code", {
        p_qr_id: id,
        p_target_email: email,
        p_note: `Transferred from admin QR workspace: ${name}`,
      });
      return true;
    }

    function qrTransferErrorMessage(err) {
      const raw = JSON.stringify(err?.data || {}) + " " + String(err?.message || err || "");
      if (raw.includes("qr_transfer_target_profile_not_found")) {
        return t("admin.codes.err_recipient_not_found", "Recipient profile not found. Ask the customer to create a VOLYNX account before transferring this QR.");
      }
      if (raw.includes("qr_transfer_target_quota_exceeded")) {
        return t("admin.codes.err_recipient_quota", "Recipient account is not compatible with this QR yet. Gift a compatible subscription or ask them to upgrade before transfer.");
      }
      if (raw.includes("qr_transfer_same_owner")) {
        return t("admin.codes.err_same_owner", "This QR already belongs to that account.");
      }
      return err?.message || String(err);
    }

    async function deleteQrCode(qr) {
      const name = qr.label || qr.slug;
      const ok = confirm(t("admin.codes.confirm_delete_qr", `Delete QR "{name}"? The short link will stop resolving immediately.`, { name }));
      if (!ok) return false;
      await postgrest(`qr_codes?id=eq.${encodeURIComponent(qr.id)}`, {
        method: "DELETE",
      });
      return true;
    }

    async function handleQrAction(event) {
      const copyButton = event.target.closest("[data-copy-value]");
      if (copyButton) {
        await copyText(copyButton.dataset.copyValue || "");
        return;
      }
      const button = event.target.closest("[data-qr-action]");
      if (!button) return;
      const row = button.closest("[data-qr-id]");
      const id = row?.dataset.qrId;
      if (!id) return;
      const qr = lastQrRows.find((item) => item.id === id);
      if (!qr) return;
      button.disabled = true;
      try {
        if (button.dataset.qrAction === "save-destination") {
          await updateQrDestination(id, row);
        } else if (button.dataset.qrAction === "download") {
          await downloadSavedQr(qr);
          return;
        } else if (button.dataset.qrAction === "transfer-owner") {
          const transferred = await transferQrOwner(id, row, qr);
          if (!transferred) return;
        } else if (button.dataset.qrAction === "founder-control") {
          const changed = await updateQrFounderControl(qr);
          if (!changed) return;
        } else if (button.dataset.qrAction === "set-validity") {
          const selectedValidity = row.querySelector("[data-qr-validity]")?.value || "1m";
          const validity = qrValidityDates(selectedValidity);
          await rpc("admin_update_qr_validity", {
            p_qr_id: id,
            p_status: qr.status === "admin_blocked" ? "admin_blocked" : qr.status === "paused" ? "paused" : "active",
            p_expires_at: validity.expires_at,
            p_grace_until: validity.grace_until,
            p_clear_expiry: validity.expires_at === null,
            p_clear_grace: validity.grace_until === null,
          });
        } else if (button.dataset.qrAction === "never") {
          await rpc("admin_update_qr_validity", {
            p_qr_id: id,
            p_status: "active",
            p_clear_expiry: true,
            p_clear_grace: true,
          });
        } else if (button.dataset.qrAction === "pause") {
          await rpc("admin_update_qr_validity", {
            p_qr_id: id,
            p_status: qr.status === "paused" ? "active" : "paused",
          });
        } else if (button.dataset.qrAction === "block") {
          const ok = confirm(t("admin.codes.confirm_block_qr", `Block QR "{name}"? The short link will stop resolving until an admin reactivates it.`, { name: qr.label || qr.slug }));
          if (!ok) return;
          await rpc("admin_update_qr_validity", {
            p_qr_id: id,
            p_status: "admin_blocked",
          });
        } else if (button.dataset.qrAction === "delete") {
          const deleted = await deleteQrCode(qr);
          if (!deleted) return;
        }
        await loadQrs();
        renderRecent();
      } catch (err) {
        alert(button.dataset.qrAction === "transfer-owner" ? qrTransferErrorMessage(err) : (err.message || String(err)));
      } finally {
        button.disabled = false;
      }
    }

    function grantsForPreset(preset) {
      if (preset === "black_diamond") {
        return {
          type: "black_diamond",
          grants: {
            badge: "black_diamond",
            daily_plan: "diamond",
            daily_plan_expires_in_days: 90,
            tokens: 80,
            icon_pack_grants: ["Hyper-Icons-Premium", "Poligon-Premium", "metal-chrome-premium"],
          },
          label: voucherPresetLabel("black_diamond"),
        };
      }
      if (preset === "vx_80") return { type: "token_pack", grants: { tokens: 80 }, label: voucherPresetLabel("vx_80") };
      if (preset === "pro_perm") return { type: "builder_bonus", grants: { plan: "pro" }, label: voucherPresetLabel("pro_perm") };
      return { type: "daily_access", grants: { daily_plan: "diamond", daily_plan_expires_in_days: 90 }, label: voucherPresetLabel("diamond_90") };
    }

    async function voucherApi(payload) {
      const session = await getSession();
      if (!session) throw new Error(t("admin.codes.err_signin_voucher", "Sign in again before creating a voucher."));
      const res = await fetch(VOUCHER_FN_URL, {
        method: "POST",
        headers: {
          Authorization: `Bearer ${session.access_token}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
      });
      const text = await res.text();
      let data = null;
      try { data = text ? JSON.parse(text) : null; } catch { data = { raw: text }; }
      if (!res.ok || !data?.ok) {
        throw new Error(data?.detail || data?.error || `Voucher API ${res.status}`);
      }
      return data;
    }

    async function createVoucher(event) {
      event.preventDefault();
      setMsg(el.voucherMsg, "");
      el.voucherCreateBtn.disabled = true;
      el.voucherCreateBtn.textContent = t("admin.codes.creating", "Creating...");
      try {
        const preset = grantsForPreset(el.voucherPreset.value);
        const recipient = el.voucherRecipient.value.trim();
        const label = el.voucherLabel.value.trim() || (recipient ? `${preset.label} - ${recipient}` : preset.label);
        const data = await voucherApi({
          action: "create",
          type: preset.type,
          label,
          description: null,
          recipient_name: recipient || null,
          target_email: el.voucherEmail.value.trim() || null,
          max_uses: 1,
          transferable: !el.voucherEmail.value.trim(),
          expires_at: null,
          grants: preset.grants,
        });
        const voucher = data.voucher;
        const url = data.invite_url || `${location.origin}/invite/black-diamond/?code=${encodeURIComponent(voucher.code)}`;
        el.voucherUrl.value = url;
        el.voucherCode.textContent = voucher.code;
        el.voucherResult.hidden = false;
        await QRCode.toCanvas(el.voucherCanvas, url, {
          width: 320,
          margin: 2,
          errorCorrectionLevel: "H",
          color: { dark: "#05060a", light: "#ffffff" },
        });
        setMsg(el.voucherMsg, t("admin.codes.voucher_created_msg", "Voucher created."), "ok");
        await loadVouchers();
        renderRecent();
      } catch (err) {
        setMsg(el.voucherMsg, err.message || String(err), "error");
      } finally {
        el.voucherCreateBtn.disabled = false;
        el.voucherCreateBtn.textContent = t("admin.codes.create_voucher", "Create voucher");
      }
    }

    async function loadVouchers() {
      setState(el.codesVoucherState, t("admin.codes.loading", "Loading"));
      el.voucherRows.innerHTML = `<div class="codes-empty">${escapeHtml(t("admin.codes.loading_vouchers", "Loading vouchers..."))}</div>`;
      try {
        const data = await voucherApi({ action: "list", limit: 100 });
        lastVoucherRows = data.items || [];
        renderVouchers(lastVoucherRows);
        setState(el.codesVoucherState, t("admin.codes.loaded_count", "{count} loaded", { count: lastVoucherRows.length }));
        updateTabCounts();
