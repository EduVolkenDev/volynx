      el.qrRows.innerHTML = `<div class="codes-empty">${escapeHtml(t("admin.codes.loading_qrs", "Loading QR codes..."))}</div>`;
      try {
        const rows = await rpc("admin_list_qr_codes", {
          p_limit: 100,
          p_status: el.qrStatusFilter.value || null,
          p_search: el.qrSearch.value.trim() || null,
        });
        lastQrRows = rows || [];
        renderQrs(lastQrRows);
        setState(el.codesQrState, t("admin.codes.loaded_count", "{count} loaded", { count: lastQrRows.length }));
        updateTabCounts();
        markRefresh();
      } catch (err) {
        el.qrRows.innerHTML = `<div class="codes-empty is-error">${escapeHtml(t("admin.codes.err_load_qrs", "Could not load QR codes:"))} ${escapeHtml(err.message || err)}</div>`;
        setState(el.codesQrState, t("admin.codes.error", "Error"));
        updateTabCounts();
      }
    }

