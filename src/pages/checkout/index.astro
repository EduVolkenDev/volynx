---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";
---

<FlagshipLayout
  title="Secure Checkout — VOLYNX"
  description="VOLYNX secure checkout bridge. Validates access, restores auth if needed and redirects into Stripe Checkout."
  pageClass="page-checkout"
>
  <FlagshipHeader ctaHref={ROUTES.products} ctaLabel="Browse products" ctaI18n="header.browse_products" />

  <main class="checkout-shell">
    <section class="checkout-hero">
      <span class="checkout-kicker"><span class="i18n-en">Secure checkout</span><span class="i18n-pt">Checkout seguro</span></span>
      <h1 id="checkoutTitle"><span class="i18n-en">Preparing your VOLYNX checkout.</span><span class="i18n-pt">Preparando seu checkout VOLYNX.</span></h1>
      <p id="checkoutMessage">
        <span class="i18n-en">Verifying access, currency and product context before opening Stripe Checkout.</span><span class="i18n-pt">Verificando acesso, moeda e contexto do produto antes de abrir o Stripe Checkout.</span>
      </p>
    </section>

    <section class="checkout-panel" aria-live="polite">
      <div class="checkout-state" id="checkoutLoading">
        <div class="checkout-spinner" aria-hidden="true"></div>
        <strong><span class="i18n-en">Opening secure checkout...</span><span class="i18n-pt">Abrindo checkout seguro...</span></strong>
        <p><span class="i18n-en">If you just signed in, stay on this page for a moment while we restore your session.</span><span class="i18n-pt">Se você acabou de entrar, fique nesta página um instante enquanto restauramos sua sessão.</span></p>
      </div>

      <div class="checkout-state checkout-state--error" id="checkoutError" hidden>
        <strong id="checkoutErrorTitle"><span class="i18n-en">Could not open checkout.</span><span class="i18n-pt">Não foi possível abrir o checkout.</span></strong>
        <p id="checkoutErrorMessage"><span class="i18n-en">Try again, or return to the product page and reopen the checkout flow.</span><span class="i18n-pt">Tente novamente ou volte à página do produto e reabra o fluxo de checkout.</span></p>
        <div class="checkout-actions">
          <a class="button button--gold" id="checkoutRetry" href={ROUTES.pricing}><span class="i18n-en">Try again</span><span class="i18n-pt">Tentar novamente</span></a>
          <a class="button button--ghost" id="checkoutBack" href={ROUTES.products}><span class="i18n-en">Back to product</span><span class="i18n-pt">Voltar ao produto</span></a>
          <a class="button button--ghost" href={ROUTES.support}><span class="i18n-en">Open support</span><span class="i18n-pt">Abrir suporte</span></a>
        </div>
      </div>
    </section>
  </main>

  <FlagshipFooter />
</FlagshipLayout>

<script is:inline type="module">
  const params = new URLSearchParams(window.location.search);
  const lookupBase = String(params.get("lookup_key") || "").trim();
  const requestedCurrency = String(params.get("currency") || "").trim().toLowerCase();
  const requestedNext = String(params.get("next") || "").trim();

  const titleEl = document.getElementById("checkoutTitle");
  const messageEl = document.getElementById("checkoutMessage");
  const errorWrap = document.getElementById("checkoutError");
  const errorTitle = document.getElementById("checkoutErrorTitle");
  const errorMessage = document.getElementById("checkoutErrorMessage");
  const retryLink = document.getElementById("checkoutRetry");
  const backLink = document.getElementById("checkoutBack");

  const LANG = (localStorage.getItem("volynx_lang") || "en").toLowerCase().startsWith("pt") ? "pt" : "en";
  const T = {
    en: {
      missing_target: "Missing checkout target.",
      missing_target_msg: "This checkout link does not include a product lookup key.",
      missing_target_hint: "Return to the product page and reopen the secure checkout link.",
      preparing_for: (label) => `Preparing checkout for ${label}.`,
      checking_session: "Checking your session and opening Stripe Checkout.",
      could_not_start: "Checkout could not start.",
      could_not_start_hint: "You can retry, return to the product page or open support with the same purchase context.",
      unexpected: "Unexpected checkout error.",
      missing_config: "Checkout configuration is missing.",
      no_redirect: "Stripe checkout did not return a redirect URL.",
    },
    pt: {
      missing_target: "Checkout sem destino.",
      missing_target_msg: "Este link de checkout não inclui o lookup_key do produto.",
      missing_target_hint: "Volte à página do produto e reabra o link do checkout seguro.",
      preparing_for: (label) => `Preparando checkout de ${label}.`,
      checking_session: "Verificando sua sessão e abrindo o Stripe Checkout.",
      could_not_start: "Não foi possível iniciar o checkout.",
      could_not_start_hint: "Você pode tentar novamente, voltar ao produto ou abrir o suporte com o mesmo contexto de compra.",
      unexpected: "Erro inesperado no checkout.",
      missing_config: "Configuração do checkout ausente.",
      no_redirect: "O Stripe Checkout não retornou um URL de redirecionamento.",
    },
  };
  const tt = T[LANG];

  const FALLBACK_LABELS = {
    portfolio: "Portfolio Pro Kit",
    agency: "Agency Launch Kit",
    saas: "SaaS Landing System",
    propertyflow: "PropertyFlow",
    pricing: "VOLYNX pricing",
  };

  function normalizeCurrency(value) {
    const currency = String(value || "gbp").toLowerCase();
    return /^(gbp|eur|brl)$/.test(currency) ? currency : "gbp";
  }

  function defaultCurrencyForLookup(lookup) {
    const key = String(lookup || "").toLowerCase().replace(/_(gbp|eur|brl)$/i, "");
    return key === "checkout_smoke_test" ? "brl" : "gbp";
  }

  function storedCurrencyForLookup(lookup) {
    const key = String(lookup || "").toLowerCase().replace(/_(gbp|eur|brl)$/i, "");
    return key === "checkout_smoke_test" ? "" : localStorage.getItem("volynx_currency");
  }

  function hasCurrencySuffix(value) {
    return /_(gbp|eur|brl)$/i.test(String(value || ""));
  }

  function sanitizeInternalPath(value) {
    if (!value || typeof value !== "string") return "";
    if (!value.startsWith("/")) return "";
    if (value.startsWith("//")) return "";
    return value;
  }

  function inferProductPath(lookup) {
    const key = String(lookup || "").toLowerCase().replace(/_(gbp|eur|brl)$/i, "");
    if (key.startsWith("kit_portfolio_")) return { href: "/products/portfolio-pro-kit/", label: FALLBACK_LABELS.portfolio };
    if (key.startsWith("kit_agency_")) return { href: "/products/agency-launch-kit/", label: FALLBACK_LABELS.agency };
    if (key.startsWith("kit_saas_")) return { href: "/products/saas-landing-system/", label: FALLBACK_LABELS.saas };
    if (key.startsWith("pf_")) return { href: "/products/propertyflow/", label: FALLBACK_LABELS.propertyflow };
    return { href: "/pricing/", label: FALLBACK_LABELS.pricing };
  }

  async function loadConfig() {
    const res = await fetch("/config.json", { cache: "no-store" });
    return res.json();
  }

  async function freshAccessToken(cfg) {
    let token = localStorage.getItem("volynx_access_token") || "";
    const refreshToken = localStorage.getItem("volynx_refresh_token") || "";

    if (!token || !refreshToken || !cfg?.supabaseUrl || !cfg?.supabaseAnonKey) {
      return token;
    }

    try {
      const res = await fetch(`${cfg.supabaseUrl}/auth/v1/token?grant_type=refresh_token`, {
        method: "POST",
        headers: {
          apikey: cfg.supabaseAnonKey,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ refresh_token: refreshToken }),
      });

      if (!res.ok) {
        // Refresh failed — purge dead tokens so the caller's `if (!token)`
        // branch redirects to /login/. Returning the stale token would
        // produce a confusing 401 from create-checkout-session.
        localStorage.removeItem("volynx_access_token");
        localStorage.removeItem("volynx_refresh_token");
        return "";
      }

      const session = await res.json();
      if (session.access_token) {
        token = session.access_token;
        localStorage.setItem("volynx_access_token", session.access_token);
        if (session.refresh_token) {
          localStorage.setItem("volynx_refresh_token", session.refresh_token);
        }
      }
    } catch (_) {
      // Network failure — keep tokens; don't sign the user out over a transient error.
    }

    return token;
  }

  function showError(title, message) {
    errorTitle.textContent = title;
    errorMessage.textContent = message;
    errorWrap.hidden = false;
  }

  async function startCheckout() {
    const fallback = inferProductPath(lookupBase);
    const fallbackBackHref = sanitizeInternalPath(requestedNext) || fallback.href;
    const retryHref = window.location.pathname + window.location.search + window.location.hash;

    retryLink.setAttribute("href", retryHref);
    backLink.setAttribute("href", fallbackBackHref);

    if (!lookupBase) {
      if (titleEl) titleEl.textContent = tt.missing_target;
      if (messageEl) messageEl.textContent = tt.missing_target_msg;
      showError(tt.missing_target, tt.missing_target_hint);
      return;
    }

    if (titleEl) titleEl.textContent = tt.preparing_for(fallback.label);
    if (messageEl) messageEl.textContent = tt.checking_session;

    let token = localStorage.getItem("volynx_access_token") || "";
    const currentPath = window.location.pathname + window.location.search + window.location.hash;

    if (!token) {
      if (window.VxReturn) window.VxReturn.redirectToLogin(currentPath);
      else window.location.href = `/login/?next=${encodeURIComponent(currentPath)}`;
      return;
    }

    try {
      const cfg = await loadConfig();
      const apiBase = String((cfg && (cfg.functionsUrl || cfg.apiBaseUrl)) || "").replace(/\/$/, "");

      if (!apiBase) {
        throw new Error(tt.missing_config);
      }

      token = await freshAccessToken(cfg);

      if (!token) {
        if (window.VxReturn) window.VxReturn.redirectToLogin(currentPath);
        else window.location.href = `/login/?next=${encodeURIComponent(currentPath)}`;
        return;
      }

      const currency = normalizeCurrency(
        requestedCurrency || storedCurrencyForLookup(lookupBase) || defaultCurrencyForLookup(lookupBase),
      );
      const lookupKey = hasCurrencySuffix(lookupBase) ? lookupBase : `${lookupBase}_${currency}`;
      const cancelPath = sanitizeInternalPath(requestedNext) || fallback.href;
      const cancelUrl = new URL(cancelPath, window.location.origin);
      cancelUrl.searchParams.set("payment", "cancelled");

      const res = await fetch(`${apiBase}/create-checkout-session`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({
          lookup_key: lookupKey,
          success_url: `${window.location.origin}/delivery/?payment=success`,
          cancel_url: cancelUrl.toString(),
        }),
      });

      const data = await res.json().catch(() => ({}));

      if (data?.url) {
        window.location.href = data.url;
        return;
      }

      throw new Error(data?.error || data?.message || tt.no_redirect);
    } catch (error) {
      console.error("[checkout-page] failed:", error);
      if (titleEl) titleEl.textContent = tt.could_not_start;
      if (messageEl) messageEl.textContent = tt.could_not_start_hint;
      showError(
        tt.could_not_start,
        error instanceof Error ? error.message : tt.unexpected,
      );
    }
  }

  startCheckout();
</script>

<style>
  .checkout-shell {
    width: min(960px, calc(100% - 32px));
    margin: 0 auto;
    padding: clamp(32px, 6vw, 72px) 0 96px;
  }

  .checkout-hero {
    max-width: 720px;
    margin-bottom: 28px;
  }

  .checkout-kicker {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .checkout-hero h1 {
    margin: 18px 0 12px;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.02;
  }

  .checkout-hero p {
    margin: 0;
    max-width: 56ch;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.7;
    font-size: 1rem;
  }

  .checkout-panel {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.02));
    backdrop-filter: blur(12px);
    padding: clamp(24px, 4vw, 36px);
  }

  .checkout-state {
    display: grid;
    gap: 12px;
  }

  .checkout-state strong {
    font-size: 1.05rem;
  }

  .checkout-state p {
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
  }

  .checkout-spinner {
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 3px solid rgba(255, 255, 255, 0.12);
    border-top-color: rgba(214, 179, 106, 0.9);
    animation: checkout-spin 0.85s linear infinite;
  }

  .checkout-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  @keyframes checkout-spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 640px) {
    .checkout-actions {
      flex-direction: column;
    }

    .checkout-actions :global(.button) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
