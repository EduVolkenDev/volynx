---
import FlagshipLayout from "../../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../../components/FlagshipFooter.astro";
import { ROUTES } from "../../../data/routes";
---

<FlagshipLayout
  title="Professional Profile — Volynx World"
  description="Discover a professional and their services inside Volynx World."
  pageClass="page-world-profile"
>
  <FlagshipHeader current={ROUTES.world} ctaLabel="Explore World" ctaHref={ROUTES.world} ctaI18n="nav.world" />
  <main class="world-profile shell">
    <a class="world-back" href={ROUTES.world}>← <span class="i18n-en">Back to World</span><span class="i18n-pt">Voltar ao World</span></a>
    <div class="world-state" id="profileState"><span class="i18n-en">Loading professional profile...</span><span class="i18n-pt">Carregando perfil profissional...</span></div>

    <section class="world-profile__hero" id="profileHero" hidden>
      <div class="world-profile__identity">
        <div class="world-profile__avatar" id="profileAvatar">VW</div>
        <div class="world-profile__identity-copy">
          <div class="world-profile__eyebrow"><span id="profileHandle">@professional</span><em id="profilePlanBadge" hidden></em><em id="verifiedBadge" hidden><span class="i18n-en">World Verified</span><span class="i18n-pt">Verificado World</span></em></div>
          <h1 id="profileName">Professional</h1>
          <p class="world-profile__headline" id="profileHeadline"></p>
          <div class="world-profile__meta"><span id="profileLocation"></span><span id="profileAvailability"></span></div>
        </div>
      </div>
      <aside class="world-profile__signal">
        <div class="world-profile__signal-media">
          <img id="profileSignalIcon" src="/assets/world/world-layer-icon.webp" alt="" loading="lazy" decoding="async" />
        </div>
        <div class="world-profile__signal-copy">
          <span class="world-label"><span class="i18n-en">World signal</span><span class="i18n-pt">Sinal World</span></span>
          <strong><span class="i18n-en">A premium professional surface inside VOLYNX.</span><span class="i18n-pt">Uma superfície profissional premium dentro da VOLYNX.</span></strong>
          <p><span class="i18n-en">Profile, service offer and private project briefs stay connected in one clear layer.</span><span class="i18n-pt">Perfil, oferta de serviço e briefings privados de projeto ficam conectados em uma camada clara.</span></p>
        </div>
        <div class="world-profile__signal-stats">
          <article><strong id="profileServiceCount">0</strong><span><span class="i18n-en">Live services</span><span class="i18n-pt">Serviços ativos</span></span></article>
          <article><strong id="profileSignalPlan">World Presence</strong><span><span class="i18n-en">World plan</span><span class="i18n-pt">Plano World</span></span></article>
          <article><strong id="profileSignalAvailability">Available</strong><span><span class="i18n-en">Availability</span><span class="i18n-pt">Disponibilidade</span></span></article>
        </div>
      </aside>
      <div class="world-profile__actions">
        <a class="button button--gold" href="#services"><span class="i18n-en">View services</span><span class="i18n-pt">Ver serviços</span></a>
        <a class="button button--ghost" id="portfolioLink" href="#" target="_blank" rel="noopener noreferrer" hidden>Portfolio ↗</a>
      </div>
    </section>

    <section class="world-profile__body" id="profileBody" hidden>
      <article class="world-about">
        <span class="world-label"><span class="i18n-en">Professional profile</span><span class="i18n-pt">Perfil profissional</span></span>
        <h2><span class="i18n-en">About</span><span class="i18n-pt">Sobre</span></h2>
        <p id="profileBio"></p>
        <div class="world-profile__facts">
          <article class="world-fact-card">
            <div class="world-fact-card__icon"><img src="/assets/world/specialties.webp" alt="" loading="lazy" decoding="async" /></div>
            <strong><span class="i18n-en">Specialties</span><span class="i18n-pt">Especialidades</span></strong>
            <div class="world-chip-list" id="profileSpecialties"></div>
          </article>
          <article class="world-fact-card">
            <div class="world-fact-card__icon"><img src="/assets/world/languages.webp" alt="" loading="lazy" decoding="async" /></div>
            <strong><span class="i18n-en">Languages</span><span class="i18n-pt">Idiomas</span></strong>
            <div class="world-chip-list" id="profileLanguages"></div>
          </article>
        </div>
      </article>
      <aside class="world-promise">
        <div class="world-promise__media"><img src="/assets/world/world-network-icon.webp" alt="" loading="lazy" decoding="async" /></div>
        <span>WORLD PROFILE</span>
        <strong><span class="i18n-en">Clear offers. Direct briefs. Independent delivery.</span><span class="i18n-pt">Ofertas claras. Briefings diretos. Entrega independente.</span></strong>
        <p><span class="i18n-en">Professionals operate independently and remain responsible for agreements and delivery. Protected payments and verified reviews are not active in this founding release.</span><span class="i18n-pt">Profissionais atuam de forma independente e continuam responsáveis pelos acordos e entregas. Pagamentos protegidos e avaliações verificadas ainda não estão ativos neste lançamento fundador.</span></p>
        <div class="world-promise__chips">
          <em><span class="i18n-en">Direct project briefs</span><span class="i18n-pt">Briefings diretos</span></em>
          <em><span class="i18n-en">Independent delivery</span><span class="i18n-pt">Entrega independente</span></em>
          <em><span class="i18n-en">Premium positioning</span><span class="i18n-pt">Posicionamento premium</span></em>
        </div>
      </aside>
    </section>

    <section class="world-services" id="services" hidden>
      <div class="world-services__head">
        <div><span class="world-label"><span class="i18n-en">Available services</span><span class="i18n-pt">Serviços disponíveis</span></span><h2><span class="i18n-en">Ways to work together.</span><span class="i18n-pt">Formas de trabalhar juntos.</span></h2><p><span class="i18n-en">Each offer is structured to make the scope, delivery mode and value easier to understand before the first message.</span><span class="i18n-pt">Cada oferta é estruturada para deixar mais claro o escopo, a forma de entrega e o valor antes da primeira mensagem.</span></p></div>
      </div>
      <div class="world-services__grid" id="servicesGrid"></div>
    </section>
  </main>

  <dialog class="world-dialog" id="inquiryDialog">
    <form method="dialog" class="world-dialog__close"><button aria-label="Close">×</button></form>
    <form id="inquiryForm">
      <span class="world-label"><span class="i18n-en">Private project brief</span><span class="i18n-pt">Briefing privado</span></span>
      <h2 id="inquiryTitle"></h2>
      <label><span><span class="i18n-en">Reply email</span><span class="i18n-pt">Email para resposta</span></span><input id="inquiryEmail" type="email" required /></label>
      <label><span><span class="i18n-en">What do you need?</span><span class="i18n-pt">O que você precisa?</span></span><input id="inquirySubject" maxlength="120" required /></label>
      <label><span><span class="i18n-en">Project brief</span><span class="i18n-pt">Briefing do projeto</span></span><textarea id="inquiryBrief" minlength="40" maxlength="3000" rows="6" required></textarea></label>
      <div class="world-dialog__grid">
        <label><span><span class="i18n-en">Budget</span><span class="i18n-pt">Orçamento</span></span><input id="inquiryBudget" maxlength="80" /></label>
        <label><span><span class="i18n-en">Timeline</span><span class="i18n-pt">Prazo</span></span><input id="inquiryTimeline" maxlength="80" /></label>
      </div>
      <button class="button button--gold" type="submit"><span class="i18n-en">Send private brief</span><span class="i18n-pt">Enviar briefing privado</span></button>
      <p class="world-state" id="inquiryState"></p>
    </form>
  </dialog>
  <FlagshipFooter />
</FlagshipLayout>

<script>
  import { createClient } from "@supabase/supabase-js";

  const byId = (id: string) => document.getElementById(id) as HTMLElement | null;
  const value = (id: string) => ((byId(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value || "").trim();
  const escapeHtml = (input: unknown) => String(input ?? "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" }[char] || char));
  const isPt = () => document.documentElement.lang.toLowerCase().startsWith("pt");
  const text = (en: string, pt: string) => isPt() ? pt : en;
  type WorldBridgeWindow = Window & {
    VxAuthBridge?: { hydrate?: () => void; sync?: () => void };
    vxEnsureFreshToken?: () => Promise<unknown>;
  };
  let cfg: any = null;
  let supabase: any;
  let user: any = null;
  let profile: any = null;
  let services: any[] = [];
  let selectedService: any = null;
  let profileError = "";
  let publicWorldPlan = "free";

  function normalizeWorldPlan(plan: unknown) {
    return plan === "member" || plan === "pro" ? plan : "free";
  }

  function readStoredWorldSession() {
    try {
      const raw = localStorage.getItem("volynx_session");
      const parsed = raw ? JSON.parse(raw) : {};
      return parsed && typeof parsed === "object" ? parsed : {};
    } catch {
      return {};
    }
  }

  function persistWorldSession(session: any, fallbackRefreshToken = "") {
    try {
      const nextAccessToken = String(session?.access_token || "");
      const nextRefreshToken = String(session?.refresh_token || fallbackRefreshToken || "");
      const nextEmail = String(session?.user?.email || localStorage.getItem("volynx_user_email") || "");
      if (!nextAccessToken) return;
      localStorage.setItem("volynx_access_token", nextAccessToken);
      if (nextRefreshToken) localStorage.setItem("volynx_refresh_token", nextRefreshToken);
      if (nextEmail) localStorage.setItem("volynx_user_email", nextEmail);
      localStorage.setItem("volynx_session", JSON.stringify({
        access_token: nextAccessToken,
        refresh_token: nextRefreshToken,
        expires_at: session?.expires_at ?? null,
        expires_in: session?.expires_in ?? null,
        user: session?.user || (nextEmail ? { email: nextEmail } : null),
      }));
      (window as WorldBridgeWindow).VxAuthBridge?.sync?.();
    } catch {}
  }

  async function refreshWorldSession(refreshToken: string) {
    if (!cfg?.supabaseUrl || !cfg?.supabaseAnonKey || !refreshToken) return null;
    try {
      const response = await fetch(`${String(cfg.supabaseUrl).replace(/\/$/, "")}/auth/v1/token?grant_type=refresh_token`, {
        method: "POST",
        headers: {
          apikey: cfg.supabaseAnonKey,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ refresh_token: refreshToken }),
      });
      if (!response.ok) return null;
      const session = await response.json();
      if (!session?.access_token) return null;
      persistWorldSession(session, refreshToken);
      return session;
    } catch {
      return null;
    }
  }

  async function restoreSession() {
    const bridge = window as WorldBridgeWindow;
    bridge.VxAuthBridge?.hydrate?.();

    let stored = readStoredWorldSession();
    let accessToken = localStorage.getItem("volynx_access_token") || stored.access_token || "";
    let refreshToken = localStorage.getItem("volynx_refresh_token") || stored.refresh_token || "";

    if (!accessToken && refreshToken) {
      await refreshWorldSession(refreshToken);
    } else if (accessToken && bridge.vxEnsureFreshToken) {
      await bridge.vxEnsureFreshToken().catch(() => null);
    }

    stored = readStoredWorldSession();
    accessToken = localStorage.getItem("volynx_access_token") || stored.access_token || "";
    refreshToken = localStorage.getItem("volynx_refresh_token") || stored.refresh_token || "";

    if (!accessToken || !refreshToken) return;
    const { data, error } = await supabase.auth.setSession({ access_token: accessToken, refresh_token: refreshToken });
    if (error || !data?.session) return;

    persistWorldSession(data.session, refreshToken);
    user = data.user || data.session.user || null;
  }

  function worldPlanLabel(plan: unknown) {
    const normalized = normalizeWorldPlan(plan);
    if (normalized === "pro") return text("World Pro", "World Pro");
    if (normalized === "member") return text("World Member", "World Member");
    return "";
  }

  function setState(message: string, kind = "") {
    const state = byId("profileState");
    if (!state) return;
    state.innerHTML = kind === "error"
      ? `<strong>${escapeHtml(message)}</strong><a class="button button--gold" href="/world/">${text("Explore professionals", "Explorar profissionais")}</a>`
      : escapeHtml(message);
    state.dataset.kind = kind;
  }

  function renderProfileError() {
    if (profileError === "missing_handle") return setState(text("Professional address missing.", "Endereço profissional não informado."), "error");
    if (profileError === "unavailable") return setState(text("This professional profile is not available.", "Este perfil profissional não está disponível."), "error");
    if (profileError === "load_error") return setState(text("World profile could not load.", "O perfil World não pôde ser carregado."), "error");
  }

  function formatPrice(service: any) {
    if (service.pricing_type === "quote" || !service.price_amount) return text("Request a quote", "Solicitar orçamento");
    const formatted = new Intl.NumberFormat(isPt() ? "pt-BR" : "en-GB", { style: "currency", currency: service.currency }).format(service.price_amount / 100);
    if (service.pricing_type === "starting_at") return `${text("From", "A partir de")} ${formatted}`;
    if (service.pricing_type === "hourly") return `${formatted}/${text("hour", "hora")}`;
    return formatted;
  }

  function categoryIcon(categoryName: string) {
    const map: Record<string, string> = {
      "Web & Technology": "/assets/world/world-intelligence-icon.webp",
      "Design & Brand": "/assets/world/world-brand-icon.webp",
      "Marketing & Growth": "/assets/world/world-growth-icon.webp",
      "Business & Strategy": "/assets/world/world-strategy-icon.webp",
      "Content & Media": "/assets/world/world-portfolio-icon.webp",
      "Other": "/assets/world/world-service-icon.webp",
    };
    return map[categoryName] || "/assets/world/world-service-icon.webp";
  }

  function worldPlanLabelFull(plan: unknown) {
    const normalized = normalizeWorldPlan(plan);
    if (normalized === "pro") return text("World Pro", "World Pro");
    if (normalized === "member") return text("World Member", "World Member");
    return text("World Presence", "World Presence");
  }

  function renderChipList(targetId: string, values: unknown[], emptyLabel: string) {
    const target = byId(targetId);
    if (!target) return;
    const entries = (values || []).map((value) => String(value || "").trim()).filter(Boolean);
    target.innerHTML = entries.length
      ? entries.map((entry) => `<span class="world-chip">${escapeHtml(entry)}</span>`).join("")
      : `<span class="world-chip world-chip--muted">${escapeHtml(emptyLabel)}</span>`;
  }

  function renderProfile() {
    const initials = String(profile.display_name).split(/\s+/).slice(0, 2).map((part: string) => part[0]).join("").toUpperCase();
    const avatar = byId("profileAvatar")!;
    const availabilityLabel = ({ available: text("Available for projects", "Disponível para projetos"), limited: text("Limited availability", "Disponibilidade limitada"), unavailable: text("Currently unavailable", "Indisponível no momento") } as any)[profile.availability] || profile.availability;
    avatar.innerHTML = profile.avatar_url ? `<img src="${escapeHtml(profile.avatar_url)}" alt="">` : escapeHtml(initials);
    byId("profileHandle")!.textContent = `@${profile.handle}`;
    byId("profileName")!.textContent = profile.display_name;
    byId("profileHeadline")!.textContent = profile.headline;
    byId("profileLocation")!.textContent = profile.location || text("Remote", "Remoto");
    byId("profileAvailability")!.textContent = availabilityLabel;
    byId("profileBio")!.textContent = profile.bio;
    renderChipList("profileSpecialties", profile.specialties || [], text("Not specified", "Não informado"));
    renderChipList("profileLanguages", profile.languages || [], text("Not specified", "Não informado"));
    const planBadge = byId("profilePlanBadge") as HTMLElement;
    const plan = normalizeWorldPlan(publicWorldPlan);
    planBadge.hidden = plan === "free";
    planBadge.textContent = worldPlanLabel(plan);
    planBadge.dataset.plan = plan;
    (byId("verifiedBadge") as HTMLElement).hidden = !profile.is_verified;
    const link = byId("portfolioLink") as HTMLAnchorElement;
    link.hidden = !profile.portfolio_url;
    if (profile.portfolio_url) {
      link.href = profile.portfolio_url;
    }
    const signalIcon = byId("profileSignalIcon") as HTMLImageElement | null;
    if (signalIcon) signalIcon.src = "/assets/world/world-layer-icon.webp";
    byId("profileServiceCount")!.textContent = String(services.length);
    byId("profileSignalPlan")!.textContent = worldPlanLabelFull(publicWorldPlan);
    byId("profileSignalAvailability")!.textContent = availabilityLabel;
    byId("profileHero")!.hidden = false;
    byId("profileBody")!.hidden = false;
    byId("services")!.hidden = false;
    setState("");
  }

  function renderServices() {
    const grid = byId("servicesGrid")!;
    if (!services.length) {
      grid.innerHTML = `<article class="world-empty">${text("This professional has not published services yet.", "Este profissional ainda não publicou serviços.")}</article>`;
      return;
    }
    const viewingOwnProfile = !!(user && profile && user.id === profile.user_id);
    grid.innerHTML = services.map((service, index) => `<article class="world-service-card">
      <div class="world-service-card__media"><img src="${escapeHtml(categoryIcon(service.category || "Other"))}" alt="" loading="lazy" decoding="async" /></div>
      <div class="world-service-card__head">
        <span class="world-service-card__category">${escapeHtml(service.category || text("Service", "Serviço"))}</span>
        <em class="world-service-card__signal">${service.vx_discount_pct ? `VX · ${text("Member benefit up to", "Benefício para membros de até")} ${escapeHtml(service.vx_discount_pct)}%` : text("Direct private brief", "Briefing privado direto")}</em>
      </div>
      <h3>${escapeHtml(service.title)}</h3>
      <p>${escapeHtml(service.description)}</p>
      <div class="world-service-card__meta">
        <article><small>${text("Investment", "Investimento")}</small><strong>${escapeHtml(formatPrice(service))}</strong></article>
        <article><small>${text("Delivery", "Entrega")}</small><strong>${service.delivery_days ? `${escapeHtml(service.delivery_days)} ${text("days", "dias")}` : text("Timeline by brief", "Prazo por briefing")}</strong></article>
      </div>
      <button class="button button--gold" data-service-index="${index}" type="button">${viewingOwnProfile ? text("Manage in World", "Gerir no World") : text("Request service", "Solicitar serviço")}</button>
    </article>`).join("");
    grid.querySelectorAll<HTMLButtonElement>("[data-service-index]").forEach((button) => button.addEventListener("click", () => {
      if (viewingOwnProfile) {
        location.href = "/world/#join-world";
        return;
      }
      openInquiry(services[Number(button.dataset.serviceIndex)]);
    }));
  }

  function openInquiry(service: any) {
    if (!user) {
      location.href = `/login/?next=${encodeURIComponent(location.pathname + location.search + "#services")}`;
      return;
    }
    if (user.id === profile.user_id) return setState(text("This is your own public profile.", "Este é o seu próprio perfil público."));
    selectedService = service;
    byId("inquiryTitle")!.textContent = service.title;
    (byId("inquirySubject") as HTMLInputElement).value = service.title;
    (byId("inquiryEmail") as HTMLInputElement).value = user.email || localStorage.getItem("volynx_user_email") || "";
    (byId("inquiryDialog") as HTMLDialogElement).showModal();
  }

  byId("inquiryForm")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const state = byId("inquiryState")!;
    state.textContent = text("Sending private brief...", "Enviando briefing privado...");
    const { error } = await supabase.from("world_inquiries").insert({
      client_id: user.id,
      provider_id: profile.user_id,
      service_id: selectedService.id,
      reply_email: value("inquiryEmail"),
      subject: value("inquirySubject"),
      brief: value("inquiryBrief"),
      budget: value("inquiryBudget") || null,
      timeline: value("inquiryTimeline") || null,
    });
    state.textContent = error ? error.message : text("Brief sent privately.", "Briefing enviado em privado.");
    state.dataset.kind = error ? "error" : "success";
    if (!error) (byId("inquiryForm") as HTMLFormElement).reset();
  });

  window.addEventListener("vx:lang-changed", () => {
    if (profile) {
      renderProfile();
      renderServices();
    } else {
      renderProfileError();
    }
  });

  async function boot() {
    const handle = new URLSearchParams(location.search).get("handle")?.toLowerCase().trim();
    if (!handle) {
      profileError = "missing_handle";
      return renderProfileError();
    }
    cfg = await fetch("/config.json", { cache: "no-store" }).then((response) => response.json());
    supabase = createClient(cfg.supabaseUrl, cfg.supabaseAnonKey);
    await restoreSession();
    const { data, error } = await supabase.from("world_profiles").select("*").eq("handle", handle).eq("is_published", true).maybeSingle();
    if (error || !data) {
      profileError = "unavailable";
      return renderProfileError();
    }
    profile = data;
    const planResult = await supabase.rpc("world_public_membership", { p_user_ids: [profile.user_id] });
    if (!planResult.error) {
      publicWorldPlan = normalizeWorldPlan(planResult.data?.[0]?.world_plan);
    }
    const serviceResult = await supabase.from("world_services").select("*").eq("provider_id", profile.user_id).eq("status", "published").order("updated_at", { ascending: false });
    services = serviceResult.data || [];
    document.title = `${profile.display_name} — Volynx World`;
    renderProfile();
    renderServices();
  }
  boot().catch(() => {
    profileError = "load_error";
    renderProfileError();
  });
</script>

<style>
  .world-profile {
    display:grid;
    gap:24px;
    padding:46px 0 110px;
  }
  .world-back {
    width:fit-content;
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:12px 18px;
    color:rgba(255,255,255,.7);
    text-decoration:none;
    border:1px solid rgba(255,255,255,.1);
    border-radius:999px;
    background:linear-gradient(135deg,rgba(255,255,255,.05),rgba(255,255,255,.02));
    box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 18px 38px rgba(0,0,0,.24);
    transition:transform .24s ease,border-color .24s ease,color .24s ease,background .24s ease;
  }
  .world-back:hover {
    transform:translateY(-1px);
    color:#fff;
    border-color:rgba(255,215,106,.35);
    background:linear-gradient(135deg,rgba(255,215,106,.08),rgba(103,241,209,.05));
  }
  .world-state { color:rgba(255,255,255,.55); }
  .world-state[data-kind="error"] { display:flex;align-items:flex-start;flex-direction:column;gap:18px;padding:28px;border:1px solid rgba(255,154,154,.18);border-radius:20px;background:rgba(255,154,154,.035);color:#ffb0b0; }
  .world-state[data-kind="success"] { color:#74f3c9; }
  .world-profile__hero,
  .world-profile__body,
  .world-services {
    position:relative;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.09);
    border-radius:32px;
    background:
      linear-gradient(145deg,rgba(20,22,33,.92),rgba(7,10,17,.86)),
      radial-gradient(circle at top left,rgba(118,0,182,.12),transparent 34%),
      radial-gradient(circle at top right,rgba(72,193,255,.08),transparent 42%);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.06),
      0 40px 90px rgba(0,0,0,.26);
  }
  .world-profile__hero::before,
  .world-profile__body::before,
  .world-services::before {
    content:"";
    position:absolute;
    inset:0;
    pointer-events:none;
    background:
      radial-gradient(circle at 14% 18%,rgba(166,122,255,.12),transparent 24%),
      radial-gradient(circle at 88% 22%,rgba(103,241,209,.12),transparent 26%);
    opacity:.9;
  }
  .world-profile__hero[hidden],.world-profile__body[hidden],.world-services[hidden] { display:none!important; }
  .world-profile [hidden],.world-dialog [hidden] { display:none!important; }
  .world-profile__hero {
    display:grid;
