---
import FlagshipLayout from '../../../../layouts/FlagshipLayout.astro';
import FlagshipHeader from '../../../../components/FlagshipHeader.astro';
import FlagshipFooter from '../../../../components/FlagshipFooter.astro';
import WorldNav from '../../../../components/WorldNav.astro';
import { ROUTES } from '../../../../data/routes';
import '../../../../styles/world-opportunities.css';
---
<FlagshipLayout title="Opportunity details — VOLYNX World" description="Review opportunity requirements, eligibility and source before applying." pageClass="page-world-opportunity-detail">
<FlagshipHeader current={ROUTES.world} ctaI18n="" ctaLabel="World" ctaHref={ROUTES.worldWorkspace}/>
<main class="shell world-work" data-world-app="detail"><WorldNav current={ROUTES.worldOpportunities}/><p id="worldStatus" class="status" role="status" aria-live="polite"></p><div id="worldResults"></div></main><FlagshipFooter/>
</FlagshipLayout>
<script>import '../../../../scripts/world-opportunities';</script>
