  async function handleWorldCheckout(plan: string) {
    if (!user || !accessToken) {
      window.location.href = `/login/?next=${encodeURIComponent("/world/#world-pricing")}`;
      return;
    }
    if (!cfg?.functionsUrl) return;
    const currency = (localStorage.getItem("volynx_currency") || "GBP").toUpperCase();
    const validCurrencies = ["GBP", "EUR", "BRL"];
    const safeCurrency = validCurrencies.includes(currency) ? currency : "GBP";
    const lookupKey = `${plan}_${safeCurrency.toLowerCase()}`;
    const successUrl = `${window.location.origin}/world/?plan_success=1#join-world`;
    const cancelUrl = `${window.location.origin}/world/#world-pricing`;
    const buttons = document.querySelectorAll<HTMLButtonElement>(`.world-checkout-btn[data-plan="${plan}"]`);
    buttons.forEach((btn) => { btn.disabled = true; btn.textContent = text("Redirecting…", "Redirecionando…"); });
    try {
      const response = await fetch(`${cfg.functionsUrl}/create-checkout-session`, {
        method: "POST",
        headers: { Authorization: `Bearer ${accessToken}`, "Content-Type": "application/json" },
        body: JSON.stringify({ lookup_key: lookupKey, success_url: successUrl, cancel_url: cancelUrl }),
      });
      const result = await response.json().catch(() => ({}));
      if (result.url) { window.location.href = result.url; return; }
      buttons.forEach((btn) => { btn.disabled = false; btn.textContent = text("Try again", "Tente novamente"); });
    } catch {
      buttons.forEach((btn) => { btn.disabled = false; btn.textContent = text("Try again", "Tente novamente"); });
    }
  }

  document.querySelectorAll<HTMLButtonElement>(".world-checkout-btn").forEach((btn) => {
    btn.addEventListener("click", () => handleWorldCheckout(btn.dataset.plan || ""));
  });
  byId("manageWorldBilling")?.addEventListener("click", handleWorldBilling);

  async function boot() {
    initWorldScene();
    cfg = await fetch("/config.json", { cache: "no-store" }).then((response) => response.json());
    supabase = createClient(cfg.supabaseUrl, cfg.supabaseAnonKey);
    updateLocalizedControls();
    updateServicePriceControl();
    await restoreSession();
    await loadMarketplace();
    if (user) {
      byId("worldManager")!.hidden = false;
      byId("worldLoginCta")!.hidden = true;
      await loadOwnWorld();
      renderServicePlanGate();
      const successParam = new URLSearchParams(window.location.search).get("plan_success");
      if (successParam) setStatus("profileFormStatus", text("Plan activated — welcome to World!", "Plano ativado — bem-vindo ao World!"), "success");
    }
    initWorldReveal();
  }
  boot().catch((error) => setStatus("marketplaceStatus", error?.message || "World could not load.", "error"));
</script>

