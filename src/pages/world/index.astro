<script>
  import { createClient } from "@supabase/supabase-js";
  import { initWorldScene } from "../../scripts/world-three";

  const byId = (id: string) => document.getElementById(id) as HTMLElement | null;
  const value = (id: string) => ((byId(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value || "").trim();
  const splitList = (input: string) => input.split(",").map((item) => item.trim()).filter(Boolean).slice(0, 12);
  const escapeHtml = (input: unknown) => String(input ?? "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" }[char] || char));
  const isPt = () => document.documentElement.lang.toLowerCase().startsWith("pt");
  const text = (en: string, pt: string) => isPt() ? pt : en;
  type WorldBridgeWindow = Window & {
    VxAuthBridge?: { hydrate?: () => void; sync?: () => void };
    vxEnsureFreshToken?: () => Promise<unknown>;
  };

  let supabase: any;
  let cfg: any = null;
  let accessToken = "";
  let user: any = null;
  let services: any[] = [];
  let ownProfile: any = null;
  let ownServices: any[] = [];
  let receivedInquiries: any[] = [];
  let starterBenefit: any = null;
  let worldPlan = "free";
  let category = "";
  let selectedService: any = null;
  let editingServiceId = "";
  let marketplaceUnavailable = false;
  const WORLD_PLAN_PRIORITY: Record<string, number> = { free: 0, member: 1, pro: 2 };

  function normalizeWorldPlan(plan: unknown) {
    return plan === "member" || plan === "pro" ? plan : "free";
  }

  function readStoredWorldSession() {
    try {
      const raw = localStorage.getItem("volynx_session");
      const parsed = raw ? JSON.parse(raw) : {};
      return parsed && typeof parsed === "object" ? parsed : {};
    } catch {
      return {};
    }
  }

  function persistWorldSession(session: any, fallbackRefreshToken = "") {
    try {
      const nextAccessToken = String(session?.access_token || "");
      const nextRefreshToken = String(session?.refresh_token || fallbackRefreshToken || "");
      const nextEmail = String(session?.user?.email || localStorage.getItem("volynx_user_email") || "");
      if (!nextAccessToken) return;
      localStorage.setItem("volynx_access_token", nextAccessToken);
      if (nextRefreshToken) localStorage.setItem("volynx_refresh_token", nextRefreshToken);
      if (nextEmail) localStorage.setItem("volynx_user_email", nextEmail);
      localStorage.setItem("volynx_session", JSON.stringify({
        access_token: nextAccessToken,
        refresh_token: nextRefreshToken,
        expires_at: session?.expires_at ?? null,
        expires_in: session?.expires_in ?? null,
        user: session?.user || (nextEmail ? { email: nextEmail } : null),
      }));
      (window as WorldBridgeWindow).VxAuthBridge?.sync?.();
    } catch {}
  }

  async function refreshWorldSession(refreshToken: string) {
    if (!cfg?.supabaseUrl || !cfg?.supabaseAnonKey || !refreshToken) return null;
    try {
      const response = await fetch(`${String(cfg.supabaseUrl).replace(/\/$/, "")}/auth/v1/token?grant_type=refresh_token`, {
        method: "POST",
        headers: {
          apikey: cfg.supabaseAnonKey,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ refresh_token: refreshToken }),
      });
      if (!response.ok) return null;
      const session = await response.json();
      if (!session?.access_token) return null;
      persistWorldSession(session, refreshToken);
      return session;
    } catch {
      return null;
    }
  }

  function worldPlanRank(plan: unknown) {
    return WORLD_PLAN_PRIORITY[normalizeWorldPlan(plan)] || 0;
  }

  function getWorldPlanMeta(plan: unknown) {
    const normalized = normalizeWorldPlan(plan);
    if (normalized === "pro") {
      return {
        key: "pro",
        label: text("World Pro", "World Pro"),
        description: text(
          "Top priority in discovery, premium spotlight, and email alerts on every brief.",
          "Prioridade máxima na descoberta, destaque premium e alertas por email em cada briefing.",
        ),
        publishing: text("Unlimited published services", "Serviços publicados ilimitados"),
        discovery: text("Featured above Member and Presence", "Destaque acima de Member e Presence"),
        briefs: text("Dashboard + email notifications", "Painel + notificações por email"),
      };
    }
    if (normalized === "member") {
      return {
        key: "member",
        label: text("World Member", "World Member"),
        description: text(
          "Unlimited services, visible Member badge, and email alerts on every brief.",
          "Serviços ilimitados, badge Member visível e alertas por email em cada briefing.",
        ),
        publishing: text("Unlimited published services", "Serviços publicados ilimitados"),
        discovery: text("Priority above free profiles", "Prioridade acima de perfis gratuitos"),
        briefs: text("Dashboard + email notifications", "Painel + notificações por email"),
      };
    }
    return {
      key: "free",
      label: text("World Presence", "World Presence"),
      description: text(
        "Free public presence with one published service and private briefs in your dashboard.",
        "Presença pública gratuita com um serviço publicado e briefings privados no seu painel.",
      ),
      publishing: text("1 published service", "1 serviço publicado"),
      discovery: text("Standard marketplace placement", "Posicionamento padrão no marketplace"),
      briefs: text("Dashboard inbox", "Caixa de entrada no painel"),
    };
  }

  function localizeWorldError(message: string) {
    if (!message) return message;
    if (message.includes("world_free_service_limit")) {
      return text(
        "Free profiles can publish only 1 service. Upgrade to World Member or World Pro to publish more.",
        "Perfis gratuitos podem publicar apenas 1 serviço. Faça upgrade para World Member ou World Pro para publicar mais.",
      );
    }
    return message;
  }

  function setStatus(id: string, message: string, kind = "") {
    const el = byId(id);
    if (!el) return;
    el.textContent = message;
    el.dataset.kind = kind;
  }

  function formatPrice(service: any) {
    if (service.pricing_type === "quote" || !service.price_amount) return text("Request a quote", "Solicitar orçamento");
    const locale = isPt() ? "pt-BR" : "en-GB";
    const formatted = new Intl.NumberFormat(locale, { style: "currency", currency: service.currency }).format(service.price_amount / 100);
    if (service.pricing_type === "starting_at") return `${text("From", "A partir de")} ${formatted}`;
    if (service.pricing_type === "hourly") return `${formatted}/${text("hour", "hora")}`;
    return formatted;
  }

  function formatCategory(categoryName: string) {
    const labels: Record<string, [string, string]> = {
      "Web & Technology": ["Web & Technology", "Web e Tecnologia"],
      "Design & Brand": ["Design & Brand", "Design e Marca"],
      "Marketing & Growth": ["Marketing & Growth", "Marketing e Crescimento"],
      "Business & Strategy": ["Business & Strategy", "Negócios e Estratégia"],
      "Content & Media": ["Content & Media", "Conteúdo e Mídia"],
      Other: ["Other", "Outro"],
    };
    const label = labels[categoryName];
    return label ? text(label[0], label[1]) : categoryName;
  }

  function formatStatus(status: string) {
    const labels: Record<string, [string, string]> = {
      available: ["Available", "Disponível"],
      limited: ["Limited", "Limitado"],
      unavailable: ["Unavailable", "Indisponível"],
      published: ["Published", "Publicado"],
      draft: ["Draft", "Rascunho"],
      paused: ["Paused", "Pausado"],
      new: ["New", "Novo"],
      reviewing: ["Reviewing", "Em análise"],
      accepted: ["Accepted", "Aceito"],
      declined: ["Declined", "Recusado"],
      closed: ["Closed", "Fechado"],
    };
    const label = labels[status];
    return label ? text(label[0], label[1]) : status;
  }

  function categoryIcon(categoryName: string) {
    const map: Record<string, string> = {
      "Web & Technology": "/assets/world/world-intelligence-icon.webp",
      "Design & Brand": "/assets/world/world-brand-icon.webp",
      "Marketing & Growth": "/assets/world/world-growth-icon.webp",
      "Business & Strategy": "/assets/world/world-strategy-icon.webp",
      "Content & Media": "/assets/world/world-portfolio-icon.webp",
      "Other": "/assets/world/world-service-icon.webp",
    };
    return map[categoryName] || "/assets/world/world-service-icon.webp";
  }

  function updateLocalizedControls() {
    const placeholders: Record<string, [string, string]> = {
      worldSearch: ["Branding, websites, automation...", "Marca, sites, automação..."],
      profileHandle: ["your_name", "seu_nome"],
      profileHeadline: ["Product designer for ambitious digital brands", "Designer de produtos para marcas digitais ambiciosas"],
      profileLocation: ["London, UK · Remote", "Lisboa, Portugal · Remoto"],
      profileSpecialties: ["Web design, Brand strategy, Astro", "Web design, Estratégia de marca, Astro"],
      profileLanguages: ["English, Português", "Português, English"],
      serviceTitle: ["Premium landing page design and build", "Design e construção de landing page premium"],
      servicePrice: ["500.00", "500,00"],
      inquiryBudget: ["£1,000–£2,000", "R$ 5.000–R$ 10.000"],
      inquiryTimeline: ["Within 4 weeks", "Em até 4 semanas"],
    };
    Object.entries(placeholders).forEach(([id, labels]) => {
      const input = byId(id) as HTMLInputElement | null;
      if (input) input.placeholder = text(labels[0], labels[1]);
    });
    const status = byId("serviceStatus") as HTMLSelectElement | null;
    if (status) {
      Array.from(status.options).forEach((option) => { option.textContent = formatStatus(option.value); });
    }
    const availability = byId("profileAvailability") as HTMLSelectElement | null;
    if (availability) Array.from(availability.options).forEach((option) => { option.textContent = formatStatus(option.value); });
    const categorySelect = byId("serviceCategory") as HTMLSelectElement | null;
    if (categorySelect) Array.from(categorySelect.options).forEach((option) => { option.textContent = formatCategory(option.value || option.textContent || "Other"); });
    const pricing = byId("servicePricing") as HTMLSelectElement | null;
    if (pricing) {
      const labels: Record<string, [string, string]> = {
        quote: ["Request a quote", "Solicitar orçamento"],
        starting_at: ["Starting at", "A partir de"],
        fixed: ["Fixed price", "Preço fixo"],
        hourly: ["Hourly", "Por hora"],
      };
      Array.from(pricing.options).forEach((option) => {
        const label = labels[option.value];
        if (label) option.textContent = text(label[0], label[1]);
      });
    }
    const vx = byId("serviceVx") as HTMLSelectElement | null;
    if (vx) {
      Array.from(vx.options).forEach((option) => {
        option.textContent = option.value === "0" ? text("Not yet", "Ainda não") : text(`Up to ${option.value}%`, `Até ${option.value}%`);
      });
    }
    const starterTemplate = byId("starterTemplate") as HTMLSelectElement | null;
    if (starterTemplate) {
      const labels: Record<string, [string, string]> = {
        executive: ["Executive", "Executivo"],
        nordic: ["Nordic", "Nórdico"],
        developer: ["Developer", "Desenvolvedor"],
        creative: ["Creative", "Criativo"],
        timeline: ["Timeline", "Linha do tempo"],
      };
      Array.from(starterTemplate.options).forEach((option) => {
        const label = labels[option.value];
        if (label) option.textContent = text(label[0], label[1]);
      });
    }
    const close = byId("inquiryCloseButton") as HTMLButtonElement | null;
    if (close) close.setAttribute("aria-label", text("Close", "Fechar"));
  }

  function updateServicePriceControl() {
    const pricing = byId("servicePricing") as HTMLSelectElement | null;
    const price = byId("servicePrice") as HTMLInputElement | null;
    if (!pricing || !price) return;
    const requiresPrice = pricing.value !== "quote";
    price.required = requiresPrice;
    price.disabled = !requiresPrice;
    if (!requiresPrice) price.value = "";
  }

  function initWorldReveal() {
    const nodes = Array.from(document.querySelectorAll<HTMLElement>(".world-reveal:not(.is-visible)"));
    if (!nodes.length) return;
    if (!("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      nodes.forEach((node) => node.classList.add("is-visible"));
      return;
    }
    const observer = new IntersectionObserver((entries, instance) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        instance.unobserve(entry.target);
      });
    }, { rootMargin: "0px 0px -12% 0px", threshold: 0.12 });
    nodes.forEach((node) => observer.observe(node));
  }

  function renderMarketplace() {
    setStatus(
      "marketplaceStatus",
      marketplaceUnavailable
        ? ""
        : services.length
          ? `${services.length} ${text("founding services available", "serviços fundadores disponíveis")}`
          : text("Founding professionals can publish now.", "Profissionais fundadores já podem publicar."),
      "",
    );
    const query = value("worldSearch").toLowerCase();
    const filtered = services.filter((service) => {
      const profile = service.world_profiles || {};
      const haystack = [service.title, service.description, service.category, profile.display_name, profile.headline, ...(profile.specialties || [])].join(" ").toLowerCase();
      return (!category || service.category === category) && (!query || haystack.includes(query));
    });
    const grid = byId("worldGrid");
    if (!grid) return;
    if (!filtered.length) {
      grid.innerHTML = marketplaceUnavailable
        ? `<article class="world-empty world-reveal"><img src="/assets/world/world-network-icon.webp" alt="" loading="lazy" decoding="async"><strong>${text("Founding profiles are being prepared.", "Os perfis fundadores estão sendo preparados.")}</strong><p>${text("Volynx World is opening its first professional network. Sign in to prepare your presence.", "O Volynx World está abrindo sua primeira rede profissional. Entre para preparar sua presença.")}</p><a class="button button--gold" href="#join-world">${text("Prepare my World profile", "Preparar meu perfil World")}</a></article>`
        : `<article class="world-empty world-reveal"><img src="/assets/world/world-discovery-icon.webp" alt="" loading="lazy" decoding="async"><strong>${text("The founding marketplace is open.", "O marketplace fundador está aberto.")}</strong><p>${text("No service matches this search yet. Be one of the first professionals to publish.", "Nenhum serviço corresponde a esta busca ainda. Seja um dos primeiros profissionais a publicar.")}</p><a class="button button--gold" href="#join-world">${text("Join Volynx World", "Entrar no Volynx World")}</a></article>`;
      requestAnimationFrame(initWorldReveal);
      return;
    }
    grid.innerHTML = filtered.map((service, index) => {
      const profile = service.world_profiles || {};
      const initials = String(profile.display_name || "VW").split(/\s+/).slice(0, 2).map((part: string) => part[0]).join("").toUpperCase();
      const bio = String(profile.bio || "").trim();
      const headline = String(profile.headline || "").trim();
      const handle = String(profile.handle || "").trim();
      const availability = ({
        available: text("Available", "Disponível"),
        limited: text("Limited availability", "Disponibilidade limitada"),
        unavailable: text("Currently unavailable", "Indisponível no momento"),
      } as Record<string, string>)[String(profile.availability || "").toLowerCase()] || String(profile.availability || text("Available", "Disponível"));
      const tags = (profile.specialties || []).slice(0, 3).map((tag: string) => `<span>${escapeHtml(tag)}</span>`).join("");
      const icon = categoryIcon(service.category || "Other");
      const planMeta = getWorldPlanMeta(service.public_world_plan);
      const publicBadges = [
        `<em class="world-card__badge world-card__badge--${planMeta.key}">${escapeHtml(planMeta.label)}</em>`,
        profile.is_verified ? `<em class="world-card__badge world-card__badge--verified">${text("World Verified", "Verificado World")}</em>` : "",
      ].filter(Boolean).join("");
      const tierClass = service.public_world_plan === "pro"
        ? " world-card--pro"
        : service.public_world_plan === "member"
          ? " world-card--member"
          : "";
      return `<article class="world-card world-reveal${tierClass}">
        <div class="world-card__topline">
          <span class="world-card__category">${escapeHtml(formatCategory(service.category || "Other"))}</span>
          <div class="world-card__badges">${publicBadges}</div>
        </div>
        <div class="world-card__hero">
          <div class="world-card__media">
            <div class="world-card__portrait">${profile.avatar_url ? `<img src="${escapeHtml(profile.avatar_url)}" alt="${escapeHtml(profile.display_name)}">` : escapeHtml(initials)}</div>
          </div>
          <div class="world-card__identity">
            ${handle ? `<span class="world-card__handle">@${escapeHtml(handle)}</span>` : ""}
            <a href="/world/profile/?handle=${encodeURIComponent(profile.handle || "")}"><strong>${escapeHtml(profile.display_name)}</strong></a>
            ${headline ? `<span class="world-card__headline">${escapeHtml(headline)}</span>` : ""}
            <div class="world-card__signal"><span>${escapeHtml(profile.location || text("Remote", "Remoto"))}</span><span>${escapeHtml(availability)}</span></div>
            ${bio ? `<p class="world-card__bio">${escapeHtml(bio)}</p>` : ""}
          </div>
        </div>
        <div class="world-card__service">
          <div class="world-card__service-head">
            <h3>${escapeHtml(service.title)}</h3>
            <span class="world-card__icon" aria-hidden="true"><img src="${escapeHtml(icon)}" alt="" loading="lazy" decoding="async"></span>
          </div>
          <p class="world-card__description">${escapeHtml(service.description)}</p>
          ${tags ? `<div class="world-card__tags">${tags}</div>` : ""}
          <div class="world-card__meta">
            <span><em>${text("Investment", "Investimento")}</em><strong>${escapeHtml(formatPrice(service))}</strong></span>
