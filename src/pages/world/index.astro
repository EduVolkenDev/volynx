---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";
---

<FlagshipLayout
  title="Volynx World — Premium professionals for ambitious work"
  description="Discover clear professional services, publish your expertise, and connect directly inside Volynx World."
  pageClass="page-world"
>
  <FlagshipHeader current={ROUTES.world} ctaLabel="Join World" ctaHref="#join-world" ctaI18n="nav.world" />

  <main>
    <section class="world-hero">
      <div class="shell world-hero__grid">
        <div>
          <span class="world-kicker"><span class="i18n-en">Volynx World · Founding marketplace</span><span class="i18n-pt">Volynx World · Marketplace fundador</span></span>
          <h1>
            <span class="i18n-en">The right professional can change what is possible.</span>
            <span class="i18n-pt">O profissional certo pode mudar o que é possível.</span>
          </h1>
          <p>
            <span class="i18n-en">Find premium talent, clear services, and people ready to build. Volynx World is where ambitious work starts a direct conversation.</span>
            <span class="i18n-pt">Encontre talentos premium, serviços claros e pessoas prontas para construir. Volynx World é onde trabalhos ambiciosos começam uma conversa direta.</span>
          </p>
          <div class="world-actions">
            <a href="#marketplace" class="button button--gold"><span class="i18n-en">Find a professional</span><span class="i18n-pt">Encontrar profissional</span></a>
            <a href="#join-world" class="button button--ghost"><span class="i18n-en">Offer your services</span><span class="i18n-pt">Oferecer serviços</span></a>
          </div>
          <div class="world-trust">
            <span>✓ <span class="i18n-en">Clear service offers</span><span class="i18n-pt">Ofertas claras</span></span>
            <span>✓ <span class="i18n-en">Direct project briefs</span><span class="i18n-pt">Briefings diretos</span></span>
            <span>VX <span class="i18n-en">founder benefit active</span><span class="i18n-pt">benefício fundador ativo</span></span>
          </div>
        </div>
        <aside class="world-vision" aria-label="Volynx World professional network preview">
          <div class="world-orbit" aria-hidden="true">
            <div class="world-orbit__core">
              <img src="/assets/V.webp" alt="" loading="eager" decoding="async" />
            </div>
            <div class="world-orbit__node world-orbit__node--one"><img src="/assets/builder.webp" alt="" loading="lazy" decoding="async" /></div>
            <div class="world-orbit__node world-orbit__node--two"><img src="/assets/cvitae.webp" alt="" loading="lazy" decoding="async" /></div>
            <div class="world-orbit__node world-orbit__node--three"><img src="/assets/lumina-icon-transparent.webp" alt="" loading="lazy" decoding="async" /></div>
            <div class="world-orbit__node world-orbit__node--four"><img src="/assets/propertyflow.webp" alt="" loading="lazy" decoding="async" /></div>
          </div>
          <span>WORLD INTELLIGENCE</span>
          <strong><span class="i18n-en">Professionals inside the platform, not outside the story.</span><span class="i18n-pt">Profissionais dentro da plataforma, não fora da história.</span></strong>
          <p><span class="i18n-en">World should feel like a premium network layer: discoverable profiles, clear services, private briefs, and platform-native benefits for serious work.</span><span class="i18n-pt">O World precisa parecer uma camada premium de rede: perfis encontráveis, serviços claros, briefings privados e benefícios nativos da plataforma para trabalho sério.</span></p>
          <div class="world-signal-grid" aria-label="World platform signals">
            <span><b>01</b><em><span class="i18n-en">Public profile</span><span class="i18n-pt">Perfil público</span></em></span>
            <span><b>02</b><em><span class="i18n-en">Service offer</span><span class="i18n-pt">Oferta de serviço</span></em></span>
            <span><b>03</b><em><span class="i18n-en">Private brief</span><span class="i18n-pt">Briefing privado</span></em></span>
            <span><b>VX</b><em><span class="i18n-en">Member benefit</span><span class="i18n-pt">Benefício membro</span></em></span>
          </div>
        </aside>
      </div>
    </section>

    <section class="world-section world-section--steps">
      <div class="shell">
        <div class="world-section__head">
          <div>
            <span class="world-kicker"><span class="i18n-en">How World works</span><span class="i18n-pt">Como o World funciona</span></span>
            <h2><span class="i18n-en">From clear need to direct conversation.</span><span class="i18n-pt">Da necessidade clara à conversa direta.</span></h2>
          </div>
        </div>
        <div class="world-steps">
          <article><span><img src="/assets/flow-professional.webp" alt="" loading="lazy" decoding="async" /></span><strong><span class="i18n-en">Discover by delivery</span><span class="i18n-pt">Encontre pela entrega</span></strong><p><span class="i18n-en">Search professionals by the service, specialty, and outcome you need.</span><span class="i18n-pt">Busque profissionais pelo serviço, especialidade e resultado que você precisa.</span></p></article>
          <article><span><img src="/assets/contacticon.webp" alt="" loading="lazy" decoding="async" /></span><strong><span class="i18n-en">Send a private brief</span><span class="i18n-pt">Envie um briefing privado</span></strong><p><span class="i18n-en">Share your goal, budget, and timeline directly with the professional.</span><span class="i18n-pt">Compartilhe objetivo, orçamento e prazo diretamente com o profissional.</span></p></article>
          <article><span><img src="/assets/approval1.webp" alt="" loading="lazy" decoding="async" /></span><strong><span class="i18n-en">Agree and build</span><span class="i18n-pt">Combine e construa</span></strong><p><span class="i18n-en">Both parties define the agreement and delivery independently in this founding release.</span><span class="i18n-pt">As duas partes definem o acordo e a entrega de forma independente neste lançamento fundador.</span></p></article>
        </div>
      </div>
    </section>

    <section class="world-section world-section--intelligence" aria-labelledby="world-intelligence-title">
      <div class="shell">
        <div class="world-section__head">
          <div>
            <span class="world-kicker"><span class="i18n-en">Premium network layer</span><span class="i18n-pt">Camada premium de rede</span></span>
            <h2 id="world-intelligence-title"><span class="i18n-en">A smarter surface for professionals inside VOLYNX.</span><span class="i18n-pt">Uma superfície mais inteligente para profissionais dentro da VOLYNX.</span></h2>
          </div>
        </div>
        <div class="world-intelligence">
          <article><img src="/assets/profile2.jpg" alt="" loading="lazy" decoding="async" /><span><span class="i18n-en">Presence</span><span class="i18n-pt">Presença</span></span><strong><span class="i18n-en">Profiles that feel credible before the first message.</span><span class="i18n-pt">Perfis que passam credibilidade antes da primeira mensagem.</span></strong></article>
          <article><img src="/assets/products.webp" alt="" loading="lazy" decoding="async" /><span><span class="i18n-en">Offer clarity</span><span class="i18n-pt">Clareza de oferta</span></span><strong><span class="i18n-en">Services packaged by category, price model, delivery and VX benefit.</span><span class="i18n-pt">Serviços empacotados por categoria, preço, entrega e benefício VX.</span></strong></article>
          <article><img src="/assets/lab-studio-memory.webp" alt="" loading="lazy" decoding="async" /><span><span class="i18n-en">Platform memory</span><span class="i18n-pt">Memória da plataforma</span></span><strong><span class="i18n-en">Private briefs and opportunities stay attached to the professional command layer.</span><span class="i18n-pt">Briefings privados e oportunidades ficam ligados ao comando profissional.</span></strong></article>
        </div>
      </div>
    </section>

    <section class="world-section" id="marketplace">
      <div class="shell">
        <div class="world-section__head">
          <div>
            <span class="world-kicker"><span class="i18n-en">World marketplace</span><span class="i18n-pt">Marketplace World</span></span>
            <h2><span class="i18n-en">Discover people by what they can deliver.</span><span class="i18n-pt">Encontre pessoas pelo que elas conseguem entregar.</span></h2>
          </div>
          <label class="world-search">
            <span class="i18n-en">Search services or specialties</span><span class="i18n-pt">Buscar serviços ou especialidades</span>
            <input id="worldSearch" type="search" placeholder="Branding, websites, automation..." />
          </label>
        </div>
        <div class="world-filter-row" id="worldFilters">
          <button class="is-active" type="button" data-category=""><span class="i18n-en">All</span><span class="i18n-pt">Todos</span></button>
          <button type="button" data-category="Web & Technology"><span class="i18n-en">Web & Technology</span><span class="i18n-pt">Web e Tecnologia</span></button>
          <button type="button" data-category="Design & Brand"><span class="i18n-en">Design & Brand</span><span class="i18n-pt">Design e Marca</span></button>
          <button type="button" data-category="Marketing & Growth"><span class="i18n-en">Marketing & Growth</span><span class="i18n-pt">Marketing e Crescimento</span></button>
          <button type="button" data-category="Business & Strategy"><span class="i18n-en">Business & Strategy</span><span class="i18n-pt">Negócios e Estratégia</span></button>
          <button type="button" data-category="Content & Media"><span class="i18n-en">Content & Media</span><span class="i18n-pt">Conteúdo e Mídia</span></button>
        </div>
        <p class="world-status" id="marketplaceStatus"><span class="i18n-en">Loading founding professionals...</span><span class="i18n-pt">Carregando profissionais fundadores...</span></p>
        <div class="world-grid" id="worldGrid"></div>
        <p class="world-independent"><span class="i18n-en">Founding release: professionals operate independently and remain responsible for their offers, agreements, delivery, taxes, and legal obligations. Volynx World provides discovery and private introductions; protected payments and verified reviews are not active yet.</span><span class="i18n-pt">Lançamento fundador: profissionais atuam de forma independente e continuam responsáveis por suas ofertas, acordos, entregas, impostos e obrigações legais. Volynx World oferece descoberta e apresentações privadas; pagamentos protegidos e avaliações verificadas ainda não estão ativos.</span></p>
      </div>
    </section>

    <section class="world-section world-section--panel" id="join-world">
      <div class="shell">
        <div class="world-section__head">
          <div>
            <span class="world-kicker"><span class="i18n-en">Professional command</span><span class="i18n-pt">Comando profissional</span></span>
            <h2><span class="i18n-en">Build your public World presence.</span><span class="i18n-pt">Construa sua presença pública no World.</span></h2>
            <p><span class="i18n-en">Publish a focused profile and services people can understand and request.</span><span class="i18n-pt">Publique um perfil focado e serviços que as pessoas consigam entender e solicitar.</span></p>
          </div>
          <a id="worldLoginCta" href="/login/?next=/world/%23join-world" class="button button--gold"><span class="i18n-en">Sign in to join</span><span class="i18n-pt">Entrar para participar</span></a>
        </div>

        <div class="world-manager" id="worldManager" hidden>
          <form class="world-form" id="worldProfileForm">
            <div class="world-form__head">
              <div><span><img src="/assets/profile2.jpg" alt="" loading="lazy" decoding="async" /></span><h3><span class="i18n-en">Professional profile</span><span class="i18n-pt">Perfil profissional</span></h3></div>
              <label class="world-toggle"><input id="profilePublished" type="checkbox" /><span><span class="i18n-en">Public</span><span class="i18n-pt">Público</span></span></label>
            </div>
            <div class="world-fields">
              <label><span><span class="i18n-en">Display name</span><span class="i18n-pt">Nome público</span></span><input id="profileDisplayName" maxlength="80" required /></label>
              <label><span><span class="i18n-en">World address</span><span class="i18n-pt">Endereço no World</span></span><input id="profileHandle" maxlength="30" pattern="[a-z0-9][a-z0-9_-]{2,29}" placeholder="your_name" required /><small class="world-field-hint">volynx.world/world/profile/?handle=<b id="handlePreview">your_name</b></small></label>
              <label><span><span class="i18n-en">Professional headline</span><span class="i18n-pt">Título profissional</span></span><input id="profileHeadline" maxlength="120" placeholder="Product designer for ambitious digital brands" required /></label>
              <label><span><span class="i18n-en">Location</span><span class="i18n-pt">Localização</span></span><input id="profileLocation" maxlength="100" placeholder="London, UK · Remote" /></label>
              <label><span><span class="i18n-en">Availability</span><span class="i18n-pt">Disponibilidade</span></span><select id="profileAvailability"><option value="available">Available</option><option value="limited">Limited</option><option value="unavailable">Unavailable</option></select></label>
              <label class="world-field--full"><span><span class="i18n-en">Professional bio</span><span class="i18n-pt">Apresentação profissional</span></span><textarea id="profileBio" minlength="40" maxlength="1200" rows="4" required></textarea></label>
              <label><span><span class="i18n-en">Specialties, separated by commas</span><span class="i18n-pt">Especialidades, separadas por vírgulas</span></span><input id="profileSpecialties" placeholder="Web design, Brand strategy, Astro" /></label>
              <label><span><span class="i18n-en">Languages, separated by commas</span><span class="i18n-pt">Idiomas, separados por vírgulas</span></span><input id="profileLanguages" placeholder="English, Português" /></label>
              <label class="world-field--full"><span><span class="i18n-en">Portfolio link</span><span class="i18n-pt">Link do portfólio</span></span><input id="profilePortfolio" type="url" placeholder="https://..." /></label>
            </div>
            <button class="button button--gold" type="submit"><span class="i18n-en">Save professional profile</span><span class="i18n-pt">Salvar perfil profissional</span></button>
            <p class="world-form__status" id="profileFormStatus" aria-live="polite"></p>
          </form>

          <form class="world-form" id="worldServiceForm">
            <div class="world-form__head"><div><span><img src="/assets/products.webp" alt="" loading="lazy" decoding="async" /></span><h3><span class="i18n-en">Publish a service</span><span class="i18n-pt">Publicar um serviço</span></h3></div></div>
            <div class="world-fields">
              <label class="world-field--full"><span><span class="i18n-en">Service title</span><span class="i18n-pt">Título do serviço</span></span><input id="serviceTitle" maxlength="100" placeholder="Premium landing page design and build" required /></label>
              <label><span><span class="i18n-en">Category</span><span class="i18n-pt">Categoria</span></span><select id="serviceCategory"><option>Web & Technology</option><option>Design & Brand</option><option>Marketing & Growth</option><option>Business & Strategy</option><option>Content & Media</option><option>Other</option></select></label>
              <label><span><span class="i18n-en">Pricing</span><span class="i18n-pt">Preço</span></span><select id="servicePricing"><option value="quote">Request a quote</option><option value="starting_at">Starting at</option><option value="fixed">Fixed price</option><option value="hourly">Hourly</option></select></label>
              <label><span><span class="i18n-en">Price</span><span class="i18n-pt">Preço</span></span><input id="servicePrice" type="number" min="0.01" step="0.01" placeholder="500.00" /></label>
              <label><span><span class="i18n-en">Currency</span><span class="i18n-pt">Moeda</span></span><select id="serviceCurrency"><option>GBP</option><option>EUR</option><option>BRL</option><option>USD</option></select></label>
              <label><span><span class="i18n-en">Estimated delivery days</span><span class="i18n-pt">Dias estimados de entrega</span></span><input id="serviceDelivery" type="number" min="1" max="365" /></label>
              <label><span><span class="i18n-en">VX member benefit</span><span class="i18n-pt">Benefício para membros VX</span></span><select id="serviceVx"><option value="0">Not yet</option><option value="5">Up to 5%</option><option value="10">Up to 10%</option><option value="15">Up to 15%</option></select></label>
              <label class="world-field--full"><span><span class="i18n-en">Service description</span><span class="i18n-pt">Descrição do serviço</span></span><textarea id="serviceDescription" minlength="30" maxlength="1200" rows="4" required></textarea></label>
              <label><span>Status</span><select id="serviceStatus"><option value="published">Published</option><option value="draft">Draft</option><option value="paused">Paused</option></select></label>
            </div>
            <div class="world-form__actions"><button class="button button--gold" id="serviceSubmit" type="submit"><span class="i18n-en">Add service</span><span class="i18n-pt">Adicionar serviço</span></button><button class="button button--ghost" id="serviceCancelEdit" type="button" hidden><span class="i18n-en">Cancel edit</span><span class="i18n-pt">Cancelar edição</span></button></div>
            <p class="world-form__status" id="serviceFormStatus" aria-live="polite"></p>
            <div class="world-own-services" id="ownServices"></div>
          </form>

          <section class="world-form">
            <div class="world-form__head"><div><span><img src="/assets/cvitae.webp" alt="" loading="lazy" decoding="async" /></span><h3><span class="i18n-en">World starter benefit</span><span class="i18n-pt">Benefício inicial World</span></h3></div></div>
            <p class="world-manager-note"><span class="i18n-en">Publish a real World presence and claim a founding benefit: one premium CVitae template plus 2 VX to start using the platform economy.</span><span class="i18n-pt">Publique uma presença real no World e resgate um benefício fundador: um template premium do CVitae mais 2 VX para começar a usar a economia da plataforma.</span></p>
            <div class="world-benefit" id="starterBenefit"></div>
            <div class="world-benefit__claim" id="starterBenefitClaim">
              <label><span><span class="i18n-en">CVitae premium template</span><span class="i18n-pt">Template premium CVitae</span></span><select id="starterTemplate"><option value="executive">Executive</option><option value="nordic">Nordic</option><option value="developer">Developer</option><option value="creative">Creative</option><option value="timeline">Timeline</option></select></label>
              <button class="button button--gold" id="claimStarterBenefit" type="button"><span class="i18n-en">Claim founder benefit</span><span class="i18n-pt">Resgatar benefício fundador</span></button>
            </div>
            <a class="button button--gold" id="starterCvitaeCta" href="https://cvitae.volynx.world/" hidden><span class="i18n-en">Open CVitae</span><span class="i18n-pt">Abrir CVitae</span></a>
            <p class="world-form__status" id="starterBenefitStatus" aria-live="polite"></p>
          </section>

          <section class="world-form">
            <div class="world-form__head"><div><span><img src="/assets/contacticon.webp" alt="" loading="lazy" decoding="async" /></span><h3><span class="i18n-en">Private opportunities</span><span class="i18n-pt">Oportunidades privadas</span></h3></div></div>
            <p class="world-manager-note"><span class="i18n-en">Briefs sent to your published services appear here. Contact details stay private between both parties.</span><span class="i18n-pt">Briefings enviados para seus serviços publicados aparecem aqui. Os contatos permanecem privados entre as duas partes.</span></p>
            <div class="world-inquiries" id="receivedInquiries"></div>
          </section>
        </div>
      </div>
    </section>
  </main>

  <dialog class="world-dialog" id="inquiryDialog">
    <form method="dialog" class="world-dialog__close"><button aria-label="Close">×</button></form>
    <form id="inquiryForm">
      <span class="world-kicker"><span class="i18n-en">Project brief</span><span class="i18n-pt">Briefing do projeto</span></span>
      <h2 id="inquiryTitle"><span class="i18n-en">Request this service</span><span class="i18n-pt">Solicitar este serviço</span></h2>
      <p id="inquiryProvider"></p>
      <label><span><span class="i18n-en">Reply email</span><span class="i18n-pt">Email para resposta</span></span><input id="inquiryEmail" type="email" required /></label>
      <label><span><span class="i18n-en">What do you need?</span><span class="i18n-pt">O que você precisa?</span></span><input id="inquirySubject" maxlength="120" required /></label>
	      <label><span><span class="i18n-en">Project brief</span><span class="i18n-pt">Briefing do projeto</span></span><textarea id="inquiryBrief" minlength="40" maxlength="3000" rows="6" required></textarea></label>
      <div class="world-dialog__grid">
        <label><span><span class="i18n-en">Budget</span><span class="i18n-pt">Orçamento</span></span><input id="inquiryBudget" maxlength="80" placeholder="£1,000–£2,000" /></label>
	        <label><span><span class="i18n-en">Timeline</span><span class="i18n-pt">Prazo</span></span><input id="inquiryTimeline" maxlength="80" placeholder="Within 4 weeks" /></label>
      </div>
      <button class="button button--gold" type="submit"><span class="i18n-en">Send private brief</span><span class="i18n-pt">Enviar briefing privado</span></button>
      <p class="world-form__status" id="inquiryStatus" aria-live="polite"></p>
    </form>
  </dialog>

  <FlagshipFooter />
</FlagshipLayout>

<script>
  import { createClient } from "@supabase/supabase-js";

  const byId = (id: string) => document.getElementById(id) as HTMLElement | null;
  const value = (id: string) => ((byId(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value || "").trim();
  const splitList = (input: string) => input.split(",").map((item) => item.trim()).filter(Boolean).slice(0, 12);
  const escapeHtml = (input: unknown) => String(input ?? "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" }[char] || char));
  const isPt = () => document.documentElement.lang.toLowerCase().startsWith("pt");
  const text = (en: string, pt: string) => isPt() ? pt : en;

  let supabase: any;
  let cfg: any = null;
  let accessToken = "";
  let user: any = null;
  let services: any[] = [];
  let ownProfile: any = null;
  let ownServices: any[] = [];
  let receivedInquiries: any[] = [];
  let starterBenefit: any = null;
  let category = "";
  let selectedService: any = null;
  let editingServiceId = "";
  let marketplaceUnavailable = false;

  function setStatus(id: string, message: string, kind = "") {
    const el = byId(id);
    if (!el) return;
    el.textContent = message;
    el.dataset.kind = kind;
  }

  function formatPrice(service: any) {
    if (service.pricing_type === "quote" || !service.price_amount) return text("Request a quote", "Solicitar orçamento");
    const locale = isPt() ? "pt-BR" : "en-GB";
    const formatted = new Intl.NumberFormat(locale, { style: "currency", currency: service.currency }).format(service.price_amount / 100);
    if (service.pricing_type === "starting_at") return `${text("From", "A partir de")} ${formatted}`;
    if (service.pricing_type === "hourly") return `${formatted}/${text("hour", "hora")}`;
    return formatted;
  }

  function categoryIcon(categoryName: string) {
    const map: Record<string, string> = {
      "Web & Technology": "/assets/builder.webp",
      "Design & Brand": "/assets/producticon.webp",
      "Marketing & Growth": "/assets/scale.webp",
      "Business & Strategy": "/assets/summary.webp",
      "Content & Media": "/assets/iconography.webp",
      "Other": "/assets/V.webp",
    };
    return map[categoryName] || "/assets/V.webp";
  }

  function updateLocalizedControls() {
    const placeholders: Record<string, [string, string]> = {
      worldSearch: ["Branding, websites, automation...", "Marca, sites, automação..."],
      profileHandle: ["your_name", "seu_nome"],
      profileHeadline: ["Product designer for ambitious digital brands", "Designer de produtos para marcas digitais ambiciosas"],
      profileLocation: ["London, UK · Remote", "Lisboa, Portugal · Remoto"],
      profileSpecialties: ["Web design, Brand strategy, Astro", "Web design, Estratégia de marca, Astro"],
      profileLanguages: ["English, Português", "Português, English"],
      serviceTitle: ["Premium landing page design and build", "Design e construção de landing page premium"],
      servicePrice: ["500.00", "500,00"],
      inquiryBudget: ["£1,000–£2,000", "R$ 5.000–R$ 10.000"],
      inquiryTimeline: ["Within 4 weeks", "Em até 4 semanas"],
    };
    Object.entries(placeholders).forEach(([id, labels]) => {
      const input = byId(id) as HTMLInputElement | null;
      if (input) input.placeholder = text(labels[0], labels[1]);
    });
    const status = byId("serviceStatus") as HTMLSelectElement | null;
    if (status) {
      const labels: Record<string, [string, string]> = {
        published: ["Published", "Publicado"],
        draft: ["Draft", "Rascunho"],
        paused: ["Paused", "Pausado"],
      };
      Array.from(status.options).forEach((option) => {
        const label = labels[option.value];
        if (label) option.textContent = text(label[0], label[1]);
      });
    }
  }

  function updateServicePriceControl() {
    const pricing = byId("servicePricing") as HTMLSelectElement | null;
    const price = byId("servicePrice") as HTMLInputElement | null;
    if (!pricing || !price) return;
    const requiresPrice = pricing.value !== "quote";
    price.required = requiresPrice;
    price.disabled = !requiresPrice;
    if (!requiresPrice) price.value = "";
  }

  function renderMarketplace() {
    setStatus(
      "marketplaceStatus",
      marketplaceUnavailable
        ? ""
        : services.length
          ? `${services.length} ${text("founding services available", "serviços fundadores disponíveis")}`
          : text("Founding professionals can publish now.", "Profissionais fundadores já podem publicar."),
      "",
    );
    const query = value("worldSearch").toLowerCase();
    const filtered = services.filter((service) => {
      const profile = service.world_profiles || {};
      const haystack = [service.title, service.description, service.category, profile.display_name, profile.headline, ...(profile.specialties || [])].join(" ").toLowerCase();
      return (!category || service.category === category) && (!query || haystack.includes(query));
    });
    const grid = byId("worldGrid");
    if (!grid) return;
    if (!filtered.length) {
      grid.innerHTML = marketplaceUnavailable
        ? `<article class="world-empty"><strong>${text("Founding profiles are being prepared.", "Os perfis fundadores estão sendo preparados.")}</strong><p>${text("Volynx World is opening its first professional network. Sign in to prepare your presence.", "O Volynx World está abrindo sua primeira rede profissional. Entre para preparar sua presença.")}</p><a class="button button--gold" href="#join-world">${text("Prepare my World profile", "Preparar meu perfil World")}</a></article>`
        : `<article class="world-empty"><strong>${text("The founding marketplace is open.", "O marketplace fundador está aberto.")}</strong><p>${text("No service matches this search yet. Be one of the first professionals to publish.", "Nenhum serviço corresponde a esta busca ainda. Seja um dos primeiros profissionais a publicar.")}</p><a class="button button--gold" href="#join-world">${text("Join Volynx World", "Entrar no Volynx World")}</a></article>`;
      return;
    }
    grid.innerHTML = filtered.map((service, index) => {
      const profile = service.world_profiles || {};
      const initials = String(profile.display_name || "VW").split(/\s+/).slice(0, 2).map((part: string) => part[0]).join("").toUpperCase();
      const tags = (profile.specialties || []).slice(0, 3).map((tag: string) => `<span>${escapeHtml(tag)}</span>`).join("");
      const icon = categoryIcon(service.category || "Other");
      return `<article class="world-card">
        <div class="world-card__topline">
          <span class="world-card__icon"><img src="${escapeHtml(icon)}" alt="" loading="lazy" decoding="async"></span>
          <span class="world-card__category">${escapeHtml(service.category)}</span>
        </div>
        <div class="world-card__person">
          <div class="world-card__avatar">${profile.avatar_url ? `<img src="${escapeHtml(profile.avatar_url)}" alt="">` : escapeHtml(initials)}</div>
          <div><a href="/world/profile/?handle=${encodeURIComponent(profile.handle || "")}"><strong>${escapeHtml(profile.display_name)}</strong></a><span>${escapeHtml(profile.headline)}</span></div>
          ${profile.is_verified ? `<em>World Verified</em>` : ""}
        </div>
        <h3>${escapeHtml(service.title)}</h3>
        <p>${escapeHtml(service.description)}</p>
        <div class="world-card__tags">${tags}</div>
        <div class="world-card__meta">
          <span><em>${text("Investment", "Investimento")}</em><strong>${escapeHtml(formatPrice(service))}</strong></span>
          <span><em>${text("Delivery", "Entrega")}</em><strong>${service.delivery_days ? `${escapeHtml(service.delivery_days)} ${text("days", "dias")}` : text("By brief", "Por briefing")}</strong></span>
        </div>
        ${service.vx_discount_pct > 0 ? `<div class="world-card__vx">VX · ${text("Member benefit up to", "Benefício para membros de até")} ${escapeHtml(service.vx_discount_pct)}%</div>` : ""}
        <div class="world-card__signal"><span>${text("Private brief", "Briefing privado")}</span><span>${text("Founder layer", "Camada fundadora")}</span></div>
        <div class="world-card__actions"><a class="button button--ghost" href="/world/profile/?handle=${encodeURIComponent(profile.handle || "")}">${text("View profile", "Ver perfil")}</a><button class="button button--gold world-request" type="button" data-service-index="${index}">${text("Request", "Solicitar")}</button></div>
      </article>`;
    }).join("");
    grid.querySelectorAll<HTMLButtonElement>(".world-request").forEach((button) => button.addEventListener("click", () => openInquiry(filtered[Number(button.dataset.serviceIndex)])));
  }

  function renderOwnServices() {
    const target = byId("ownServices");
    if (!target) return;
    target.innerHTML = ownServices.length ? `<h4>${text("Your services", "Seus serviços")}</h4>` + ownServices.map((service) => `<div class="world-own-service"><span class="world-own-service__icon"><img src="${escapeHtml(categoryIcon(service.category || "Other"))}" alt="" loading="lazy" decoding="async"></span><span><strong>${escapeHtml(service.title)}</strong><small>${escapeHtml(service.status)} · ${escapeHtml(formatPrice(service))}</small></span><div><button type="button" data-edit-service="${escapeHtml(service.id)}">${text("Edit", "Editar")}</button><button type="button" data-toggle-service="${escapeHtml(service.id)}" data-next-status="${service.status === "published" ? "paused" : "published"}">${service.status === "published" ? text("Pause", "Pausar") : text("Publish", "Publicar")}</button><button type="button" data-delete-service="${escapeHtml(service.id)}">${text("Remove", "Remover")}</button></div></div>`).join("") : "";
    target.querySelectorAll<HTMLButtonElement>("[data-edit-service]").forEach((button) => button.addEventListener("click", () => startServiceEdit(button.dataset.editService || "")));
    target.querySelectorAll<HTMLButtonElement>("[data-toggle-service]").forEach((button) => button.addEventListener("click", async () => {
      const { error } = await supabase.from("world_services").update({ status: button.dataset.nextStatus }).eq("id", button.dataset.toggleService);
      if (error) return setStatus("serviceFormStatus", error.message, "error");
      await loadOwnWorld();
      await loadMarketplace();
    }));
    target.querySelectorAll<HTMLButtonElement>("[data-delete-service]").forEach((button) => button.addEventListener("click", async () => {
      if (!confirm(text("Remove this service?", "Remover este serviço?"))) return;
      const { error } = await supabase.from("world_services").delete().eq("id", button.dataset.deleteService);
      if (error) return setStatus("serviceFormStatus", error.message, "error");
      await loadOwnWorld();
      await loadMarketplace();
    }));
  }

  function resetServiceForm() {
    editingServiceId = "";
    (byId("worldServiceForm") as HTMLFormElement).reset();
    updateServicePriceControl();
    (byId("serviceSubmit") as HTMLButtonElement).textContent = text("Add service", "Adicionar serviço");
    (byId("serviceCancelEdit") as HTMLButtonElement).hidden = true;
  }

  function startServiceEdit(id: string) {
    const service = ownServices.find((item) => item.id === id);
    if (!service) return;
    editingServiceId = id;
    (byId("serviceTitle") as HTMLInputElement).value = service.title || "";
    (byId("serviceCategory") as HTMLSelectElement).value = service.category || "Other";
    (byId("servicePricing") as HTMLSelectElement).value = service.pricing_type || "quote";
    (byId("servicePrice") as HTMLInputElement).value = service.price_amount ? String(service.price_amount / 100) : "";
    (byId("serviceCurrency") as HTMLSelectElement).value = service.currency || "GBP";
    (byId("serviceDelivery") as HTMLInputElement).value = service.delivery_days || "";
    (byId("serviceVx") as HTMLSelectElement).value = String(service.vx_discount_pct || 0);
    (byId("serviceDescription") as HTMLTextAreaElement).value = service.description || "";
    (byId("serviceStatus") as HTMLSelectElement).value = service.status || "draft";
    updateServicePriceControl();
    (byId("serviceSubmit") as HTMLButtonElement).textContent = text("Save service", "Salvar serviço");
    (byId("serviceCancelEdit") as HTMLButtonElement).hidden = false;
    byId("worldServiceForm")?.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function renderInquiries() {
    const target = byId("receivedInquiries");
    if (!target) return;
    target.innerHTML = receivedInquiries.length ? receivedInquiries.map((inquiry) => `<article class="world-inquiry">
      <div><span>${escapeHtml(inquiry.status)}</span><time>${new Date(inquiry.created_at).toLocaleDateString(isPt() ? "pt-BR" : "en-GB")}</time></div>
      <h4>${escapeHtml(inquiry.subject)}</h4>
      <p>${escapeHtml(inquiry.brief)}</p>
      <dl><div><dt>${text("Budget", "Orçamento")}</dt><dd>${escapeHtml(inquiry.budget || text("Not specified", "Não informado"))}</dd></div><div><dt>Timeline</dt><dd>${escapeHtml(inquiry.timeline || text("Not specified", "Não informado"))}</dd></div></dl>
      <div class="world-inquiry__actions"><a class="button button--ghost" href="mailto:${encodeURIComponent(inquiry.reply_email)}?subject=${encodeURIComponent(`Volynx World · ${inquiry.subject}`)}">${text("Reply by email", "Responder por email")}</a><select data-inquiry-status="${escapeHtml(inquiry.id)}"><option value="new" ${inquiry.status === "new" ? "selected" : ""}>New</option><option value="reviewing" ${inquiry.status === "reviewing" ? "selected" : ""}>Reviewing</option><option value="accepted" ${inquiry.status === "accepted" ? "selected" : ""}>Accepted</option><option value="declined" ${inquiry.status === "declined" ? "selected" : ""}>Declined</option><option value="closed" ${inquiry.status === "closed" ? "selected" : ""}>Closed</option></select></div>
    </article>`).join("") : `<p class="world-manager-note">${text("No briefs received yet. Publish a clear service to start being discovered.", "Nenhum briefing recebido ainda. Publique um serviço claro para começar a ser encontrado.")}</p>`;
    target.querySelectorAll<HTMLSelectElement>("[data-inquiry-status]").forEach((select) => select.addEventListener("change", async () => {
      const { error } = await supabase.from("world_inquiries").update({ status: select.value }).eq("id", select.dataset.inquiryStatus);
      if (error) {
        setStatus("serviceFormStatus", error.message, "error");
        await loadOwnWorld();
      }
    }));
  }

  function renderStarterBenefit() {
    const target = byId("starterBenefit");
    const claim = byId("starterBenefitClaim");
    const cvitaeCta = byId("starterCvitaeCta") as HTMLAnchorElement | null;
    if (!target || !claim || !cvitaeCta) return;

    const hasPublishedProfile = !!ownProfile?.is_published;
    const hasPublishedService = ownServices.some((service) => service.status === "published");
    const hasClaimed = !!starterBenefit;
    const canClaim = hasPublishedProfile && hasPublishedService && !hasClaimed;
    const template = starterBenefit?.template_id ? String(starterBenefit.template_id) : "";

    target.innerHTML = `<div class="world-benefit__grid">
      <div class="${hasPublishedProfile ? "is-complete" : ""}"><span>${hasPublishedProfile ? "✓" : "1"}</span><strong>${text("Public World profile", "Perfil World público")}</strong><small>${text("Save your professional profile and keep it public.", "Salve seu perfil profissional e mantenha-o público.")}</small></div>
      <div class="${hasPublishedService ? "is-complete" : ""}"><span>${hasPublishedService ? "✓" : "2"}</span><strong>${text("Published service", "Serviço publicado")}</strong><small>${text("Offer at least one clear service in the marketplace.", "Ofereça pelo menos um serviço claro no marketplace.")}</small></div>
      <div class="${hasClaimed ? "is-complete" : ""}"><span>${hasClaimed ? "✓" : "3"}</span><strong>${text("CVitae + VX unlocked", "CVitae + VX liberados")}</strong><small>${hasClaimed ? text(`Template ${template} unlocked and 2 VX credited.`, `Template ${template} liberado e 2 VX creditados.`) : text("Choose a premium CVitae template and claim once.", "Escolha um template premium CVitae e resgate uma vez.")}</small></div>
    </div>`;

    claim.hidden = !canClaim;
    cvitaeCta.hidden = !hasClaimed;
    if (hasClaimed) {
      setStatus("starterBenefitStatus", text("Founder benefit already claimed. Open CVitae to use your premium template.", "Benefício fundador já resgatado. Abra o CVitae para usar seu template premium."), "success");
    } else if (!hasPublishedProfile || !hasPublishedService) {
      setStatus("starterBenefitStatus", text("Complete the two steps above to unlock this founder benefit.", "Complete os dois passos acima para liberar este benefício fundador."));
    } else {
      setStatus("starterBenefitStatus", text("Ready to claim.", "Pronto para resgatar."));
    }
  }

  async function loadMarketplace() {
    setStatus("marketplaceStatus", text("Loading founding professionals...", "Carregando profissionais fundadores..."));
    const { data, error } = await supabase.from("world_services").select("*, world_profiles!inner(*)").eq("status", "published").order("updated_at", { ascending: false });
    if (error) {
      services = [];
      marketplaceUnavailable = true;
    } else {
      services = data || [];
      marketplaceUnavailable = false;
    }
    renderMarketplace();
  }

  async function restoreSession() {
    accessToken = localStorage.getItem("volynx_access_token") || "";
    const refreshToken = localStorage.getItem("volynx_refresh_token") || "";
    if (!accessToken || !refreshToken) return;
    const { error } = await supabase.auth.setSession({ access_token: accessToken, refresh_token: refreshToken });
    if (error) return;
    const { data: sessionData } = await supabase.auth.getSession();
    accessToken = sessionData?.session?.access_token || accessToken;
    const { data } = await supabase.auth.getUser();
    user = data?.user || null;
  }

  async function loadOwnWorld() {
    if (!user) return;
    const [{ data: profile }, { data: own }, { data: inquiries }, benefitResult] = await Promise.all([
      supabase.from("world_profiles").select("*").eq("user_id", user.id).maybeSingle(),
      supabase.from("world_services").select("*").eq("provider_id", user.id).order("updated_at", { ascending: false }),
      supabase.from("world_inquiries").select("*").eq("provider_id", user.id).order("created_at", { ascending: false }),
      supabase.from("world_starter_benefits").select("*").eq("user_id", user.id).maybeSingle(),
    ]);
    ownProfile = profile || null;
    ownServices = own || [];
    receivedInquiries = inquiries || [];
    starterBenefit = benefitResult?.data || null;
    if (ownProfile) {
      (byId("profileDisplayName") as HTMLInputElement).value = ownProfile.display_name || "";
      (byId("profileHandle") as HTMLInputElement).value = ownProfile.handle || "";
      (byId("handlePreview") as HTMLElement).textContent = ownProfile.handle || "your_name";
      (byId("profileHeadline") as HTMLInputElement).value = ownProfile.headline || "";
      (byId("profileLocation") as HTMLInputElement).value = ownProfile.location || "";
      (byId("profileAvailability") as HTMLSelectElement).value = ownProfile.availability || "available";
      (byId("profileBio") as HTMLTextAreaElement).value = ownProfile.bio || "";
      (byId("profileSpecialties") as HTMLInputElement).value = (ownProfile.specialties || []).join(", ");
      (byId("profileLanguages") as HTMLInputElement).value = (ownProfile.languages || []).join(", ");
      (byId("profilePortfolio") as HTMLInputElement).value = ownProfile.portfolio_url || "";
      (byId("profilePublished") as HTMLInputElement).checked = !!ownProfile.is_published;
    }
    renderOwnServices();
    renderStarterBenefit();
    renderInquiries();
  }

  function openInquiry(service: any) {
    if (!user) {
      window.location.href = `/login/?next=${encodeURIComponent("/world/#marketplace")}`;
      return;
    }
    if (service.provider_id === user.id) {
      setStatus("marketplaceStatus", text("This is your own service.", "Este serviço é seu."));
      return;
    }
    selectedService = service;
    (byId("inquiryTitle") as HTMLElement).textContent = service.title;
    (byId("inquiryProvider") as HTMLElement).textContent = `${text("Private brief for", "Briefing privado para")} ${service.world_profiles?.display_name || "professional"}`;
    (byId("inquirySubject") as HTMLInputElement).value = service.title;
    (byId("inquiryEmail") as HTMLInputElement).value = user.email || localStorage.getItem("volynx_user_email") || "";
    setStatus("inquiryStatus", "");
    (byId("inquiryDialog") as HTMLDialogElement).showModal();
  }

  byId("worldSearch")?.addEventListener("input", renderMarketplace);
  window.addEventListener("vx:lang-changed", () => {
    updateLocalizedControls();
    renderMarketplace();
    if (user) {
      renderOwnServices();
      renderStarterBenefit();
      renderInquiries();
    }
  });
  byId("profileHandle")?.addEventListener("input", () => {
    const input = byId("profileHandle") as HTMLInputElement;
    input.value = input.value.toLowerCase().replace(/[^a-z0-9_-]/g, "").slice(0, 30);
    (byId("handlePreview") as HTMLElement).textContent = input.value || "your_name";
  });
  byId("serviceCancelEdit")?.addEventListener("click", resetServiceForm);
  byId("servicePricing")?.addEventListener("change", updateServicePriceControl);
  byId("claimStarterBenefit")?.addEventListener("click", async () => {
    if (!user || !accessToken) return setStatus("starterBenefitStatus", text("Sign in again to claim this benefit.", "Entre novamente para resgatar este benefício."), "error");
    if (!cfg?.functionsUrl) return setStatus("starterBenefitStatus", text("World benefits are not configured yet.", "Os benefícios World ainda não estão configurados."), "error");

    const button = byId("claimStarterBenefit") as HTMLButtonElement;
    button.disabled = true;
    setStatus("starterBenefitStatus", text("Claiming founder benefit...", "Resgatando benefício fundador..."));
    try {
      const response = await fetch(`${cfg.functionsUrl}/claim-world-starter-benefit`, {
        method: "POST",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ template_id: value("starterTemplate") }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.ok) {
        const messages: Record<string, string> = {
          world_profile_incomplete: text("Keep your World profile public before claiming.", "Mantenha seu perfil World público antes de resgatar."),
          world_service_missing: text("Publish at least one service before claiming.", "Publique pelo menos um serviço antes de resgatar."),
          invalid_template_id: text("Choose a valid CVitae template.", "Escolha um template CVitae válido."),
        };
        return setStatus("starterBenefitStatus", messages[String(result.error)] || (result.error || text("Benefit could not be claimed yet.", "O benefício ainda não pôde ser resgatado.")), "error");
      }
      setStatus("starterBenefitStatus", text("Benefit claimed: CVitae template unlocked and 2 VX credited.", "Benefício resgatado: template CVitae liberado e 2 VX creditados."), "success");
      await loadOwnWorld();
    } catch (error) {
      setStatus("starterBenefitStatus", (error as Error)?.message || text("Benefit could not be claimed yet.", "O benefício ainda não pôde ser resgatado."), "error");
    } finally {
      button.disabled = false;
    }
  });
  byId("worldFilters")?.querySelectorAll<HTMLButtonElement>("button").forEach((button) => button.addEventListener("click", () => {
    category = button.dataset.category || "";
    byId("worldFilters")?.querySelectorAll("button").forEach((item) => item.classList.toggle("is-active", item === button));
    renderMarketplace();
  }));

  byId("worldProfileForm")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!user) return;
    setStatus("profileFormStatus", text("Saving...", "Salvando..."));
    const payload = {
      user_id: user.id,
      handle: value("profileHandle").toLowerCase(),
      display_name: value("profileDisplayName"),
      headline: value("profileHeadline"),
      location: value("profileLocation") || null,
      availability: value("profileAvailability"),
      bio: value("profileBio"),
      specialties: splitList(value("profileSpecialties")),
      languages: splitList(value("profileLanguages")),
      portfolio_url: value("profilePortfolio") || null,
      is_published: (byId("profilePublished") as HTMLInputElement).checked,
    };
    const { error } = await supabase.from("world_profiles").upsert(payload, { onConflict: "user_id" });
    if (error) return setStatus("profileFormStatus", error.message, "error");
    setStatus("profileFormStatus", text("Professional profile saved.", "Perfil profissional salvo."), "success");
    await loadOwnWorld();
    await loadMarketplace();
  });

  byId("worldServiceForm")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!user) return;
    if (!ownProfile) return setStatus("serviceFormStatus", text("Save your professional profile first.", "Salve seu perfil profissional primeiro."), "error");
    const pricingType = value("servicePricing");
    const payload = {
      provider_id: user.id,
      title: value("serviceTitle"),
      description: value("serviceDescription"),
      category: value("serviceCategory"),
      pricing_type: pricingType,
      price_amount: pricingType === "quote" ? null : Math.round(Number(value("servicePrice")) * 100),
      currency: value("serviceCurrency"),
      delivery_days: value("serviceDelivery") ? Number(value("serviceDelivery")) : null,
      vx_discount_pct: Number(value("serviceVx") || 0),
      status: value("serviceStatus"),
    };
    setStatus("serviceFormStatus", editingServiceId ? text("Saving...", "Salvando...") : text("Publishing...", "Publicando..."));
    const { error } = editingServiceId
      ? await supabase.from("world_services").update(payload).eq("id", editingServiceId)
      : await supabase.from("world_services").insert(payload);
    if (error) return setStatus("serviceFormStatus", error.message, "error");
    resetServiceForm();
    setStatus("serviceFormStatus", text("Service saved on your World profile.", "Serviço salvo no seu perfil World."), "success");
    await loadOwnWorld();
    await loadMarketplace();
  });

  byId("inquiryForm")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!user || !selectedService) return;
    setStatus("inquiryStatus", text("Sending private brief...", "Enviando briefing privado..."));
    const { error } = await supabase.from("world_inquiries").insert({
      client_id: user.id,
      provider_id: selectedService.provider_id,
      service_id: selectedService.id,
      subject: value("inquirySubject"),
      brief: value("inquiryBrief"),
      reply_email: value("inquiryEmail"),
      budget: value("inquiryBudget") || null,
      timeline: value("inquiryTimeline") || null,
    });
    if (error) return setStatus("inquiryStatus", error.message, "error");
    setStatus("inquiryStatus", text("Brief sent. The professional can now review it privately.", "Briefing enviado. O profissional já pode analisá-lo em privado."), "success");
    (byId("inquiryForm") as HTMLFormElement).reset();
  });

  async function boot() {
    cfg = await fetch("/config.json", { cache: "no-store" }).then((response) => response.json());
    supabase = createClient(cfg.supabaseUrl, cfg.supabaseAnonKey);
    updateLocalizedControls();
    updateServicePriceControl();
    await restoreSession();
    await loadMarketplace();
    if (user) {
      byId("worldManager")!.hidden = false;
      byId("worldLoginCta")!.hidden = true;
      await loadOwnWorld();
    }
  }
  boot().catch((error) => setStatus("marketplaceStatus", error?.message || "World could not load.", "error"));
</script>

<style>
  .world-hero { padding: clamp(76px, 10vw, 150px) 0 70px; border-bottom: 1px solid rgba(255,255,255,.08); }
  .world-hero__grid { display:grid; gap:34px; align-items:end; }
  .world-kicker { display:block; color:#ffd76a; font-size:.72rem; font-weight:800; letter-spacing:.18em; text-transform:uppercase; margin-bottom:14px; }
  .world-hero h1 { max-width:850px; margin:0; font-size:clamp(2.8rem, 7vw, 6.8rem); line-height:.93; letter-spacing:-.065em; }
  .world-hero p,.world-section__head p { max-width:730px; color:rgba(255,255,255,.68); line-height:1.7; font-size:1rem; }
  .world-actions,.world-trust,.world-filter-row { display:flex; gap:12px; flex-wrap:wrap; }
  .world-actions { margin-top:28px; }
  .world-trust { margin-top:25px; color:rgba(255,255,255,.62); font-size:.78rem; text-transform:uppercase; letter-spacing:.08em; }
  .world-vision { padding:26px; border:1px solid rgba(255,215,106,.25); border-radius:24px; background:linear-gradient(145deg,rgba(255,215,106,.08),rgba(25,255,207,.04)); }
  .world-vision span { color:#ffd76a; font-size:.7rem; letter-spacing:.2em; }
