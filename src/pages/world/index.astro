  async function loadMarketplace() {
    setStatus("marketplaceStatus", text("Loading founding professionals...", "Carregando profissionais fundadores..."));
    const { data, error } = await supabase.from("world_services").select("*, world_profiles!inner(*)").eq("status", "published").order("updated_at", { ascending: false });
    if (error) {
      services = [];
      marketplaceUnavailable = true;
    } else {
      const providerIds = [...new Set((data || []).map((service: any) => service.provider_id).filter(Boolean))];
      let publicPlans = new Map<string, string>();
      if (providerIds.length) {
        const planResult = await supabase.rpc("world_public_membership", { p_user_ids: providerIds });
        if (!planResult.error) {
          publicPlans = new Map((planResult.data || []).map((row: any) => [String(row.user_id), normalizeWorldPlan(row.world_plan)]));
        }
      }
      services = (data || [])
        .map((service: any) => ({
          ...service,
          public_world_plan: publicPlans.get(String(service.provider_id)) || "free",
        }))
        .sort((a: any, b: any) => (
          worldPlanRank(b.public_world_plan) - worldPlanRank(a.public_world_plan)
          || Number(Boolean(b.world_profiles?.is_verified)) - Number(Boolean(a.world_profiles?.is_verified))
          || new Date(b.updated_at || 0).getTime() - new Date(a.updated_at || 0).getTime()
        ));
      marketplaceUnavailable = false;
    }
    renderMarketplace();
  }

  async function restoreSession() {
    const bridge = window as WorldBridgeWindow;
    bridge.VxAuthBridge?.hydrate?.();

    let stored = readStoredWorldSession();
    let nextAccessToken = localStorage.getItem("volynx_access_token") || stored.access_token || "";
    let nextRefreshToken = localStorage.getItem("volynx_refresh_token") || stored.refresh_token || "";

    if (!nextAccessToken && nextRefreshToken) {
      await refreshWorldSession(nextRefreshToken);
    } else if (nextAccessToken && bridge.vxEnsureFreshToken) {
      await bridge.vxEnsureFreshToken().catch(() => null);
    }

    stored = readStoredWorldSession();
    nextAccessToken = localStorage.getItem("volynx_access_token") || stored.access_token || "";
    nextRefreshToken = localStorage.getItem("volynx_refresh_token") || stored.refresh_token || "";

    if (!nextAccessToken || !nextRefreshToken) return;
    const { data, error } = await supabase.auth.setSession({ access_token: nextAccessToken, refresh_token: nextRefreshToken });
    if (error || !data?.session) return;

    persistWorldSession(data.session, nextRefreshToken);
    accessToken = data.session.access_token || nextAccessToken;
    user = data.user || data.session.user || null;
  }

