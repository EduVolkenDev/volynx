---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";
import { sitePricing } from "../../data/pricing";

const worldPlans = sitePricing.worldPlans;
const worldMemberPlan = worldPlans.find((plan) => plan.id === "world_member");
const worldProPlan = worldPlans.find((plan) => plan.id === "world_pro");
const worldMemberLocalizedPrice = worldMemberPlan
  ? `${worldMemberPlan.price.EUR}/${worldMemberPlan.price.BRL}`
  : "€16/R$89";
const worldProLocalizedPrice = worldProPlan
  ? `${worldProPlan.price.EUR}/${worldProPlan.price.BRL}`
  : "€39/R$219";
---

<FlagshipLayout
  title="Volynx World — Premium professionals for ambitious work"
  description="Discover clear professional services, publish your expertise, and connect directly inside Volynx World."
  pageClass="page-world"
>
  <FlagshipHeader current={ROUTES.world} ctaLabel="Join World" ctaHref="#join-world" ctaI18n="nav.world" />

  <main>
    <canvas class="world-webgl" data-world-scene aria-hidden="true"></canvas>
    <section class="world-hero world-reveal">
      <div class="shell world-hero__grid">
        <div class="world-hero__copy">
          <span class="world-kicker"><span class="i18n-en">Volynx World · Founding marketplace</span><span class="i18n-pt">Volynx World · Marketplace fundador</span></span>
          <h1>
            <span class="i18n-en">The right professional can change what is possible.</span>
            <span class="i18n-pt">O profissional certo pode mudar o que é possível.</span>
          </h1>
          <p>
            <span class="i18n-en">Find premium talent, clear services, and people ready to build. Volynx World is where ambitious work starts a direct conversation.</span>
            <span class="i18n-pt">Encontre talentos premium, serviços claros e pessoas prontas para construir. Volynx World é onde trabalhos ambiciosos começam uma conversa direta.</span>
          </p>
          <div class="world-actions">
            <a href="#marketplace" class="button button--gold"><span class="i18n-en">Find a professional</span><span class="i18n-pt">Encontrar profissional</span></a>
            <a href="#join-world" class="button button--ghost"><span class="i18n-en">Offer your services</span><span class="i18n-pt">Oferecer serviços</span></a>
          </div>
          <div class="world-trust">
            <span>✓ <span class="i18n-en">Clear service offers</span><span class="i18n-pt">Ofertas claras</span></span>
            <span>✓ <span class="i18n-en">Direct project briefs</span><span class="i18n-pt">Briefings diretos</span></span>
            <span>VX <span class="i18n-en">founder benefit active</span><span class="i18n-pt">benefício fundador ativo</span></span>
          </div>
        </div>
        <aside class="world-vision world-reveal" style="--reveal-delay: 180ms;">
          <div class="world-orbit" aria-hidden="true">
            <div class="world-orbit__core">
              <img src="/assets/world/world-network-icon.webp" alt="" loading="eager" decoding="async" />
            </div>
            <div class="world-orbit__node world-orbit__node--one"><img src="/assets/world/world-profile-icon.webp" alt="" loading="lazy" decoding="async" /></div>
            <div class="world-orbit__node world-orbit__node--two"><img src="/assets/world/world-service-icon.webp" alt="" loading="lazy" decoding="async" /></div>
            <div class="world-orbit__node world-orbit__node--three"><img src="/assets/world/world-brief-icon.webp" alt="" loading="lazy" decoding="async" /></div>
            <div class="world-orbit__node world-orbit__node--four"><img src="/assets/world/world-intelligence-icon.webp" alt="" loading="lazy" decoding="async" /></div>
          </div>
          <span id="world-vision-title"><span class="i18n-en">World intelligence</span><span class="i18n-pt">Inteligência World</span></span>
          <strong><span class="i18n-en">Professionals inside the platform, not outside the story.</span><span class="i18n-pt">Profissionais dentro da plataforma, não fora da história.</span></strong>
          <p><span class="i18n-en">World should feel like a premium network layer: discoverable profiles, clear services, private briefs, and platform-native benefits for serious work.</span><span class="i18n-pt">O World precisa parecer uma camada premium de rede: perfis encontráveis, serviços claros, briefings privados e benefícios nativos da plataforma para trabalho sério.</span></p>
          <div class="world-signal-grid">
            <span><b>01</b><em><span class="i18n-en">Public profile</span><span class="i18n-pt">Perfil público</span></em></span>
            <span><b>02</b><em><span class="i18n-en">Service offer</span><span class="i18n-pt">Oferta de serviço</span></em></span>
            <span><b>03</b><em><span class="i18n-en">Private brief</span><span class="i18n-pt">Briefing privado</span></em></span>
            <span><b>VX</b><em><span class="i18n-en">Member benefit</span><span class="i18n-pt">Benefício membro</span></em></span>
          </div>
        </aside>
      </div>
    </section>

    <section class="world-section world-section--steps world-reveal">
      <div class="shell">
        <div class="world-section__head">
          <div>
            <span class="world-kicker"><span class="i18n-en">How World works</span><span class="i18n-pt">Como o World funciona</span></span>
            <h2><span class="i18n-en">From clear need to direct conversation.</span><span class="i18n-pt">Da necessidade clara à conversa direta.</span></h2>
          </div>
        </div>
        <div class="world-steps">
          <article class="world-reveal" style="--reveal-delay: 80ms;"><span><img src="/assets/world/world-discovery-icon.webp" alt="" loading="lazy" decoding="async" /></span><strong><span class="i18n-en">Discover by delivery</span><span class="i18n-pt">Encontre pela entrega</span></strong><p><span class="i18n-en">Search professionals by the service, specialty, and outcome you need.</span><span class="i18n-pt">Busque profissionais pelo serviço, especialidade e resultado que você precisa.</span></p></article>
          <article class="world-reveal" style="--reveal-delay: 160ms;"><span><img src="/assets/world/world-brief-icon.webp" alt="" loading="lazy" decoding="async" /></span><strong><span class="i18n-en">Send a private brief</span><span class="i18n-pt">Envie um briefing privado</span></strong><p><span class="i18n-en">Share your goal, budget, and timeline directly with the professional.</span><span class="i18n-pt">Compartilhe objetivo, orçamento e prazo diretamente com o profissional.</span></p></article>
          <article class="world-reveal" style="--reveal-delay: 240ms;"><span><img src="/assets/world/world-strategy-icon.webp" alt="" loading="lazy" decoding="async" /></span><strong><span class="i18n-en">Agree and build</span><span class="i18n-pt">Combine e construa</span></strong><p><span class="i18n-en">Both parties define the agreement and delivery independently in this founding release.</span><span class="i18n-pt">As duas partes definem o acordo e a entrega de forma independente neste lançamento fundador.</span></p></article>
        </div>
      </div>
    </section>

    <section class="world-section world-section--showcase" aria-labelledby="world-showcase-title">
      <div class="shell">
        <div class="world-section__head world-reveal">
          <div>
            <span class="world-kicker"><span class="i18n-en">Built for serious work</span><span class="i18n-pt">Feito para trabalho sério</span></span>
            <h2 id="world-showcase-title"><span class="i18n-en">A professional layer that feels alive, not listed.</span><span class="i18n-pt">Uma camada profissional que parece viva, não apenas listada.</span></h2>
          </div>
          <p><span class="i18n-en">World uses large visual anchors, private context, and platform signals so every professional presence feels connected to the VOLYNX ecosystem.</span><span class="i18n-pt">O World usa âncoras visuais grandes, contexto privado e sinais da plataforma para que cada presença profissional pareça conectada ao ecossistema VOLYNX.</span></p>
        </div>
        <div class="world-showcase">
          <article class="world-showcase-card world-showcase-card--large world-reveal" style="--reveal-delay: 80ms;">
            <div class="world-showcase-card__media"><img src="/assets/world/world-profile-icon.webp" alt="" loading="lazy" decoding="async" /></div>
            <div>
              <span class="world-kicker"><span class="i18n-en">Professional brand</span><span class="i18n-pt">Marca profissional</span></span>
              <h3><span class="i18n-en">Presence becomes a signal, not a listing.</span><span class="i18n-pt">Presença vira sinal, não apenas listagem.</span></h3>
              <p><span class="i18n-en">Specialties, proof, language, availability and services appear as one recognizable professional layer.</span><span class="i18n-pt">Especialidades, prova, idioma, disponibilidade e serviços aparecem como uma camada profissional reconhecível.</span></p>
            </div>
          </article>
          <article class="world-showcase-card world-reveal" style="--reveal-delay: 160ms;">
            <div class="world-showcase-card__media"><img src="/assets/world/world-brief-icon.webp" alt="" loading="lazy" decoding="async" /></div>
            <div>
              <span class="world-kicker"><span class="i18n-en">Private context</span><span class="i18n-pt">Contexto privado</span></span>
              <h3><span class="i18n-en">Briefs stay intentional.</span><span class="i18n-pt">Briefings continuam intencionais.</span></h3>
              <p><span class="i18n-en">Requests carry goal, timeline, budget and reply path without turning World into a public inbox.</span><span class="i18n-pt">Solicitações levam objetivo, prazo, orçamento e canal de resposta sem transformar o World em uma caixa pública.</span></p>
            </div>
          </article>
          <article class="world-showcase-card world-reveal" style="--reveal-delay: 240ms;">
            <div class="world-showcase-card__media"><img src="/assets/world/world-intelligence-icon.webp" alt="" loading="lazy" decoding="async" /></div>
            <div>
              <span class="world-kicker"><span class="i18n-en">Intelligence</span><span class="i18n-pt">Inteligência</span></span>
              <h3><span class="i18n-en">Discovery follows delivery.</span><span class="i18n-pt">A descoberta segue a entrega.</span></h3>
              <p><span class="i18n-en">Categories, signals and VX benefits make the marketplace easier to understand and easier to trust.</span><span class="i18n-pt">Categorias, sinais e benefícios VX tornam o marketplace mais fácil de entender e confiar.</span></p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="world-section world-section--intelligence world-reveal" aria-labelledby="world-intelligence-title">
      <div class="shell">
        <div class="world-section__head">
          <div>
            <span class="world-kicker"><span class="i18n-en">Premium network layer</span><span class="i18n-pt">Camada premium de rede</span></span>
            <h2 id="world-intelligence-title"><span class="i18n-en">A smarter surface for professionals inside VOLYNX.</span><span class="i18n-pt">Uma superfície mais inteligente para profissionais dentro da VOLYNX.</span></h2>
          </div>
        </div>
        <div class="world-intelligence">
          <article class="world-reveal" style="--reveal-delay: 80ms;"><img src="/assets/world/world-portfolio-icon.webp" alt="" loading="lazy" decoding="async" /><span><span class="i18n-en">Proof</span><span class="i18n-pt">Prova</span></span><strong><span class="i18n-en">Profiles can point to real work, not generic promises.</span><span class="i18n-pt">Perfis podem apontar para trabalho real, não promessas genéricas.</span></strong></article>
          <article class="world-reveal" style="--reveal-delay: 160ms;"><img src="/assets/world/world-service-icon.webp" alt="" loading="lazy" decoding="async" /><span><span class="i18n-en">Offer clarity</span><span class="i18n-pt">Clareza de oferta</span></span><strong><span class="i18n-en">Services packaged by category, price model, delivery and VX benefit.</span><span class="i18n-pt">Serviços empacotados por categoria, preço, entrega e benefício VX.</span></strong></article>
          <article class="world-reveal" style="--reveal-delay: 240ms;"><img src="/assets/world/world-intelligence-icon.webp" alt="" loading="lazy" decoding="async" /><span><span class="i18n-en">Platform memory</span><span class="i18n-pt">Memória da plataforma</span></span><strong><span class="i18n-en">Private briefs and opportunities stay attached to the professional command layer.</span><span class="i18n-pt">Briefings privados e oportunidades ficam ligados ao comando profissional.</span></strong></article>
        </div>
      </div>
    </section>

    <section class="world-section world-reveal" id="marketplace">
      <div class="shell">
        <div class="world-section__head">
          <div>
            <span class="world-kicker"><span class="i18n-en">World marketplace</span><span class="i18n-pt">Marketplace World</span></span>
            <h2><span class="i18n-en">Discover people by what they can deliver.</span><span class="i18n-pt">Encontre pessoas pelo que elas conseguem entregar.</span></h2>
          </div>
          <label class="world-search">
            <span class="i18n-en">Search services or specialties</span><span class="i18n-pt">Buscar serviços ou especialidades</span>
            <input id="worldSearch" type="search" placeholder="Branding, websites, automation..." />
          </label>
        </div>
        <div class="world-filter-row" id="worldFilters">
          <button class="is-active" type="button" data-category=""><span class="i18n-en">All</span><span class="i18n-pt">Todos</span></button>
          <button type="button" data-category="Web & Technology"><span class="i18n-en">Web & Technology</span><span class="i18n-pt">Web e Tecnologia</span></button>
          <button type="button" data-category="Design & Brand"><span class="i18n-en">Design & Brand</span><span class="i18n-pt">Design e Marca</span></button>
          <button type="button" data-category="Marketing & Growth"><span class="i18n-en">Marketing & Growth</span><span class="i18n-pt">Marketing e Crescimento</span></button>
          <button type="button" data-category="Business & Strategy"><span class="i18n-en">Business & Strategy</span><span class="i18n-pt">Negócios e Estratégia</span></button>
          <button type="button" data-category="Content & Media"><span class="i18n-en">Content & Media</span><span class="i18n-pt">Conteúdo e Mídia</span></button>
        </div>
        <p class="world-status" id="marketplaceStatus"><span class="i18n-en">Loading founding professionals...</span><span class="i18n-pt">Carregando profissionais fundadores...</span></p>
        <div class="world-grid" id="worldGrid"></div>
        <p class="world-independent"><span class="i18n-en">Founding release: professionals operate independently and remain responsible for their offers, agreements, delivery, taxes, and legal obligations. Volynx World provides discovery and private introductions; protected payments and verified reviews are not active yet.</span><span class="i18n-pt">Lançamento fundador: profissionais atuam de forma independente e continuam responsáveis por suas ofertas, acordos, entregas, impostos e obrigações legais. Volynx World oferece descoberta e apresentações privadas; pagamentos protegidos e avaliações verificadas ainda não estão ativos.</span></p>
      </div>
    </section>

    <section class="world-section world-section--pricing world-reveal" id="world-pricing" aria-labelledby="world-pricing-title">
      <div class="shell">
        <div class="world-section__head world-reveal">
          <div>
            <span class="world-kicker"><span class="i18n-en">World plans</span><span class="i18n-pt">Planos World</span></span>
            <h2 id="world-pricing-title">
              <span class="i18n-en">Start free. Scale when you're ready.</span>
              <span class="i18n-pt">Comece grátis. Escale quando estiver pronto.</span>
            </h2>
          </div>
          <p>
            <span class="i18n-en">Every professional on Volynx World gets a free public presence. Upgrade for unlimited services, visible tier badges, stronger marketplace placement, and email brief notifications.</span>
            <span class="i18n-pt">Todo profissional no Volynx World tem uma presença pública gratuita. Faça upgrade para serviços ilimitados, badges visíveis de plano, posicionamento melhor no marketplace e notificações de briefings por email.</span>
          </p>
        </div>
        <div class="world-plans">
          {worldPlans.map((plan, index) => (
            <article
              class:list={["world-plan", plan.featured && "world-plan--featured", "world-reveal"]}
              style={`--reveal-delay: ${80 + index * 80}ms;`}
            >
              {plan.badge && (
                <div class="world-plan__badge">
                  <span class="i18n-en">{plan.badge.en}</span>
                  <span class="i18n-pt">{plan.badge.pt}</span>
                </div>
              )}
              <div class="world-plan__header">
                <h3>
                  <span class="i18n-en">{plan.name.en}</span>
                  <span class="i18n-pt">{plan.name.pt}</span>
                </h3>
                <div class="world-plan__price">
                  <strong>{plan.price.GBP}</strong>
                  <span class="world-plan__billing">
                    <span class="i18n-en">{plan.billing.en}</span>
                    <span class="i18n-pt">{plan.billing.pt}</span>
                  </span>
                </div>
                <p class="world-plan__summary">
                  <span class="i18n-en">{plan.description.en}</span>
                  <span class="i18n-pt">{plan.description.pt}</span>
                </p>
              </div>
              <ul class="world-plan__features">
                {plan.features.en.map((featureEn, featureIndex) => (
                  <li>
                    <span class="i18n-en">{featureEn}</span>
                    <span class="i18n-pt">{plan.features.pt[featureIndex]}</span>
                  </li>
                ))}
              </ul>
              {plan.href ? (
                <a href={plan.href} class="button button--ghost world-plan__btn">
                  <span class="i18n-en">{plan.cta.en}</span>
                  <span class="i18n-pt">{plan.cta.pt}</span>
                </a>
              ) : (
                <button
                  class:list={[
                    "world-plan__btn",
                    "world-checkout-btn",
                    "button",
                    plan.featured ? "button--gold" : "button--ghost",
                  ]}
                  data-plan={plan.id}
                >
                  <span class="i18n-en">{plan.cta.en}</span>
                  <span class="i18n-pt">{plan.cta.pt}</span>
                </button>
              )}
            </article>
          ))}
        </div>
        <p class="world-pricing-note">
          <span class="i18n-en">
            Prices shown in GBP · EUR and BRL at checkout ({worldMemberLocalizedPrice} Member · {worldProLocalizedPrice} Pro)
          </span>
          <span class="i18n-pt">
            Valores em GBP · EUR e BRL disponíveis no checkout ({worldMemberLocalizedPrice} Member · {worldProLocalizedPrice} Pro)
          </span>
        </p>
      </div>
    </section>

    <section class="world-section world-section--panel world-reveal" id="join-world">
      <div class="shell">
        <div class="world-section__head">
          <div>
            <span class="world-kicker"><span class="i18n-en">Professional command</span><span class="i18n-pt">Comando profissional</span></span>
            <h2><span class="i18n-en">Build your public World presence.</span><span class="i18n-pt">Construa sua presença pública no World.</span></h2>
            <p><span class="i18n-en">Publish a focused profile and services people can understand and request.</span><span class="i18n-pt">Publique um perfil focado e serviços que as pessoas consigam entender e solicitar.</span></p>
          </div>
          <a id="worldLoginCta" href="/login/?next=/world/%23join-world" class="button button--gold"><span class="i18n-en">Sign in to join</span><span class="i18n-pt">Entrar para participar</span></a>
        </div>

        <div class="world-manager" id="worldManager" hidden>
          <section class="world-form world-plan-summary">
            <div class="world-form__head">
              <div><span><img src="/assets/world/world-network-icon.webp" alt="" loading="lazy" decoding="async" /></span><h3><span class="i18n-en">World plan control</span><span class="i18n-pt">Controle do plano World</span></h3></div>
            </div>
            <p class="world-manager-note" id="worldPlanDescription"></p>
            <div class="world-plan-summary__grid">
              <div><small><span class="i18n-en">Current plan</span><span class="i18n-pt">Plano atual</span></small><strong id="worldPlanName"></strong></div>
              <div><small><span class="i18n-en">Publishing</span><span class="i18n-pt">Publicação</span></small><strong id="worldPlanPublishing"></strong></div>
              <div><small><span class="i18n-en">Marketplace</span><span class="i18n-pt">Marketplace</span></small><strong id="worldPlanDiscovery"></strong></div>
              <div><small><span class="i18n-en">Briefs</span><span class="i18n-pt">Briefings</span></small><strong id="worldPlanBriefs"></strong></div>
            </div>
            <div class="world-form__actions">
              <a class="button button--ghost" href="#world-pricing"><span class="i18n-en">Compare plans</span><span class="i18n-pt">Comparar planos</span></a>
              <button class="button button--gold" id="manageWorldBilling" type="button"><span class="i18n-en">Manage plan</span><span class="i18n-pt">Gerir plano</span></button>
            </div>
            <p class="world-form__status" id="worldPlanStatus" aria-live="polite"></p>
          </section>

          <form class="world-form" id="worldProfileForm">
            <div class="world-form__head">
              <div><span><img src="/assets/world/world-profile-icon.webp" alt="" loading="lazy" decoding="async" /></span><h3><span class="i18n-en">Professional profile</span><span class="i18n-pt">Perfil profissional</span></h3></div>
              <label class="world-toggle"><input id="profilePublished" type="checkbox" /><span><span class="i18n-en">Public</span><span class="i18n-pt">Público</span></span></label>
            </div>
            <div class="world-fields">
              <label><span><span class="i18n-en">Display name</span><span class="i18n-pt">Nome público</span></span><input id="profileDisplayName" maxlength="80" required /></label>
              <label><span><span class="i18n-en">World address</span><span class="i18n-pt">Endereço no World</span></span><input id="profileHandle" maxlength="30" pattern="[a-z0-9][a-z0-9_-]{2,29}" placeholder="your_name" required /><small class="world-field-hint">volynx.world/world/profile/?handle=<b id="handlePreview">your_name</b></small></label>
              <label><span><span class="i18n-en">Professional headline</span><span class="i18n-pt">Título profissional</span></span><input id="profileHeadline" maxlength="120" placeholder="Product designer for ambitious digital brands" required /></label>
              <label><span><span class="i18n-en">Location</span><span class="i18n-pt">Localização</span></span><input id="profileLocation" maxlength="100" placeholder="London, UK · Remote" /></label>
              <label><span><span class="i18n-en">Availability</span><span class="i18n-pt">Disponibilidade</span></span><select id="profileAvailability"><option value="available">Available</option><option value="limited">Limited</option><option value="unavailable">Unavailable</option></select></label>
              <label class="world-field--full"><span><span class="i18n-en">Professional bio</span><span class="i18n-pt">Apresentação profissional</span></span><textarea id="profileBio" minlength="40" maxlength="1200" rows="4" required></textarea></label>
              <label><span><span class="i18n-en">Specialties, separated by commas</span><span class="i18n-pt">Especialidades, separadas por vírgulas</span></span><input id="profileSpecialties" placeholder="Web design, Brand strategy, Astro" /></label>
              <label><span><span class="i18n-en">Languages, separated by commas</span><span class="i18n-pt">Idiomas, separados por vírgulas</span></span><input id="profileLanguages" placeholder="English, Português" /></label>
              <label class="world-field--full"><span><span class="i18n-en">Portfolio link</span><span class="i18n-pt">Link do portfólio</span></span><input id="profilePortfolio" type="url" placeholder="https://..." /></label>
            </div>
            <button class="button button--gold" type="submit"><span class="i18n-en">Save professional profile</span><span class="i18n-pt">Salvar perfil profissional</span></button>
            <p class="world-form__status" id="profileFormStatus" aria-live="polite"></p>
          </form>

          <form class="world-form" id="worldServiceForm">
            <div class="world-form__head"><div><span><img src="/assets/world/world-service-icon.webp" alt="" loading="lazy" decoding="async" /></span><h3><span class="i18n-en">Publish a service</span><span class="i18n-pt">Publicar um serviço</span></h3></div></div>
            <div class="world-fields">
              <label class="world-field--full"><span><span class="i18n-en">Service title</span><span class="i18n-pt">Título do serviço</span></span><input id="serviceTitle" maxlength="100" placeholder="Premium landing page design and build" required /></label>
