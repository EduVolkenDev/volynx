---
import "../../../styles/icons-store.css";
import PageWidgets from "../../../components/PageWidgets.astro";
const pageTitle = "Volynx Icons Store - Premium SVG Icons & Design Assets";
const pageDescription = "Premium SVG icons and design assets for developers. Build faster, design better.";
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content="/assets/volynx-icon.webp" />
  <meta property="og:url" content="https://volynx.world/products/volynx-icons-store/" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/assets/site.webmanifest" />
</head>

<body class="fx-grid">
  <nav class="nav-header">
    <div class="nav-container">
      <!-- Logo -->
      <div class="brand">
        <div class="brand-icon">
          <img src="/assets/volynx-icon.webp" alt="Volynx Icon" aria-hidden="true" />
        </div>
        <div class="brand-name">
          <img src="/assets/wordmark.webp" alt="Volynx Wordmark" aria-hidden="true" />
        </div>
      </div>

      <!-- Desktop Navigation -->
      <div class="nav-links desktop-nav">
        <a href="/products/volynx-icons-store/" class="nav-link active">Gallery</a>
        <a href="#" class="nav-link" id="collectionsBtn">Collections</a>
        <a href="#" class="nav-link" id="favoritesBtn">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
          Favorites
        </a>
        <a href="#" class="btn-upgrade" id="upgradeBtn">Upgrade</a>
      </div>

      <!-- Auth Buttons -->
      <div class="nav-actions">
        <button class="btn btn-primary" id="signInBtn">Sign In</button>

        <!-- User Menu (hidden by default) -->
        <div class="user-menu" id="userMenu" style="display: none;">
          <button class="user-btn" id="userMenuBtn">
            <svg class="user-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <span id="userName">User</span>
          </button>

          <div class="dropdown-menu" id="dropdownMenu">
            <div class="dropdown-item user-info">
              <div class="user-details">
                <span class="user-name-full" id="userNameFull">John Doe</span>
                <span class="user-email" id="userEmail">john@example.com</span>
              </div>
            </div>
            <div class="dropdown-divider"></div>
            <a href="#" class="dropdown-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
              </svg>
              My Favorites
            </a>
            <a href="#" class="dropdown-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                <line x1="3" y1="6" x2="21" y2="6" />
                <path d="M16 10a4 4 0 0 1-8 0" />
              </svg>
              Upgrade Plan
            </a>
            <div class="dropdown-divider"></div>
            <button class="dropdown-item logout-btn" id="logoutBtn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
              </svg>
              Logout
            </button>
          </div>
        </div>

        <!-- Mobile Menu Button -->
        <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle menu">
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
      <a href="/products/volynx-icons-store/" class="mobile-menu-item active">Gallery</a>
      <a href="#" class="mobile-menu-item" id="mobileCollectionsBtn">Collections</a>
      <a href="#" class="mobile-menu-item" id="mobileFavoritesBtn">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
        </svg>
        Favorites
      </a>
      <a href="#" class="mobile-menu-item upgrade" id="mobileUpgradeBtn">Upgrade to Pro</a>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="main-content">
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <h1 class="hero-title">
          Premium Design Assets
          <span class="gradient-text">For Modern Developers</span>
        </h1>
        <p class="hero-description">
          Thousands of premium SVG icons, UI kits, and design assets.
          Download instantly and build beautiful products faster.
        </p>
        <div class="hero-actions">
          <a href="#gallery" class="btn btn-primary btn-lg">Browse Gallery</a>
          <a href="#" class="btn btn-secondary btn-lg" id="pricingBtn">View Pricing</a>
        </div>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-number">3K+</span>
            <span class="stat-label">Icons</span>
          </div>
          <div class="stat">
            <span class="stat-number">100+</span>
            <span class="stat-label">Collections</span>
          </div>
          <div class="stat">
            <span class="stat-number">10K+</span>
            <span class="stat-label">Downloads</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Gallery Section -->
    <section class="gallery-section" id="gallery">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Featured Icons</h2>
          <div class="filters">
            <button class="filter-btn active" data-filter="all">All</button>
            <button class="filter-btn" data-filter="ui">UI/UX</button>
            <button class="filter-btn" data-filter="social">Social</button>
            <button class="filter-btn" data-filter="business">Business</button>
            <button class="filter-btn" data-filter="arrows">Arrows</button>
          </div>
        </div>

        <div class="gallery-grid" id="galleryGrid">
          <!-- Icons generated by JS -->
        </div>

        <div class="load-more-container">
          <button class="btn btn-secondary" id="loadMoreBtn">Load More</button>
        </div>
      </div>
    </section>

    <!-- Collections Preview -->
    <section class="collections-preview">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Popular Collections</h2>
          <a href="#" class="view-all" id="viewAllBtn">
            View All
            <svg viewBox="0 0 20 20" fill="currentColor">
              <path d="M7 3l7 7-7 7" />
            </svg>
          </a>
        </div>

        <div class="collections-grid">
          <a href="#" class="collection-card" id="uiEssentialsCard">
            <div class="collection-preview">
              <div class="preview-icon">🎨</div>
              <div class="preview-icon">🖌️</div>
              <div class="preview-icon">✨</div>
              <div class="preview-icon">🎭</div>
            </div>
            <h3 class="collection-title">UI Essentials</h3>
            <p class="collection-count">240 icons</p>
          </a>

          <a href="#" class="collection-card" id="techDevicesCard">
            <div class="collection-preview">
              <div class="preview-icon">📱</div>
              <div class="preview-icon">💻</div>
              <div class="preview-icon">⌨️</div>
              <div class="preview-icon">🖥️</div>
            </div>
            <h3 class="collection-title">Tech &amp; Devices</h3>
            <p class="collection-count">180 icons</p>
          </a>

          <a href="#" class="collection-card" id="communicationCard">
            <div class="collection-preview">
              <div class="preview-icon">🌐</div>
              <div class="preview-icon">📧</div>
              <div class="preview-icon">💬</div>
              <div class="preview-icon">📢</div>
            </div>
            <h3 class="collection-title">Communication</h3>
            <p class="collection-count">150 icons</p>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-box">
          <h2 class="cta-title">Ready to upgrade?</h2>
          <p class="cta-description">
            Get unlimited downloads, premium collections, and commercial license.
          </p>
          <a href="#" class="btn btn-primary btn-lg" id="ctaPricingBtn">View Pricing Plans</a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <div class="footer-brand">
            <div class="brand-icon-footer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 2 7 12 12 22 7 12 2" />
                <polyline points="2 17 12 22 22 17" />
                <polyline points="2 12 12 17 22 12" />
              </svg>
            </div>
            <span class="brand-name-footer">Volynx Icons Store</span>
          </div>
          <p class="footer-description">
            Premium SVG icons and design assets for developers. Build faster, design better.
          </p>
        </div>

        <div class="footer-col">
          <h4 class="footer-title">Product</h4>
          <ul class="footer-links">
            <li><a href="/products/volynx-icons-store/">Gallery</a></li>
            <li><a href="#">Collections</a></li>
            <li><a href="#">Pricing</a></li>
            <li><a href="#">Documentation</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-title">Support</h4>
          <ul class="footer-links">
            <li><a href="#">Help Center</a></li>
            <li><a href="#">API Reference</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="#">License</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-title">Company</h4>
          <ul class="footer-links">
            <li><a href="/about/">About</a></li>
            <li><a href="#">Blog</a></li>
            <li><a href="#">Careers</a></li>
            <li><a href="#">Press Kit</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p class="footer-copyright">© <span id="y"></span> Volynx Icons Store. All rights reserved.</p>
        <div class="footer-legal">
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="/disclaimer/">License</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    // ===== STATE =====
    let isLoggedIn = false;
    let currentUser: { name: string; email: string } | null = null;
    let currentFilter = "all";

    const iconsData = [
      { id: 1,  name: "Home",      icon: "🏠", category: "ui" },
      { id: 2,  name: "Search",    icon: "🔍", category: "ui" },
      { id: 3,  name: "Settings",  icon: "⚙️", category: "ui" },
      { id: 4,  name: "User",      icon: "👤", category: "ui" },
      { id: 5,  name: "Heart",     icon: "❤️", category: "social" },
      { id: 6,  name: "Star",      icon: "⭐", category: "ui" },
      { id: 7,  name: "Message",   icon: "💬", category: "social" },
      { id: 8,  name: "Phone",     icon: "📱", category: "social" },
      { id: 9,  name: "Mail",      icon: "✉️", category: "social" },
      { id: 10, name: "Calendar",  icon: "📅", category: "business" },
      { id: 11, name: "Clock",     icon: "⏰", category: "business" },
      { id: 12, name: "Camera",    icon: "📷", category: "ui" },
      { id: 13, name: "Image",     icon: "🖼️", category: "ui" },
      { id: 14, name: "Video",     icon: "🎥", category: "ui" },
      { id: 15, name: "Music",     icon: "🎵", category: "ui" },
      { id: 16, name: "Folder",    icon: "📁", category: "business" },
      { id: 17, name: "File",      icon: "📄", category: "business" },
      { id: 18, name: "Chart",     icon: "📊", category: "business" },
      { id: 19, name: "Arrow Up",  icon: "⬆️", category: "arrows" },
      { id: 20, name: "Arrow Down",icon: "⬇️", category: "arrows" },
      { id: 21, name: "Arrow Left",icon: "⬅️", category: "arrows" },
      { id: 22, name: "Arrow Right",icon: "➡️", category: "arrows" },
      { id: 23, name: "Plus",      icon: "➕", category: "ui" },
      { id: 24, name: "Minus",     icon: "➖", category: "ui" },
    ];

    // ===== INIT =====
    document.addEventListener("DOMContentLoaded", () => {
      initNavigation();
      initGallery();
      initFilters();
      checkAuth();
      initComingSoonLinks();

      const y = document.getElementById("y");
      if (y) y.textContent = String(new Date().getFullYear());
    });

    // ===== COMING SOON LINKS =====
    function initComingSoonLinks() {
      const comingSoon = [
        "collectionsBtn", "favoritesBtn", "upgradeBtn", "pricingBtn",
        "viewAllBtn", "uiEssentialsCard", "techDevicesCard", "communicationCard",
        "ctaPricingBtn", "mobileCollectionsBtn", "mobileFavoritesBtn", "mobileUpgradeBtn"
      ];
      comingSoon.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener("click", (e) => { e.preventDefault(); alert("Coming soon!"); });
      });
    }

    // ===== NAVIGATION =====
    function initNavigation() {
      const mobileMenuBtn = document.getElementById("mobileMenuBtn");
      const mobileMenu = document.getElementById("mobileMenu");
      const userMenuBtn = document.getElementById("userMenuBtn");
      const dropdownMenu = document.getElementById("dropdownMenu");

      if (mobileMenuBtn && mobileMenu) {
        mobileMenuBtn.addEventListener("click", () => {
          mobileMenuBtn.classList.toggle("active");
          mobileMenu.classList.toggle("show");
        });
      }

      if (userMenuBtn && dropdownMenu) {
        userMenuBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          dropdownMenu.classList.toggle("show");
        });
        document.addEventListener("click", (e) => {
          if (!userMenuBtn.contains(e.target as Node) && !dropdownMenu.contains(e.target as Node)) {
            dropdownMenu.classList.remove("show");
          }
        });
      }

      const signInBtn = document.getElementById("signInBtn");
      if (signInBtn) signInBtn.addEventListener("click", simulateLogin);

      const logoutBtn = document.getElementById("logoutBtn");
      if (logoutBtn) logoutBtn.addEventListener("click", logout);
    }

    // ===== AUTH =====
    function checkAuth() {
      try {
        const savedUser = localStorage.getItem("designmarket_user");
        if (savedUser) {
          currentUser = JSON.parse(savedUser);
          isLoggedIn = true;
          updateAuthUI();
        }
      } catch (e) { /* localStorage unavailable */ }
    }

    function simulateLogin() {
      try {
        currentUser = { name: "John Doe", email: "john@example.com" };
        isLoggedIn = true;
        localStorage.setItem("designmarket_user", JSON.stringify(currentUser));
        updateAuthUI();
      } catch (e) {
        isLoggedIn = true;
        updateAuthUI();
      }
    }

    function logout() {
      currentUser = null;
      isLoggedIn = false;
      localStorage.removeItem("designmarket_user");
      updateAuthUI();
      document.getElementById("dropdownMenu")?.classList.remove("show");
    }

    function updateAuthUI() {
      const signInBtn = document.getElementById("signInBtn");
      const userMenu = document.getElementById("userMenu");
      const userName = document.getElementById("userName");
      const userNameFull = document.getElementById("userNameFull");
      const userEmail = document.getElementById("userEmail");

      if (isLoggedIn && currentUser) {
        if (signInBtn) signInBtn.style.display = "none";
        if (userMenu) userMenu.style.display = "block";
        const displayName = currentUser.name.split(" ")[0];
        if (userName) userName.textContent = displayName;
        if (userNameFull) userNameFull.textContent = currentUser.name;
        if (userEmail) userEmail.textContent = currentUser.email;
      } else {
        if (signInBtn) signInBtn.style.display = "inline-flex";
        if (userMenu) userMenu.style.display = "none";
      }
    }

    // ===== GALLERY =====
    function initGallery() {
      renderIcons(iconsData.slice(0, 12));
      const loadMoreBtn = document.getElementById("loadMoreBtn");
      if (loadMoreBtn) loadMoreBtn.addEventListener("click", loadMoreIcons);
    }

    function renderIcons(icons: typeof iconsData) {
      const galleryGrid = document.getElementById("galleryGrid");
      if (!galleryGrid) return;
      icons.forEach(icon => galleryGrid.appendChild(createIconCard(icon)));
    }

    function createIconCard(icon: { id: number; name: string; icon: string; category: string }) {
      const card = document.createElement("div");
      card.className = "icon-card";
      card.dataset.category = icon.category;
      card.innerHTML = `<div class="icon-display">${icon.icon}</div><div class="icon-name">${icon.name}</div>`;
      card.addEventListener("click", () => downloadIcon(icon));
      return card;
    }

    function downloadIcon(icon: { name: string; icon: string }) {
      try {
        const svgContent = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100"><text x="50" y="50" font-size="50" text-anchor="middle" dominant-baseline="middle">${icon.icon}</text></svg>`;
        const blob = new Blob([svgContent], { type: "image/svg+xml" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `${icon.name.toLowerCase().replace(/\s+/g, "-")}.svg`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        showNotification(`Downloaded: ${icon.name}`);
      } catch (e) {
        showNotification("Download failed. Please try again.");
      }
    }

    function loadMoreIcons() {
      const galleryGrid = document.getElementById("galleryGrid");
      if (!galleryGrid) return;
      const currentCount = galleryGrid.children.length;
      const remaining = iconsData.slice(currentCount, currentCount + 12);
      if (remaining.length > 0) renderIcons(remaining);
      if (currentCount + remaining.length >= iconsData.length) {
        const btn = document.getElementById("loadMoreBtn");
        if (btn) btn.style.display = "none";
      }
    }

    // ===== FILTERS =====
    function initFilters() {
      const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
      filterBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          filterBtns.forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          currentFilter = btn.dataset.filter ?? "all";
          applyFilter(currentFilter);
        });
      });
    }

    function applyFilter(filter: string) {
      document.querySelectorAll<HTMLElement>(".icon-card").forEach(card => {
        card.style.display = (filter === "all" || card.dataset.category === filter) ? "flex" : "none";
      });
    }

    // ===== NOTIFICATIONS =====
    function showNotification(message: string) {
      const n = document.createElement("div");
      n.className = "notification";
      n.textContent = message;
      document.body.appendChild(n);
      setTimeout(() => {
        n.classList.add("fade-out");
        setTimeout(() => { if (document.body.contains(n)) document.body.removeChild(n); }, 300);
      }, 3000);
    }

    // ===== SMOOTH SCROLL =====
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener("click", function (this: HTMLAnchorElement, e) {
        const href = this.getAttribute("href");
        if (!href || href === "#") return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    });
  </script>

  <PageWidgets />
</body>
</html>
