---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";
---
<FlagshipLayout title="Dev Hub — VOLYNX" description="The curation layer for systems, kits and useful building blocks developers actually want to revisit." pageClass="page-devhub">
  <FlagshipHeader current={ROUTES.devHub} ctaLabel="Explore the Hub" />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="kicker" data-i18n="devhub2.hero_kicker">Build with VOLYNX</span>
          <h1 data-i18n="devhub2.hero_title">Build, ship and extend the work that started with a clear intention.</h1>
          <p data-i18n="devhub2.hero_desc">The Dev Hub brings together VOLYNX tools, systems, products, learning and support for people building ambitious digital work.</p>
          <div class="hero-actions">
            <a href="#resources" class="button button--gold" data-i18n="devhub2.browse_resources">Browse resources</a>
            <a href={ROUTES.products} class="button button--ghost" data-i18n="devhub2.all_products">All products</a>
          </div>
        </div>
        <div class="hero-visual hero-visual--float" id="heroVisual">
          <img src="/assets/devhub-hero-core.webp" alt="Dev Hub" class="hero-float-icon" />
        </div>
      </div>
    </section>

    <!-- ═══ RESOURCES ═══ -->
    <section id="resources" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="devhub2.resources_eyebrow">Developer resources</span>
        <h2 data-i18n="devhub2.collections_title">Curated collections for serious builders</h2>
      </div>
      <div class="shell grid-3">
        <article class="panel hub-card product-card--iconic hub-card--featured">
          <img src="/assets/devhub-starter-systems.webp" alt="" class="product-card__float-icon devhub-icon" />
          <h3 data-i18n="devhub2.starter_systems">Starter Systems</h3>
          <p data-i18n="devhub2.starter_desc">Fast foundations for agencies, dev portfolios and modern SaaS pages. Ready-to-deploy structures with design + code logic included.</p>
          <div class="actions">
            <a href={ROUTES.portfolioKit} class="button button--ghost" data-i18n="devhub2.portfolio_kit">Portfolio Kit</a>
            <a href={ROUTES.agencyKit} class="button button--ghost" data-i18n="devhub2.agency_kit">Agency Kit</a>
            <a href={ROUTES.portfolioKitPreview} class="button button--gold">Preview unlocks</a>
          </div>
        </article>
        <article class="panel hub-card product-card--iconic hub-card--compact">
          <img src="/assets/devhub-premium-assets.webp" alt="" class="product-card__float-icon devhub-icon" />
          <h3 data-i18n="devhub2.premium_assets">Premium Assets</h3>
          <p data-i18n="devhub2.premium_desc">Icon collections and visual resources that give your work a sharper, more premium finish. Grid, styles and packs — curated, not generic.</p>
          <div class="actions">
            <a href={ROUTES.iconsStore} class="button button--ghost" data-i18n="devhub2.browse_icons">Browse Icons</a>
          </div>
        </article>
        <article class="panel hub-card product-card--iconic hub-card--compact panel--pro">
          <img src="/assets/devhub-pro-utilities.webp" alt="" class="product-card__float-icon devhub-icon" />
          <h3 data-i18n="devhub2.pro_utilities">Pro Utilities</h3>
          <p data-i18n="devhub2.pro_desc">Reserved value for paying users, surfaced elegantly instead of through generic lock states. Studio tools, batch workflows and premium exports.</p>
          <div class="actions">
            <a href={ROUTES.studio} class="button button--gold" data-i18n="devhub2.see_studio_pro">See Studio Pro</a>
          </div>
        </article>
      </div>
    </section>

    <!-- ═══ BUILDER LINK ═══ -->
    <section class="page-section">
      <div class="shell">
        <article class="panel spotlight-card panel--pro" style="position:relative;overflow:visible;">
          <img src="/assets/devhub-builder.webp" alt="" class="product-card__float-icon devhub-builder-icon" />
          <div>
            <span class="label label--pro" data-i18n="devhub2.builder_label">Builder</span>
            <h3 data-i18n="devhub2.builder_title">VOLYNX Builder — the main product.</h3>
            <p data-i18n="devhub2.builder_desc">Create and publish premium sites with guided flows, premium kits and one-click deploy. Custom domains on Pro plans.</p>
          </div>
          <a href={ROUTES.builder} class="button button--gold" data-i18n="devhub2.open_builder">Open Builder</a>
        </article>
      </div>
    </section>

    <!-- ═══ PRODUCT DOCS ═══ -->
    <section class="page-section page-section--last">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="devhub2.docs_eyebrow">Product documentation</span>
        <h2 data-i18n="devhub2.docs_title">Kit documentation and setup guides</h2>
        <p>Public preview only. Full docs, delivery and premium files stay gated after purchase.</p>
      </div>
      <div class="shell grid-3">
        <article class="panel hub-card product-card--iconic hub-card--featured hub-card--docs-featured">
          <img src="/assets/devhub-portfolio-kit.webp" alt="" class="product-card__float-icon" style="border-radius:12px;" />
          <h3 data-i18n="devhub2.doc_portfolio_title">Portfolio Pro Kit</h3>
          <p data-i18n="devhub2.doc_portfolio_desc">Full setup guide, section variants, motion presets and SEO configuration for the premium portfolio system.</p>
          <div class="actions"><a href={`${ROUTES.docs}#portfolio-kit`} class="button button--gold">Preview docs</a></div>
        </article>
        <article class="panel hub-card product-card--iconic hub-card--compact">
          <img src="/assets/devhub-saas-system.webp" alt="" class="product-card__float-icon" />
          <h3 data-i18n="devhub2.doc_saas_title">SaaS Landing System</h3>
          <p data-i18n="devhub2.doc_saas_desc">Block library, variant logic, conversion tracking setup and deployment guide.</p>
          <div class="actions"><a href={`${ROUTES.docs}#saas-system`} class="button button--gold">Preview docs</a></div>
        </article>
        <article class="panel hub-card product-card--iconic hub-card--compact">
          <img src="/assets/devhub-icons-store.webp" alt="" class="product-card__float-icon product-card__float-icon--icons-store" />
          <h3 data-i18n="devhub2.doc_icons_title">Volynx Icons Store</h3>
          <p data-i18n="devhub2.doc_icons_desc">Icon grid, style variants, pack structure and integration with Builder and Studio.</p>
          <div class="actions"><a href={`${ROUTES.docs}#icons-store`} class="button button--gold">Preview docs</a></div>
        </article>
      </div>
    </section>

  </main>
  <FlagshipFooter />
</FlagshipLayout>

<style is:global>
  .page-devhub .hero-copy h1 {
    max-width: 20ch;
  }
  .page-devhub .product-card__float-icon.devhub-icon {
    width: 170px;
    height: auto;
    object-fit: contain;
    border-radius: 16px;
    filter: drop-shadow(0 0 8px rgba(139,250,240,.15));
    top: -50px;
    right: -25px;
  }
  .page-devhub .product-card__float-icon--icons-store {
    width: 200px;
    height: auto;
    top: -50px;
    right: -16px;
  }
  .page-devhub .spotlight-card .devhub-builder-icon {
    width: 120px;
    height: 120px;
    top: -30px;
    right: 20px;
    z-index: 2;
  }
  @media (max-width: 1023px) {
    .page-devhub .product-card__float-icon.devhub-icon {
      right: clamp(-16px, -2vw, -8px);
    }
  }
  @media (min-width: 1024px) {
    .page-devhub .product-card__float-icon,
    .page-devhub .product-card__float-icon.devhub-icon {
      width: 250px;
      height: auto;
      top: -130px;
      right: -70px;
    }
    .page-devhub .product-card__float-icon--icons-store {
      width: 200px;
      height: auto;
      top: -50px;
      right: -16px;
    }
  }
  @media (min-width: 1024px) {
    .page-devhub .spotlight-card .devhub-builder-icon {
      top: -260px;
      right: 20px;
      width: 600px;
      height: auto;
      z-index: -5;
    }
  }
  @media (min-width: 1024px) {
    .product-card__float-icon {
      width: 280px;
      height: auto;
      top: -120px;
      right: -40px;
      z-index: 2;
    }
  }
  .page-devhub .grid-3 {
    margin-top: 60px;
  }
  .page-devhub .section-head {
    margin-bottom: 20px;
  }

  @media (max-width: 767px) {
    .page-devhub .hero {
      padding-top: 20px;
    }
    .page-devhub .hero-grid {
      gap: 8px;
    }
    .page-devhub .hero-copy h1 {
      font-size: clamp(1.55rem, 8.4vw, 2.3rem);
      line-height: 1.03;
    }
    .page-devhub .hero-copy p {
      font-size: .92rem;
      line-height: 1.45;
    }
    .page-devhub .hero-actions {
      gap: 8px;
      margin-top: 18px;
    }
    .page-devhub .hero-actions .button {
      min-height: 44px;
      padding: 11px 14px;
    }
    .page-devhub .hero-visual {
      min-height: 250px;
    }
    .page-devhub .hero-float-icon {
      width: min(74vw, 280px);
    }

    .page-devhub .page-section {
      padding-top: 42px;
    }
    .page-devhub .page-section--last {
      padding-bottom: 22px;
    }
    .page-devhub .section-head {
      gap: 8px;
      margin-bottom: 18px;
    }
    .page-devhub .section-head h2 {
      font-size: clamp(1.9rem, 8.6vw, 2.65rem);
      line-height: 1;
    }
    .page-devhub .section-head p {
      margin: 10px 0 0;
      padding: 12px 14px;
      font-size: .92rem;
      line-height: 1.45;
    }
    .page-devhub .grid-3 {
      gap: 12px;
      margin-top: 24px;
    }

    .page-devhub .hub-card {
      min-height: 0;
      gap: 10px;
      padding: 18px;
      border-radius: 20px;
    }
    .page-devhub .hub-card--featured,
    .page-devhub .hub-card--docs-featured {
      padding-top: 64px;
    }
    .page-devhub .hub-card--featured .devhub-icon,
    .page-devhub .hub-card--docs-featured .product-card__float-icon {
      width: 124px;
      height: 124px;
      top: -48px;
      right: -8px;
    }
    .page-devhub .hub-card--compact {
      display: grid;
      grid-template-columns: 88px minmax(0, 1fr);
      column-gap: 14px;
      align-items: start;
      padding: 16px;
    }
    .page-devhub .hub-card--compact .product-card__float-icon,
    .page-devhub .hub-card--compact .product-card__float-icon--icons-store {
      position: static;
      grid-row: 1 / span 3;
      width: 88px;
      height: 88px;
      max-width: 88px;
      margin: 0;
      object-fit: contain;
      animation: none;
    }
    .page-devhub .hub-card--compact h3 {
      grid-column: 2;
      margin: 0;
      font-size: 1.08rem;
      line-height: 1.08;
    }
    .page-devhub .hub-card--compact p {
      grid-column: 2;
      margin: 0;
      font-size: .78rem;
      line-height: 1.4;
    }
    .page-devhub .hub-card--compact .actions {
      grid-column: 2;
      margin-top: 0;
      gap: 6px;
    }
    .page-devhub .hub-card--compact .actions .button {
      min-height: 40px;
      padding: 9px 11px;
      font-size: .68rem;
    }

    .page-devhub .spotlight-card {
      gap: 12px;
      padding: 18px;
      border-radius: 20px;
    }
    .page-devhub .spotlight-card h3 {
      font-size: 1.35rem;
      line-height: 1.06;
    }
    .page-devhub .spotlight-card p {
      font-size: .84rem;
      line-height: 1.45;
    }
    .page-devhub .spotlight-card .devhub-builder-icon {
      width: 96px;
      height: 96px;
      top: -18px;
      right: 18px;
      z-index: 2;
    }
    .page-devhub .spotlight-card .button {
      min-height: 42px;
    }
  }
</style>
