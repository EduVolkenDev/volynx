---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";
---
<FlagshipLayout title="Dev Hub — VOLYNX" description="The curation layer for systems, kits and useful building blocks developers actually want to revisit." pageClass="page-devhub">
  <FlagshipHeader current={ROUTES.devHub} ctaLabel="Explore the Hub" />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="kicker" data-i18n="devhub2.hero_kicker">Execution layer of VOLYNX</span>
          <h1 data-i18n="devhub2.hero_title">Build, ship and extend the work that started with a clear intention.</h1>
          <p data-i18n="devhub2.hero_desc">The Dev Hub is where VOLYNX turns direction into production: tools, systems, products, learning and support connected in one operating layer.</p>
          <div class="hero-actions">
            <a href="#resources" class="button button--gold" data-i18n="devhub2.browse_resources">Browse resources</a>
            <a href={ROUTES.products} class="button button--ghost" data-i18n="devhub2.all_products">All products</a>
          </div>
        </div>
        <div class="hero-visual hero-visual--float" id="heroVisual">
          <img src="/assets/hero-deploy.webp" alt="Dev Hub" class="hero-float-icon" />
        </div>
      </div>
    </section>

    <!-- ═══ RESOURCES ═══ -->
    <section id="resources" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="devhub2.resources_eyebrow">Developer resources</span>
        <h2 data-i18n="devhub2.collections_title">Curated collections for serious builders</h2>
      </div>
      <div class="shell grid-3">
        <article class="panel hub-card product-card--iconic">
          <img src="/assets/sistemas.webp" alt="" class="product-card__float-icon devhub-icon" />
          <h3 data-i18n="devhub2.starter_systems">Starter Systems</h3>
          <p data-i18n="devhub2.starter_desc">Fast foundations for agencies, dev portfolios and modern SaaS pages. Ready-to-deploy structures with design + code logic included.</p>
          <div class="actions">
            <a href={ROUTES.portfolioKit} class="button button--ghost" data-i18n="devhub2.portfolio_kit">Portfolio Kit</a>
            <a href={ROUTES.agencyKit} class="button button--ghost" data-i18n="devhub2.agency_kit">Agency Kit</a>
            <a href={ROUTES.portfolioKitPreview} class="button button--gold">Preview unlocks</a>
          </div>
        </article>
        <article class="panel hub-card product-card--iconic">
          <img src="/assets/ativos.webp" alt="" class="product-card__float-icon devhub-icon" />
          <h3 data-i18n="devhub2.premium_assets">Premium Assets</h3>
          <p data-i18n="devhub2.premium_desc">Icon collections and visual resources that make the whole product line feel more expensive. Grid, styles and packs — curated, not generic.</p>
          <div class="actions">
            <a href={ROUTES.iconsStore} class="button button--ghost" data-i18n="devhub2.browse_icons">Browse Icons</a>
          </div>
        </article>
        <article class="panel hub-card product-card--iconic panel--pro">
          <img src="/assets/utilitarios.webp" alt="" class="product-card__float-icon devhub-icon" />
          <h3 data-i18n="devhub2.pro_utilities">Pro Utilities</h3>
          <p data-i18n="devhub2.pro_desc">Reserved value for paying users, surfaced elegantly instead of through generic lock states. Studio tools, batch workflows and premium exports.</p>
          <div class="actions">
            <a href={ROUTES.studio} class="button button--gold" data-i18n="devhub2.see_studio_pro">See Studio Pro</a>
          </div>
        </article>
      </div>
    </section>

    <!-- ═══ BUILDER LINK ═══ -->
    <section class="page-section">
      <div class="shell">
        <article class="panel spotlight-card panel--pro" style="position:relative;overflow:visible;">
          <img src="/assets/builder.webp" alt="" class="product-card__float-icon" style="top:-30px;right:20px;width:120px;height:120px;" />
          <div>
            <span class="label label--pro" data-i18n="devhub2.builder_label">Builder</span>
            <h3 data-i18n="devhub2.builder_title">VOLYNX Builder — the main product.</h3>
            <p data-i18n="devhub2.builder_desc">Create and publish premium sites with guided flows, premium kits and one-click deploy. Custom domains on Pro plans.</p>
          </div>
          <a href={ROUTES.builder} class="button button--gold" data-i18n="devhub2.open_builder">Open Builder</a>
        </article>
      </div>
    </section>

    <!-- ═══ PRODUCT DOCS ═══ -->
    <section class="page-section page-section--last">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="devhub2.docs_eyebrow">Product documentation</span>
        <h2 data-i18n="devhub2.docs_title">Kit documentation and setup guides</h2>
        <p>Public preview only. Full docs, delivery and premium files stay gated after purchase.</p>
      </div>
      <div class="shell grid-3">
        <article class="panel hub-card product-card--iconic">
          <img src="/assets/newportfolio.webp" alt="" class="product-card__float-icon" style="border-radius:12px;" />
          <h3 data-i18n="devhub2.doc_portfolio_title">Portfolio Pro Kit</h3>
          <p data-i18n="devhub2.doc_portfolio_desc">Full setup guide, section variants, motion presets and SEO configuration for the premium portfolio system.</p>
          <div class="actions"><a href={`${ROUTES.docs}#portfolio-kit`} class="button button--gold">Preview docs</a></div>
        </article>
        <article class="panel hub-card product-card--iconic">
          <img src="/assets/saasbig.webp" alt="" class="product-card__float-icon" />
          <h3 data-i18n="devhub2.doc_saas_title">SaaS Landing System</h3>
          <p data-i18n="devhub2.doc_saas_desc">Block library, variant logic, conversion tracking setup and deployment guide.</p>
          <div class="actions"><a href={`${ROUTES.docs}#saas-system`} class="button button--gold">Preview docs</a></div>
        </article>
        <article class="panel hub-card product-card--iconic">
          <img src="/assets/icons-store-logo.webp" alt="" class="product-card__float-icon product-card__float-icon--icons-store" />
          <h3 data-i18n="devhub2.doc_icons_title">Volynx Icons Store</h3>
          <p data-i18n="devhub2.doc_icons_desc">Icon grid, style variants, pack structure and integration with Builder and Studio.</p>
          <div class="actions"><a href={`${ROUTES.docs}#icons-store`} class="button button--gold">Preview docs</a></div>
        </article>
      </div>
    </section>

  </main>
  <FlagshipFooter />
</FlagshipLayout>

<style is:global>
  .page-devhub .hero-copy h1 {
    max-width: 20ch;
  }
  .page-devhub .product-card__float-icon.devhub-icon {
    width: 170px;
    height: auto;
    object-fit: contain;
    border-radius: 16px;
    filter: drop-shadow(0 0 8px rgba(139,250,240,.15));
    top: -50px;
    right: -25px;
  }
  .page-devhub .product-card__float-icon--icons-store {
    width: 200px;
    height: auto;
    top: -50px;
    right: -16px;
  }
  @media (min-width: 1024px) {
    .page-devhub .product-card__float-icon,
    .page-devhub .product-card__float-icon.devhub-icon {
      width: 140px;
      height: 180px;
      top: -60px;
      right: -20px;
    }
    .page-devhub .product-card__float-icon--icons-store {
      width: 200px;
      height: auto;
      top: -50px;
      right: -16px;
    }
  }
  .page-devhub .grid-3 {
    margin-top: 60px;
  }
  .page-devhub .section-head {
    margin-bottom: 20px;
  }
</style>
