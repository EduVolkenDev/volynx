---
import "../../styles/lab.css";
import PageWidgets from "../../components/PageWidgets.astro";
import SiteFooter from "../../components/SiteFooter.astro";
const pageTitle = "VOLYNX Dev Hub — Kits & Systems";
const pageDescription = "Premium kits and systems for developers and agencies. Portfolio, SaaS, icons and more.";
---

<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/assets/site.webmanifest" />
</head>

<body>
  <div class="bg" aria-hidden="true"></div>

  <header class="topbar">
    <div class="topbar__inner">
      <a class="topbar__logo" href="/">VOLYNX</a>
      <a class="pill-back" href="/">← Home</a>
    </div>
  </header>

  <main class="wrap">
    <div class="hero">
      <div class="hero__badge">
        <span class="hero__badge-dot" aria-hidden="true"></span>
        VOLYNX Dev Hub
      </div>
      <h1 class="hero__title">
        Kits &amp; <span class="hero__title-accent">Systems</span>
      </h1>
      <p class="hero__desc">
        Products Ready to Deploy. Portfolios, landing pages, icon packs and more.
        Buy, Customize, Launch.
      </p>
    </div>

    <div class="tools-grid">
      <a href="/dev-hub/portfolio-pro-kit/" class="tool-card">
        <img src="/assets/newiconskits4.png">
        <p class="tool-card__desc">
          Premium Portfolio with the unique VOLYNX System.
          Sections, motion, SEO — Ready for conversion.
        </p>
        <span class="tool-card__link">
          See demo
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/dev-hub/saas-landing-system/" class="tool-card">
        <img src="/assets/newiconskits2.png">
        <p class="tool-card__desc">
          Landing page kit focused on conversion. Clean sections,
          basic SEO and fast iteration.
        </p>
        <span class="tool-card__link">
          See demo
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/dev-hub/volynx-icons-store/" class="tool-card">
        <img src="/assets/newiconskits1.png">
        <p class="tool-card__desc">
          Premium SVG Icons pack. Sharp, consistence, ready to brand.
          Scale without losing quality.
        </p>
        <span class="tool-card__link">
          See store
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/products/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
        <span class="tool-card__chip" style="background:rgba(109,94,252,.18);border-color:rgba(109,94,252,.35)">All</span>
        <div class="tool-card__icon" aria-hidden="true">📦</div>
        <h2 class="tool-card__title">See all Products</h2>
        <p class="tool-card__desc">
          Complete catalog of kits, systems and assets by VOLYNX.
          Agency Launch Kit and more.
        </p>
        <span class="tool-card__link">
          See catalog
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </main>

  <SiteFooter />
  <PageWidgets />
</body>
</html>
