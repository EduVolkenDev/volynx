---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";
---
<FlagshipLayout title="Dev Hub — VOLYNX" description="The curation layer for systems, kits and useful building blocks developers actually want to revisit." pageClass="page-devhub">
  <FlagshipHeader current={ROUTES.devHub} ctaLabel="Explore the Hub" />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="kicker">For devs, by devs</span>
          <h1>The Dev Hub should feel like a premium collection, not a leftovers page.</h1>
          <p>The Hub is the curation layer for systems, kits and useful building blocks developers actually want to revisit. Starter systems, premium assets and Pro utilities — all in one place.</p>
          <div class="hero-actions">
            <a href="#resources" class="button button--gold">Browse resources</a>
            <a href={ROUTES.products} class="button button--ghost">All products</a>
          </div>
        </div>
        <div class="hero-card visual-card">
          <span class="label">Collection logic</span>
          <div class="stack">
            <div class="metric">Starter kits</div>
            <div class="metric">Icons</div>
            <div class="metric">Templates</div>
            <div class="metric">Builder tie-ins</div>
          </div>
          <img src="/assets/volynx-icon.webp" alt="Dev Hub" />
        </div>
      </div>
    </section>

    <!-- ═══ RESOURCES ═══ -->
    <section id="resources" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow">Developer resources</span>
        <h2>Curated collections for serious builders</h2>
      </div>
      <div class="shell grid-3">
        <article class="panel hub-card">
          <h3>Starter Systems</h3>
          <p>Fast foundations for agencies, dev portfolios and modern SaaS pages. Ready-to-deploy structures with design + code logic included.</p>
          <div class="actions">
            <a href={ROUTES.portfolioKit} class="button button--ghost">Portfolio Kit</a>
            <a href={ROUTES.agencyKit} class="button button--ghost">Agency Kit</a>
          </div>
        </article>
        <article class="panel hub-card">
          <h3>Premium Assets</h3>
          <p>Icon collections and visual resources that make the whole product line feel more expensive. Grid, styles and packs — curated, not generic.</p>
          <div class="actions">
            <a href={ROUTES.iconsStore} class="button button--ghost">Browse Icons</a>
          </div>
        </article>
        <article class="panel hub-card panel--pro">
          <h3>Pro Utilities</h3>
          <p>Reserved value for paying users, surfaced elegantly instead of through generic lock states. Studio tools, batch workflows and premium exports.</p>
          <div class="actions">
            <a href={ROUTES.studio} class="button button--gold">See Studio Pro</a>
          </div>
        </article>
      </div>
    </section>

    <!-- ═══ BUILDER LINK ═══ -->
    <section class="page-section">
      <div class="shell">
        <article class="panel spotlight-card panel--pro">
          <div>
            <span class="label label--pro">Builder</span>
            <h3>VOLYNX Builder lives here too.</h3>
            <p>Create and manage premium mini-sites with a JSON editor, magic link auth and one-click publish. Custom domains on Pro plans.</p>
          </div>
          <a href={ROUTES.builder} class="button button--gold">Open Builder</a>
        </article>
      </div>
    </section>

    <!-- ═══ PRODUCT DOCS ═══ -->
    <section class="page-section page-section--last">
      <div class="shell section-head">
        <span class="eyebrow">Product documentation</span>
        <h2>Kit documentation and setup guides</h2>
      </div>
      <div class="shell grid-3">
        <article class="panel hub-card">
          <h3>Portfolio Pro Kit</h3>
          <p>Full setup guide, section variants, motion presets and SEO configuration for the premium portfolio system.</p>
          <div class="actions"><a href="/dev-hub/portfolio-pro-kit/" class="button button--ghost">View docs</a></div>
        </article>
        <article class="panel hub-card">
          <h3>SaaS Landing System</h3>
          <p>Block library, variant logic, conversion tracking setup and deployment guide.</p>
          <div class="actions"><a href="/dev-hub/saas-landing-system/" class="button button--ghost">View docs</a></div>
        </article>
        <article class="panel hub-card">
          <h3>Volynx Icons Store</h3>
          <p>Icon grid, style variants, pack structure and integration with Builder and Studio.</p>
          <div class="actions"><a href={ROUTES.iconsStore} class="button button--ghost">View docs</a></div>
        </article>
      </div>
    </section>

  </main>
  <FlagshipFooter />
</FlagshipLayout>
