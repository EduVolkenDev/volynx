---
import "../../styles/lab.css";
import LabBg from "../../components/LabBg.astro";
import PageWidgets from "../../components/PageWidgets.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Topbar from "../../components/Topbar.astro";
const pageTitle = "VOLYNX Dev Hub — Kits & Systems";
const pageDescription = "Premium kits and systems for developers and agencies. Portfolio, SaaS, icons and more.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/site.webmanifest" />
</head>

<body>
  <LabBg />

  <Topbar rightLinks={[{ href: "/", label: "← Home" }]} />

  <main class="wrap">
    <div class="hero">
      <div class="hero__badge">
        <span class="hero__badge-dot" aria-hidden="true"></span>
        <span data-i18n="devhub.title">VOLYNX Dev Hub</span>
      </div>
      <h1 class="hero__title">
        <span data-i18n="devhub.kicker">Kits &amp; <span class="hero__title-accent">Systems</span></span>
      </h1>
      <p class="hero__desc" data-i18n="devhub.subtitle">
        Products Ready to Deploy. Portfolios, landing pages, icon packs and more.
        Buy, Customize, Launch.
      </p>
    </div>

    <div class="tools-grid">
      <a href="/dev-hub/portfolio-pro-kit/" class="tool-card">
        <div class="tool-card__audience" data-i18n="devhub.ppk.for">For: Freelancers · Agencies · Creators</div>
        <img src="/assets/portfoliokit.webp">
        <p class="tool-card__desc">
          Premium Portfolio with the unique VOLYNX System.
          Sections, motion, SEO — Ready for conversion.
        </p>
        <p class="tool-card__usecase">Best for: converting visitors into clients with a polished personal brand.</p>
        <span class="tool-card__link">
          See demo
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/dev-hub/saas-landing-system/" class="tool-card">
        <div class="tool-card__audience" data-i18n="devhub.sls.for">For: SaaS · Creators · Freelancers</div>
        <img src="/assets/saaskit.webp">
        <p class="tool-card__desc">
          Landing page kit focused on conversion. Clean sections,
          basic SEO and fast iteration.
        </p>
        <p class="tool-card__usecase">Best for: launching a product or offer fast, without starting from scratch.</p>
        <span class="tool-card__link">
          See demo
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/products/volynx-icons-store/" class="tool-card">
        <div class="tool-card__audience" data-i18n="devhub.icons.for">For: Designers · Devs · Agencies</div>
        <img src="/assets/icons-store.webp">
        <p class="tool-card__desc">
          Premium SVG Icons pack. Sharp, consistent, ready to brand.
          Scale without losing quality.
        </p>
        <p class="tool-card__usecase">Best for: adding a professional icon language to any product or client project.</p>
        <span class="tool-card__link">
          See store
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/builder/" class="tool-card" style="border-color:rgba(125,211,252,.3)">
        <span class="tool-card__chip" style="background:rgba(125,211,252,.12);border-color:rgba(125,211,252,.3)">Builder</span>
        <img src="/assets/builder-logo.webp" alt="VOLYNX Builder" style="padding:10px 0">
        <h2 class="tool-card__title">VOLYNX Builder</h2>
        <p class="tool-card__desc" data-i18n="devhub.builder.desc">
          Create and manage mini-sites with a JSON editor,
          magic link auth and one-click publish.
        </p>
        <span class="tool-card__link">
          Open Builder
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/products/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
        <span class="tool-card__chip" style="background:rgba(109,94,252,.18);border-color:rgba(109,94,252,.35)">All</span>
        <img src="/assets/studiologo.png" aria-hidden="true">
        <h2 class="tool-card__title" data-i18n="devhub.all_products">See all Products</h2>
        <p class="tool-card__desc">
          Complete catalog of kits, systems and assets by VOLYNX.
          Agency Launch Kit and more.
        </p>
        <span class="tool-card__link">
          See catalog
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </main>

  <SiteFooter />
  <PageWidgets />
</body>
</html>
