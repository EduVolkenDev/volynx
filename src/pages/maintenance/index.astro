---
import "../../styles/maintenance.css";
import PageWidgets from "../../components/PageWidgets.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Topbar from "../../components/Topbar.astro";
const pageTitle = "Volynx — Website Maintenance Plans";
const pageDescription = "Structured website maintenance and product evolution. Predictable delivery. Premium execution. Zero friction.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/site.webmanifest" />
</head>

<body>
  <div class="wmp-bg" aria-hidden="true"></div>

  <Topbar leftLinks={[{ href: "/", label: "Home" }]} />

  <!-- HERO LOGO -->
  <section class="hero">
    <div class="hero-logo">
      <img src="/assets/goldenlogoofi.webp" alt="Volynx — Website Maintenance Plans" />
    </div>
  </section>

  <!-- HERO COPY -->
  <section class="hero-layout">
    <div class="hero-content">
      <h1 data-i18n="maintenance.hero.title">
        Conversion-first websites<br />
        that evolve continuously
      </h1>
      <p class="hero-sub" data-i18n="maintenance.hero.subtitle">
        Volynx delivers structured website maintenance and product evolution.
        Predictable delivery. Premium execution. Zero friction.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn" data-i18n="maintenance.hero.cta.plans">View plans</a>
        <a
          class="btn btn--ghost"
          href="https://wa.me/447438656769?text=Hi%2C%20I%20have%20a%20project%20for%20VOLYNX"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="maintenance.hero.cta.quote"
        >Request a quote</a>
      </div>
    </div>
  </section>

  <!-- PLANS -->
  <section id="plans" class="plans">
    <h2 data-i18n="maintenance.plans.title">Maintenance Plans</h2>
    <p class="section-sub" data-i18n="maintenance.plans.subtitle">
      Subscription-based website care — built for modern businesses.
    </p>

    <div class="plans-grid">
      <!-- OPAL -->
      <div class="plan-card">
        <div class="planimg">
          <span>
            <img class="plan-tier" src="/assets/opalofi2.webp" alt="Opal Plan Icon" />
          </span>
        </div>
        <div class="plan-header">
          <h3>Essential Care</h3>
        </div>
        <p class="plan-desc">
          Stability, security and peace of mind for websites that simply need to work — perfectly.
        </p>
        <ul>
          <li>Weekly update round</li>
          <li>Bug fixes &amp; minor changes</li>
          <li>Dependency updates</li>
          <li>Automated backups</li>
          <li>Uptime monitoring</li>
          <li>Async support (SLA)</li>
        </ul>
        <h2>€219.90 per month</h2>
        <a href="https://buy.stripe.com/fZueVc5hk0Mq3eBaWe5wI01" class="btn btn-opal">Get Opal</a>
      </div>

      <!-- SAPHYRA (featured) -->
      <div class="plan-card plan-featured">
        <div class="planimg">
          <img class="plan-tier" src="/assets/saphyraofi.webp" alt="Saphyra Plan Icon" />
        </div>
        <div class="plan-header">
          <h3>Growth &amp; Performance</h3>
        </div>
        <p class="plan-desc">
          Optimization-driven maintenance focused on performance, UX and conversion.
        </p>
        <ul>
          <li>6 update rounds / month</li>
          <li>Core Web Vitals optimization</li>
          <li>UX &amp; UI improvements</li>
          <li>Conversion &amp; friction audit</li>
          <li>Security hardening + WAF</li>
          <li>Monthly insights report</li>
        </ul>
        <h2>€449.90 per month</h2>
        <a href="https://buy.stripe.com/bJecN49xAdzcbL70hA5wI02" class="btn btn-saphyra">
          Get Saphyra <span>(most popular)</span>
        </a>
      </div>

      <!-- DIAMOND -->
      <div class="plan-card plan-diamond">
        <div class="planimg">
          <img class="plan-tier" src="/assets/diamondofi2.webp" alt="Diamond Plan Icon" />
        </div>
        <div class="plan-header">
          <h3>Signature Studio</h3>
        </div>
        <p class="plan-desc">
          Strategic partnership for high-impact platforms that must perform at all times.
        </p>
        <ul>
          <li>Priority workflow (fair use)</li>
          <li>Monthly feature rollouts</li>
          <li>Continuous UX &amp; conversion audits</li>
          <li>Advanced monitoring &amp; alerts</li>
          <li>Strategic consulting</li>
          <li>Executive-level reporting</li>
        </ul>
        <h2>€749.90 per month</h2>
        <a href="https://buy.stripe.com/3cI00i1143YCeXj5BU5wI03" class="btn btn-diamond">Apply for Diamond</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contact" class="cta">
    <h2 data-i18n="maintenance.cta.title">Your website deserves more than maintenance.</h2>
    <p data-i18n="maintenance.cta.subtitle">
      Let's build a predictable, high-performance system for your digital presence.
    </p>
    <a
      href="https://wa.me/447438656769?text=Hi%2C%20I%20have%20a%20project%20for%20VOLYNX"
      target="_blank"
      rel="noopener noreferrer"
      class="btn"
      data-i18n="maintenance.cta.button"
    >Start the conversation</a>
  </section>

  <SiteFooter />
  <PageWidgets hideUtilBar />
</body>
</html>
