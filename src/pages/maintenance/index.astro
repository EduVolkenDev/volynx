---
import "../../styles/maintenance.css";
import FaviconHead from "../../components/FaviconHead.astro";
import PageWidgets from "../../components/PageWidgets.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Topbar from "../../components/Topbar.astro";
const pageTitle = "VOLYNX Cloud — Care Plans";
const pageDescription = "VOLYNX Cloud keeps your digital presence secure, observable and continuously evolving.";
const maintenanceBriefHref = "/contact/?product=maintenance&intent=guided-quote";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <FaviconHead />
</head>

<body>
  <div class="wmp-bg" aria-hidden="true"></div>

  <Topbar leftLinks={[{ href: "/", label: "Home" }]} />

  <main>

  <!-- HERO LOGO -->
  <section class="hero" aria-labelledby="cloud-hero-title">
    <div class="hero-logo">
      <img src="/assets/volynx-cloud-console-logo.webp" alt="VOLYNX Cloud Console" />
    </div>
  </section>

  <!-- HERO COPY -->
  <section class="hero-layout">
    <div class="hero-content">
      <p class="eyebrow">VOLYNX CLOUD <span aria-hidden="true">/</span> CARE OPERATIONS</p>
      <h1 id="cloud-hero-title" data-i18n="maintenance.hero.title">
        Your digital presence,<br />
        continuously in orbit
      </h1>
      <p class="hero-sub" data-i18n="maintenance.hero.subtitle">
        A managed layer for websites and digital products that need to stay secure,
        sharp and ready for what comes next.
      </p>
      <div class="hero-signals" aria-label="VOLYNX Cloud operating principles">
        <span>SECURE BY DEFAULT</span>
        <span>OBSERVABLE</span>
        <span>ALWAYS EVOLVING</span>
      </div>
      <div class="hero-actions">
        <a href="#plans" class="btn" data-i18n="maintenance.hero.cta.plans">View plans</a>
        <a
          class="btn btn--ghost"
          href={maintenanceBriefHref}
          data-i18n="maintenance.hero.cta.quote"
        >Request a quote</a>
      </div>
    </div>
  </section>

  <!-- CLOUD OPERATING MODEL -->
  <section class="cloud-explainer" aria-labelledby="cloud-explainer-title">
    <div class="cloud-explainer__intro">
      <p class="section-kicker">WHAT YOU ARE ACTUALLY CONTRACTING</p>
      <h2 id="cloud-explainer-title" data-i18n="maintenance.explainer.title">Not just a website online. A product kept in motion.</h2>
      <p data-i18n="maintenance.explainer.desc">VOLYNX Cloud combines infrastructure, technical care and product attention into one accountable operating layer.</p>
    </div>
    <div class="cloud-pillars">
      <article class="cloud-pillar">
        <img class="cloud-pillar__asset" src="/assets/cloud-operational-growth.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" />
        <span class="cloud-pillar__index">01</span>
        <h3 data-i18n="maintenance.explainer.p1.title">Operational Continuity</h3>
        <p data-i18n="maintenance.explainer.p1.desc">Updates, dependency care, backups and release discipline reduce avoidable disruption.</p>
      </article>
      <article class="cloud-pillar">
        <img class="cloud-pillar__asset" src="/assets/cloud-infrastructure-protection.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" />
        <span class="cloud-pillar__index">02</span>
        <h3 data-i18n="maintenance.explainer.p2.title">Infrastructure Protection</h3>
        <p data-i18n="maintenance.explainer.p2.desc">Domains, SSL, delivery, health signals and incidents are treated as an operating picture, not a guess.</p>
      </article>
      <article class="cloud-pillar">
        <img class="cloud-pillar__asset" src="/assets/cloud-global-delivery.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" />
        <span class="cloud-pillar__index">03</span>
        <h3 data-i18n="maintenance.explainer.p3.title">Global Delivery</h3>
        <p data-i18n="maintenance.explainer.p3.desc">Performance, UX, conversion and planned improvements keep the product aligned with the business.</p>
      </article>
    </div>
    <div class="cloud-explainer__foot">
      <span data-i18n="maintenance.explainer.foot1">Your plan covers attention, decisions and execution — not just infrastructure.</span>
      <span data-i18n="maintenance.explainer.foot2">External provider charges and major new builds are scoped separately.</span>
    </div>
  </section>

  <!-- PLANS -->
  <section id="plans" class="plans">
    <p class="section-kicker">CHOOSE YOUR CLOUD LAYER</p>
    <h2 data-i18n="maintenance.plans.title">VOLYNX Cloud plans</h2>
    <p class="section-sub" data-i18n="maintenance.plans.subtitle">
      Three levels of operational care for the stage your product is in today.
    </p>
    <div class="vx-currency-bar"></div>

    <div class="plans-grid">
      <!-- OPAL -->
      <div class="plan-card">
        <div class="planimg">
          <span>
            <img class="plan-tier" src="/assets/volynx-cloud-opal.webp" alt="VOLYNX Cloud Opal" />
          </span>
        </div>
        <div class="plan-header">
          <p class="plan-code">CLOUD / 01</p>
          <h3 aria-label="Volynx Cloud Opal"><span>Volynx Cloud</span><span>Opal</span></h3>
        </div>
        <p class="plan-desc" data-i18n="maint.opal.desc">
          The essential operating layer for a stable, protected digital presence.
        </p>
        <ul>
          <li data-i18n="maint.opal.f1">Weekly update round</li>
          <li data-i18n="maint.opal.f2">Bug fixes &amp; minor changes</li>
          <li data-i18n="maint.opal.f3">Dependency updates</li>
          <li data-i18n="maint.opal.f4">Automated backups</li>
          <li data-i18n="maint.opal.f5">Uptime monitoring</li>
          <li data-i18n="maint.opal.f6">Async support (SLA)</li>
        </ul>
        <h2><span data-price-gbp="£189.90 per month" data-price-gbp-pt="£189,90 por mês" data-price-eur="€219.90 per month" data-price-eur-pt="€219,90 por mês" data-price-brl="R$1.349 per month" data-price-brl-pt="R$1.349 por mês">£189.90 per month</span></h2>
        <a href="https://buy.stripe.com/fZueVc5hk0Mq3eBaWe5wI01" class="btn btn-opal" data-i18n="maint.opal.cta">Activate Opal</a>
      </div>

      <!-- SAPHYRA (featured) -->
      <div class="plan-card plan-featured">
        <div class="planimg">
          <img class="plan-tier" src="/assets/volynx-cloud-saphyra.webp" alt="VOLYNX Cloud Saphyra" />
        </div>
        <div class="plan-header">
          <p class="plan-code">CLOUD / 02 <span class="plan-badge">RECOMMENDED</span></p>
          <h3 aria-label="Volynx Cloud Saphyra"><span>Volynx Cloud</span><span>Saphyra</span></h3>
        </div>
        <p class="plan-desc" data-i18n="maint.saphyra.desc">
          A performance-led operating layer for products ready to grow with intention.
        </p>
        <ul>
          <li data-i18n="maint.saphyra.f1">6 update rounds / month</li>
          <li data-i18n="maint.saphyra.f2">Core Web Vitals optimization</li>
          <li data-i18n="maint.saphyra.f3">UX &amp; UI improvements</li>
          <li data-i18n="maint.saphyra.f4">Conversion &amp; friction audit</li>
          <li data-i18n="maint.saphyra.f5">Security hardening + WAF</li>
          <li data-i18n="maint.saphyra.f6">Monthly insights report</li>
        </ul>
        <h2><span data-price-gbp="£389.90 per month" data-price-gbp-pt="£389,90 por mês" data-price-eur="€449.90 per month" data-price-eur-pt="€449,90 por mês" data-price-brl="R$2.749 per month" data-price-brl-pt="R$2.749 por mês">£389.90 per month</span></h2>
        <a href="https://buy.stripe.com/bJecN49xAdzcbL70hA5wI02" class="btn btn-saphyra" data-i18n="maint.saphyra.cta">
          Activate Saphyra <span data-i18n="maint.saphyra.popular">(recommended)</span>
        </a>
      </div>

      <!-- DIAMOND -->
      <div class="plan-card plan-diamond">
        <div class="planimg">
          <img class="plan-tier" src="/assets/volynx-cloud-diamond.webp" alt="VOLYNX Cloud Diamond" />
        </div>
        <div class="plan-header">
          <p class="plan-code">CLOUD / 03</p>
          <h3 aria-label="Volynx Cloud Diamond"><span>Volynx Cloud</span><span>Diamond</span></h3>
        </div>
        <p class="plan-desc" data-i18n="maint.diamond.desc">
          The highest-touch operating layer for high-impact platforms and ambitious teams.
        </p>
        <ul>
          <li data-i18n="maint.diamond.f1">Priority workflow (fair use)</li>
          <li data-i18n="maint.diamond.f2">Monthly feature rollouts</li>
          <li data-i18n="maint.diamond.f3">Continuous UX &amp; conversion audits</li>
          <li data-i18n="maint.diamond.f4">Advanced monitoring &amp; alerts</li>
          <li data-i18n="maint.diamond.f5">Strategic consulting</li>
          <li data-i18n="maint.diamond.f6">Executive-level reporting</li>
        </ul>
        <h2><span data-price-gbp="£649.90 per month" data-price-gbp-pt="£649,90 por mês" data-price-eur="€749.90 per month" data-price-eur-pt="€749,90 por mês" data-price-brl="R$4.499 per month" data-price-brl-pt="R$4.499 por mês">£649.90 per month</span></h2>
        <a href="https://buy.stripe.com/3cI00i1143YCeXj5BU5wI03" class="btn btn-diamond" data-i18n="maint.diamond.cta">Enter Diamond</a>
      </div>
    </div>
  </section>

  <!-- MONTHLY OPERATING LAYER -->
  <section class="cloud-workflow" aria-labelledby="cloud-workflow-title">
    <div class="cloud-workflow__head">
      <p class="section-kicker">THE MONTHLY LAYER</p>
      <h2 id="cloud-workflow-title" data-i18n="maintenance.workflow.title">What happens after launch</h2>
      <p data-i18n="maintenance.workflow.desc">The work is continuous because the conditions around a digital product are continuous.</p>
    </div>
    <ol class="cloud-workflow__steps">
      <li><strong data-i18n="maintenance.workflow.s1.title">Observe</strong><span data-i18n="maintenance.workflow.s1.desc">Review signals, changes and issues.</span></li>
      <li><strong data-i18n="maintenance.workflow.s2.title">Prioritise</strong><span data-i18n="maintenance.workflow.s2.desc">Separate urgent risk from useful improvement.</span></li>
      <li><strong data-i18n="maintenance.workflow.s3.title">Execute</strong><span data-i18n="maintenance.workflow.s3.desc">Ship the agreed care and product work.</span></li>
      <li><strong data-i18n="maintenance.workflow.s4.title">Report</strong><span data-i18n="maintenance.workflow.s4.desc">Keep the next decision clear.</span></li>
    </ol>
  </section>

  <!-- CTA -->
  <section id="contact" class="cta">
    <p class="section-kicker">THE CLOUD STANDARD</p>
    <h2 data-i18n="maintenance.cta.title">Maintenance is only the beginning.</h2>
    <p data-i18n="maintenance.cta.subtitle">
      Let's give your digital presence the operational clarity to perform today and evolve tomorrow.
    </p>
    <a
      href={maintenanceBriefHref}
      class="btn"
      data-i18n="maintenance.cta.button"
    >Start the conversation</a>
  </section>

  </main>

  <SiteFooter />
  <PageWidgets hideUtilBar />
  <script is:inline src="/js/vx-currency.js"></script>
</body>
</html>
