---
import "../../styles/maintenance.css";
import FaviconHead from "../../components/FaviconHead.astro";
import PageWidgets from "../../components/PageWidgets.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Topbar from "../../components/Topbar.astro";
const pageTitle = "Volynx — Website Maintenance Plans";
const pageDescription = "Structured website maintenance and product evolution. Predictable delivery. Premium execution. Zero friction.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <FaviconHead />
</head>

<body>
  <div class="wmp-bg" aria-hidden="true"></div>

  <Topbar leftLinks={[{ href: "/", label: "Home" }]} />

  <!-- HERO LOGO -->
  <section class="hero">
    <div class="hero-logo">
      <img src="/assets/goldenlogoofi.webp" alt="Volynx — Website Maintenance Plans" />
    </div>
  </section>

  <!-- HERO COPY -->
  <section class="hero-layout">
    <div class="hero-content">
      <h1 data-i18n="maintenance.hero.title">
        Conversion-first websites<br />
        that evolve continuously
      </h1>
      <p class="hero-sub" data-i18n="maintenance.hero.subtitle">
        Volynx delivers structured website maintenance and product evolution.
        Predictable delivery. Premium execution. Zero friction.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn" data-i18n="maintenance.hero.cta.plans">View plans</a>
        <a
          class="btn btn--ghost"
          href="https://wa.me/447577991080?text=Hi%2C%20I%20have%20a%20project%20for%20VOLYNX"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="maintenance.hero.cta.quote"
        >Request a quote</a>
      </div>
    </div>
  </section>

  <!-- PLANS -->
  <section id="plans" class="plans">
    <h2 data-i18n="maintenance.plans.title">Maintenance Plans</h2>
    <p class="section-sub" data-i18n="maintenance.plans.subtitle">
      Subscription-based website care — built for modern businesses.
    </p>
    <div class="vx-currency-bar"></div>

    <div class="plans-grid">
      <!-- OPAL -->
      <div class="plan-card">
        <div class="planimg">
          <span>
            <img class="plan-tier" src="/assets/opalofi2.webp" alt="Opal Plan Icon" />
          </span>
        </div>
        <div class="plan-header">
          <h3 data-i18n="maint.opal.name">Essential Care</h3>
        </div>
        <p class="plan-desc" data-i18n="maint.opal.desc">
          Stability, security and peace of mind for websites that simply need to work — perfectly.
        </p>
        <ul>
          <li data-i18n="maint.opal.f1">Weekly update round</li>
          <li data-i18n="maint.opal.f2">Bug fixes &amp; minor changes</li>
          <li data-i18n="maint.opal.f3">Dependency updates</li>
          <li data-i18n="maint.opal.f4">Automated backups</li>
          <li data-i18n="maint.opal.f5">Uptime monitoring</li>
          <li data-i18n="maint.opal.f6">Async support (SLA)</li>
        </ul>
        <h2><span data-price-gbp="£189.90 per month" data-price-eur="€219.90 per month" data-price-brl="R$1.349 per month">£189.90 per month</span></h2>
        <a href="https://buy.stripe.com/fZueVc5hk0Mq3eBaWe5wI01" class="btn btn-opal" data-i18n="maint.opal.cta">Get Opal</a>
      </div>

      <!-- SAPHYRA (featured) -->
      <div class="plan-card plan-featured">
        <div class="planimg">
          <img class="plan-tier" src="/assets/saphyraofi.webp" alt="Saphyra Plan Icon" />
        </div>
        <div class="plan-header">
          <h3 data-i18n="maint.saphyra.name">Growth &amp; Performance</h3>
        </div>
        <p class="plan-desc" data-i18n="maint.saphyra.desc">
          Optimization-driven maintenance focused on performance, UX and conversion.
        </p>
        <ul>
          <li data-i18n="maint.saphyra.f1">6 update rounds / month</li>
          <li data-i18n="maint.saphyra.f2">Core Web Vitals optimization</li>
          <li data-i18n="maint.saphyra.f3">UX &amp; UI improvements</li>
          <li data-i18n="maint.saphyra.f4">Conversion &amp; friction audit</li>
          <li data-i18n="maint.saphyra.f5">Security hardening + WAF</li>
          <li data-i18n="maint.saphyra.f6">Monthly insights report</li>
        </ul>
        <h2><span data-price-gbp="£389.90 per month" data-price-eur="€449.90 per month" data-price-brl="R$2.749 per month">£389.90 per month</span></h2>
        <a href="https://buy.stripe.com/bJecN49xAdzcbL70hA5wI02" class="btn btn-saphyra" data-i18n="maint.saphyra.cta">
          Get Saphyra <span data-i18n="maint.saphyra.popular">(most popular)</span>
        </a>
      </div>

      <!-- DIAMOND -->
      <div class="plan-card plan-diamond">
        <div class="planimg">
          <img class="plan-tier" src="/assets/diamondofi2.webp" alt="Diamond Plan Icon" />
        </div>
        <div class="plan-header">
          <h3 data-i18n="maint.diamond.name">Signature Studio</h3>
        </div>
        <p class="plan-desc" data-i18n="maint.diamond.desc">
          Strategic partnership for high-impact platforms that must perform at all times.
        </p>
        <ul>
          <li data-i18n="maint.diamond.f1">Priority workflow (fair use)</li>
          <li data-i18n="maint.diamond.f2">Monthly feature rollouts</li>
          <li data-i18n="maint.diamond.f3">Continuous UX &amp; conversion audits</li>
          <li data-i18n="maint.diamond.f4">Advanced monitoring &amp; alerts</li>
          <li data-i18n="maint.diamond.f5">Strategic consulting</li>
          <li data-i18n="maint.diamond.f6">Executive-level reporting</li>
        </ul>
        <h2><span data-price-gbp="£649.90 per month" data-price-eur="€749.90 per month" data-price-brl="R$4.499 per month">£649.90 per month</span></h2>
        <a href="https://buy.stripe.com/3cI00i1143YCeXj5BU5wI03" class="btn btn-diamond" data-i18n="maint.diamond.cta">Apply for Diamond</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contact" class="cta">
    <h2 data-i18n="maintenance.cta.title">Your website deserves more than maintenance.</h2>
    <p data-i18n="maintenance.cta.subtitle">
      Let's build a predictable, high-performance system for your digital presence.
    </p>
    <a
      href="https://wa.me/447577991080?text=Hi%2C%20I%20have%20a%20project%20for%20VOLYNX"
      target="_blank"
      rel="noopener noreferrer"
      class="btn"
      data-i18n="maintenance.cta.button"
    >Start the conversation</a>
  </section>

  <SiteFooter />
  <PageWidgets hideUtilBar />
  <script is:inline src="/js/vx-currency.js"></script>
</body>
</html>
