---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const title = "Property Flow";
const description = "Catálogo de imóveis publicado com Property Flow.";
---

<BaseLayout title={title} description={description} hideUtilBar pageClass="property-flow-public-page">
  <main class="pf-public" id="propertyFlowPublic" aria-live="polite">
    <section class="pf-public__state" id="publicLoading"><span class="pf-public__spinner" aria-hidden="true"></span><p>Carregando catálogo…</p></section>
    <section class="pf-public__state" id="publicError" hidden><p id="publicErrorMessage">Este catálogo ainda não está disponível.</p><a href="/products/propertyflow/">Conhecer o Property Flow</a></section>
    <div id="publicSite" hidden>
      <header class="pf-public__header"><a class="pf-public__brand" href="/"><span class="pf-public__mark" id="publicMark">PF</span><span><strong id="publicBrandName">Property Flow</strong><small id="publicBrandTagline">Catálogo de imóveis</small></span></a><span class="pf-public__template" id="publicTemplateLabel"></span></header>
      <section class="pf-public__hero"><div class="pf-public__hero-copy"><span class="pf-public__eyebrow">PROPERTY FLOW</span><h1 id="publicTitle">Encontre o imóvel certo.</h1><p id="publicDescription">Explore imóveis selecionados com clareza, contexto e uma experiência feita para decidir.</p><a class="pf-public__contact" id="publicContact" href="#catalog">Ver imóveis</a></div><div class="pf-public__hero-media" id="publicHeroMedia" role="img" aria-label="Imagem de destaque do catálogo"></div></section>
      <section class="pf-public__catalog" id="catalog"><div class="pf-public__catalog-head"><div><span class="pf-public__eyebrow">CATÁLOGO</span><h2>Imóveis disponíveis</h2></div><span id="publicCount"></span></div><div class="pf-public__filter-bar"><label class="pf-public__search"><span class="sr-only">Buscar imóveis</span><span aria-hidden="true">⌕</span><input id="publicSearch" type="search" placeholder="Buscar imóvel, cidade ou bairro" autocomplete="off" /></label><div class="pf-public__filters" id="publicFilters" role="group" aria-label="Filtrar imóveis"></div></div><div class="pf-public__map-context" id="publicMapContext" hidden><div class="pf-public__map-grid" aria-hidden="true"></div><div><span class="pf-public__eyebrow">MAP-FIRST</span><h3>Comece pela região.</h3><p>Explore o catálogo por cidade e localização antes de escolher o imóvel.</p></div></div><div class="pf-public__carousel" id="publicCarousel" hidden><span class="pf-public__carousel-position" id="publicCarouselPosition" aria-live="polite"></span><div class="pf-public__carousel-actions"><button type="button" id="publicCarouselPrevious" aria-label="Imóvel anterior" aria-controls="publicGrid"><span aria-hidden="true">←</span></button><button type="button" id="publicCarouselNext" aria-label="Próximo imóvel" aria-controls="publicGrid"><span aria-hidden="true">→</span></button></div></div><div class="pf-public__grid" id="publicGrid"></div></section>
      <footer class="pf-public__footer" id="contact"><span id="publicFooterBrand">Property Flow</span><span>Powered by VOLYNX</span></footer>
    </div>
    <dialog class="pf-details" id="publicDetails" aria-labelledby="publicDetailsTitle">
      <button class="pf-details__close" id="publicDetailsClose" type="button" aria-label="Fechar detalhes">×</button>
      <div class="pf-details__layout">
        <div class="pf-details__gallery"><img id="publicDetailsImage" alt="" /><div class="pf-details__thumbs" id="publicDetailsThumbs"></div></div>
        <div class="pf-details__copy"><span class="pf-public__eyebrow" id="publicDetailsCategory"></span><h2 id="publicDetailsTitle"></h2><strong class="pf-details__price" id="publicDetailsPrice"></strong>
          <section class="pf-details__panel pf-details__panel--story" id="publicDetailsStory" aria-labelledby="publicDetailsStoryLabel"><img src="/assets/propertyflow/visuals/feature/04-property-key.webp" alt="" aria-hidden="true" loading="lazy" /><div><span class="pf-public__eyebrow" id="publicDetailsStoryLabel">A EXPERIÊNCIA</span><p id="publicDetailsDescription"></p><ul id="publicDetailsHighlights" hidden></ul></div></section>
          <section class="pf-details__panel pf-details__panel--place" aria-labelledby="publicDetailsPlaceLabel"><img src="/assets/propertyflow/visuals/feature/05-location.webp" alt="" aria-hidden="true" loading="lazy" /><div><span class="pf-public__eyebrow" id="publicDetailsPlaceLabel">O ENDEREÇO</span><strong id="publicDetailsLocation"></strong><dl id="publicDetailsFacts"></dl></div></section>
        </div>
      </div>
    </dialog>
  </main>
</BaseLayout>

<script>
  import { createClient } from "@supabase/supabase-js";
  import { propertyFlowTemplate, type PropertyFlowTemplateKey } from "../../../lib/property-flow-templates";

  type Site = { id: string; name: string; slug: string; domain?: string | null; subdomain?: string | null; theme?: Record<string, unknown>; settings?: Record<string, any> };
  type Property = { id: string; title: string; slug: string; category?: string; listing_type?: "sale" | "rent" | "sale_and_rent"; summary?: string; description?: string; price_label?: string; price_amount?: number | null; location?: { label?: string; city?: string; region?: string }; features?: unknown; status: string; is_featured?: boolean; bedrooms?: number; bathrooms?: number; yield?: string; demo_image?: string };
  type Image = { property_id: string; storage_path: string; is_cover: boolean; sort_order: number };
  type PublicData = { site: Site; properties: Property[]; images: Image[] };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const params = new URLSearchParams(window.location.search);
  const preview = import.meta.env.DEV && params.get("preview") === "1";
  const requestedPreviewTemplate = preview ? params.get("template") : null;
  const legacyTemplateAliases: Record<string, PropertyFlowTemplateKey> = { "map-view": "map-first", "tabbed-categories": "grouped", "carousel-hero": "showroom" };
  const demoSite: Site = { id: "demo", name: "Jhonatan Peterson Imóveis", slug: "johnny-parisnez", domain: "www.jhonatanpetersonimoveis.com.br", settings: { image_bucket: "johnny-property-images", property_flow: { template_key: "editorial" }, property_flow_admin: { brand: { name: "Jhonatan Peterson", tagline: "Imóveis com curadoria, estratégia e atendimento premium.", mark: "JP", colors: { primary: "#d8b36a", accent: "#a9a0ff", ink: "#f7f8fc", surface: "#0c111d" } } } } };
  const demoProperties: Property[] = [
    { id: "demo-1", title: "Casa com vista para a serra", slug: "casa-serra", category: "Casa", listing_type: "sale", summary: "Arquitetura, luz e privacidade em uma localização especial.", description: "Um imóvel pensado para viver com calma e receber bem.", price_label: "R$ 1.850.000", location: { label: "Atibaia, SP", city: "Atibaia", region: "SP" }, status: "published", is_featured: true, bedrooms: 4, bathrooms: 3, yield: "4,8%", demo_image: "/propertyflow/demo/casa-serra.webp" },
    { id: "demo-2", title: "Apartamento autoral", slug: "apartamento-autoral", category: "Apartamento", listing_type: "sale", summary: "Linhas contemporâneas e tudo perto.", description: "Um endereço urbano para uma rotina mais simples.", price_label: "R$ 1.280.000", location: { label: "São Paulo, SP", city: "São Paulo", region: "SP" }, status: "published", bedrooms: 3, bathrooms: 2, yield: "5,1%", demo_image: "/propertyflow/demo/apartamento-autoral.webp" },
    { id: "demo-3", title: "Refúgio entre árvores", slug: "refugio-arvores", category: "Chácara", listing_type: "rent", summary: "Espaço, silêncio e natureza para chamar de seu.", description: "Uma propriedade para desacelerar sem ficar distante.", price_label: "R$ 8.500 / mês", location: { label: "Mairiporã, SP", city: "Mairiporã", region: "SP" }, status: "published", bedrooms: 5, bathrooms: 4, yield: "3,9%", demo_image: "/propertyflow/demo/refugio-arvores.webp" },
  ];

  function escapeHtml(value: unknown) { return String(value ?? "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char] || char); }
  function canonicalTemplate(value: unknown): PropertyFlowTemplateKey { return propertyFlowTemplate(value)?.key || legacyTemplateAliases[String(value || "")] || "classic-grid"; }
  function coverFor(propertyId: string, images: Image[]) { return images.filter((image) => image.property_id === propertyId).sort((a, b) => Number(a.sort_order) - Number(b.sort_order)).find((image) => image.is_cover) || images.find((image) => image.property_id === propertyId); }
  function imageUrl(supa: any, bucket: string, image?: Image) { return image ? supa.storage.from(bucket).getPublicUrl(image.storage_path).data.publicUrl : ""; }
  function brandFrom(site: Site) { const brand = site.settings?.property_flow_admin?.brand || {}; return { name: String(brand.name || site.name || "Property Flow"), tagline: String(brand.tagline || "Catálogo de imóveis"), mark: String(brand.mark || site.name?.slice(0, 2) || "PF"), colors: brand.colors || {} }; }
  function render(data: PublicData, supa: any) {
    const site = data.site; const brand = brandFrom(site); const template = canonicalTemplate(requestedPreviewTemplate || site.settings?.property_flow?.template_key); const info = propertyFlowTemplate(template); const bucket = String(site.settings?.image_bucket || "property-flow-images"); const root = $("propertyFlowPublic")!; root.dataset.template = template; root.dataset.preview = String(preview); const mapContext = $("publicMapContext"); if (mapContext) mapContext.hidden = template !== "map-first";
    $("publicBrandName")!.textContent = brand.name; $("publicBrandTagline")!.textContent = brand.tagline; $("publicMark")!.textContent = brand.mark; $("publicFooterBrand")!.textContent = brand.name; $("publicTemplateLabel")!.textContent = info?.name || template; $("publicCount")!.textContent = `${data.properties.length} ${data.properties.length === 1 ? "imóvel" : "imóveis"}`;
    const colors = brand.colors as Record<string, string>; for (const [key, fallback] of [["primary", "#d8b36a"], ["accent", "#a9a0ff"], ["surface", "#0c111d"], ["ink", "#f7f8fc"]] as const) root.style.setProperty(`--pf-public-${key}`, /^#[0-9a-f]{6}$/i.test(String(colors[key] || "")) ? colors[key] : fallback);
    const categories = [...new Set(data.properties.map((property) => property.category).filter(Boolean))] as string[]; const filters = $("publicFilters")!; filters.innerHTML = [`<button class="is-active" type="button" data-category="all">Todos</button>`, ...categories.map((category) => `<button type="button" data-category="${escapeHtml(category)}">${escapeHtml(category)}</button>`)].join("");
    const search = $("publicSearch") as HTMLInputElement | null;
    const listingLabel = (value: Property["listing_type"]) => value === "rent" ? "Aluguel" : value === "sale_and_rent" ? "Venda e aluguel" : "Venda";
    const featureNumber = (property: Property, label: string) => { const features = Array.isArray(property.features) ? property.features : []; const match = features.find((feature) => typeof feature === "string" && feature.toLowerCase().includes(label)); const number = typeof match === "string" ? match.match(/\d+/)?.[0] : undefined; return number ? Number(number) : undefined; };
    const propertyMeta = (property: Property) => ({ beds: property.bedrooms ?? featureNumber(property, "quarto") ?? featureNumber(property, "bed"), baths: property.bathrooms ?? featureNumber(property, "banheiro") ?? featureNumber(property, "bath"), location: property.location?.label || [property.location?.city, property.location?.region].filter(Boolean).join(", ") || "Localização sob consulta" });
    const heroProperty = data.properties.find((property) => property.is_featured) || data.properties[0]; const heroImage = heroProperty?.demo_image || imageUrl(supa, bucket, heroProperty ? coverFor(heroProperty.id, data.images) : undefined); const heroMedia = $("publicHeroMedia"); if (heroMedia) { heroMedia.style.backgroundImage = heroImage ? `linear-gradient(180deg,rgba(5,8,14,.04),rgba(5,8,14,.64)),url('${escapeHtml(heroImage)}')` : ""; heroMedia.setAttribute("aria-label", heroProperty ? `Imagem de destaque: ${heroProperty.title}` : "Imagem de destaque do catálogo"); heroMedia.toggleAttribute("hidden", !heroImage); }
    const grid = $("publicGrid")!;
    const carousel = $("publicCarousel")!;
    const carouselPosition = $("publicCarouselPosition")!;
    const previous = $("publicCarouselPrevious") as HTMLButtonElement;
    const next = $("publicCarouselNext") as HTMLButtonElement;
    const carouselCards = () => [...grid.querySelectorAll<HTMLElement>(".pf-public__card")];
    const activeCarouselIndex = () => {
      const cards = carouselCards();
      const center = grid.getBoundingClientRect().left + grid.clientWidth / 2;
      return cards.reduce((closest, card, index) => Math.abs(card.getBoundingClientRect().left + card.clientWidth / 2 - center) < Math.abs(cards[closest].getBoundingClientRect().left + cards[closest].clientWidth / 2 - center) ? index : closest, 0);
    };
    const updateCarousel = () => {
      const cards = carouselCards();
      carousel.hidden = template !== "showroom" || cards.length < 2;
      if (carousel.hidden) return;
      const index = activeCarouselIndex();
      carouselPosition.textContent = `${index + 1} de ${cards.length}`;
      previous.disabled = index === 0;
      next.disabled = index === cards.length - 1;
    };
    const moveCarousel = (direction: number) => {
      const cards = carouselCards();
      const target = cards[Math.max(0, Math.min(cards.length - 1, activeCarouselIndex() + direction))];
      if (!target) return;
      grid.scrollTo({ left: grid.scrollLeft + target.getBoundingClientRect().left - grid.getBoundingClientRect().left, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    };
    previous.addEventListener("click", () => moveCarousel(-1));
    next.addEventListener("click", () => moveCarousel(1));
    grid.addEventListener("scroll", () => requestAnimationFrame(updateCarousel), { passive: true });
    window.addEventListener("resize", updateCarousel);
    const details = $("publicDetails") as HTMLDialogElement;
    const closeDetails = $("publicDetailsClose") as HTMLButtonElement;
    closeDetails.addEventListener("click", () => details.close());
    details.addEventListener("click", (event) => { if (event.target === details) details.close(); });
    const openDetails = (property: Property) => {
      const meta = propertyMeta(property);
      $("publicDetailsCategory")!.textContent = property.category || "Imóvel";
      $("publicDetailsTitle")!.textContent = property.title;
      $("publicDetailsPrice")!.textContent = property.price_label || "Sob consulta";
      const narrative = property.description || property.summary || "";
      $("publicDetailsDescription")!.textContent = narrative;
      $("publicDetailsStory")!.hidden = !narrative;
      $("publicDetailsLocation")!.textContent = meta.location;
      const highlights = $("publicDetailsHighlights")!;
      highlights.replaceChildren();
      const features = Array.isArray(property.features) ? property.features.filter((feature): feature is string => typeof feature === "string" && !!feature.trim()).slice(0, 6) : [];
      for (const feature of features) { const item = document.createElement("li"); item.textContent = feature; highlights.append(item); }
      highlights.hidden = !features.length;
      const facts = $("publicDetailsFacts")!;
      facts.replaceChildren();
      for (const [label, value] of [["Quartos", meta.beds], ["Banheiros", meta.baths]] as const) {
        if (value === undefined || value === null) continue;
        const wrapper = document.createElement("div"); const term = document.createElement("dt"); const detail = document.createElement("dd");
        term.textContent = label; detail.textContent = String(value); wrapper.append(term, detail); facts.append(wrapper);
      }
      const gallery = $("publicDetailsThumbs")!;
      gallery.replaceChildren();
      const images = data.images.filter((image) => image.property_id === property.id).sort((a, b) => a.sort_order - b.sort_order).map((image) => imageUrl(supa, bucket, image));
      if (property.demo_image && !images.length) images.push(property.demo_image);
      const main = $("publicDetailsImage") as HTMLImageElement;
      const galleryPanel = main.parentElement as HTMLElement;
      galleryPanel.hidden = !images.length;
      galleryPanel.parentElement?.classList.toggle("pf-details__layout--no-gallery", !images.length);
      if (images.length) { main.src = images[0]; main.alt = `${property.title} — foto 1`; }
      images.forEach((src, index) => {
        const button = document.createElement("button"); button.type = "button"; button.setAttribute("aria-label", `Ver foto ${index + 1} de ${images.length}`);
        const image = document.createElement("img"); image.src = src; image.alt = ""; image.loading = "lazy"; button.append(image);
        button.addEventListener("click", () => { main.src = src; main.alt = `${property.title} — foto ${index + 1}`; });
        gallery.append(button);
      });
      details.showModal();
    };
    grid.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-open-property]");
      if (!button) return;
      const property = data.properties.find((item) => item.id === button.dataset.openProperty);
      if (property) openDetails(property);
    });
    const renderGrid = (category = "all", query = "") => {
      const normalizedQuery = query.trim().toLocaleLowerCase();
      const properties = data.properties.filter((property) => {
        const searchable = [property.title, property.summary, property.location?.label, property.location?.city, property.location?.region].filter(Boolean).join(" ").toLocaleLowerCase();
        return (category === "all" || property.category === category) && (!normalizedQuery || searchable.includes(normalizedQuery));
      });
      $("publicCount")!.textContent = `${properties.length} ${properties.length === 1 ? "imóvel" : "imóveis"}`;
      const cardMarkup = (property: Property, index: number) => {
        const image = property.demo_image || imageUrl(supa, bucket, coverFor(property.id, data.images));
        const meta = propertyMeta(property);
        const stats = [meta.beds ? `${meta.beds} quartos` : "", meta.baths ? `${meta.baths} banheiros` : "", property.yield ? `yield ${property.yield}` : ""].filter(Boolean).join("  ·  ");
        const style = image ? ` style="background-image:linear-gradient(180deg,rgba(6,10,18,.08),rgba(6,10,18,.86)),url('${escapeHtml(image)}')"` : "";
        return `<article class="pf-public__card" data-property-card data-category="${escapeHtml(property.category || "Imóvel")}" data-timeline-index="${index + 1}" style="--card-index:${index}"><div class="pf-public__image" role="img" aria-label="Imagem de ${escapeHtml(property.title)}"${style}><div class="pf-public__image-top"><span>${escapeHtml(property.category || "Imóvel")}</span>${property.is_featured ? `<strong>Em destaque</strong>` : ""}</div><div class="pf-public__image-meta"><small>${escapeHtml(meta.location)}</small><h3>${escapeHtml(property.title)}</h3><div><b>${escapeHtml(property.price_label || "Sob consulta")}</b><span>${escapeHtml(stats || listingLabel(property.listing_type))}</span></div></div>${!image ? `<strong class="pf-public__image-placeholder">${escapeHtml((property.title || "P").slice(0, 1).toUpperCase())}</strong>` : ""}</div><div class="pf-public__card-body"><p>${escapeHtml(property.summary || property.description || "")}</p><div class="pf-public__card-foot"><span>${escapeHtml(listingLabel(property.listing_type))}</span><button type="button" data-open-property="${escapeHtml(property.id)}">Ver detalhes</button></div></div></article>`;
      };
      if (!properties.length) { grid.innerHTML = `<div class="pf-public__empty">Nenhum imóvel encontrado nesta busca.</div>`; updateCarousel(); return; }
      if (template === "grouped") {
        const groups = properties.reduce((map, property) => { const key = property.category || "Imóveis"; const group = map.get(key) || []; group.push(property); map.set(key, group); return map; }, new Map<string, Property[]>());
        grid.innerHTML = [...groups.entries()].map(([name, group]) => `<section class="pf-public__group"><h3>${escapeHtml(name)}</h3><div class="pf-public__group-grid">${group.map((property, index) => cardMarkup(property, index)).join("")}</div></section>`).join("");
      } else {
        grid.innerHTML = properties.map(cardMarkup).join("");
      }
      grid.scrollLeft = 0;
      updateCarousel();
    };
    const rerender = () => renderGrid(filters.querySelector<HTMLButtonElement>("button.is-active")?.dataset.category || "all", search?.value || "");
    renderGrid(); filters.querySelectorAll<HTMLButtonElement>("button").forEach((button) => button.addEventListener("click", () => { filters.querySelectorAll("button").forEach((item) => item.classList.toggle("is-active", item === button)); rerender(); })); search?.addEventListener("input", rerender);
    $("publicLoading")!.hidden = true; $("publicSite")!.hidden = false; requestAnimationFrame(updateCarousel);
  }
  async function boot() {
    try {
      const cfg = await fetch("/config.json", { cache: "no-store" }).then((response) => response.json()); const supa = createClient(cfg.supabaseUrl, cfg.supabaseAnonKey);
      if (preview) { render({ site: demoSite, properties: demoProperties, images: [] }, supa); return; }
      const target = params.get("site") || window.location.hostname; const resolved = await supa.rpc("get_public_property_flow_site", { p_host: target }); const site = Array.isArray(resolved.data) ? resolved.data[0] : resolved.data; if (resolved.error) throw resolved.error; if (!site) throw new Error("Catálogo não encontrado.");
      const [propertiesResult, imagesResult] = await Promise.all([supa.from("property_listings").select("id,title,slug,category,listing_type,summary,description,price_amount,price_label,location,features,is_featured,status,sort_order").eq("site_id", site.id).eq("organization_id", site.organization_id).eq("status", "published").order("sort_order", { ascending: true }).order("created_at", { ascending: false }), supa.from("property_listing_images").select("property_id,storage_path,is_cover,sort_order").eq("site_id", site.id).eq("organization_id", site.organization_id).order("sort_order", { ascending: true })]); if (propertiesResult.error) throw propertiesResult.error; if (imagesResult.error) throw imagesResult.error; render({ site, properties: propertiesResult.data || [], images: imagesResult.data || [] }, supa);
    } catch (error) { $("publicLoading")!.hidden = true; $("publicError")!.hidden = false; $("publicErrorMessage")!.textContent = error instanceof Error ? error.message : "Este catálogo ainda não está disponível."; }
  }
  boot();
</script>

<style>
  :global(body.property-flow-public-page) { margin: 0; background: #080b12; }
  .pf-public { --pf-public-primary: #d8b36a; --pf-public-accent: #a9a0ff; --pf-public-surface: #0c111d; --pf-public-ink: #f7f8fc; min-height: 100vh; color: var(--pf-public-ink); background: radial-gradient(circle at 86% -8%, color-mix(in srgb, var(--pf-public-accent) 18%, transparent), transparent 36rem), radial-gradient(circle at 4% 14%, color-mix(in srgb, var(--pf-public-primary) 11%, transparent), transparent 30rem), #080b12; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  .pf-public__state { display: grid; min-height: 70vh; place-items: center; align-content: center; gap: 14px; padding: 24px; color: rgba(247,248,252,.68); text-align: center; } .pf-public__state[hidden] { display: none; } .pf-public__state a { color: var(--pf-public-primary); font-weight: 800; } .pf-public__spinner { width: 28px; height: 28px; border: 3px solid rgba(255,255,255,.14); border-top-color: var(--pf-public-primary); border-radius: 50%; animation: pf-spin .8s linear infinite; } @keyframes pf-spin { to { transform: rotate(360deg); } }
  .pf-public__header, .pf-public__hero, .pf-public__catalog, .pf-public__footer { width: min(1180px, calc(100% - 40px)); margin-inline: auto; } .pf-public__header { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 26px 0; border-bottom: 1px solid rgba(255,255,255,.08); } .pf-public__brand { display: flex; align-items: center; gap: 12px; color: inherit; text-decoration: none; } .pf-public__mark { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 14px; background: linear-gradient(135deg, var(--pf-public-primary), var(--pf-public-accent)); color: #071119; font-size: 12px; font-weight: 900; } .pf-public__brand strong, .pf-public__brand small { display: block; } .pf-public__brand strong { font-size: 15px; } .pf-public__brand small { margin-top: 3px; color: rgba(247,248,252,.5); font-size: 12px; } .pf-public__template { color: var(--pf-public-primary); font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
