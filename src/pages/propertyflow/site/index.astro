---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const title = "Property Flow";
const description = "Catálogo de imóveis publicado com Property Flow.";
---

<BaseLayout title={title} description={description} hideUtilBar pageClass="property-flow-public-page">
  <main class="pf-public" id="propertyFlowPublic" aria-live="polite">
    <section class="pf-public__state" id="publicLoading"><span class="pf-public__spinner" aria-hidden="true"></span><p>Carregando catálogo…</p></section>
    <section class="pf-public__state" id="publicError" hidden><p id="publicErrorMessage">Este catálogo ainda não está disponível.</p><a href="/products/propertyflow/">Conhecer o Property Flow</a></section>
    <div id="publicSite" hidden>
      <header class="pf-public__header"><a class="pf-public__brand" href="/"><span class="pf-public__mark" id="publicMark">PF</span><span><strong id="publicBrandName">Property Flow</strong><small id="publicBrandTagline">Catálogo de imóveis</small></span></a><span class="pf-public__template" id="publicTemplateLabel"></span></header>
      <section class="pf-public__hero"><div class="pf-public__hero-copy"><span class="pf-public__eyebrow">PROPERTY FLOW</span><h1 id="publicTitle">Encontre o imóvel certo.</h1><p id="publicDescription">Explore imóveis selecionados com clareza, contexto e uma experiência feita para decidir.</p><a class="pf-public__contact" id="publicContact" href="#catalog">Ver imóveis</a></div><div class="pf-public__hero-media" id="publicHeroMedia" role="img" aria-label="Imagem de destaque do catálogo"></div></section>
      <section class="pf-public__catalog" id="catalog"><div class="pf-public__catalog-head"><div><span class="pf-public__eyebrow">CATÁLOGO</span><h2>Imóveis disponíveis</h2></div><span id="publicCount"></span></div><div class="pf-public__filter-bar"><label class="pf-public__search"><span class="sr-only">Buscar imóveis</span><span aria-hidden="true">⌕</span><input id="publicSearch" type="search" placeholder="Buscar imóvel, cidade ou bairro" autocomplete="off" /></label><div class="pf-public__filters" id="publicFilters" role="group" aria-label="Filtrar imóveis"></div></div><div class="pf-public__grid" id="publicGrid"></div></section>
      <footer class="pf-public__footer"><span id="publicFooterBrand">Property Flow</span><span>Powered by VOLYNX</span></footer>
    </div>
  </main>
</BaseLayout>

<script>
  import { createClient } from "@supabase/supabase-js";
  import { propertyFlowTemplate, type PropertyFlowTemplateKey } from "../../../lib/property-flow-templates";

  type Site = { id: string; name: string; slug: string; domain?: string | null; subdomain?: string | null; theme?: Record<string, unknown>; settings?: Record<string, any> };
  type Property = { id: string; title: string; slug: string; category?: string; listing_type?: "sale" | "rent" | "sale_and_rent"; summary?: string; description?: string; price_label?: string; price_amount?: number | null; location?: { label?: string; city?: string; region?: string }; features?: unknown; status: string; is_featured?: boolean; bedrooms?: number; bathrooms?: number; yield?: string; demo_image?: string };
  type Image = { property_id: string; storage_path: string; is_cover: boolean; sort_order: number };
  type PublicData = { site: Site; properties: Property[]; images: Image[] };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const params = new URLSearchParams(window.location.search);
  const preview = import.meta.env.DEV && params.get("preview") === "1";
  const requestedPreviewTemplate = preview ? params.get("template") : null;
  const legacyTemplateAliases: Record<string, PropertyFlowTemplateKey> = { "map-view": "map-first", "tabbed-categories": "grouped", "carousel-hero": "showroom" };
  const demoSite: Site = { id: "demo", name: "Jhonatan Peterson Imóveis", slug: "johnny-parisnez", domain: "www.jhonatanpetersonimoveis.com.br", settings: { image_bucket: "johnny-property-images", property_flow: { template_key: "editorial" }, property_flow_admin: { brand: { name: "Jhonatan Peterson", tagline: "Imóveis com curadoria, estratégia e atendimento premium.", mark: "JP", colors: { primary: "#d8b36a", accent: "#a9a0ff", ink: "#f7f8fc", surface: "#0c111d" } } } } };
  const demoProperties: Property[] = [
    { id: "demo-1", title: "Casa com vista para a serra", slug: "casa-serra", category: "Casa", listing_type: "sale", summary: "Arquitetura, luz e privacidade em uma localização especial.", description: "Um imóvel pensado para viver com calma e receber bem.", price_label: "R$ 1.850.000", location: { label: "Atibaia, SP", city: "Atibaia", region: "SP" }, status: "published", is_featured: true, bedrooms: 4, bathrooms: 3, yield: "4,8%", demo_image: "/propertyflow/demo/casa-serra.webp" },
    { id: "demo-2", title: "Apartamento autoral", slug: "apartamento-autoral", category: "Apartamento", listing_type: "sale", summary: "Linhas contemporâneas e tudo perto.", description: "Um endereço urbano para uma rotina mais simples.", price_label: "R$ 1.280.000", location: { label: "São Paulo, SP", city: "São Paulo", region: "SP" }, status: "published", bedrooms: 3, bathrooms: 2, yield: "5,1%", demo_image: "/propertyflow/demo/apartamento-autoral.webp" },
    { id: "demo-3", title: "Refúgio entre árvores", slug: "refugio-arvores", category: "Chácara", listing_type: "rent", summary: "Espaço, silêncio e natureza para chamar de seu.", description: "Uma propriedade para desacelerar sem ficar distante.", price_label: "R$ 8.500 / mês", location: { label: "Mairiporã, SP", city: "Mairiporã", region: "SP" }, status: "published", bedrooms: 5, bathrooms: 4, yield: "3,9%", demo_image: "/propertyflow/demo/refugio-arvores.webp" },
  ];

  function escapeHtml(value: unknown) { return String(value ?? "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char] || char); }
  function canonicalTemplate(value: unknown): PropertyFlowTemplateKey { return propertyFlowTemplate(value)?.key || legacyTemplateAliases[String(value || "")] || "classic-grid"; }
  function coverFor(propertyId: string, images: Image[]) { return images.filter((image) => image.property_id === propertyId).sort((a, b) => Number(a.sort_order) - Number(b.sort_order)).find((image) => image.is_cover) || images.find((image) => image.property_id === propertyId); }
  function imageUrl(supa: any, bucket: string, image?: Image) { return image ? supa.storage.from(bucket).getPublicUrl(image.storage_path).data.publicUrl : ""; }
  function brandFrom(site: Site) { const brand = site.settings?.property_flow_admin?.brand || {}; return { name: String(brand.name || site.name || "Property Flow"), tagline: String(brand.tagline || "Catálogo de imóveis"), mark: String(brand.mark || site.name?.slice(0, 2) || "PF"), colors: brand.colors || {} }; }
  function render(data: PublicData, supa: any) {
    const site = data.site; const brand = brandFrom(site); const template = canonicalTemplate(requestedPreviewTemplate || site.settings?.property_flow?.template_key); const info = propertyFlowTemplate(template); const bucket = String(site.settings?.image_bucket || "property-flow-images"); const root = $("propertyFlowPublic")!; root.dataset.template = template; root.dataset.preview = String(preview);
    $("publicBrandName")!.textContent = brand.name; $("publicBrandTagline")!.textContent = brand.tagline; $("publicMark")!.textContent = brand.mark; $("publicFooterBrand")!.textContent = brand.name; $("publicTemplateLabel")!.textContent = info?.name || template; $("publicCount")!.textContent = `${data.properties.length} ${data.properties.length === 1 ? "imóvel" : "imóveis"}`;
    const colors = brand.colors as Record<string, string>; for (const [key, fallback] of [["primary", "#d8b36a"], ["accent", "#a9a0ff"], ["surface", "#0c111d"], ["ink", "#f7f8fc"]] as const) root.style.setProperty(`--pf-public-${key}`, /^#[0-9a-f]{6}$/i.test(String(colors[key] || "")) ? colors[key] : fallback);
    const categories = [...new Set(data.properties.map((property) => property.category).filter(Boolean))] as string[]; const filters = $("publicFilters")!; filters.innerHTML = [`<button class="is-active" type="button" data-category="all">Todos</button>`, ...categories.map((category) => `<button type="button" data-category="${escapeHtml(category)}">${escapeHtml(category)}</button>`)].join("");
    const search = $("publicSearch") as HTMLInputElement | null;
    const listingLabel = (value: Property["listing_type"]) => value === "rent" ? "Aluguel" : value === "sale_and_rent" ? "Venda e aluguel" : "Venda";
    const featureNumber = (property: Property, label: string) => { const features = Array.isArray(property.features) ? property.features : []; const match = features.find((feature) => typeof feature === "string" && feature.toLowerCase().includes(label)); const number = typeof match === "string" ? match.match(/\d+/)?.[0] : undefined; return number ? Number(number) : undefined; };
    const propertyMeta = (property: Property) => ({ beds: property.bedrooms ?? featureNumber(property, "quarto") ?? featureNumber(property, "bed"), baths: property.bathrooms ?? featureNumber(property, "banheiro") ?? featureNumber(property, "bath"), location: property.location?.label || [property.location?.city, property.location?.region].filter(Boolean).join(", ") || "Localização sob consulta" });
    const heroProperty = data.properties.find((property) => property.is_featured) || data.properties[0]; const heroImage = heroProperty?.demo_image || imageUrl(supa, bucket, heroProperty ? coverFor(heroProperty.id, data.images) : undefined); const heroMedia = $("publicHeroMedia"); if (heroMedia) { heroMedia.style.backgroundImage = heroImage ? `linear-gradient(180deg,rgba(5,8,14,.04),rgba(5,8,14,.64)),url('${escapeHtml(heroImage)}')` : ""; heroMedia.setAttribute("aria-label", heroProperty ? `Imagem de destaque: ${heroProperty.title}` : "Imagem de destaque do catálogo"); heroMedia.toggleAttribute("hidden", !heroImage); }
    const renderGrid = (category = "all", query = "") => { const normalizedQuery = query.trim().toLocaleLowerCase(); const properties = data.properties.filter((property) => { const searchable = [property.title, property.summary, property.location?.label, property.location?.city, property.location?.region].filter(Boolean).join(" ").toLocaleLowerCase(); return (category === "all" || property.category === category) && (!normalizedQuery || searchable.includes(normalizedQuery)); }); $("publicCount")!.textContent = `${properties.length} ${properties.length === 1 ? "imóvel" : "imóveis"}`; $("publicGrid")!.innerHTML = properties.length ? properties.map((property, index) => { const image = property.demo_image || imageUrl(supa, bucket, coverFor(property.id, data.images)); const meta = propertyMeta(property); const stats = [meta.beds ? `${meta.beds} quartos` : "", meta.baths ? `${meta.baths} banheiros` : "", property.yield ? `yield ${property.yield}` : ""].filter(Boolean).join("  ·  "); const style = image ? ` style="background-image:linear-gradient(180deg,rgba(6,10,18,.08),rgba(6,10,18,.86)),url('${escapeHtml(image)}')"` : ""; return `<article class="pf-public__card" data-property-card style="--card-index:${index}"><div class="pf-public__image" role="img" aria-label="Imagem de ${escapeHtml(property.title)}"${style}><div class="pf-public__image-top"><span>${escapeHtml(property.category || "Imóvel")}</span>${property.is_featured ? `<strong>Em destaque</strong>` : ""}</div><div class="pf-public__image-meta"><small>${escapeHtml(meta.location)}</small><h3>${escapeHtml(property.title)}</h3><div><b>${escapeHtml(property.price_label || "Sob consulta")}</b><span>${escapeHtml(stats || listingLabel(property.listing_type))}</span></div></div>${!image ? `<strong class="pf-public__image-placeholder">${escapeHtml((property.title || "P").slice(0, 1).toUpperCase())}</strong>` : ""}</div><div class="pf-public__card-body"><p>${escapeHtml(property.summary || property.description || "Conheça os detalhes deste imóvel.")}</p><div class="pf-public__card-foot"><span>${escapeHtml(listingLabel(property.listing_type))}</span><a href="#contact">Tenho interesse</a></div></div></article>`; }).join("") : `<div class="pf-public__empty">Nenhum imóvel encontrado nesta busca.</div>`; };
    const rerender = () => renderGrid(filters.querySelector<HTMLButtonElement>("button.is-active")?.dataset.category || "all", search?.value || "");
    renderGrid(); filters.querySelectorAll<HTMLButtonElement>("button").forEach((button) => button.addEventListener("click", () => { filters.querySelectorAll("button").forEach((item) => item.classList.toggle("is-active", item === button)); rerender(); })); search?.addEventListener("input", rerender);
    $("publicLoading")!.hidden = true; $("publicSite")!.hidden = false;
  }
  async function boot() {
    try {
      const cfg = await fetch("/config.json", { cache: "no-store" }).then((response) => response.json()); const supa = createClient(cfg.supabaseUrl, cfg.supabaseAnonKey);
      if (preview) { render({ site: demoSite, properties: demoProperties, images: [] }, supa); return; }
      const target = params.get("site") || window.location.hostname; const resolved = await supa.rpc("get_public_property_flow_site", { p_host: target }); const site = Array.isArray(resolved.data) ? resolved.data[0] : resolved.data; if (resolved.error) throw resolved.error; if (!site) throw new Error("Catálogo não encontrado.");
      const [propertiesResult, imagesResult] = await Promise.all([supa.from("property_listings").select("id,title,slug,category,listing_type,summary,description,price_amount,price_label,location,features,is_featured,status").eq("site_id", site.id).eq("organization_id", site.organization_id).eq("status", "published").order("is_featured", { ascending: false }).order("sort_order", { ascending: true }), supa.from("property_listing_images").select("property_id,storage_path,is_cover,sort_order").eq("site_id", site.id).eq("organization_id", site.organization_id).order("sort_order", { ascending: true })]); if (propertiesResult.error) throw propertiesResult.error; if (imagesResult.error) throw imagesResult.error; render({ site, properties: propertiesResult.data || [], images: imagesResult.data || [] }, supa);
    } catch (error) { $("publicLoading")!.hidden = true; $("publicError")!.hidden = false; $("publicErrorMessage")!.textContent = error instanceof Error ? error.message : "Este catálogo ainda não está disponível."; }
  }
  boot();
</script>

<style>
  :global(body.property-flow-public-page) { margin: 0; background: #080b12; }
  .pf-public { --pf-public-primary: #d8b36a; --pf-public-accent: #a9a0ff; --pf-public-surface: #0c111d; --pf-public-ink: #f7f8fc; min-height: 100vh; color: var(--pf-public-ink); background: radial-gradient(circle at 86% -8%, color-mix(in srgb, var(--pf-public-accent) 18%, transparent), transparent 36rem), radial-gradient(circle at 4% 14%, color-mix(in srgb, var(--pf-public-primary) 11%, transparent), transparent 30rem), #080b12; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  .pf-public__state { display: grid; min-height: 70vh; place-items: center; align-content: center; gap: 14px; padding: 24px; color: rgba(247,248,252,.68); text-align: center; } .pf-public__state[hidden] { display: none; } .pf-public__state a { color: var(--pf-public-primary); font-weight: 800; } .pf-public__spinner { width: 28px; height: 28px; border: 3px solid rgba(255,255,255,.14); border-top-color: var(--pf-public-primary); border-radius: 50%; animation: pf-spin .8s linear infinite; } @keyframes pf-spin { to { transform: rotate(360deg); } }
  .pf-public__header, .pf-public__hero, .pf-public__catalog, .pf-public__footer { width: min(1180px, calc(100% - 40px)); margin-inline: auto; } .pf-public__header { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 26px 0; border-bottom: 1px solid rgba(255,255,255,.08); } .pf-public__brand { display: flex; align-items: center; gap: 12px; color: inherit; text-decoration: none; } .pf-public__mark { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 14px; background: linear-gradient(135deg, var(--pf-public-primary), var(--pf-public-accent)); color: #071119; font-size: 12px; font-weight: 900; } .pf-public__brand strong, .pf-public__brand small { display: block; } .pf-public__brand strong { font-size: 15px; } .pf-public__brand small { margin-top: 3px; color: rgba(247,248,252,.5); font-size: 12px; } .pf-public__template { color: var(--pf-public-primary); font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .pf-public__hero { display: grid; grid-template-columns: minmax(0, .92fr) minmax(320px, .82fr); align-items: center; gap: clamp(34px, 7vw, 96px); padding: clamp(56px, 9vw, 118px) 0 76px; } .pf-public__hero-copy { min-width: 0; } .pf-public__hero h1 { max-width: 780px; margin: 10px 0 18px; font-size: clamp(3rem, 8vw, 7.6rem); line-height: .94; letter-spacing: -.085em; } .pf-public__hero p { max-width: 580px; margin: 0; color: rgba(247,248,252,.6); font-size: clamp(1rem, 1.6vw, 1.3rem); line-height: 1.65; } .pf-public__eyebrow { color: var(--pf-public-primary); font-size: 11px; font-weight: 900; letter-spacing: .18em; text-transform: uppercase; } .pf-public__contact { display: inline-flex; margin-top: 28px; padding: 14px 20px; border-radius: 10px; background: var(--pf-public-primary); color: #071119; font-weight: 900; text-decoration: none; } .pf-public__hero-media { min-height: min(560px, 50vw); border: 1px solid rgba(255,255,255,.14); border-radius: 10px; background-position: center; background-size: cover; box-shadow: 0 28px 90px rgba(0,0,0,.38), 0 0 70px color-mix(in srgb, var(--pf-public-accent) 17%, transparent); } .pf-public__hero-media[hidden] { display: none; }
  .pf-public__catalog { padding-bottom: 72px; } .pf-public__catalog-head { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 18px; } .pf-public__catalog h2 { margin: 8px 0 0; font-size: clamp(2rem, 4vw, 3.6rem); letter-spacing: -.065em; } #publicCount { color: rgba(247,248,252,.48); font-size: 13px; } .pf-public__filter-bar { display: grid; gap: 12px; margin-bottom: 22px; } .pf-public__search { display: flex; align-items: center; gap: 10px; min-height: 46px; padding: 0 14px; border: 1px solid rgba(255,255,255,.12); border-radius: 10px; background: rgba(255,255,255,.04); color: rgba(247,248,252,.6); } .pf-public__search input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--pf-public-ink); font: inherit; } .pf-public__search input::placeholder { color: rgba(247,248,252,.4); } .pf-public__filters { display: flex; flex-wrap: wrap; gap: 8px; } .pf-public__filters button { padding: 10px 15px; border: 1px solid rgba(255,255,255,.12); border-radius: 8px; background: transparent; color: rgba(247,248,252,.62); font: inherit; cursor: pointer; } .pf-public__filters button.is-active, .pf-public__filters button:hover { border-color: color-mix(in srgb, var(--pf-public-primary) 60%, transparent); background: color-mix(in srgb, var(--pf-public-primary) 12%, transparent); color: #fff; }
  .pf-public__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; } .pf-public__card { overflow: hidden; border: 1px solid rgba(255,255,255,.1); border-radius: 10px; background: linear-gradient(145deg, rgba(255,255,255,.08), rgba(255,255,255,.025)); box-shadow: 0 24px 70px rgba(0,0,0,.2); } .pf-public__image { position: relative; display: flex; min-height: 290px; flex-direction: column; justify-content: space-between; background-position: center; background-size: cover; background-color: var(--pf-public-surface); } .pf-public__image-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 14px; } .pf-public__image-top span, .pf-public__image-top strong { padding: 7px 9px; border-radius: 6px; background: rgba(7,10,18,.72); color: var(--pf-public-primary); font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; } .pf-public__image-top strong { color: #071119; background: var(--pf-public-primary); } .pf-public__image-meta { margin: 14px; padding: 14px; border: 1px solid rgba(255,255,255,.15); border-radius: 10px; background: rgba(0,0,0,.56); backdrop-filter: blur(14px); } .pf-public__image-meta small { color: rgba(247,248,252,.7); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; } .pf-public__image-meta h3 { margin: 7px 0 12px; font-size: 1.2rem; letter-spacing: -.035em; } .pf-public__image-meta > div { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: rgba(247,248,252,.74); font-size: 12px; } .pf-public__image-meta b { color: var(--pf-public-ink); } .pf-public__image-placeholder { align-self: center; color: rgba(255,255,255,.14); font-size: 6rem; } .pf-public__card-body { display: grid; gap: 18px; padding: 18px; } .pf-public__card-body p { min-height: 44px; margin: 0; color: rgba(247,248,252,.55); font-size: 13px; line-height: 1.55; } .pf-public__card-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; border-top: 1px solid rgba(255,255,255,.08); padding-top: 15px; } .pf-public__card-foot span { color: var(--pf-public-primary); font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; } .pf-public__card-foot a { color: var(--pf-public-ink); font-size: 12px; font-weight: 800; text-decoration: none; } .pf-public__empty { grid-column: 1 / -1; padding: 60px 20px; border: 1px dashed rgba(255,255,255,.16); border-radius: 10px; color: rgba(247,248,252,.54); text-align: center; }
  /* Runtime-rendered catalog nodes do not receive Astro's scoped attribute. */
  :global(.pf-public__filters button) { padding: 10px 15px; border: 1px solid rgba(255,255,255,.12); border-radius: 999px; background: transparent; color: rgba(247,248,252,.62); font: inherit; cursor: pointer; }
  :global(.pf-public__filters button.is-active), :global(.pf-public__filters button:hover) { border-color: color-mix(in srgb, var(--pf-public-primary) 60%, transparent); background: color-mix(in srgb, var(--pf-public-primary) 12%, transparent); color: #fff; }
  :global(.pf-public__card) { overflow: hidden; border: 1px solid rgba(255,255,255,.1); border-radius: 24px; background: linear-gradient(145deg, rgba(255,255,255,.08), rgba(255,255,255,.025)); box-shadow: 0 24px 70px rgba(0,0,0,.2); }
  :global(.pf-public__image) { position: relative; display: grid; min-height: 260px; place-items: center; background-position: center; background-size: cover; background-color: var(--pf-public-surface); }
  :global(.pf-public__image > span) { position: absolute; top: 14px; left: 14px; padding: 7px 9px; border-radius: 999px; background: rgba(7,10,18,.7); color: var(--pf-public-primary); font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  :global(.pf-public__image > strong) { color: rgba(255,255,255,.14); font-size: 6rem; }
  :global(.pf-public__card-body) { display: grid; gap: 18px; min-width: 0; padding: 20px; }
  :global(.pf-public__card-body small) { color: var(--pf-public-primary); font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  :global(.pf-public__card-body h3) { margin: 8px 0 0; font-size: 1.35rem; line-height: 1.15; letter-spacing: -.04em; overflow-wrap: anywhere; }
  :global(.pf-public__card-body p) { min-height: 44px; margin: 10px 0 0; color: rgba(247,248,252,.55); font-size: 13px; line-height: 1.55; overflow-wrap: anywhere; }
  :global(.pf-public__card-foot) { display: flex; align-items: center; justify-content: space-between; gap: 10px; border-top: 1px solid rgba(255,255,255,.08); padding-top: 15px; }
  :global(.pf-public__card-foot strong) { color: var(--pf-public-primary); font-size: 13px; }
