  async function ensureWorkspace(user: any): Promise<Site[]> {
    const existing = await state.supa.from("sites").select("id,organization_id,name,slug,status,template_key,domain,subdomain,theme,settings,published_at").eq("template_key", "property-flow").order("created_at", { ascending: true });
