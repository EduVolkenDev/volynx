    const existing = imagesFor(property.id); const bucket = siteBucket();
    for (let index = 0; index < files.length; index += 1) {
      const optimized = await optimizePropertyFlowImage(files.item(index)!); if (!optimized.contentHash) throw new Error("Não foi possível criar o hash da foto neste navegador.");
      const path = buildPropertyFlowImagePath({ organizationId: property.organization_id, siteId: property.site_id, propertyId: property.id, contentHash: optimized.contentHash });
      const upload = await state.supa.storage.from(bucket).upload(path, optimized.file, { contentType: optimized.mimeType, cacheControl: "31536000", upsert: true });
      if (upload.error) throw upload.error;
      const row = await state.supa.from("property_listing_images").upsert({ property_id: property.id, organization_id: property.organization_id, site_id: property.site_id, storage_path: path, filename: optimized.filename, alt_text: property.title, mime_type: optimized.mimeType, size_bytes: optimized.sizeBytes, width: optimized.width, height: optimized.height, source_bytes: optimized.sourceBytes, optimized_at: new Date().toISOString(), content_hash: optimized.contentHash, sort_order: existing.length + index, is_cover: existing.length === 0 && index === 0 }).select("id,property_id,storage_path,is_cover,sort_order,size_bytes,width,height").single();
      if (row.error) throw row.error; state.images.push(row.data as ImageRow);
    }
  }

