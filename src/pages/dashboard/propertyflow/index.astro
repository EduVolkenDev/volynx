      state.user = userResult.data.user; $("accountEmail")!.textContent = state.user.email || "Conta"; $("accountInitial")!.textContent = (state.user.email || "V").slice(0, 1).toUpperCase(); state.sites = await ensureWorkspace(state.user); const requestedSiteId = new URLSearchParams(window.location.search).get("site"); state.site = state.sites.find((site) => site.id === requestedSiteId) || state.sites[0];
