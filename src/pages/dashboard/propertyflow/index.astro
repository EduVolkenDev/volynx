    const provisioned = await state.supa.rpc("provision_property_flow_workspace", { p_user_id: user.id });
    if (provisioned.error) throw provisioned.error;
    const workspace = provisioned.data && typeof provisioned.data === "object" ? provisioned.data as Record<string, any> : null;
    if (!workspace?.site_id) throw new Error("Não foi possível preparar seu workspace Property Flow.");
    const recovered = await state.supa.from("sites").select("id,organization_id,name,slug,status,template_key,domain,subdomain,theme,settings,published_at").eq("id", workspace.site_id).single();
