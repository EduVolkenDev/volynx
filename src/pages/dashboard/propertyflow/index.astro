---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const title = "Property Flow Studio";
const previewMode = false;
---

<BaseLayout title={title} description="Painel de gestão e personalização de imóveis" hideUtilBar>
  <main class="pf-studio" id="propertyFlowStudio" data-preview-mode={previewMode ? "true" : "false"}>
    <section class="pf-state" id="loadingState" aria-live="polite">
      <span class="pf-spinner" aria-hidden="true"></span>
      <p>Carregando seu painel…</p>
    </section>

    <section class="pf-state" id="loggedOutState" hidden>
      <span class="pf-state__eyebrow">PROPERTY FLOW STUDIO</span>
      <h1>Entre para gerenciar sua vitrine.</h1>
      <p>Seu painel de gestão é privado e separado do site público.</p>
      <a class="pf-button pf-button--primary" href="/login/?next=/dashboard/propertyflow/">Entrar no VOLYNX</a>
      {import.meta.env.DEV && <a class="pf-button pf-button--ghost" href="/dashboard/propertyflow/?preview=1">Ver prévia local (somente leitura)</a>}
    </section>

    <section class="pf-state" id="errorState" hidden>
      <span class="pf-state__eyebrow">PROPERTY FLOW STUDIO</span>
      <h1>Não conseguimos abrir este painel.</h1>
      <p id="errorMessage">Tente atualizar a página.</p>
      <button class="pf-button pf-button--ghost" id="retryButton" type="button">Tentar novamente</button>
    </section>

    <div id="appShell" hidden>
      <aside class="pf-sidebar" id="sidebar">
        <div class="pf-sidebar__top">
          <a class="pf-brand" href="/dashboard/propertyflow/" aria-label="Voltar para o início do Property Flow">
            <span class="pf-brand__mark" id="brandMark">PF</span>
            <span>
              <strong id="brandName">Property Flow</strong>
              <small id="brandTagline">Seu catálogo, sob seu controle.</small>
            </span>
          </a>
          <button class="pf-sidebar__close" id="closeSidebar" type="button" aria-label="Fechar menu">×</button>
        </div>

        <label class="pf-site-picker">
          <span>Site</span>
          <select id="siteSelect" aria-label="Selecionar site"></select>
        </label>

        <nav class="pf-nav" id="mainNav" aria-label="Navegação do painel">
          <button type="button" class="is-active" data-view="overview" aria-current="page"><span class="pf-nav__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 13h6V4H4v9Zm10 7h6v-9h-6v9ZM4 20h6v-3H4v3Zm10-12h6V4h-6v4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span><b data-nav-label="overview">Visão geral</b></button>
          <button type="button" data-view="properties"><span class="pf-nav__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V10Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 21v-6h6v6" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span><b data-nav-label="properties">Imóveis</b></button>
          <button type="button" data-view="appearance"><span class="pf-nav__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m14.5 4.5 5 5M5 19l2.2-.5L18.8 6.9a1.8 1.8 0 0 0-2.5-2.5L4.7 16.9 4 20l3-.7Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 4h5M4 8h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span><b data-nav-label="appearance">Identidade</b></button>
          <button type="button" data-view="modules"><span class="pf-nav__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="9" cy="7" r="2" fill="var(--pf-surface)" stroke="currentColor" stroke-width="1.8"/><circle cx="15" cy="17" r="2" fill="var(--pf-surface)" stroke="currentColor" stroke-width="1.8"/></svg></span><b data-nav-label="modules">Preferências</b></button>
        </nav>

        <div class="pf-sidebar__bottom">
          <div class="pf-account"><span id="accountInitial">V</span><span><strong id="accountEmail">Conta</strong><small id="accountRole">Administrador</small></span></div>
          <button class="pf-logout" id="logoutButton" type="button">Sair</button>
        </div>
      </aside>

      <div class="pf-overlay" id="sidebarOverlay" hidden></div>

      <section class="pf-main">
        <header class="pf-topbar">
          <button class="pf-menu-button" id="openSidebar" type="button" aria-label="Abrir menu">☰</button>
          <div><span class="pf-topbar__kicker">PAINEL PROPERTY FLOW</span><strong id="siteHeading">Seu site</strong></div>
          <div class="pf-topbar__actions"><span class="pf-save-status" id="saveStatus" aria-live="polite"></span><button class="pf-button pf-button--ghost pf-language-toggle" id="languageToggle" type="button" aria-label="Mudar idioma">EN</button><a class="pf-button pf-button--ghost" id="previewLink" href="/propertyflow/" target="_blank" rel="noreferrer">Ver site ↗</a></div>
        </header>

        <div class="pf-preview-banner" id="previewBanner" role="status" hidden><strong>PRÉVIA</strong><span>Conteúdo demonstrativo · alterações desativadas nesta visualização.</span></div>

        <div class="pf-content">
          <section class="pf-view is-visible" id="view-overview" data-view-panel="overview">
            <div class="pf-view-head"><div><span class="pf-eyebrow">CENTRO DE CONTROLE</span><h1 id="overviewTitle">Sua vitrine em movimento.</h1><p>Publique, organize e apresente seus imóveis com a identidade da sua marca.</p></div><button class="pf-button pf-button--primary" data-open-property type="button">+ <span data-label="newProperty">Novo imóvel</span></button></div>
            <div class="pf-metrics" id="metrics"></div>
            <div class="pf-overview-grid"><article class="pf-card"><div class="pf-card__head"><div><span class="pf-eyebrow">ATIVIDADE</span><h2>Últimos imóveis</h2></div><button class="pf-link" data-show-view="properties" type="button">Ver todos</button></div><div id="recentProperties" class="pf-list"></div></article><article class="pf-card pf-card--accent"><span class="pf-eyebrow">IDENTIDADE</span><h2 id="identityPreviewTitle">Seu painel, sua presença.</h2><p>Escolha as cores, o logo e os textos que representam o seu negócio.</p><button class="pf-button pf-button--light" data-show-view="appearance" type="button">Personalizar painel</button></article></div>
            <article class="pf-card pf-setup-card"><div class="pf-card__head"><div><span class="pf-eyebrow" id="setupEyebrow">PRÓXIMOS PASSOS</span><h2 id="setupTitle">Deixe o site pronto para publicar</h2><p id="setupDescription">O painel acompanha o que já foi configurado e mostra o próximo passo mais simples.</p></div><a class="pf-link" id="setupGuide" href="/docs/#propertyflow" target="_blank" rel="noreferrer">Ver guia de conexão</a></div><div class="pf-setup-list" id="setupChecklist"></div></article>
            <article class="pf-card pf-publication-card">
              <div class="pf-card__head">
                <div><span class="pf-eyebrow" id="publicationEyebrow">PUBLICAÇÃO</span><h2 id="publicationTitle">Escolha onde seu site vai morar</h2><p id="publicationDescription">Comece com um endereço VOLYNX gratuito ou conecte um domínio que você já possui.</p></div>
                <span class="pf-publication-status" id="publicationStatus">Ainda não configurado</span>
              </div>
              <div class="pf-publication-options" role="radiogroup" aria-label="Modo de publicação">
                <label class="pf-publication-option"><input type="radio" name="publicationMode" value="volynx-subdomain" /><span><strong id="publicationSubdomainTitle">Criar um endereço VOLYNX</strong><small id="publicationSubdomainDescription">Ex.: sua-imobiliaria.volynx.world. Não precisa comprar domínio agora.</small></span></label>
                <label class="pf-publication-option"><input type="radio" name="publicationMode" value="custom-domain" /><span><strong id="publicationCustomTitle">Usar meu domínio próprio</strong><small id="publicationCustomDescription">Você informa o domínio; o painel orienta o apontamento DNS.</small></span></label>
                <label class="pf-publication-option"><input type="radio" name="publicationMode" value="existing-site" /><span><strong id="publicationExistingTitle">Conectar ao meu site atual</strong><small id="publicationExistingDescription">Seu catálogo ganha um endereço seguro e um botão pronto para usar no site que você já tem.</small></span></label>
              </div>
              <div class="pf-publication-fields">
                <label class="pf-field" id="subdomainField"><span id="subdomainLabel">Nome do endereço</span><div class="pf-input-suffix"><input id="subdomainInput" maxlength="48" inputmode="lowercase" placeholder="sua-imobiliaria" /><strong>.volynx.world</strong></div><small id="subdomainHint">Use letras, números e hífen. O endereço só fica público depois da publicação.</small></label>
                <label class="pf-field" id="customDomainField" hidden><span id="customDomainLabel">Domínio próprio</span><input id="customDomainInput" inputmode="url" placeholder="www.suaempresa.com.br" /><small id="customDomainHint">Não vamos alterar seu DNS automaticamente. O painel mostrará exatamente o próximo passo.</small></label>
                <div class="pf-publication-existing" id="existingSiteHint" hidden>
                  <div><strong id="existingSiteHintTitle">Conexão universal, sem mexer no seu site</strong><p id="existingSiteHintDescription">Publicamos o catálogo separadamente e geramos um link e um botão. Você pode colá-los no menu ou em qualquer construtor de sites.</p></div>
                  <label class="pf-field"><span id="existingSiteUrlLabel">Endereço do seu site atual</span><input id="existingSiteUrlInput" inputmode="url" placeholder="https://www.suaempresa.com.br" /><small id="existingSiteUrlHint">Usamos este endereço apenas para orientar a integração.</small></label>
                  <label class="pf-field"><span id="existingSubdomainLabel">Endereço do seu catálogo</span><div class="pf-input-suffix"><input id="existingSubdomainInput" maxlength="48" inputmode="lowercase" placeholder="sua-imobiliaria" /><strong>.volynx.world</strong></div><small id="existingSubdomainHint">O catálogo fica independente, seguro e pronto para receber seus imóveis.</small></label>
                  <div class="pf-integration-kit" id="integrationKit" hidden>
                    <div class="pf-integration-kit__head"><div><span class="pf-eyebrow" id="integrationKitEyebrow">KIT DE CONEXÃO</span><h3 id="integrationKitTitle">Tudo pronto para ligar ao seu site</h3></div><span class="pf-integration-badge" id="integrationKitBadge">FUNCIONA EM QUALQUER SITE</span></div>
                    <p id="integrationKitDescription">Use o link no menu do seu site ou cole o botão em um bloco HTML. Seus imóveis continuam sendo gerenciados somente aqui.</p>
                    <div class="pf-copy-row"><label class="pf-field"><span id="integrationLinkLabel">Link do catálogo</span><input id="integrationLinkOutput" readonly /></label><button class="pf-button pf-button--ghost" id="copyIntegrationLink" type="button">Copiar link</button></div>
                    <div class="pf-copy-row"><label class="pf-field"><span id="integrationButtonLabel">Botão pronto para site</span><textarea id="integrationButtonOutput" rows="3" readonly></textarea></label><button class="pf-button pf-button--ghost" id="copyIntegrationButton" type="button">Copiar botão</button></div>
                    <p class="pf-integration-note" id="integrationEmbedNote"><strong>Quer incorporar o catálogo na página?</strong> Essa opção depende da plataforma permitir conteúdo externo. Primeiro conecte pelo botão; depois o painel pode verificar uma incorporação compatível sem arriscar seu site.</p>
                  </div>
                </div>
              </div>
              <div class="pf-publication-actions"><span class="pf-save-status" id="publicationSaveStatus" aria-live="polite"></span><a class="pf-link" id="publicationPreviewLink" href="#" target="_blank" rel="noreferrer" hidden>Ver endereço</a><button class="pf-button pf-button--primary" id="savePublicationButton" type="button">Salvar publicação</button></div>
            </article>
          </section>

          <section class="pf-view" id="view-properties" data-view-panel="properties">
            <div class="pf-view-head"><div><span class="pf-eyebrow">CATÁLOGO</span><h1>Imóveis</h1><p>Atualize seus imóveis sem alterar o visual do seu site.</p></div><button class="pf-button pf-button--primary" data-open-property type="button">+ <span data-label="newProperty">Novo imóvel</span></button></div>
            <div class="pf-toolbar"><div class="pf-filter" role="group" aria-label="Filtrar imóveis"><button class="is-active" data-filter="all" type="button">Todos</button><button data-filter="published" type="button">Publicados</button><button data-filter="draft" type="button">Rascunhos</button><button data-filter="archived" type="button">Arquivados</button></div><label class="pf-search"><span class="pf-visually-hidden" id="propertySearchLabel">Buscar imóveis</span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><input id="propertySearch" type="search" autocomplete="off" /></label><span class="pf-toolbar__count" id="propertyCount"></span></div>
            <div class="pf-property-grid" id="propertyGrid"></div>
          </section>

          <section class="pf-view" id="view-appearance" data-view-panel="appearance">
            <div class="pf-view-head"><div><span class="pf-eyebrow">PERSONALIZAÇÃO</span><h1>Identidade do painel</h1><p>Personalize o painel para que ele tenha a cara da sua marca.</p></div><button class="pf-button pf-button--primary" form="appearanceForm" type="submit">Salvar identidade</button></div>
            <form class="pf-settings-grid" id="appearanceForm">
              <article class="pf-card pf-form-card"><div class="pf-card__head"><div><span class="pf-eyebrow">MARCA</span><h2>Nome e presença</h2></div></div><div class="pf-form-grid"><label class="pf-field pf-field--wide"><span>Nome da marca</span><input name="brandName" maxlength="80" required /></label><label class="pf-field pf-field--wide"><span>Frase de apoio</span><input name="tagline" maxlength="120" /></label><label class="pf-field pf-field--wide"><span>Logo</span><input name="logoFile" type="file" accept="image/jpeg,image/png,image/webp" /><small id="logoUploadHint">Envie JPG, PNG ou WebP. A logo será otimizada automaticamente.</small></label><label class="pf-field pf-field--wide"><span>URL alternativa da logo</span><input name="logoUrl" type="url" placeholder="https://…" /></label><label class="pf-field"><span>Monograma</span><input name="mark" maxlength="4" /></label><label class="pf-field"><span>Arredondamento</span><select name="radius"><option value="soft">Suave</option><option value="rounded">Arredondado</option><option value="sharp">Editorial</option></select></label></div></article>
              <article class="pf-card pf-form-card pf-visual-system-card"><div class="pf-card__head"><div><span class="pf-eyebrow">APARÊNCIA</span><h2>Cores do seu site</h2><p>Escolha cada cor pelo que ela faz. A prévia muda na hora, antes de salvar.</p></div></div><div class="pf-color-grid"><label class="pf-color-field"><span class="pf-color-field__label">Cor principal</span><small>Botões e chamadas importantes.</small><span class="pf-color-picker"><input name="primary" type="color" aria-label="Cor principal" /><output id="primaryValue"></output></span></label><label class="pf-color-field"><span class="pf-color-field__label">Cor de destaque</span><small>Detalhes, selos e elementos secundários.</small><span class="pf-color-picker"><input name="accent" type="color" aria-label="Cor de destaque" /><output id="accentValue"></output></span></label><label class="pf-color-field"><span class="pf-color-field__label">Cor do texto</span><small>Textos sobre o fundo principal.</small><span class="pf-color-picker"><input name="ink" type="color" aria-label="Cor do texto" /><output id="inkValue"></output></span></label><label class="pf-color-field"><span class="pf-color-field__label">Cor de fundo</span><small>Base visual de todo o site.</small><span class="pf-color-picker"><input name="surface" type="color" aria-label="Cor de fundo" /><output id="surfaceValue"></output></span></label></div><section class="pf-brand-preview" id="brandPreview" aria-label="Prévia ao vivo do seu site"><div class="pf-brand-preview__top"><div class="pf-brand-preview__identity"><span class="pf-brand-preview__logo"><img id="miniPreviewLogo" alt="" hidden /><b id="miniPreviewMark">PF</b></span><span><strong id="miniPreviewName">Property Flow</strong><small id="miniPreviewTagline">Seu catálogo</small></span></div><span class="pf-brand-preview__menu">Imóveis&nbsp;&nbsp;&nbsp; Sobre</span></div><div class="pf-brand-preview__hero"><span>IMÓVEIS EM DESTAQUE</span><h3>Uma vitrine com a sua identidade.</h3><p>Veja como as suas escolhas ficam em um site real.</p><button type="button" tabindex="-1">Ver imóveis</button></div><div class="pf-brand-preview__listing"><span></span><div><small>DESTAQUE</small><strong>Casa com vista para a serra</strong><p>Atibaia, SP · Sob consulta</p></div></div></section></article>
              <article class="pf-card pf-form-card pf-template-card"><div class="pf-card__head"><div><span class="pf-eyebrow">TEMPLATES</span><h2>Escolha a estrutura do seu site</h2><p id="templateAccessCopy">Carregando os templates disponíveis para sua compra.</p></div><span class="pf-tier-badge" id="templateTierBadge">Tier não identificado</span></div><div class="pf-template-grid" id="templateGrid"></div><small class="pf-template-note" id="templateNote">Os imóveis, fotos e informações permanecem os mesmos quando você troca o template.</small></article>
            </form>
          </section>

          <section class="pf-view" id="view-modules" data-view-panel="modules">
            <div class="pf-view-head"><div><span class="pf-eyebrow">PREFERÊNCIAS</span><h1>Preferências do painel</h1><p>Escolha o que sua equipe vê e quais informações devem ser preenchidas em cada imóvel.</p></div><button class="pf-button pf-button--primary" form="modulesForm" type="submit">Salvar preferências</button></div>
            <form class="pf-settings-grid" id="modulesForm"><article class="pf-card pf-form-card"><div class="pf-card__head"><div><span class="pf-eyebrow">NAVEGAÇÃO</span><h2>Itens do painel</h2></div></div><div class="pf-toggle-list"><label><input type="checkbox" name="moduleOverview" /><span><strong>Visão geral</strong><small>Indicadores e atividade recente.</small></span></label><label><input type="checkbox" name="moduleProperties" /><span><strong>Imóveis</strong><small>Catálogo, publicação e arquivo.</small></span></label><label><input type="checkbox" name="moduleAppearance" /><span><strong>Identidade</strong><small>Cores, logo e linguagem da marca.</small></span></label><label><input type="checkbox" name="moduleModules" /><span><strong>Preferências</strong><small>Ajustes do painel e dos imóveis.</small></span></label></div></article><article class="pf-card pf-form-card"><div class="pf-card__head"><div><span class="pf-eyebrow">FORMULÁRIO</span><h2>Campos dos imóveis</h2></div></div><div class="pf-toggle-list" id="fieldConfigList"><label data-config-field="category"><input type="checkbox" name="fieldCategory" /><span><strong>Categoria</strong><small>Casa, apartamento, fazenda…</small></span><em><input type="checkbox" name="requiredCategory" /> obrigatório</em></label><label data-config-field="price"><input type="checkbox" name="fieldPrice" /><span><strong>Preço</strong><small>Valor ou texto comercial.</small></span><em><input type="checkbox" name="requiredPrice" /> obrigatório</em></label><label data-config-field="location"><input type="checkbox" name="fieldLocation" /><span><strong>Localização</strong><small>Cidade e região de exibição.</small></span><em><input type="checkbox" name="requiredLocation" /> obrigatório</em></label><label data-config-field="summary"><input type="checkbox" name="fieldSummary" /><span><strong>Resumo</strong><small>Texto curto para cards.</small></span><em><input type="checkbox" name="requiredSummary" /> obrigatório</em></label><label data-config-field="description"><input type="checkbox" name="fieldDescription" /><span><strong>Descrição</strong><small>Detalhes completos do imóvel.</small></span><em><input type="checkbox" name="requiredDescription" /> obrigatório</em></label><label data-config-field="whatsapp"><input type="checkbox" name="fieldWhatsapp" /><span><strong>WhatsApp</strong><small>Mensagem pronta para contato.</small></span><em><input type="checkbox" name="requiredWhatsapp" /> obrigatório</em></label></div></article></form>
          </section>
        </div>
      </section>
    </div>

    <dialog class="pf-dialog" id="propertyDialog"><form method="dialog" id="propertyForm"><div class="pf-dialog__head"><div><span class="pf-eyebrow">CATÁLOGO</span><h2 id="propertyDialogTitle">Novo imóvel</h2></div><button class="pf-dialog__close" value="cancel" aria-label="Fechar">×</button></div><div class="pf-dialog__body"><div class="pf-form-grid"><label class="pf-field pf-field--wide"><span>Título do imóvel</span><input name="title" required maxlength="120" placeholder="Ex.: Casa com vista para a serra" /></label><label class="pf-field" data-property-field="category"><span>Categoria</span><input name="category" placeholder="Casa" /></label><label class="pf-field" data-property-field="price"><span>Preço ou chamada</span><input name="priceLabel" placeholder="Sob consulta" /></label><label class="pf-field pf-field--wide" data-property-field="location"><span>Localização exibida</span><input name="location" placeholder="Atibaia, SP" /></label><label class="pf-field pf-field--wide" data-property-field="summary"><span>Resumo</span><textarea name="summary" rows="2" maxlength="240" placeholder="Uma frase que abre o desejo."></textarea></label><label class="pf-field pf-field--wide" data-property-field="description"><span>Descrição</span><textarea name="description" rows="5" placeholder="Conte a história e os diferenciais do imóvel."></textarea></label><label class="pf-field pf-field--wide" data-property-field="whatsapp"><span>Mensagem de WhatsApp</span><input name="whatsapp" placeholder="Olá, gostaria de saber mais sobre…" /></label><label class="pf-field pf-field--wide"><span>Fotos</span><input name="images" type="file" accept="image/jpeg,image/png,image/webp,image/avif" multiple /><small>Convertidas para WebP automaticamente, até 3 MB por foto.</small></label></div></div><div class="pf-dialog__foot"><span class="pf-save-status" id="propertyStatus" aria-live="polite"></span><button class="pf-button pf-button--ghost" value="cancel">Cancelar</button><button class="pf-button pf-button--primary" type="submit" data-save-property="draft">Salvar rascunho</button><button class="pf-button pf-button--light" type="button" id="saveAndPublish">Salvar e publicar</button></div></form></dialog>
  </main>
</BaseLayout>

<script>
  import { createClient } from "@supabase/supabase-js";
  import { optimizePropertyFlowLogo } from "../../../lib/property-flow-brand";
  import { buildPropertyFlowImagePath, optimizePropertyFlowImage } from "../../../lib/property-flow-images";
  import { DEFAULT_PROPERTY_FLOW_ADMIN_CONFIG, getPropertyFlowAdminConfig, configForSitePersistence, type PropertyFlowAdminConfig } from "../../../lib/property-flow-config";
  import { PROPERTY_FLOW_TRANSLATIONS, propertyFlowLanguage, type PropertyFlowLanguage, type PropertyFlowTranslationKey } from "../../../lib/property-flow-i18n";
  import { propertyFlowDomainUrl, propertyFlowIntegrationButtonHtml, propertyFlowPublicationFromSettings, propertyFlowSubdomainUrl, normalizePropertyFlowDomain, normalizePropertyFlowSubdomain, normalizePropertyFlowWebsiteUrl, isPropertyFlowCustomDomainFormat, isPropertyFlowSubdomainAvailableFormat, type PropertyFlowPublicationMode } from "../../../lib/property-flow-publication";
  import { PROPERTY_FLOW_TEMPLATES, PROPERTY_FLOW_TIERS, propertyFlowTemplate, propertyFlowTemplateAllowed, propertyFlowTier, type PropertyFlowTemplateKey, type PropertyFlowTier } from "../../../lib/property-flow-templates";

  type Site = { id: string; organization_id: string; name: string; slug: string; status: string; template_key?: string | null; domain?: string | null; subdomain?: string | null; theme?: Record<string, unknown>; settings?: Record<string, unknown>; published_at?: string | null };
  type Property = { id: string; site_id: string; organization_id: string; title: string; slug: string; category?: string; status: string; summary?: string; description?: string; price_label?: string; location?: { label?: string }; whatsapp_message?: string; created_at?: string; published_at?: string; archived_at?: string };
  type ImageRow = { id: string; property_id: string; storage_path: string; is_cover: boolean; sort_order: number; size_bytes?: number; width?: number; height?: number };
  type PropertyFlowAccess = { tier: PropertyFlowTier; template_count: number; source: string };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const studio = $("propertyFlowStudio")!;
  const previewParams = new URLSearchParams(window.location.search);
  const previewMode = import.meta.env.DEV && previewParams.get("preview") === "1";
  const previewExistingSite = previewMode && previewParams.get("flow") === "existing-site";
  const JOHNNY_PREVIEW_SITE: Site = {
