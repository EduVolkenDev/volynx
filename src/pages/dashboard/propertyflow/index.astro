  .pf-studio[data-radius="soft"] { --pf-radius: 14px; } .pf-studio[data-radius="rounded"] { --pf-radius: 24px; } .pf-studio[data-radius="sharp"] { --pf-radius: 5px; }
  .pf-state { min-height: 100vh; display: grid; place-content: center; justify-items: center; gap: 12px; padding: 30px; text-align: center; } .pf-state h1 { max-width: 620px; margin: 0; font-size: clamp(2.4rem, 6vw, 5rem); line-height: .98; letter-spacing: -.06em; } .pf-state p { max-width: 520px; margin: 0 0 18px; color: rgba(240,244,255,.6); line-height: 1.6; } .pf-state__eyebrow, .pf-eyebrow, .pf-topbar__kicker { color: var(--pf-primary); font-size: 10px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; } .pf-spinner { width: 26px; height: 26px; border: 2px solid rgba(255,255,255,.16); border-top-color: var(--pf-primary); border-radius: 50%; animation: pf-spin .8s linear infinite; } @keyframes pf-spin { to { transform: rotate(360deg); } }
  #appShell { min-height: 100vh; } .pf-sidebar { position: fixed; inset: 0 auto 0 0; z-index: 20; display: flex; width: 272px; flex-direction: column; gap: 30px; padding: 26px 18px 18px; border-right: 1px solid rgba(255,255,255,.08); background: color-mix(in srgb, var(--pf-surface) 91%, #05070b); } .pf-sidebar__top { display: flex; align-items: flex-start; justify-content: space-between; } .pf-brand { display: flex; align-items: center; gap: 11px; color: var(--pf-ink); text-decoration: none; } .pf-brand__mark { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 13px; background: linear-gradient(135deg, var(--pf-primary), var(--pf-accent)); color: #071119; font-weight: 900; font-size: 12px; letter-spacing: -.04em; } .pf-brand strong, .pf-account strong { display: block; color: #fff; font-size: 14px; letter-spacing: -.02em; } .pf-brand small, .pf-account small { display: block; max-width: 158px; overflow: hidden; color: rgba(221,228,244,.5); font-size: 11px; text-overflow: ellipsis; white-space: nowrap; } .pf-sidebar__close, .pf-menu-button { display: none; border: 0; background: transparent; color: rgba(255,255,255,.75); font-size: 25px; cursor: pointer; }
