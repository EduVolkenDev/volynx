---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ROUTES } from "../../data/routes";

const title = "Dashboard — VOLYNX";
---

<BaseLayout title={title} description="Gerencie seus produtos e workspaces VOLYNX em um só lugar." hideUtilBar>
  <main class="vx-dashboard" id="volynxDashboard">
    <section class="vx-dashboard__state" id="dashboardLoading" aria-live="polite">
      <span class="vx-dashboard__spinner" aria-hidden="true"></span>
      <p>Carregando seu dashboard…</p>
    </section>

    <section class="vx-dashboard__state" id="dashboardLoggedOut" hidden>
      <span class="vx-dashboard__eyebrow">VOLYNX DASHBOARD</span>
      <h1>Seu trabalho, em um só lugar.</h1>
      <p>Entre para acessar os produtos, workspaces e ferramentas disponíveis na sua conta.</p>
      <a class="vx-button vx-button--primary" href={`${ROUTES.login}?next=${ROUTES.dashboard}`}>Entrar ou criar conta</a>
    </section>

    <section class="vx-dashboard__state" id="dashboardError" hidden>
      <span class="vx-dashboard__eyebrow">VOLYNX DASHBOARD</span>
      <h1>Não conseguimos carregar seus dados.</h1>
      <p id="dashboardErrorMessage">Atualize a página e tente novamente.</p>
      <button class="vx-button vx-button--ghost" id="dashboardRetry" type="button">Tentar novamente</button>
    </section>

    <div class="vx-dashboard__app" id="dashboardApp" hidden>
      <aside class="vx-dashboard__sidebar" id="dashboardSidebar">
        <div class="vx-dashboard__brand-row">
          <a class="vx-dashboard__brand" href={ROUTES.dashboard} aria-label="Ir para o início do dashboard VOLYNX">
            <span class="vx-dashboard__brand-mark" aria-hidden="true">V</span>
            <span><strong>VOLYNX</strong><small>Command dashboard</small></span>
          </a>
          <button class="vx-dashboard__close" id="dashboardClose" type="button" aria-label="Fechar menu">×</button>
        </div>

        <nav class="vx-dashboard__nav" aria-label="Navegação principal">
          <a class="is-active" aria-current="page" href={ROUTES.dashboard}><span class="vx-icon" aria-hidden="true" data-icon="grid"></span><b>Visão geral</b></a>
          <a href={ROUTES.delivery}><span class="vx-icon" aria-hidden="true" data-icon="box"></span><b>Meus produtos</b></a>
          <a href={ROUTES.profile}><span class="vx-icon" aria-hidden="true" data-icon="user"></span><b>Minha conta</b></a>
          <a href={ROUTES.support}><span class="vx-icon" aria-hidden="true" data-icon="help"></span><b>Suporte</b></a>
        </nav>

        <div class="vx-dashboard__sidebar-bottom">
          <div class="vx-dashboard__account"><span id="dashboardInitial">V</span><span><strong id="dashboardEmail">Conta</strong><small id="dashboardPlan">Conta VOLYNX</small></span></div>
          <button class="vx-dashboard__logout" id="dashboardLogout" type="button">Sair da conta</button>
        </div>
      </aside>

      <div class="vx-dashboard__overlay" id="dashboardOverlay" hidden></div>

      <section class="vx-dashboard__main">
        <header class="vx-dashboard__topbar">
          <button class="vx-dashboard__menu" id="dashboardOpen" type="button" aria-label="Abrir menu">☰</button>
          <div><span class="vx-dashboard__kicker">PAINEL DA CONTA</span><strong id="dashboardGreeting">Olá</strong></div>
          <a class="vx-button vx-button--ghost vx-dashboard__topbar-link" href={ROUTES.delivery}>Abrir meus produtos</a>
        </header>

        <div class="vx-dashboard__content">
          <section class="vx-dashboard__hero">
            <div><span class="vx-dashboard__eyebrow">SEU ECOSSISTEMA VOLYNX</span><h1>Olá, <span id="dashboardName">você</span>.</h1><p>Escolha um produto para continuar de onde parou.</p></div>
            <a class="vx-button vx-button--primary" href={ROUTES.products}>Explorar produtos</a>
          </section>

          <section class="vx-dashboard__metrics" aria-label="Resumo da conta" id="dashboardMetrics"></section>

          <section class="vx-dashboard__section">
            <div class="vx-dashboard__section-head"><div><span class="vx-dashboard__eyebrow">AMBIENTES DE TRABALHO</span><h2>Seus workspaces</h2></div><span class="vx-dashboard__section-note" id="workspaceCount"></span></div>
            <div class="vx-dashboard__workspace-grid" id="workspaceGrid"></div>
          </section>

          <section class="vx-dashboard__section">
            <div class="vx-dashboard__section-head"><div><span class="vx-dashboard__eyebrow">ACESSO DISPONÍVEL</span><h2>Seus produtos</h2></div><a class="vx-dashboard__text-link" href={ROUTES.delivery}>Ver detalhes</a></div>
            <div class="vx-dashboard__product-grid" id="productGrid"></div>
          </section>

          <section class="vx-dashboard__quick-grid" aria-label="Atalhos">
            <a class="vx-dashboard__quick-card" href={ROUTES.delivery}><span class="vx-dashboard__quick-icon vx-dashboard__quick-icon--cyan"><span class="vx-icon" aria-hidden="true" data-icon="box"></span></span><span><strong>Meus produtos</strong><small>Veja acessos, entregas e próximos passos.</small></span><span class="vx-dashboard__arrow" aria-hidden="true">↗</span></a>
            <a class="vx-dashboard__quick-card" href={ROUTES.builder}><span class="vx-dashboard__quick-icon vx-dashboard__quick-icon--violet"><span class="vx-icon" aria-hidden="true" data-icon="spark"></span></span><span><strong>Abrir o Builder</strong><small>Comece um novo projeto visual.</small></span><span class="vx-dashboard__arrow" aria-hidden="true">↗</span></a>
            <a class="vx-dashboard__quick-card" href={ROUTES.support}><span class="vx-dashboard__quick-icon vx-dashboard__quick-icon--gold"><span class="vx-icon" aria-hidden="true" data-icon="help"></span></span><span><strong>Precisa de ajuda?</strong><small>Fale com o suporte VOLYNX.</small></span><span class="vx-dashboard__arrow" aria-hidden="true">↗</span></a>
          </section>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { createClient } from "@supabase/supabase-js";

  type Profile = { email?: string | null; plan?: string | null; builder_plan?: string | null; daily_plan?: string | null; token_balance?: number | null };
  type Site = { id: string; name: string; slug: string; template_key?: string | null; status?: string | null; updated_at?: string | null; theme?: Record<string, unknown> | null };
  type ProductRecord = { key: string; source: "addon" | "purchase"; createdAt?: string | null; metadata?: Record<string, unknown> };
  type Product = ProductRecord & { title: string; eyebrow: string; description: string; href: string; icon: string; tone: "cyan" | "violet" | "gold" | "neutral" };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const tokenKeys = ["volynx_access_token", "volynx_refresh_token"];
  const state = { supa: null as any, user: null as any, profile: {} as Profile, products: [] as Product[], sites: [] as Site[] };

  function escapeHtml(value: unknown) { return String(value ?? "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char] || char); }
  function iconSvg(name: string) {
    const paths: Record<string, string> = {
      grid: '<rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/>',
      box: '<path d="m4 8 8-4 8 4-8 4-8-4Z"/><path d="M4 8v8l8 4 8-4V8M12 12v8"/>',
      user: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c.8-3.1 3.2-4.8 7-4.8s6.2 1.7 7 4.8"/>',
      help: '<circle cx="12" cy="12" r="8.5"/><path d="M9.7 9.2a2.5 2.5 0 1 1 4.1 1.9c-1.1.8-1.8 1.2-1.8 2.7M12 17h.01"/>',
      spark: '<path d="m12 3 1.6 5.4L19 10l-5.4 1.6L12 17l-1.6-5.4L5 10l5.4-1.6L12 3Z"/><path d="m19 16 .6 2.1L22 19l-2.4.9L19 22l-.6-2.1L16 19l2.4-.9L19 16Z"/>'
    };
    return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${paths[name] || paths.grid}</svg>`;
  }
  function firstName(email: string) { return (email.split("@")[0] || "você").split(/[._-]/)[0].replace(/^w/, (letter) => letter.toUpperCase()); }
  function normalizedKey(value: unknown) { return String(value || "").trim().toLowerCase().replace(/\s+/g, "_"); }
  function metadataOf(row: any) { return row?.metadata && typeof row.metadata === "object" ? row.metadata as Record<string, unknown> : {}; }
  function productSpec(record: ProductRecord): Product {
    const key = normalizedKey(record.key);
    if (key.startsWith("pf_") || key.includes("propertyflow") || key.includes("property_flow")) return { ...record, title: "Property Flow", eyebrow: "WORKSPACE ADMIN", description: "Gerencie imóveis, fotos, publicação e a identidade da sua vitrine.", href: "/dashboard/propertyflow/", icon: "box", tone: "cyan" };
    if (key.startsWith("kit_") || key.includes("kit")) return { ...record, title: "Website Kits", eyebrow: "KIT DE INTERFACE", description: "Acesse seus kits e materiais para criar experiências com mais velocidade.", href: "/dashboard/purchases/kits/", icon: "grid", tone: "violet" };
    if (key.startsWith("icons_") || key.includes("icon")) return { ...record, title: "Icon Packs", eyebrow: "RECURSOS VISUAIS", description: "Explore os recursos visuais incluídos na sua compra.", href: "/dashboard/purchases/icons/", icon: "spark", tone: "gold" };
    if (key.includes("builder")) return { ...record, title: "Builder", eyebrow: "FERRAMENTA VOLYNX", description: "Continue construindo seu próximo projeto visual.", href: "/builder/", icon: "spark", tone: "violet" };
    return { ...record, title: "Produto VOLYNX", eyebrow: "ACESSO ATIVO", description: "Abra os detalhes e continue sua experiência VOLYNX.", href: "/delivery/", icon: "grid", tone: "neutral" };
  }
  function uniqueProducts(addons: any[], events: any[]) {
    const records: ProductRecord[] = [];
    for (const row of addons || []) { const metadata = metadataOf(row); const key = normalizedKey(row.addon_id || metadata.lookup_key || metadata.product_key); if (key) records.push({ key, source: "addon", createdAt: row.created_at, metadata }); }
    for (const row of events || []) { const metadata = metadataOf(row); const key = normalizedKey(row.lookup_key || row.product_key || metadata.lookup_key || metadata.product_key); if (key) records.push({ key, source: "purchase", createdAt: row.created_at, metadata }); }
    const seen = new Set<string>();
    return records.filter((record) => { if (seen.has(record.key)) return false; seen.add(record.key); return true; }).map(productSpec);
  }
  function showState(which: "loading" | "loggedOut" | "error" | "app") { $("dashboardLoading")!.hidden = which !== "loading"; $("dashboardLoggedOut")!.hidden = which !== "loggedOut"; $("dashboardError")!.hidden = which !== "error"; $("dashboardApp")!.hidden = which !== "app"; }
  function renderIcons() { document.querySelectorAll<HTMLElement>("[data-icon]").forEach((node) => { node.innerHTML = iconSvg(node.dataset.icon || "grid"); }); }
  function renderMetrics() {
    const plan = state.profile.plan || state.profile.builder_plan || "Free";
    const tokenBalance = Number(state.profile.token_balance || 0);
    $("dashboardMetrics")!.innerHTML = [["Produtos ativos", state.products.length, "acessos disponíveis"], ["Workspaces", state.sites.length, "ambientes configurados"], ["Plano atual", plan, "da sua conta"], ["Saldo VX", tokenBalance, "tokens disponíveis"]].map(([label, value, hint]) => `<article class="vx-dashboard__metric"><span>${escapeHtml(label)}</span><strong>${escapeHtml(value)}</strong><small>${escapeHtml(hint)}</small></article>`).join("");
  }
  function renderWorkspaces() {
    $("workspaceCount")!.textContent = `${state.sites.length} ${state.sites.length === 1 ? "workspace" : "workspaces"}`;
    $("workspaceGrid")!.innerHTML = state.sites.length ? state.sites.map((site) => { const propertyFlow = site.template_key === "property-flow"; const href = propertyFlow ? `/dashboard/propertyflow/?site=${encodeURIComponent(site.id)}` : `/dashboard/?site=${encodeURIComponent(site.id)}`; return `<article class="vx-dashboard__workspace-card"><div class="vx-dashboard__workspace-icon"><span class="vx-icon" aria-hidden="true" data-icon="${propertyFlow ? "box" : "grid"}"></span></div><div class="vx-dashboard__workspace-copy"><span class="vx-dashboard__status">${escapeHtml(site.status === "published" ? "Ativo" : "Configurando")}</span><h3>${escapeHtml(site.name)}</h3><p>${escapeHtml(propertyFlow ? "Property Flow · catálogo e vitrine" : "Workspace VOLYNX")}</p></div><a class="vx-button vx-button--small vx-button--ghost" href="${href}">${propertyFlow ? "Gerenciar" : "Abrir"}</a></article>`; }).join("") : `<div class="vx-dashboard__empty"><strong>Você ainda não tem um workspace configurado.</strong><span>Quando um produto com ambiente próprio estiver disponível, ele aparecerá aqui.</span></div>`;
    renderIcons();
  }
  function renderProducts() {
    $("productGrid")!.innerHTML = state.products.length ? state.products.map((product) => `<article class="vx-dashboard__product-card"><div class="vx-dashboard__product-icon vx-dashboard__product-icon--${product.tone}"><span class="vx-icon" aria-hidden="true" data-icon="${product.icon}"></span></div><span class="vx-dashboard__status">Acesso ativo</span><h3>${escapeHtml(product.title)}</h3><p>${escapeHtml(product.description)}</p><a class="vx-button vx-button--small vx-button--primary" href="${product.href}">Abrir produto</a></article>`).join("") : `<div class="vx-dashboard__empty"><strong>Seus produtos aparecerão aqui.</strong><span>Depois da compra, o acesso fica associado automaticamente à sua conta.</span><a class="vx-dashboard__text-link" href="/products/">Conhecer produtos</a></div>`;
    renderIcons();
  }
  function render() {
    const email = state.user?.email || "Conta"; const name = firstName(email); const plan = state.profile.plan || state.profile.builder_plan || "Conta gratuita";
    $("dashboardEmail")!.textContent = email; $("dashboardInitial")!.textContent = email.slice(0, 1).toUpperCase(); $("dashboardPlan")!.textContent = String(plan); $("dashboardGreeting")!.textContent = `Olá, ${name}`; $("dashboardName")!.textContent = name;
    renderMetrics(); renderWorkspaces(); renderProducts(); renderIcons();
  }
  function closeMenu() { $("dashboardSidebar")?.classList.remove("is-open"); $("dashboardOverlay")?.setAttribute("hidden", ""); }
  function openMenu() { $("dashboardSidebar")?.classList.add("is-open"); $("dashboardOverlay")?.removeAttribute("hidden"); }
  async function boot() {
    showState("loading");
    try {
      const config = await fetch("/config.json").then((response) => response.json());
      state.supa = createClient(config.supabaseUrl, config.supabaseAnonKey);
      const accessToken = localStorage.getItem(tokenKeys[0]); const refreshToken = localStorage.getItem(tokenKeys[1]);
      if (accessToken && refreshToken) await state.supa.auth.setSession({ access_token: accessToken, refresh_token: refreshToken });
      const userResult = await state.supa.auth.getUser();
      if (userResult.error || !userResult.data.user) { showState("loggedOut"); return; }
      state.user = userResult.data.user;
      const [profileResult, addonsResult, eventsResult, sitesResult] = await Promise.all([
        state.supa.from("profiles").select("email,plan,builder_plan,daily_plan,token_balance").eq("id", state.user.id).maybeSingle(),
        state.supa.from("addons_purchased").select("addon_id,metadata,created_at").eq("user_id", state.user.id).eq("status", "active").order("created_at", { ascending: false }),
        state.supa.from("purchase_events").select("lookup_key,product_key,metadata,created_at").eq("user_id", state.user.id).eq("status", "completed").order("created_at", { ascending: false }),
        state.supa.from("sites").select("id,name,slug,template_key,status,updated_at,theme").order("updated_at", { ascending: false })
      ]);
      if (profileResult.error) console.warn("Dashboard profile unavailable", profileResult.error.message);
      if (addonsResult.error) console.warn("Dashboard addons unavailable", addonsResult.error.message);
      if (eventsResult.error) console.warn("Dashboard purchase history unavailable", eventsResult.error.message);
      if (sitesResult.error) console.warn("Dashboard workspaces unavailable", sitesResult.error.message);
      state.profile = (profileResult.data || {}) as Profile; state.products = uniqueProducts(addonsResult.data || [], eventsResult.data || []); state.sites = (sitesResult.data || []) as Site[];
      render(); showState("app");
    } catch (error) {
      $("dashboardErrorMessage")!.textContent = error instanceof Error ? error.message : "Atualize a página e tente novamente."; showState("error");
    }
  }
  document.querySelectorAll<HTMLAnchorElement>(".vx-dashboard__nav a").forEach((link) => link.addEventListener("click", closeMenu));
  $("dashboardOpen")?.addEventListener("click", openMenu); $("dashboardClose")?.addEventListener("click", closeMenu); $("dashboardOverlay")?.addEventListener("click", closeMenu); $("dashboardRetry")?.addEventListener("click", boot);
  $("dashboardLogout")?.addEventListener("click", async () => { await state.supa?.auth.signOut(); tokenKeys.forEach((key) => localStorage.removeItem(key)); window.location.href = "/login/"; });
  boot();
</script>

<style>
  :global(body) { background: #080b12; }
  .vx-dashboard [hidden] { display: none !important; }
  .vx-dashboard { --vx-cyan: #8de7d5; --vx-violet: #a9a0ff; --vx-gold: #f0c56a; --vx-ink: #f7f8fc; --vx-surface: #0c111d; min-height: 100vh; color: var(--vx-ink); background: radial-gradient(circle at 78% -8%, rgba(141,231,213,.12), transparent 34rem), #080b12; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 16px; }
  .vx-dashboard__state { min-height: 100vh; display: grid; place-content: center; justify-items: center; gap: 14px; padding: 30px; text-align: center; }
  .vx-dashboard__state h1 { max-width: 680px; margin: 0; color: #fff; font-size: clamp(2.6rem, 6vw, 5rem); line-height: .98; letter-spacing: -.065em; }
  .vx-dashboard__state p { max-width: 560px; margin: 0 0 18px; color: rgba(240,244,255,.68); line-height: 1.65; }
  .vx-dashboard__eyebrow, .vx-dashboard__kicker { color: var(--vx-cyan); font-size: 12px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .vx-dashboard__spinner { width: 30px; height: 30px; border: 2px solid rgba(255,255,255,.16); border-top-color: var(--vx-cyan); border-radius: 50%; animation: vx-spin .8s linear infinite; }
  @keyframes vx-spin { to { transform: rotate(360deg); } }
  .vx-dashboard__app { min-height: 100vh; }
  .vx-dashboard__sidebar { position: fixed; inset: 0 auto 0 0; z-index: 20; display: flex; width: 280px; flex-direction: column; gap: 34px; padding: 28px 20px 20px; border-right: 1px solid rgba(255,255,255,.08); background: color-mix(in srgb, var(--vx-surface) 92%, #05070b); }
  .vx-dashboard__brand-row { display: flex; align-items: flex-start; justify-content: space-between; }
  .vx-dashboard__brand { display: flex; align-items: center; gap: 12px; color: #fff; text-decoration: none; }
  .vx-dashboard__brand-mark { display: grid; width: 44px; height: 44px; place-items: center; border-radius: 14px; background: linear-gradient(135deg, var(--vx-cyan), var(--vx-violet)); color: #071119; font-size: 18px; font-weight: 900; }
  .vx-dashboard__brand strong, .vx-dashboard__account strong { display: block; font-size: 16px; letter-spacing: -.02em; }
  .vx-dashboard__brand small, .vx-dashboard__account small { display: block; margin-top: 3px; color: rgba(221,228,244,.54); font-size: 12px; }
  .vx-dashboard__close, .vx-dashboard__menu { display: none; border: 0; background: transparent; color: rgba(255,255,255,.8); font: inherit; font-size: 28px; cursor: pointer; }
  .vx-dashboard__nav { display: grid; gap: 7px; }
  .vx-dashboard__nav a { display: flex; min-height: 54px; align-items: center; gap: 13px; padding: 0 14px; border: 1px solid transparent; border-radius: 14px; color: rgba(222,229,244,.62); font-size: 15px; text-decoration: none; transition: .18s ease; }
  .vx-dashboard__nav a:hover, .vx-dashboard__nav a.is-active { border-color: rgba(141,231,213,.28); background: rgba(141,231,213,.09); color: #fff; }
  .vx-icon { display: inline-grid; width: 22px; height: 22px; flex: 0 0 22px; place-items: center; color: var(--vx-cyan); }
  .vx-icon svg { width: 21px; height: 21px; }
  .vx-dashboard__sidebar-bottom { display: grid; gap: 18px; margin-top: auto; }
  .vx-dashboard__account { display: flex; align-items: center; gap: 11px; padding: 15px 4px; border-top: 1px solid rgba(255,255,255,.08); }
  .vx-dashboard__account > span:first-child { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 50%; background: rgba(255,255,255,.1); color: var(--vx-cyan); font-size: 14px; font-weight: 800; }
  .vx-dashboard__account > span:last-child { min-width: 0; overflow: hidden; }
  .vx-dashboard__account strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .vx-dashboard__logout { width: fit-content; padding: 0 4px; border: 0; background: transparent; color: rgba(221,228,244,.52); font: inherit; font-size: 14px; cursor: pointer; }
  .vx-dashboard__logout:hover { color: #fff; }
  .vx-dashboard__main { min-width: 0; margin-left: 280px; }
  .vx-dashboard__topbar { position: sticky; top: 0; z-index: 10; display: flex; min-height: 82px; align-items: center; gap: 18px; padding: 0 clamp(22px, 4vw, 64px); border-bottom: 1px solid rgba(255,255,255,.07); background: rgba(8,11,18,.86); backdrop-filter: blur(18px); }
  .vx-dashboard__topbar > div { display: grid; gap: 6px; margin-right: auto; }
  .vx-dashboard__topbar strong { color: #fff; font-size: 16px; }
  .vx-dashboard__content { width: min(1280px, calc(100% - 52px)); margin: 0 auto; padding: clamp(38px, 5vw, 74px) 0 100px; }
  .vx-dashboard__hero { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 34px; }
  .vx-dashboard__hero h1 { margin: 10px 0 12px; color: #fff; font-size: clamp(2.8rem, 5.4vw, 5.7rem); line-height: .93; letter-spacing: -.075em; }
  .vx-dashboard__hero p { margin: 0; color: rgba(223,230,245,.68); font-size: 18px; line-height: 1.55; }
  .vx-button { display: inline-flex; min-height: 52px; align-items: center; justify-content: center; gap: 8px; padding: 0 18px; border: 1px solid rgba(255,255,255,.14); border-radius: 999px; background: rgba(255,255,255,.05); color: #fff; font: inherit; font-size: 15px; font-weight: 800; text-decoration: none; white-space: nowrap; cursor: pointer; transition: transform .18s ease, border-color .18s ease, background .18s ease; }
  .vx-button:hover { transform: translateY(-1px); border-color: rgba(141,231,213,.7); }
  .vx-button--primary { border-color: transparent; background: linear-gradient(135deg, var(--vx-cyan), var(--vx-violet)); color: #071119; }
  .vx-button--ghost { background: rgba(255,255,255,.045); color: rgba(240,244,255,.86); }
  .vx-button--small { min-height: 44px; padding: 0 14px; font-size: 14px; }
  .vx-dashboard__metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 56px; }
  .vx-dashboard__metric, .vx-dashboard__workspace-card, .vx-dashboard__product-card, .vx-dashboard__quick-card { border: 1px solid rgba(255,255,255,.1); border-radius: 20px; background: linear-gradient(145deg, rgba(255,255,255,.08), rgba(255,255,255,.022)); box-shadow: 0 20px 70px rgba(0,0,0,.14); }
