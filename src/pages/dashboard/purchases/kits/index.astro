---
import FlagshipLayout from "../../../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../../../components/FlagshipFooter.astro";
import DeliveryTrustStrip from "../../../../components/DeliveryTrustStrip.astro";
import PlatformAssistStrip from "../../../../components/PlatformAssistStrip.astro";
import { ROUTES } from "../../../../data/routes";

const assistItems = [
  { href: ROUTES.delivery, label: "All purchases", title: "Back to my products", copy: "Switch to the full delivery dashboard for tokens, PropertyFlow and other purchases.", emphasized: true },
  { href: ROUTES.builder, label: "Builder", title: "Open Builder", copy: "Pick up where the kit left off — every kit ships pre-loaded as a draft project." },
  { href: ROUTES.products, label: "Catalog", title: "Browse products", copy: "Compare tiers across Portfolio, Agency and SaaS kits before adding more." },
  { href: ROUTES.support, label: "Help", title: "Open support", copy: "Hit support if a kit didn't auto-load, the preset is missing, or licensing needs clarification." },
];
---
<FlagshipLayout title="Kits — VOLYNX" description="Open your purchased Portfolio, Agency, and SaaS kits in Builder, manage tier licenses, recover preset drafts." pageClass="page-kits-delivery">
  <FlagshipHeader ctaLabel="Open Builder" ctaHref={ROUTES.builder} />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero kits-hero">
      <div class="shell">
        <nav class="kits-breadcrumbs" aria-label="Breadcrumb">
          <a href={ROUTES.home}>Home</a>
          <span>/</span>
          <a href={ROUTES.delivery}>My products</a>
          <span>/</span>
          <span>Kits</span>
        </nav>

        <div class="hero-grid kits-hero-grid">
          <div class="hero-copy">
            <span class="eyebrow"><span class="i18n-en">Your kits</span><span class="i18n-pt">Seus kits</span></span>
            <h1><span class="i18n-en">Open. Edit. Ship.</span><span class="i18n-pt">Abrir. Editar. Publicar.</span></h1>
            <p>
              <span class="i18n-en">Every kit you've purchased is auto-loaded into Builder as a draft. Open it to start customising — content, branding, and sections are pre-wired by tier.</span>
              <span class="i18n-pt">Cada kit comprado é carregado no Builder como rascunho. Abra para personalizar — conteúdo, branding e seções já vêm pré-montados pelo tier.</span>
            </p>
            <div class="hero-actions">
              <a href={ROUTES.builder} class="button button--gold"><span class="i18n-en">Open Builder</span><span class="i18n-pt">Abrir Builder</span></a>
              <a href={ROUTES.products} class="button button--ghost"><span class="i18n-en">Browse kits</span><span class="i18n-pt">Ver kits</span></a>
            </div>
          </div>
          <div class="kits-hero-visual" aria-hidden="true">
            <span class="vx-glow-container vx-glow-container--gold vx-glow-container--strong vx-glow-container--xl">
              <img src="/assets/Volynx-OS-Cards/kits.webp" alt="" loading="eager" />
            </span>
          </div>
        </div>
      </div>
    </section>

    <PlatformAssistStrip
      eyebrow="Kit lane"
      title="Stay close to delivery, Builder, and support."
      description="One click to your draft. One click to recovery if the preset didn't auto-load."
      items={assistItems}
    />

    <!-- ═══ PURCHASES ═══ -->
    <section class="page-section">
      <div class="shell">

        <!-- Loading state -->
        <div id="kitsLoading" class="kits-state">
          <div class="kits-spinner" aria-hidden="true"></div>
          <p class="kits-state__label"><span class="i18n-en">Loading your kits...</span><span class="i18n-pt">Carregando seus kits...</span></p>
        </div>

        <!-- Error state -->
        <div id="kitsError" class="kits-state" style="display:none;">
          <p class="kits-state__label kits-state__label--error" id="kitsErrorMsg">Something went wrong. Please try again.</p>
          <div class="kits-state__actions">
            <a href={ROUTES.login + "?next=/dashboard/purchases/kits/"} class="button button--ghost">Sign in again</a>
            <a href={ROUTES.support + "?product=kits"} class="button button--ghost">Open support</a>
          </div>
        </div>

        <!-- Empty state -->
        <div id="kitsEmpty" class="kits-state" style="display:none;">
          <p class="kits-state__label"><span class="i18n-en">You don't have any kits yet.</span><span class="i18n-pt">Você ainda não tem kits.</span></p>
          <a href={ROUTES.products} class="button button--gold"><span class="i18n-en">Browse Portfolio · Agency · SaaS</span><span class="i18n-pt">Ver Portfolio · Agency · SaaS</span></a>
        </div>

        <!-- Purchase grid -->
        <div id="kitsGrid" class="kits-grid" style="display:none;" aria-live="polite"></div>

      </div>
    </section>

    <section class="page-section page-section--tight">
      <div class="shell">
        <DeliveryTrustStrip productName="kit" />
      </div>
    </section>

    <!-- ═══ RECOVERY ═══ -->
    <section class="page-section">
      <div class="shell kits-help panel">
        <div>
          <span class="eyebrow"><span class="i18n-en">Need a hand?</span><span class="i18n-pt">Precisa de ajuda?</span></span>
          <strong><span class="i18n-en">Preset didn't auto-load?</span><span class="i18n-pt">Preset não carregou automaticamente?</span></strong>
          <p>
            <span class="i18n-en">Click <em>Set up in Builder</em> on any card. Builder will pick up the preset and create your project draft from scratch.</span>
            <span class="i18n-pt">Clique em <em>Configurar no Builder</em> em qualquer card. O Builder pega o preset e cria seu projeto draft do zero.</span>
          </p>
        </div>
        <div class="hero-actions">
          <a href={ROUTES.support + "?product=kits&intent=delivery"} class="button button--ghost">Contact support</a>
        </div>
      </div>
    </section>

  </main>
  <FlagshipFooter />

  <script is:inline type="module">
    // ── Auth guard ────────────────────────────────────────────────────────
    const token = localStorage.getItem('volynx_access_token');
    if (!token) {
      window.location.href = '/login/?next=/dashboard/purchases/kits/';
    }

    function show(id) { const el = document.getElementById(id); if (el) el.style.display = ''; }
    function hide(id) { const el = document.getElementById(id); if (el) el.style.display = 'none'; }

    function jwtSub(jwt) {
      try {
        const part = String(jwt || '').split('.')[1];
        if (!part) return null;
        const normalized = part.replace(/-/g, '+').replace(/_/g, '/');
        const payload = JSON.parse(atob(normalized.padEnd(normalized.length + (4 - normalized.length % 4) % 4, '=')));
        return payload?.sub || null;
      } catch { return null; }
    }

    // Per-family branding. Keep in sync with Volynx-OS demo themes:
    // portfolio = teal, agency = violet, saas = cyan.
    const KIT_FAMILIES = {
      portfolio: {
        en: 'Portfolio Pro Kit', pt: 'Portfolio Pro Kit',
        tone: 'portfolio',
        preset: 'portfolio',
        product_url: '/products/portfolio-pro-kit/',
      },
      agency: {
        en: 'Agency Launch Kit', pt: 'Agency Launch Kit',
        tone: 'agency',
        preset: 'agency',
        product_url: '/products/agency-launch-kit/',
      },
      saas: {
        en: 'SaaS Landing System', pt: 'SaaS Landing System',
        tone: 'saas',
        preset: 'saas',
        product_url: '/products/saas-landing-system/',
      },
    };

    const TIER_LABELS = {
      personal:     { en: 'Starter',  pt: 'Starter' },
      commercial:   { en: 'Pro',      pt: 'Pro' },
      studio:       { en: 'Studio',   pt: 'Studio' },
    };

    /** Identify the kit family from a kit_* addon_id. */
    function kitFamily(addonId) {
      const id = String(addonId || '').toLowerCase();
      if (id.startsWith('kit_portfolio') || id.startsWith('kit-portfolio')) return 'portfolio';
      if (id.startsWith('kit_agency')    || id.startsWith('kit-agency'))    return 'agency';
      if (id.startsWith('kit_saas')      || id.startsWith('kit-saas'))      return 'saas';
      // landing_express maps to saas family per webhook presetMap
      if (id.startsWith('kit_landing')   || id.startsWith('kit-landing'))   return 'saas';
      return null;
    }

    /** Extract tier suffix from kit_* addon_id. */
    function kitTier(addonId, metaTier) {
      if (metaTier) return metaTier;
      const m = String(addonId || '').toLowerCase().match(/_(personal|commercial|studio)$/);
      return m ? m[1] : null;
    }

    function isKitAddon(addonId) {
      return kitFamily(addonId) !== null;
    }

    function parseMeta(value) {
      if (!value) return {};
      if (typeof value === 'string') {
        try { return JSON.parse(value); } catch { return {}; }
      }
      return typeof value === 'object' ? value : {};
    }

    function hasValue(value) {
      if (value == null) return false;
      if (typeof value === 'string') return value.trim() !== '';
      return true;
    }

    function firstValue(...values) {
      for (const value of values) {
        if (hasValue(value)) return value;
      }
      return null;
    }

    function stripCurrencySuffix(value) {
      return String(value || '')
        .trim()
        .replace(/_(gbp|eur|brl)$/i, '')
        .replace(/-(gbp|eur|brl)$/i, '');
    }

    function canonicalAddonId(value) {
      return stripCurrencySuffix(value).toLowerCase();
    }

    function purchaseSessionId(item) {
      const meta = parseMeta(item?.metadata);
      return String(meta.stripe_session_id || item?.stripe_session_id || '').trim();
    }

    function samePurchase(a, b) {
      const aSession = purchaseSessionId(a);
      const bSession = purchaseSessionId(b);
      if (aSession && bSession) return aSession === bSession;
      return false;
    }

    function mergedMetadata(baseItem, incomingItem) {
      return {
        ...parseMeta(incomingItem?.metadata),
        ...parseMeta(baseItem?.metadata),
      };
    }

    function mergedPricePaid(baseItem, incomingItem) {
      const basePrice = baseItem?.price_paid;
      const incomingPrice = incomingItem?.price_paid;
      const incomingAmountPaid = incomingItem?.amount_paid;

      if (hasValue(basePrice)) return basePrice;
      if (hasValue(incomingPrice)) return incomingPrice;
      if (typeof incomingAmountPaid === 'number') return incomingAmountPaid / 100;
      return null;
    }

    function mergePurchaseRecords(baseItem, incomingItem) {
      const metadata = mergedMetadata(baseItem, incomingItem);
      const baseAddonId = canonicalAddonId(baseItem?.addon_id || baseItem?.lookup_key);
      const incomingAddonId = canonicalAddonId(incomingItem?.addon_id || incomingItem?.lookup_key);

      return {
        ...incomingItem,
        ...baseItem,
        id: firstValue(baseItem?.id, incomingItem?.id),
        addon_id: firstValue(
          baseAddonId,
          incomingAddonId,
          canonicalAddonId(metadata.lookup_key),
          canonicalAddonId(metadata.stripe_lookup_key)
        ),
        lookup_key: firstValue(
          baseItem?.lookup_key,
          incomingItem?.lookup_key,
          metadata.lookup_key,
          metadata.stripe_lookup_key
        ),
        stripe_session_id: firstValue(
          purchaseSessionId(baseItem),
          purchaseSessionId(incomingItem),
          metadata.stripe_session_id
        ),
        purchase_id: firstValue(
          baseItem?.purchase_id,
          incomingItem?.purchase_id,
          baseItem?.source === 'addon' ? baseItem?.id : null,
          incomingItem?.source === 'addon' ? incomingItem?.id : null
        ),
        price_paid: mergedPricePaid(baseItem, incomingItem),
        currency: firstValue(baseItem?.currency, incomingItem?.currency),
        status: firstValue(baseItem?.status, incomingItem?.status, 'completed'),
        created_at: firstValue(baseItem?.created_at, incomingItem?.created_at),
        metadata,
      };
    }

    function fmtDate(iso) {
      if (!iso) return '';
      try {
        return new Date(iso).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
      } catch { return iso; }
    }

    function fmtMoney(amount, currency) {
      if (amount == null) return '';
      try {
        const n = typeof amount === 'number' ? amount : parseFloat(amount);
        return new Intl.NumberFormat(undefined, { style: 'currency', currency: (currency || 'GBP').toUpperCase() }).format(n);
      } catch { return String(amount); }
    }

    function statusPill(meta) {
      const s = meta?.delivery_status || (meta?.download_url ? 'ready' : meta?.project_slug ? 'ready' : 'pending_signed_url');
      const map = {
        ready:                  { en: 'Ready', pt: 'Pronto',           tone: 'ok' },
        pending_signed_url:     { en: 'Awaiting link', pt: 'Aguardando link', tone: 'warn' },
        pending_preset_fetch:   { en: 'Awaiting setup', pt: 'Aguardando setup', tone: 'warn' },
        missing_storage_asset:  { en: 'Awaiting upload', pt: 'Aguardando upload', tone: 'warn' },
        refunded:               { en: 'Refunded', pt: 'Reembolsado',   tone: 'muted' },
        canceled:               { en: 'Canceled', pt: 'Cancelado',     tone: 'muted' },
      };
      const label = map[s] || { en: s, pt: s, tone: 'muted' };
      return `<span class="kit-pill kit-pill--${label.tone}"><span class="i18n-en">${label.en}</span><span class="i18n-pt">${label.pt}</span></span>`;
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    /** Pretty-print an addon_entitlement feature key (e.g. "agency_proposal_full" → "Proposal full"). */
    function prettyFeature(key) {
      const stripped = String(key).replace(/^(kit_|portfolio_|agency_|saas_)/, '').replace(/_/g, ' ');
      return stripped.charAt(0).toUpperCase() + stripped.slice(1);
    }

    function featureList(features) {
      const arr = Array.isArray(features) ? features : [];
      if (arr.length === 0) return '';
      const items = arr.slice(0, 14).map(f => `<li>${escapeHtml(prettyFeature(f))}</li>`).join('');
      return `<details class="kit-features">
        <summary><span class="i18n-en">License + sections (${arr.length})</span><span class="i18n-pt">Licença + seções (${arr.length})</span></summary>
        <ul>${items}</ul>
      </details>`;
    }

    /** Returns true when a stored signed download URL is still usable. */
    function isDownloadValid(meta) {
      if (!meta || !meta.download_url) return false;
      const exp = meta.download_expires_at ? new Date(meta.download_expires_at).getTime() : 0;
      // <60s away from expiry counts as expired so we never serve a URL
      // that dies mid-request.
      return Number.isFinite(exp) && exp - Date.now() > 60_000;
    }

    function buildCard(item, entitlements) {
      const addonId = canonicalAddonId(item.addon_id || item.lookup_key);
      const family = kitFamily(addonId);
      if (!family) return '';
      const fam = KIT_FAMILIES[family];

      const meta = parseMeta(item.metadata);
      const tier = kitTier(addonId, meta.tier);
      const tierLabel = (tier && TIER_LABELS[tier]) || null;

      const purchaseDate = fmtDate(item.created_at);
      const price = fmtMoney(item.price_paid, item.currency);

      const projectSlug = meta.project_slug || null;
      const presetId = meta.preset_id || fam.preset;
      const downloadValid = isDownloadValid(meta);
      const expiresLabel = meta.download_expires_at ? fmtDate(meta.download_expires_at) : '';
      const purchaseId = item.purchase_id || null;

      const features = entitlements?.[addonId]?.features || meta.features || [];
      const description = entitlements?.[addonId]?.description || '';

      // Primary CTA priority:
      //   1. Direct "Download ZIP" anchor when metadata.download_url is still
      //      valid (>60s before download_expires_at). This is the canonical
      //      delivery — kit ZIP holds the full Next.js source.
      //   2. "Generate download link" button → POSTs to refresh-kit-url to
      //      mint a fresh signed URL. Used when the original 24h URL has
      //      expired or the webhook failed to mint one (delivery_status
      //      = pending_signed_url / missing_storage_asset).
      // Builder route ("Open in Builder" / "Set up in Builder") becomes a
      // SECONDARY action so buyers who want the no-code path still have it.
      const primary = downloadValid
        ? `<a href="${escapeHtml(meta.download_url)}" class="button button--gold kit-card__cta" download>
             <span class="i18n-en">Download ZIP</span><span class="i18n-pt">Baixar ZIP</span>
           </a>`
        : `<button type="button" class="button button--gold kit-card__cta kit-card__refresh"
                   ${purchaseId ? `data-purchase-id="${escapeHtml(purchaseId)}"` : ''}
                   data-addon-id="${escapeHtml(addonId)}">
             <span class="i18n-en">Generate download link</span><span class="i18n-pt">Gerar link de download</span>
           </button>`;

      const builderSecondary = projectSlug
        ? `<a href="/builder/?project=${encodeURIComponent(projectSlug)}" class="button button--ghost kit-card__cta-secondary">
             <span class="i18n-en">Open in Builder (no-code)</span><span class="i18n-pt">Abrir no Builder (no-code)</span>
           </a>`
        : `<a href="/builder/?preset=${encodeURIComponent(presetId)}" class="button button--ghost kit-card__cta-secondary">
             <span class="i18n-en">Set up in Builder (no-code)</span><span class="i18n-pt">Configurar no Builder (no-code)</span>
           </a>`;

      const errorNote = meta.delivery_error
        ? `<p class="kit-card__error">${escapeHtml(String(meta.delivery_error))}</p>`
        : '';

      return `
        <article class="panel kit-card kit-card--${fam.tone}" data-row-id="${escapeHtml(item.id)}">
          <header class="kit-card__head">
            <div class="kit-card__title">
              <span class="eyebrow">${statusPill(meta)}</span>
              <h2 class="i18n-en">${escapeHtml(fam.en)}${tierLabel ? ' — ' + escapeHtml(tierLabel.en) : ''}</h2>
              <h2 class="i18n-pt">${escapeHtml(fam.pt)}${tierLabel ? ' — ' + escapeHtml(tierLabel.pt) : ''}</h2>
            </div>
            <span class="kit-card__family">${escapeHtml(family)}</span>
          </header>

          ${description ? `<p class="kit-card__desc">${escapeHtml(description)}</p>` : ''}

          <dl class="kit-card__meta">
            ${purchaseDate ? `<div><dt><span class="i18n-en">Purchased</span><span class="i18n-pt">Compra</span></dt><dd>${purchaseDate}</dd></div>` : ''}
            ${price        ? `<div><dt><span class="i18n-en">Paid</span><span class="i18n-pt">Pago</span></dt><dd>${price}</dd></div>` : ''}
            ${downloadValid && expiresLabel ? `<div><dt><span class="i18n-en">Link expires</span><span class="i18n-pt">Link expira</span></dt><dd>${expiresLabel}</dd></div>` : ''}
            ${projectSlug  ? `<div><dt><span class="i18n-en">Builder draft</span><span class="i18n-pt">Draft no Builder</span></dt><dd class="kit-card__slug">${escapeHtml(projectSlug)}</dd></div>` : ''}
          </dl>

          <p class="kit-card__hint" data-kit-status>${downloadValid
            ? `<span class="i18n-en">Direct download — link expires after ${expiresLabel}.</span><span class="i18n-pt">Download direto — o link expira após ${expiresLabel}.</span>`
            : `<span class="i18n-en">Click below to mint a fresh 24h download link.</span><span class="i18n-pt">Clique abaixo para gerar um link de 24h novo.</span>`}</p>

          ${errorNote}
          ${featureList(features)}

          <div class="kit-card__actions">
            ${primary}
            ${builderSecondary}
            <a href="${escapeHtml(fam.product_url)}" class="button button--ghost kit-card__cta-secondary">
              <span class="i18n-en">Product page</span><span class="i18n-pt">Página do produto</span>
            </a>
          </div>
        </article>`;
    }

    /** Wire up "Generate download link" buttons to refresh-kit-url. Mirrors
     *  the pattern in the PropertyFlow dashboard so the contract is identical
     *  across product families. */
    function attachKitRefreshHandlers(supabaseUrl, anonKey) {
      const fnUrl = supabaseUrl + '/functions/v1/refresh-kit-url';
      document.querySelectorAll('.kit-card__refresh').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const purchaseId = btn.getAttribute('data-purchase-id');
          const addonId    = btn.getAttribute('data-addon-id');
          if (!purchaseId && !addonId) return;
          const card = btn.closest('.kit-card');
          const status = card?.querySelector('[data-kit-status]');
          const original = btn.innerHTML;

          btn.innerHTML = '<span class="i18n-en">Generating...</span><span class="i18n-pt">Gerando...</span>';
          btn.setAttribute('disabled', 'true');

          try {
            const res = await fetch(fnUrl, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Authorization: 'Bearer ' + token,
                apikey: anonKey,
              },
              body: JSON.stringify({ purchase_id: purchaseId, addon_id: addonId }),
            });
            const data = await res.json().catch(() => ({}));
            const url = data?.download_url || data?.url;
            if (res.ok && url) {
              const a = document.createElement('a');
              a.href = url;
              a.className = 'button button--gold kit-card__cta';
              a.setAttribute('download', '');
              a.innerHTML = '<span class="i18n-en">Download ZIP</span><span class="i18n-pt">Baixar ZIP</span>';
              btn.replaceWith(a);
              if (status) {
                const exp = data.download_expires_at || data.expires_at;
                const when = exp ? new Date(exp).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : '';
                status.innerHTML = `<span class="i18n-en">Direct download — link expires after ${when}.</span><span class="i18n-pt">Download direto — o link expira após ${when}.</span>`;
              }
              a.click();
            } else {
              btn.innerHTML = original;
              btn.removeAttribute('disabled');
              if (status) {
                const msg = data?.error || 'unknown error';
                status.innerHTML = '<span class="i18n-en">Could not generate link: ' + msg + '. Please try again or contact support.</span><span class="i18n-pt">Não foi possível gerar o link: ' + msg + '. Tente novamente ou abra suporte.</span>';
              }
            }
          } catch (err) {
            btn.innerHTML = original;
            btn.removeAttribute('disabled');
            if (status) status.innerHTML = '<span class="i18n-en">Network error. Please try again.</span><span class="i18n-pt">Erro de rede. Tente novamente.</span>';
          }
        });
      });
    }

    // ── Main fetch ────────────────────────────────────────────────────────
    (async () => {
      let userId = null;
      try {
        const session = JSON.parse(localStorage.getItem('volynx_session') || '{}');
        userId = session?.user?.id || jwtSub(token);
      } catch {}
      userId = userId || jwtSub(token);

      if (!userId) {
        window.location.href = '/login/?next=/dashboard/purchases/kits/';
        return;
      }

      let cfg = null;
      try { cfg = await fetch('/config.json', { cache: 'no-store' }).then(r => r.json()); } catch {}
      const supabaseUrl = (cfg?.supabaseUrl || '').replace(/\/$/, '');
      const anonKey     = cfg?.supabaseAnonKey || cfg?.anonKey || '';

      if (!supabaseUrl || !anonKey) {
        hide('kitsLoading');
        document.getElementById('kitsErrorMsg').textContent = 'Configuration error. Please contact support.';
        show('kitsError');
        return;
      }

      const headers = {
        apikey: anonKey,
        Authorization: 'Bearer ' + token,
        'Content-Type': 'application/json',
      };

      try {
        // Fetch addon purchases + purchase events together so a kit card never
        // disappears just because /delivery/ merged one table and this page
        // only read the other.
        const [purchasesRes, eventsRes, entitlementsRes] = await Promise.all([
          fetch(`${supabaseUrl}/rest/v1/addons_purchased?select=id,addon_id,price_paid,currency,status,metadata,created_at&user_id=eq.${userId}&status=eq.active&order=created_at.desc`, { headers }),
          fetch(`${supabaseUrl}/rest/v1/purchase_events?select=id,lookup_key,amount_paid,currency,status,metadata,created_at,stripe_session_id&user_id=eq.${userId}&status=eq.completed&order=created_at.desc`, { headers }),
          fetch(`${supabaseUrl}/rest/v1/addon_entitlements?select=addon_id,features,description&addon_id=like.kit_*`, { headers }),
        ]);

        if (!purchasesRes.ok) throw new Error('purchases fetch failed: ' + purchasesRes.status);

        const purchaseRows = await purchasesRes.json().catch(() => []);
        const eventRows = eventsRes.ok ? await eventsRes.json().catch(() => []) : [];
        const mergedRows = [];

        const upsertRow = (row) => {
          const existingIndex = mergedRows.findIndex((entry) => samePurchase(entry, row));
          if (existingIndex === -1) {
            mergedRows.push(mergePurchaseRecords(row, {}));
            return;
          }
          mergedRows[existingIndex] = mergePurchaseRecords(mergedRows[existingIndex], row);
        };

        for (const row of (Array.isArray(purchaseRows) ? purchaseRows : [])) {
          upsertRow({ ...row, source: 'addon', purchase_id: row.id });
        }

        for (const row of (Array.isArray(eventRows) ? eventRows : [])) {
          upsertRow({ ...row, source: 'event' });
        }

        const requestedSessionId = new URLSearchParams(window.location.search).get('session_id');
        let kitRows = mergedRows.filter((row) => isKitAddon(row.addon_id || row.lookup_key));
        if (requestedSessionId) {
          const focusedRows = kitRows.filter((row) => purchaseSessionId(row) === requestedSessionId);
          if (focusedRows.length > 0) {
            kitRows = focusedRows;
          }
        }

        // Build a lookup so each card can pull its entitlement inline.
        let entitlements = {};
        if (entitlementsRes.ok) {
          try {
            const ent = await entitlementsRes.json();
            entitlements = (Array.isArray(ent) ? ent : []).reduce((acc, e) => {
              acc[e.addon_id] = e;
              return acc;
            }, {});
          } catch {}
        }

        hide('kitsLoading');

        if (kitRows.length === 0) {
          show('kitsEmpty');
          return;
        }

        const grid = document.getElementById('kitsGrid');
        grid.innerHTML = kitRows.map(item => buildCard(item, entitlements)).join('');
        grid.style.display = '';
        attachKitRefreshHandlers(supabaseUrl, anonKey);
      } catch (err) {
        hide('kitsLoading');
        const errEl = document.getElementById('kitsErrorMsg');
        if (errEl) errEl.textContent = 'Failed to load kits. Please refresh and try again.';
        show('kitsError');
      }
    })();
  </script>
</FlagshipLayout>

