---
import FlagshipLayout from "../../../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../../../components/FlagshipFooter.astro";
import DeliveryTrustStrip from "../../../../components/DeliveryTrustStrip.astro";
import PlatformAssistStrip from "../../../../components/PlatformAssistStrip.astro";
import { ROUTES } from "../../../../data/routes";

const assistItems = [
  { href: ROUTES.builder, label: { en: "Start", pt: "Começar" }, title: { en: "Open the Builder draft", pt: "Abrir o rascunho no Builder" }, copy: { en: "Your kit is meant to become a site, not sit in a receipt. Start with the visual path first.", pt: "Seu kit foi criado para se tornar um site, não para permanecer em um recibo. Comece pelo fluxo visual." }, emphasized: true, iconSrc: "/assets/new-builder-icon.webp" },
  { href: ROUTES.delivery, label: { en: "Own", pt: "Posse" }, title: { en: "Back to all products", pt: "Voltar aos produtos" }, copy: { en: "Keep every purchase connected across VX, PropertyFlow, icons and kits.", pt: "Mantenha cada compra conectada entre VX, PropertyFlow, icones e kits." }, iconSrc: "/assets/Volynx-OS-Cards/allproducts.webp" },
  { href: ROUTES.products, label: { en: "Expand", pt: "Expandir" }, title: { en: "Browse more kits", pt: "Ver mais kits" }, copy: { en: "Compare Portfolio, Agency and SaaS systems when you are ready for the next launch.", pt: "Compare os sistemas Portfolio, Agency e SaaS quando estiver pronto para o próximo lançamento." }, iconSrc: "/assets/Volynx-OS-Cards/kits.webp" },
  { href: ROUTES.support, label: { en: "Recover", pt: "Recuperar" }, title: { en: "Support with context", pt: "Suporte com contexto" }, copy: { en: "If a draft, source ZIP or license needs attention, the purchase context stays attached.", pt: "Se um draft, ZIP fonte ou licenca precisar de atencao, o contexto da compra continua junto." }, iconSrc: "/assets/Volynx-OS-Cards/support.webp" },
];

const kitValueItems = [
  { iconSrc: "/assets/Volynx-OS-Cards/kits.webp", label: { en: "Premium structure", pt: "Estrutura premium" }, copy: { en: "Sections, hierarchy and motion decisions already shaped for a serious launch.", pt: "Seções, hierarquia e decisões de movimento já definidas para um lançamento consistente." } },
  { iconSrc: "/assets/new-builder-icon.webp", label: { en: "Builder-first", pt: "Builder primeiro" }, copy: { en: "No setup ceremony: open the draft, edit visually and move toward publication.", pt: "Sem ritual de instalacao: abra o draft, edite visualmente e avance para a publicacao." } },
  { iconSrc: "/assets/Volynx-OS-Cards/allproducts.webp", label: { en: "Source included", pt: "Código-fonte incluído" }, copy: { en: "Advanced source ZIP delivery stays available when you need code-level control.", pt: "A entrega do arquivo ZIP com o código-fonte permanece disponível quando você precisar de controle em nível de código." } },
];
---
<FlagshipLayout title="Kits — VOLYNX" description="Open your purchased Portfolio, Agency, and SaaS kits in Builder, manage tier licenses, recover preset drafts." pageClass="page-kits-delivery">
  <FlagshipHeader ctaLabel="Open Builder" ctaI18n="header.open_builder" ctaHref={ROUTES.builder} />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero kits-hero">
      <div class="shell">
        <nav class="kits-breadcrumbs" aria-label="Breadcrumb">
          <a href={ROUTES.home}><span class="i18n-en">Home</span><span class="i18n-pt">Início</span></a>
          <span>/</span>
          <a href={ROUTES.delivery}><span class="i18n-en">My products</span><span class="i18n-pt">Meus produtos</span></a>
          <span>/</span>
          <span>Kits</span>
        </nav>

        <div class="hero-grid kits-hero-grid">
          <div class="hero-copy">
            <span class="eyebrow"><span class="i18n-en">Kit delivery</span><span class="i18n-pt">Entrega do kit</span></span>
            <h1><span class="i18n-en">Your VOLYNX kit is unlocked. Make it visible.</span><span class="i18n-pt">Seu kit VOLYNX foi liberado. Faça ele aparecer.</span></h1>
            <p>
              <span class="i18n-en">Thank you for backing the ecosystem. This is the handoff from checkout into production: premium structure, Builder access, protected source delivery and a clear path to ship.</span>
              <span class="i18n-pt">Obrigado por acreditar no ecossistema. Este e o handoff do checkout para a producao: estrutura premium, acesso ao Builder, fonte protegido e um caminho claro para publicar.</span>
            </p>
            <div class="hero-actions">
              <a href="#kitsGrid" class="button button--gold"><span class="i18n-en">Open my kit</span><span class="i18n-pt">Abrir meu kit</span></a>
              <a href={ROUTES.builder} class="button button--ghost"><span class="i18n-en">Open Builder</span><span class="i18n-pt">Abrir Builder</span></a>
            </div>
            <div class="kits-hero-proof" aria-label="Kit delivery highlights">
              <span><strong>Builder</strong><em>Draft-ready</em></span>
              <span><strong>Source</strong><em>Protected ZIP</em></span>
              <span><strong>Launch</strong><em>Production path</em></span>
            </div>
          </div>
          <div class="kits-hero-visual" aria-hidden="true">
            <span class="kits-hero-glow vx-glow-container vx-glow-container--gold vx-glow-container--strong vx-glow-container--xl">
              <img src="/assets/Volynx-OS-Cards/kits.webp" alt="" loading="eager" />
            </span>
          </div>
        </div>
      </div>
    </section>

    <PlatformAssistStrip
      eyebrow={{ en: "What this unlocks", pt: "O que isso libera" }}
      title={{ en: "A kit purchase should feel like opening a production system.", pt: "Comprar um kit precisa parecer abrir um sistema de producao." }}
      description={{ en: "The delivery screen keeps the premium promise visible: use the kit, recover the files, and keep the launch moving.", pt: "A tela de entrega mantém a promessa premium visível: use o kit, recupere os arquivos e avance com o lançamento." }}
      items={assistItems}
    />

    <section class="page-section page-section--tight kits-values-band" aria-label="VOLYNX kit value">
      <div class="shell">
        <div class="kits-values">
          {kitValueItems.map((item) => (
            <article class="kits-value">
              <div class="kits-value__icon" aria-hidden="true">
                <img src={item.iconSrc} alt="" loading="eager" decoding="async" />
              </div>
              <div class="kits-value__copy">
                <span class="kits-value__light" aria-hidden="true"></span>
                <h2><span class="i18n-en">{item.label.en}</span><span class="i18n-pt">{item.label.pt}</span></h2>
                <p><span class="i18n-en">{item.copy.en}</span><span class="i18n-pt">{item.copy.pt}</span></p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ PURCHASES ═══ -->
    <section class="page-section">
      <div class="shell">
        <div class="kits-section-head">
          <span class="eyebrow"><span class="i18n-en">Unlocked for you</span><span class="i18n-pt">Liberado para você</span></span>
          <h2><span class="i18n-en">Your purchased kits</span><span class="i18n-pt">Seus kits comprados</span></h2>
          <p>
            <span class="i18n-en">Start in Builder for the fastest premium path. Use source ZIP delivery only when you need advanced code handoff.</span>
            <span class="i18n-pt">Comece pelo Builder para seguir pelo fluxo premium mais rápido. Use o arquivo ZIP com o código-fonte apenas quando precisar de uma entrega técnica avançada.</span>
          </p>
        </div>

        <!-- Loading state -->
        <div id="kitsLoading" class="kits-state">
          <div class="kits-spinner" aria-hidden="true"></div>
          <p class="kits-state__label"><span class="i18n-en">Loading your kits...</span><span class="i18n-pt">Carregando seus kits...</span></p>
        </div>

        <!-- Error state -->
        <div id="kitsError" class="kits-state" style="display:none;">
          <p class="kits-state__label kits-state__label--error" id="kitsErrorMsg"><span class="i18n-en">Something went wrong. Please try again.</span><span class="i18n-pt">Algo deu errado. Tente novamente.</span></p>
          <div class="kits-state__actions">
            <a href={ROUTES.login + "?next=/dashboard/purchases/kits/"} class="button button--ghost"><span class="i18n-en">Sign in again</span><span class="i18n-pt">Entrar novamente</span></a>
            <a href={ROUTES.support + "?product=kits"} class="button button--ghost"><span class="i18n-en">Open support</span><span class="i18n-pt">Abrir suporte</span></a>
          </div>
        </div>

        <!-- Empty state -->
        <div id="kitsEmpty" class="kits-state" style="display:none;">
          <p class="kits-state__label"><span class="i18n-en">You don't have any kits yet.</span><span class="i18n-pt">Você ainda não tem kits.</span></p>
          <a href={ROUTES.products} class="button button--gold"><span class="i18n-en">Browse Portfolio · Agency · SaaS</span><span class="i18n-pt">Ver Portfolio · Agency · SaaS</span></a>
        </div>

        <!-- Fresh checkout / webhook pending state -->
        <div id="kitsPending" class="kits-state kits-state--pending" style="display:none;">
          <p class="kits-state__label">
            <span class="i18n-en">Your checkout is confirmed. We are preparing the kit card.</span>
            <span class="i18n-pt">Seu checkout foi confirmado. Estamos preparando o card do kit.</span>
          </p>
          <p class="kits-state__hint">
            <span class="i18n-en">This can take a few seconds while Stripe and VOLYNX sync the Builder draft and protected source delivery.</span>
            <span class="i18n-pt">Isso pode levar alguns segundos enquanto Stripe e VOLYNX sincronizam o draft no Builder e a entrega protegida do fonte.</span>
          </p>
          <div class="kits-state__actions">
            <button type="button" class="button button--gold" id="kitsPendingRetry">
              <span class="i18n-en">Check again</span><span class="i18n-pt">Verificar novamente</span>
            </button>
            <a href={ROUTES.portfolioKitPreview} class="button button--ghost">
              <span class="i18n-en">View a kit demo</span><span class="i18n-pt">Ver demo de um kit</span>
            </a>
            <a href={ROUTES.support + "?product=kits&intent=checkout-pending"} class="button button--ghost">
              <span class="i18n-en">Open support</span><span class="i18n-pt">Abrir suporte</span>
            </a>
          </div>
        </div>

        <!-- Purchase grid -->
        <div id="kitsGrid" class="kits-grid" style="display:none;" aria-live="polite"></div>

      </div>
    </section>

    <section class="page-section page-section--tight">
      <div class="shell">
        <DeliveryTrustStrip productName="kit" />
      </div>
    </section>

    <!-- ═══ RECOVERY ═══ -->
    <section class="page-section">
      <div class="shell kits-help panel">
        <div>
          <span class="eyebrow"><span class="i18n-en">Need a hand?</span><span class="i18n-pt">Precisa de ajuda?</span></span>
          <strong><span class="i18n-en">Preset didn't auto-load?</span><span class="i18n-pt">Preset não carregou automaticamente?</span></strong>
          <p>
            <span class="i18n-en">Click <em>Set up in Builder</em> on any card. Builder will pick up the preset and create your project draft from scratch.</span>
            <span class="i18n-pt">Clique em <em>Configurar no Builder</em> em qualquer card. O Builder pega o preset e cria seu projeto draft do zero.</span>
          </p>
        </div>
        <div class="hero-actions">
          <a href={ROUTES.support + "?product=kits&intent=delivery"} class="button button--ghost"><span class="i18n-en">Contact support</span><span class="i18n-pt">Falar com suporte</span></a>
        </div>
      </div>
    </section>

  </main>
  <FlagshipFooter />

  <script is:inline type="module">
    // ── Auth guard ────────────────────────────────────────────────────────
    const token = localStorage.getItem('volynx_access_token');
    if (!token) {
      if (window.VxReturn) window.VxReturn.redirectToLogin();
      else window.location.href = '/login/?next=/dashboard/purchases/kits/';
    }

    function show(id) { const el = document.getElementById(id); if (el) el.style.display = ''; }
    function hide(id) { const el = document.getElementById(id); if (el) el.style.display = 'none'; }

    function jwtSub(jwt) {
      try {
        const part = String(jwt || '').split('.')[1];
        if (!part) return null;
        const normalized = part.replace(/-/g, '+').replace(/_/g, '/');
        const payload = JSON.parse(atob(normalized.padEnd(normalized.length + (4 - normalized.length % 4) % 4, '=')));
        return payload?.sub || null;
      } catch { return null; }
    }

    // Per-family branding. Keep in sync with Volynx-OS demo themes:
    // portfolio = teal, agency = violet, saas = cyan.
    const KIT_FAMILIES = {
      portfolio: {
        en: 'Portfolio Pro Kit', pt: 'Portfolio Pro Kit',
        tone: 'portfolio',
        preset: 'portfolio',
        product_url: '/products/portfolio-pro-kit/',
      },
      agency: {
        en: 'Agency Launch Kit', pt: 'Agency Launch Kit',
        tone: 'agency',
        preset: 'agency',
        product_url: '/products/agency-launch-kit/',
      },
      saas: {
        en: 'SaaS Landing System', pt: 'SaaS Landing System',
        tone: 'saas',
        preset: 'saas',
        product_url: '/products/saas-landing-system/',
      },
    };

    const TIER_LABELS = {
      personal:     { en: 'Starter',  pt: 'Starter' },
      commercial:   { en: 'Pro',      pt: 'Pro' },
      studio:       { en: 'Studio',   pt: 'Studio' },
    };

    /** Identify the kit family from a kit_* addon_id. */
    function kitFamily(addonId) {
      const id = String(addonId || '').toLowerCase();
      if (id.startsWith('kit_portfolio') || id.startsWith('kit-portfolio')) return 'portfolio';
      if (id.startsWith('kit_agency')    || id.startsWith('kit-agency'))    return 'agency';
      if (id.startsWith('kit_saas')      || id.startsWith('kit-saas'))      return 'saas';
      // landing_express maps to saas family per webhook presetMap
      if (id.startsWith('kit_landing')   || id.startsWith('kit-landing'))   return 'saas';
      return null;
    }

    /** Extract tier suffix from kit_* addon_id. */
    function kitTier(addonId, metaTier) {
      if (metaTier) return metaTier;
      const normalized = String(addonId || '').toLowerCase().replace(/_e2e$/, '').replace(/-e2e$/, '');
      const m = normalized.match(/[_-](personal|commercial|studio)$/);
      return m ? m[1] : null;
    }

    function isKitAddon(addonId) {
      return kitFamily(addonId) !== null;
    }

    function parseMeta(value) {
      if (!value) return {};
      if (typeof value === 'string') {
        try { return JSON.parse(value); } catch { return {}; }
      }
      return typeof value === 'object' ? value : {};
    }

    function hasValue(value) {
      if (value == null) return false;
      if (typeof value === 'string') return value.trim() !== '';
      return true;
    }

    function firstValue(...values) {
      for (const value of values) {
        if (hasValue(value)) return value;
      }
      return null;
    }

    function stripCurrencySuffix(value) {
      return String(value || '')
        .trim()
        .replace(/_(gbp|eur|brl)$/i, '')
        .replace(/-(gbp|eur|brl)$/i, '');
    }

    function canonicalAddonId(value) {
      return stripCurrencySuffix(value).toLowerCase();
    }

    function purchaseSessionId(item) {
      const meta = parseMeta(item?.metadata);
      return String(meta.stripe_session_id || item?.stripe_session_id || '').trim();
    }

    function samePurchase(a, b) {
      const aSession = purchaseSessionId(a);
      const bSession = purchaseSessionId(b);
      if (aSession && bSession) return aSession === bSession;
      return false;
    }

    function mergedMetadata(baseItem, incomingItem) {
      return {
        ...parseMeta(incomingItem?.metadata),
        ...parseMeta(baseItem?.metadata),
      };
    }

    function mergedPricePaid(baseItem, incomingItem) {
      const basePrice = baseItem?.price_paid;
      const incomingPrice = incomingItem?.price_paid;
      const incomingAmountPaid = incomingItem?.amount_paid;

      if (hasValue(basePrice)) return basePrice;
      if (hasValue(incomingPrice)) return incomingPrice;
      if (typeof incomingAmountPaid === 'number') return incomingAmountPaid / 100;
      return null;
    }

    function mergePurchaseRecords(baseItem, incomingItem) {
      const metadata = mergedMetadata(baseItem, incomingItem);
      const baseAddonId = canonicalAddonId(baseItem?.addon_id || baseItem?.lookup_key);
      const incomingAddonId = canonicalAddonId(incomingItem?.addon_id || incomingItem?.lookup_key);

      return {
        ...incomingItem,
        ...baseItem,
        id: firstValue(baseItem?.id, incomingItem?.id),
        addon_id: firstValue(
          baseAddonId,
          incomingAddonId,
          canonicalAddonId(metadata.lookup_key),
          canonicalAddonId(metadata.stripe_lookup_key)
        ),
        lookup_key: firstValue(
          baseItem?.lookup_key,
          incomingItem?.lookup_key,
          metadata.lookup_key,
          metadata.stripe_lookup_key
        ),
        stripe_session_id: firstValue(
          purchaseSessionId(baseItem),
          purchaseSessionId(incomingItem),
          metadata.stripe_session_id
        ),
        purchase_id: firstValue(
          baseItem?.purchase_id,
          incomingItem?.purchase_id,
          baseItem?.source === 'addon' ? baseItem?.id : null,
          incomingItem?.source === 'addon' ? incomingItem?.id : null
        ),
        price_paid: mergedPricePaid(baseItem, incomingItem),
        currency: firstValue(baseItem?.currency, incomingItem?.currency),
        status: firstValue(baseItem?.status, incomingItem?.status, 'completed'),
        created_at: firstValue(baseItem?.created_at, incomingItem?.created_at),
        metadata,
      };
    }

    function fmtDate(iso) {
      if (!iso) return '';
      try {
        return new Date(iso).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
      } catch { return iso; }
    }

    function fmtMoney(amount, currency) {
      if (amount == null) return '';
      try {
        const n = typeof amount === 'number' ? amount : parseFloat(amount);
        return new Intl.NumberFormat(undefined, { style: 'currency', currency: (currency || 'GBP').toUpperCase() }).format(n);
      } catch { return String(amount); }
    }

    function statusPill(meta) {
      const s = meta?.delivery_status || (meta?.download_url ? 'ready' : meta?.project_slug ? 'ready' : 'pending_signed_url');
      const map = {
        ready:                  { en: 'Ready', pt: 'Pronto',           tone: 'ok' },
        pending_signed_url:     { en: 'Awaiting link', pt: 'Aguardando link', tone: 'warn' },
        pending_preset_fetch:   { en: 'Awaiting setup', pt: 'Aguardando setup', tone: 'warn' },
        missing_storage_asset:  { en: 'Awaiting upload', pt: 'Aguardando upload', tone: 'warn' },
        refunded:               { en: 'Refunded', pt: 'Reembolsado',   tone: 'muted' },
        canceled:               { en: 'Canceled', pt: 'Cancelado',     tone: 'muted' },
      };
      const label = map[s] || { en: s, pt: s, tone: 'muted' };
      return `<span class="kit-pill kit-pill--${label.tone}"><span class="i18n-en">${label.en}</span><span class="i18n-pt">${label.pt}</span></span>`;
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    /** Pretty-print an addon_entitlement feature key (e.g. "agency_proposal_full" → "Proposal full"). */
    function prettyFeature(key) {
      const stripped = String(key).replace(/^(kit_|portfolio_|agency_|saas_)/, '').replace(/_/g, ' ');
      return stripped.charAt(0).toUpperCase() + stripped.slice(1);
    }

    function featureList(features) {
      const arr = Array.isArray(features) ? features : [];
      if (arr.length === 0) return '';
      const items = arr.slice(0, 14).map(f => `<li>${escapeHtml(prettyFeature(f))}</li>`).join('');
      return `<details class="kit-features">
        <summary><span class="i18n-en">License + sections (${arr.length})</span><span class="i18n-pt">Licença + seções (${arr.length})</span></summary>
        <ul>${items}</ul>
      </details>`;
    }

    /** Returns true when a stored signed download URL is still usable. */
    function isDownloadValid(meta) {
      if (!meta || !meta.download_url) return false;
      const exp = meta.download_expires_at ? new Date(meta.download_expires_at).getTime() : 0;
      // <60s away from expiry counts as expired so we never serve a URL
      // that dies mid-request.
      return Number.isFinite(exp) && exp - Date.now() > 60_000;
    }

    function buildCard(item, entitlements) {
      const addonId = canonicalAddonId(item.addon_id || item.lookup_key);
      const family = kitFamily(addonId);
      if (!family) return '';
      const fam = KIT_FAMILIES[family];

      const meta = parseMeta(item.metadata);
      const tier = kitTier(addonId, meta.tier);
      const tierLabel = (tier && TIER_LABELS[tier]) || null;

      const purchaseDate = fmtDate(item.created_at);
      const price = fmtMoney(item.price_paid, item.currency);

      const projectId = item.project_id || meta.project_id || null;
      const projectSlug = meta.project_slug || null;
      const projectRef = projectId || projectSlug;
      const presetId = meta.preset_id || fam.preset;
      const downloadValid = isDownloadValid(meta);
      const expiresLabel = meta.download_expires_at ? fmtDate(meta.download_expires_at) : '';
      const purchaseId = item.purchase_id || null;

      const features = entitlements?.[addonId]?.features || meta.features || [];
      const description = entitlements?.[addonId]?.description || '';
      const featureCount = Array.isArray(features) ? features.length : 0;
      const valueLine = featureCount > 0
        ? `<span class="i18n-en">${featureCount} licensed sections and assets are connected to this purchase.</span><span class="i18n-pt">${featureCount} seções e recursos licenciados estão vinculados a esta compra.</span>`
        : `<span class="i18n-en">Builder access and source delivery are connected to this purchase.</span><span class="i18n-pt">O acesso ao Builder e a entrega do código-fonte estão vinculados a esta compra.</span>`;

      // Builder is the premium path for non-technical buyers. Source ZIPs stay
      // available as an advanced fallback for developers and agency handoff.
      const primary = projectRef
        ? `<a href="/builder/?project=${encodeURIComponent(projectRef)}" class="button button--gold kit-card__cta">
             <span class="i18n-en">Customize my site</span><span class="i18n-pt">Personalizar meu site</span>
           </a>`
        : `<a href="/builder/?preset=${encodeURIComponent(presetId)}" class="button button--gold kit-card__cta">
             <span class="i18n-en">Start customizing</span><span class="i18n-pt">Começar a personalizar</span>
           </a>`;

      const sourceSecondary = downloadValid
        ? `<a href="${escapeHtml(meta.download_url)}" class="button button--ghost kit-card__cta-secondary" download>
             <span class="i18n-en">Download source ZIP (advanced)</span><span class="i18n-pt">Baixar ZIP fonte (avançado)</span>
           </a>`
        : `<button type="button" class="button button--ghost kit-card__cta-secondary kit-card__refresh"
                   ${purchaseId ? `data-purchase-id="${escapeHtml(purchaseId)}"` : ''}
                   data-addon-id="${escapeHtml(addonId)}">
             <span class="i18n-en">Generate source ZIP link</span><span class="i18n-pt">Gerar link do ZIP fonte</span>
           </button>`;

      const errorNote = meta.delivery_error
        ? `<p class="kit-card__error">${escapeHtml(String(meta.delivery_error))}</p>`
        : '';

      return `
        <article class="panel kit-card kit-card--${fam.tone}" data-row-id="${escapeHtml(item.id)}">
          <div class="kit-card__glow" aria-hidden="true"></div>
          <header class="kit-card__head">
            <div class="kit-card__title">
              <span class="eyebrow">${statusPill(meta)}</span>
