---
import FaviconHead from "../components/FaviconHead.astro";

const target = '/products/volynx-icons-store/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={`https://volynx.world${target}`} />
    <title>Redirecting…</title>
    <FaviconHead />
    <script is:inline>window.location.replace('/products/volynx-icons-store/');</script>
  </head>
  <body>
    <p><a href={target}>Open Icons Store</a></p>
  </body>
</html>
