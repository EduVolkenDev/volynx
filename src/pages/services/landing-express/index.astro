---
import "../../../styles/landing-express.css";
import PageWidgets from "../../../components/PageWidgets.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import Topbar from "../../../components/Topbar.astro";
import { ROUTES } from "../../../data/routes";
const pageTitle = "VOLYNX — Landing Express";
const pageDescription = "Premium, conversion-focused landing page. Delivered in 48–72h. Stripe checkout + contact form included.";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#070814" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/site.webmanifest" />
</head>

<body>
  <div class="bg" aria-hidden="true"></div>

  <script is:inline type="module" src="/scripts/landing-express.js"></script>

  <Topbar leftLinks={[{ href: "#pain", label: "Problem", i18n: "le.nav_problem" }, { href: "#solution", label: "Solution", i18n: "le.nav_solution" }, { href: "#scope", label: "Included", i18n: "le.nav_included" }, { href: "#proof", label: "Proof", i18n: "le.nav_proof" }, { href: "#contact", label: "Contact", i18n: "le.nav_contact" }]} rightLinks={[{ href: "#contact", label: "Get started", i18n: "le.nav_start" }]} />

  <main>
    <div class="wrap">
      <!-- HERO -->
      <section class="hero" id="top">
        <div class="kicker">
          <span class="pill" data-i18n="le.pill_premium">Premium</span>
          <span class="pill" data-i18n="le.pill_conversion">Conversion-first</span>
          <span class="pill" data-i18n="le.pill_delivery">Delivered in 48–72h</span>
        </div>

        <h1 data-i18n="le.hero_title">Stop losing leads to a slow, generic landing page.</h1>
        <p class="sub" data-i18n="le.hero_sub">
          A premium, responsive, conversion-focused landing page — built to turn
          traffic into clients, with Stripe checkout and a proper contact form. Powered by Volynx Builder.
        </p>

        <div class="ctaRow">
          <a class="btn btn--primary" id="heroCta" href={`${ROUTES.contact}?product=landing-express`} target="_blank" rel="noopener" data-i18n="le.hero_cta">
            Book Landing Express now
          </a>
          <a class="btn btn--ghost" href="#contact" data-i18n="le.hero_cta2">Talk about a bigger project</a>
        </div>

        <div class="trustRow">
          <span class="pill" data-i18n="le.trust_stripe">Secure payment via Stripe</span>
          <span class="pill" data-i18n="le.trust_scope">Clear scope</span>
          <span class="pill" data-i18n="le.trust_revisions">Revisions included</span>
        </div>
      </section>

      <!-- PROBLEM -->
      <section class="section" id="pain">
        <h2 data-i18n="le.pain_title">The problem isn't your traffic. It's the leak.</h2>
        <p class="p" data-i18n="le.pain_desc">
          When a visitor lands and doesn't instantly understand the value, the page becomes a leaky funnel.
          A leaky funnel doesn't scale — it just burns budget and time.
        </p>
        <div class="grid grid3">
          <div class="card">
            <h3 data-i18n="le.pain_card1_title">No hierarchy</h3>
            <p data-i18n="le.pain_card1_desc">Good-looking design with no direction. The visitor doesn't know where to click or why.</p>
          </div>
          <div class="card">
            <h3 data-i18n="le.pain_card2_title">Mobile is broken</h3>
            <p data-i18n="le.pain_card2_desc">Most decisions happen on mobile. If the experience is poor there, conversion dies there.</p>
          </div>
          <div class="card">
            <h3 data-i18n="le.pain_card3_title">Friction everywhere</h3>
            <p data-i18n="le.pain_card3_desc">Weak CTA, slow load, confusing layout. Doubt wins over the click.</p>
          </div>
        </div>
      </section>

      <!-- SOLUTION -->
      <section class="section" id="solution">
        <h2 data-i18n="le.sol_title">The VOLYNX approach: premium design + conversion engineering.</h2>
        <p class="p" data-i18n="le.sol_desc">
          Straight-line structure: clear promise, proof, scope, strong CTA. No maze, no ten options. One path.
        </p>

        <div class="grid grid3">
          <div class="card">
            <h3 data-i18n="le.sol_card1_title">Conversion</h3>
            <p data-i18n="le.sol_card1_desc">Copy and layout designed to drive the click — reducing hesitation at every step.</p>
          </div>
          <div class="card">
            <h3 data-i18n="le.sol_card2_title">Performance</h3>
            <p data-i18n="le.sol_card2_desc">Fast and lean so load time never kills the buying impulse.</p>
          </div>
          <div class="card">
            <h3 data-i18n="le.sol_card3_title">Mobile-first</h3>
            <p data-i18n="le.sol_card3_desc">Readable, breathable, with CTA always in reach — no broken layouts on small screens.</p>
          </div>
        </div>
      </section>

      <!-- SCOPE -->
      <section class="section" id="scope">
        <h2 data-i18n="le.scope_title">What's included in Landing Express</h2>
        <p class="p" data-i18n="le.scope_desc">A clear, objective scope to deliver fast and at a premium standard.</p>

        <div class="grid grid2">
          <div class="card">
            <h3 data-i18n="le.scope_delivery_title">Delivery</h3>
            <ul>
              <li data-i18n="le.scope_d1">1 landing page with conversion structure (all sections)</li>
              <li data-i18n="le.scope_d2">Full responsiveness (mobile, tablet, desktop)</li>
              <li data-i18n="le.scope_d3">Performance baseline (assets, loading, core web vitals)</li>
              <li data-i18n="le.scope_d4">Basic SEO (title, description, heading hierarchy)</li>
            </ul>
          </div>

          <div class="card">
            <h3 data-i18n="le.scope_ops_title">Operations</h3>
            <ul>
              <li data-i18n="le.scope_o1">CTA with Stripe (Payment Link or Buy Button)</li>
              <li data-i18n="le.scope_o2">Contact form via Formspree (no broken mailto)</li>
              <li data-i18n="le.scope_o3">Social proof blocks (cases, logos, numbers)</li>
              <li data-i18n="le.scope_o4">Smooth anchors and page navigation</li>
            </ul>
          </div>
        </div>

        <div class="midCta">
          <div>
            <h3 style="margin:0 0 6px;" data-i18n="le.mid_title">Ready to turn traffic into clients?</h3>
            <p class="p" style="margin:0;" data-i18n="le.mid_desc">One path. One click. No friction.</p>
          </div>
          <a class="btn btn--primary" id="midCta" href={`${ROUTES.contact}?product=landing-express`} target="_blank" rel="noopener" data-i18n="le.mid_cta">
            Book my Landing Express
          </a>
        </div>
      </section>

      <!-- PROOF -->
      <section class="section" id="proof">
        <h2 data-i18n="le.proof_title">What a VOLYNX landing looks like in practice</h2>
        <p class="p" data-i18n="le.proof_desc">
          Real project. Studios Valcarce — luxury residential complex landing page with bilingual content,
          custom VOLYNX icons, appointment scheduling and AI chat.
        </p>

        <div class="grid grid3">
          <div class="card">
            <div class="metric" data-i18n="le.proof_m1_val">48–72h</div>
            <p data-i18n="le.proof_m1_desc">Delivery time from brief to live page — mobile-first, conversion-ready.</p>
          </div>
          <div class="card">
            <div class="metric" data-i18n="le.proof_m2_val">Bilingual</div>
            <p data-i18n="le.proof_m2_desc">Studios Valcarce: EN + ES. Designed to convert international buyers from day one.</p>
          </div>
          <div class="card">
            <div class="metric" data-i18n="le.proof_m3_val">Custom</div>
            <p data-i18n="le.proof_m3_desc">VOLYNX Icons, on-brand palette, AI chat widget. Every section designed to close.</p>
          </div>
        </div>

        <div class="logos" aria-label="Real project reference">
          <a class="logoPill" href="https://eduvolkendev.github.io/Valcarce/" target="_blank" rel="noopener noreferrer" style="text-decoration:none;color:inherit;">Studios Valcarce →</a>
        </div>
      </section>

      <!-- CONTACT -->
      <section class="section" id="contact">
        <h2 data-i18n="le.contact_title">Bigger project? Send a brief.</h2>
        <p class="p" data-i18n="le.contact_desc">
          No broken mailto. Send this and we'll come back with next steps — scope, timeline, and investment.
        </p>

        <form id="briefForm" action="/contact/?product=landing-express" method="POST">
          <div>
            <label for="name" data-i18n="le.form_name">Your name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>

          <div>
            <label for="email" data-i18n="le.form_email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>

          <div>
            <label for="message" data-i18n="le.form_details">Project details</label>
            <textarea id="message" name="message" rows="6" required
              data-i18n-placeholder="le.form_ph_details"
              placeholder="What are you selling? What's the goal? Timeline? Current site (if any). References…"></textarea>
          </div>

          <!-- Honeypot anti-spam -->
          <input type="text" name="_gotcha" style="display:none" />

          <label class="consent">
            <input type="checkbox" required />
            <span data-i18n="le.form_consent">I agree to be contacted about this request.</span>
          </label>

          <button class="btn btn--primary" type="submit" data-i18n="le.form_submit">Send brief</button>
          <p class="note" data-i18n="le.form_note">Response within business hours. No spam. No fluff.</p>
        </form>
      </section>

      <!-- FINAL CTA -->
      <section class="section final" id="cta">
        <h2 data-i18n="le.final_title">If the decision is "grow", the next step is simple.</h2>
        <p class="p" data-i18n="le.final_desc">Complete checkout. After that, your guided Builder flow begins immediately.</p>

        <div class="ctaRow">
          <a class="btn btn--primary" id="finalCta" href={`${ROUTES.contact}?product=landing-express`} target="_blank" rel="noopener" data-i18n="le.hero_cta">
            Book Landing Express now
          </a>
          <a class="btn btn--ghost" href="#contact" data-i18n="le.final_cta2">I have a bigger project</a>
        </div>

        <div class="trustRow" style="justify-content:flex-start;">
          <span class="pill" data-i18n="le.trust_checkout">Stripe checkout</span>
          <span class="pill" data-i18n="le.pill_delivery">48–72h delivery</span>
          <span class="pill" data-i18n="le.trust_revisions">Revisions included</span>
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
  <PageWidgets hideUtilBar />
</body>
</html>
