---
import FlagshipLayout from "../../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../../components/FlagshipFooter.astro";
import { ROUTES } from "../../../data/routes";

const briefHref = `${ROUTES.contact}?product=services&intent=conversion-fix&source=conversion-fix-campaign`;
const campaignSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "VOLYNX Website Conversion Fix",
  "serviceType": "Website conversion improvement sprint",
  "provider": { "@type": "Organization", "name": "VOLYNX", "url": "https://volynx.world" },
  "areaServed": ["GB", "BR", "Worldwide"],
  "offers": {
    "@type": "Offer",
    "priceCurrency": "GBP",
    "price": "249",
    "url": "https://volynx.world/services/conversion-fix/",
    "description": "Fixed-scope conversion improvement sprint delivered from £249.",
  },
};
---

<FlagshipLayout
  title="Website Conversion Fix in 48h — VOLYNX"
  description="A focused 48-hour sprint to find the friction, sharpen your message and make the next click obvious. From £249."
  pageClass="page-conversion-fix"
>
  <FlagshipHeader current={ROUTES.conversionFix} ctaLabel="Send your URL" ctaI18n="svc2.fix_cta" ctaHref={briefHref} />

  <main>
    <script type="application/ld+json" set:html={JSON.stringify(campaignSchema)} />
    <section class="cf-hero">
      <div class="shell cf-hero-grid">
        <div class="cf-hero-copy">
          <span class="eyebrow"><span class="i18n-en">Website Conversion Fix · 48 hours</span><span class="i18n-pt">Website Conversion Fix · 48 horas</span></span>
          <h1><span class="i18n-en">Your site may not need a rebuild. It may need a clearer next step.</span><span class="i18n-pt">Seu site talvez não precise ser refeito. Talvez precise de um próximo passo mais claro.</span></h1>
          <p class="cf-lead"><span class="i18n-en">Send your URL and the business goal. VOLYNX finds the highest-impact friction and ships a focused improvement sprint in 48 hours.</span><span class="i18n-pt">Envie sua URL e o objetivo do negócio. A VOLYNX encontra o maior ponto de atrito e entrega uma melhoria focada em 48 horas.</span></p>
          <div class="cf-actions">
            <a class="button button--gold" href={briefHref} data-analytics-event="conversion_fix_brief"><span class="i18n-en">Get the 3-point preview →</span><span class="i18n-pt">Receber o preview de 3 pontos →</span></a>
            <a class="button button--ghost" href="#included" data-analytics-event="conversion_fix_scope"><span class="i18n-en">See what is included</span><span class="i18n-pt">Ver o que está incluído</span></a>
          </div>
          <div class="cf-proof-row" aria-label="Conversion Fix facts">
            <div><strong>£249+</strong><span><span class="i18n-en">fixed starting point</span><span class="i18n-pt">a partir de valor fechado</span></span></div>
            <div><strong>48h</strong><span><span class="i18n-en">focused delivery</span><span class="i18n-pt">entrega focada</span></span></div>
            <div><strong>1 URL</strong><span><span class="i18n-en">where we start</span><span class="i18n-pt">por onde começamos</span></span></div>
          </div>
        </div>

        <aside class="cf-offer-card panel panel--pro">
          <span class="label label--pro"><span class="i18n-en">The fastest useful intervention</span><span class="i18n-pt">A intervenção útil mais rápida</span></span>
          <h2><span class="i18n-en">Stop losing the next click.</span><span class="i18n-pt">Pare de perder o próximo clique.</span></h2>
          <ul>
            <li><span class="i18n-en">Mobile, message, trust and CTA review</span><span class="i18n-pt">Revisão de mobile, mensagem, confiança e CTA</span></li>
            <li><span class="i18n-en">Three prioritised changes</span><span class="i18n-pt">Três mudanças priorizadas</span></li>
            <li><span class="i18n-en">One focused implementation sprint</span><span class="i18n-pt">Uma implementação focada</span></li>
          </ul>
          <strong class="cf-price"><span class="i18n-en">From £249</span><span class="i18n-pt">A partir de £249</span></strong>
          <span class="cf-price-note"><span class="i18n-en">Final scope confirmed before work starts.</span><span class="i18n-pt">Escopo final confirmado antes do início.</span></span>
        </aside>
      </div>
    </section>

    <section id="included" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">What changes</span><span class="i18n-pt">O que muda</span></span>
        <h2><span class="i18n-en">A small sprint aimed at the place money is getting stuck.</span><span class="i18n-pt">Um sprint pequeno focado no ponto em que o dinheiro está travando.</span></h2>
        <p><span class="i18n-en">No vague audit and no pressure to buy a full rebuild. We identify the smallest useful intervention first.</span><span class="i18n-pt">Sem auditoria vaga e sem pressão para comprar um site inteiro. Primeiro identificamos a menor intervenção útil.</span></p>
      </div>
      <div class="shell grid-3 cf-includes-grid">
        <article class="panel cf-card"><span class="cf-number">01</span><h3><span class="i18n-en">Find the friction</span><span class="i18n-pt">Encontrar o atrito</span></h3><p><span class="i18n-en">We review the first impression, mobile path, offer clarity, trust signals and the primary CTA.</span><span class="i18n-pt">Revisamos primeira impressão, caminho mobile, clareza da oferta, sinais de confiança e CTA principal.</span></p></article>
        <article class="panel cf-card"><span class="cf-number">02</span><h3><span class="i18n-en">Make the action obvious</span><span class="i18n-pt">Tornar a ação óbvia</span></h3><p><span class="i18n-en">You receive three changes ranked by impact, effort and proximity to a booking, enquiry or purchase.</span><span class="i18n-pt">Você recebe três mudanças ordenadas por impacto, esforço e proximidade de uma reserva, contato ou compra.</span></p></article>
        <article class="panel cf-card"><span class="cf-number">03</span><h3><span class="i18n-en">Ship the fix</span><span class="i18n-pt">Publicar a melhoria</span></h3><p><span class="i18n-en">The focused implementation is tested and handed back with clear next steps.</span><span class="i18n-pt">A implementação focada é testada e devolvida com próximos passos claros.</span></p></article>
      </div>
    </section>

    <section class="page-section cf-fit-section">
      <div class="shell cf-fit-grid">
        <div>
          <span class="eyebrow"><span class="i18n-en">This is for you if</span><span class="i18n-pt">É para você se</span></span>
          <h2><span class="i18n-en">You already have something live, but it is not pulling its weight.</span><span class="i18n-pt">Você já tem algo publicado, mas ele não está trabalhando a favor do negócio.</span></h2>
        </div>
        <ul class="cf-fit-list">
          <li><span class="i18n-en">Visitors arrive but do not understand the offer quickly.</span><span class="i18n-pt">As pessoas chegam, mas não entendem a oferta rapidamente.</span></li>
          <li><span class="i18n-en">The mobile experience makes booking or contacting you harder.</span><span class="i18n-pt">A experiência mobile dificulta agendar ou entrar em contato.</span></li>
          <li><span class="i18n-en">You want evidence before committing to a complete rebuild.</span><span class="i18n-pt">Você quer evidência antes de investir em um site completo.</span></li>
        </ul>
      </div>
    </section>

    <section class="page-section page-section--last">
      <div class="shell cf-final panel panel--pro">
        <span class="eyebrow"><span class="i18n-en">Start with the smallest useful step</span><span class="i18n-pt">Comece pelo menor passo útil</span></span>
        <h2><span class="i18n-en">Send the URL. We will tell you where the next customer is getting lost.</span><span class="i18n-pt">Envie a URL. Vamos mostrar onde o próximo cliente está se perdendo.</span></h2>
        <p><span class="i18n-en">No full audit required. Share the site, the business goal and what feels stuck.</span><span class="i18n-pt">Não é preciso uma auditoria completa. Envie o site, o objetivo e o que parece travado.</span></p>
        <a class="button button--gold" href={briefHref} data-analytics-event="conversion_fix_final_cta"><span class="i18n-en">Send my URL →</span><span class="i18n-pt">Enviar minha URL →</span></a>
      </div>
    </section>
  </main>

  <FlagshipFooter />
</FlagshipLayout>

<style>
  .page-conversion-fix .cf-hero { padding: clamp(56px, 8vw, 112px) 0 clamp(42px, 6vw, 78px); }
  .cf-hero-grid { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(280px, .88fr); gap: clamp(28px, 6vw, 84px); align-items: center; }
  .cf-hero-copy h1 { max-width: 760px; margin: 16px 0 20px; font-size: clamp(2.7rem, 6vw, 6rem); line-height: .98; letter-spacing: -.05em; }
  .cf-lead { max-width: 660px; margin: 0; color: var(--muted, rgba(209,215,230,.74)); font-size: clamp(1rem, 1.45vw, 1.25rem); line-height: 1.65; }
  .cf-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .cf-proof-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; max-width: 680px; margin-top: 30px; }
  .cf-proof-row > div { display: grid; gap: 3px; padding: 13px 12px; border: 1px solid rgba(255,255,255,.09); border-radius: 15px; background: rgba(255,255,255,.035); }
  .cf-proof-row strong, .cf-price, .cf-number { color: var(--cyan, #8bfaf0); }
  .cf-proof-row span { color: var(--muted, rgba(209,215,230,.74)); font-size: .72rem; line-height: 1.35; }
  .cf-offer-card { display: grid; gap: 16px; padding: clamp(24px, 4vw, 38px); background: radial-gradient(circle at 100% 0%, rgba(139,250,240,.16), transparent 52%), rgba(255,255,255,.045); }
  .cf-offer-card h2 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.7rem); letter-spacing: -.04em; }
  .cf-offer-card ul { display: grid; gap: 10px; margin: 0; padding-left: 20px; color: var(--muted, rgba(209,215,230,.74)); line-height: 1.55; }
  .cf-price { font-size: 1.65rem; font-weight: 800; }
  .cf-price-note { color: var(--muted, rgba(209,215,230,.74)); font-size: .82rem; }
  .cf-includes-grid { align-items: stretch; }
  .cf-card { min-height: 210px; }
  .cf-number { font-size: .8rem; letter-spacing: .16em; font-weight: 800; }
  .cf-card h3 { margin: 22px 0 10px; }
  .cf-card p { margin: 0; color: var(--muted, rgba(209,215,230,.74)); line-height: 1.65; }
  .cf-fit-section { background: linear-gradient(180deg, transparent, rgba(139,250,240,.035), transparent); }
  .cf-fit-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .9fr); gap: clamp(28px, 8vw, 120px); align-items: center; }
  .cf-fit-grid h2 { max-width: 720px; margin: 14px 0 0; font-size: clamp(2rem, 4vw, 4rem); line-height: 1.02; letter-spacing: -.045em; }
  .cf-fit-list { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
  .cf-fit-list li { padding: 18px 18px 18px 22px; border-left: 2px solid var(--cyan, #8bfaf0); border-radius: 0 14px 14px 0; background: rgba(255,255,255,.04); color: rgba(237,242,251,.82); line-height: 1.55; }
  .cf-final { display: grid; justify-items: center; gap: 14px; padding: clamp(30px, 5vw, 62px); text-align: center; background: radial-gradient(circle at 50% 0%, rgba(139,250,240,.14), transparent 54%), linear-gradient(135deg, rgba(255,255,255,.07), rgba(255,255,255,.025)); border-color: rgba(139,250,240,.22); }
  .cf-final h2 { max-width: 820px; margin: 0; font-size: clamp(2rem, 4vw, 4rem); line-height: 1.02; letter-spacing: -.045em; }
  .cf-final p { margin: 0; color: var(--muted, rgba(209,215,230,.74)); }
  @media (max-width: 900px) { .cf-hero-grid, .cf-fit-grid { grid-template-columns: 1fr; } .cf-hero-copy { text-align: center; } .cf-lead { margin-inline: auto; } .cf-actions, .cf-proof-row { justify-content: center; margin-inline: auto; } }
  @media (max-width: 560px) { .cf-hero-copy h1 { font-size: clamp(2.45rem, 12vw, 4rem); } .cf-proof-row { grid-template-columns: 1fr; max-width: 280px; } .cf-actions .button { width: 100%; text-align: center; } }
</style>
