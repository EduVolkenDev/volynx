---
import "../../styles/services.css";
import PageWidgets from "../../components/PageWidgets.astro";
import { ROUTES } from "../../data/routes";

const pageTitle = "VOLYNX — Premium Web Design";
const pageDescription = "VOLYNX crafts premium, conversion-focused websites and brand identities with fast delivery and intelligent design.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="format-detection" content="telephone=no,date=no,address=no,email=no" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/site.webmanifest" />
</head>

<body>
  <div class="wrap">
    <header class="globalnav" aria-label="VOLYNX global navigation">
      <div class="globalnav-left">
        <a class="globalnav-brand" href="#top" aria-label="Go to top">
          <img class="brand-eye" src="/assets/wordmark.webp" alt="VOLYNX Eye" decoding="async" loading="eager" />
        </a>
      </div>
      <nav class="globalnav-center" aria-label="Primary">
        <a href={ROUTES.home} data-i18n="services.nav.home">Home</a>
        <a href="#plans" data-i18n="services.nav.plans">Plans</a>
        <a href="#addons" data-i18n="services.nav.addons">Add-ons</a>
        <a href="#why-volynx" data-i18n="services.nav.why">Why</a>
        <a href="#contact" data-i18n="services.nav.contact">Contact</a>
      </nav>
      <div class="globalnav-right">
        <a class="top-whats" href={`${ROUTES.whatsapp}?text=I%20want%20a%20premium%20VOLYNX%20website`} target="_blank" rel="noopener noreferrer" data-i18n="svc.nav_whatsapp">WhatsApp</a>
        <select class="btn alt currency-select" aria-label="Choose currency">
          <option value="gbp">GBP £</option>
          <option value="eur" selected>EUR €</option>
        </select>
        <a class="btn primary" href="https://calendly.com/volynx-schedule-your-meeting/new-meeting" target="_blank" rel="noopener noreferrer" data-i18n="services.lets_talk">Let's Talk About Your Project!</a>
      </div>
    </header>

    <main class="main" role="main">
      <!-- HERO -->
      <section class="homepage-section" id="top">
        <div class="hero-unit">
          <div class="hero-grid">
            <div class="hero-copy">
              <div class="hero-eyebrow" data-i18n="services.hero.pill">• INTELLIGENCE • DESIGN • CONVERSION •</div>
              <div class="hero-logo" aria-label="VOLYNX">
                <img src="/assets/volynx-icon.webp" alt="VOLYNX" decoding="async" loading="eager" />
              </div>
              <p class="hero-subhead" data-i18n="services.hero.title">
                Premium websites engineered for conversion, shipped with a guided process that keeps you moving.
                You bring the vision. We operationalize it into a site that sells.
              </p>
              <div class="cta-links">
                <a class="btn primary" href="https://calendly.com/volynx-schedule-your-meeting/30min" target="_blank" rel="noopener noreferrer" data-i18n="svc.hero_book_meeting">Book a Meeting</a>
                <a class="btn whats" href="https://wa.me/447438656769?text=I%20want%20a%20premium%20VOLYNX%20website" target="_blank" rel="noopener noreferrer" data-i18n="svc.hero_whatsapp">WhatsApp</a>
                <a class="btn alt" href="#plans" data-i18n="svc.hero_see_plans">See plans</a>
              </div>
            </div>
            <div class="hero-visual" aria-label="Key metrics">
              <div class="chip" data-i18n="svc.hero_chip">Delivery, not delays</div>
              <div class="kpi-grid">
                <div class="kpi">
                  <div class="n" data-i18n="services.hero.m1_val">Days</div>
                  <div class="l" data-i18n="services.hero.m1_label">Time to launch</div>
                </div>
                <div class="kpi">
                  <div class="n" data-i18n="services.hero.m2_val">A+</div>
                  <div class="l" data-i18n="services.hero.m2_label">Performance focus</div>
                </div>
                <div class="kpi">
                  <div class="n" data-i18n="services.hero.m3_val">Guided</div>
                  <div class="l" data-i18n="services.hero.m3_label">Copy &amp; structure</div>
                </div>
                <div class="kpi">
                  <div class="n" data-i18n="services.hero.m4_val">Clean</div>
                  <div class="l" data-i18n="services.hero.m4_label">Premium UI</div>
                </div>
              </div>
              <p class="muted" style="margin: 12px 0 0; font-size: 15px;" data-i18n="services.hero.tagline">
                The point is simple: less "website project", more "revenue engine".
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- PLANS -->
      <section class="homepage-section collection-module" id="plans">
        <h2 class="sec-title" data-i18n="services.plans.title">
          <svg class="icon" aria-hidden="true"><use href="#i-spark" /></svg>
          Plans (choose your mission profile)
        </h2>
        <div class="plan-grid">

          <!-- Landing Express -->
          <div class="plan-tile">
            <div class="plan-media">
              <a href={ROUTES.landingExpress} aria-label="View Landing Express details">
                <img src="/assets/starter.webp" alt="Landing Express" loading="lazy" />
              </a>
            </div>
            <div class="plan-content">
              <span class="chip" data-i18n="services.plan1.delivery">48–72h delivery</span>
              <h3 class="headline" data-i18n="services.plan1.title">Landing Express</h3>
              <p class="muted">One page that converts. Stripe checkout, contact form, mobile-first. Deployed and handed off in 48–72 hours.</p>
              <ul class="plan-scope">
                <li data-i18n="svc.plan1_item1">1 conversion-focused page (all sections)</li>
                <li data-i18n="svc.plan1_item2">Stripe CTA + Formspree contact form</li>
                <li data-i18n="svc.plan1_item3">Mobile-first, performance-optimised</li>
                <li data-i18n="svc.plan1_item4">Basic SEO (title, description, headers)</li>
                <li data-i18n="svc.plan1_item5">Social proof blocks included</li>
              </ul>
              <div class="cta-links">
                <a class="btn primary" href={ROUTES.landingExpress} data-i18n="svc.plan_see_scope">See full scope</a>
                <a class="btn alt" href="https://wa.me/447438656769?text=I%20want%20Landing%20Express" target="_blank" rel="noopener noreferrer" data-i18n="svc.plan_whatsapp">WhatsApp</a>
              </div>
            </div>
          </div>

          <!-- Portfolio + Identity -->
          <div class="plan-tile">
            <div class="plan-media">
              <a href={ROUTES.portfolioKit} aria-label="View Portfolio + Identity details">
                <img src="/assets/pro.webp" alt="Portfolio + Identity" loading="lazy" />
              </a>
            </div>
            <div class="plan-content">
              <span class="chip" data-i18n="services.plan2.delivery">5–7 days delivery</span>
              <h3 class="headline" data-i18n="services.plan2.title">Portfolio + Identity</h3>
              <p class="muted">Full portfolio with brand identity. The system used to showcase my own work — adapted to your brand and content.</p>
              <ul class="plan-scope">
                <li data-i18n="svc.plan2_item1">Multi-section portfolio site</li>
                <li data-i18n="svc.plan2_item2">Visual identity (colours, typography, logo usage)</li>
                <li data-i18n="svc.plan2_item3">Motion & interaction polish</li>
                <li data-i18n="svc.plan2_item4">SEO + analytics setup</li>
                <li data-i18n="svc.plan2_item5">Editable components, source files delivered</li>
              </ul>
              <div class="cta-links">
                <a class="btn primary" href={ROUTES.portfolioKit} data-i18n="svc.plan_see_example">See example</a>
                <a class="btn alt" href="https://wa.me/447438656769?text=I%20want%20the%20Portfolio%20plan" target="_blank" rel="noopener noreferrer" data-i18n="svc.plan_whatsapp">WhatsApp</a>
              </div>
            </div>
          </div>

          <!-- Full Site + Brand -->
          <div class="plan-tile">
            <div class="plan-media">
              <a href={ROUTES.agencyKit} aria-label="View Full Site + Brand details">
                <img src="/assets/elite.webp" alt="Full Site + Brand" loading="lazy" />
              </a>
            </div>
            <div class="plan-content">
              <span class="chip" data-i18n="services.plan3.delivery">2–3 weeks delivery</span>
              <h3 class="headline" data-i18n="services.plan3.title">Full Site + Brand</h3>
              <p class="muted">Multi-page site, full brand system, copy structure, and analytics. Launch-ready at scale for studios and growing businesses.</p>
              <ul class="plan-scope">
                <li data-i18n="svc.plan3_item1">Full multi-page website</li>
                <li data-i18n="svc.plan3_item2">Complete brand system (mark, palette, type, tone)</li>
                <li data-i18n="svc.plan3_item3">Copy structure & offer narrative</li>
                <li data-i18n="svc.plan3_item4">Domain, email, analytics, SEO setup</li>
                <li data-i18n="svc.plan3_item5">Maintenance plan available as add-on</li>
              </ul>
              <div class="cta-links">
                <a class="btn primary" href="https://calendly.com/volynx-schedule-your-meeting/new-meeting" target="_blank" rel="noopener noreferrer" data-i18n="svc.plan_book_call">Book a call</a>
                <a class="btn alt" href="https://wa.me/447438656769?text=I%20want%20the%20Full%20Site%20plan" target="_blank" rel="noopener noreferrer" data-i18n="svc.plan_whatsapp">WhatsApp</a>
              </div>
            </div>
          </div>

        </div>
        <div class="plans-note" data-i18n="svc.plans_note">
          Don't see your exact scenario? Good — that means you're building something real.
          Ping us and we'll scope a custom stack.
        </div>
      </section>

      <!-- ADD-ONS -->
      <section class="homepage-section" id="addons">
        <h2 class="sec-title" data-i18n="services.addons.title">
          <svg class="icon" aria-hidden="true"><use href="#i-cpu" /></svg>
          Add-ons (for the details that make the difference)
        </h2>
        <div class="promo-grid">
          <div class="promo-tile">
            <div>
              <span class="chip" data-i18n="svc.addon1_chip">Acceleration</span>
              <h3 data-i18n="services.addon1.title">Copy Sprint</h3>
              <p data-i18n="svc.addon1_desc">We turn your messy notes into a tight offer narrative: headline, sections, CTA sequencing, microcopy.</p>
            </div>
            <a class="btn alt" href="https://wa.me/447438656769?text=I%20want%20Copy%20Sprint%20as%20an%20add-on" target="_blank" rel="noopener noreferrer" data-i18n="svc.addon_add">Add to my plan</a>
          </div>
          <div class="promo-tile">
            <div>
              <span class="chip" data-i18n="svc.addon2_chip">Signal</span>
              <h3 data-i18n="services.addon2.title">SEO Booster</h3>
              <p data-i18n="svc.addon2_desc">Technical SEO hygiene+on-page structure that makes Google understand you (and users trust you).</p>
            </div>
            <a class="btn alt" href="https://wa.me/447438656769?text=I%20want%20SEO%20Booster%20as%20an%20add-on" target="_blank" rel="noopener noreferrer" data-i18n="svc.addon_add">Add to my plan</a>
          </div>
          <div class="promo-tile">
            <div>
              <span class="chip" data-i18n="svc.addon3_chip">Operations</span>
              <h3 data-i18n="services.addon3.title">Maintenance &amp; Analytics</h3>
              <p data-i18n="svc.addon3_desc">Monthly updates, performance monitoring, and conversion insights — the "keep it winning" package.</p>
            </div>
            <a class="btn alt" href="https://wa.me/447438656769?text=I%20want%20Maintenance%20%26%20Analytics%20as%20an%20add-on" target="_blank" rel="noopener noreferrer" data-i18n="svc.addon_add">Add to my plan</a>
          </div>
        </div>
      </section>

      <!-- WHY VOLYNX -->
      <section id="why-volynx" class="section">
        <h2 class="sec-title" data-i18n="svc.why_title">
          <svg class="icon" aria-hidden="true"><use href="#i-bolt" /></svg>
          Why VOLYNX
        </h2>
        <div class="grid cols-2">
          <div class="card">
            <span class="chip" data-i18n="svc.why_chip1">You need clients, not "just a website"</span>
            <h3 data-i18n="services.why.title">Built with intelligence to save your time <strong>(and money)</strong>.</h3>
            <p class="muted">
              VOLYNX is for entrepreneurs, creators and professionals who need a premium &amp;
              conversion-focused site live in days. You bring the vision; we translate it into
              clear positioning, structure and design that'll make your products / services be desired!
            </p>
            <ul class="why-features">
              <li>
                <svg class="icon" aria-hidden="true"><use href="#i-spark" /></svg>
                <span data-i18n="services.why.f1"><strong>Guided process.</strong> Short, focused calls and prompts so you don't get stuck writing copy or deciding layouts.</span>
              </li>
              <li>
                <svg class="icon" aria-hidden="true"><use href="#i-cpu" /></svg>
                <span data-i18n="services.why.f2"><strong>Strategy+design+tech in one place.</strong> We align your offer, narrative, visual identity and setup (domain, email, analytics, SEO basics).</span>
              </li>
              <li>
                <svg class="icon" aria-hidden="true"><use href="#i-shield" /></svg>
                <span data-i18n="services.why.f3"><strong>Zero DIY platforms.</strong> No generic templates or bloated builders: lean, performant code prepared to scale.</span>
              </li>
            </ul>
          </div>
          <div class="card">
            <span class="chip" data-i18n="svc.why_chip2">Designed to unlock revenue fast</span>
            <h3 data-i18n="svc.why_card2_title">Launch quickly, then improve with real data</h3>
            <p class="muted">
              Instead of endless "coming soon", you get a clear launch-ready version that already sells
              your value and can be refined as clients and feedback start coming in.
            </p>
            <div class="why-metrics">
              <div class="metric">
                <div class="metric-number" data-i18n="svc.metric1_val">48–72h</div>
                <div class="metric-label" data-i18n="svc.metric1_label">delivery window (Start)</div>
              </div>
              <div class="metric">
                <div class="metric-number" data-i18n="svc.metric2_val">A grade</div>
                <div class="metric-label" data-i18n="svc.metric2_label">performance target</div>
              </div>
              <div class="metric">
                <div class="metric-number" data-i18n="svc.metric3_val">1 focus</div>
                <div class="metric-label" data-i18n="svc.metric3_label">clear main CTA</div>
              </div>
            </div>
            <p class="why-tagline" data-i18n="svc.why_tagline">
              The goal: get you online with a serious, trustworthy presence that can generate
              opportunities while you sort the rest of your life and business.
            </p>
            <p class="why-note" data-i18n="svc.why_note">
              *Delivery time and performance depend on scope, assets and infrastructure,
              but the whole process is optimized for speed and clarity.
            </p>
          </div>
        </div>
      </section>

      <!-- CONTACT -->
      <section class="section" id="contact">
        <h2 class="sec-title" data-i18n="services.contact.title">
          <svg class="icon" aria-hidden="true"><use href="#i-spark" /></svg>
          Quick contact
        </h2>
        <div class="grid cols-2">
          <form action="mailto:hello@volynx.world?subject=New%20Project%20from%20volynx.world" method="post" enctype="text/plain">
            <input name="name" placeholder="Your name" required data-i18n="services.contact.name" />
            <input name="email" type="email" placeholder="Your email" required data-i18n="services.contact.email" />
            <textarea name="message" rows="4" placeholder="Tell us about your project" required data-i18n="services.contact.msg"></textarea>
            <div class="row" style="justify-content: space-between; align-items: center">
              <div class="row" style="gap: 8px">
                <input type="file" name="attachment" style="font-size: 13px; max-width: 220px; padding: 8px 10px; border-radius: 12px;" />
                <span class="muted" style="font-size: 11px">Optional: attach a file</span>
              </div>
              <button class="btn primary" type="submit" data-i18n="services.contact.send">Send by email</button>
            </div>
          </form>
          <div class="card">
            <h3 data-i18n="services.contact.whatsapp">Prefer WhatsApp?</h3>
            <p class="muted">Monday to Thursday, 11am–5pm and Friday, 11am–3pm (UK time).</p>
            <div class="row" style="margin-top: 10px">
              <a class="btn whats" href="https://wa.me/447438656769?text=Hi%2C%20I%20have%20a%20project%20for%20VOLYNX" target="_blank" rel="noopener noreferrer" data-i18n="svc.contact_whatsapp">WhatsApp</a>
              <a class="btn" href="https://calendly.com/volynx-schedule-your-meeting/new-meeting" target="_blank" rel="noopener noreferrer" data-i18n="svc.contact_call">Book a call</a>
            </div>
          </div>
        </div>
      </section>

      <!-- FOOTER -->
      <footer class="footer-dir">
        <div class="cols">
          <div>
            <h4 data-i18n="svc.footer_h1">Services</h4>
            <a href="#plans" data-i18n="svc.footer_design">Web Design</a>
            <a href="#addons" data-i18n="svc.footer_addons">Add-ons</a>
            <a href="#contact" data-i18n="svc.footer_intake">Project intake</a>
          </div>
          <div>
            <h4 data-i18n="svc.footer_h2">Plans</h4>
            <a href="#plans" data-i18n="svc.footer_landing">Landing Express</a>
            <a href="#plans" data-i18n="svc.footer_portfolio">Portfolio+Identity</a>
            <a href="#plans" data-i18n="svc.footer_fullsite">Full Site+Brand</a>
          </div>
          <div>
            <h4 data-i18n="svc.footer_h3">Company</h4>
            <a href={ROUTES.manifesto}>Why VOLYNX</a>
            <a href={ROUTES.home}>Main site</a>
            <a href={ROUTES.email}>Email</a>
          </div>
          <div>
            <h4 data-i18n="svc.footer_h4">Support</h4>
            <a href="https://wa.me/447438656769?text=I%20need%20support%20with%20my%20VOLYNX%20project" target="_blank" rel="noopener noreferrer" data-i18n="svc.footer_support_whats">WhatsApp</a>
            <a href="#contact" data-i18n="svc.footer_contact">Contact form</a>
            <a href="#top" data-i18n="svc.footer_top">Back to top</a>
          </div>
        </div>
        <div class="footer-legal">
          <div>© {new Date().getFullYear()} VOLYNX. All rights reserved.</div>
          <div class="links">
            <a href={ROUTES.privacy}>Privacy</a>
            <a href={ROUTES.terms}>Terms</a>
            <a href={ROUTES.disclaimer}>Legal</a>
          </div>
        </div>
      </footer>
    </main>
  </div>

  <!-- SVG Icon Sprites -->
  <svg width="0" height="0" style="position:absolute; visibility:hidden" aria-hidden="true">
    <symbol id="i-bolt" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <polygon points="13 2 3 14 11 14 9 22 21 10 13 10 13 2"></polygon>
    </symbol>
    <symbol id="i-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
    </symbol>
    <symbol id="i-cpu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4" y="4" width="16" height="16" rx="2"></rect>
      <rect x="9" y="9" width="6" height="6"></rect>
      <path d="M9 1v3M15 1v3M9 20v3M15 20v3M1 9h3M1 15h3M20 9h3M20 15h3"></path>
    </symbol>
    <symbol id="i-spark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2v4M12 18v4M2 12h4M18 12h4M5 5l2.8 2.8M16.2 16.2L19 19M5 19l2.8-2.8M16.2 7.8L19 5"></path>
    </symbol>
  </svg>

  <PageWidgets hideUtilBar />
</body>
</html>
