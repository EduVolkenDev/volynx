---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";

const conversionBriefHref = `${ROUTES.contact}?product=services&intent=conversion-fix`;
const essentialBriefHref = `${ROUTES.contact}?product=services&intent=essential`;
const growthBriefHref = `${ROUTES.contact}?product=services&intent=growth`;
const premiumBriefHref = `${ROUTES.contact}?product=services&intent=premium`;
---
<FlagshipLayout title="Full Site + Brand — VOLYNX bespoke" description="Custom website and brand identity projects, by brief, quote and approval. Not a template. Built to carry your business." pageClass="page-services">
  <FlagshipHeader current={ROUTES.services} ctaLabel="Book a call" ctaHref="https://calendly.com/volynx-schedule-your-meeting/new-meeting" />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero hero--services">
      <div class="shell hero-grid hero-grid--services">
        <div class="hero-copy">
          <span class="kicker" data-i18n="svc2.kicker">Conversion-led · Bespoke by design · Built around your offer</span>
          <h1 data-i18n="svc2.hero_title">Make your website earn its place.</h1>
          <p data-i18n="svc2.hero_desc">VOLYNX turns unclear websites into premium conversion systems — from a focused 48-hour fix to a complete site and brand built around how your business sells.</p>
          <div class="hero-actions">
            <a href={conversionBriefHref} class="button button--gold" data-i18n="svc2.hero_book">Get a 3-point preview</a>
            <a href="#plans" class="button button--ghost" data-i18n="svc2.hero_brief">See packages</a>
            <a href="https://calendly.com/volynx-schedule-your-meeting/new-meeting" target="_blank" rel="noopener noreferrer" class="button button--ghost" data-i18n="svc2.hero_plans">Book a larger project</a>
          </div>
          <div class="hero-inline-stats">
            <div class="svc-stat-card">
              <img class="svc-stat-icon" src="/assets/tailormade.webp?v=20260502" alt="" loading="lazy" />
              <strong data-i18n="svc2.stat1_val">48h</strong>
              <span data-i18n="svc2.stat1_label">Focused conversion sprint</span>
            </div>
            <div class="svc-stat-card">
              <img class="svc-stat-icon" src="/assets/deadline.webp?v=20260502" alt="" loading="lazy" />
              <strong data-i18n="svc2.stat2_val">From £249</strong>
              <span data-i18n="svc2.stat2_label">Fixed-scope entry</span>
            </div>
            <div class="svc-stat-card">
              <img class="svc-stat-icon" src="/assets/quotes.webp?v=20260502" alt="" loading="lazy" />
              <strong data-i18n="svc2.stat3_val">Fixed</strong>
              <span data-i18n="svc2.stat3_label">No hourly billing</span>
            </div>
            <div class="svc-stat-card">
              <img class="svc-stat-icon" src="/assets/1on1.webp?v=20260502" alt="" loading="lazy" />
              <strong data-i18n="svc2.stat4_val">Yours</strong>
              <span data-i18n="svc2.stat4_label">Full ownership at handoff</span>
            </div>
          </div>
        </div>
        <div class="hero-visual hero-visual--flagship svc-hero-img svc-hero-stage">
          <img src="/assets/dark-icon-light.webp" alt="VOLYNX" loading="eager" />
          <aside class="panel panel--pro svc-hero-offer">
            <span class="label label--pro" data-i18n="svc2.fix_chip">Fastest route to a better site</span>
            <h2 data-i18n="svc2.fix_title">Website Conversion Fix</h2>
            <p data-i18n="svc2.fix_desc">Find the friction, sharpen the message and make the next click obvious.</p>
            <div class="svc-offer-meta">
              <strong data-i18n="svc2.fix_price">From £249</strong>
              <span data-i18n="svc2.fix_timeline">48-hour sprint</span>
            </div>
            <a href={conversionBriefHref} class="button button--gold" data-i18n="svc2.fix_cta">Get a 3-point preview</a>
          </aside>
        </div>
      </div>
    </section>

    <!-- ═══ FAST ENTRY OFFER ═══ -->
    <section id="fix" class="page-section svc-entry-section">
      <div class="shell">
        <div class="panel panel--pro svc-entry-card">
          <div class="svc-entry-copy">
            <span class="eyebrow" data-i18n="svc2.entry_eyebrow">A sharper site without a full rebuild</span>
            <h2 data-i18n="svc2.entry_title">More bookings, enquiries and sales — starting with the friction you already have.</h2>
            <p data-i18n="svc2.entry_desc">Send your URL and the business goal. VOLYNX identifies the highest-impact changes, then delivers a focused improvement sprint without forcing you into a full rebrand.</p>
            <div class="svc-entry-points">
              <div><strong data-i18n="svc2.entry_point1_title">Find the friction</strong><span data-i18n="svc2.entry_point1_desc">Mobile, message, trust and CTA review.</span></div>
              <div><strong data-i18n="svc2.entry_point2_title">Make it obvious</strong><span data-i18n="svc2.entry_point2_desc">A clearer path to booking, enquiry or purchase.</span></div>
              <div><strong data-i18n="svc2.entry_point3_title">Ship the fix</strong><span data-i18n="svc2.entry_point3_desc">Focused implementation, tested and handed back.</span></div>
            </div>
          </div>
          <div class="svc-entry-action">
            <span class="svc-entry-price" data-i18n="svc2.entry_price">From £249</span>
            <span class="svc-entry-time" data-i18n="svc2.entry_time">48-hour delivery</span>
            <a href={conversionBriefHref} class="button button--gold" data-i18n="svc2.entry_cta">Get a 3-point preview</a>
            <small data-i18n="svc2.entry_note">No pressure. No full audit required to start.</small>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ CHOOSE YOUR ROUTE ═══ -->
    <section id="who-for" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="svc2.fit_eyebrow">Choose your route</span>
        <h2 data-i18n="svc2.fit_title">One focused fix, one complete launch, or a bespoke growth system.</h2>
        <p data-i18n="svc2.fit_desc">Start at the smallest useful intervention. Scale only when the business needs more.</p>
      </div>
      <div class="shell grid-3 svc-route-grid">
        <article class="panel svc-why-card svc-showcase-card">
          <div class="svc-card-showcase" aria-hidden="true">
            <img src="/assets/foryou.webp" alt="" loading="lazy" />
          </div>
          <span class="label label--pro" data-i18n="svc2.route_fast_chip">Fast entry · from £249</span>
          <h3 data-i18n="svc2.fit_yes_title">Fix what is already costing you leads.</h3>
          <ul class="detail-list">
            <li data-i18n-html="svc2.fit_yes1"><strong>You have an existing site</strong> but visitors are not taking the next step.</li>
            <li data-i18n-html="svc2.fit_yes2"><strong>Your booking, enquiry or purchase path feels unclear</strong> on mobile.</li>
            <li data-i18n-html="svc2.fit_yes3"><strong>You need a sharp intervention</strong> before committing to a full rebuild.</li>
          </ul>
          <div class="svc-route-actions"><a href={conversionBriefHref} class="button button--gold" data-i18n="svc2.route_fast_cta">Get the preview</a></div>
        </article>
        <article class="panel svc-why-card svc-showcase-card panel--pro">
          <div class="svc-card-showcase" aria-hidden="true">
            <img src="/assets/saasbig.webp" alt="" loading="lazy" />
          </div>
          <span class="label label--pro" data-i18n="svc2.route_landing_chip">Landing Express · from £300</span>
          <h3 data-i18n="svc2.route_landing_title">Launch a serious landing page fast.</h3>
          <ul class="detail-list">
            <li data-i18n-html="svc2.route_landing1"><strong>One focused page</strong> built around your offer and the action you want visitors to take.</li>
            <li data-i18n-html="svc2.route_landing2"><strong>Premium design and responsive build</strong> ready for mobile, desktop and real-world traffic.</li>
            <li data-i18n-html="svc2.route_landing3"><strong>48–72h delivery</strong> with CTA, booking/contact flow and launch handoff included.</li>
          </ul>
          <div class="svc-route-actions"><a href={ROUTES.landingExpress} class="button button--gold" data-i18n="svc2.route_landing_cta">Explore Landing Express</a></div>
        </article>
        <article class="panel svc-why-card svc-showcase-card">
          <div class="svc-card-showcase" aria-hidden="true">
            <img src="/assets/notforyou.webp" alt="" loading="lazy" />
          </div>
          <span class="label" data-i18n="svc2.route_build_chip">Bespoke build · from £1,500</span>
          <h3 data-i18n="svc2.fit_no_title">Build the flagship version.</h3>
          <ul class="detail-list">
            <li data-i18n-html="svc2.fit_no1"><strong>You're launching or repositioning</strong> and need the whole message to feel coherent.</li>
            <li data-i18n-html="svc2.fit_no2"><strong>You want strategy, copy, design and code aligned</strong> under one VOLYNX direction.</li>
            <li data-i18n-html="svc2.fit_no3"><strong>You need a system that can grow</strong> with integrations, content and future offers.</li>
          </ul>
          <div class="svc-route-actions"><a href="#plans" class="button button--ghost" data-i18n="svc2.route_build_cta">See build packages</a></div>
        </article>
      </div>
    </section>

    <!-- ═══ PROCESS ═══ -->
    <section id="process" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="svc2.process_eyebrow">How it runs</span>
        <h2 data-i18n="svc2.process_title">A clear path from first message to live site.</h2>
        <p data-i18n="svc2.process_desc">The fast fix stays focused. The bespoke build gets the full architecture. Either way, you know what happens next and what is expected from both sides.</p>
      </div>
      <div class="shell grid-3 svc-plans-grid">
        <article class="panel svc-plan-card svc-plan-card--process">
          <div class="svc-card-top">
            <div class="svc-card-icon svc-card-icon--process" aria-hidden="true">
              <img src="/assets/discoverycall1.webp" alt="" loading="lazy" decoding="async" />
            </div>
            <span class="label" data-i18n="svc2.step1_num">01</span>
          </div>
          <h3 data-i18n="svc2.step1_title">Discovery call</h3>
          <p data-i18n="svc2.step1_desc">30-45 min on Calendly. We cover your offer, audience, constraints, existing assets and the win condition.</p>
        </article>
        <article class="panel svc-plan-card svc-plan-card--process">
          <div class="svc-card-top">
            <div class="svc-card-icon svc-card-icon--process" aria-hidden="true">
              <img src="/assets/briefanalysis1.webp" alt="" loading="lazy" decoding="async" />
            </div>
            <span class="label" data-i18n="svc2.step2_num">02</span>
          </div>
          <h3 data-i18n="svc2.step2_title">Brief analysis</h3>
          <p data-i18n="svc2.step2_desc">The call becomes a written brief: what you're selling, to whom, what the site and brand need to accomplish.</p>
        </article>
        <article class="panel svc-plan-card svc-plan-card--process">
          <div class="svc-card-top">
            <div class="svc-card-icon svc-card-icon--process" aria-hidden="true">
              <img src="/assets/quoteandtimeline2.webp" alt="" loading="lazy" decoding="async" />
            </div>
            <span class="label" data-i18n="svc2.step3_num">03</span>
          </div>
          <h3 data-i18n="svc2.step3_title">Quote &amp; timeline</h3>
          <p data-i18n="svc2.step3_desc">Fixed written quote, clear milestones, deposit terms. No hourly billing. No surprise extras.</p>
        </article>
        <article class="panel svc-plan-card svc-plan-card--process">
          <div class="svc-card-top">
            <div class="svc-card-icon svc-card-icon--process" aria-hidden="true">
              <img src="/assets/approval1.webp" alt="" loading="lazy" decoding="async" />
            </div>
            <span class="label" data-i18n="svc2.step4_num">04</span>
          </div>
          <h3 data-i18n="svc2.step4_title">Approval</h3>
          <p data-i18n="svc2.step4_desc">You sign off the scope and deposit. Work doesn't start before approval. Nothing assumed.</p>
        </article>
        <article class="panel svc-plan-card svc-plan-card--process">
          <div class="svc-card-top">
            <div class="svc-card-icon svc-card-icon--process" aria-hidden="true">
              <img src="/assets/buildanditeration1.webp" alt="" loading="lazy" decoding="async" />
            </div>
            <span class="label" data-i18n="svc2.step5_num">05</span>
          </div>
          <h3 data-i18n="svc2.step5_title">Build &amp; iteration</h3>
          <p data-i18n="svc2.step5_desc">Brand, design, copy and code in parallel. Scheduled review checkpoints. Revisions inside scope.</p>
        </article>
        <article class="panel svc-plan-card svc-plan-card--process">
          <div class="svc-card-top">
            <div class="svc-card-icon svc-card-icon--process" aria-hidden="true">
              <img src="/assets/deliveryandhandoff1.webp" alt="" loading="lazy" decoding="async" />
            </div>
            <span class="label" data-i18n="svc2.step6_num">06</span>
          </div>
          <h3 data-i18n="svc2.step6_title">Delivery &amp; handoff</h3>
          <p data-i18n="svc2.step6_desc">Launch, training, source-file transfer and optional maintenance plan. Full ownership is yours.</p>
        </article>
      </div>
    </section>

    <!-- ═══ SCOPE PACKAGES ═══ -->
    <section id="plans" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="svc2.plans_eyebrow">Scope packages</span>
        <h2 data-i18n="svc2.plans_title">Choose the level of build your business actually needs.</h2>
        <p data-i18n="svc2.plans_desc">Start with the £249 conversion fix above, or choose a full build below. Every bespoke project gets a fixed written quote before work begins.</p>
      </div>
      <div class="shell grid-3 svc-plans-grid">

        <!-- Essential -->
        <article class="panel feature-card svc-plan-card has-card-asset">
          <img src="/assets/starter.webp" alt="Essential" class="card-asset" loading="lazy" />
          <span class="label" data-i18n="svc2.plan1_delivery">From £1,500 · 2 weeks</span>
          <h3 data-i18n="svc2.plan1_title">Launch</h3>
          <p data-i18n="svc2.plan1_desc">One premium landing page built from your brief, with a tight brand kit. For focused launches where a single page carries the pitch.</p>
          <ul class="detail-list">
            <li data-i18n="svc2.plan1_item1">1 custom landing page (design + code)</li>
            <li data-i18n="svc2.plan1_item2">Brand kit lite (logo, palette, type)</li>
            <li data-i18n="svc2.plan1_item3">Copy structure in collaboration</li>
            <li data-i18n="svc2.plan1_item4">Basic SEO &amp; analytics setup</li>
            <li data-i18n="svc2.plan1_item5">Launch + 2 revision rounds</li>
          </ul>
          <div class="svc-plan-actions">
            <a href="https://calendly.com/volynx-schedule-your-meeting/new-meeting" target="_blank" rel="noopener noreferrer" class="button button--gold" data-i18n="svc2.plan_call">Book a discovery call</a>
            <a href={essentialBriefHref} class="button button--ghost" data-i18n="svc2.plan_fit">Check fit first</a>
          </div>
        </article>

        <!-- Growth -->
        <article class="panel feature-card svc-plan-card panel--pro premium-frame has-card-asset">
          <img src="/assets/pro.webp" alt="Growth" class="card-asset" loading="lazy" />
          <span class="label label--pro" data-i18n="svc2.plan2_delivery">From £3,500 · 3-4 weeks</span>
          <h3 data-i18n="svc2.plan2_title">Growth · most common</h3>
          <p data-i18n="svc2.plan2_desc">Multi-page site with a full brand identity, delivered end-to-end. The standard VOLYNX engagement — the shape most businesses actually need.</p>
          <ul class="detail-list">
            <li data-i18n="svc2.plan2_item1">Multi-page custom site (design + code)</li>
            <li data-i18n="svc2.plan2_item2">Complete brand system (mark, palette, type, tone)</li>
            <li data-i18n="svc2.plan2_item3">Copy narrative across every page</li>
            <li data-i18n="svc2.plan2_item4">Domain + email + analytics + SEO</li>
            <li data-i18n="svc2.plan2_item5">Launch + 3 revision rounds</li>
          </ul>
          <div class="svc-plan-actions">
            <a href="https://calendly.com/volynx-schedule-your-meeting/new-meeting" target="_blank" rel="noopener noreferrer" class="button button--gold" data-i18n="svc2.plan_call">Book a discovery call</a>
            <a href={growthBriefHref} class="button button--ghost" data-i18n="svc2.plan_fit">Check fit first</a>
          </div>
        </article>

        <!-- Premium -->
        <article class="panel feature-card svc-plan-card has-card-asset">
          <img src="/assets/elite.webp" alt="Premium" class="card-asset" loading="lazy" />
          <span class="label label--pro" data-i18n="svc2.plan3_delivery">From £7,000 · 5-6 weeks</span>
          <h3 data-i18n="svc2.plan3_title">Flagship</h3>
          <p data-i18n="svc2.plan3_desc">Everything in Growth plus integrations, custom tooling, and the first 3 months of maintenance. For businesses treating the site as infrastructure, not decoration.</p>
          <ul class="detail-list">
            <li data-i18n="svc2.plan3_item1">Everything in Growth</li>
            <li data-i18n="svc2.plan3_item2">Custom integrations (CRM, Stripe, bookings…)</li>
            <li data-i18n="svc2.plan3_item3">Bilingual (EN + PT) setup</li>
            <li data-i18n="svc2.plan3_item4">Performance &amp; accessibility pass</li>
            <li data-i18n="svc2.plan3_item5">3 months of maintenance included</li>
          </ul>
          <div class="svc-plan-actions">
            <a href="https://calendly.com/volynx-schedule-your-meeting/new-meeting" target="_blank" rel="noopener noreferrer" class="button button--gold" data-i18n="svc2.plan_call">Book a discovery call</a>
            <a href={premiumBriefHref} class="button button--ghost" data-i18n="svc2.plan_fit">Check fit first</a>
          </div>
        </article>
      </div>

      <div class="shell">
        <div class="panel svc-plans-note" data-i18n="svc2.plans_note">
          The Conversion Fix can begin from a URL and a clear goal. Larger engagements start with a discovery call and receive a fixed written quote. No hourly billing and no surprise extras.
        </div>
      </div>
    </section>

    <!-- ═══ ADD-ONS ═══ -->
    <section id="addons" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="svc2.addons_eyebrow">Add-ons</span>
        <h2 data-i18n="svc2.addons_title">Extend the scope during the quote.</h2>
        <p data-i18n="svc2.addons_desc">Discussed in the discovery call. Priced inside the final written quote — no surprise add-ons after approval.</p>
      </div>
      <div class="shell grid-3">
        <article class="panel svc-addon">
          <div class="svc-card-top">
            <div class="svc-card-icon svc-card-icon--addon" aria-hidden="true">
              <img src="/assets/domainemaildns.webp" alt="" loading="lazy" decoding="async" />
            </div>
            <span class="label" data-i18n="svc2.addon1_chip">Setup</span>
          </div>
          <h3 data-i18n="svc2.addon1_title">Domain + email + DNS</h3>
          <p data-i18n="svc2.addon1_desc">VOLYNX handles registrar, DNS, SSL, professional email setup and deploy. You get working infrastructure, not a config checklist.</p>
        </article>
        <article class="panel svc-addon">
          <div class="svc-card-top">
            <div class="svc-card-icon" aria-hidden="true">
              <img src="/assets/bilingual.webp" alt="" loading="lazy" />
            </div>
            <span class="label label--pro" data-i18n="svc2.addon2_chip">Scope</span>
          </div>
          <h3 data-i18n="svc2.addon2_title">Bilingual EN + PT</h3>
          <p data-i18n="svc2.addon2_desc">Native Brazilian Portuguese plus English, with proper translation (not Google Translate). Reach both markets in the same site.</p>
        </article>
        <article class="panel svc-addon">
          <div class="svc-card-top">
            <div class="svc-card-icon svc-card-icon--addon" aria-hidden="true">
              <img src="/assets/iconography.webp" alt="" loading="lazy" decoding="async" />
            </div>
            <span class="label" data-i18n="svc2.addon3_chip">Visual</span>
          </div>
          <h3 data-i18n="svc2.addon3_title">Custom iconography</h3>
          <p data-i18n="svc2.addon3_desc">Curated VOLYNX icon system tailored to your brand — not stock. Sharper visual identity across the site.</p>
        </article>
        <article class="panel svc-addon">
          <div class="svc-card-top">
            <div class="svc-card-icon" aria-hidden="true">
              <img src="/assets/maintenanceplans.webp" alt="" loading="lazy" />
            </div>
            <span class="label" data-i18n="svc2.addon4_chip">Ongoing</span>
          </div>
          <h3 data-i18n="svc2.addon4_title">Maintenance plan</h3>
          <p data-i18n="svc2.addon4_desc">Monthly retainer for updates, copy changes, new sections, performance checks. Priority queue.</p>
        </article>
        <article class="panel svc-addon">
          <div class="svc-card-top">
            <div class="svc-card-icon svc-card-icon--addon" aria-hidden="true">
              <img src="/assets/stripecrmbooking.webp" alt="" loading="lazy" decoding="async" />
            </div>
            <span class="label label--pro" data-i18n="svc2.addon5_chip">Integrations</span>
          </div>
          <h3 data-i18n="svc2.addon5_title">Stripe / CRM / booking</h3>
          <p data-i18n="svc2.addon5_desc">Stripe checkout, CRM connection, Calendly, Typeform, analytics — wired correctly and tested.</p>
        </article>
        <article class="panel svc-addon">
          <div class="svc-card-top">
            <div class="svc-card-icon svc-card-icon--addon" aria-hidden="true">
              <img src="/assets/performance.webp" alt="" loading="lazy" decoding="async" />
            </div>
            <span class="label" data-i18n="svc2.addon6_chip">Performance</span>
          </div>
          <h3 data-i18n="svc2.addon6_title">Performance &amp; SEO audit</h3>
          <p data-i18n="svc2.addon6_desc">Deep pass on Lighthouse scores, accessibility, structured data and search hygiene. Delivered as a written report.</p>
        </article>
      </div>
    </section>

    <!-- ═══ PROOF ═══ -->
    <section id="proof" class="page-section">
      <div class="shell section-head section-head--split">
        <div>
          <span class="eyebrow" data-i18n="svc2.why_eyebrow">Recent work</span>
        <h2 data-i18n="svc2.why_title">Work that makes the business feel more credible.</h2>
        </div>
        <p data-i18n="svc2.why_subtitle">Every engagement is built from scratch to fit the business. Here's the shape of that work.</p>
      </div>
      <div class="shell grid-2">
        <article class="panel svc-why-card svc-showcase-card">
