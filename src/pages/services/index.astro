---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";
---
<FlagshipLayout title="Services — VOLYNX" description="Premium websites powered by VOLYNX Builder. From single landing pages to full brand sites, launch faster with a real platform behind it." pageClass="page-services">
  <FlagshipHeader current={ROUTES.services} ctaLabel="Let's talk" ctaHref="https://calendly.com/volynx-schedule-your-meeting/new-meeting" />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero hero--services">
      <div class="shell hero-grid hero-grid--services">
        <div class="hero-copy">
          <span class="kicker" data-i18n="svc2.kicker">Intelligence + Design + Conversion</span>
          <h1 data-i18n="svc2.hero_title">Premium websites built to sell, not just to exist.</h1>
          <p data-i18n="svc2.hero_desc">VOLYNX crafts conversion-focused websites and brand identities with guided flows, premium kits and fast delivery. From single landing pages to full brand sites, launch with a real platform behind you.</p>
          <div class="hero-actions">
            <a href="https://calendly.com/volynx-schedule-your-meeting/new-meeting" target="_blank" rel="noopener noreferrer" class="button button--gold" data-i18n="svc2.hero_book">Book a meeting</a>
            <a href={`${ROUTES.whatsapp}?text=I%20want%20a%20premium%20VOLYNX%20website`} target="_blank" rel="noopener noreferrer" class="button button--ghost svc-whats-btn" data-i18n="svc2.hero_whatsapp">WhatsApp</a>
            <a href="#plans" class="button button--ghost" data-i18n="svc2.hero_plans">See plans</a>
          </div>
          <div class="hero-inline-stats">
            <div><strong data-i18n="svc2.stat1_val">Days</strong><span data-i18n="svc2.stat1_label">Time to launch</span></div>
            <div><strong data-i18n="svc2.stat2_val">A+</strong><span data-i18n="svc2.stat2_label">Performance focus</span></div>
            <div><strong data-i18n="svc2.stat3_val">Guided</strong><span data-i18n="svc2.stat3_label">Copy & structure</span></div>
            <div><strong data-i18n="svc2.stat4_val">Clean</strong><span data-i18n="svc2.stat4_label">Premium UI</span></div>
          </div>
        </div>
        <div class="hero-visual hero-visual--flagship svc-hero-img">
          <img src="/assets/volynx-icon.webp" alt="VOLYNX" loading="eager" />
        </div>
      </div>
    </section>

    <!-- ═══ PLANS ═══ -->
    <section id="plans" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="svc2.plans_eyebrow">Choose your mission profile</span>
        <h2 data-i18n="svc2.plans_title">Three plans. One standard: premium.</h2>
        <p data-i18n="svc2.plans_desc">Each plan is powered by VOLYNX Builder with guided flows, conversion-focused copy and professional output.</p>
      </div>
      <div class="shell grid-3 svc-plans-grid">

        <!-- Landing Express -->
        <article class="panel feature-card svc-plan-card has-card-asset">
          <img src="/assets/starter.webp" alt="Landing Express" class="card-asset" loading="lazy" />
          <span class="label" data-i18n="svc2.plan1_delivery">48-72h delivery</span>
          <h3 data-i18n="svc2.plan1_title">Landing Express</h3>
          <p data-i18n="svc2.plan1_desc">One conversion-focused page built with VOLYNX Builder. Stripe checkout, contact form, mobile-first. Guided flow, premium output.</p>
          <ul class="detail-list">
            <li data-i18n="svc2.plan1_item1">1 conversion-focused page (all sections)</li>
            <li data-i18n="svc2.plan1_item2">Stripe CTA + Formspree contact form</li>
            <li data-i18n="svc2.plan1_item3">Mobile-first, performance-optimised</li>
            <li data-i18n="svc2.plan1_item4">Basic SEO (title, description, headers)</li>
            <li data-i18n="svc2.plan1_item5">Social proof blocks included</li>
          </ul>
          <div class="svc-plan-actions">
            <a href={ROUTES.landingExpress} class="button button--gold" data-i18n="svc2.plan_scope">See full scope</a>
            <a href={`${ROUTES.whatsapp}?text=I%20want%20Landing%20Express`} target="_blank" rel="noopener noreferrer" class="button button--ghost svc-whats-btn" data-i18n="svc2.plan_whatsapp">WhatsApp</a>
          </div>
        </article>

        <!-- Portfolio + Identity -->
        <article class="panel feature-card svc-plan-card has-card-asset">
          <img src="/assets/pro.webp" alt="Portfolio + Identity" class="card-asset" loading="lazy" />
          <span class="label label--pro" data-i18n="svc2.plan2_delivery">5-7 days delivery</span>
          <h3 data-i18n="svc2.plan2_title">Portfolio + Identity</h3>
          <p data-i18n="svc2.plan2_desc">Full portfolio powered by the Portfolio Pro Kit. Brand identity, motion, SEO and conversion-first sections adapted to your brand.</p>
          <ul class="detail-list">
            <li data-i18n="svc2.plan2_item1">Multi-section portfolio site</li>
            <li data-i18n="svc2.plan2_item2">Visual identity (colours, typography, logo)</li>
            <li data-i18n="svc2.plan2_item3">Motion & interaction polish</li>
            <li data-i18n="svc2.plan2_item4">SEO + analytics setup</li>
            <li data-i18n="svc2.plan2_item5">Editable components, source files delivered</li>
          </ul>
          <div class="svc-plan-actions">
            <a href={ROUTES.portfolioKit} class="button button--gold" data-i18n="svc2.plan_example">See example</a>
            <a href={`${ROUTES.whatsapp}?text=I%20want%20the%20Portfolio%20plan`} target="_blank" rel="noopener noreferrer" class="button button--ghost svc-whats-btn" data-i18n="svc2.plan_whatsapp">WhatsApp</a>
          </div>
        </article>

        <!-- Full Site + Brand -->
        <article class="panel feature-card svc-plan-card panel--pro premium-frame has-card-asset">
          <img src="/assets/elite.webp" alt="Full Site + Brand" class="card-asset" loading="lazy" />
          <span class="label label--pro" data-i18n="svc2.plan3_delivery">2-3 weeks delivery</span>
          <h3 data-i18n="svc2.plan3_title">Full Site + Brand</h3>
          <p data-i18n="svc2.plan3_desc">Multi-page site built on VOLYNX Builder with full brand system, copy structure and analytics. Launch-ready at scale.</p>
          <ul class="detail-list">
            <li data-i18n="svc2.plan3_item1">Full multi-page website</li>
            <li data-i18n="svc2.plan3_item2">Complete brand system (mark, palette, type, tone)</li>
            <li data-i18n="svc2.plan3_item3">Copy structure & offer narrative</li>
            <li data-i18n="svc2.plan3_item4">Domain, email, analytics, SEO setup</li>
            <li data-i18n="svc2.plan3_item5">Maintenance plan available as add-on</li>
          </ul>
          <div class="svc-plan-actions">
            <a href="https://calendly.com/volynx-schedule-your-meeting/new-meeting" target="_blank" rel="noopener noreferrer" class="button button--gold" data-i18n="svc2.plan_call">Book a call</a>
            <a href={`${ROUTES.whatsapp}?text=I%20want%20the%20Full%20Site%20plan`} target="_blank" rel="noopener noreferrer" class="button button--ghost svc-whats-btn" data-i18n="svc2.plan_whatsapp">WhatsApp</a>
          </div>
        </article>
      </div>

      <div class="shell">
        <div class="panel svc-plans-note" data-i18n="svc2.plans_note">
          Don't see your exact scenario? Good — that means you're building something real. Ping us and we'll scope a custom stack.
        </div>
      </div>
    </section>

    <!-- ═══ ADD-ONS ═══ -->
    <section id="addons" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="svc2.addons_eyebrow">Extend your project</span>
        <h2 data-i18n="svc2.addons_title">Add-ons for the details that make the difference.</h2>
      </div>
      <div class="shell grid-3">
        <article class="panel svc-addon">
          <span class="label" data-i18n="svc2.addon1_chip">Setup</span>
          <h3 data-i18n="svc2.addon1_title">Assisted Domain Setup</h3>
          <p data-i18n="svc2.addon1_desc">We handle DNS, SSL and deployment so you don't have to. Faster activation with less friction.</p>
          <a class="button button--ghost" href={`${ROUTES.whatsapp}?text=I%20want%20Domain%20Setup`} target="_blank" rel="noopener noreferrer" data-i18n="svc2.addon_add">Add to my plan</a>
        </article>
        <article class="panel svc-addon">
          <span class="label label--pro" data-i18n="svc2.addon2_chip">Premium</span>
          <h3 data-i18n="svc2.addon2_title">Premium Template / Kit</h3>
          <p data-i18n="svc2.addon2_desc">Ready-made kits for premium conversion pages. Designed, structured and copy-ready.</p>
          <a class="button button--ghost" href={`${ROUTES.whatsapp}?text=I%20want%20a%20Premium%20Template`} target="_blank" rel="noopener noreferrer" data-i18n="svc2.addon_add">Add to my plan</a>
        </article>
        <article class="panel svc-addon">
          <span class="label" data-i18n="svc2.addon3_chip">Export</span>
          <h3 data-i18n="svc2.addon3_title">HTML Export</h3>
          <p data-i18n="svc2.addon3_desc">Exportable package for use outside the platform. Take your site anywhere.</p>
          <a class="button button--ghost" href={`${ROUTES.whatsapp}?text=I%20want%20HTML%20Export`} target="_blank" rel="noopener noreferrer" data-i18n="svc2.addon_add">Add to my plan</a>
        </article>
        <article class="panel svc-addon">
          <span class="label" data-i18n="svc2.addon4_chip">Scale</span>
          <h3 data-i18n="svc2.addon4_title">Extra Site Slot</h3>
          <p data-i18n="svc2.addon4_desc">More capacity without a full plan upgrade. Add sites on demand.</p>
          <a class="button button--ghost" href={`${ROUTES.whatsapp}?text=I%20want%20an%20Extra%20Site%20Slot`} target="_blank" rel="noopener noreferrer" data-i18n="svc2.addon_add">Add to my plan</a>
        </article>
        <article class="panel svc-addon">
          <span class="label" data-i18n="svc2.addon5_chip">i18n</span>
          <h3 data-i18n="svc2.addon5_title">Bilingual Pack</h3>
          <p data-i18n="svc2.addon5_desc">Two-language support in published projects. Reach both EN and PT audiences.</p>
          <a class="button button--ghost" href={`${ROUTES.whatsapp}?text=I%20want%20the%20Bilingual%20Pack`} target="_blank" rel="noopener noreferrer" data-i18n="svc2.addon_add">Add to my plan</a>
        </article>
        <article class="panel svc-addon">
          <span class="label label--pro" data-i18n="svc2.addon6_chip">Visual</span>
          <h3 data-i18n="svc2.addon6_title">Icon Vault Direction</h3>
          <p data-i18n="svc2.addon6_desc">Premium icon curation and SVG cleanup for projects that need a sharper visual system.</p>
          <a class="button button--ghost" href={`${ROUTES.whatsapp}?text=I%20want%20Icon%20Vault%20Direction`} target="_blank" rel="noopener noreferrer">Request direction</a>
        </article>
      </div>
    </section>

    <!-- ═══ WHY VOLYNX ═══ -->
    <section id="why-volynx" class="page-section">
      <div class="shell section-head section-head--split">
        <div>
          <span class="eyebrow" data-i18n="svc2.why_eyebrow">Not just a website</span>
          <h2 data-i18n="svc2.why_title">Built with intelligence to save your time (and money).</h2>
        </div>
        <p data-i18n="svc2.why_subtitle">You need clients, not "just a website". VOLYNX Builder gets you a launch-ready presence that already sells your value.</p>
      </div>
      <div class="shell grid-2">
        <article class="panel svc-why-card">
          <h3 data-i18n="svc2.why_approach_title">The approach</h3>
          <ul class="detail-list">
            <li data-i18n="svc2.why_f1"><strong>Guided process.</strong> Short, focused calls and prompts so you don't get stuck writing copy or deciding layouts.</li>
            <li data-i18n="svc2.why_f2"><strong>Strategy + design + tech in one place.</strong> We align your offer, narrative, visual identity and setup.</li>
            <li data-i18n="svc2.why_f3"><strong>Zero DIY platforms.</strong> No generic templates or bloated builders: lean, performant code prepared to scale.</li>
          </ul>
        </article>
        <article class="panel panel--pro svc-why-card">
          <h3 data-i18n="svc2.why_results_title">The results</h3>
          <div class="svc-metrics-row">
            <div class="svc-metric"><strong data-i18n="svc2.metric1_val">48-72h</strong><span data-i18n="svc2.metric1_label">delivery window (Start)</span></div>
            <div class="svc-metric"><strong data-i18n="svc2.metric2_val">A grade</strong><span data-i18n="svc2.metric2_label">performance target</span></div>
            <div class="svc-metric"><strong data-i18n="svc2.metric3_val">1 focus</strong><span data-i18n="svc2.metric3_label">clear main CTA</span></div>
          </div>
          <p data-i18n="svc2.why_tagline">The goal: get you online with a serious, trustworthy presence that generates opportunities while you sort the rest.</p>
          <p class="svc-note" data-i18n="svc2.why_note">*Delivery time and performance depend on scope, assets and infrastructure, but the whole process is optimized for speed and clarity.</p>
        </article>
      </div>
    </section>

    <!-- ═══ CONTACT ═══ -->
    <section id="contact" class="page-section page-section--last">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="svc2.contact_eyebrow">Start your project</span>
        <h2 data-i18n="svc2.contact_title">Ready to build something real?</h2>
      </div>
      <div class="shell grid-2 svc-contact-grid">
        <div class="panel svc-contact-form">
          <form action="mailto:hello@volynx.world?subject=New%20Project%20from%20volynx.world" method="post" enctype="text/plain">
            <input name="name" class="svc-input" placeholder="Your name" required data-i18n-placeholder="svc2.contact_name" />
            <input name="email" type="email" class="svc-input" placeholder="Your email" required data-i18n-placeholder="svc2.contact_email" />
            <textarea name="message" rows="4" class="svc-input svc-textarea" placeholder="Tell us about your project" required data-i18n-placeholder="svc2.contact_msg"></textarea>
            <button class="button button--gold" type="submit" data-i18n="svc2.contact_send">Send message</button>
          </form>
        </div>
        <div class="panel panel--pro svc-contact-alt">
          <h3 data-i18n="svc2.contact_whatsapp_title">Prefer a direct conversation?</h3>
          <p data-i18n="svc2.contact_hours">Monday to Thursday, 11am-5pm and Friday, 11am-3pm (UK time).</p>
          <div class="svc-contact-btns">
            <a class="button button--gold svc-whats-btn" href={`${ROUTES.whatsapp}?text=Hi%2C%20I%20have%20a%20project%20for%20VOLYNX`} target="_blank" rel="noopener noreferrer" data-i18n="svc2.contact_whatsapp">WhatsApp</a>
            <a class="button button--ghost" href="https://calendly.com/volynx-schedule-your-meeting/new-meeting" target="_blank" rel="noopener noreferrer" data-i18n="svc2.contact_call">Book a call</a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <FlagshipFooter />
</FlagshipLayout>

<style>
  /* ═══ Services page-specific styles ═══ */

  /* Hero */
  .hero--services { padding-top: clamp(40px, 6vw, 80px); }
  .hero-grid--services {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }
  .svc-hero-img {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }
  .svc-hero-img img {
    max-width: 280px;
    filter: drop-shadow(0 0 40px rgba(130,220,255,.25)) drop-shadow(0 0 80px rgba(177,150,255,.2));
  }

  /* Plans */
  .svc-plans-grid { align-items: stretch; }
  .svc-plan-card {
    display: flex;
    flex-direction: column;
  }
  .svc-plan-card .detail-list { flex: 1; }
  .svc-plan-actions {
    display: flex;
    gap: 10px;
    margin-top: 16px;
    flex-wrap: wrap;
  }
  .svc-plan-actions .button { flex: 1; min-width: 120px; text-align: center; }
  .svc-plans-note {
    margin-top: 20px;
    text-align: center;
    font-size: .85rem;
    color: var(--muted, rgba(209,215,230,.74));
    padding: 16px 20px;
    border-style: dashed;
  }

  /* Add-ons */
  .svc-addon {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .svc-addon h3 { margin: 0; font-size: 1.15rem; }
  .svc-addon p { flex: 1; margin: 0; font-size: .9rem; line-height: 1.6; color: var(--muted, rgba(209,215,230,.74)); }
  .svc-addon .button { margin-top: auto; align-self: flex-start; }

  /* Why VOLYNX */
  .svc-why-card h3 { margin: 0 0 12px; }
  .svc-metrics-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 16px;
  }
  .svc-metric {
    text-align: center;
    padding: 14px 10px;
    border-radius: 14px;
    border: 1px solid var(--line, rgba(255,255,255,.08));
    background: rgba(255,255,255,.03);
  }
  .svc-metric strong {
    display: block;
    font-size: 1.1rem;
    color: var(--cyan, #8bfaf0);
  }
  .svc-metric span {
    display: block;
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--muted, rgba(209,215,230,.74));
    margin-top: 4px;
  }
  .svc-note {
    font-size: .75rem;
    color: var(--muted, rgba(209,215,230,.74));
    opacity: .7;
    margin-top: 12px;
  }

  /* Contact */
  .svc-contact-grid { align-items: stretch; }
  .svc-contact-form form {
    display: grid;
    gap: 14px;
  }
  .svc-input {
    width: 100%;
    padding: 12px 14px;
    border-radius: 14px;
    border: 1px solid var(--line, rgba(255,255,255,.1));
    background: rgba(255,255,255,.04);
    color: var(--text, rgba(245,247,252,.96));
    font: inherit;
    font-size: .95rem;
    backdrop-filter: blur(6px);
  }
  .svc-input:focus {
    outline: none;
    border-color: var(--cyan, #8bfaf0);
  }
  .svc-textarea { min-height: 120px; resize: vertical; }
  .svc-contact-alt {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }
  .svc-contact-alt h3 { margin: 0; }
  .svc-contact-alt p { margin: 0; font-size: .9rem; color: var(--muted, rgba(209,215,230,.74)); line-height: 1.6; }
  .svc-contact-btns {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  /* WhatsApp green tint */
  .svc-whats-btn {
    border-color: rgba(37,211,102,.35) !important;
    color: #25d366 !important;
  }
  .svc-whats-btn:hover {
    background: rgba(37,211,102,.12) !important;
    border-color: rgba(37,211,102,.5) !important;
  }

  /* Responsive */
  @media (min-width: 768px) {
    .hero-grid--services { grid-template-columns: 1.2fr .8fr; }
    .svc-hero-img img { max-width: 340px; }
  }
  @media (max-width: 767px) {
    .svc-hero-img { display: none; }
    .svc-metrics-row { grid-template-columns: 1fr; }
  }
</style>
