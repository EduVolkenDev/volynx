---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";

const conversionBriefHref = `${ROUTES.contact}?product=services&intent=conversion-fix`;
const essentialBriefHref = `${ROUTES.contact}?product=services&intent=essential`;
const growthBriefHref = `${ROUTES.contact}?product=services&intent=growth`;
const premiumBriefHref = `${ROUTES.contact}?product=services&intent=premium`;
---
<FlagshipLayout title="Full Site + Brand — VOLYNX bespoke" description="Custom website and brand identity projects, by brief, quote and approval. Not a template. Built to carry your business." pageClass="page-services">
  <FlagshipHeader current={ROUTES.services} ctaLabel="Book a call" ctaHref="https://calendly.com/volynx-schedule-your-meeting/new-meeting" />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero hero--services">
      <div class="shell hero-grid hero-grid--services">
        <div class="hero-copy">
          <span class="kicker" data-i18n="svc2.kicker">Conversion-led · Bespoke by design · Built around your offer</span>
          <h1 data-i18n="svc2.hero_title">Make your website earn its place.</h1>
          <p data-i18n="svc2.hero_desc">VOLYNX turns unclear websites into premium conversion systems — from a focused 48-hour fix to a complete site and brand built around how your business sells.</p>
          <div class="hero-actions">
            <a href={conversionBriefHref} class="button button--gold" data-i18n="svc2.hero_book">Get a 3-point preview</a>
            <a href="#plans" class="button button--ghost" data-i18n="svc2.hero_brief">See packages</a>
            <a href="https://calendly.com/volynx-schedule-your-meeting/new-meeting" target="_blank" rel="noopener noreferrer" class="button button--ghost" data-i18n="svc2.hero_plans">Book a larger project</a>
          </div>
        </div>
        <div class="hero-visual hero-visual--flagship svc-hero-img svc-hero-stage">
          <img src="/assets/dark-icon-light.webp" alt="VOLYNX" loading="eager" />
        </div>
        <div class="hero-inline-stats">
          <div class="svc-stat-card">
            <img class="svc-stat-icon" src="/assets/tailormade.webp?v=20260502" alt="" loading="lazy" />
            <strong data-i18n="svc2.stat1_val">48h</strong>
            <span data-i18n="svc2.stat1_label">Focused conversion sprint</span>
          </div>
          <div class="svc-stat-card">
            <img class="svc-stat-icon" src="/assets/deadline.webp?v=20260502" alt="" loading="lazy" />
            <strong data-market-price data-market-uk-en="From £249" data-market-uk-pt="A partir de £249" data-market-br-en="Quoted in BRL" data-market-br-pt="Orçado em BRL">From £249</strong>
            <span data-i18n="svc2.stat2_label">Fixed-scope entry</span>
          </div>
          <div class="svc-stat-card">
            <img class="svc-stat-icon" src="/assets/quotes.webp?v=20260502" alt="" loading="lazy" />
            <strong data-i18n="svc2.stat3_val">Fixed</strong>
            <span data-i18n="svc2.stat3_label">No hourly billing</span>
          </div>
          <div class="svc-stat-card">
            <img class="svc-stat-icon" src="/assets/1on1.webp?v=20260502" alt="" loading="lazy" />
            <strong data-i18n="svc2.stat4_val">Yours</strong>
            <span data-i18n="svc2.stat4_label">Full ownership at handoff</span>
          </div>
        </div>
      </div>
      <div class="shell svc-hero-offer-rail">
        <aside class="panel panel--pro svc-hero-offer svc-hero-offer--featured">
          <div class="svc-hero-offer__copy">
            <span class="label label--pro" data-i18n="svc2.fix_chip">Fastest route to a better site</span>
            <h2 data-i18n="svc2.fix_title">Website Conversion Fix</h2>
            <p data-i18n="svc2.fix_desc">Find the friction, sharpen the message and make the next click obvious.</p>
          </div>
          <div class="svc-offer-meta">
            <strong data-market-price data-market-uk-en="From £249" data-market-uk-pt="A partir de £249" data-market-br-en="Quoted in BRL" data-market-br-pt="Orçado em BRL">From £249</strong>
            <span data-i18n="svc2.fix_timeline">48-hour sprint</span>
          </div>
          <a href={conversionBriefHref} class="button button--gold" data-i18n="svc2.fix_cta">Get a 3-point preview</a>
        </aside>
      </div>
    </section>

    <!-- ═══ FAST ENTRY OFFER ═══ -->
    <section id="fix" class="page-section svc-entry-section">
      <div class="shell">
        <div class="panel panel--pro svc-entry-card">
          <div class="svc-entry-copy">
            <span class="eyebrow" data-i18n="svc2.entry_eyebrow">A sharper site without a full rebuild</span>
            <h2 data-i18n="svc2.entry_title">More bookings, enquiries and sales — starting with the friction you already have.</h2>
            <p data-i18n="svc2.entry_desc">Send your URL and the business goal. VOLYNX identifies the highest-impact changes, then delivers a focused improvement sprint without forcing you into a full rebrand.</p>
            <div class="svc-entry-points">
              <div><strong data-i18n="svc2.entry_point1_title">Find the friction</strong><span data-i18n="svc2.entry_point1_desc">Mobile, message, trust and CTA review.</span></div>
              <div><strong data-i18n="svc2.entry_point2_title">Make it obvious</strong><span data-i18n="svc2.entry_point2_desc">A clearer path to booking, enquiry or purchase.</span></div>
              <div><strong data-i18n="svc2.entry_point3_title">Ship the fix</strong><span data-i18n="svc2.entry_point3_desc">Focused implementation, tested and handed back.</span></div>
            </div>
          </div>
          <div class="svc-entry-action">
            <span class="svc-entry-price" data-market-price data-market-uk-en="From £249" data-market-uk-pt="A partir de £249" data-market-br-en="Quoted in BRL" data-market-br-pt="Orçado em BRL">From £249</span>
            <span class="svc-entry-time" data-i18n="svc2.entry_time">48-hour delivery</span>
            <a href={conversionBriefHref} class="button button--gold" data-i18n="svc2.entry_cta">Get a 3-point preview</a>
            <small data-i18n="svc2.entry_note">No pressure. No full audit required to start.</small>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ CHOOSE YOUR ROUTE ═══ -->
    <section id="who-for" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="svc2.fit_eyebrow">Choose your route</span>
        <h2 data-i18n="svc2.fit_title">One focused fix, one complete launch, or a bespoke growth system.</h2>
        <p data-i18n="svc2.fit_desc">Start at the smallest useful intervention. Scale only when the business needs more.</p>
      </div>
      <div class="shell grid-3 svc-route-grid">
        <article class="panel svc-why-card svc-showcase-card">
          <div class="svc-card-showcase" aria-hidden="true">
            <img src="/assets/landing-express/conversion-path.webp" alt="" loading="lazy" />
          </div>
          <span class="label label--pro" data-market-price data-market-uk-en="Fast entry · from £249" data-market-uk-pt="Entrada rápida · a partir de £249" data-market-br-en="Fast entry · quoted in BRL" data-market-br-pt="Entrada rápida · orçado em BRL">Fast entry · from £249</span>
          <h3 data-i18n="svc2.fit_yes_title">Fix what is already costing you leads.</h3>
          <ul class="detail-list">
            <li data-i18n-html="svc2.fit_yes1"><strong>You have an existing site</strong> but visitors are not taking the next step.</li>
            <li data-i18n-html="svc2.fit_yes2"><strong>Your booking, enquiry or purchase path feels unclear</strong> on mobile.</li>
            <li data-i18n-html="svc2.fit_yes3"><strong>You need a sharp intervention</strong> before committing to a full rebuild.</li>
          </ul>
          <div class="svc-route-actions"><a href={conversionBriefHref} class="button button--gold" data-i18n="svc2.route_fast_cta">Get the preview</a></div>
        </article>
        <article class="panel svc-why-card svc-showcase-card panel--pro">
          <div class="svc-card-showcase" aria-hidden="true">
            <img src="/assets/landing-express/responsive-build.webp" alt="" loading="lazy" />
          </div>
          <span class="label label--pro" data-market-price data-market-uk-en="Landing Express · from £300" data-market-uk-pt="Landing Express · a partir de £300" data-market-br-en="Landing Express · quoted in BRL" data-market-br-pt="Landing Express · orçado em BRL">Landing Express · from £300</span>
          <h3 data-i18n="svc2.route_landing_title">Launch a serious landing page fast.</h3>
          <ul class="detail-list">
            <li data-i18n-html="svc2.route_landing1"><strong>One focused page</strong> built around your offer and the action you want visitors to take.</li>
            <li data-i18n-html="svc2.route_landing2"><strong>Premium design and responsive build</strong> ready for mobile, desktop and real-world traffic.</li>
            <li data-i18n-html="svc2.route_landing3"><strong>48–72h delivery</strong> with CTA, booking/contact flow and launch handoff included.</li>
          </ul>
          <div class="svc-route-actions"><a href={ROUTES.landingExpress} class="button button--gold" data-i18n="svc2.route_landing_cta">Explore Landing Express</a></div>
        </article>
        <article class="panel svc-why-card svc-showcase-card">
          <div class="svc-card-showcase" aria-hidden="true">
            <img src="/assets/landing-express/premium-visual-system.webp" alt="" loading="lazy" />
          </div>
          <span class="label" data-market-price data-market-uk-en="Flagship build · from £10,000" data-market-uk-pt="Projeto flagship · a partir de £10.000" data-market-br-en="Flagship build · from R$29,900" data-market-br-pt="Projeto flagship · a partir de R$29.900">Flagship build · from £10,000</span>
          <h3 data-i18n="svc2.fit_no_title">Build the flagship version.</h3>
          <ul class="detail-list">
            <li data-i18n-html="svc2.fit_no1"><strong>You're launching or repositioning</strong> and need the whole message to feel coherent.</li>
            <li data-i18n-html="svc2.fit_no2"><strong>You want strategy, copy, design and code aligned</strong> under one VOLYNX direction.</li>
            <li data-i18n-html="svc2.fit_no3"><strong>You need a system that can grow</strong> with integrations, content and future offers.</li>
          </ul>
          <div class="svc-route-actions"><a href="#plans" class="button button--ghost" data-i18n="svc2.route_build_cta">See build packages</a></div>
        </article>
      </div>
    </section>

    <!-- ═══ PROCESS ═══ -->
    <section id="process" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="svc2.process_eyebrow">How it runs</span>
        <h2 data-i18n="svc2.process_title">A clear path from first message to live site.</h2>
        <p data-i18n="svc2.process_desc">The fast fix stays focused. Larger projects get a clear plan, milestones and written boundaries. Either way, you know what happens next and what is expected from both sides.</p>
      </div>
      <div class="shell grid-3 svc-plans-grid">
        <article class="panel svc-plan-card svc-plan-card--process">
          <div class="svc-card-top">
            <div class="svc-card-icon svc-card-icon--process" aria-hidden="true">
              <img src="/assets/discoverycall1.webp" alt="" loading="lazy" decoding="async" />
            </div>
            <span class="label" data-i18n="svc2.step1_num">01</span>
          </div>
          <h3 data-i18n="svc2.step1_title">Discovery call</h3>
          <p data-i18n="svc2.step1_desc">30-45 min on Calendly. We cover your offer, audience, constraints, existing assets and the win condition.</p>
        </article>
        <article class="panel svc-plan-card svc-plan-card--process">
          <div class="svc-card-top">
            <div class="svc-card-icon svc-card-icon--process" aria-hidden="true">
              <img src="/assets/briefanalysis1.webp" alt="" loading="lazy" decoding="async" />
            </div>
            <span class="label" data-i18n="svc2.step2_num">02</span>
          </div>
          <h3 data-i18n="svc2.step2_title">Brief analysis</h3>
          <p data-i18n="svc2.step2_desc">The call becomes a written brief: what you're selling, to whom, what the site and brand need to accomplish.</p>
        </article>
        <article class="panel svc-plan-card svc-plan-card--process">
          <div class="svc-card-top">
            <div class="svc-card-icon svc-card-icon--process" aria-hidden="true">
              <img src="/assets/quoteandtimeline2.webp" alt="" loading="lazy" decoding="async" />
            </div>
            <span class="label" data-i18n="svc2.step3_num">03</span>
          </div>
          <h3 data-i18n="svc2.step3_title">Quote &amp; timeline</h3>
          <p data-i18n="svc2.step3_desc">Fixed written quote, clear milestones and payment terms: 40% to start, 30% after design approval and 30% before launch.</p>
        </article>
        <article class="panel svc-plan-card svc-plan-card--process">
          <div class="svc-card-top">
            <div class="svc-card-icon svc-card-icon--process" aria-hidden="true">
              <img src="/assets/approval1.webp" alt="" loading="lazy" decoding="async" />
            </div>
            <span class="label" data-i18n="svc2.step4_num">04</span>
          </div>
          <h3 data-i18n="svc2.step4_title">Approval</h3>
          <p data-i18n="svc2.step4_desc">You sign off the scope and deposit. Work doesn't start before approval. Nothing assumed.</p>
        </article>
        <article class="panel svc-plan-card svc-plan-card--process">
          <div class="svc-card-top">
            <div class="svc-card-icon svc-card-icon--process" aria-hidden="true">
              <img src="/assets/buildanditeration1.webp" alt="" loading="lazy" decoding="async" />
            </div>
            <span class="label" data-i18n="svc2.step5_num">05</span>
          </div>
          <h3 data-i18n="svc2.step5_title">Build &amp; iteration</h3>
          <p data-i18n="svc2.step5_desc">Brand, design, copy and code in parallel. Scheduled review checkpoints. Revisions inside scope.</p>
        </article>
        <article class="panel svc-plan-card svc-plan-card--process">
          <div class="svc-card-top">
            <div class="svc-card-icon svc-card-icon--process" aria-hidden="true">
              <img src="/assets/deliveryandhandoff1.webp" alt="" loading="lazy" decoding="async" />
            </div>
            <span class="label" data-i18n="svc2.step6_num">06</span>
          </div>
          <h3 data-i18n="svc2.step6_title">Delivery &amp; handoff</h3>
          <p data-i18n="svc2.step6_desc">Launch, training and source-file transfer, with technical care available under a defined support plan. Full ownership is yours.</p>
        </article>
      </div>
    </section>

    <!-- ═══ SCOPE PACKAGES ═══ -->
    <section id="plans" class="page-section svc-plans-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="svc2.plans_eyebrow">Packages and scope</span>
        <h2 data-i18n="svc2.plans_title">Choose the level of build your business actually needs.</h2>
        <p data-i18n="svc2.plans_desc">Choose the market that applies to you. Each project receives a fixed written quote before work begins, with the included scope clearly defined.</p>
      </div>
      <div class="shell svc-market-bar" data-market-root>
        <div>
          <span class="eyebrow" data-i18n="svc2.market_eyebrow">Pricing by market</span>
          <p data-i18n="svc2.market_note">Choose your market to see the appropriate price and scope.</p>
        </div>
        <div class="svc-market-toggle" role="group" aria-label="Pricing market">
          <button type="button" class="is-active" data-market="uk" aria-pressed="true"><strong>UK</strong><span>GBP</span></button>
          <button type="button" data-market="br" aria-pressed="false"><strong>Brasil</strong><span>BRL</span></button>
        </div>
      </div>
      <div class="shell grid-3 svc-plans-grid">

        <!-- Essential -->
        <article class="panel svc-tier-card svc-tier-card--launch svc-plan-card">
          <div class="svc-tier-card__visual" aria-hidden="true">
            <img src="/assets/starter.webp" alt="" class="svc-tier-card__asset" loading="lazy" />
          </div>
          <div class="svc-tier-card__body">
            <div class="svc-tier-card__head">
              <span class="svc-tier-card__eyebrow label" data-market-price data-market-uk-en="From £2,400 · 2–3 weeks · up to 5 focused days" data-market-uk-pt="A partir de £2.400 · 2–3 semanas · até 5 dias focados" data-market-br-en="From R$6,500 · 2–3 weeks · local scope" data-market-br-pt="A partir de R$6.500 · 2–3 semanas · escopo local">From £2,400 · 2–3 weeks · up to 5 focused days</span>
              <h3 data-i18n="svc2.plan1_title">Launch</h3>
              <p data-market-copy data-market-uk-en="One premium landing page built from your brief, with a compact visual direction. Best for a focused launch where one page carries the pitch." data-market-uk-pt="Uma landing page premium construída a partir do seu briefing, com direção visual compacta. Indicada para um lançamento focado em que uma página concentra a oferta." data-market-br-en="A focused landing page based on a VOLYNX structure, adapted to your offer and audience." data-market-br-pt="Uma landing page focada, baseada em uma estrutura VOLYNX e adaptada à sua oferta e ao seu público.">One premium landing page built from your brief, with a compact visual direction. Best for a focused launch where one page carries the pitch.</p>
            </div>
            <ul class="svc-tier-card__features detail-list">
              <li data-market-copy data-market-uk-en="One custom landing page · up to 7 sections" data-market-uk-pt="Uma landing page personalizada · até 7 seções" data-market-br-en="One customised landing page · up to 5 sections" data-market-br-pt="Uma landing page personalizada · até 5 seções">One custom landing page · up to 7 sections</li>
              <li data-market-copy data-market-uk-en="Custom design and development" data-market-uk-pt="Design e desenvolvimento personalizados" data-market-br-en="Adaptation of a VOLYNX structure + responsive development" data-market-br-pt="Adaptação de uma estrutura VOLYNX + desenvolvimento responsivo">Custom design and development</li>
              <li data-market-copy data-market-uk-en="Compact visual direction: palette, type and existing brand application" data-market-uk-pt="Direção visual compacta: paleta, tipografia e aplicação da marca existente" data-market-br-en="Light visual direction using your existing brand" data-market-br-pt="Direção visual leve usando sua marca existente">Compact visual direction: palette, type and existing brand application</li>
              <li data-market-copy data-market-uk-en="Copy structure developed collaboratively · full copywriting not included" data-market-uk-pt="Estrutura de copy desenvolvida em colaboração · copywriting completo não incluído" data-market-br-en="Copy structure developed collaboratively · full copywriting not included" data-market-br-pt="Estrutura de copy desenvolvida em colaboração · copywriting completo não incluído">Copy structure developed collaboratively · full copywriting not included</li>
              <li data-market-copy data-market-uk-en="Basic technical SEO and analytics setup" data-market-uk-pt="SEO técnico básico e configuração de analytics" data-market-br-en="Basic technical SEO and analytics" data-market-br-pt="SEO técnico básico e analytics">Basic technical SEO and analytics setup</li>
              <li data-market-copy data-market-uk-en="Two consolidated revision rounds" data-market-uk-pt="Duas rodadas consolidadas de revisão" data-market-br-en="Two consolidated revision rounds" data-market-br-pt="Duas rodadas consolidadas de revisão">Two consolidated revision rounds</li>
              <li data-market-copy data-market-uk-en="14 days of technical support after launch" data-market-uk-pt="14 dias de suporte técnico após o lançamento" data-market-br-en="14 days of technical support after launch" data-market-br-pt="14 dias de suporte técnico após o lançamento">14 days of technical support after launch</li>
            </ul>
            <div class="svc-plan-actions">
              <a href="https://calendly.com/volynx-schedule-your-meeting/new-meeting" target="_blank" rel="noopener noreferrer" class="button button--gold" data-i18n="svc2.plan_call">Book a discovery call</a>
              <a href={essentialBriefHref} class="button button--ghost" data-i18n="svc2.plan_fit">Check fit first</a>
            </div>
          </div>
        </article>

        <!-- Growth -->
        <article class="panel panel--pro svc-tier-card svc-tier-card--growth svc-tier-card--featured svc-plan-card">
          <div class="svc-tier-card__visual" aria-hidden="true">
            <img src="/assets/pro.webp" alt="" class="svc-tier-card__asset" loading="lazy" />
          </div>
          <div class="svc-tier-card__body">
            <div class="svc-tier-card__head">
              <span class="svc-tier-card__eyebrow label label--pro" data-market-price data-market-uk-en="From £5,500 · 4–6 weeks · up to 12 focused days" data-market-uk-pt="A partir de £5.500 · 4–6 semanas · até 12 dias focados" data-market-br-en="From R$14,900 · 4–6 weeks · adapted scope" data-market-br-pt="A partir de R$14.900 · 4–6 semanas · escopo adaptado">From £5,500 · 4–6 weeks · up to 12 focused days</span>
              <h3 data-i18n="svc2.plan2_title">Growth · most common</h3>
              <p data-market-copy data-market-uk-en="A custom multi-page website with an essential brand system, clear structure and a guided route to launch." data-market-uk-pt="Um site personalizado com várias páginas, sistema de marca essencial, estrutura clara e caminho guiado até o lançamento." data-market-br-en="A custom website with a practical page structure and an essential brand system adapted to the Brazilian market." data-market-br-pt="Um site personalizado com estrutura prática de páginas e sistema de marca essencial adaptado ao mercado brasileiro.">A custom multi-page website with an essential brand system, clear structure and a guided route to launch.</p>
            </div>
            <ul class="svc-tier-card__features detail-list">
              <li data-market-copy data-market-uk-en="Custom website · up to 6 pages" data-market-uk-pt="Site personalizado · até 6 páginas" data-market-br-en="Custom website · up to 5 pages" data-market-br-pt="Site personalizado · até 5 páginas">Custom website · up to 6 pages</li>
              <li data-market-copy data-market-uk-en="Essential brand system" data-market-uk-pt="Sistema de marca essencial" data-market-br-en="Essential brand system" data-market-br-pt="Sistema de marca essencial">Essential brand system</li>
              <li data-market-copy data-market-uk-en="Narrative and structure for each page" data-market-uk-pt="Narrativa e estrutura de cada página" data-market-br-en="Narrative and structure for each page" data-market-br-pt="Narrativa e estrutura de cada página">Narrative and structure for each page</li>
              <li data-market-copy data-market-uk-en="Basic CMS, if needed" data-market-uk-pt="CMS básico, se necessário" data-market-br-en="Basic CMS, if needed" data-market-br-pt="CMS básico, se necessário">Basic CMS, if needed</li>
              <li data-market-copy data-market-uk-en="Technical SEO, analytics, domain and email setup · external costs separate" data-market-uk-pt="SEO técnico, analytics, domínio e configuração de e-mail · custos externos à parte" data-market-br-en="Technical SEO, analytics, domain and email setup · external costs separate" data-market-br-pt="SEO técnico, analytics, domínio e configuração de e-mail · custos externos à parte">Technical SEO, analytics, domain and email setup · external costs separate</li>
              <li data-market-copy data-market-uk-en="Three consolidated revision rounds" data-market-uk-pt="Três rodadas consolidadas de revisão" data-market-br-en="Three consolidated revision rounds" data-market-br-pt="Três rodadas consolidadas de revisão">Three consolidated revision rounds</li>
              <li data-market-copy data-market-uk-en="30 days of technical support" data-market-uk-pt="30 dias de suporte técnico" data-market-br-en="30 days of technical support" data-market-br-pt="30 dias de suporte técnico">30 days of technical support</li>
