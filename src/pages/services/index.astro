<script is:inline>
  (() => {
    const root = document.querySelector("[data-market-root]");
    if (!root) return;
    const buttons = Array.from(root.querySelectorAll("[data-market]"));
    const storageKey = "volynx_services_market";
    const getLanguage = () => String(document.documentElement.lang || "en").toLowerCase().startsWith("pt") ? "pt" : "en";
    const storedLanguage = (() => {
      try { return localStorage.getItem("volynx_lang") || ""; } catch (_) { return ""; }
    })();
    let activeMarket = (() => {
      try {
        const stored = localStorage.getItem(storageKey);
        if (stored === "uk" || stored === "br") return stored;
      } catch (_) {}
      return storedLanguage.startsWith("pt") ? "br" : "uk";
    })();

    const applyMarket = (market) => {
      activeMarket = market === "br" ? "br" : "uk";
      const marketKey = activeMarket === "br" ? "Br" : "Uk";
      const languageKey = getLanguage() === "pt" ? "Pt" : "En";
      document.querySelectorAll("[data-market-price], [data-market-copy]").forEach((node) => {
        const value = node.dataset[`market${marketKey}${languageKey}`];
        if (value) node.textContent = value;
      });
      buttons.forEach((button) => {
        const selected = button.dataset.market === activeMarket;
        button.classList.toggle("is-active", selected);
        button.setAttribute("aria-pressed", String(selected));
      });
      try { localStorage.setItem(storageKey, activeMarket); } catch (_) {}
    };

    buttons.forEach((button) => button.addEventListener("click", () => applyMarket(button.dataset.market)));
