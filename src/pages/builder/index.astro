---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";
---
<FlagshipLayout title="Builder — VOLYNX" description="Create and manage premium mini-sites with a JSON editor, magic link auth and one-click publish." pageClass="page-builder">
  <FlagshipHeader current={ROUTES.builder} ctaLabel="Builder Pro" />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="kicker" data-i18n="builder2.hero_kicker">Builder flagship</span>
          <h1 data-i18n="builder2.hero_title">Professional publishing infrastructure for teams that take their web presence seriously.</h1>
          <p data-i18n="builder2.hero_desc">Builder is the serious publishing layer with premium themes, cleaner control surfaces and a much more visible distinction between Free and Pro. Launch premium mini-sites fast.</p>
          <div class="hero-actions">
            <a href="#plans" class="button button--gold" data-i18n="builder2.compare_plans">Compare plans</a>
            <a href={ROUTES.pricing} class="button button--ghost" data-i18n="builder2.pricing">Pricing</a>
          </div>
        </div>
        <div class="hero-card visual-card">
          <span class="label label--pro">Builder Pro</span>
          <div class="stack">
            <div class="metric">Custom domain</div>
            <div class="metric">Version restore</div>
            <div class="metric">Premium sections</div>
            <div class="metric">Full export logic</div>
          </div>
          <img src="/assets/volynx-icon.webp" alt="Builder" />
        </div>
      </div>
    </section>

    <!-- ═══ PLANS OVERVIEW ═══ -->
    <section id="plans" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow" data-i18n="builder2.plans_eyebrow">Builder plans</span>
        <h2 data-i18n="builder2.plans_title">From draft to production, at your pace</h2>
        <p data-i18n="builder2.plans_desc">Free is generous enough to test the flow. Pro is the serious layer for custom domains, premium kits and clean deployment.</p>
      </div>
      <div class="shell grid-3">
        <article class="panel feature-card">
          <span class="label label--free" data-i18n="builder2.free_label">Free</span>
          <h3 data-i18n="builder2.tier1_title">Draft and learn</h3>
          <p data-i18n="builder2.tier1_desc">Enough to understand the flow, test the editor and experience the VOLYNX system. 1 draft, full editor, preview with Volynx branding.</p>
          <ul class="detail-list">
            <li data-i18n="builder2.tier1_item1">1 draft project</li>
            <li data-i18n="builder2.tier1_item2">Full editor access</li>
            <li data-i18n="builder2.tier1_item3">Preview mode</li>
            <li data-i18n="builder2.tier1_item4">Volynx branding visible</li>
          </ul>
        </article>
        <article class="panel feature-card panel--pro">
          <span class="label label--pro" data-i18n="builder2.pro_label">Pro</span>
          <h3 data-i18n="builder2.tier2_title">Publish with confidence</h3>
          <p data-i18n="builder2.tier2_desc">Custom domains, premium sections, reusable brand profiles and a cleaner deployment experience. The anchor plan for serious creators.</p>
          <ul class="detail-list">
            <li data-i18n="builder2.tier2_item1">Up to 3 published sites</li>
            <li data-i18n="builder2.tier2_item2">Custom domain</li>
            <li data-i18n="builder2.tier2_item3">Remove Volynx branding</li>
            <li data-i18n="builder2.tier2_item4">Selected premium kits</li>
            <li data-i18n="builder2.tier2_item5">Publish priority</li>
          </ul>
          <a href={ROUTES.pricing} class="button button--gold" style="margin-top:auto;" data-i18n="builder2.go_pro">Go Pro</a>
        </article>
        <article class="panel feature-card">
          <span class="label" data-i18n="builder2.teams_label">Teams</span>
          <h3 data-i18n="builder2.tier3_title">Shared publishing operations</h3>
          <p data-i18n="builder2.tier3_desc">Seats, approvals, asset pools and handoff logic for agencies and teams. Central billing and shared icons pool.</p>
          <ul class="detail-list">
            <li data-i18n="builder2.tier3_item1">25 sites</li>
            <li data-i18n="builder2.tier3_item2">Workspace</li>
            <li data-i18n="builder2.tier3_item3">Central billing</li>
            <li data-i18n="builder2.tier3_item4">Shared assets and icons pool</li>
            <li data-i18n="builder2.tier3_item5">Priority support</li>
          </ul>
          <a href={ROUTES.contact} class="button button--ghost" style="margin-top:auto;" data-i18n="builder2.talk_to_volynx">Talk to Volynx</a>
        </article>
      </div>
    </section>

    <!-- ═══ COMPARISON ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <h2 data-i18n="builder2.comparison_title">What changes with each tier</h2>
      </div>
      <div class="shell comparison">
        <div class="comparison-row"><strong data-i18n="builder2.comp_label1">Project overview</strong><span class="check" data-i18n="builder2.comp_val1_free">Basic list</span><span class="check pro" data-i18n="builder2.comp_val1_pro">Command center cards with status and usage</span></div>
        <div class="comparison-row"><strong data-i18n="builder2.comp_label2">Publishing</strong><span class="check" data-i18n="builder2.comp_val2_free">Subdomain and preview</span><span class="check pro" data-i18n="builder2.comp_val2_pro">Custom domain, priority publish and restore</span></div>
        <div class="comparison-row"><strong data-i18n="builder2.comp_label3">Templates</strong><span class="check" data-i18n="builder2.comp_val3_free">Base options</span><span class="check pro" data-i18n="builder2.comp_val3_pro">Premium systems and stronger defaults</span></div>
        <div class="comparison-row"><strong data-i18n="builder2.comp_label4">Branding</strong><span class="check" data-i18n="builder2.comp_val4_free">Volynx watermark</span><span class="check pro" data-i18n="builder2.comp_val4_pro">Full white-label control</span></div>
        <div class="comparison-row"><strong data-i18n="builder2.comp_label5">Export</strong><span class="check" data-i18n="builder2.comp_val5_free">Preview only</span><span class="check pro" data-i18n="builder2.comp_val5_pro">HTML export + asset packages</span></div>
      </div>
    </section>

    <!-- ═══ CTA ═══ -->
    <section class="page-section page-section--last">
      <div class="shell callout panel panel--pro">
        <div>
          <span class="label label--pro" data-i18n="builder2.cta_label">Launch today</span>
          <strong data-i18n="builder2.cta_title">Faster than a generic builder. More premium than a cheap solution.</strong>
          <p data-i18n="builder2.cta_desc">VOLYNX Builder sells speed, premium finish, simple publish, ready-made kits and integration with icons, assets and services.</p>
        </div>
        <div class="hero-actions">
          <a href={ROUTES.pricing} class="button button--gold" data-i18n="builder2.see_pricing">See pricing</a>
          <a href={ROUTES.devHub} class="button button--ghost" data-i18n="builder2.explore_devhub">Explore Dev Hub</a>
        </div>
      </div>
    </section>

  </main>
  <FlagshipFooter />
</FlagshipLayout>
