---
import LabBg from "../../components/LabBg.astro";
import Topbar from "../../components/Topbar.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PageWidgets from "../../components/PageWidgets.astro";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>VOLYNX Builder — Create & Manage Sites</title>
  <meta name="description" content="Create and manage mini-sites with a JSON editor, magic link auth and one-click publish." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
</head>

<body>
  <LabBg src="/assets/lucid3.jpg" />
  <Topbar leftLinks={[{ href: "/volynx-lab/studio/", label: "Studio" }, { href: "/products/", label: "Products" }]} rightLinks={[{ href: "/profile/", label: "Profile" }]} />

  <!-- HERO -->
  <section class="hero">
    <div class="hero__badge">
      <span class="badge-dot" aria-hidden="true"></span>
      <span data-i18n="builder.badge">VOLYNX Builder</span>
    </div>
    <h1 class="hero__title" data-i18n="builder.title">
      Build &amp; <span class="accent">Deploy</span> Sites
    </h1>
    <p class="hero__sub" data-i18n="builder.subtitle">
      Create mini-sites with JSON, manage them in one place,
      and publish to your own subdomain.
    </p>
  </section>

  <!-- APP SHELL -->
  <main class="app" id="app">

    <!-- AUTH PANEL (shown when logged out) -->
    <div class="panel auth-panel" id="authPanel">
      <div class="panel__icon" aria-hidden="true">⚡</div>
      <h2 class="panel__title" data-i18n="builder.auth.title">Sign in to Builder</h2>
      <p class="panel__sub" data-i18n="builder.auth.subtitle">Enter your email — we'll send a magic link. No password needed.</p>
      <div class="auth-form">
        <input
          id="email"
          type="email"
          placeholder="your@email.com"
          autocomplete="email"
          class="field"
        />
        <button class="btn btn--primary" id="sendLink" data-i18n="builder.auth.cta">Get magic link</button>
        <p class="auth-msg" id="authMsg"></p>
      </div>
    </div>

    <!-- BUILDER WORKSPACE (shown when logged in) -->
    <div class="workspace" id="workspace" hidden>

      <!-- Session bar -->
      <div class="session-bar">
        <div class="session-who">
          <span class="dot" aria-hidden="true"></span>
          <span id="who" class="session-email">...</span>
        </div>
        <button id="logout" class="btn btn--ghost btn--sm">Sign out</button>
      </div>

      <div class="grid">
        <!-- NEW PROJECT WIZARD -->
        <div class="card card--wizard" id="wizardCard">
          <!-- Step indicator -->
          <div class="wizard-steps">
            <span class="wizard-dot wizard-dot--active" data-step="1">1</span>
            <span class="wizard-line"></span>
            <span class="wizard-dot" data-step="2">2</span>
          </div>

          <!-- STEP 1: Project & Preset -->
          <div class="wizard-step" id="wizStep1">
            <h3 class="card__title">New project</h3>

            <div class="preset-picker">
              <label class="label">Start from a kit</label>
              <div class="preset-grid" id="presetGrid"></div>
            </div>

            <!-- Variant selectors (populated by JS per preset) -->
            <div id="variantSelectors" class="variant-selectors" hidden></div>

            <div class="row" style="margin-top:14px">
              <div class="field-group">
                <label class="label" for="pname">Project name</label>
                <input id="pname" class="field" placeholder="Studio Aurora" />
              </div>
              <div class="field-group">
                <label class="label" for="pslug">Slug</label>
                <input id="pslug" class="field" placeholder="studio-aurora" />
              </div>
            </div>

            <button class="btn btn--primary" id="toStep2" style="margin-top:14px;width:100%">
              Next: Brand & details →
            </button>
          </div>

          <!-- STEP 2: Brand & Config -->
          <div class="wizard-step" id="wizStep2" hidden>
            <h3 class="card__title">Brand & details</h3>

            <div class="row">
              <div class="field-group">
                <label class="label" for="wBrand">Brand name</label>
                <input id="wBrand" class="field" placeholder="Acme Inc" />
              </div>
              <div class="field-group">
                <label class="label" for="wTagline">Tagline</label>
                <input id="wTagline" class="field" placeholder="Build faster, ship smarter." />
              </div>
            </div>

            <div class="row" style="margin-top:12px">
              <div class="field-group">
                <label class="label" for="wCta">Primary CTA label</label>
                <input id="wCta" class="field" placeholder="Get started" />
              </div>
              <div class="field-group">
                <label class="label" for="wCtaHref">CTA link</label>
                <input id="wCtaHref" class="field" placeholder="https://..." />
              </div>
            </div>

            <div class="row" style="margin-top:12px">
              <div class="field-group">
                <label class="label" for="wAudience">Audience</label>
                <select id="wAudience" class="field">
                  <option value="b2b">B2B / Companies</option>
                  <option value="b2c">B2C / Consumers</option>
                  <option value="developers">Developers</option>
                  <option value="creators">Creators / Freelancers</option>
                  <option value="agencies">Agencies</option>
                </select>
              </div>
              <div class="field-group">
                <label class="label" for="wGoal">Goal</label>
                <select id="wGoal" class="field">
                  <option value="leads">Lead generation</option>
                  <option value="sales">Direct sales</option>
                  <option value="showcase">Showcase / portfolio</option>
                  <option value="bookings">Bookings</option>
                  <option value="waitlist">Waitlist</option>
                </select>
              </div>
            </div>

            <div class="row" style="margin-top:12px">
              <div class="field-group">
                <label class="label" for="wTone">Tone</label>
                <select id="wTone" class="field">
                  <option value="premium">Premium</option>
                  <option value="minimal">Minimal</option>
                  <option value="bold">Bold</option>
                  <option value="futuristic">Futuristic</option>
                  <option value="organic">Organic</option>
                </select>
              </div>
              <div class="field-group">
                <label class="label" for="wLang">Language</label>
                <select id="wLang" class="field">
                  <option value="en">English</option>
                  <option value="pt">Português</option>
                </select>
              </div>
            </div>

            <!-- Optional sections (populated by JS per preset) -->
            <div id="optionalToggles" class="optional-toggles" style="margin-top:14px"></div>

            <div style="display:flex;gap:8px;margin-top:16px">
              <button class="btn btn--ghost" id="backStep1" style="flex:1">← Back</button>
              <button class="btn btn--primary" id="create" style="flex:2">Create project →</button>
            </div>
            <p class="hint" style="margin-top:10px">
              Will publish at <code>https://<span id="slugPreview">slug</span>.volynx.world</code>
            </p>
          </div>
        </div>

        <!-- PROJECTS LIST -->
        <div class="card card--list">
          <h3 class="card__title">My projects</h3>
          <div id="projects" class="projects-list hint">No projects yet.</div>
        </div>

        <!-- JSON EDITOR -->
        <div class="card card--editor">
          <div class="editor-header">
            <h3 class="card__title">JSON editor</h3>
            <div class="editor-actions">
              <button class="btn btn--ghost btn--sm" id="copy">Copy</button>
              <button class="btn btn--ghost btn--sm" id="save">Save</button>
              <button class="btn btn--primary btn--sm" id="publish">Publish →</button>
            </div>
          </div>
          <textarea id="json" class="json-editor" placeholder="Select a project to edit…" spellcheck="false"></textarea>
          <div class="editor-footer">
            <p class="hint" id="status"></p>
            <p class="hint" id="link"></p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <SiteFooter />
  <PageWidgets />
</body>
</html>

<script>
  import { createClient } from "@supabase/supabase-js";

  const $ = (id: string) => document.getElementById(id);
  const log = (msg: string) => console.log(`[builder] ${msg}`);

  let supa: any = null;
  let currentProject: any = null;
  let presetsData: any = {};
  let presets: any[] = [];
  let selectedPresetId = "blank";
  let selectedVariants: Record<string, string> = {};
  let wizardStep = 1;

  const KEYS = ["volynx_access_token", "volynx_refresh_token", "volynx_user_email"];

  const setStatus = (t: string) => { const el = $("status"); if (el) el.textContent = t || ""; };

  const slugify = (s: string) =>
    (s || "").toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

  const rand4 = () => Math.random().toString(16).slice(2, 6);

  // ── Wizard navigation ──────────────────────────────────────
  function showWizardStep(step: number) {
    wizardStep = step;
    ($("wizStep1") as HTMLElement).hidden = step !== 1;
    ($("wizStep2") as HTMLElement).hidden = step !== 2;
    document.querySelectorAll(".wizard-dot").forEach(d => {
      const s = Number((d as HTMLElement).dataset.step);
      d.classList.toggle("wizard-dot--active", s <= step);
    });
    if (step === 2) {
      const slug = slugify(($("pname") as HTMLInputElement)?.value || "") || "slug";
      const preview = $("slugPreview");
      if (preview) preview.textContent = `${slug}-${rand4()}`;
      renderOptionalToggles();
    }
  }

  // ── Preset picker ──────────────────────────────────────────
  async function loadPresets() {
    try {
      const res = await fetch("/builder/presets.json", { cache: "no-store" });
      if (!res.ok) return;
      presetsData = await res.json();
      presets = presetsData.presets || [];
      renderPresetPicker();
      log("presets loaded: " + presets.length);
    } catch { log("presets unavailable"); }
  }

  function renderPresetPicker() {
    const grid = $("presetGrid");
    if (!grid) return;
    const blank = `<button type="button" class="preset-card preset-card--active" data-preset="blank">
      <span class="preset-icon">✏️</span>
      <span class="preset-name">Custom</span>
      <span class="preset-tag">Blank</span>
    </button>`;
    const cards = presets.map((p: any) => `<button type="button" class="preset-card" data-preset="${p.id}">
      <span class="preset-icon">${p.icon || "📦"}</span>
      <span class="preset-name">${p.name}</span>
      <span class="preset-tag">${p.tag || ""}</span>
    </button>`).join("");
    grid.innerHTML = blank + cards;

    grid.querySelectorAll(".preset-card").forEach(btn => {
      btn.addEventListener("click", () => {
        grid.querySelectorAll(".preset-card").forEach(b => b.classList.remove("preset-card--active"));
        btn.classList.add("preset-card--active");
        selectedPresetId = (btn as HTMLElement).dataset.preset || "blank";
        selectedVariants = {};
        renderVariantSelectors();
        log("preset selected: " + selectedPresetId);
      });
    });
    renderVariantSelectors();
  }

  // ── Variant selectors (per preset) ─────────────────────────
  function renderVariantSelectors() {
    const box = $("variantSelectors") as HTMLElement;
    if (!box) return;
    const preset = presets.find((p: any) => p.id === selectedPresetId);
    if (!preset?.variants) { box.hidden = true; box.innerHTML = ""; return; }

    box.hidden = false;
    box.innerHTML = Object.entries(preset.variants as Record<string, any>).map(([key, v]: [string, any]) => {
      selectedVariants[key] = selectedVariants[key] || v.default;
      return `<div class="field-group field-group--inline">
        <label class="label">${v.label}</label>
        <div class="chip-group" data-variant-key="${key}">
          ${v.options.map((opt: string) => `<button type="button" class="chip ${opt === (selectedVariants[key] || v.default) ? "chip--active" : ""}" data-value="${opt}">${opt}</button>`).join("")}
        </div>
      </div>`;
    }).join("");

    box.querySelectorAll(".chip-group").forEach(group => {
      const key = (group as HTMLElement).dataset.variantKey!;
      group.querySelectorAll(".chip").forEach(chip => {
        chip.addEventListener("click", () => {
          group.querySelectorAll(".chip").forEach(c => c.classList.remove("chip--active"));
          chip.classList.add("chip--active");
          selectedVariants[key] = (chip as HTMLElement).dataset.value || "";
          log(`variant ${key} = ${selectedVariants[key]}`);
        });
      });
    });
  }

  // ── Optional section toggles ───────────────────────────────
  function renderOptionalToggles() {
    const box = $("optionalToggles") as HTMLElement;
    if (!box) return;
    const preset = presets.find((p: any) => p.id === selectedPresetId);
    if (!preset?.optionalSections) { box.innerHTML = ""; return; }

    box.innerHTML = `<label class="label">Include sections</label><div class="toggle-grid">` +
      Object.entries(preset.optionalSections as Record<string, any>).map(([key, cfg]: [string, any]) =>
        `<label class="toggle-item">
          <input type="checkbox" data-section="${key}" ${cfg.default ? "checked" : ""} />
          <span>${cfg.label}</span>
        </label>`
      ).join("") + `</div>`;
  }

  function getEnabledSections(): Set<string> {
    const enabled = new Set<string>();
    const box = $("optionalToggles");
    if (!box) return enabled;
    box.querySelectorAll<HTMLInputElement>("input[data-section]").forEach(cb => {
      if (cb.checked) enabled.add(cb.dataset.section!);
    });
    return enabled;
  }

  // ── Build project data ─────────────────────────────────────
  interface WizardInputs {
    name: string;
    brand: string;
    tagline: string;
    cta: string;
    ctaHref: string;
    audience: string;
    goal: string;
    tone: string;
    lang: string;
  }

  function getWizardInputs(): WizardInputs {
    return {
      name: (($("pname") as HTMLInputElement)?.value || "").trim() || "New Site",
      brand: (($("wBrand") as HTMLInputElement)?.value || "").trim(),
      tagline: (($("wTagline") as HTMLInputElement)?.value || "").trim(),
      cta: (($("wCta") as HTMLInputElement)?.value || "").trim(),
      ctaHref: (($("wCtaHref") as HTMLInputElement)?.value || "").trim(),
      audience: (($("wAudience") as HTMLSelectElement)?.value || "b2b"),
      goal: (($("wGoal") as HTMLSelectElement)?.value || "leads"),
      tone: (($("wTone") as HTMLSelectElement)?.value || "premium"),
      lang: (($("wLang") as HTMLSelectElement)?.value || "en"),
    };
  }

  // ── Intent-aware copy seeds ────────────────────────────────
  // Keyed by goal → returns hero/cta copy fragments
  const goalCopy: Record<string, { heroVerb: string; ctaDefault: string; ctaClose: string; urgency: string }> = {
    leads:    { heroVerb: "attract the right customers",    ctaDefault: "Get a free consultation", ctaClose: "Let's talk about your project.",         urgency: "Limited spots available." },
    sales:    { heroVerb: "drive revenue and conversions",  ctaDefault: "Start free trial",        ctaClose: "Join thousands of happy customers.",    urgency: "No credit card required." },
    showcase: { heroVerb: "showcase your best work",        ctaDefault: "See my work",             ctaClose: "Explore what I've built.",               urgency: "" },
    bookings: { heroVerb: "fill your calendar with clients", ctaDefault: "Book a call",            ctaClose: "Schedule your free session now.",        urgency: "Next available slot this week." },
    waitlist: { heroVerb: "build anticipation before launch", ctaDefault: "Join the waitlist",     ctaClose: "Be the first to know when we launch.",  urgency: "Early access for the first 500." },
  };

  const audienceCopy: Record<string, { who: string; proofLabel: string }> = {
    b2b:        { who: "companies and teams",       proofLabel: "Trusted by leading companies" },
    b2c:        { who: "people like you",            proofLabel: "Loved by thousands of users" },
    developers: { who: "developers and engineers",   proofLabel: "Used by developers worldwide" },
    creators:   { who: "creators and freelancers",   proofLabel: "Chosen by top creators" },
    agencies:   { who: "agencies and studios",       proofLabel: "Trusted by agencies globally" },
  };

  const toneBadge: Record<string, string> = {
    premium:    "Premium experience",
    minimal:    "Simple by design",
    bold:       "Built different",
    futuristic: "Next generation",
    organic:    "Human-first",
  };

  function buildMeta(w: WizardInputs): any {
    return {
      projectType: selectedPresetId === "blank" ? "custom" : selectedPresetId,
      goal: w.goal,
      audience: w.audience,
      tone: w.tone,
      language: w.lang,
      presetId: selectedPresetId,
      presetVariants: { ...selectedVariants },
    };
  }

  function buildProjectData(): any {
    const w = getWizardInputs();
    const brandName = w.brand || w.name;
    const gc = goalCopy[w.goal] || goalCopy.leads;
    const ac = audienceCopy[w.audience] || audienceCopy.b2b;
    const badge = toneBadge[w.tone] || "";
    const cta = w.cta || gc.ctaDefault;
    const ctaHref = w.ctaHref || "#";

    // ── Blank / custom ──────────────────────────────────────
    if (selectedPresetId === "blank") {
      return {
        meta: buildMeta(w),
        brand: { name: brandName, tagline: w.tagline || `Helping ${ac.who} ${gc.heroVerb}.`, colors: { primary: "#7DD3FC", bg: "#070A12", fg: "#E7EEF7", accent: "#34D399" } },
        sections: [
          { type: "hero", variant: "centered", content: {
            badge,
            title: w.tagline || `${brandName} helps ${ac.who} ${gc.heroVerb}.`,
            subtitle: `The modern solution designed for ${ac.who} who want results, not complexity.`,
            primaryCta: { label: cta, href: ctaHref },
          }},
          { type: "cta", content: { title: gc.ctaClose, subtitle: gc.urgency || `Built for ${ac.who}.`, primaryCta: { label: cta, href: ctaHref } } },
        ],
      };
    }

    // ── Preset-based ────────────────────────────────────────
    const preset = presets.find((p: any) => p.id === selectedPresetId);
    if (!preset) { selectedPresetId = "blank"; return buildProjectData(); }

    const data = JSON.parse(JSON.stringify(preset.data));
    const enabled = getEnabledSections();

    // Inject meta
    data.meta = buildMeta(w);

    // Inject brand
    data.brand.name = brandName;
    if (w.tagline) data.brand.tagline = w.tagline;
    else data.brand.tagline = `Helping ${ac.who} ${gc.heroVerb}.`;

    // ── Intent-aware section overrides ───────────────────────
    data.sections.forEach((s: any) => {
      // Hero: apply variant + inject intent-aware copy
      if (s.type === "hero") {
        if (selectedVariants.hero) s.variant = selectedVariants.hero;
        s.content.badge = badge;
        if (!w.tagline) {
          // Only override title/subtitle if user didn't provide custom tagline
          s.content.title = `${brandName} helps ${ac.who} ${gc.heroVerb}.`;
          s.content.subtitle = `The modern solution designed for ${ac.who} who want results, not complexity.`;
        }
      }

      // Pricing: apply variant
      if (s.type === "pricing" && selectedVariants.pricing) {
        s.variant = selectedVariants.pricing;
      }

      // Logo cloud: audience-aware label
      if (s.type === "logoCloud") {
        s.content.title = ac.proofLabel;
      }

      // CTA: goal-aware closing copy
      if (s.type === "cta") {
        s.content.title = gc.ctaClose;
        if (gc.urgency) s.content.subtitle = gc.urgency;
      }

      // Override primary CTA labels with user's choice
      if (w.cta && s.content?.primaryCta) s.content.primaryCta.label = cta;
      if (w.ctaHref && s.content?.primaryCta) s.content.primaryCta.href = ctaHref;

      // Pricing tier CTAs: override highlighted tier
      if (s.content?.tiers) {
        s.content.tiers.forEach((t: any) => {
          if (t.highlight && t.cta) {
            if (w.cta) t.cta.label = cta;
            if (w.ctaHref) t.cta.href = ctaHref;
          }
        });
      }
    });

    // ── Filter optional sections ────────────────────────────
    if (preset.optionalSections) {
      const optionalTypes = new Set(Object.keys(preset.optionalSections));
      data.sections = data.sections.filter((s: any) => {
        if (!optionalTypes.has(s.type)) return true;
        return enabled.has(s.type);
      });
    }

    // ── Proof variant filter ────────────────────────────────
    if (selectedVariants.proof) {
      const v = selectedVariants.proof;
      if (v === "none") data.sections = data.sections.filter((s: any) => s.type !== "metrics" && s.type !== "logoCloud");
      else if (v === "metrics") data.sections = data.sections.filter((s: any) => s.type !== "logoCloud");
      else if (v === "logos") data.sections = data.sections.filter((s: any) => s.type !== "metrics");
    }

    // ── Process/showcase variant filter (agency/portfolio) ──
    if (selectedVariants.process) {
      const v = selectedVariants.process;
      if (v === "none") data.sections = data.sections.filter((s: any) => s.type !== "workflow" && s.type !== "featureSplit");
      else if (v === "workflow") data.sections = data.sections.filter((s: any) => s.type !== "featureSplit" || s.content?.title === "Tech stack");
      else if (v === "featureSplit") data.sections = data.sections.filter((s: any) => s.type !== "workflow");
    }
    if (selectedVariants.showcase) {
      const v = selectedVariants.showcase;
      if (v === "none") data.sections = data.sections.filter((s: any) => s.type !== "valueGrid" && s.type !== "featureSplit");
      else if (v === "valueGrid") data.sections = data.sections.filter((s: any) => !(s.type === "featureSplit" && s.content?.title !== "Tech stack"));
      else if (v === "featureSplit") data.sections = data.sections.filter((s: any) => s.type !== "valueGrid");
    }

    // ── Portfolio focus variant ──────────────────────────────
    if (selectedPresetId === "portfolio" && selectedVariants.focus) {
      const focus = selectedVariants.focus;
      const hero = data.sections.find((s: any) => s.type === "hero");
      const grid = data.sections.find((s: any) => s.type === "valueGrid");
      const faq = data.sections.find((s: any) => s.type === "faq");

      if (focus === "hire_me") {
        if (hero && !w.tagline) {
          hero.content.badge = "Available for hire";
          hero.content.title = `I help ${ac.who} ship products that actually work.`;
          hero.content.subtitle = "Full-stack developer with a design eye. I ship fast, write clean code and take ownership from day one.";
        }
        if (faq) faq.content.items = [
          { question: "What's your availability?", answer: "I typically book 2–4 weeks ahead. Reach out early for the best scheduling." },
          { question: "What's your rate?", answer: "It depends on scope and timeline. Reach out with your project details for a clear quote." },
          { question: "Do you do retainers?", answer: "Yes — for ongoing work, I offer monthly retainer packages with priority scheduling." },
        ];
      } else if (focus === "technical") {
        if (hero && !w.tagline) {
          hero.content.badge = "Engineer";
          hero.content.title = `${brandName} — systems, architecture, shipping.`;
          hero.content.subtitle = "I build production infrastructure, APIs and full-stack applications. Clean code, zero shortcuts.";
        }
        if (grid) {
          grid.content.title = "Engineering focus";
          grid.content.cards = [
            { title: "System design", description: "Distributed systems, event-driven architecture, horizontal scaling." },
            { title: "API & backend", description: "REST, GraphQL, real-time — built for reliability and performance." },
            { title: "DevOps & infra", description: "CI/CD, Docker, Kubernetes, monitoring — production-grade from day one." },
            { title: "Code quality", description: "Tests, type safety, code review culture. No technical debt by default." },
          ];
        }
        if (faq) faq.content.items = [
          { question: "What languages do you work with?", answer: "TypeScript, Go, Python, Rust — I pick the right tool for each problem." },
          { question: "Do you work with legacy codebases?", answer: "Yes. I specialize in incremental modernization without full rewrites." },
          { question: "Can you lead a team?", answer: "Yes — I've led teams of 3–8 engineers on complex multi-month projects." },
        ];
      } else if (focus === "creative") {
        if (hero && !w.tagline) {
          hero.content.badge = "Designer & developer";
          hero.content.title = `${brandName} — where design meets engineering.`;
          hero.content.subtitle = "I create digital experiences that feel intentional. Every interaction, transition and pixel has a reason.";
        }
        if (grid) {
          grid.content.title = "Creative approach";
          grid.content.cards = [
            { title: "Visual storytelling", description: "Design that communicates before the user reads a single word." },
            { title: "Motion & interaction", description: "Subtle animations and micro-interactions that elevate the experience." },
            { title: "Brand systems", description: "Consistent visual language across every touchpoint — web, mobile, print." },
            { title: "Design-to-code", description: "I design in Figma and build in code. No handoff, no translation loss." },
          ];
        }
        if (faq) faq.content.items = [
          { question: "Do you do branding?", answer: "Yes — logos, color systems, typography and brand guidelines are part of my offering." },
          { question: "What design tools do you use?", answer: "Figma for UI, After Effects for motion, Blender for 3D. All exported production-ready." },
          { question: "Can you handle both design and development?", answer: "That's my specialty. One person, zero handoff, pixel-perfect execution." },
        ];
      }
    }

    return data;
  }

  function showAuth(show: boolean) {
    const authPanel = $("authPanel") as HTMLElement | null;
    const workspace = $("workspace") as HTMLElement | null;
    if (authPanel) authPanel.hidden = !show;
    if (workspace) workspace.hidden = show;
  }

  async function listProjects(userId: string) {
    const { data, error } = await supa
      .from("projects")
      .select("id,name,slug,builder_data,status,created_at")
      .eq("user_id", userId)
      .is("deleted_at", null)
      .order("created_at", { ascending: false });

    if (error) return setStatus(error.message);
    const box = $("projects");
    if (!box) return;

    box.innerHTML =
      (data || []).map((p: any) => `
        <button class="project-btn" data-id="${p.id}">
          <span class="project-name">${p.name}</span>
          <span class="project-slug">${p.slug || "no slug"}</span>
        </button>
      `).join("") || `<span class="hint">No projects yet.</span>`;

    box.querySelectorAll(".project-btn").forEach((btn) => {
      btn.addEventListener("click", () =>
        openProject((data || []).find((x: any) => x.id === (btn as HTMLElement).dataset.id))
      );
    });
  }

  function openProject(p: any) {
    currentProject = p;
    const json = $("json") as HTMLTextAreaElement | null;
    if (json) json.value = JSON.stringify(p.builder_data || {}, null, 2);
    const link = $("link");
    if (link) link.innerHTML = p.slug ? `Active: <code>${p.slug}</code>` : "";
    setStatus("Project loaded.");

    document.querySelectorAll(".project-btn").forEach((b) => b.classList.remove("active"));
    const active = document.querySelector(`[data-id="${p.id}"]`);
    if (active) active.classList.add("active");
  }

  async function saveCurrent() {
    if (!currentProject) return false;
    let parsed;
    try {
      parsed = JSON.parse(($("json") as HTMLTextAreaElement)?.value || "{}");
    } catch {
      setStatus("Invalid JSON.");
      return false;
    }
    const { error } = await supa
      .from("projects")
      .update({ builder_data: parsed, updated_at: new Date().toISOString() })
      .eq("id", currentProject.id);
    if (error) { setStatus(error.message); return false; }
    currentProject.builder_data = parsed;
    return true;
  }

  // ── Boot: use existing Volynx session ──────────────────────────
  (async function boot() {
    log("boot start");

    // 1. Load config
    let cfg: any;
    try {
      cfg = await fetch("/config.json", { cache: "no-store" }).then(r => r.json());
    } catch {
      showAuth(true);
      ($("authMsg") as HTMLElement).textContent = "Configuration error.";
      return;
    }

    supa = createClient(cfg.supabaseUrl, cfg.supabaseAnonKey);
    log("supabase client created");

    // Load presets (non-blocking)
    await loadPresets();

    // 2. Restore session from Volynx tokens
    const accessToken = localStorage.getItem("volynx_access_token");
    const refreshToken = localStorage.getItem("volynx_refresh_token");

    if (!accessToken || !refreshToken) {
      log("no session tokens — show login prompt");
      showAuth(true);
      ($("authMsg") as HTMLElement).textContent = "Sign in to your Volynx account first.";
      ($("sendLink") as HTMLButtonElement).textContent = "Go to Login";
      ($("sendLink") as HTMLButtonElement).onclick = () => {
        window.location.href = "/login/?next=/builder/";
      };
      ($("email") as HTMLElement).style.display = "none";
      return;
    }

    const { error: sessErr } = await supa.auth.setSession({
      access_token: accessToken,
      refresh_token: refreshToken,
    });

    if (sessErr) {
      log("session restore failed: " + sessErr.message);
      showAuth(true);
      ($("authMsg") as HTMLElement).textContent = "Session expired. Please sign in again.";
      ($("sendLink") as HTMLButtonElement).textContent = "Go to Login";
      ($("sendLink") as HTMLButtonElement).onclick = () => {
        window.location.href = "/login/?next=/builder/";
      };
      ($("email") as HTMLElement).style.display = "none";
      return;
    }

    const { data: authData } = await supa.auth.getUser();
    const user = authData?.user;
    if (!user) {
      log("getUser failed");
      showAuth(true);
      return;
    }

    log("authenticated: " + user.email);
    const who = $("who");
    if (who) who.textContent = user.email || "";
    showAuth(false);
    await listProjects(user.id);

    // ── Event listeners ────────────────────────────────────────
    $("logout")?.addEventListener("click", async () => {
      try { await supa.auth.signOut(); } catch {}
      KEYS.forEach(k => localStorage.removeItem(k));
      window.location.href = "/";
    });

    // Wizard navigation
    $("toStep2")?.addEventListener("click", () => {
      const name = (($("pname") as HTMLInputElement)?.value || "").trim();
      if (!name) { ($("pname") as HTMLInputElement).focus(); return; }
      // Pre-fill brand with project name if empty
      const brandInput = $("wBrand") as HTMLInputElement;
      if (brandInput && !brandInput.value.trim()) brandInput.value = name;
      showWizardStep(2);
    });

    $("backStep1")?.addEventListener("click", () => showWizardStep(1));

    // Create project
    $("create")?.addEventListener("click", async () => {
      const w = getWizardInputs();
      const baseSlug = slugify((($("pslug") as HTMLInputElement)?.value || "").trim() || w.name) || "site";
      const slug = `${baseSlug}-${rand4()}`;

      const builder_data = buildProjectData();

      const { data, error } = await supa
        .from("projects")
        .insert({ user_id: user.id, name: w.name, slug, domain_type: "subdomain", builder_data, status: "draft" })
        .select("id,name,slug,builder_data,status,created_at")
        .single();

      if (error) return setStatus(error.message);
      setStatus("Project created.");
      showWizardStep(1); // reset wizard
      await listProjects(user.id);
      openProject(data);
    });

    $("save")?.addEventListener("click", async () => {
      if (!currentProject) return setStatus("Select a project.");
      const ok = await saveCurrent();
      if (ok) setStatus("Saved ✓");
    });

    $("copy")?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(($("json") as HTMLTextAreaElement)?.value || "");
        setStatus("Copied to clipboard.");
      } catch { setStatus("Clipboard permission denied."); }
    });

    $("publish")?.addEventListener("click", async () => {
      if (!currentProject) return setStatus("Select a project.");
      setStatus("Saving…");
      const ok = await saveCurrent();
      if (!ok) return;

      const { data: sessData } = await supa.auth.getSession();
      const token = sessData?.session?.access_token;
      if (!token) return setStatus("Session expired.");

      setStatus("Publishing…");
      try {
        const apiBase = (cfg.apiBaseUrl || "").replace(/\/$/, "");
        if (!apiBase) return setStatus("Publish API not configured.");

        const r = await fetch(`${apiBase}/publish`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify({ projectId: currentProject.id }),
        });

        const j: any = await r.json().catch(() => ({}));
        if (!r.ok) return setStatus(j?.error || "Publish error.");

        const linkEl = $("link");
        if (linkEl)
          linkEl.innerHTML = `Published: <a href="${j.url}" target="_blank" rel="noreferrer">${j.url}</a>`;
        setStatus("Published ✓");

        await supa.from("projects")
          .update({ status: "published", updated_at: new Date().toISOString() })
          .eq("id", currentProject.id);

        await listProjects(user.id);
      } catch {
        setStatus("Publish API unavailable.");
      }
    });

    log("boot complete");
  })();
</script>

<style>
  :root {
    --bg: #070A12;
    --fg: #E7EEF7;
    --mut: rgba(231, 238, 247, .55);
    --line: rgba(231, 238, 247, .10);
    --accent: #7DD3FC;
    --card-bg: rgba(231, 238, 247, .04);
    --card-border: rgba(231, 238, 247, .10);
    --r: 20px;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html {
    background: var(--bg);
    width: 100%;
    overflow-x: hidden;
  }

  body {
    margin: 0;
    font-family: "Sora", ui-sans-serif, system-ui, sans-serif;
    color: var(--fg);
    background: transparent;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* HERO */
  .hero {
    text-align: center;
    padding: 56px 24px 40px;
    max-width: 680px;
    margin: 0 auto;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid rgba(125, 211, 252, .22);
    background: rgba(125, 211, 252, .06);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 24px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: .3; }
  }

  .hero__title {
    margin: 0 0 14px;
    font-size: clamp(32px, 6vw, 56px);
    font-weight: 800;
    letter-spacing: -.03em;
    line-height: 1.05;
  }

  .accent {
    background: linear-gradient(90deg, #7DD3FC, #a78bfa);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__sub {
    margin: 0;
    font-size: clamp(14px, 2vw, 16px);
    color: var(--mut);
    line-height: 1.7;
  }

  /* APP */
  .app {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px 80px;
  }

  /* AUTH PANEL */
  .panel {
    max-width: 440px;
    margin: 0 auto 60px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--r);
    padding: 36px 32px;
    text-align: center;
    backdrop-filter: blur(16px);
  }

  .panel__icon { font-size: 36px; margin-bottom: 16px; }
  .panel__title { margin: 0 0 8px; font-size: 20px; font-weight: 700; }
  .panel__sub { margin: 0 0 24px; font-size: 14px; color: var(--mut); line-height: 1.6; }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .auth-msg {
    font-size: 13px;
    color: var(--mut);
    min-height: 18px;
    margin: 0;
  }

  /* SESSION BAR */
  .session-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(125, 211, 252, .04);
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .session-who {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .session-email {
    font-size: 13px;
    color: var(--mut);
    font-weight: 600;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
