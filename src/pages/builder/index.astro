---
import LabBg from "../../components/LabBg.astro";
import Topbar from "../../components/Topbar.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PageWidgets from "../../components/PageWidgets.astro";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>VOLYNX Builder — Create & Manage Sites</title>
  <meta name="description" content="Create and manage mini-sites with a JSON editor, magic link auth and one-click publish." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;800;900&display=swap" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js" defer></script>
  <script is:inline src="/builder/vx-renderer.js"></script>
  <script is:inline src="/builder/vx-section-editor.js"></script>
</head>

<body>
  <LabBg src="/assets/lucid3.jpg" />
  <Topbar leftLinks={[{ href: "/volynx-lab/studio/", label: "Studio" }, { href: "/products/", label: "Products" }]} rightLinks={[{ href: "/profile/", label: "Profile" }]} />

  <!-- HERO -->
  <section class="hero">
    <div class="hero__badge">
      <span class="badge-dot" aria-hidden="true"></span>
      <span data-i18n="builder.badge">VOLYNX Builder</span>
    </div>
    <h1 class="hero__title" data-i18n="builder.title">
      Build &amp; <span class="accent">Deploy</span> Sites
    </h1>
    <p class="hero__sub" data-i18n="builder.subtitle">
      Create mini-sites with JSON, manage them in one place,
      and publish to your own subdomain.
    </p>
  </section>

  <!-- APP SHELL -->
  <main class="app" id="app">

    <!-- AUTH PANEL (shown when logged out) -->
    <div class="panel auth-panel" id="authPanel">
      <div class="panel__icon" aria-hidden="true">⚡</div>
      <h2 class="panel__title" data-i18n="builder.auth.title">Sign in to Builder</h2>
      <p class="panel__sub" data-i18n="builder.auth.subtitle">Enter your email — we'll send a magic link. No password needed.</p>
      <div class="auth-form">
        <input
          id="email"
          type="email"
          placeholder="your@email.com"
          autocomplete="email"
          class="field"
        />
        <button class="btn btn--primary" id="sendLink" data-i18n="builder.auth.cta">Get magic link</button>
        <p class="auth-msg" id="authMsg"></p>
      </div>
    </div>

    <!-- BUILDER WORKSPACE (shown when logged in) -->
    <div class="workspace" id="workspace" hidden>

      <!-- Session bar -->
      <div class="session-bar">
        <div class="session-who">
          <span class="dot" aria-hidden="true"></span>
          <span id="who" class="session-email">...</span>
        </div>
        <button id="logout" class="btn btn--ghost btn--sm">Sign out</button>
      </div>

      <div class="grid">
        <!-- NEW PROJECT WIZARD -->
        <div class="card card--wizard" id="wizardCard">
          <!-- Step indicator -->
          <div class="wizard-steps">
            <div class="wizard-step-dot wizard-step-dot--active" data-step="1"><span>1</span><small>Kit</small></div>
            <div class="wizard-line-bar"><div class="wizard-line-fill" id="wizProgress"></div></div>
            <div class="wizard-step-dot" data-step="2"><span>2</span><small>Layout</small></div>
            <div class="wizard-line-bar"><div class="wizard-line-fill" id="wizProgress2"></div></div>
            <div class="wizard-step-dot" data-step="3"><span>3</span><small>Brand</small></div>
          </div>

          <!-- STEP 1: Choose Kit -->
          <div class="wizard-step" id="wizStep1">
            <h3 class="card__title">What are you building?</h3>
            <p class="hint" style="margin-bottom:16px">Choose a starting point. Everything is customizable after creation.</p>

            <div class="archetype-grid" id="presetGrid">
              <!-- Populated by JS with enhanced archetype cards -->
            </div>

            <div class="row" style="margin-top:16px">
              <div class="field-group">
                <label class="label" for="pname">Project name</label>
                <input id="pname" class="field" placeholder="My landing page" />
              </div>
              <div class="field-group">
                <label class="label" for="pslug">Slug</label>
                <input id="pslug" class="field" placeholder="my-landing-page" />
              </div>
            </div>

            <button class="btn btn--primary" id="toStep2" style="margin-top:14px;width:100%">
              Next: Choose layout →
            </button>
          </div>

          <!-- STEP 2: Layout & Variants -->
          <div class="wizard-step" id="wizStep2" hidden>
            <h3 class="card__title">Pick your layout</h3>
            <p class="hint" style="margin-bottom:16px">Choose how each section looks. Mix and match freely.</p>

            <!-- Variant selectors (populated by JS per preset) -->
            <div id="variantSelectors" class="variant-selectors"></div>

            <!-- Optional sections -->
            <div id="optionalToggles" class="optional-toggles"></div>

            <div style="display:flex;gap:8px;margin-top:18px">
              <button class="btn btn--ghost" id="backStep1" style="flex:1">← Back</button>
              <button class="btn btn--primary" id="toStep3" style="flex:2">Next: Brand details →</button>
            </div>
          </div>

          <!-- STEP 3: Brand & Config -->
          <div class="wizard-step" id="wizStep3" hidden>
            <h3 class="card__title">Brand & details</h3>
            <p class="hint" style="margin-bottom:16px">Tell us about your brand — we'll generate the copy.</p>

            <div class="row">
              <div class="field-group">
                <label class="label" for="wBrand">Brand name</label>
                <input id="wBrand" class="field" placeholder="Acme Inc" />
              </div>
              <div class="field-group">
                <label class="label" for="wTagline">Tagline</label>
                <input id="wTagline" class="field" placeholder="Build faster, ship smarter." />
              </div>
            </div>

            <div class="row" style="margin-top:12px">
              <div class="field-group">
                <label class="label" for="wCta">Primary CTA label</label>
                <input id="wCta" class="field" placeholder="Get started" />
              </div>
              <div class="field-group">
                <label class="label" for="wCtaHref">CTA link</label>
                <input id="wCtaHref" class="field" placeholder="https://..." />
              </div>
            </div>

            <div class="row" style="margin-top:12px">
              <div class="field-group">
                <label class="label" for="wAudience">Audience</label>
                <select id="wAudience" class="field">
                  <option value="b2b">B2B / Companies</option>
                  <option value="b2c">B2C / Consumers</option>
                  <option value="developers">Developers</option>
                  <option value="creators">Creators / Freelancers</option>
                  <option value="agencies">Agencies</option>
                </select>
              </div>
              <div class="field-group">
                <label class="label" for="wGoal">Goal</label>
                <select id="wGoal" class="field">
                  <option value="leads">Lead generation</option>
                  <option value="sales">Direct sales</option>
                  <option value="showcase">Showcase / portfolio</option>
                  <option value="bookings">Bookings</option>
                  <option value="waitlist">Waitlist</option>
                </select>
              </div>
            </div>

            <div class="row" style="margin-top:12px">
              <div class="field-group">
                <label class="label" for="wTone">Tone</label>
                <select id="wTone" class="field">
                  <option value="premium">Premium</option>
                  <option value="minimal">Minimal</option>
                  <option value="bold">Bold</option>
                  <option value="futuristic">Futuristic</option>
                  <option value="organic">Organic</option>
                </select>
              </div>
              <div class="field-group">
                <label class="label" for="wLang">Language</label>
                <select id="wLang" class="field">
                  <option value="en">English</option>
                  <option value="pt">Português</option>
                </select>
              </div>
            </div>

            <div style="display:flex;gap:8px;margin-top:18px">
              <button class="btn btn--ghost" id="backStep2" style="flex:1">← Back</button>
              <button class="btn btn--primary" id="create" style="flex:2">Create project →</button>
            </div>
            <p class="hint" style="margin-top:10px;text-align:center">
              Will publish at <code style="color:var(--accent)">https://<span id="slugPreview">slug</span>.volynx.world</code>
            </p>
          </div>
        </div>

        <!-- PROJECTS LIST -->
        <div class="card card--list">
          <h3 class="card__title">My projects</h3>
          <div id="projects" class="projects-list hint">No projects yet.</div>
        </div>

        <!-- PROJECT INFO PANEL (shown after selecting a project) -->
        <div class="card card--info" id="infoPanel" hidden>
          <div class="info-header">
            <h3 class="card__title" id="infoName">—</h3>
            <span class="status-badge" id="infoBadge">draft</span>
          </div>
          <div class="info-url-box" id="infoUrlBox" hidden>
            <span class="info-url-label">Live at</span>
            <a class="info-url-link" id="infoUrl" href="#" target="_blank" rel="noreferrer">—</a>
          </div>
          <div class="info-actions">
            <a class="btn btn--accent btn--sm" id="visitSite" href="#" target="_blank" rel="noreferrer" hidden>Visit site ↗</a>
            <button class="btn btn--ghost btn--sm" id="exportZip">Download ZIP</button>
            <button class="btn btn--ghost btn--sm" id="deleteProject">Delete</button>
          </div>
        </div>

        <!-- EDITOR WORKSPACE -->
        <div class="card card--editor">
          <div class="editor-header">
            <div class="editor-tabs">
              <button class="editor-tab editor-tab--active" id="tabSections" data-tab="sections">Sections</button>
              <button class="editor-tab" id="tabJson" data-tab="json">JSON</button>
              <button class="editor-tab" id="tabPreview" data-tab="preview">Preview</button>
              <button class="editor-tab editor-tab--ai" id="tabAI" data-tab="ai">✦ AI</button>
            </div>
            <div class="editor-actions">
              <button class="btn btn--ghost btn--sm" id="copy">Copy</button>
              <button class="btn btn--ghost btn--sm" id="save">Save</button>
              <button class="btn btn--primary btn--sm" id="publish">Publish →</button>
            </div>
          </div>

          <!-- TAB: Section Editor -->
          <div class="editor-panel" id="panelSections">
            <div id="sectionEditor" class="section-editor-root">
              <div class="se-empty">Select a project to start editing</div>
            </div>
          </div>

          <!-- TAB: JSON -->
          <div class="editor-panel" id="panelJson" hidden>
            <textarea id="json" class="json-editor" placeholder="Select a project to edit…" spellcheck="false"></textarea>
          </div>

          <!-- TAB: Preview -->
          <div class="editor-panel" id="panelPreview" hidden>
            <iframe id="previewFrame" class="preview-frame" sandbox="allow-same-origin" title="Live preview"></iframe>
          </div>

          <!-- TAB: AI Generate / Refine -->
          <div class="editor-panel ai-panel" id="panelAI" hidden>
            <div class="ai-panel-inner">
              <div class="ai-panel-header">
                <span class="ai-panel-badge">✦ AI Builder</span>
                <p class="ai-panel-sub">Describe the site you want — AI will generate valid VxOS sections for you.</p>
              </div>
              <textarea id="aiPrompt" class="ai-textarea" rows="5" placeholder="Ex: A SaaS landing page for a project management tool for remote teams. Include pricing with 3 tiers, a workflow section showing 3 steps, and a FAQ."></textarea>
              <div class="ai-actions">
                <button class="btn btn--primary" id="aiGenerate">✦ Generate site</button>
                <button class="btn btn--ghost" id="aiRefine" disabled title="Select a project first to refine it">Refine current</button>
              </div>
              <div id="aiStatus" class="ai-status" hidden></div>
            </div>
          </div>

          <div class="editor-footer">
            <p class="hint" id="status"></p>
            <p class="hint" id="link"></p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <SiteFooter />
  <PageWidgets hideUtilBar />
</body>
</html>

<script>
  import { createClient } from "@supabase/supabase-js";

  const $ = (id: string) => document.getElementById(id);
  const log = (msg: string) => console.log(`[builder] ${msg}`);

  let supa: any = null;
  let currentProject: any = null;
  let presetsData: any = {};
  let presets: any[] = [];
  let selectedPresetId = "blank";
  let selectedVariants: Record<string, string> = {};
  let wizardStep = 1;
  let userProfile: any = null;

  const KEYS = ["volynx_access_token", "volynx_refresh_token", "volynx_user_email"];

  // ── Builder plan limits (loaded from DB at boot) ──────────
  let planLimits: any = null;

  async function fetchUserProfile(userId: string) {
    const { data, error } = await supa
      .from("profiles")
      .select("id,email,plan,org_id,username,token_balance,builder_plan")
      .eq("id", userId)
      .single();
    if (error) { log("profile fetch error: " + error.message); return null; }
    return data;
  }

  async function fetchPlanLimits(builderPlan: string) {
    const { data, error } = await supa
      .from("builder_plan_limits")
      .select("*")
      .eq("plan", builderPlan)
      .single();
    if (error || !data) return { max_drafts: 1, max_published: 0, custom_domain: false, remove_branding: false, premium_kits: false };
    return data;
  }

  async function countActiveProjects(userId: string): Promise<{ drafts: number; published: number }> {
    const { data, error } = await supa
      .from("projects")
      .select("id,status")
      .eq("user_id", userId)
      .is("deleted_at", null);
    if (error || !data) return { drafts: 0, published: 0 };
    const published = data.filter((p: any) => p.status === "published").length;
    return { drafts: data.length, published };
  }

  async function logUsage(toolName: string) {
    if (!userProfile) return;
    // Call API endpoint (server-side logging)
    try {
      const cfg = await fetch("/config.json", { cache: "no-store" }).then(r => r.json());
      const apiBase = (cfg.functionsUrl || cfg.apiBaseUrl || "").replace(/\/$/, "");
      const token = localStorage.getItem("volynx_access_token") || "";
      if (apiBase && token) {
        fetch(`${apiBase}/log-usage`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify({ tool: toolName, amount: 1 }),
        }).catch(() => {});
      }
    } catch {}
    log(`usage logged: ${toolName}`);
  }

  async function useTokens(actionId: string): Promise<{ ok: boolean; balance?: number; reason?: string }> {
    try {
      const cfg = await fetch("/config.json", { cache: "no-store" }).then(r => r.json());
      const apiBase = (cfg.apiBaseUrl || "").replace(/\/$/, "");
      const token = localStorage.getItem("volynx_access_token") || "";
      if (!apiBase || !token) return { ok: true }; // fallback: allow if no API
      const res = await fetch(`${apiBase}/api/use-tokens`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
        body: JSON.stringify({ action: actionId, tool: "builder" }),
      });
      if (!res.ok) {
        const j = await res.json().catch(() => ({}));
        return { ok: false, balance: j.balance, reason: j.reason };
      }
      const j = await res.json();
      return { ok: true, balance: j.balance };
    } catch { return { ok: true }; } // fallback: allow on error
  }

  function canCreate(counts: { drafts: number; published: number }): { ok: boolean; msg: string } {
    if (!planLimits) return { ok: true, msg: "" };
    const max = planLimits.max_drafts;
    if (max === -1 || max >= 999) return { ok: true, msg: "" };
    if (counts.drafts >= max) {
      return { ok: false, msg: `Your plan allows ${max} project${max > 1 ? "s" : ""}. Upgrade for more.` };
    }
    return { ok: true, msg: "" };
  }

  function canPublish(counts: { drafts: number; published: number }): { ok: boolean; msg: string } {
    if (!planLimits) return { ok: true, msg: "" };
    const max = planLimits.max_published;
    if (max === -1 || max >= 999) return { ok: true, msg: "" };
    if (max === 0) {
      return { ok: false, msg: "Publishing requires a paid plan. Upgrade to Launch or Pro." };
    }
    if (counts.published >= max) {
      return { ok: false, msg: `Your plan allows ${max} published site${max > 1 ? "s" : ""}. Upgrade for more.` };
    }
    return { ok: true, msg: "" };
  }

  const setStatus = (t: string) => { const el = $("status"); if (el) el.textContent = t || ""; };

  // ── Tab switching ────────────────────────────────────────
  function switchTab(tab: string) {
    const panels: Record<string, string> = { sections: "panelSections", json: "panelJson", preview: "panelPreview", ai: "panelAI" };
    Object.entries(panels).forEach(([t, id]) => {
      const panel = $(id) as HTMLElement;
      if (panel) panel.hidden = t !== tab;
    });
    document.querySelectorAll(".editor-tab").forEach(el => {
      el.classList.toggle("editor-tab--active", (el as HTMLElement).dataset.tab === tab);
    });
    if (tab === "preview") {
      try {
        const raw = ($("json") as HTMLTextAreaElement)?.value || "{}";
        const data = JSON.parse(raw);
        const frame = $("previewFrame") as HTMLIFrameElement;
        if (frame && (window as any).VxRenderer && data.sections) {
          frame.srcdoc = (window as any).VxRenderer.renderPage(data);
        }
      } catch {}
    }
  }

  // ── Button loading helper ────────────────────────────────
  function btnLoading(btn: HTMLButtonElement | null, loading: boolean, label?: string) {
    if (!btn) return;
    if (loading) {
      btn.disabled = true;
      btn.classList.add("is-loading");
      if (label) btn.dataset.origLabel = btn.textContent || "";
      if (label) btn.textContent = label;
    } else {
      btn.disabled = false;
      btn.classList.remove("is-loading");
      if (btn.dataset.origLabel) { btn.textContent = btn.dataset.origLabel; delete btn.dataset.origLabel; }
    }
  }

  const slugify = (s: string) =>
    (s || "").toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

  const rand4 = () => Math.random().toString(16).slice(2, 6);

  // ── Wizard navigation ──────────────────────────────────────
  function showWizardStep(step: number) {
    wizardStep = step;
    ($("wizStep1") as HTMLElement).hidden = step !== 1;
    ($("wizStep2") as HTMLElement).hidden = step !== 2;
    ($("wizStep3") as HTMLElement).hidden = step !== 3;
    document.querySelectorAll(".wizard-step-dot").forEach(d => {
      const s = Number((d as HTMLElement).dataset.step);
      d.classList.toggle("wizard-step-dot--active", s <= step);
    });
    const p1 = $("wizProgress") as HTMLElement;
    const p2 = $("wizProgress2") as HTMLElement;
    if (p1) p1.style.width = step >= 2 ? "100%" : "0%";
    if (p2) p2.style.width = step >= 3 ? "100%" : "0%";

    if (step === 2) {
      renderVariantSelectors();
      renderOptionalToggles();
    }
    if (step === 3) {
      const slug = slugify(($("pname") as HTMLInputElement)?.value || "") || "slug";
      const preview = $("slugPreview");
      if (preview) preview.textContent = `${slug}-${rand4()}`;
    }
  }

  // ── Preset picker ──────────────────────────────────────────
  async function loadPresets() {
    try {
      const res = await fetch("/builder/presets.json", { cache: "no-store" });
      if (!res.ok) return;
      presetsData = await res.json();
      presets = presetsData.presets || [];
      renderPresetPicker();
      log("presets loaded: " + presets.length);
    } catch { log("presets unavailable"); }
  }

  // Mini layout SVGs for preset previews
  const presetIcons: Record<string, string> = {
    blank: "📄",
    saas: "⚡",
    agency: "🏢",
    portfolio: "👤",
  };

  // Enhanced archetype descriptions
  const archetypeInfo: Record<string, { outcome: string; ideal: string }> = {
    saas: {
      outcome: "A conversion-focused product page with pricing, features and social proof",
      ideal: "Software products, apps, and platforms that need to convert visitors into users",
    },
    agency: {
      outcome: "A professional services page with process steps, packages and client trust signals",
      ideal: "Agencies, studios, and consultancies that sell expertise and services",
    },
    portfolio: {
      outcome: "A personal brand page with work showcase, skills and a clear hire-me CTA",
      ideal: "Developers, designers, and freelancers presenting their work and availability",
    },
  };

  function renderPresetPicker() {
    const grid = $("presetGrid");
    if (!grid) return;

    const blank = `<button type="button" class="archetype-card" data-preset="blank">
      <div class="archetype-icon">${presetIcons.blank}</div>
      <div class="archetype-body">
        <span class="archetype-name">Custom</span>
        <span class="archetype-outcome">Start from scratch with a blank canvas</span>
        <span class="archetype-ideal">For experienced users who want full control</span>
      </div>
    </button>`;

    const cards = presets.map((p: any) => {
      const info = archetypeInfo[p.id] || { outcome: p.description, ideal: "" };
      return `<button type="button" class="archetype-card${p.id === 'saas' ? ' archetype-card--active' : ''}" data-preset="${p.id}">
      <div class="archetype-icon">${presetIcons[p.id] || p.icon || "📦"}</div>
      <div class="archetype-body">
        <span class="archetype-name">${p.name}</span>
        <span class="archetype-outcome">${info.outcome}</span>
        <span class="archetype-ideal">${info.ideal}</span>
      </div>
    </button>`;
    }).join("");

    // Landing Express quick-start
    const landingExpress = `<button type="button" class="archetype-card archetype-card--express" data-preset="landing-express">
      <div class="archetype-icon archetype-icon--express">⚡</div>
      <div class="archetype-body">
        <span class="archetype-name">Landing Express</span>
        <span class="archetype-tag">Guided</span>
        <span class="archetype-outcome">Answer 3 questions and get a ready-to-edit landing page in seconds</span>
        <span class="archetype-ideal">The fastest way to launch. Perfect for first-time users.</span>
      </div>
    </button>`;

    grid.innerHTML = landingExpress + cards + blank;

    // Default selection
    selectedPresetId = "saas";
    grid.querySelector('.archetype-card--active')?.scrollIntoView({ block: "nearest" });

    grid.querySelectorAll(".archetype-card").forEach(btn => {
      btn.addEventListener("click", () => {
        grid.querySelectorAll(".archetype-card").forEach(b => b.classList.remove("archetype-card--active"));
        btn.classList.add("archetype-card--active");
        const preset = (btn as HTMLElement).dataset.preset || "blank";

        // Landing Express redirects to a simplified flow
        if (preset === "landing-express") {
          selectedPresetId = "saas"; // default base for express
          showLandingExpressFlow();
          return;
        }

        // TODO: premium gating — check planLimits.premium_kits here before allowing
        // non-free presets. If planLimits.premium_kits === false and the selected preset
        // is a paid kit, block selection and prompt the user to upgrade.
        // Example: if (!planLimits?.premium_kits && PREMIUM_PRESET_IDS.includes(preset)) { ... }

        selectedPresetId = preset;
        selectedVariants = {};
        renderVariantSelectors();
        log("preset selected: " + selectedPresetId);
      });
    });
    renderVariantSelectors();
  }

  // ── Landing Express guided flow ──
  function showLandingExpressFlow() {
    const wizCard = $("wizardCard") as HTMLElement;
    if (!wizCard) return;

    // Replace wizard content with express flow
    const expressHtml = `
      <div class="express-flow" id="expressFlow">
        <div class="express-header">
          <span class="express-badge">⚡ Landing Express</span>
          <h3 class="card__title">Build your landing page in 60 seconds</h3>
