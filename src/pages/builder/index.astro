    backdrop-filter: blur(14px);
  }

  .card__title {
    margin: 0 0 16px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: .02em;
  }

  /* WIZARD */
  .card--wizard { overflow: hidden; }
  .wizard-steps {
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: 20px;
  }
  .wizard-dot {
    width: 28px; height: 28px; border-radius: 999px;
    display: grid; place-items: center;
    font-size: 12px; font-weight: 700;
    border: 1px solid var(--line);
    color: var(--mut); background: transparent;
    transition: all .2s;
  }
  .wizard-dot--active {
    border-color: var(--accent); color: var(--accent);
    background: rgba(125, 211, 252, .08);
  }
  .wizard-line {
    flex: 1; height: 1px; background: var(--line); margin: 0 8px;
  }

  /* PRESET PICKER */
  .preset-picker { margin-bottom: 4px; }
  .preset-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    margin-top: 8px;
  }
  .preset-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: 12px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--mut);
    cursor: pointer;
    transition: border-color .15s, background .15s;
    text-align: left;
    font-family: inherit;
  }
  .preset-card:hover {
    border-color: rgba(125, 211, 252, .25);
    background: rgba(125, 211, 252, .04);
  }
  .preset-card--active {
    border-color: var(--accent);
    background: rgba(125, 211, 252, .08);
    color: var(--fg);
  }
  .preset-icon { font-size: 18px; line-height: 1; }
  .preset-name { font-size: 13px; font-weight: 700; color: inherit; }
  .preset-tag { font-size: 10px; color: var(--mut); text-transform: uppercase; letter-spacing: .08em; font-weight: 600; }
  .preset-card--active .preset-tag { color: rgba(125, 211, 252, .6); }

  /* VARIANT SELECTORS */
  .variant-selectors { margin-top: 14px; display: grid; gap: 10px; }
  .field-group--inline { display: flex; flex-direction: column; gap: 5px; }
  .chip-group { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    padding: 5px 12px; border-radius: 999px;
    font-size: 12px; font-weight: 600; font-family: inherit;
    border: 1px solid var(--line); background: transparent;
    color: var(--mut); cursor: pointer; transition: all .15s;
    text-transform: capitalize;
  }
  .chip:hover { border-color: rgba(125, 211, 252, .3); color: var(--fg); }
  .chip--active {
    border-color: var(--accent); background: rgba(125, 211, 252, .1); color: var(--accent);
  }

  /* OPTIONAL TOGGLES */
  .optional-toggles .toggle-grid {
    display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px;
  }
  .toggle-item {
    display: flex; align-items: center; gap: 6px;
    font-size: 13px; color: var(--mut); cursor: pointer;
  }
  .toggle-item input { accent-color: var(--accent); width: 16px; height: 16px; cursor: pointer; }
  .toggle-item span { user-select: none; }

  @media (max-width: 480px) {
    .preset-grid { grid-template-columns: 1fr 1fr; }
    .chip { font-size: 11px; padding: 4px 10px; }
  }

  /* FORM ELEMENTS */
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  @media (max-width: 520px) {
    .row { grid-template-columns: 1fr; }
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--mut);
  }

  .field {
    width: 100%;
    padding: 11px 14px;
