---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";
---
<FlagshipLayout title="Builder — VOLYNX" description="Create and manage premium mini-sites with a JSON editor, magic link auth and one-click publish." pageClass="page-builder">
  <FlagshipHeader current={ROUTES.builder} ctaLabel="Builder Pro" />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="kicker">Builder flagship</span>
          <h1>The builder should feel like product infrastructure, not a simple editor.</h1>
          <p>Builder is the serious publishing layer with premium themes, cleaner control surfaces and a much more visible distinction between Free and Pro. Launch premium mini-sites fast.</p>
          <div class="hero-actions">
            <a href="#plans" class="button button--gold">Compare plans</a>
            <a href={ROUTES.pricing} class="button button--ghost">Pricing</a>
          </div>
        </div>
        <div class="hero-card visual-card">
          <span class="label label--pro">Builder Pro</span>
          <div class="stack">
            <div class="metric">Custom domain</div>
            <div class="metric">Version restore</div>
            <div class="metric">Premium sections</div>
            <div class="metric">Full export logic</div>
          </div>
          <img src="/assets/volynx-icon.webp" alt="Builder" />
        </div>
      </div>
    </section>

    <!-- ═══ PLANS OVERVIEW ═══ -->
    <section id="plans" class="page-section">
      <div class="shell section-head">
        <span class="eyebrow">Builder plans</span>
        <h2>From draft to production, at your pace</h2>
        <p>Free is generous enough to test the flow. Pro is the serious layer for custom domains, premium kits and clean deployment.</p>
      </div>
      <div class="shell grid-3">
        <article class="panel feature-card">
          <span class="label label--free">Free</span>
          <h3>Draft and learn</h3>
          <p>Enough to understand the flow, test the editor and experience the VOLYNX system. 1 draft, full editor, preview with Volynx branding.</p>
          <ul class="detail-list">
            <li>1 draft project</li>
            <li>Full editor access</li>
            <li>Preview mode</li>
            <li>Volynx branding visible</li>
          </ul>
        </article>
        <article class="panel feature-card panel--pro">
          <span class="label label--pro">Pro</span>
          <h3>Publish with confidence</h3>
          <p>Custom domains, premium sections, reusable brand profiles and a cleaner deployment experience. The anchor plan for serious creators.</p>
          <ul class="detail-list">
            <li>Up to 3 published sites</li>
            <li>Custom domain</li>
            <li>Remove Volynx branding</li>
            <li>Selected premium kits</li>
            <li>Publish priority</li>
          </ul>
          <a href={ROUTES.pricing} class="button button--gold" style="margin-top:auto;">Go Pro</a>
        </article>
        <article class="panel feature-card">
          <span class="label">Teams</span>
          <h3>Shared publishing operations</h3>
          <p>Seats, approvals, asset pools and handoff logic for agencies and teams. Central billing and shared icons pool.</p>
          <ul class="detail-list">
            <li>25 sites</li>
            <li>Workspace</li>
            <li>Central billing</li>
            <li>Shared assets and icons pool</li>
            <li>Priority support</li>
          </ul>
          <a href={ROUTES.contact} class="button button--ghost" style="margin-top:auto;">Talk to Volynx</a>
        </article>
      </div>
    </section>

    <!-- ═══ COMPARISON ═══ -->
    <section class="page-section">
      <div class="shell section-head">
        <h2>What changes with each tier</h2>
      </div>
      <div class="shell comparison">
        <div class="comparison-row"><strong>Project overview</strong><span class="check">Basic list</span><span class="check pro">Command center cards with status and usage</span></div>
        <div class="comparison-row"><strong>Publishing</strong><span class="check">Subdomain and preview</span><span class="check pro">Custom domain, priority publish and restore</span></div>
        <div class="comparison-row"><strong>Templates</strong><span class="check">Base options</span><span class="check pro">Premium systems and stronger defaults</span></div>
        <div class="comparison-row"><strong>Branding</strong><span class="check">Volynx watermark</span><span class="check pro">Full white-label control</span></div>
        <div class="comparison-row"><strong>Export</strong><span class="check">Preview only</span><span class="check pro">HTML export + asset packages</span></div>
      </div>
    </section>

    <!-- ═══ CTA ═══ -->
    <section class="page-section page-section--last">
      <div class="shell callout panel panel--pro">
        <div>
          <span class="label label--pro">Launch today</span>
          <strong>Faster than a generic builder. More premium than a cheap solution.</strong>
          <p>VOLYNX Builder sells speed, premium finish, simple publish, ready-made kits and integration with icons, assets and services.</p>
        </div>
        <div class="hero-actions">
          <a href={ROUTES.pricing} class="button button--gold">See pricing</a>
          <a href={ROUTES.devHub} class="button button--ghost">Explore Dev Hub</a>
        </div>
      </div>
    </section>

  </main>
  <FlagshipFooter />
</FlagshipLayout>
