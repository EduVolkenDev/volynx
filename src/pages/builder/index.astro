        <button class="btn btn--ghost btn--sm" id="exBack" style="margin-top:12px">← Back to templates</button>
      </div>
    `;

    // Store original wizard content
    if (!(wizCard as any)._originalHTML) {
      (wizCard as any)._originalHTML = wizCard.innerHTML;
    }
    wizCard.innerHTML = expressHtml;

    let exArchetype = "saas";
    let exGoal = "leads";

    // Archetype mapping
    const archetypeToPreset: Record<string, string> = {
      saas: "saas", agency: "agency", portfolio: "portfolio",
      local: "agency", ecommerce: "saas", event: "saas",
    };

    // Step 1: Archetype
    $("exArchetype")?.querySelectorAll(".express-opt").forEach((btn: any) => {
      btn.addEventListener("click", () => {
        $("exArchetype")!.querySelectorAll(".express-opt").forEach((b: any) => b.classList.remove("express-opt--active"));
        btn.classList.add("express-opt--active");
        exArchetype = btn.dataset.val;
        ($("exStep2") as HTMLElement).hidden = false;
        ($("exStep2") as HTMLElement).scrollIntoView({ behavior: "smooth", block: "nearest" });
      });
    });

    // Step 2: Goal
    $("exGoal")?.querySelectorAll(".express-opt").forEach((btn: any) => {
      btn.addEventListener("click", () => {
        $("exGoal")!.querySelectorAll(".express-opt").forEach((b: any) => b.classList.remove("express-opt--active"));
        btn.classList.add("express-opt--active");
        exGoal = btn.dataset.val;
        ($("exStep3") as HTMLElement).hidden = false;
        ($("exStep3") as HTMLElement).scrollIntoView({ behavior: "smooth", block: "nearest" });
      });
    });

    // Generate
    $("exGenerate")?.addEventListener("click", async () => {
      const brand = ($("exBrand") as HTMLInputElement)?.value?.trim() || "My Brand";
      const tagline = ($("exTagline") as HTMLInputElement)?.value?.trim() || "";
      const cta = ($("exCta") as HTMLInputElement)?.value?.trim() || "Get started";
      const slug = ($("exSlug") as HTMLInputElement)?.value?.trim() || brand.toLowerCase().replace(/[^a-z0-9]+/g, "-");

      // Restore wizard + use selected archetype
      selectedPresetId = archetypeToPreset[exArchetype] || "saas";

      // Set wizard inputs programmatically
      wizCard.innerHTML = (wizCard as any)._originalHTML;
      renderPresetPicker();
      renderVariantSelectors();

      // Fill in brand fields
      ($("pname") as HTMLInputElement).value = brand;
      ($("pslug") as HTMLInputElement).value = slug;
      ($("wBrand") as HTMLInputElement).value = brand;
      ($("wTagline") as HTMLInputElement).value = tagline;
      ($("wCta") as HTMLInputElement).value = cta;
      ($("wGoal") as HTMLSelectElement).value = exGoal;

      // Auto-create the project
      const w = getWizardInputs();
      w.name = brand;
      w.brand = brand;
      w.tagline = tagline;
      w.cta = cta;
      w.goal = exGoal;

      const projectName = brand;
      const projectSlug = slug + "-" + Math.random().toString(36).slice(2, 6);
      const builder_data = buildProjectData();

      setStatus("Creating your landing page...");
      const { data, error } = await supa.from("projects")
        .insert({ user_id: user.id, name: projectName, slug: projectSlug, domain_type: "subdomain", builder_data, status: "draft" })
        .select("id,name,slug,builder_data,status,created_at")
        .single();

      if (error) { setStatus(error.message); return; }
      await logUsage("builder_create");
      setStatus("Landing page created!");
      await listProjects(user.id);
      openProject(data);

      // Switch to sections tab
      switchTab("sections");
    });

    // Back button
    $("exBack")?.addEventListener("click", () => {
      wizCard.innerHTML = (wizCard as any)._originalHTML;
      renderPresetPicker();
      renderVariantSelectors();
    });
  }

