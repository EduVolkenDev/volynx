  function getWizardInputs(): WizardInputs {
    return {
      name: (($("pname") as HTMLInputElement)?.value || "").trim() || "New Site",
      brand: (($("wBrand") as HTMLInputElement)?.value || "").trim(),
      tagline: (($("wTagline") as HTMLInputElement)?.value || "").trim(),
      cta: (($("wCta") as HTMLInputElement)?.value || "").trim(),
      ctaHref: (($("wCtaHref") as HTMLInputElement)?.value || "").trim(),
      audience: (($("wAudience") as HTMLSelectElement)?.value || "b2b"),
      goal: (($("wGoal") as HTMLSelectElement)?.value || "leads"),
      tone: (($("wTone") as HTMLSelectElement)?.value || "premium"),
      lang: (($("wLang") as HTMLSelectElement)?.value || "en"),
    };
  }

  // ── Intent-aware copy engine ─────────────────────────────
  // Structured by preset × goal × audience → specific copy
  // Instead of one generic "heroVerb", each combination gets real copy.

  type CopySeed = {
    title: (brand: string) => string;
    subtitle: string;
    ctaLabel: string;
    ctaClose: string;
    urgency: string;
    proofLine: string;
    tagline: (brand: string) => string;
  };

  function getCopySeed(preset: string, goal: string, audience: string, tone: string): CopySeed {
    // ── Audience fragments ──────────────────────────
    const aud: Record<string, { for: string; proof: string }> = {
      b2b:        { for: "companies and teams",     proof: "Trusted by leading companies" },
      b2c:        { for: "thousands of users",       proof: "Loved by thousands of users" },
      developers: { for: "developers who ship",      proof: "Used by developers worldwide" },
      creators:   { for: "creators and freelancers", proof: "Chosen by top creators" },
      agencies:   { for: "agencies and studios",     proof: "Trusted by agencies globally" },
    };
    const a = aud[audience] || aud.b2b;

    // ── Tone modifiers ──────────────────────────────
    const toneAdj: Record<string, { feel: string; badge: string }> = {
      premium:    { feel: "premium",       badge: "Premium experience" },
      minimal:    { feel: "clean",         badge: "Simple by design" },
      bold:       { feel: "powerful",      badge: "Built different" },
      futuristic: { feel: "next-gen",      badge: "The future is here" },
      organic:    { feel: "human",         badge: "Human-first" },
    };
    const t = toneAdj[tone] || toneAdj.premium;

    // ── Preset × goal matrix ────────────────────────
    // SaaS
    if (preset === "saas") {
      if (goal === "waitlist") return {
        title: (b) => `${b} is coming. Get early access before everyone else.`,
        subtitle: `A ${t.feel} platform built for ${a.for}. We're launching soon — reserve your spot.`,
        ctaLabel: "Join the waitlist", ctaClose: "Be the first to know.", urgency: "Early access for the first 500.",
        proofLine: a.proof, tagline: (b) => `${b} — launching soon.`,
      };
      if (goal === "sales") return {
        title: (b) => `${b} — the ${t.feel} way to run your workflow.`,
        subtitle: `Built for ${a.for} who need speed, clarity and zero friction. Start in minutes.`,
        ctaLabel: "Start free trial", ctaClose: "Join ${a.for} already on the platform.", urgency: "No credit card required.",
        proofLine: a.proof, tagline: (b) => `${b} — workflow, simplified.`,
      };
      if (goal === "bookings") return {
        title: (b) => `${b} — see it in action. Book a live demo.`,
        subtitle: `A ${t.feel} platform for ${a.for}. We'll walk you through everything in 20 minutes.`,
        ctaLabel: "Book a demo", ctaClose: "Pick a time that works for you.", urgency: "Next available slot this week.",
        proofLine: a.proof, tagline: (b) => `${b} — built for ${a.for}.`,
      };
      // default: leads
      return {
        title: (b) => `Stop duct-taping your stack. ${b} replaces the chaos.`,
        subtitle: `One ${t.feel} platform for ${a.for} who want results, not workarounds.`,
        ctaLabel: "Get a free demo", ctaClose: "See how it works for your team.", urgency: "Free consultation, no commitment.",
        proofLine: a.proof, tagline: (b) => `${b} — built for ${a.for}.`,
      };
    }

    // Agency
    if (preset === "agency") {
      if (goal === "bookings") return {
        title: (b) => `${b} — strategy, design and code. One call to start.`,
        subtitle: `We help ${a.for} ship ${t.feel} digital products. No pitch decks — just a real conversation about your project.`,
        ctaLabel: "Book a call", ctaClose: "Let's talk about what you're building.", urgency: "Usually reply within 24 hours.",
        proofLine: a.proof, tagline: (b) => `${b} — digital products for ${a.for}.`,
      };
      if (goal === "leads") return {
        title: (b) => `${b} builds digital products for ${a.for} who care about execution.`,
        subtitle: `Strategy, design and engineering under one roof. ${t.feel.charAt(0).toUpperCase() + t.feel.slice(1)} results, on time, every time.`,
        ctaLabel: "Start a project", ctaClose: "Tell us what you need. We'll tell you how.", urgency: "Free project assessment.",
        proofLine: a.proof, tagline: (b) => `${b} — execution over everything.`,
      };
      if (goal === "showcase") return {
        title: (b) => `${b} — we make ${a.for} look as good as their work.`,
        subtitle: `A ${t.feel} approach to branding, web and product design. See what we've shipped.`,
        ctaLabel: "See our work", ctaClose: "Explore what we've built.", urgency: "",
        proofLine: a.proof, tagline: (b) => `${b} — work that speaks.`,
      };
      // default
      return {
        title: (b) => `${b} — digital products that actually convert.`,
        subtitle: `We work with ${a.for} who need ${t.feel}, functional products — not just pretty mockups.`,
        ctaLabel: "Start a project", ctaClose: "Let's build something that works.", urgency: "Free initial consultation.",
        proofLine: a.proof, tagline: (b) => `${b} — built for ${a.for}.`,
      };
    }

    // Portfolio
    if (preset === "portfolio") {
      if (goal === "leads") return {
        title: (b) => `I help ${a.for} ship products that people actually use.`,
        subtitle: `${t.feel.charAt(0).toUpperCase() + t.feel.slice(1)} execution, clean code, full ownership. No hand-holding required.`,
        ctaLabel: "Work with me", ctaClose: "Got a project? Let's scope it.", urgency: "Usually reply within 24h.",
        proofLine: a.proof, tagline: (b) => `${b} — shipping for ${a.for}.`,
      };
      if (goal === "showcase") return {
        title: (b) => `${b} — building ${t.feel} digital products since day one.`,
        subtitle: `Full-stack work for ${a.for}. I care about craft, speed and things that actually ship.`,
        ctaLabel: "See my work", ctaClose: "Explore what I've built.", urgency: "",
        proofLine: a.proof, tagline: (b) => `${b} — the work speaks.`,
      };
      if (goal === "bookings") return {
        title: (b) => `I'm ${b}. Let's talk about your next project.`,
        subtitle: `I build ${t.feel} products for ${a.for}. Book a free call and let's see if it's a fit.`,
        ctaLabel: "Book a call", ctaClose: "Pick a time. I'll be there.", urgency: "Next available slot this week.",
        proofLine: a.proof, tagline: (b) => `${b} — open for new work.`,
      };
      if (goal === "waitlist") return {
        title: (b) => `Something new is coming from ${b}.`,
        subtitle: `I'm building something for ${a.for}. Sign up to get notified.`,
        ctaLabel: "Get notified", ctaClose: "Be the first to see it.", urgency: "Launching soon.",
        proofLine: a.proof, tagline: (b) => `${b} — something new.`,
      };
      // default
      return {
        title: (b) => `I'm ${b}. I build ${t.feel} products for ${a.for}.`,
        subtitle: "Full-stack developer. Design-aware. I ship fast and take full ownership.",
        ctaLabel: "Work with me", ctaClose: "Let's talk.", urgency: "",
        proofLine: a.proof, tagline: (b) => `${b} — developer & designer.`,
      };
    }

    // Fallback (blank / unknown)
    return {
      title: (b) => `${b} — built for ${a.for}.`,
      subtitle: `A ${t.feel} solution that delivers results.`,
      ctaLabel: "Get started", ctaClose: "Ready to start?", urgency: "",
      proofLine: a.proof, tagline: (b) => `${b} — ${t.feel} by design.`,
    };
  }

  function buildMeta(w: WizardInputs): any {
    return {
      projectType: selectedPresetId === "blank" ? "custom" : selectedPresetId,
      goal: w.goal,
      audience: w.audience,
      tone: w.tone,
      language: w.lang,
      presetId: selectedPresetId,
      presetVariants: { ...selectedVariants },
    };
  }

  function buildProjectData(): any {
    const w = getWizardInputs();
    const brandName = w.brand || w.name;
    const seed = getCopySeed(selectedPresetId, w.goal, w.audience, w.tone);
    const toneAdj: Record<string, string> = { premium: "Premium experience", minimal: "Simple by design", bold: "Built different", futuristic: "The future is here", organic: "Human-first" };
    const badge = toneAdj[w.tone] || "";
    const cta = w.cta || seed.ctaLabel;
    const ctaHref = w.ctaHref || "#";

    // ── Blank / custom ──────────────────────────────────────
    if (selectedPresetId === "blank") {
      return {
        meta: buildMeta(w),
        brand: { name: brandName, tagline: w.tagline || seed.tagline(brandName), colors: { primary: "#7DD3FC", bg: "#070A12", fg: "#E7EEF7", accent: "#34D399" } },
        sections: [
          { type: "hero", variant: "centered", content: {
            badge,
            title: w.tagline || seed.title(brandName),
            subtitle: seed.subtitle,
            primaryCta: { label: cta, href: ctaHref },
          }},
          { type: "cta", content: { title: seed.ctaClose, subtitle: seed.urgency || `Built for results.`, primaryCta: { label: cta, href: ctaHref } } },
        ],
      };
    }

    // ── Preset-based ────────────────────────────────────────
    const preset = presets.find((p: any) => p.id === selectedPresetId);
    if (!preset) { selectedPresetId = "blank"; return buildProjectData(); }

    const data = JSON.parse(JSON.stringify(preset.data));
    const enabled = getEnabledSections();

    // Inject meta
    data.meta = buildMeta(w);

    // Inject brand
    data.brand.name = brandName;
    data.brand.tagline = w.tagline || seed.tagline(brandName);

    // ── Section overrides ───────────────────────────────────
    data.sections.forEach((s: any) => {
      if (s.type === "hero") {
        if (selectedVariants.hero) s.variant = selectedVariants.hero;
        s.content.badge = badge;
        if (!w.tagline) {
          s.content.title = seed.title(brandName);
          s.content.subtitle = seed.subtitle;
        }
      }

      if (s.type === "pricing" && selectedVariants.pricing) {
        s.variant = selectedVariants.pricing;
      }

      if (s.type === "logoCloud") {
        s.content.title = seed.proofLine;
      }

      if (s.type === "cta") {
        s.content.title = seed.ctaClose;
        s.content.subtitle = seed.urgency || s.content.subtitle;
      }

      // Override CTA labels
      if (w.cta && s.content?.primaryCta) s.content.primaryCta.label = cta;
      if (w.ctaHref && s.content?.primaryCta) s.content.primaryCta.href = ctaHref;
      if (s.content?.tiers) {
        s.content.tiers.forEach((t: any) => {
          if (t.highlight && t.cta) {
            if (w.cta) t.cta.label = cta;
            if (w.ctaHref) t.cta.href = ctaHref;
          }
        });
      }
    });

    // ── Filter optional sections ────────────────────────────
    if (preset.optionalSections) {
      const optionalTypes = new Set(Object.keys(preset.optionalSections));
      data.sections = data.sections.filter((s: any) => {
        if (!optionalTypes.has(s.type)) return true;
        return enabled.has(s.type);
      });
    }

    // ── Proof variant filter ────────────────────────────────
    if (selectedVariants.proof) {
      const v = selectedVariants.proof;
      if (v === "none") data.sections = data.sections.filter((s: any) => s.type !== "metrics" && s.type !== "logoCloud");
      else if (v === "metrics") data.sections = data.sections.filter((s: any) => s.type !== "logoCloud");
      else if (v === "logos") data.sections = data.sections.filter((s: any) => s.type !== "metrics");
    }

    // ── Process/showcase variant filter (agency/portfolio) ──
    if (selectedVariants.process) {
      const v = selectedVariants.process;
      if (v === "none") data.sections = data.sections.filter((s: any) => s.type !== "workflow" && s.type !== "featureSplit");
      else if (v === "workflow") data.sections = data.sections.filter((s: any) => s.type !== "featureSplit" || s.content?.title === "Tech stack");
      else if (v === "featureSplit") data.sections = data.sections.filter((s: any) => s.type !== "workflow");
    }
    if (selectedVariants.showcase) {
      const v = selectedVariants.showcase;
      if (v === "none") data.sections = data.sections.filter((s: any) => s.type !== "valueGrid" && s.type !== "featureSplit");
      else if (v === "valueGrid") data.sections = data.sections.filter((s: any) => !(s.type === "featureSplit" && s.content?.title !== "Tech stack"));
      else if (v === "featureSplit") data.sections = data.sections.filter((s: any) => s.type !== "valueGrid");
    }

    // ── Portfolio focus variant ──────────────────────────────
    if (selectedPresetId === "portfolio" && selectedVariants.focus) {
      const focus = selectedVariants.focus;
      const hero = data.sections.find((s: any) => s.type === "hero");
      const grid = data.sections.find((s: any) => s.type === "valueGrid");
      const faq = data.sections.find((s: any) => s.type === "faq");

      if (focus === "hire_me") {
        if (hero && !w.tagline) {
          hero.content.badge = "Available for hire";
          hero.content.title = `I help teams ship products that actually work.`;
          hero.content.subtitle = "Full-stack developer with a design eye. I ship fast, write clean code and take ownership from day one.";
        }
        if (faq) faq.content.items = [
          { question: "What's your availability?", answer: "I typically book 2–4 weeks ahead. Reach out early for the best scheduling." },
          { question: "What's your rate?", answer: "It depends on scope and timeline. Reach out with your project details for a clear quote." },
          { question: "Do you do retainers?", answer: "Yes — for ongoing work, I offer monthly retainer packages with priority scheduling." },
        ];
      } else if (focus === "technical") {
        if (hero && !w.tagline) {
          hero.content.badge = "Engineer";
          hero.content.title = `${brandName} — systems, architecture, shipping.`;
          hero.content.subtitle = "I build production infrastructure, APIs and full-stack applications. Clean code, zero shortcuts.";
        }
        if (grid) {
          grid.content.title = "Engineering focus";
          grid.content.cards = [
            { title: "System design", description: "Distributed systems, event-driven architecture, horizontal scaling." },
            { title: "API & backend", description: "REST, GraphQL, real-time — built for reliability and performance." },
            { title: "DevOps & infra", description: "CI/CD, Docker, Kubernetes, monitoring — production-grade from day one." },
            { title: "Code quality", description: "Tests, type safety, code review culture. No technical debt by default." },
          ];
        }
        if (faq) faq.content.items = [
          { question: "What languages do you work with?", answer: "TypeScript, Go, Python, Rust — I pick the right tool for each problem." },
          { question: "Do you work with legacy codebases?", answer: "Yes. I specialize in incremental modernization without full rewrites." },
          { question: "Can you lead a team?", answer: "Yes — I've led teams of 3–8 engineers on complex multi-month projects." },
        ];
      } else if (focus === "creative") {
        if (hero && !w.tagline) {
          hero.content.badge = "Designer & developer";
          hero.content.title = `${brandName} — where design meets engineering.`;
          hero.content.subtitle = "I create digital experiences that feel intentional. Every interaction, transition and pixel has a reason.";
        }
        if (grid) {
          grid.content.title = "Creative approach";
          grid.content.cards = [
            { title: "Visual storytelling", description: "Design that communicates before the user reads a single word." },
            { title: "Motion & interaction", description: "Subtle animations and micro-interactions that elevate the experience." },
            { title: "Brand systems", description: "Consistent visual language across every touchpoint — web, mobile, print." },
            { title: "Design-to-code", description: "I design in Figma and build in code. No handoff, no translation loss." },
          ];
        }
        if (faq) faq.content.items = [
          { question: "Do you do branding?", answer: "Yes — logos, color systems, typography and brand guidelines are part of my offering." },
          { question: "What design tools do you use?", answer: "Figma for UI, After Effects for motion, Blender for 3D. All exported production-ready." },
          { question: "Can you handle both design and development?", answer: "That's my specialty. One person, zero handoff, pixel-perfect execution." },
        ];
      }
    }

    return data;
  }

  function showAuth(show: boolean) {
    const authPanel = $("authPanel") as HTMLElement | null;
    const workspace = $("workspace") as HTMLElement | null;
    if (authPanel) authPanel.hidden = !show;
    if (workspace) workspace.hidden = show;
  }

  async function listProjects(userId: string) {
    const { data, error } = await supa
      .from("projects")
      .select("id,name,slug,builder_data,status,created_at")
      .eq("user_id", userId)
      .is("deleted_at", null)
      .order("created_at", { ascending: false });

    if (error) return setStatus(error.message);
    const box = $("projects");
    if (!box) return;

    box.innerHTML =
      (data || []).map((p: any) => `
        <button class="project-btn" data-id="${p.id}">
          <div class="project-row">
            <span class="project-name">${p.name}</span>
            <span class="project-status project-status--${p.status || 'draft'}">${p.status || 'draft'}</span>
          </div>
          <span class="project-slug">${p.slug ? p.slug + '.volynx.world' : 'no slug'}</span>
        </button>
      `).join("") || `<span class="hint">No projects yet.</span>`;

    box.querySelectorAll(".project-btn").forEach((btn) => {
      btn.addEventListener("click", () =>
        openProject((data || []).find((x: any) => x.id === (btn as HTMLElement).dataset.id))
      );
    });
  }

  function openProject(p: any) {
    currentProject = p;
    const json = $("json") as HTMLTextAreaElement | null;
    if (json) json.value = JSON.stringify(p.builder_data || {}, null, 2);
    const link = $("link");
    if (link) link.innerHTML = "";
    setStatus("Project loaded.");

    // Info panel
    const infoPanel = $("infoPanel") as HTMLElement;
    if (infoPanel) infoPanel.hidden = false;

    const infoName = $("infoName");
    if (infoName) infoName.textContent = p.name;

    const infoBadge = $("infoBadge") as HTMLElement;
    if (infoBadge) {
      infoBadge.textContent = p.status || "draft";
      infoBadge.className = `status-badge status-badge--${p.status || "draft"}`;
    }

    const liveUrl = p.slug ? `https://${p.slug}.volynx.world/` : "";
    const infoUrlBox = $("infoUrlBox") as HTMLElement;
    const infoUrl = $("infoUrl") as HTMLAnchorElement;
    const visitBtn = $("visitSite") as HTMLAnchorElement;

    if (p.status === "published" && liveUrl) {
      if (infoUrlBox) infoUrlBox.hidden = false;
      if (infoUrl) { infoUrl.href = liveUrl; infoUrl.textContent = liveUrl; }
      if (visitBtn) { visitBtn.hidden = false; visitBtn.href = liveUrl; }
    } else {
      if (infoUrlBox) infoUrlBox.hidden = true;
      if (visitBtn) visitBtn.hidden = true;
    }

    document.querySelectorAll(".project-btn").forEach((b) => b.classList.remove("active"));
    const active = document.querySelector(`[data-id="${p.id}"]`);
    if (active) active.classList.add("active");

    // Enable "Refine current" in AI tab
    const aiRefineBtn = $("aiRefine") as HTMLButtonElement;
    if (aiRefineBtn) {
      aiRefineBtn.disabled = false;
      aiRefineBtn.title = "Refine " + p.name + " with AI";
    }

    // Trigger preview refresh
    ($("json") as HTMLTextAreaElement)?.dispatchEvent(new Event("input"));
  }

  async function saveCurrent() {
    if (!currentProject) return false;
    let parsed;
    try {
      parsed = JSON.parse(($("json") as HTMLTextAreaElement)?.value || "{}");
    } catch {
      setStatus("Invalid JSON.");
      return false;
    }
    const { error } = await supa
      .from("projects")
      .update({ builder_data: parsed, updated_at: new Date().toISOString() })
      .eq("id", currentProject.id);
    if (error) { setStatus(error.message); return false; }
    currentProject.builder_data = parsed;
    return true;
  }

  // ── Boot: use existing Volynx session ──────────────────────────
  (async function boot() {
    log("boot start");

    // 1. Load config
    let cfg: any;
    try {
      cfg = await fetch("/config.json", { cache: "no-store" }).then(r => r.json());
    } catch {
      showAuth(true);
      ($("authMsg") as HTMLElement).textContent = "Configuration error.";
      return;
    }

    supa = createClient(cfg.supabaseUrl, cfg.supabaseAnonKey);
    log("supabase client created");

    // Load presets (non-blocking)
    await loadPresets();

    // 2. Restore session from Volynx tokens
    const accessToken = localStorage.getItem("volynx_access_token");
    const refreshToken = localStorage.getItem("volynx_refresh_token");

    if (!accessToken || !refreshToken) {
      log("no session tokens — show login prompt");
      showAuth(true);
      ($("authMsg") as HTMLElement).textContent = "Sign in to your Volynx account first.";
      ($("sendLink") as HTMLButtonElement).textContent = "Go to Login";
      ($("sendLink") as HTMLButtonElement).onclick = () => {
        window.location.href = "/login/?next=/builder/";
      };
      ($("email") as HTMLElement).style.display = "none";
      return;
    }

    const { error: sessErr } = await supa.auth.setSession({
      access_token: accessToken,
      refresh_token: refreshToken,
    });

    if (sessErr) {
      log("session restore failed: " + sessErr.message);
      showAuth(true);
      ($("authMsg") as HTMLElement).textContent = "Session expired. Please sign in again.";
      ($("sendLink") as HTMLButtonElement).textContent = "Go to Login";
      ($("sendLink") as HTMLButtonElement).onclick = () => {
        window.location.href = "/login/?next=/builder/";
      };
      ($("email") as HTMLElement).style.display = "none";
      return;
    }

    const { data: authData } = await supa.auth.getUser();
    const user = authData?.user;
    if (!user) {
      log("getUser failed");
      showAuth(true);
      return;
    }

    log("authenticated: " + user.email);
    const who = $("who");
    if (who) who.textContent = user.email || "";
    showAuth(false);

    // Fetch user profile (plan, org_id, tokens, builder_plan)
    userProfile = await fetchUserProfile(user.id);
    const builderPlan = userProfile?.builder_plan || "free";
    planLimits = await fetchPlanLimits(builderPlan);
    log("builder_plan: " + builderPlan + " | tokens: " + (userProfile?.token_balance || 0));

    await listProjects(user.id);

    // ── URL parameter handling ──────────────────────────────────
    // ?preset={id}   → auto-select a preset in the wizard and advance to step 2
    // ?project={uuid} → load an existing project directly into the editor, skipping the wizard
    (function handleUrlParams() {
      const params = new URLSearchParams(window.location.search);
      const presetParam = params.get("preset");
      const projectParam = params.get("project");

      if (projectParam) {
        // Load a specific project by UUID directly into the editor
        log("url param: project=" + projectParam);
        supa
          .from("projects")
          .select("id,name,slug,builder_data,status,created_at")
          .eq("id", projectParam)
          .eq("user_id", user.id)
          .is("deleted_at", null)
          .single()
          .then(({ data, error }: { data: any; error: any }) => {
            if (error || !data) {
              log("project url param load failed: " + (error?.message || "not found"));
              setStatus("Project not found or access denied.");
              return;
            }
            openProject(data);
            log("opened project from url param: " + data.name);
          });
        // project param takes priority — skip preset handling
        return;
      }

      if (presetParam) {
        // Auto-select a preset and advance the wizard to step 2
        log("url param: preset=" + presetParam);
        const presetGrid = document.getElementById("presetGrid");
        if (!presetGrid) return;

        const matchingCard = presetGrid.querySelector<HTMLElement>(
          `[data-preset="${CSS.escape(presetParam)}"]`
        );
        if (!matchingCard) {
          log("preset url param not found in grid: " + presetParam);
          return;
        }

        // Simulate a click to trigger existing selection + active styling
        matchingCard.click();
        log("preset auto-selected from url param: " + presetParam);

        // Advance to step 2 — the wizard requires a project name first, so
        // scroll the name field into view and wait for user input before proceeding
        showWizardStep(2);
      }
    })();

    // ── Event listeners ────────────────────────────────────────
    $("logout")?.addEventListener("click", async () => {
      try { await supa.auth.signOut(); } catch {}
      KEYS.forEach(k => localStorage.removeItem(k));
      window.location.href = "/";
    });

    // Export ZIP
    $("exportZip")?.addEventListener("click", async () => {
      if (!currentProject) return setStatus("Select a project.");
      setStatus("Generating ZIP…");
      try {
        const jsonStr = JSON.stringify(currentProject.builder_data || {}, null, 2);
        const slug = currentProject.slug || "project";

        // Build a simple HTML preview using the builder_data
        const htmlContent = `<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>${currentProject.name || "VOLYNX Site"}</title>
<style>body{font-family:system-ui,sans-serif;background:#070A12;color:#E7EEF7;margin:0;padding:40px 24px;max-width:960px;margin:0 auto}
h1{font-size:2.5em;letter-spacing:-.03em}p{color:rgba(231,238,247,.6);line-height:1.7}
.badge{display:inline-block;padding:6px 14px;border-radius:999px;background:rgba(125,211,252,.08);border:1px solid rgba(125,211,252,.2);font-size:12px;color:#7DD3FC;margin-bottom:20px}
section{padding:40px 0;border-bottom:1px solid rgba(231,238,247,.08)}</style>
</head>
<body>
<p class="badge">${slug}.volynx.world</p>
<h1>${currentProject.name}</h1>
<p>This site was built with VOLYNX Builder. Edit the builder_data.json to customize.</p>
<p>To publish: use the VOLYNX Builder at <a href="https://volynx.world/builder/" style="color:#7DD3FC">volynx.world/builder</a></p>
</body></html>`;

        // Create ZIP with JSZip (or fallback to JSON download)
        const blob = new Blob([jsonStr], { type: "application/json" });
        const htmlBlob = new Blob([htmlContent], { type: "text/html" });

        if (typeof JSZip !== "undefined") {
          const zip = new JSZip();
          zip.file("builder_data.json", jsonStr);
          zip.file("index.html", htmlContent);
          zip.file("README.txt", `VOLYNX Builder Export\n\nProject: ${currentProject.name}\nSlug: ${slug}\nExported: ${new Date().toISOString()}\n\nFiles:\n- builder_data.json → your site configuration (edit this)\n- index.html → basic preview\n\nTo publish your site:\n1. Go to https://volynx.world/builder/\n2. Import or paste the builder_data.json\n3. Click Publish\n\nYour site will be live at: https://${slug}.volynx.world/\n`);
          const zipBlob = await zip.generateAsync({ type: "blob" });
          const a = document.createElement("a");
          a.href = URL.createObjectURL(zipBlob);
          a.download = `${slug}-volynx-export.zip`;
          a.click();
          URL.revokeObjectURL(a.href);
          setStatus("ZIP downloaded ✓");
        } else {
          // Fallback: just download JSON
          const a = document.createElement("a");
          a.href = URL.createObjectURL(blob);
          a.download = `${slug}-builder_data.json`;
          a.click();
          URL.revokeObjectURL(a.href);
          setStatus("JSON downloaded ✓");
        }
      } catch (err: any) {
        setStatus("Export failed: " + (err?.message || err));
      }
    });

    // Delete project (soft delete)
    $("deleteProject")?.addEventListener("click", async () => {
      if (!currentProject) return setStatus("Select a project.");
      if (!confirm(`Delete "${currentProject.name}"? This can't be undone.`)) return;

      const { error } = await supa
        .from("projects")
        .update({ deleted_at: new Date().toISOString() })
        .eq("id", currentProject.id);

      if (error) return setStatus(error.message);
      setStatus("Project deleted.");
      currentProject = null;
      ($("json") as HTMLTextAreaElement).value = "";
      ($("infoPanel") as HTMLElement).hidden = true;
      await listProjects(user.id);
    });

    // Wizard navigation (3 steps)
    $("toStep2")?.addEventListener("click", () => {
      const name = (($("pname") as HTMLInputElement)?.value || "").trim();
      if (!name) { ($("pname") as HTMLInputElement).focus(); return; }
      showWizardStep(2);
    });

    $("toStep3")?.addEventListener("click", () => {
      // Pre-fill brand with project name if empty
      const brandInput = $("wBrand") as HTMLInputElement;
      const pname = (($("pname") as HTMLInputElement)?.value || "").trim();
      if (brandInput && !brandInput.value.trim()) brandInput.value = pname;
      showWizardStep(3);
    });

    $("backStep1")?.addEventListener("click", () => showWizardStep(1));
    $("backStep2")?.addEventListener("click", () => showWizardStep(2));

    // ── Tab click handlers ──
    document.querySelectorAll(".editor-tab").forEach(tab => {
      tab.addEventListener("click", () => switchTab((tab as HTMLElement).dataset.tab || "sections"));
    });

    // Create project (with builder_plan limit check + usage logging)
    $("create")?.addEventListener("click", async () => {
      const btn = $("create") as HTMLButtonElement;
      const counts = await countActiveProjects(user.id);
      const check = canCreate(counts);
      if (!check.ok) return setStatus(check.msg);

      btnLoading(btn, true, "Creating...");
      const w = getWizardInputs();
      const baseSlug = slugify((($("pslug") as HTMLInputElement)?.value || "").trim() || w.name) || "site";
      const slug = `${baseSlug}-${rand4()}`;

      const builder_data = buildProjectData();

      const { data, error } = await supa
        .from("projects")
        .insert({ user_id: user.id, name: w.name, slug, domain_type: "subdomain", builder_data, status: "draft" })
        .select("id,name,slug,builder_data,status,created_at")
        .single();

      btnLoading(btn, false);
      if (error) return setStatus(error.message);
      await logUsage("builder_create");
      setStatus("Project created!");
      showWizardStep(1); // reset wizard
      await listProjects(user.id);
      openProject(data);
    });

    $("save")?.addEventListener("click", async () => {
      if (!currentProject) return setStatus("Select a project.");
      const ok = await saveCurrent();
      if (ok) setStatus("Saved ✓");
    });

    $("copy")?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(($("json") as HTMLTextAreaElement)?.value || "");
        setStatus("Copied to clipboard.");
      } catch { setStatus("Clipboard permission denied."); }
    });

    $("publish")?.addEventListener("click", async () => {
      if (!currentProject) return setStatus("Select a project.");
      if (!currentProject.slug) return setStatus("Project has no slug. Edit JSON to add one.");

      // Check publish limit based on builder_plan
      const counts = await countActiveProjects(user.id);
      const pubCheck = canPublish(counts);
      if (!pubCheck.ok) return setStatus(pubCheck.msg);

      setStatus("Saving…");
      const ok = await saveCurrent();
      if (!ok) return;

      const { data: sessData } = await supa.auth.getSession();
      const token = sessData?.session?.access_token;
      if (!token) return setStatus("Session expired. Please refresh the page.");

      const apiBase = ((cfg as any).apiBaseUrl || "").replace(/\/$/, "");
      if (!apiBase) {
        setStatus("Publish backend not configured. Add apiBaseUrl to config.json.");
        log("publish blocked: apiBaseUrl missing from config.json");
        return;
      }

      const pubBtn = $("publish") as HTMLButtonElement;
      btnLoading(pubBtn, true, "Publishing...");
      setStatus("Publishing to " + currentProject.slug + ".volynx.world…");
      try {
        const ctrl = new AbortController();
        const timeout = setTimeout(() => ctrl.abort(), 15000);

        const r = await fetch(`${apiBase}/publish`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify({ projectId: currentProject.id }),
          signal: ctrl.signal,
        });
        clearTimeout(timeout);

        const j: any = await r.json().catch(() => ({}));

        if (!r.ok) {
          const errMap: Record<string, string> = {
            missing_token: "Authentication failed. Try signing out and back in.",
            invalid_token: "Session invalid. Try signing out and back in.",
            missing_projectId: "Internal error: project ID missing.",
            project_not_found: "Project not found in the database.",
            forbidden: "You don't have permission to publish this project.",
            missing_slug: "Project needs a slug before publishing.",
          };
          return setStatus(errMap[j?.error] || j?.error || `Publish failed (HTTP ${r.status}).`);
        }

        btnLoading(pubBtn, false);
        setStatus("Published ✓");
        currentProject.status = "published";
        await logUsage("builder_publish");

        // Update info panel with live URL
        const liveUrl = j.url || `https://${currentProject.slug}.volynx.world/`;
        const infoUrlBox = $("infoUrlBox") as HTMLElement;
        const infoUrl = $("infoUrl") as HTMLAnchorElement;
        const visitBtn = $("visitSite") as HTMLAnchorElement;
        const infoBadge = $("infoBadge") as HTMLElement;
        if (infoUrlBox) infoUrlBox.hidden = false;
        if (infoUrl) { infoUrl.href = liveUrl; infoUrl.textContent = liveUrl; }
        if (visitBtn) { visitBtn.hidden = false; visitBtn.href = liveUrl; }
        if (infoBadge) { infoBadge.textContent = "published"; infoBadge.className = "status-badge status-badge--published"; }

        await supa.from("projects")
          .update({ status: "published", updated_at: new Date().toISOString() })
          .eq("id", currentProject.id);

        await listProjects(user.id);
      } catch (err: any) {
        btnLoading(pubBtn, false);
        if (err?.name === "AbortError") {
          setStatus("Publish timed out. The API may be starting up — try again in 30s.");
        } else {
          setStatus("Cannot reach publish API. Check that api.volynx.world is configured.");
          log("publish error: " + (err?.message || err));
        }
      }
    });

    // ── Preview Toggle + Live Render ──
    const previewToggle = $("previewToggle") as HTMLButtonElement;
    const previewPane = $("previewPane") as HTMLElement;
    const previewFrame = $("previewFrame") as HTMLIFrameElement;
    const editorSplit = $("editorSplit") as HTMLElement;
    let previewActive = false;

    function updatePreview() {
      if (!previewActive || !previewFrame) return;
      try {
        const raw = ($("json") as HTMLTextAreaElement)?.value || "{}";
        const data = JSON.parse(raw);
        if (window.VxRenderer && data.sections) {
          previewFrame.srcdoc = window.VxRenderer.renderPage(data);
        }
      } catch (_) {
        // Invalid JSON — don't update preview
      }
    }

    previewToggle?.addEventListener("click", () => {
      previewActive = !previewActive;
      previewToggle.classList.toggle("is-active", previewActive);
      previewPane.hidden = !previewActive;
      editorSplit.classList.toggle("is-split", previewActive);
      if (previewActive) updatePreview();
    });

    // Debounced preview on JSON edit
    let previewTimer: ReturnType<typeof setTimeout>;
    ($("json") as HTMLTextAreaElement)?.addEventListener("input", () => {
      clearTimeout(previewTimer);
      previewTimer = setTimeout(updatePreview, 400);
    });

    // ── AI Generate / Refine ──────────────────────────────────
    const functionsBase = ((cfg as any).functionsUrl || "https://zdmpzrderifgqmqivjoy.supabase.co/functions/v1").replace(/\/$/, "");

    async function callAIBuilder(description: string, refine: boolean, current: any) {
      const token = localStorage.getItem("volynx_access_token") || "";
      const res = await fetch(`${functionsBase}/ai-builder`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          ...(token ? { "Authorization": "Bearer " + token } : {}),
        },
        body: JSON.stringify({ description, refine, current }),
      });
      const data = await res.json();
      if (data.error) throw new Error(data.error);
      return data.builderData;
    }

    function setAIStatus(msg: string, type: "info" | "error" | "success" = "info") {
      const el = $("aiStatus") as HTMLElement;
      if (!el) return;
      el.hidden = !msg;
      el.textContent = msg;
      el.className = `ai-status ai-status--${type}`;
    }

    async function runAI(refine: boolean) {
      const prompt = ($("aiPrompt") as HTMLTextAreaElement)?.value?.trim();
      if (!prompt) {
        setAIStatus("Please describe the site you want to build.", "error");
        return;
      }
      const generateBtn = $("aiGenerate") as HTMLButtonElement;
      const refineBtn = $("aiRefine") as HTMLButtonElement;

      // Deduct a token first
      const token = localStorage.getItem("volynx_access_token");
      if (!token) {
        setAIStatus("Sign in to use AI Builder.", "error");
        return;
      }
      setAIStatus("Checking balance…", "info");
      try {
        const deductRes = await fetch(`${functionsBase}/deduct-tokens`, {
          method: "POST",
          headers: { "Content-Type": "application/json", "Authorization": "Bearer " + token },
          body: JSON.stringify({ tool: "builder", action_class: "pro", description: "AI Builder site generation" }),
        });
        const deductData = await deductRes.json();
        if (!deductData.ok && deductData.error === "insufficient_balance") {
          setAIStatus("Not enough tokens. Add more to use AI Builder.", "error");
          ($("aiStatus") as HTMLElement).innerHTML +=
            ' <a href="/pricing/" class="btn btn--primary btn--sm" style="margin-left:8px;">Add tokens</a>';
          return;
        }
      } catch { /* allow on network error */ }

      generateBtn.disabled = true;
      refineBtn.disabled = true;
      setAIStatus("Generating site with AI… this may take a few seconds.", "info");

      try {
        const current = refine && currentProject ? currentProject.builder_data : undefined;
        const builderData = await callAIBuilder(prompt, refine, current);

        if (refine && currentProject) {
          // Update existing project JSON in editor
          const jsonEl = $("json") as HTMLTextAreaElement;
          if (jsonEl) {
            jsonEl.value = JSON.stringify(builderData, null, 2);
            jsonEl.dispatchEvent(new Event("input"));
          }
          currentProject.builder_data = builderData;
          setAIStatus("Sections updated! Switch to Sections or JSON to review, then Save.", "success");
          switchTab("sections");
        } else {
          // Create a new draft project with AI-generated data
          const slug = "ai-" + (prompt.slice(0, 20).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "") || "site") + "-" + rand4();
          const name = prompt.slice(0, 40).replace(/[^\w\s-]/g, "").trim() || "AI Generated Site";
          const counts = await countActiveProjects(user.id);
          const check = canCreate(counts);
          if (!check.ok) {
            setAIStatus(check.msg, "error");
            return;
          }
          const { data, error } = await supa
            .from("projects")
            .insert({ user_id: user.id, name, slug, domain_type: "subdomain", builder_data: builderData, status: "draft" })
            .select("id,name,slug,builder_data,status,created_at")
            .single();

          if (error) { setAIStatus(error.message, "error"); return; }
          await logUsage("builder_ai");
          setAIStatus("Site generated! Switch to Sections to review and edit.", "success");
          await listProjects(user.id);
          openProject(data);
          switchTab("sections");
        }
      } catch (err: any) {
        setAIStatus("Error: " + (err?.message || "AI generation failed."), "error");
      } finally {
        generateBtn.disabled = false;
        if (currentProject) refineBtn.disabled = false;
      }
    }

    $("aiGenerate")?.addEventListener("click", () => runAI(false));
    $("aiRefine")?.addEventListener("click", () => runAI(true));

    log("boot complete");
  })();
</script>

