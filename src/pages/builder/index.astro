    border-top-color: var(--fg);
    border-radius: 50%;
    display: inline-block;
    margin-left: 8px;
    vertical-align: -2px;
    animation: spin .7s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* MISC */
  .hint {
    font-size: 12px;
    color: var(--mut);
    margin: 0;
    line-height: 1.5;
  }

  code {
    font-family: ui-monospace, monospace;
    background: rgba(125, 211, 252, .1);
    padding: 1px 5px;
