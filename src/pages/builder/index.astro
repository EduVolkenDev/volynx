    flex-shrink: 0;
  }

  /* GRID */
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .card--editor {
    grid-column: 1 / -1;
  }

  @media (max-width: 800px) {
    .grid { grid-template-columns: 1fr; }
    .card--editor { grid-column: auto; }
  }

  /* CARD */
  .card {
    border: 1px solid var(--card-border);
    border-radius: var(--r);
    padding: 22px;
