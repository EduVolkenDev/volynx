  }

  a { color: inherit; }

  .btn[disabled] { opacity: .5; cursor: not-allowed; }

  /* Mobile */
  @media (max-width: 680px) {
    .hero { padding: 40px 16px 28px; }
    .panel { padding: 28px 20px; }
    .card { padding: 16px; }
    .json-editor { min-height: 220px; }
    .editor-header { flex-direction: column; align-items: flex-start; }
