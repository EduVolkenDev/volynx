  // ── Variant selectors (per preset) ─────────────────────────
  function renderVariantSelectors() {
    const box = $("variantSelectors") as HTMLElement;
    if (!box) return;
    const preset = presets.find((p: any) => p.id === selectedPresetId);
    if (!preset?.variants) { box.innerHTML = ""; return; }

    box.innerHTML = Object.entries(preset.variants as Record<string, any>).map(([key, v]: [string, any]) => {
      selectedVariants[key] = selectedVariants[key] || v.default;
      const icons = variantIcons[key] || {};
      return `<div class="variant-group">
        <label class="label">${v.label}</label>
        <div class="variant-options" data-variant-key="${key}">
          ${v.options.map((opt: string) => `<button type="button" class="variant-card ${opt === (selectedVariants[key] || v.default) ? "variant-card--active" : ""}" data-value="${opt}">
            <div class="variant-card__preview">${icons[opt] || `<span style="font-size:11px;opacity:.3">${opt}</span>`}</div>
            <span class="variant-card__label">${variantLabels[opt] || opt}</span>
          </button>`).join("")}
        </div>
      </div>`;
    }).join("");

    box.querySelectorAll(".variant-options").forEach(group => {
      const key = (group as HTMLElement).dataset.variantKey!;
      group.querySelectorAll(".variant-card").forEach(card => {
        card.addEventListener("click", () => {
          group.querySelectorAll(".variant-card").forEach(c => c.classList.remove("variant-card--active"));
          card.classList.add("variant-card--active");
          selectedVariants[key] = (card as HTMLElement).dataset.value || "";
          log(`variant ${key} = ${selectedVariants[key]}`);
        });
      });
    });
  }

  // ── Optional section toggles ───────────────────────────────
  function renderOptionalToggles() {
    const box = $("optionalToggles") as HTMLElement;
    if (!box) return;
    const preset = presets.find((p: any) => p.id === selectedPresetId);
    if (!preset?.optionalSections) { box.innerHTML = ""; return; }

    box.innerHTML = `<label class="label">Include sections</label><div class="toggle-grid">` +
      Object.entries(preset.optionalSections as Record<string, any>).map(([key, cfg]: [string, any]) =>
        `<label class="toggle-item">
          <input type="checkbox" data-section="${key}" ${cfg.default ? "checked" : ""} />
          <span>${cfg.label}</span>
        </label>`
      ).join("") + `</div>`;
  }

  function getEnabledSections(): Set<string> {
    const enabled = new Set<string>();
    const box = $("optionalToggles");
    if (!box) return enabled;
    box.querySelectorAll<HTMLInputElement>("input[data-section]").forEach(cb => {
      if (cb.checked) enabled.add(cb.dataset.section!);
    });
    return enabled;
  }

  // ── Build project data ─────────────────────────────────────
  interface WizardInputs {
