---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import DeliveryTrustStrip from "../../components/DeliveryTrustStrip.astro";
import PlatformAssistStrip from "../../components/PlatformAssistStrip.astro";
import { ROUTES } from "../../data/routes";

const deliveryAssistItems = [
  { href: ROUTES.support, label: "Help", title: "Open support", copy: "Keep the checkout email and product name attached if recovery needs a human lane.", emphasized: true, iconSrc: "/assets/support-gold.webp" },
  { href: ROUTES.products, label: "Catalog", title: "Browse products", copy: "Go back to the catalog if you need to compare what was purchased or what comes next.", iconSrc: "/assets/allproducts.webp" },
  { href: ROUTES.pricing, label: "Plans", title: "Check pricing", copy: "Review access, bundles and token logic while the purchase context is still fresh.", iconSrc: "/assets/pricing.webp" },
  { href: ROUTES.daily, label: "Workspace", title: "Open Daily", copy: "Return to the daily workspace and keep the ecosystem connected beyond delivery.", iconSrc: "/assets/daily-diamond.webp" },
];
---
<FlagshipLayout title="My Products — VOLYNX" description="Access your purchased products, downloads and subscriptions." pageClass="page-delivery">
  <FlagshipHeader ctaLabel="Open Builder" ctaI18n="header.open_builder" ctaHref="/builder/" />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero delivery-hero">
      <div class="shell">
        <nav class="delivery-breadcrumbs" aria-label="Breadcrumb">
          <a href={ROUTES.home}><span class="i18n-en">Home</span><span class="i18n-pt">Início</span></a>
          <span>/</span>
          <a href={ROUTES.products}><span class="i18n-en">Products</span><span class="i18n-pt">Produtos</span></a>
          <span>/</span>
          <span><span class="i18n-en">My Products</span><span class="i18n-pt">Meus produtos</span></span>
        </nav>

        <!-- Payment success banner — shown when ?payment=success in URL after Stripe redirect -->
        <div id="paymentSuccessBanner" class="payment-banner payment-banner--success" role="status" aria-live="polite" hidden>
          <div class="payment-banner__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <div class="payment-banner__copy">
            <strong><span class="i18n-en">Payment confirmed.</span><span class="i18n-pt">Pagamento confirmado.</span></strong>
            <span><span class="i18n-en">Your purchase is below. Downloads and access were unlocked automatically.</span><span class="i18n-pt">Sua compra está abaixo. Downloads e acessos foram liberados automaticamente.</span></span>
          </div>
          <button type="button" class="payment-banner__close" id="paymentBannerClose" aria-label="Dismiss notification" data-i18n-aria="delivery.dismiss">×</button>
        </div>

        <!-- Payment cancelled banner -->
        <div id="paymentCancelledBanner" class="payment-banner payment-banner--info" role="status" aria-live="polite" hidden>
          <div class="payment-banner__copy">
            <strong><span class="i18n-en">Checkout cancelled.</span><span class="i18n-pt">Checkout cancelado.</span></strong>
            <span><span class="i18n-en">No charge was made. You can resume from the catalog whenever you're ready.</span><span class="i18n-pt">Nenhuma cobrança foi feita. Você pode retomar pelo catálogo quando quiser.</span></span>
          </div>
          <button type="button" class="payment-banner__close" id="paymentCancelledClose" aria-label="Dismiss notification" data-i18n-aria="delivery.dismiss">×</button>
        </div>

        <div class="hero-grid delivery-hero-grid">
          <div class="hero-copy">
            <span class="eyebrow"><span class="i18n-en">Your purchases</span><span class="i18n-pt">Suas compras</span></span>
            <h1><span class="i18n-en">Downloads, access and recovery.</span><span class="i18n-pt">Downloads, acessos e recuperação.</span></h1>
            <p><span class="i18n-en">Every kit, download, icon pack, subscription and VX top-up you've unlocked - ready to open, recover or route into support without losing context.</span><span class="i18n-pt">Todo kit, download, pack de ícones, assinatura e recarga de VX desbloqueados — prontos para abrir, recuperar ou direcionar ao suporte sem perder o contexto.</span></p>
            <div class="hero-actions">
              <a href={ROUTES.support} class="button button--gold"><span class="i18n-en">Open support</span><span class="i18n-pt">Abrir suporte</span></a>
              <a href={ROUTES.products} class="button button--ghost"><span class="i18n-en">Browse products</span><span class="i18n-pt">Ver produtos</span></a>
            </div>
          </div>
          <div class="hero-visual hero-visual--float delivery-hero-visual" aria-hidden="true">
            <img src="/assets/mybox.webp" alt="" class="hero-float-icon delivery-hero-icon" width="1380" height="1580" loading="eager" />
          </div>
        </div>
      </div>
    </section>

    <PlatformAssistStrip
      eyebrow="Delivery flow"
      title="Recovered purchases should never feel like a dead end."
      description="Use this layer to move from purchase, back into the right product or the right support lane."
      items={deliveryAssistItems}
    />

    <!-- ═══ PURCHASES ═══ -->
    <section class="page-section">
      <div class="shell">

        <!-- Loading state -->
        <div id="deliveryLoading" class="delivery-state">
          <div class="delivery-spinner" aria-hidden="true"></div>
          <p class="delivery-state__label"><span class="i18n-en">Loading your purchases...</span><span class="i18n-pt">Carregando suas compras...</span></p>
        </div>

        <!-- Error state -->
        <div id="deliveryError" class="delivery-state" style="display:none;">
          <p class="delivery-state__label delivery-state__label--error" id="deliveryErrorMsg"><span class="i18n-en">Something went wrong. Please try again.</span><span class="i18n-pt">Algo deu errado. Tente novamente.</span></p>
          <div class="delivery-state__actions">
            <a href={ROUTES.login + "?next=/delivery/"} class="button button--ghost"><span class="i18n-en">Sign in again</span><span class="i18n-pt">Entrar novamente</span></a>
            <a href={ROUTES.support} class="button button--ghost"><span class="i18n-en">Open support</span><span class="i18n-pt">Abrir suporte</span></a>
          </div>
        </div>

        <!-- Empty state -->
        <div id="deliveryEmpty" class="delivery-state" style="display:none;">
          <p class="delivery-state__label"><span class="i18n-en">No purchases yet.</span><span class="i18n-pt">Você ainda não tem compras.</span></p>
          <a href={ROUTES.products} class="button button--gold"><span class="i18n-en">Browse products</span><span class="i18n-pt">Ver produtos</span></a>
        </div>

        <!-- Product grid -->
        <div id="deliveryGrid" class="delivery-grid" style="display:none;" aria-live="polite"></div>

      </div>
    </section>

    <section class="page-section page-section--tight">
      <div class="shell">
        <DeliveryTrustStrip productName="VOLYNX delivery" />
      </div>
    </section>

    <section class="page-section">
      <div class="shell delivery-help panel">
        <div>
          <span class="eyebrow"><span class="i18n-en">Recovery path</span><span class="i18n-pt">Caminho de recuperação</span></span>
          <strong><span class="i18n-en">Missing download, billing question or launch issue?</span><span class="i18n-pt">Download faltando, dúvida de cobrança ou problema no lançamento?</span></strong>
          <p><span class="i18n-en">Open support with the same checkout email and product name so recovery keeps the right context.</span><span class="i18n-pt">Abra um chamado com o mesmo e-mail do checkout e o nome do produto para manter o contexto certo.</span></p>
        </div>
        <div class="hero-actions">
          <a href={ROUTES.support} class="button button--ghost"><span class="i18n-en">Open support</span><span class="i18n-pt">Abrir suporte</span></a>
          <a href={ROUTES.contact} class="button button--ghost"><span class="i18n-en">Contact sales</span><span class="i18n-pt">Falar com vendas</span></a>
        </div>
      </div>
    </section>

    <!-- ═══ CTA ═══ -->
    <section class="page-section page-section--last">
      <div class="shell callout panel panel--pro">
        <div>
          <span class="eyebrow"><span class="i18n-en">Keep building</span><span class="i18n-pt">Continue construindo</span></span>
          <strong><span class="i18n-en">Open Builder and start with any of your kits.</span><span class="i18n-pt">Abra o Builder e comece com qualquer um dos seus kits.</span></strong>
          <p><span class="i18n-en">Presets are loaded automatically when you follow the link from each product card.</span><span class="i18n-pt">Os presets são carregados automaticamente quando você segue o link de cada card.</span></p>
        </div>
        <div class="hero-actions">
          <a href="/builder/" class="button button--gold"><span class="i18n-en">Open Builder</span><span class="i18n-pt">Abrir Builder</span></a>
          <a href={ROUTES.products} class="button button--ghost"><span class="i18n-en">Browse more products</span><span class="i18n-pt">Ver mais produtos</span></a>
        </div>
      </div>
    </section>

  </main>
  <FlagshipFooter />

  <script is:inline type="module">
    const ROUTES = {
      support: "/support/",
      products: "/products/",
      profile: "/profile/",
      builder: "/builder/",
      kitsDelivery: "/dashboard/purchases/kits",
      propertyflowDelivery: "/dashboard/purchases/propertyflow",
      iconsDelivery: "/dashboard/purchases/icons",
    };
    const tx = (key, fallback) => window.VxI18n?.t?.(key, fallback) ?? fallback;

    // ── Auth guard ──────────────────────────────────────────────────────────
    const token = localStorage.getItem('volynx_access_token');
    const authRedirecting = !token;
    if (!token) {
      if (window.VxReturn) window.VxReturn.redirectToLogin();
      else window.location.href = '/login/?next=/delivery/';
    }

    // ── Payment status banner ──────────────────────────────────────────────
    // Stripe redirects to /delivery/?payment=success after a successful
    // checkout. Show a banner so the user gets explicit confirmation
    // (not just "the page loaded with my purchase in it").
    (function showPaymentBanner() {
      if (authRedirecting) return;
      try {
        const params = new URLSearchParams(window.location.search);
        const status = params.get('payment');
        const successEl = document.getElementById('paymentSuccessBanner');
        const cancelledEl = document.getElementById('paymentCancelledBanner');

        function hideBanner(el) {
          if (!el) return;
          el.hidden = true;
          el.style.display = 'none';
        }

        function showBanner(el) {
          if (!el) return;
          el.style.removeProperty('display');
          el.hidden = false;
        }

        hideBanner(successEl);
        hideBanner(cancelledEl);

        document.querySelectorAll('.payment-banner__close').forEach((button) => {
          button.addEventListener('click', () => hideBanner(button.closest('.payment-banner')));
        });

        if (status === 'success' && successEl) {
          showBanner(successEl);
        } else if (status === 'cancelled' && cancelledEl) {
          showBanner(cancelledEl);
        }
        if (status) {
          // Strip the param so a refresh doesn't re-show the banner forever.
          params.delete('payment');
          const qs = params.toString();
          const url = window.location.pathname + (qs ? `?${qs}` : '') + window.location.hash;
          window.history.replaceState({}, '', url);
        }
      } catch (_) {}
    })();

    // ── Helpers ─────────────────────────────────────────────────────────────
    function show(id) { const el = document.getElementById(id); if (el) el.style.display = ''; }
    function hide(id) { const el = document.getElementById(id); if (el) el.style.display = 'none'; }

    function normalizeProductId(raw) {
      const normalized = String(raw || '')
        .trim()
        .toLowerCase()
        .replace(/_(gbp|eur|brl)$/i, '')
        .replace(/-(gbp|eur|brl)$/i, '')
        .replace(/_/g, '-');

      if (normalized === 'pf-enterprise') return 'pf-white-label';
      return normalized;
    }

    function parseMeta(value) {
      if (!value) return {};
      if (typeof value === 'string') {
        try { return JSON.parse(value); } catch { return {}; }
      }
      return typeof value === 'object' ? value : {};
    }

    function stripCurrencySuffix(value) {
      return String(value || '')
        .trim()
        .replace(/_(gbp|eur|brl)$/i, '')
        .replace(/-(gbp|eur|brl)$/i, '');
    }

    function hasValue(value) {
      if (value == null) return false;
      if (typeof value === 'string') return value.trim() !== '';
      return true;
    }

    function firstValue(...values) {
      for (const value of values) {
        if (hasValue(value)) return value;
      }
      return null;
    }

    function purchaseLookupBase(item) {
      const meta = parseMeta(item?.metadata);
      return normalizeProductId(
        stripCurrencySuffix(
          meta.lookup_key ||
          meta.stripe_lookup_key ||
          item?.lookup_key ||
          item?.addon_id ||
          item?.product_id ||
          ''
        )
      );
    }

    function purchaseSessionId(item) {
      const meta = parseMeta(item?.metadata);
      return String(meta.stripe_session_id || item?.stripe_session_id || '').trim();
    }

    function mergedMetadata(baseItem, incomingItem) {
      return {
        ...parseMeta(incomingItem?.metadata),
        ...parseMeta(baseItem?.metadata),
      };
    }

    function mergedPricePaid(baseItem, incomingItem) {
      const basePrice = baseItem?.price_paid;
      const incomingPrice = incomingItem?.price_paid;
      const incomingAmountPaid = incomingItem?.amount_paid;

      if (hasValue(basePrice)) return basePrice;
      if (hasValue(incomingPrice)) return incomingPrice;
      if (typeof incomingAmountPaid === 'number') return incomingAmountPaid / 100;
      return null;
    }

    function mergePurchaseRecords(baseItem, incomingItem) {
      const metadata = mergedMetadata(baseItem, incomingItem);
      const merged = {
        ...incomingItem,
        ...baseItem,
        id: firstValue(baseItem?.id, incomingItem?.id),
        addon_id: firstValue(
          baseItem?.addon_id,
          incomingItem?.addon_id,
          metadata.lookup_key,
          metadata.stripe_lookup_key,
          incomingItem?.lookup_key,
          baseItem?.lookup_key
        ),
        product_id: firstValue(baseItem?.product_id, incomingItem?.product_id),
        lookup_key: firstValue(
          baseItem?.lookup_key,
          incomingItem?.lookup_key,
          metadata.lookup_key,
          metadata.stripe_lookup_key
        ),
        stripe_session_id: firstValue(
          purchaseSessionId(baseItem),
          purchaseSessionId(incomingItem),
          metadata.stripe_session_id
        ),
        price_paid: mergedPricePaid(baseItem, incomingItem),
        amount_paid: firstValue(incomingItem?.amount_paid, baseItem?.amount_paid),
        amount: firstValue(baseItem?.amount, incomingItem?.amount),
        price: firstValue(baseItem?.price, incomingItem?.price),
        currency: firstValue(baseItem?.currency, incomingItem?.currency),
        status: firstValue(baseItem?.status, incomingItem?.status),
        created_at: firstValue(baseItem?.created_at, incomingItem?.created_at),
        metadata,
      };

      return merged;
    }

    function sameProductPurchase(existingItem, incomingItem) {
      const existingProduct = purchaseLookupBase(existingItem);
      const incomingProduct = purchaseLookupBase(incomingItem);
      const existingSession = purchaseSessionId(existingItem);
      const incomingSession = purchaseSessionId(incomingItem);

      if (existingProduct && incomingProduct) {
        if (existingProduct !== incomingProduct) return false;
        if (existingSession && incomingSession) return existingSession === incomingSession;
        return true;
      }

      if (existingSession && incomingSession) return existingSession === incomingSession;
      return false;
    }

    function safeBuildCard(item) {
      try {
        return buildCard(item);
      } catch (err) {
        console.error('delivery card render failed', {
          item,
          error: err instanceof Error ? err.message : String(err),
        });
        return '';
      }
    }

    function withQuery(path, params) {
      const search = new URLSearchParams();
      Object.entries(params || {}).forEach(([key, value]) => {
        if (value) search.set(key, String(value));
      });
      const query = search.toString();
      return query ? `${path}?${query}` : path;
    }

    function propertyFlowTier(item) {
      const base = String(purchaseLookupBase(item) || '');
      if (base.includes('white-label') || base.includes('enterprise')) return 'white-label';
      if (base.includes('professional')) return 'professional';
      if (base.includes('starter')) return 'starter';
      return '';
    }

    function supportHref(item, product) {
      return withQuery(ROUTES.support, {
        intent: 'delivery',
        product,
        purchase: firstValue(item?.id, purchaseLookupBase(item), item?.addon_id),
        session_id: purchaseSessionId(item),
        lookup_key: firstValue(item?.lookup_key, parseMeta(item?.metadata).lookup_key),
      });
    }

    function jwtSub(jwt) {
      try {
        const part = String(jwt || '').split('.')[1];
        if (!part) return null;
        const normalized = part.replace(/-/g, '+').replace(/_/g, '/');
        const payload = JSON.parse(atob(normalized.padEnd(normalized.length + (4 - normalized.length % 4) % 4, '=')));
        return payload?.sub || null;
      } catch {
        return null;
      }
    }

    function timestampFor(value) {
      const time = new Date(value || 0).getTime();
      return Number.isFinite(time) ? time : 0;
    }

    function isTokenProductId(id) {
      return String(id || '').startsWith('tokens-');
    }

    function isKitProductId(id) {
      return String(id || '').startsWith('kit-');
    }

    function isPropertyFlowProductId(id) {
      return String(id || '').startsWith('pf-');
    }

    function isIconsProductId(id) {
      return String(id || '').startsWith('icons-');
    }

    function isAddonProductId(id) {
      return String(id || '').startsWith('addon-');
    }

    function isCheckoutSmokeProductId(id) {
      return String(id || '') === 'checkout-smoke-test';
    }

    function isSubscriptionProductId(id) {
      const value = String(id || '');
      return value.startsWith('volynx-')
        || value.startsWith('builder-')
        || value.startsWith('daily-')
        || value.startsWith('cvitae-')
        || value.startsWith('bundle-')
        || value === 'studio-pro';
    }

    function shouldShowEventFallback(row) {
      const productId = purchaseLookupBase(row);
      return isTokenProductId(productId)
        || isKitProductId(productId)
        || isPropertyFlowProductId(productId)
        || isIconsProductId(productId)
        || isAddonProductId(productId)
        || isCheckoutSmokeProductId(productId);
    }

    function tokenPackLabel(id) {
      const pack = String(id || '').replace(/^tokens-/, '');
      const map = {
        starter: 'Starter',
        core: 'Core',
        pro: 'Pro',
        scale: 'Scale',
      };
      return map[pack] || titleCase(pack);
    }

    function subscriptionLookupBase(row) {
      return normalizeProductId(
        firstValue(
          row?.lookup_key,
          row?.plan_key,
          row?.product_key,
          parseMeta(row?.metadata).lookup_key
        ) || ''
      );
    }

    function subscriptionLabel(row) {
      const planKey = String(row?.plan_key || '');
      const lookup = subscriptionLookupBase(row);

      if (planKey.startsWith('volynx_') || lookup.startsWith('volynx-') || lookup.startsWith('builder-')) {
        return 'VOLYNX Builder — ' + titleCase(String(planKey || lookup).replace(/^(volynx_|builder-)/, '').replace(/^volynx-/, ''));
      }
      if (planKey.startsWith('daily_') || lookup.startsWith('daily-')) {
        return 'VOLYNX Daily — ' + titleCase(String(planKey || lookup).replace(/^daily[_-]/, ''));
      }
      if (planKey === 'cvitae_business' || lookup.startsWith('cvitae-')) {
        return 'CVitae — ' + titleCase(String(planKey || lookup).replace(/^cvitae[_-]/, ''));
      }
      if (planKey.startsWith('bundle_') || lookup.startsWith('bundle-')) {
        return 'VOLYNX Bundle — ' + titleCase(String(planKey || lookup).replace(/^bundle[_-]/, ''));
      }
      if (planKey === 'studio_pro' || lookup === 'studio-pro') {
        return 'Studio Pro';
      }

      return titleCase(planKey || lookup || row?.product_key || 'subscription');
    }

    function subscriptionHref(row) {
      const lookup = subscriptionLookupBase(row);
      if (lookup.startsWith('daily-')) return 'https://daily.volynx.world/tools/my-day/';
      if (lookup.startsWith('cvitae-')) return 'https://cvitae.volynx.world/profile/';
      if (lookup.startsWith('bundle-')) return ROUTES.profile;
      return ROUTES.profile;
    }

    function subscriptionCta(row) {
      const lookup = subscriptionLookupBase(row);
      if (lookup.startsWith('daily-')) return 'Open Daily';
      if (lookup.startsWith('cvitae-')) return 'Open CVitae';
      return 'Open account';
    }

    function devJourneyTierLabel(tier) {
      const normalized = String(tier || '').toLowerCase();
      if (normalized === 'pro') return 'Pro Track';
      if (normalized === 'bundle') return 'Bundle';
      return 'Social Sprint';
    }

    function buildDevJourneyCard(progress) {
      const tier = String(progress?.tier || '').toLowerCase();
      if (tier !== 'pro' && tier !== 'bundle') return '';

      return `
        <article class="panel delivery-card delivery-card--subscription">
          <div class="delivery-card__body">
            <span class="eyebrow delivery-card__eyebrow">${escapeHtml(tx('delivery.course_access', 'Course access'))}</span>
            <h3 class="delivery-card__name">Dev Journey — ${devJourneyTierLabel(tier)}</h3>
            <dl class="delivery-card__meta">
              <div><dt>${escapeHtml(tx('delivery.tier', 'Tier'))}</dt><dd>${devJourneyTierLabel(tier)}</dd></div>
              <div><dt>${escapeHtml(tx('delivery.delivery_label', 'Delivery'))}</dt><dd>${escapeHtml(tx('delivery.course_delivery', 'ZIP files are available in the student area'))}</dd></div>
            </dl>
          </div>
          <div class="delivery-card__actions">
            <a href="/dev-journey/student/" class="button button--gold delivery-card__cta">${escapeHtml(tx('delivery.open_student', 'Open student area'))}</a>
          </div>
        </article>`;
    }

    function buildSubscriptionCard(row) {
      const label = subscriptionLabel(row);
      const created = formatDate(row.created_at);
      const renews = formatDate(row.current_period_end);
      const status = titleCase(String(row.status || 'active'));

      return `
        <article class="panel delivery-card delivery-card--subscription">
          <div class="delivery-card__body">
            <span class="eyebrow delivery-card__eyebrow">${escapeHtml(tx('delivery.subscription', 'Subscription'))}</span>
            <h3 class="delivery-card__name">${label}</h3>
            <dl class="delivery-card__meta">
              ${created ? `<div><dt>${escapeHtml(tx('delivery.started', 'Started'))}</dt><dd>${created}</dd></div>` : ''}
              ${renews ? `<div><dt>${escapeHtml(tx('delivery.renews', 'Renews'))}</dt><dd>${renews}</dd></div>` : ''}
              ${status ? `<div><dt>${escapeHtml(tx('delivery.status_label', 'Status'))}</dt><dd>${status}</dd></div>` : ''}
            </dl>
          </div>
          <div class="delivery-card__actions">
            <a href="${subscriptionHref(row)}" class="button button--gold delivery-card__cta">${subscriptionCta(row)}</a>
          </div>
        </article>`;
    }

    function projectRecoveryKey(project) {
      const meta = parseMeta(project?.metadata);
      return firstValue(meta.source_kit, meta.preset_id, project?.slug, project?.id);
    }

    function projectRecoveryLabel(project) {
      const meta = parseMeta(project?.metadata);
      const sourceKit = normalizeProductId(meta.source_kit || '');
      if (sourceKit) return addonLabel(sourceKit);
      if (meta.preset_id) return addonLabel('kit-' + String(meta.preset_id));
      return project?.name || 'Builder draft';
    }

    function hasVisiblePurchaseForProject(project, items) {
      const meta = parseMeta(project?.metadata);
      const sourceKit = normalizeProductId(meta.source_kit || '');
      const projectSlug = String(project?.slug || '').trim();
      const sessionId = String(meta.stripe_session_id || '').trim();

      return (items || []).some((item) => {
        const itemMeta = parseMeta(item?.metadata);
        if (sessionId && purchaseSessionId(item) === sessionId) return true;
        if (sourceKit && purchaseLookupBase(item) === sourceKit) return true;
        if (projectSlug && String(itemMeta.project_slug || '').trim() === projectSlug) return true;
        return false;
      });
    }

    function buildProjectRecoveryCard(project) {
      const created = formatDate(project?.created_at);
      const label = projectRecoveryLabel(project);
      const projectId = String(project?.id || '').trim();
      const slug = String(project?.slug || '').trim();
      const projectRef = projectId || slug;
      const status = titleCase(String(project?.status || 'draft'));
      const href = projectRef
        ? '/builder/?project=' + encodeURIComponent(projectRef)
        : ROUTES.builder;

      return `
        <article class="panel delivery-card delivery-card--recovery">
          <div class="delivery-card__body">
            <span class="eyebrow delivery-card__eyebrow">${escapeHtml(tx('delivery.kit_recovery', 'Kit recovery'))}</span>
            <h3 class="delivery-card__name">${label}</h3>
            <dl class="delivery-card__meta">
              ${created ? `<div><dt>${escapeHtml(tx('delivery.prepared', 'Prepared'))}</dt><dd>${created}</dd></div>` : ''}
              ${slug ? `<div><dt>${escapeHtml(tx('delivery.draft', 'Draft'))}</dt><dd>${slug}</dd></div>` : ''}
              ${status ? `<div><dt>${escapeHtml(tx('delivery.status_label', 'Status'))}</dt><dd>${status}</dd></div>` : ''}
            </dl>
          </div>
          <div class="delivery-card__actions">
            <a href="${href}" class="button button--gold delivery-card__cta">${escapeHtml(tx('delivery.open_builder_draft', 'Open Builder draft'))}</a>
          </div>
        </article>`;
    }

    /** Derive a display name from addon_id.
     *  e.g. "kit-portfolio-personal" → "Portfolio Pro Kit — Personal"
     *       "kit-agency-launch"      → "Agency Launch Kit — Launch"
     *       "kit-saas-standard"      → "SaaS Landing System — Standard"
     *       "kit-landing-express"    → "Landing Express"
     */
    function addonLabel(addonId) {
      if (!addonId) return 'Unknown Product';
      const id = String(addonId).toLowerCase().replace(/_/g, '-');
      if (id.startsWith('kit-portfolio')) {
        const variant = id.replace('kit-portfolio-', '');
        return 'Portfolio Pro Kit' + (variant ? ' \u2014 ' + titleCase(variant) : '');
      }
      if (id.startsWith('kit-agency')) {
        const variant = id.replace('kit-agency-', '');
        return 'Agency Launch Kit' + (variant ? ' \u2014 ' + titleCase(variant) : '');
      }
      if (id.startsWith('kit-saas')) {
        const variant = id.replace('kit-saas-', '');
        return 'SaaS Landing System' + (variant ? ' \u2014 ' + titleCase(variant) : '');
      }
      if (id.startsWith('pf-')) {
        const variant = id.replace('pf-', '');
        if (variant === 'enterprise' || variant === 'white-label') {
          return 'PropertyFlow \u2014 White-Label';
        }
        return 'PropertyFlow' + (variant ? ' \u2014 ' + titleCase(variant) : '');
      }
      if (id.startsWith('icons-')) {
        return 'VOLYNX Icon Vault';
      }
      if (id.startsWith('tokens-')) {
        return 'VX Top-up \u2014 ' + tokenPackLabel(id);
      }
      if (id.startsWith('volynx-') || id.startsWith('builder-')) {
        return 'VOLYNX Builder \u2014 ' + titleCase(id.replace(/^volynx-/, '').replace(/^builder-/, ''));
      }
      if (id.startsWith('daily-')) {
        return 'VOLYNX Daily \u2014 ' + titleCase(id.replace(/^daily-/, ''));
      }
      if (id.startsWith('cvitae-')) {
        return 'CVitae \u2014 ' + titleCase(id.replace(/^cvitae-/, ''));
      }
      if (id.startsWith('bundle-')) {
        return 'VOLYNX Bundle \u2014 ' + titleCase(id.replace(/^bundle-/, ''));
      }
      if (id === 'studio-pro') {
        return 'Studio Pro';
      }
      if (id.startsWith('addon-')) {
        return 'Add-on \u2014 ' + titleCase(id.replace(/^addon-/, ''));
      }
      if (isCheckoutSmokeProductId(id)) {
        return 'VOLYNX Checkout Verification';
      }
      if (id === 'kit-landing-express' || id.startsWith('kit-landing')) {
        return 'Landing Express';
      }
      // Fallback: humanise the raw id
      return addonId.replace(/[_-]/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    }

    function titleCase(str) {
      return str.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    }

    /** Map addon_id to a Builder preset slug. */
    function addonToPreset(addonId) {
      if (!addonId) return null;
      const id = String(addonId).toLowerCase().replace(/_/g, '-');
      if (id.startsWith('kit-portfolio')) return 'portfolio';
      if (id.startsWith('kit-agency'))    return 'agency';
      if (id.startsWith('kit-saas'))      return 'saas';
      if (id === 'kit-landing-express' || id.startsWith('kit-landing')) return 'landing_express';
      return null;
    }

    function productHref(item) {
      const id = String(purchaseLookupBase(item) || '');
      if (!id) return ROUTES.profile;
      if (isTokenProductId(id)) return ROUTES.profile + '#vxSection';
      if (isSubscriptionProductId(id)) return ROUTES.profile;
      if (id.startsWith('addon-')) return supportHref(item, 'addon');
      // Kit purchases route to the dedicated kits dashboard so we keep one
      // delivery experience per product family. The dashboard surfaces tier,
      // license, and an Open-in-Builder CTA that already loads the preset.
      if (id.startsWith('kit-')) {
        const sessionId = purchaseSessionId(item);
        if (sessionId) {
          return withQuery(ROUTES.kitsDelivery, { session_id: sessionId });
        }
        return ROUTES.kitsDelivery;
      }
      const preset = addonToPreset(id);
      if (preset) return '/builder/?preset=' + encodeURIComponent(preset);
      if (id.startsWith('pf-')) {
        const sessionId = purchaseSessionId(item);
        const tier = propertyFlowTier(item);
        if (sessionId) {
          return withQuery(ROUTES.propertyflowDelivery, {
            session_id: sessionId,
            tier,
          });
        }
        return supportHref(item, 'propertyflow');
      }
      if (id.startsWith('icons-')) {
        const sessionId = purchaseSessionId(item);
        if (sessionId) {
          return withQuery(ROUTES.iconsDelivery, { session_id: sessionId });
        }
        return ROUTES.iconsDelivery;
      }
      if (isCheckoutSmokeProductId(id)) return ROUTES.products;
      return ROUTES.profile;
    }

    function productCta(item) {
      const id = String(purchaseLookupBase(item) || '');
      const sessionId = purchaseSessionId(item);
      if (isTokenProductId(id)) return 'View VX balance';
      if (isSubscriptionProductId(id)) return 'Open account';
      if (id.startsWith('kit-')) return sessionId ? 'Open kit delivery' : 'Recover kit delivery';
      if (id.startsWith('pf-')) return sessionId ? 'Open PropertyFlow delivery' : 'Recover PropertyFlow access';
      if (id.startsWith('icons-')) return sessionId ? 'Open icon delivery' : 'Open icon purchases';
      if (id.startsWith('addon-')) return 'Open support';
      if (isCheckoutSmokeProductId(id)) return 'Browse products';
      return 'Open account';
    }

    function formatDate(iso) {
      if (!iso) return '';
      try {
        return new Date(iso).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
      } catch { return iso; }
    }

    function formatPrice(amount, currency, minorUnits = false) {
      if (!amount && amount !== 0) return '';
      try {
        const num = typeof amount === 'number' ? amount : parseFloat(amount);
        const cur = (currency || 'USD').toUpperCase();
        return new Intl.NumberFormat(undefined, { style: 'currency', currency: cur })
          .format(minorUnits ? num / 100 : num);
      } catch { return String(amount); }
    }

    function buildCard(item) {
      const productId = String(purchaseLookupBase(item) || '');
      const label   = addonLabel(productId);
      const date    = formatDate(item.created_at);
      const amount  = item.price_paid ?? item.amount_paid ?? item.amount ?? item.price;
      const price   = formatPrice(amount, item.currency, item.price_paid == null);
      const builderHref = productHref(item);
      const cta = productCta(item);

      return `
        <article class="panel delivery-card">
          <div class="delivery-card__body">
            <span class="eyebrow delivery-card__eyebrow">${isCheckoutSmokeProductId(productId) ? 'Checkout verification' : 'Product'}</span>
            <h3 class="delivery-card__name">${label}</h3>
            <dl class="delivery-card__meta">
              ${date  ? `<div><dt>${escapeHtml(tx('delivery.purchased', 'Purchased'))}</dt><dd>${date}</dd></div>` : ''}
              ${price ? `<div><dt>${escapeHtml(tx('delivery.paid', 'Paid'))}</dt><dd>${price}</dd></div>` : ''}
            </dl>
          </div>
          <div class="delivery-card__actions">
            <a href="${builderHref}" class="button button--gold delivery-card__cta">${cta}</a>
          </div>
        </article>`;
    }

    // ── Main fetch logic ────────────────────────────────────────────────────
    (async () => {
      // Resolve user id from stored session
      let userId = null;
      try {
        const session = JSON.parse(localStorage.getItem('volynx_session') || '{}');
        userId = session?.user?.id || jwtSub(token);
      } catch {}
      userId = userId || jwtSub(token);

      if (!userId) {
        if (window.VxReturn) window.VxReturn.redirectToLogin();
        else window.location.href = '/login/?next=/delivery/';
        return;
      }

      // Load Supabase config
      let cfg = null;
      try { cfg = await fetch('/config.json', { cache: 'no-store' }).then(r => r.json()); } catch {}
      const supabaseUrl  = (cfg?.supabaseUrl  || '').replace(/\/$/, '');
      const anonKey      = cfg?.supabaseAnonKey || cfg?.anonKey || '';

      if (!supabaseUrl || !anonKey) {
        hide('deliveryLoading');
        document.getElementById('deliveryErrorMsg').textContent = 'Configuration error. Please contact support.';
        show('deliveryError');
        return;
      }

      const headers = {
        apikey: anonKey,
        Authorization: 'Bearer ' + token,
        'Content-Type': 'application/json',
      };

      const functionsUrl = (cfg?.functionsUrl || '').replace(/\/$/, '');

      try {
        const safeFetch = (url, options) => fetch(url, options).catch((error) => {
          console.warn('delivery source fetch failed', {
            url,
            error: error instanceof Error ? error.message : String(error),
          });
          return null;
        });

        // Aggregate every revenue-bearing family we can recover from the
        // platform: one-time products, payment events, subscriptions and kit
        // Builder drafts that may exist even when the addon row is missing.
        const [purchasedRes, eventsRes, subscriptionsRes, projectsRes, devJourneyRes] = await Promise.all([
          safeFetch(`${supabaseUrl}/rest/v1/addons_purchased?select=id,addon_id,price_paid,currency,status,metadata,created_at&user_id=eq.${userId}&order=created_at.desc`, { headers }),
          safeFetch(`${supabaseUrl}/rest/v1/purchase_events?select=id,lookup_key,product_key,amount_paid,currency,status,metadata,created_at,stripe_session_id&user_id=eq.${userId}&status=eq.completed&order=created_at.desc`, { headers }),
          safeFetch(`${supabaseUrl}/rest/v1/subscriptions?select=id,product_key,plan_key,lookup_key,status,current_period_end,cancel_at_period_end,created_at&user_id=eq.${userId}&order=created_at.desc`, { headers }),
          safeFetch(`${supabaseUrl}/rest/v1/projects?select=id,name,slug,status,created_at,metadata&user_id=eq.${userId}&order=created_at.desc`, { headers }),
          functionsUrl
            ? safeFetch(`${functionsUrl}/devjourney-progress`, {
                method: 'POST',
                headers: {
                  Authorization: 'Bearer ' + token,
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({ action: 'get' }),
              })
            : Promise.resolve(null),
        ]);

        let purchased = [];
        let events = [];
        let subscriptions = [];
        let projects = [];
        let devJourneyProgress = null;

        if (purchasedRes.ok) {
          try { purchased = await purchasedRes.json(); } catch {}
        }
        if (eventsRes.ok) {
          try { events = await eventsRes.json(); } catch {}
        }
        if (subscriptionsRes.ok) {
          try { subscriptions = await subscriptionsRes.json(); } catch {}
        }
        if (projectsRes.ok) {
          try { projects = await projectsRes.json(); } catch {}
        }
        if (devJourneyRes && devJourneyRes.ok) {
          try { devJourneyProgress = await devJourneyRes.json(); } catch {}
        }

        // Preserve one card per purchased row. `addons_purchased` is the source
        // of truth for what the user owns; `purchase_events` only enriches an
        // existing purchase or backfills when no purchased row exists yet.
        const items = purchased.map((row) => mergePurchaseRecords(row, {}));

        const upsertEvent = (row) => {
          const productId = purchaseLookupBase(row);
          const sessionId = purchaseSessionId(row);

          if (!productId && !sessionId) return;

          try {
            const existingIndex = items.findIndex((entry) => sameProductPurchase(entry, row));
            if (existingIndex === -1) {
              items.push(mergePurchaseRecords(row, {}));
              return;
            }
            items[existingIndex] = mergePurchaseRecords(items[existingIndex], row);
          } catch (err) {
            console.error('delivery merge failed', {
              row,
              error: err instanceof Error ? err.message : String(err),
            });
          }
        };

        for (const row of events) {
          if (!shouldShowEventFallback(row)) continue;
          upsertEvent(row);
        }

        items.sort((a, b) => {
          return timestampFor(b?.created_at) - timestampFor(a?.created_at);
        });

        hide('deliveryLoading');

        const cardEntries = [];

        for (const item of items) {
          const html = safeBuildCard(item);
          if (!html) continue;
          cardEntries.push({
            sortAt: timestampFor(item?.created_at),
            html,
          });
        }

        for (const row of (Array.isArray(subscriptions) ? subscriptions : [])) {
          try {
            cardEntries.push({
              sortAt: timestampFor(row?.created_at || row?.current_period_end),
              html: buildSubscriptionCard(row),
            });
          } catch (err) {
            console.error('delivery subscription render failed', {
              row,
              error: err instanceof Error ? err.message : String(err),
            });
          }
        }

        const recoveryProjects = (Array.isArray(projects) ? projects : []).filter((project) => {
          const key = projectRecoveryKey(project);
          if (!key) return false;
          if (!String(project?.slug || '').trim()) return false;
          return !hasVisiblePurchaseForProject(project, items);
        });

        for (const project of recoveryProjects) {
          try {
            cardEntries.push({
              sortAt: timestampFor(project?.created_at),
              html: buildProjectRecoveryCard(project),
            });
          } catch (err) {
            console.error('delivery project recovery render failed', {
              project,
              error: err instanceof Error ? err.message : String(err),
            });
          }
        }

        if (devJourneyProgress) {
          const html = buildDevJourneyCard(devJourneyProgress);
          if (html) {
            cardEntries.push({
              sortAt: 0,
              html,
            });
          }
        }

        if (cardEntries.length === 0) {
          show('deliveryEmpty');
          return;
        }

        const grid = document.getElementById('deliveryGrid');
        const cards = cardEntries
          .sort((a, b) => b.sortAt - a.sortAt)
          .map((entry) => entry.html)
          .filter(Boolean);

        grid.innerHTML = cards.join('');
        grid.style.display = '';

      } catch (err) {
        console.error('delivery page load failed', err);
        hide('deliveryLoading');
        document.getElementById('deliveryErrorMsg').textContent = 'Failed to load purchases. Please refresh and try again.';
        show('deliveryError');
      }
    })();
  </script>
</FlagshipLayout>

