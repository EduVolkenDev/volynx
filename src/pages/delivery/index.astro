---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import DeliveryTrustStrip from "../../components/DeliveryTrustStrip.astro";
import PlatformAssistStrip from "../../components/PlatformAssistStrip.astro";
import { ROUTES } from "../../data/routes";

const deliveryAssistItems = [
  { href: ROUTES.support, label: "Help", title: "Open support", copy: "Keep the checkout email and product name attached if recovery needs a human lane.", emphasized: true },
  { href: ROUTES.products, label: "Catalog", title: "Browse products", copy: "Go back to the catalog if you need to compare what was purchased or what comes next." },
  { href: ROUTES.pricing, label: "Plans", title: "Check pricing", copy: "Review access, bundles and token logic while the purchase context is still fresh." },
  { href: ROUTES.daily, label: "Workspace", title: "Open Daily", copy: "Return to the daily workspace and keep the ecosystem connected beyond delivery." },
];
---
<FlagshipLayout title="My Products — VOLYNX" description="Access your purchased kits and products. Open them directly in Builder." pageClass="page-delivery">
  <FlagshipHeader ctaLabel="Open Builder" ctaHref="/builder/" />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero delivery-hero">
      <div class="shell">
        <nav class="delivery-breadcrumbs" aria-label="Breadcrumb">
          <a href={ROUTES.home}>Home</a>
          <span>/</span>
          <a href={ROUTES.products}>Products</a>
          <span>/</span>
          <span>My Products</span>
        </nav>

        <div class="hero-grid">
          <div class="hero-copy">
            <span class="eyebrow">Your purchases</span>
            <h1>Downloads, access and recovery.</h1>
            <p>Every kit and product you've unlocked - ready to open, recover or route into support without losing context.</p>
            <div class="hero-actions">
              <a href={ROUTES.support} class="button button--gold">Open support</a>
              <a href={ROUTES.products} class="button button--ghost">Browse products</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <PlatformAssistStrip
      eyebrow="Delivery flow"
      title="Recovered purchases should never feel like a dead end."
      description="Use this layer to move from purchase, back into the right product or the right support lane."
      items={deliveryAssistItems}
    />

    <!-- ═══ PURCHASES ═══ -->
    <section class="page-section">
      <div class="shell">

        <!-- Loading state -->
        <div id="deliveryLoading" class="delivery-state">
          <div class="delivery-spinner" aria-hidden="true"></div>
          <p class="delivery-state__label">Loading your purchases...</p>
        </div>

        <!-- Error state -->
        <div id="deliveryError" class="delivery-state" style="display:none;">
          <p class="delivery-state__label delivery-state__label--error" id="deliveryErrorMsg">Something went wrong. Please try again.</p>
          <div class="delivery-state__actions">
            <a href={ROUTES.login + "?next=/delivery/"} class="button button--ghost">Sign in again</a>
            <a href={ROUTES.support} class="button button--ghost">Open support</a>
          </div>
        </div>

        <!-- Empty state -->
        <div id="deliveryEmpty" class="delivery-state" style="display:none;">
          <p class="delivery-state__label">No purchases yet.</p>
          <a href={ROUTES.products} class="button button--gold">Browse products</a>
        </div>

        <!-- Product grid -->
        <div id="deliveryGrid" class="delivery-grid" style="display:none;" aria-live="polite"></div>

      </div>
    </section>

    <section class="page-section page-section--tight">
      <div class="shell">
        <DeliveryTrustStrip productName="VOLYNX delivery" />
      </div>
    </section>

    <section class="page-section">
      <div class="shell delivery-help panel">
        <div>
          <span class="eyebrow">Recovery path</span>
          <strong>Missing download, billing question or launch issue?</strong>
          <p>Open support with the same checkout email and product name so recovery keeps the right context.</p>
        </div>
        <div class="hero-actions">
          <a href={ROUTES.support} class="button button--ghost">Open support</a>
          <a href={ROUTES.contact} class="button button--ghost">Contact sales</a>
        </div>
      </div>
    </section>

    <!-- ═══ CTA ═══ -->
    <section class="page-section page-section--last">
      <div class="shell callout panel panel--pro">
        <div>
          <span class="eyebrow">Keep building</span>
          <strong>Open Builder and start with any of your kits.</strong>
          <p>Presets are loaded automatically when you follow the link from each product card.</p>
        </div>
        <div class="hero-actions">
          <a href="/builder/" class="button button--gold">Open Builder</a>
          <a href={ROUTES.products} class="button button--ghost">Browse more products</a>
        </div>
      </div>
    </section>

  </main>
  <FlagshipFooter />

  <script is:inline type="module">
    // ── Auth guard ──────────────────────────────────────────────────────────
    const token = localStorage.getItem('volynx_access_token');
    if (!token) {
      window.location.href = '/login/?next=/delivery/';
    }

    // ── Helpers ─────────────────────────────────────────────────────────────
    function show(id) { const el = document.getElementById(id); if (el) el.style.display = ''; }
    function hide(id) { const el = document.getElementById(id); if (el) el.style.display = 'none'; }

    function normalizeProductId(raw) {
      const normalized = String(raw || '')
        .trim()
        .toLowerCase()
        .replace(/_(gbp|eur|brl)$/i, '')
        .replace(/-(gbp|eur|brl)$/i, '')
        .replace(/_/g, '-');

      if (normalized === 'pf-enterprise') return 'pf-white-label';
      return normalized;
    }

    function parseMeta(value) {
      if (!value) return {};
      if (typeof value === 'string') {
        try { return JSON.parse(value); } catch { return {}; }
      }
      return typeof value === 'object' ? value : {};
    }

    function stripCurrencySuffix(value) {
      return String(value || '')
        .trim()
        .replace(/_(gbp|eur|brl)$/i, '')
        .replace(/-(gbp|eur|brl)$/i, '');
    }

    function hasValue(value) {
      if (value == null) return false;
      if (typeof value === 'string') return value.trim() !== '';
      return true;
    }

    function firstValue(...values) {
      for (const value of values) {
        if (hasValue(value)) return value;
      }
      return null;
    }

    function purchaseLookupBase(item) {
      const meta = parseMeta(item?.metadata);
      return normalizeProductId(
        stripCurrencySuffix(
          meta.lookup_key ||
          meta.stripe_lookup_key ||
          item?.lookup_key ||
          item?.addon_id ||
          item?.product_id ||
          ''
        )
      );
    }

    function purchaseSessionId(item) {
      const meta = parseMeta(item?.metadata);
      return String(meta.stripe_session_id || item?.stripe_session_id || '').trim();
    }

    function purchaseAliases(item) {
      const aliases = new Set();
      const sessionId = purchaseSessionId(item);
      const lookupBase = purchaseLookupBase(item);
      const rawId = String(item?.id || '').trim();

      if (sessionId) aliases.add(`session:${sessionId}`);
      if (lookupBase) aliases.add(`product:${lookupBase}`);
      if (rawId) aliases.add(`id:${rawId}`);

      return aliases;
    }

    function sharesPurchaseAlias(a, b) {
      const aAliases = purchaseAliases(a);
      if (!aAliases.size) return false;
      for (const alias of purchaseAliases(b)) {
        if (aAliases.has(alias)) return true;
      }
      return false;
    }

    function mergedMetadata(baseItem, incomingItem) {
      return {
        ...parseMeta(incomingItem?.metadata),
        ...parseMeta(baseItem?.metadata),
      };
    }

    function mergedPricePaid(baseItem, incomingItem) {
      const basePrice = baseItem?.price_paid;
      const incomingPrice = incomingItem?.price_paid;
      const incomingAmountPaid = incomingItem?.amount_paid;

      if (hasValue(basePrice)) return basePrice;
      if (hasValue(incomingPrice)) return incomingPrice;
      if (typeof incomingAmountPaid === 'number') return incomingAmountPaid / 100;
      return null;
    }

    function mergePurchaseRecords(baseItem, incomingItem) {
      const metadata = mergedMetadata(baseItem, incomingItem);
      const merged = {
        ...incomingItem,
        ...baseItem,
        id: firstValue(baseItem?.id, incomingItem?.id),
        addon_id: firstValue(
          baseItem?.addon_id,
          incomingItem?.addon_id,
          metadata.lookup_key,
          metadata.stripe_lookup_key,
          incomingItem?.lookup_key,
          baseItem?.lookup_key
        ),
        product_id: firstValue(baseItem?.product_id, incomingItem?.product_id),
        lookup_key: firstValue(
          baseItem?.lookup_key,
          incomingItem?.lookup_key,
          metadata.lookup_key,
          metadata.stripe_lookup_key
        ),
        stripe_session_id: firstValue(
          purchaseSessionId(baseItem),
          purchaseSessionId(incomingItem),
          metadata.stripe_session_id
        ),
        price_paid: mergedPricePaid(baseItem, incomingItem),
        amount_paid: firstValue(incomingItem?.amount_paid, baseItem?.amount_paid),
        amount: firstValue(baseItem?.amount, incomingItem?.amount),
        price: firstValue(baseItem?.price, incomingItem?.price),
        currency: firstValue(baseItem?.currency, incomingItem?.currency),
        status: firstValue(baseItem?.status, incomingItem?.status),
        created_at: firstValue(baseItem?.created_at, incomingItem?.created_at),
        metadata,
      };

      return merged;
    }

    function withQuery(path, params) {
      const search = new URLSearchParams();
      Object.entries(params || {}).forEach(([key, value]) => {
        if (value) search.set(key, String(value));
      });
      const query = search.toString();
      return query ? `${path}?${query}` : path;
    }

    function propertyFlowTier(item) {
      const base = purchaseLookupBase(item);
      if (base.includes('white-label') || base.includes('enterprise')) return 'white-label';
      if (base.includes('professional')) return 'professional';
      if (base.includes('starter')) return 'starter';
      return '';
    }

    function supportHref(item, product) {
      return withQuery(ROUTES.support, {
        intent: 'delivery',
        product,
        purchase: firstValue(item?.id, purchaseLookupBase(item), item?.addon_id),
        session_id: purchaseSessionId(item),
        lookup_key: firstValue(item?.lookup_key, parseMeta(item?.metadata).lookup_key),
      });
    }

    function jwtSub(jwt) {
      try {
        const part = String(jwt || '').split('.')[1];
        if (!part) return null;
        const normalized = part.replace(/-/g, '+').replace(/_/g, '/');
        const payload = JSON.parse(atob(normalized.padEnd(normalized.length + (4 - normalized.length % 4) % 4, '=')));
        return payload?.sub || null;
      } catch {
        return null;
      }
    }

    /** Derive a display name from addon_id.
     *  e.g. "kit-portfolio-personal" → "Portfolio Pro Kit — Personal"
     *       "kit-agency-launch"      → "Agency Launch Kit — Launch"
     *       "kit-saas-standard"      → "SaaS Landing System — Standard"
     *       "kit-landing-express"    → "Landing Express"
     */
    function addonLabel(addonId) {
      if (!addonId) return 'Unknown Product';
      const id = addonId.toLowerCase().replace(/_/g, '-');
      if (id.startsWith('kit-portfolio')) {
        const variant = id.replace('kit-portfolio-', '');
        return 'Portfolio Pro Kit' + (variant ? ' \u2014 ' + titleCase(variant) : '');
      }
      if (id.startsWith('kit-agency')) {
        const variant = id.replace('kit-agency-', '');
        return 'Agency Launch Kit' + (variant ? ' \u2014 ' + titleCase(variant) : '');
      }
      if (id.startsWith('kit-saas')) {
        const variant = id.replace('kit-saas-', '');
        return 'SaaS Landing System' + (variant ? ' \u2014 ' + titleCase(variant) : '');
      }
      if (id.startsWith('pf-')) {
        const variant = id.replace('pf-', '');
        if (variant === 'enterprise' || variant === 'white-label') {
          return 'PropertyFlow \u2014 White-Label';
        }
        return 'PropertyFlow' + (variant ? ' \u2014 ' + titleCase(variant) : '');
      }
      if (id.startsWith('icons-')) {
        return 'VOLYNX Icon Vault';
      }
      if (id === 'kit-landing-express' || id.startsWith('kit-landing')) {
        return 'Landing Express';
      }
      // Fallback: humanise the raw id
      return addonId.replace(/[_-]/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    }

    function titleCase(str) {
      return str.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    }

    /** Map addon_id to a Builder preset slug. */
    function addonToPreset(addonId) {
      if (!addonId) return null;
      const id = addonId.toLowerCase().replace(/_/g, '-');
      if (id.startsWith('kit-portfolio')) return 'portfolio';
      if (id.startsWith('kit-agency'))    return 'agency';
      if (id.startsWith('kit-saas'))      return 'saas';
      if (id === 'kit-landing-express' || id.startsWith('kit-landing')) return 'landing_express';
      return null;
    }

    function productHref(item) {
      const id = purchaseLookupBase(item);
      if (!id) return '/builder/';
      const preset = addonToPreset(id);
      if (preset) return '/builder/?preset=' + encodeURIComponent(preset);
      if (id.startsWith('pf-')) {
        const sessionId = purchaseSessionId(item);
        const tier = propertyFlowTier(item);
        if (sessionId) {
          return withQuery(ROUTES.propertyflowDelivery, {
            session_id: sessionId,
            tier,
          });
        }
        return supportHref(item, 'propertyflow');
      }
      if (id.startsWith('icons-')) {
        const sessionId = purchaseSessionId(item);
        if (sessionId) {
          return withQuery(ROUTES.iconsDelivery, { session_id: sessionId });
        }
        return '/profile/#iconPurchasesSection';
      }
      return '/builder/';
    }

    function productCta(item) {
      const id = purchaseLookupBase(item);
      const sessionId = purchaseSessionId(item);
      if (id.startsWith('pf-')) return sessionId ? 'Open PropertyFlow delivery' : 'Recover PropertyFlow access';
      if (id.startsWith('icons-')) return sessionId ? 'Open icon delivery' : 'Open icon purchases';
      return 'Open in Builder';
    }

    function formatDate(iso) {
      if (!iso) return '';
      try {
        return new Date(iso).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
      } catch { return iso; }
    }

    function formatPrice(amount, currency, minorUnits = false) {
      if (!amount && amount !== 0) return '';
      try {
        const num = typeof amount === 'number' ? amount : parseFloat(amount);
        const cur = (currency || 'USD').toUpperCase();
        return new Intl.NumberFormat(undefined, { style: 'currency', currency: cur })
          .format(minorUnits ? num / 100 : num);
      } catch { return String(amount); }
    }

    function buildCard(item) {
      const productId = purchaseLookupBase(item);
      const label   = addonLabel(productId);
      const date    = formatDate(item.created_at);
      const amount  = item.price_paid ?? item.amount_paid ?? item.amount ?? item.price;
      const price   = formatPrice(amount, item.currency, item.price_paid == null);
      const builderHref = productHref(item);
      const cta = productCta(item);

      return `
        <article class="panel delivery-card">
          <div class="delivery-card__body">
            <span class="eyebrow delivery-card__eyebrow">Product</span>
            <h3 class="delivery-card__name">${label}</h3>
            <dl class="delivery-card__meta">
              ${date  ? `<div><dt>Purchased</dt><dd>${date}</dd></div>` : ''}
              ${price ? `<div><dt>Paid</dt><dd>${price}</dd></div>` : ''}
            </dl>
          </div>
          <div class="delivery-card__actions">
            <a href="${builderHref}" class="button button--gold delivery-card__cta">${cta}</a>
          </div>
        </article>`;
    }

    // ── Main fetch logic ────────────────────────────────────────────────────
    (async () => {
      // Resolve user id from stored session
      let userId = null;
      try {
        const session = JSON.parse(localStorage.getItem('volynx_session') || '{}');
        userId = session?.user?.id || jwtSub(token);
      } catch {}
      userId = userId || jwtSub(token);

      if (!userId) {
        window.location.href = '/login/?next=/delivery/';
        return;
      }

      // Load Supabase config
      let cfg = null;
      try { cfg = await fetch('/config.json', { cache: 'no-store' }).then(r => r.json()); } catch {}
      const supabaseUrl  = (cfg?.supabaseUrl  || '').replace(/\/$/, '');
      const anonKey      = cfg?.supabaseAnonKey || cfg?.anonKey || '';

      if (!supabaseUrl || !anonKey) {
        hide('deliveryLoading');
        document.getElementById('deliveryErrorMsg').textContent = 'Configuration error. Please contact support.';
        show('deliveryError');
        return;
      }

      const headers = {
        apikey: anonKey,
        Authorization: 'Bearer ' + token,
        'Content-Type': 'application/json',
      };

      try {
        // Fetch both tables in parallel
        const [purchasedRes, eventsRes] = await Promise.all([
          fetch(`${supabaseUrl}/rest/v1/addons_purchased?select=*&user_id=eq.${userId}&order=created_at.desc`, { headers }),
          fetch(`${supabaseUrl}/rest/v1/purchase_events?select=*&user_id=eq.${userId}&status=eq.completed&order=created_at.desc`, { headers }),
        ]);

        let purchased = [];
        let events = [];

        if (purchasedRes.ok) {
          try { purchased = await purchasedRes.json(); } catch {}
        }
        if (eventsRes.ok) {
          try { events = await eventsRes.json(); } catch {}
        }

        // Merge addons + events into a single card per product while preserving
        // the best delivery context (especially Stripe session IDs from events).
        const items = [];
        const upsertItem = (row) => {
          const existingIndex = items.findIndex((entry) => sharesPurchaseAlias(entry, row));
          if (existingIndex === -1) {
            items.push(mergePurchaseRecords(row, {}));
            return;
          }
          items[existingIndex] = mergePurchaseRecords(items[existingIndex], row);
        };

        for (const row of purchased) {
          upsertItem(row);
        }
        for (const row of events) {
          upsertItem(row);
        }

        items.sort((a, b) => {
          const aTime = new Date(a?.created_at || 0).getTime();
          const bTime = new Date(b?.created_at || 0).getTime();
          return bTime - aTime;
        });

        hide('deliveryLoading');

        if (items.length === 0) {
          show('deliveryEmpty');
          return;
        }

        const grid = document.getElementById('deliveryGrid');
        grid.innerHTML = items.map(buildCard).join('');
        grid.style.display = '';

      } catch (err) {
        hide('deliveryLoading');
        document.getElementById('deliveryErrorMsg').textContent = 'Failed to load purchases. Please refresh and try again.';
        show('deliveryError');
      }
    })();
  </script>
</FlagshipLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────────── */
  .delivery-hero { padding-top: clamp(28px, 5vw, 52px); }
  .delivery-hero .hero-copy h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  .delivery-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    font-size: .82rem;
    color: rgba(255,255,255,.5);
  }
  .delivery-breadcrumbs a {
    color: rgba(255,255,255,.7);
    text-decoration: none;
    transition: color .15s;
  }
  .delivery-breadcrumbs a:hover { color: #fff; }

  /* ── Loading / states ────────────────────────────────────────────────────── */
  .delivery-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: clamp(40px, 8vw, 80px) 0;
    text-align: center;
  }
  .delivery-state__label {
    color: rgba(255, 255, 255, .55);
    font-size: .95rem;
    margin: 0;
  }
  .delivery-state__label--error { color: rgba(255, 120, 120, .85); }
  .delivery-state__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .delivery-spinner {
    width: 32px;
    height: 32px;
    border: 2px solid rgba(255, 255, 255, .12);
    border-top-color: rgba(139, 250, 240, .7);
    border-radius: 50%;
    animation: spin 700ms linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Product grid ────────────────────────────────────────────────────────── */
  .delivery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }

  /* ── Product card ────────────────────────────────────────────────────────── */
  .delivery-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
  }
  .delivery-card__body { flex: 1; }
  .delivery-card__eyebrow { display: block; margin-bottom: 8px; }
  .delivery-card__name {
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    font-weight: 700;
    color: rgba(255, 255, 255, .95);
    margin: 0 0 14px;
    line-height: 1.3;
  }

  .delivery-card__meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
  }
  .delivery-card__meta > div {
    display: flex;
    gap: 8px;
    align-items: baseline;
    font-size: .82rem;
  }
  .delivery-card__meta dt {
    color: rgba(255, 255, 255, .35);
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    font-size: .7rem;
    min-width: 60px;
  }
  .delivery-card__meta dd {
    color: rgba(255, 255, 255, .7);
    margin: 0;
  }

  .delivery-card__actions { margin-top: auto; }
  .delivery-card__cta { width: 100%; justify-content: center; text-align: center; }
  .page-section--tight { padding-top: 0; }
  .delivery-help {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .delivery-help strong {
    display: block;
    margin: 6px 0 10px;
    font-size: 1.05rem;
    line-height: 1.45;
  }
  .delivery-help p {
    margin: 0;
    color: rgba(255,255,255,.65);
    line-height: 1.7;
  }
  @media (max-width: 860px) {
    .delivery-help { flex-direction: column; align-items: flex-start; }
  }
</style>
