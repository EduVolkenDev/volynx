---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../components/FlagshipHeader.astro";
import FlagshipFooter from "../components/FlagshipFooter.astro";
import PlatformAssistStrip from "../components/PlatformAssistStrip.astro";
import { ROUTES } from "../data/routes";
const title = "Support — VOLYNX";

const supportAssistItems = [
  { href: ROUTES.delivery, label: { en: "Recovery", pt: "Recuperação" }, title: { en: "Open my products", pt: "Abrir meus produtos" }, copy: { en: "Use the delivery hub when a purchase already happened and you need the right file or access again.", pt: "Use o hub de entrega quando uma compra já aconteceu e você precisa do arquivo certo ou acesso de novo." }, emphasized: true },
  { href: ROUTES.daily, label: { en: "Workspace", pt: "Workspace" }, title: { en: "Open Daily", pt: "Abrir Daily" }, copy: { en: "Jump back into My Day, Summary, Writing, Vault and the rest of the personal execution layer.", pt: "Volte para My Day, Summary, Writing, Vault e o resto da camada de execução pessoal." } },
  { href: ROUTES.products, label: { en: "Catalog", pt: "Catálogo" }, title: { en: "Browse products", pt: "Ver produtos" }, copy: { en: "If you need the product path instead of support, keep discovery and recovery in the same loop.", pt: "Se você precisa do caminho de produto em vez de suporte, mantenha descoberta e recuperação no mesmo loop." } },
  { href: ROUTES.iconsStore, label: { en: "Assets", pt: "Ativos" }, title: { en: "Open Icons Store", pt: "Abrir Icons Store" }, copy: { en: "Route icon delivery, pack access and visual asset issues from the same recovery entry point.", pt: "Direcione entrega de ícones, acesso a packs e questões de ativos visuais pela mesma entrada de recuperação." } },
];
---

<FlagshipLayout title={title} description="Fast recovery for purchases, delivery, product access and launch issues across VOLYNX." pageClass="page-support">
  <FlagshipHeader ctaHref={ROUTES.delivery} ctaLabel="My products" ctaI18n="header.my_products" />

  <main class="shell support-page">
    <section class="hero">
      <div class="hero-grid support-hero-grid">
        <div class="support-hero-copy">
          <div class="kicker"><span class="i18n-en">Support</span><span class="i18n-pt">Suporte</span></div>
          <h1><span class="i18n-en">Fast recovery for purchases, delivery and access.</span><span class="i18n-pt">Recuperação rápida de compras, entregas e acessos.</span></h1>
          <p class="sub"><span class="i18n-en">Use Support for delivery, billing, product access and launch issues. Use Contact for new projects, partnerships and sales conversations.</span><span class="i18n-pt">Use o Suporte para entrega, cobrança, acesso a produtos e problemas de lançamento. Use Contato para novos projetos, parcerias e conversas comerciais.</span></p>
          <div class="hero-actions">
            <a class="hero-btn hero-btn--primary" href={ROUTES.delivery}><span class="i18n-en">Open my products</span><span class="i18n-pt">Abrir meus produtos</span></a>
            <a class="hero-btn" id="supportMailto" href={ROUTES.email}><span class="i18n-en">Email support</span><span class="i18n-pt">Falar por e-mail</span></a>
          </div>
          <div id="supportContext" class="support-context" hidden></div>
        </div>
        <div class="hero-visual hero-visual--float support-hero-visual" aria-hidden="true">
          <img src="/assets/support.webp" alt="" class="hero-float-icon support-hero-icon" width="1380" height="1580" loading="eager" />
        </div>
      </div>
    </section>

    <PlatformAssistStrip
      eyebrow={{ en: "Support flow", pt: "Fluxo de suporte" }}
      title={{ en: "Keep the recovery lane connected.", pt: "Mantenha a faixa de recuperação conectada." }}
      description={{ en: "The support surface should always lead back to the exact place where context matters most.", pt: "A superfície de suporte deve sempre levar de volta ao lugar exato onde o contexto importa mais." }}
      items={supportAssistItems}
    />

    <section class="support-paths" aria-label="Support shortcuts" data-i18n-aria="aria.support_shortcuts">
      <a class="path-card" href={ROUTES.delivery}>
        <div class="path-card__eyebrow"><span class="i18n-en">Delivery hub</span><span class="i18n-pt">Central de entregas</span></div>
        <h2><span class="i18n-en">Find a purchase</span><span class="i18n-pt">Encontrar uma compra</span></h2>
        <p><span class="i18n-en">Return to products, verify what unlocked, and recover delivery after checkout.</span><span class="i18n-pt">Volte para os produtos, confira o que foi desbloqueado e recupere a entrega após o checkout.</span></p>
      </a>
      <a class="path-card" href={ROUTES.daily}>
        <div class="path-card__eyebrow">VOLYNX Daily</div>
        <h2><span class="i18n-en">Open Daily</span><span class="i18n-pt">Abrir o Daily</span></h2>
        <p><span class="i18n-en">Jump back into My Day, Summary, Writing, Vault and the rest of the workspace.</span><span class="i18n-pt">Volte ao My Day, Summary, Writing, Vault e ao restante do seu workspace.</span></p>
      </a>
      <a class="path-card" href={ROUTES.propertyflow}>
        <div class="path-card__eyebrow">PropertyFlow</div>
        <h2><span class="i18n-en">Review product access</span><span class="i18n-pt">Revisar acesso ao produto</span></h2>
        <p><span class="i18n-en">Check the live product page, pricing, launch notes and the right support context.</span><span class="i18n-pt">Confira a página do produto no ar, preço, notas de lançamento e o contexto certo de suporte.</span></p>
      </a>
      <a class="path-card" href={ROUTES.iconsStore}>
        <div class="path-card__eyebrow">Icons Store</div>
        <h2><span class="i18n-en">Recover icon delivery</span><span class="i18n-pt">Recuperar entrega de ícones</span></h2>
        <p><span class="i18n-en">Return to the store, match the pack name and route icon delivery issues fast.</span><span class="i18n-pt">Volte à loja, identifique o pack pelo nome e resolva problemas de entrega rapidamente.</span></p>
      </a>
      <a class="path-card" href={ROUTES.products}>
        <div class="path-card__eyebrow"><span class="i18n-en">Platform</span><span class="i18n-pt">Plataforma</span></div>
        <h2><span class="i18n-en">Browse products</span><span class="i18n-pt">Ver produtos</span></h2>
        <p><span class="i18n-en">Move across the ecosystem without losing the path back to support or delivery.</span><span class="i18n-pt">Circule pelo ecossistema sem perder o caminho de volta para suporte ou entrega.</span></p>
      </a>
      <a class="path-card" href={ROUTES.contact}>
        <div class="path-card__eyebrow"><span class="i18n-en">Contact &amp; sales</span><span class="i18n-pt">Contato e vendas</span></div>
        <h2><span class="i18n-en">Start a project</span><span class="i18n-pt">Iniciar um projeto</span></h2>
        <p><span class="i18n-en">New build, partnership or commercial question? Use the sales lane instead of support.</span><span class="i18n-pt">Novo projeto, parceria ou pergunta comercial? Use o canal de vendas em vez do suporte.</span></p>
      </a>
    </section>

    <section class="support-grid">
      <article class="panel">
        <div class="panel-label"><span class="i18n-en">What to include</span><span class="i18n-pt">O que incluir</span></div>
        <h2><span class="i18n-en">Make recovery fast</span><span class="i18n-pt">Acelere a recuperação</span></h2>
        <ul class="checklist">
          <li><span class="i18n-en">Order email</span><span class="i18n-pt">E-mail da compra</span></li>
          <li><span class="i18n-en">Product or tier name</span><span class="i18n-pt">Nome do produto ou tier</span></li>
          <li><span class="i18n-en">Purchase ID or Stripe session ID if you have it</span><span class="i18n-pt">ID da compra ou Stripe session ID, se tiver</span></li>
          <li><span class="i18n-en">Short issue summary</span><span class="i18n-pt">Descrição curta do problema</span></li>
        </ul>
      </article>

      <article class="panel">
        <div class="panel-label"><span class="i18n-en">Best next step</span><span class="i18n-pt">Próximo passo</span></div>
        <h2><span class="i18n-en">Use the right lane</span><span class="i18n-pt">Use o caminho certo</span></h2>
        <p class="panel-copy"><span class="i18n-en">If you just checked out, open My Products first. If access or delivery still looks wrong, use the prefilled support email from this page so the context stays attached.</span><span class="i18n-pt">Acabou de fazer checkout? Abra Meus Produtos primeiro. Se o acesso ou a entrega ainda parecerem errados, use o e-mail de suporte pré-preenchido nesta página para que o contexto chegue junto.</span></p>
        <div class="panel-actions">
          <a class="panel-link" href={ROUTES.delivery}><span class="i18n-en">Open delivery</span><span class="i18n-pt">Abrir entrega</span></a>
          <a class="panel-link" href={ROUTES.contact}><span class="i18n-en">Contact sales</span><span class="i18n-pt">Falar com vendas</span></a>
          <a class="panel-link" href={ROUTES.products}><span class="i18n-en">Browse products</span><span class="i18n-pt">Ver produtos</span></a>
        </div>
      </article>
    </section>
  </main>

  <FlagshipFooter />
</FlagshipLayout>

<style>
  .support-page { padding-bottom: 80px; }

  .hero {
    padding: 56px 0 30px;
  }
  .support-hero-grid {
    align-items: center;
    gap: clamp(24px, 4vw, 52px);
  }
  .support-hero-copy {
    max-width: 760px;
  }
  .kicker {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.5;
    margin-bottom: 14px;
  }
  .hero h1 {
    font-size: clamp(30px, 5vw, 54px);
    font-weight: 800;
    line-height: 1.08;
    margin-bottom: 16px;
  }
  .sub {
    opacity: 0.76;
    font-size: 17px;
    line-height: 1.7;
    margin: 0;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }
  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 18px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,.1);
    text-decoration: none;
    color: rgba(255,255,255,.84);
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s;
  }
  .hero-btn:hover {
    color: #fff;
    border-color: rgba(255,255,255,.2);
  }
  .hero-btn--primary {
    background: rgba(79,195,247,.12);
    border-color: rgba(79,195,247,.3);
    color: #4fc3f7;
  }
  .support-hero-visual {
    display: none;
    min-height: clamp(280px, 28vw, 440px);
    justify-items: end;
    overflow: visible;
    pointer-events: none;
  }
  .support-hero-icon {
    width: min(100%, 380px);
    height: auto;
    aspect-ratio: 1380 / 1580;
    object-fit: contain;
    max-width: none;
    margin: 0 -8px -8px 0;
    filter: drop-shadow(0 28px 72px rgba(0,0,0,.48));
  }
  .support-context {
    display: inline-flex;
    margin-top: 16px;
    padding: 10px 14px;
    border-radius: 999px;
    border: 1px solid rgba(79,195,247,.18);
    background: rgba(79,195,247,.06);
    font-size: 12px;
    line-height: 1.4;
    color: rgba(255,255,255,.78);
  }

  .support-paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }
  .path-card {
    display: block;
    min-height: 220px;
    padding: 24px;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(10,12,20,.5);
    backdrop-filter: blur(12px);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, border-color 0.2s, background 0.2s;
  }
  .path-card:hover {
    transform: translateY(-2px);
    border-color: rgba(79,195,247,.24);
    background: rgba(12,16,26,.62);
  }
  .path-card__eyebrow {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.45;
    margin-bottom: 12px;
  }
  .path-card h2 {
    margin: 0 0 12px;
    font-size: 24px;
    line-height: 1.15;
  }
  .path-card p {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    opacity: 0.74;
  }

  .support-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .panel {
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 20px;
    padding: 32px;
    background: rgba(10,12,20,.5);
    backdrop-filter: blur(12px);
  }
  .panel-label {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.45;
    margin-bottom: 12px;
  }
  .panel h2 {
    font-size: 22px;
    font-weight: 700;
    margin: 0 0 12px;
  }
  .panel-copy {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    opacity: 0.76;
  }
  .checklist {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .checklist li {
    padding: 9px 0;
    border-bottom: 1px solid rgba(255,255,255,.05);
    font-size: 14px;
    opacity: 0.84;
  }
  .checklist li::before {
    content: "✓ ";
    color: #4fc3f7;
    opacity: 0.8;
  }
  .panel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }
  .panel-link {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,.1);
    text-decoration: none;
    color: rgba(255,255,255,.82);
    font-size: 14px;
    font-weight: 600;
  }
  .panel-link:hover {
    border-color: rgba(79,195,247,.24);
    color: #fff;
  }

  @media (max-width: 980px) {
    .support-paths { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .support-hero-grid {
      grid-template-columns: minmax(0, 1.02fr) minmax(360px, .98fr);
    }
    .support-hero-visual { display: grid; }
  }
  @media (max-width: 860px) {
    .support-grid { grid-template-columns: 1fr; }
    .panel { padding: 24px; }
  }
  @media (max-width: 620px) {
    .support-paths { grid-template-columns: 1fr; }
    .hero { padding: 36px 0 24px; }
  }
</style>

<script is:inline>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var product = params.get('product') || '';
    var intent = params.get('intent') || '';
    var purchase = params.get('purchase') || '';
    var sessionId = params.get('session_id') || '';
    var bits = [];

    if (product) bits.push('Product: ' + product.replace(/[-_]/g, ' '));
    if (intent) bits.push('Intent: ' + intent.replace(/[-_]/g, ' '));
    if (purchase) bits.push('Purchase: ' + purchase);
    if (sessionId) bits.push('Session: ' + sessionId);

    var context = document.getElementById('supportContext');
    if (context && bits.length) {
      context.hidden = false;
      context.textContent = 'Current context - ' + bits.join(' | ');
    }

    var mail = document.getElementById('supportMailto');
    if (!mail) return;

    var subject = 'VOLYNX support';
    if (product) subject += ' - ' + product;

    var bodyLines = [
      'Please describe the issue.',
      '',
      'Useful context:'
    ];

    if (product) bodyLines.push('Product: ' + product);
    if (intent) bodyLines.push('Intent: ' + intent);
    if (purchase) bodyLines.push('Purchase: ' + purchase);
    if (sessionId) bodyLines.push('Session ID: ' + sessionId);

    bodyLines.push('', 'Issue summary:');

    mail.href = 'mailto:hello@volynx.world?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(bodyLines.join('\n'));
  })();
</script>
