---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";
---

<FlagshipLayout
  title="PropertyFlow — Guia de publicação e conexão"
  description="Guia passo a passo para configurar, publicar e conectar seu PropertyFlow sem terminal ou código."
  pageClass="page-propertyflow-guide"
>
  <FlagshipHeader current={ROUTES.propertyflow} ctaLabel="Open PropertyFlow Studio" ctaI18n="header.open_studio" ctaHref={ROUTES.propertyflowStudio} />

  <main>
    <section class="pf-guide-hero">
      <div class="shell pf-guide-hero__grid">
        <div>
          <span class="kicker"><span class="i18n-en">PropertyFlow connection guide</span><span class="i18n-pt">Guia de conexão PropertyFlow</span></span>
          <h1><span class="i18n-en">From purchase to published site, without a terminal.</span><span class="i18n-pt">Da compra ao site publicado, sem terminal.</span></h1>
          <p><span class="i18n-en">Your hosted Studio is the complete path. Configure the brand, add properties, choose a template and publish from one dashboard.</span><span class="i18n-pt">O Studio hospedado é o caminho completo. Configure a marca, cadastre imóveis, escolha um template e publique em um único painel.</span></p>
          <div class="hero-actions">
            <a class="button button--gold" href={ROUTES.propertyflowStudio}><span class="i18n-en">Open my Studio</span><span class="i18n-pt">Abrir meu Studio</span></a>
            <a class="button button--ghost" href="#publication"><span class="i18n-en">See publication options</span><span class="i18n-pt">Ver opções de publicação</span></a>
          </div>
        </div>
        <aside class="panel pf-guide-hero__aside">
          <img class="pf-guide-hero__visual" src="/assets/propertyflow-guide/propertyflow-overview.webp" alt="Painel PropertyFlow conectado a uma vitrine imobiliária" width="1448" height="1086" fetchpriority="high" />
          <span class="pf-guide-status"><span aria-hidden="true">●</span> <span class="i18n-en">Recommended path</span><span class="i18n-pt">Caminho recomendado</span></span>
          <strong><span class="i18n-en">Hosted Studio</span><span class="i18n-pt">Studio hospedado</span></strong>
          <p><span class="i18n-en">No ZIP, hosting setup, DNS knowledge or code is required for the normal workflow.</span><span class="i18n-pt">No fluxo normal, você não precisa de ZIP, hospedagem, conhecimento de DNS ou código.</span></p>
        </aside>
      </div>
    </section>

    <section class="page-section pf-guide-section" id="start">
      <div class="shell">
        <div class="section-head">
          <span class="eyebrow"><span class="i18n-en">Start here</span><span class="i18n-pt">Comece aqui</span></span>
          <h2><span class="i18n-en">The three steps every buyer follows.</span><span class="i18n-pt">Os três passos de todo comprador.</span></h2>
        </div>
        <div class="pf-guide-steps">
          <article class="panel pf-guide-step"><img src="/assets/propertyflow-guide/propertyflow-configuration.webp" alt="Configuração visual da identidade do PropertyFlow" width="1254" height="1254" loading="lazy" decoding="async" /><span>01</span><h3><span class="i18n-en">Configure</span><span class="i18n-pt">Configure</span></h3><p><span class="i18n-en">Open the Studio, choose your brand identity, select a template and add your properties and photos.</span><span class="i18n-pt">Abra o Studio, escolha a identidade da marca, selecione um template e cadastre seus imóveis e fotos.</span></p></article>
          <article class="panel pf-guide-step"><img src="/assets/propertyflow-guide/propertyflow-addresses.webp" alt="Escolha de endereço e domínio para o site imobiliário" width="1254" height="1254" loading="lazy" decoding="async" /><span>02</span><h3><span class="i18n-en">Choose an address</span><span class="i18n-pt">Escolha um endereço</span></h3><p><span class="i18n-en">Use a free VOLYNX subdomain, connect a domain you already own or link the catalogue to your current website.</span><span class="i18n-pt">Use um subdomínio VOLYNX gratuito, conecte um domínio que já possui ou ligue o catálogo ao seu site atual.</span></p></article>
          <article class="panel pf-guide-step"><img src="/assets/propertyflow-guide/propertyflow-publish.webp" alt="Site PropertyFlow publicado e marcado como online" width="1254" height="1254" loading="lazy" decoding="async" /><span>03</span><h3><span class="i18n-en">Publish</span><span class="i18n-pt">Publique</span></h3><p><span class="i18n-en">Save the publication settings, confirm the checklist and share the generated address. Changes remain managed in the Studio.</span><span class="i18n-pt">Salve a publicação, confirme a checklist e compartilhe o endereço gerado. As alterações continuam sendo gerenciadas no Studio.</span></p></article>
        </div>
      </div>
    </section>

    <section class="page-section pf-guide-section" id="publication">
      <div class="shell">
        <div class="section-head">
          <span class="eyebrow"><span class="i18n-en">Publication choices</span><span class="i18n-pt">Escolha de publicação</span></span>
          <h2><span class="i18n-en">Pick the connection that matches your business.</span><span class="i18n-pt">Escolha a conexão que combina com seu negócio.</span></h2>
        </div>
        <div class="pf-guide-options">
          <article class="panel pf-guide-option">
            <img src="/assets/propertyflow-guide/propertyflow-subdomain.webp" alt="Subdomínio VOLYNX conectado ao site imobiliário" width="1254" height="1254" loading="lazy" decoding="async" />
            <span class="pf-guide-option__number">A</span>
            <h3><span class="i18n-en">Free VOLYNX subdomain</span><span class="i18n-pt">Subdomínio VOLYNX gratuito</span></h3>
            <p><span class="i18n-en">The fastest option. Enter a short name, for example <strong>sua-imobiliaria.volynx.world</strong>, and publish.</span><span class="i18n-pt">A opção mais rápida. Digite um nome curto, por exemplo <strong>sua-imobiliaria.volynx.world</strong>, e publique.</span></p>
            <ol><li><span class="i18n-en">Select “Create a VOLYNX address” in the Studio.</span><span class="i18n-pt">Selecione “Criar um endereço VOLYNX” no Studio.</span></li><li><span class="i18n-en">Choose the available name.</span><span class="i18n-pt">Escolha o nome disponível.</span></li><li><span class="i18n-en">Save and open the generated address.</span><span class="i18n-pt">Salve e abra o endereço gerado.</span></li></ol>
          </article>
          <article class="panel pf-guide-option">
            <img src="/assets/propertyflow-guide/propertyflow-domain-dns.webp" alt="Configuração de domínio próprio e registros DNS" width="1254" height="1254" loading="lazy" decoding="async" />
            <span class="pf-guide-option__number">B</span>
            <h3><span class="i18n-en">Your own domain</span><span class="i18n-pt">Seu domínio próprio</span></h3>
            <p><span class="i18n-en">Keep your existing brand address. The Studio shows the exact DNS value to add and indicates when verification is complete.</span><span class="i18n-pt">Mantenha o endereço da sua marca. O Studio mostra o valor exato de DNS a adicionar e indica quando a verificação terminar.</span></p>
            <ol><li><span class="i18n-en">Select “Use my own domain”.</span><span class="i18n-pt">Selecione “Usar meu domínio próprio”.</span></li><li><span class="i18n-en">Enter the domain you control.</span><span class="i18n-pt">Digite o domínio que você controla.</span></li><li><span class="i18n-en">Copy the displayed DNS record into your domain provider.</span><span class="i18n-pt">Copie o registro DNS exibido para o provedor do domínio.</span></li><li><span class="i18n-en">Return to the Studio and wait for verification.</span><span class="i18n-pt">Volte ao Studio e aguarde a verificação.</span></li></ol>
          </article>
          <article class="panel pf-guide-option">
            <img src="/assets/propertyflow-guide/propertyflow-existing-site.webp" alt="Catálogo PropertyFlow conectado a um site existente" width="1254" height="1254" loading="lazy" decoding="async" />
            <span class="pf-guide-option__number">C</span>
            <h3><span class="i18n-en">Existing website</span><span class="i18n-pt">Site que você já possui</span></h3>
            <p><span class="i18n-en">Keep your current website and add a catalogue link or button. Your listings stay managed in PropertyFlow.</span><span class="i18n-pt">Mantenha seu site atual e adicione um link ou botão para o catálogo. Seus imóveis continuam sendo gerenciados no PropertyFlow.</span></p>
            <ol><li><span class="i18n-en">Select “Connect to my current website”.</span><span class="i18n-pt">Selecione “Conectar ao meu site atual”.</span></li><li><span class="i18n-en">Enter your current website address and choose the catalogue subdomain.</span><span class="i18n-pt">Informe o endereço do site atual e escolha o subdomínio do catálogo.</span></li><li><span class="i18n-en">Copy the ready-made catalogue link or button.</span><span class="i18n-pt">Copie o link ou botão pronto do catálogo.</span></li><li><span class="i18n-en">Paste it into your site's menu or page.</span><span class="i18n-pt">Cole no menu ou em uma página do seu site.</span></li></ol>
          </article>
        </div>
      </div>
    </section>

    <section class="page-section pf-guide-section" id="templates">
      <div class="shell pf-guide-split">
        <div>
          <span class="eyebrow"><span class="i18n-en">Templates</span><span class="i18n-pt">Templates</span></span>
          <h2><span class="i18n-en">Change the structure without starting over.</span><span class="i18n-pt">Troque a estrutura sem começar de novo.</span></h2>
          <p class="pf-guide-copy"><span class="i18n-en">Your properties, photos and brand settings are kept in the Studio. When you choose another template, the same catalogue is rendered in the new structure.</span><span class="i18n-pt">Seus imóveis, fotos e configurações de marca ficam salvos no Studio. Ao escolher outro template, o mesmo catálogo é renderizado na nova estrutura.</span></p>
          <img class="pf-guide-section__visual" src="/assets/propertyflow-guide/propertyflow-templates.webp" alt="Vários templates PropertyFlow com o mesmo catálogo de imóveis" width="1448" height="1086" loading="lazy" decoding="async" />
        </div>
        <div class="panel pf-guide-checklist">
          <img class="pf-guide-checklist__visual" src="/assets/propertyflow-guide/propertyflow-management.webp" alt="Gestão de imóveis, imagens e identidade no PropertyFlow" width="1448" height="1086" loading="lazy" decoding="async" />
          <strong><span class="i18n-en">What you do in the Studio</span><span class="i18n-pt">O que você faz no Studio</span></strong>
          <ul><li><span class="i18n-en">Choose the template in Identity.</span><span class="i18n-pt">Escolhe o template em Identidade.</span></li><li><span class="i18n-en">Edit colours, logo and brand copy.</span><span class="i18n-pt">Edita cores, logo e textos da marca.</span></li><li><span class="i18n-en">Manage properties in the Properties area.</span><span class="i18n-pt">Gerencia imóveis na área Imóveis.</span></li><li><span class="i18n-en">Publish again when the preview is ready.</span><span class="i18n-pt">Publica novamente quando a prévia estiver pronta.</span></li></ul>
        </div>
      </div>
    </section>

    <section class="page-section page-section--last pf-guide-section" id="zip">
      <div class="shell">
        <div class="panel pf-guide-warning">
          <img class="pf-guide-warning__visual" src="/assets/propertyflow-guide/propertyflow-delivery.webp" alt="Entrega do PropertyFlow com download opcional do ZIP" width="1448" height="1086" loading="lazy" decoding="async" />
          <span class="eyebrow"><span class="i18n-en">Optional advanced path</span><span class="i18n-pt">Caminho avançado opcional</span></span>
          <h2><span class="i18n-en">The ZIP is not part of the normal setup.</span><span class="i18n-pt">O ZIP não faz parte da configuração normal.</span></h2>
          <p><span class="i18n-en">Only download the ZIP if you or a technical partner deliberately want to self-host the files. For everyone else, the hosted Studio already handles the project, publishing and updates.</span><span class="i18n-pt">Baixe o ZIP apenas se você ou um parceiro técnico quiserem hospedar os arquivos por conta própria. Para todos os demais, o Studio hospedado já cuida do projeto, da publicação e das atualizações.</span></p>
          <a class="button button--ghost" href={ROUTES.propertyflowStudio}><span class="i18n-en">Return to my Studio</span><span class="i18n-pt">Voltar ao meu Studio</span></a>
        </div>
      </div>
    </section>
  </main>

  <FlagshipFooter />
</FlagshipLayout>

<style is:global>
  .page-propertyflow-guide .pf-guide-hero { padding: 90px 0 56px; background: radial-gradient(circle at 85% 15%, rgba(125,249,255,.13), transparent 34%), linear-gradient(145deg, #071019, #0b1220 58%, #111827); }
  .page-propertyflow-guide .pf-guide-hero__grid { display: grid; gap: 28px; align-items: center; }
  .page-propertyflow-guide .pf-guide-hero h1 { max-width: 800px; margin: 18px 0; font-size: clamp(2.6rem, 7vw, 5.4rem); line-height: .98; letter-spacing: -.055em; }
  .page-propertyflow-guide .pf-guide-hero p { max-width: 690px; color: var(--muted); font-size: 1.08rem; line-height: 1.7; }
  .page-propertyflow-guide .pf-guide-hero__aside { padding: 26px; display: grid; gap: 12px; border-color: rgba(125,249,255,.22); }
  .page-propertyflow-guide .pf-guide-hero__visual { width: 100%; height: 190px; object-fit: contain; object-position: center; display: block; margin: -10px 0 2px; }
  .page-propertyflow-guide .pf-guide-hero__aside strong { color: #fff; font-size: 1.35rem; }
  .page-propertyflow-guide .pf-guide-hero__aside p { margin: 0; font-size: .95rem; }
  .page-propertyflow-guide .pf-guide-status { color: #7df9ff; font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .page-propertyflow-guide .pf-guide-section { padding-top: 74px; }
  .page-propertyflow-guide .pf-guide-steps, .page-propertyflow-guide .pf-guide-options { display: grid; gap: 14px; margin-top: 24px; }
  .page-propertyflow-guide .pf-guide-step, .page-propertyflow-guide .pf-guide-option { padding: 24px; }
  .page-propertyflow-guide .pf-guide-step > img, .page-propertyflow-guide .pf-guide-option > img { width: 100%; height: 300px; display: block; object-fit: contain; object-position: center; margin-bottom: 18px; }
  .page-propertyflow-guide .pf-guide-step > span, .page-propertyflow-guide .pf-guide-option__number { color: #7df9ff; font-size: .78rem; font-weight: 800; letter-spacing: .14em; }
  .page-propertyflow-guide .pf-guide-step h3, .page-propertyflow-guide .pf-guide-option h3 { margin: 18px 0 10px; color: #fff; font-size: 1.25rem; }
  .page-propertyflow-guide .pf-guide-step p, .page-propertyflow-guide .pf-guide-option p, .page-propertyflow-guide .pf-guide-option li, .page-propertyflow-guide .pf-guide-copy { color: var(--muted); line-height: 1.7; }
  .page-propertyflow-guide .pf-guide-option ol { display: grid; gap: 8px; margin: 18px 0 0; padding-left: 20px; }
  .page-propertyflow-guide .pf-guide-option strong { color: #fff; }
  .page-propertyflow-guide .pf-guide-split { display: grid; gap: 24px; align-items: start; }
  .page-propertyflow-guide .pf-guide-checklist { padding: 26px; }
  .page-propertyflow-guide .pf-guide-section__visual { width: min(100%, 520px); height: 260px; display: block; object-fit: contain; object-position: left center; margin: 22px 0 0; }
  .page-propertyflow-guide .pf-guide-checklist__visual { width: 100%; height: 210px; display: block; object-fit: contain; object-position: center; margin-bottom: 12px; }
  .page-propertyflow-guide .pf-guide-checklist ul { display: grid; gap: 12px; margin: 16px 0 0; padding-left: 20px; color: var(--muted); line-height: 1.6; }
  .page-propertyflow-guide .pf-guide-warning { padding: 30px; border-color: rgba(216,179,106,.28); background: linear-gradient(135deg, rgba(216,179,106,.08), rgba(255,255,255,.025)); }
  .page-propertyflow-guide .pf-guide-warning__visual { width: min(100%, 440px); height: 220px; display: block; object-fit: contain; object-position: center; margin: -12px auto 12px; }
  .page-propertyflow-guide .pf-guide-warning h2 { max-width: 700px; margin: 12px 0; }
  .page-propertyflow-guide .pf-guide-warning p { max-width: 760px; color: var(--muted); line-height: 1.7; }
  @media (min-width: 760px) {
    .page-propertyflow-guide .pf-guide-hero__grid { grid-template-columns: minmax(0, 1.4fr) minmax(280px, .6fr); }
    .page-propertyflow-guide .pf-guide-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .page-propertyflow-guide .pf-guide-options { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .page-propertyflow-guide .pf-guide-split { grid-template-columns: minmax(0, 1fr) minmax(280px, .8fr); }
    .page-propertyflow-guide .pf-guide-warning { display: grid; grid-template-columns: minmax(240px, .55fr) minmax(0, 1fr); column-gap: 28px; align-items: center; }
    .page-propertyflow-guide .pf-guide-warning__visual { grid-row: span 4; width: 100%; height: 250px; margin: 0; }
  }
</style>
