---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ROUTES, productPreviewHref } from "../data/routes";

const utm = "?utm_source=tiktok&utm_medium=bio&utm_campaign=bootstrap";
const studioOfferHref = `${productPreviewHref("studio_pro")}?utm_source=tiktok&utm_medium=bio&utm_campaign=studio-pro`;
const toolHref = `${ROUTES.labImageSuite}?tool=bg-remove&utm_source=tiktok&utm_medium=bio&utm_campaign=studio-pro`;
const platformHref = `${ROUTES.platform}${utm}`;
---

<BaseLayout
  title="VOLYNX — Remove backgrounds privately"
  description="Pro background remover with local browser processing. Your image is processed on your device after sign-in or upgrade."
  ogImage="/assets/newimagesuite.webp"
>
  <main class="tt-page">
    <section class="tt-hero">
      <div class="tt-shell tt-hero-grid">
        <div class="tt-hero-copy">
          <div class="tt-eyebrow">
            <span class="tt-dot" aria-hidden="true"></span>
            <span data-i18n="tt.eyebrow">From TikTok</span>
          </div>

          <h1 class="tt-headline">
            <span data-i18n="tt.hook">Why your photo shouldn't go to a server.</span>
          </h1>

          <p class="tt-sub" data-i18n="tt.subhook">
            Remove backgrounds with local browser processing inside VOLYNX Studio. Your image is processed on your device; access requires sign-in and a Pro/Studio plan.
          </p>

          <div class="tt-cta-group">
            <a class="tt-cta-primary" href={studioOfferHref} data-campaign-event="tiktok_studio_offer">
              <span data-i18n="tt.cta_primary">Unlock Studio Pro — £18/month</span>
              <span class="tt-arrow" aria-hidden="true">→</span>
            </a>
            <p class="tt-cta-note" data-i18n="tt.cta_note">
              Includes private background removal, batch workflows and commercial rights. Cancel anytime.
            </p>
            <a class="tt-cta-tool" href={toolHref} data-campaign-event="tiktok_tool_demo">
              <span data-i18n="tt.cta_try_tool">Try the Image Suite first</span>
              <span class="tt-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <div class="tt-hero-art" aria-label="VOLYNX Image Suite">
          <div class="tt-hero-art__frame">
            <span class="tt-hero-art__label">VOLYNX / IMAGE SUITE</span>
            <img src="/assets/newimagesuite.webp" alt="VOLYNX Image Suite" width="1380" height="752" loading="eager" decoding="async" />
            <span class="tt-hero-art__status"><span class="tt-status-dot" aria-hidden="true"></span> LOCAL PROCESSING</span>
          </div>
        </div>
      </div>
    </section>

    <section class="tt-proof">
      <div class="tt-shell tt-proof-grid">
        <article class="tt-card">
          <div class="tt-card-num">01</div>
          <h3 class="tt-card-title" data-i18n="tt.proof_1_title">Zero upload</h3>
          <p class="tt-card-desc" data-i18n="tt.proof_1_desc">
            U²-Net model runs in your browser via WebAssembly. No server processes your file.
          </p>
        </article>

        <article class="tt-card">
          <div class="tt-card-num">02</div>
          <h3 class="tt-card-title" data-i18n="tt.proof_2_title">Clear access rules</h3>
          <p class="tt-card-desc" data-i18n="tt.proof_2_desc">
            Background removal is a Pro/Studio feature. If your account is not eligible, the tool asks you to sign in or upgrade before processing.
          </p>
        </article>

        <article class="tt-card">
          <div class="tt-card-num">03</div>
          <h3 class="tt-card-title" data-i18n="tt.proof_3_title">Apache 2.0</h3>
          <p class="tt-card-desc" data-i18n="tt.proof_3_desc">
            Open-source model. No vendor lock-in. Same engine you'd find in research papers.
          </p>
        </article>
      </div>
    </section>

    <section class="tt-how">
      <div class="tt-shell">
        <h2 class="tt-how-title" data-i18n="tt.how_title">How it works</h2>
        <ol class="tt-steps">
          <li class="tt-step">
            <span class="tt-step-num">1</span>
            <span class="tt-step-text" data-i18n="tt.how_1">Open the background remover</span>
          </li>
          <li class="tt-step">
            <span class="tt-step-num">2</span>
            <span class="tt-step-text" data-i18n="tt.how_2">Sign in or upgrade if your plan does not include it</span>
          </li>
          <li class="tt-step">
            <span class="tt-step-num">3</span>
            <span class="tt-step-text" data-i18n="tt.how_3">Process locally and download the transparent cutout</span>
          </li>
        </ol>
      </div>
    </section>

    <section class="tt-foot">
      <div class="tt-shell tt-foot-inner">
        <a class="tt-cta-primary tt-cta-primary--foot" href={studioOfferHref} data-campaign-event="tiktok_studio_offer_repeat">
          <span data-i18n="tt.cta_primary">Unlock Studio Pro — £18/month</span>
          <span class="tt-arrow" aria-hidden="true">→</span>
        </a>
        <a class="tt-cta-secondary" href={toolHref} data-campaign-event="tiktok_tool_demo_repeat">
          <span data-i18n="tt.cta_secondary">Try the Image Suite first</span>
          <span class="tt-arrow" aria-hidden="true">→</span>
        </a>
        <a class="tt-explore" href={platformHref} data-campaign-event="tiktok_platform_cta" data-i18n="tt.explore">
          Or explore the full VOLYNX platform →
        </a>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const params = new URLSearchParams(window.location.search);
      const keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'];
      const attribution = Object.fromEntries(keys.filter((key) => params.has(key)).map((key) => [key, params.get(key)]));
      if (Object.keys(attribution).length) {
        try { sessionStorage.setItem('volynx_campaign_attribution', JSON.stringify(attribution)); } catch (_) {}
      }
      const emit = (event) => window.dispatchEvent(new CustomEvent('volynx:campaign-event', {
        detail: {
          campaign: 'tiktok-bootstrap',
          event,
          attribution: (() => {
            try { return JSON.parse(sessionStorage.getItem('volynx_campaign_attribution') || '{}'); } catch (_) { return {}; }
          })()
        }
      }));
      emit('tiktok_view');
      document.addEventListener('click', (event) => {
        const target = event.target.closest('[data-campaign-event]');
        if (target) emit(target.dataset.campaignEvent);
      });
    })();
  </script>
</BaseLayout>

<style>
  .tt-page {
    min-height: 100vh;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(109, 94, 252, 0.18), transparent 70%),
      radial-gradient(ellipse 60% 40% at 80% 30%, rgba(130, 220, 255, 0.08), transparent 70%),
      var(--color-bg-primary);
    color: var(--color-text);
    font-family: var(--font-body);
    padding-top: clamp(48px, 10vh, 96px);
    padding-bottom: clamp(48px, 8vh, 80px);
  }

  .tt-shell {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 32px);
    box-sizing: border-box;
  }

  /* ── Hero ────────────────────────────────────── */
  .tt-hero {
    padding-bottom: clamp(48px, 8vh, 80px);
  }

  .tt-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, .9fr);
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
  }

  .tt-hero-copy { min-width: 0; }

  .tt-hero-art {
    position: relative;
    min-width: 0;
    isolation: isolate;
  }

  .tt-hero-art::before {
    content: "";
    position: absolute;
    inset: 14% -8% -10%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(2, 253, 206, .19), rgba(109, 94, 252, .08) 42%, transparent 70%);
    filter: blur(18px);
  }

  .tt-hero-art__frame {
    position: relative;
    display: grid;
    gap: 12px;
    padding: 16px;
    border: 1px solid rgba(255, 255, 255, .14);
    border-radius: 28px;
    background: linear-gradient(145deg, rgba(255, 255, 255, .12), rgba(255, 255, 255, .035) 46%, rgba(4, 7, 18, .9));
    box-shadow: 0 28px 80px rgba(0, 0, 0, .46), 0 0 52px rgba(2, 253, 206, .08), inset 0 1px 0 rgba(255, 255, 255, .14);
    transform: rotate(1.5deg);
  }

  .tt-hero-art__frame img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18px;
    background: rgba(1, 3, 11, .58);
    object-fit: contain;
  }

  .tt-hero-art__label,
  .tt-hero-art__status {
    color: rgba(245, 247, 252, .6);
    font: 700 10px/1.2 var(--font-display);
    letter-spacing: .16em;
  }

  .tt-hero-art__status { display: inline-flex; align-items: center; gap: 8px; color: var(--color-accent-teal); }
  .tt-status-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; box-shadow: 0 0 12px currentColor; }

  .tt-headline,
  .tt-sub,
  .tt-cta-group { text-align: left; }

  .tt-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 28px;
  }

  .tt-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-teal);
    box-shadow: 0 0 8px rgba(2, 253, 206, 0.6);
  }

  .tt-headline {
    font-family: var(--font-display);
    font-size: clamp(34px, 4.6vw, 58px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-text-strong);
    margin: 0 0 24px;
    font-weight: 600;
    text-wrap: balance;
  }

  .tt-sub {
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 560px;
    margin: 0 auto 40px;
    text-wrap: balance;
  }

  .tt-cta-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .tt-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 28px;
    background: linear-gradient(135deg, #6d5efc 0%, #8b7cff 100%);
    color: #fff;
    text-decoration: none;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    box-shadow:
      0 8px 24px rgba(109, 94, 252, 0.35),
      0 1px 0 rgba(255, 255, 255, 0.15) inset;
    transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
    min-height: 56px;
  }

  .tt-cta-primary:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
    box-shadow:
      0 12px 32px rgba(109, 94, 252, 0.45),
      0 1px 0 rgba(255, 255, 255, 0.18) inset;
  }

  .tt-cta-primary:active { transform: translateY(0); }

  .tt-arrow {
    transition: transform 0.18s ease;
  }

  .tt-cta-primary:hover .tt-arrow { transform: translateX(3px); }

  .tt-cta-note {
    font-size: 13px;
    color: var(--color-text-faint);
    margin: 0;
  }

  .tt-cta-tool {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 28px;
    color: rgba(219, 233, 255, .72);
    font-size: 13px;
    text-decoration: none;
    transition: color .18s ease;
  }

  .tt-cta-tool:hover { color: #fff; }
  .tt-cta-tool:hover .tt-arrow { transform: translateX(3px); }

  @media (max-width: 720px) {
    .tt-hero-grid { grid-template-columns: 1fr; gap: 34px; }
    .tt-hero-copy { text-align: center; }
    .tt-headline, .tt-sub, .tt-cta-group { text-align: center; }
    .tt-cta-group { align-items: center; }
    .tt-hero-art { width: min(100%, 480px); margin: 0 auto; }
    .tt-hero-art::before { left: 0; right: 0; }
    .tt-hero-art__frame { transform: rotate(0); }
  }

  /* ── Proof cards ─────────────────────────────── */
  .tt-proof {
    padding-bottom: clamp(48px, 8vh, 80px);
  }

  .tt-proof-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .tt-card {
    padding: 24px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .tt-card:hover {
    border-color: rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.05);
  }

  .tt-card-num {
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.15em;
    color: var(--color-text-faint);
    margin-bottom: 12px;
  }

  .tt-card-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-text-strong);
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }

  .tt-card-desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ── How it works ────────────────────────────── */
  .tt-how {
    padding-bottom: clamp(48px, 8vh, 80px);
  }

  .tt-how-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 28px);
    color: var(--color-text-strong);
    margin: 0 0 24px;
    letter-spacing: -0.01em;
    text-align: center;
    font-weight: 600;
  }

  .tt-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 540px;
    margin-inline: auto;
  }

  .tt-step {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
  }

  .tt-step-num {
    flex: 0 0 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    background: rgba(109, 94, 252, 0.18);
    color: #c4b5fd;
    border: 1px solid rgba(109, 94, 252, 0.35);
  }

  .tt-step-text {
    font-size: 15px;
    color: var(--color-text);
    line-height: 1.4;
  }

  /* ── Foot CTA ────────────────────────────────── */
  .tt-foot-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }

  .tt-cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--color-text-strong);
    text-decoration: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 500;
    transition: border-color 0.18s ease, background 0.18s ease;
    min-height: 48px;
  }

  .tt-cta-secondary:hover {
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.06);
  }

  .tt-cta-secondary:hover .tt-arrow { transform: translateX(3px); }

  .tt-cta-primary--foot { min-height: 52px; padding: 14px 24px; font-size: 15px; }

  .tt-explore {
    font-size: 13px;
    color: var(--color-text-faint);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .tt-explore:hover {
    color: var(--color-text-muted);
    border-bottom-color: rgba(255, 255, 255, 0.2);
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 720px) {
    .tt-proof-grid {
      grid-template-columns: 1fr;
    }
    .tt-cta-primary {
      width: 100%;
      max-width: 320px;
      justify-content: center;
    }
    .tt-cta-primary--foot { max-width: 340px; }
  }

  /* Reduce motion */
  @media (prefers-reduced-motion: reduce) {
    .tt-cta-primary,
    .tt-cta-secondary,
    .tt-arrow,
    .tt-card {
      transition: none;
    }
  }
</style>
