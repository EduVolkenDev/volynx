---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ROUTES } from "../data/routes";

const utm = "?utm_source=tiktok&utm_medium=bio&utm_campaign=bootstrap";
const primaryHref = `${ROUTES.labImageSuite}?tool=bg-remove&utm_source=tiktok&utm_medium=bio&utm_campaign=bootstrap`;
const platformHref = `${ROUTES.platform}${utm}`;
---

<BaseLayout
  title="VOLYNX — Private Pro background remover"
  description="Pro background remover with local browser processing. Your image is processed on your device after sign-in or upgrade."
  ogImage="/assets/volynx-icon.webp"
>
  <main class="tt-page">
    <section class="tt-hero">
      <div class="tt-shell">
        <div class="tt-eyebrow">
          <span class="tt-dot" aria-hidden="true"></span>
          <span data-i18n="tt.eyebrow">From TikTok</span>
        </div>

        <h1 class="tt-headline">
          <span data-i18n="tt.hook">Why your photo shouldn't go to a server.</span>
        </h1>

        <p class="tt-sub" data-i18n="tt.subhook">
          Remove backgrounds with local browser processing inside VOLYNX Studio. Your image is processed on your device; access requires sign-in and a Pro/Studio plan.
        </p>

        <div class="tt-cta-group">
          <a class="tt-cta-primary" href={primaryHref}>
            <span data-i18n="tt.cta_primary">Try the background remover</span>
            <span class="tt-arrow" aria-hidden="true">→</span>
          </a>
          <p class="tt-cta-note" data-i18n="tt.cta_note">
            Pro/Studio tool. Sign-in and upgrade may be required.
          </p>
        </div>
      </div>
    </section>

    <section class="tt-proof">
      <div class="tt-shell tt-proof-grid">
        <article class="tt-card">
          <div class="tt-card-num">01</div>
          <h3 class="tt-card-title" data-i18n="tt.proof_1_title">Zero upload</h3>
          <p class="tt-card-desc" data-i18n="tt.proof_1_desc">
            U²-Net model runs in your browser via WebAssembly. No server processes your file.
          </p>
        </article>

        <article class="tt-card">
          <div class="tt-card-num">02</div>
          <h3 class="tt-card-title" data-i18n="tt.proof_2_title">Clear access rules</h3>
          <p class="tt-card-desc" data-i18n="tt.proof_2_desc">
            Background removal is a Pro/Studio feature. If your account is not eligible, the tool asks you to sign in or upgrade before processing.
          </p>
        </article>

        <article class="tt-card">
          <div class="tt-card-num">03</div>
          <h3 class="tt-card-title" data-i18n="tt.proof_3_title">Apache 2.0</h3>
          <p class="tt-card-desc" data-i18n="tt.proof_3_desc">
            Open-source model. No vendor lock-in. Same engine you'd find in research papers.
          </p>
        </article>
      </div>
    </section>

    <section class="tt-how">
      <div class="tt-shell">
        <h2 class="tt-how-title" data-i18n="tt.how_title">How it works</h2>
        <ol class="tt-steps">
          <li class="tt-step">
            <span class="tt-step-num">1</span>
            <span class="tt-step-text" data-i18n="tt.how_1">Open the background remover</span>
          </li>
          <li class="tt-step">
            <span class="tt-step-num">2</span>
            <span class="tt-step-text" data-i18n="tt.how_2">Sign in or upgrade if your plan does not include it</span>
          </li>
          <li class="tt-step">
            <span class="tt-step-num">3</span>
            <span class="tt-step-text" data-i18n="tt.how_3">Process locally and download the transparent cutout</span>
          </li>
        </ol>
      </div>
    </section>

    <section class="tt-foot">
      <div class="tt-shell tt-foot-inner">
        <a class="tt-cta-secondary" href={primaryHref}>
          <span data-i18n="tt.cta_secondary">Open the tool</span>
          <span class="tt-arrow" aria-hidden="true">→</span>
        </a>
        <a class="tt-explore" href={platformHref} data-i18n="tt.explore">
          Or explore the full VOLYNX platform →
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .tt-page {
    min-height: 100vh;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(109, 94, 252, 0.18), transparent 70%),
      radial-gradient(ellipse 60% 40% at 80% 30%, rgba(130, 220, 255, 0.08), transparent 70%),
      var(--color-bg-primary);
    color: var(--color-text);
    font-family: var(--font-body);
    padding-top: clamp(48px, 10vh, 96px);
    padding-bottom: clamp(48px, 8vh, 80px);
  }

  .tt-shell {
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 32px);
    box-sizing: border-box;
  }

  /* ── Hero ────────────────────────────────────── */
  .tt-hero {
    text-align: center;
    padding-bottom: clamp(48px, 8vh, 80px);
  }

  .tt-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 28px;
  }

  .tt-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-teal);
    box-shadow: 0 0 8px rgba(2, 253, 206, 0.6);
  }

  .tt-headline {
    font-family: var(--font-display);
    font-size: clamp(34px, 6.5vw, 62px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-text-strong);
    margin: 0 0 24px;
    font-weight: 600;
    text-wrap: balance;
  }

  .tt-sub {
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 560px;
    margin: 0 auto 40px;
    text-wrap: balance;
  }

  .tt-cta-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .tt-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 28px;
    background: linear-gradient(135deg, #6d5efc 0%, #8b7cff 100%);
    color: #fff;
    text-decoration: none;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    box-shadow:
      0 8px 24px rgba(109, 94, 252, 0.35),
      0 1px 0 rgba(255, 255, 255, 0.15) inset;
    transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
    min-height: 56px;
  }

  .tt-cta-primary:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
    box-shadow:
      0 12px 32px rgba(109, 94, 252, 0.45),
      0 1px 0 rgba(255, 255, 255, 0.18) inset;
  }

  .tt-cta-primary:active { transform: translateY(0); }

  .tt-arrow {
    transition: transform 0.18s ease;
  }

  .tt-cta-primary:hover .tt-arrow { transform: translateX(3px); }

  .tt-cta-note {
    font-size: 13px;
    color: var(--color-text-faint);
    margin: 0;
  }

  /* ── Proof cards ─────────────────────────────── */
  .tt-proof {
    padding-bottom: clamp(48px, 8vh, 80px);
  }

  .tt-proof-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .tt-card {
    padding: 24px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .tt-card:hover {
    border-color: rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.05);
  }

  .tt-card-num {
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.15em;
    color: var(--color-text-faint);
    margin-bottom: 12px;
  }

  .tt-card-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-text-strong);
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }

  .tt-card-desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ── How it works ────────────────────────────── */
  .tt-how {
    padding-bottom: clamp(48px, 8vh, 80px);
  }

  .tt-how-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 28px);
    color: var(--color-text-strong);
    margin: 0 0 24px;
    letter-spacing: -0.01em;
    text-align: center;
    font-weight: 600;
  }

  .tt-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 540px;
    margin-inline: auto;
  }

  .tt-step {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
  }

  .tt-step-num {
    flex: 0 0 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    background: rgba(109, 94, 252, 0.18);
    color: #c4b5fd;
    border: 1px solid rgba(109, 94, 252, 0.35);
  }

  .tt-step-text {
    font-size: 15px;
    color: var(--color-text);
    line-height: 1.4;
  }

  /* ── Foot CTA ────────────────────────────────── */
  .tt-foot-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }

  .tt-cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--color-text-strong);
    text-decoration: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 500;
    transition: border-color 0.18s ease, background 0.18s ease;
    min-height: 48px;
  }

  .tt-cta-secondary:hover {
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.06);
  }

  .tt-cta-secondary:hover .tt-arrow { transform: translateX(3px); }

  .tt-explore {
    font-size: 13px;
    color: var(--color-text-faint);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .tt-explore:hover {
    color: var(--color-text-muted);
    border-bottom-color: rgba(255, 255, 255, 0.2);
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 720px) {
    .tt-proof-grid {
      grid-template-columns: 1fr;
    }
    .tt-cta-primary {
      width: 100%;
      max-width: 320px;
      justify-content: center;
    }
  }

  /* Reduce motion */
  @media (prefers-reduced-motion: reduce) {
    .tt-cta-primary,
    .tt-cta-secondary,
    .tt-arrow,
    .tt-card {
      transition: none;
    }
  }
</style>
