---
import "../../styles/lab.css";
import PageWidgets from "../../components/PageWidgets.astro";
import SiteFooter from "../../components/SiteFooter.astro";
const pageTitle = "VOLYNX Lab — Free Tools";
const pageDescription = "Free browser-based image tools by VOLYNX — convert, upscale and process images locally, no upload required.";
---

<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>

  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Volynx" />
  <link rel="manifest" href="/assets/site.webmanifest" />
</head>

<body>
  <div class="bg" aria-hidden="true"></div>

  <header class="topbar">
    <div class="topbar__inner">
      <a class="topbar__logo" href="/">VOLYNX</a>
      <a class="pill-back" href="/">← Home</a>
    </div>
  </header>

  <main class="wrap">
    <div class="hero">
      <div class="hero__badge">
        <span class="hero__badge-dot" aria-hidden="true"></span>
        VOLYNX Lab
      </div>
      <h1 class="hero__title">
        Free <span class="hero__title-accent">Image Tools</span>
      </h1>
      <p class="hero__desc">
        Ferramentas de imagem gratuitas que rodam direto no browser.
        Sem upload, sem servidor — tudo local.
      </p>
    </div>

    <div class="tools-grid">
      <a href="/volynx-lab/converter/" class="tool-card">
        <span class="tool-card__free">FREE</span>
        <span class="tool-card__chip">Converter</span>
        <div class="tool-card__icon" aria-hidden="true">🔄</div>
        <h2 class="tool-card__title">Converter</h2>
        <p class="tool-card__desc">
          Converta imagens para WebP, JPG, PNG ou AVIF com controle de qualidade e resize.
          Suporte a lote e download ZIP.
        </p>
        <span class="tool-card__link">
          Abrir ferramenta
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/volynx-lab/image-scaler/" class="tool-card">
        <span class="tool-card__free">FREE</span>
        <span class="tool-card__chip">Upscaler</span>
        <div class="tool-card__icon" aria-hidden="true">🔍</div>
        <h2 class="tool-card__title">Image Scaler</h2>
        <p class="tool-card__desc">
          Amplie imagens pequenas com suavização alta e nitidez opcional. Escala 2x, 3x ou 4x,
          tudo processado localmente.
        </p>
        <span class="tool-card__link">
          Abrir ferramenta
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/volynx-lab/image-suite/" class="tool-card">
        <span class="tool-card__free">FREE</span>
        <span class="tool-card__chip">Suite</span>
        <div class="tool-card__icon" aria-hidden="true">🎨</div>
        <h2 class="tool-card__title">iMage Suite</h2>
        <p class="tool-card__desc">
          Upscale, compressão e conversão numa interface única. Limite diário para uso gratuito,
          desbloqueio PRO disponível.
        </p>
        <span class="tool-card__link">
          Abrir ferramenta
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/volynx-lab/qr-gen/" class="tool-card">
        <span class="tool-card__free">FREE</span>
        <span class="tool-card__chip">QR</span>
        <div class="tool-card__icon" aria-hidden="true">📱</div>
        <h2 class="tool-card__title">QR Generator</h2>
        <p class="tool-card__desc">
          Gere QR codes estilizados e links prontos para campanha.
        </p>
        <span class="tool-card__link">
          Abrir ferramenta
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/volynx-lab/studio/" class="tool-card" style="border-color:rgba(109,94,252,.35)">
        <span class="tool-card__free" style="background:rgba(109,94,252,.18);border-color:rgba(109,94,252,.35)">PRO</span>
        <span class="tool-card__chip">Studio</span>
        <div class="tool-card__icon" aria-hidden="true">🏭</div>
        <h2 class="tool-card__title">Volynx Studio</h2>
        <p class="tool-card__desc">
          Brand Kit + presets multicanal + export pack com manifesto. Produção em escala com guardrails.
        </p>
        <span class="tool-card__link">
          Abrir Studio
          <span class="tool-card__link-arrow" aria-hidden="true">→</span>
        </span>
      </a>

    </div>
  </main>

  <SiteFooter />
  <PageWidgets />
</body>
</html>
