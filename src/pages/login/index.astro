---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";
---
<FlagshipLayout title="Login — VOLYNX" description="Access your VOLYNX account." pageClass="page-login">
  <FlagshipHeader current={ROUTES.login} ctaLabel="Start Pro" />
  <main>

    <!-- ═══ LOGIN HERO ═══ -->
    <section class="hero account-hero">
      <div class="shell login-shell">
        <div class="hero-copy">
          <span class="kicker">Sign in</span>
          <h1>Access a cleaner command layer, not just an account page.</h1>
          <p>Post-login should feel like a shift in class. Free users get continuity. Pro users get a premium workspace with more speed, memory and control.</p>
        </div>
        <div class="form-card">
          <form class="form-grid" id="loginForm" action="#" method="get">
            <div class="field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" autocomplete="email" placeholder="you@volynx.world" required />
            </div>
            <div class="field">
              <label for="password">Password</label>
              <input type="password" id="password" name="password" autocomplete="current-password" placeholder="••••••••" required />
            </div>
            <button type="submit" id="submitBtn" class="button button--gold" style="width:100%;justify-content:center;">Sign in</button>
            <p id="msg" class="msg" aria-live="polite"></p>
            <div style="display:flex;justify-content:space-between;gap:12px;font-size:13px;">
              <a href={ROUTES.authRecover} style="color:var(--muted);transition:color .15s;">Forgot password?</a>
              <a href={ROUTES.signup} style="color:var(--cyan);transition:color .15s;">Create account</a>
            </div>
            <div style="height:1px;background:var(--line);margin:4px 0;"></div>
            <div style="display:flex;gap:10px;">
              <a href={ROUTES.studio} class="button button--ghost" style="flex:1;justify-content:center;">Go to Studio</a>
              <a href={ROUTES.lab} class="button button--ghost" style="flex:1;justify-content:center;">Try Lab</a>
            </div>
            <a href={ROUTES.pricing} class="button button--ghost" style="justify-content:center;">Compare Free vs Pro</a>
          </form>
        </div>
      </div>
    </section>

  </main>
  <FlagshipFooter />

  <script is:inline type="module" src="/scripts/auth-login.js"></script>
</FlagshipLayout>

<style>
  .msg{ min-height: 18px; margin: 0; font-size: 13px; }
  .msg.err{ color: rgba(255, 140, 140, .95); }
  .msg.ok{ color: rgba(140, 255, 210, .92); }
  .account-hero{ padding-top: clamp(40px, 6vw, 80px); padding-bottom: clamp(40px, 6vw, 80px); }
</style>
