---
import FlagshipLayout from "../../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../../components/FlagshipHeader.astro";
import FlagshipFooter from "../../components/FlagshipFooter.astro";
import { ROUTES } from "../../data/routes";
---
<FlagshipLayout title="Login — VOLYNX" description="Access your VOLYNX account." pageClass="page-login">
  <FlagshipHeader current={ROUTES.login} ctaLabel="Start Pro" ctaI18n="nav.start_pro" />
  <main>

    <!-- ═══ LOGIN HERO ═══ -->
    <section class="hero account-hero">
      <div class="shell login-shell">
        <div class="hero-copy">
          <span class="kicker" data-i18n="login2.kicker">Sign in</span>
          <h1 data-i18n="login2.title">Access a cleaner command layer, not just an account page.</h1>
          <p data-i18n="login2.desc">Sign in to access your tools, projects, and workspace. Pro members unlock the full premium experience with advanced features and higher limits.</p>
        </div>
        <div class="form-card">
          <div id="sessionExpiredKicker" class="session-expired" role="status" aria-live="polite" hidden>
            <span class="session-expired__dot" aria-hidden="true"></span>
            <span><strong data-i18n="login2.expired_title">Session expired.</strong> <span data-i18n="login2.expired_desc">Sign in again to continue where you left off.</span></span>
          </div>
          <form class="form-grid" id="loginForm" action="#" method="get">
            <div class="field">
              <label for="email" data-i18n="login2.email_label">Email</label>
              <input type="email" id="email" name="email" autocomplete="email" placeholder="you@volynx.world" data-i18n-placeholder="login2.email_ph" required />
            </div>
            <div class="field">
              <label for="password" data-i18n="login2.password_label">Password</label>
              <input type="password" id="password" name="password" autocomplete="current-password" placeholder="••••••••" data-i18n-placeholder="login2.password_ph" required />
            </div>
            <button type="submit" id="submitBtn" class="button button--gold" style="width:100%;justify-content:center;" data-i18n="login2.btn_signin">Sign in</button>
            <p id="msg" class="msg" aria-live="polite"></p>
            <div class="login-alternatives" id="loginAlternatives" aria-labelledby="loginAlternativesTitle" hidden>
              <p class="login-alternatives__title" id="loginAlternativesTitle"><span class="i18n-en">Other ways to enter</span><span class="i18n-pt">Outras formas de entrar</span></p>
              <div class="login-alternatives__grid">
                <button type="button" id="googleSignInBtn" class="button button--ghost login-alternatives__button" disabled><span class="login-alternatives__symbol" aria-hidden="true">G</span><span><span class="i18n-en">Continue with Google</span><span class="i18n-pt">Continuar com Google</span></span></button>
                <button type="button" id="appleSignInBtn" class="button button--ghost login-alternatives__button" disabled><span><span class="i18n-en">Continue with Apple</span><span class="i18n-pt">Continuar com Apple</span></span></button>
                <button type="button" id="passkeySignInBtn" class="button button--ghost login-alternatives__button login-alternatives__button--wide" disabled><span class="login-alternatives__symbol" aria-hidden="true">✦</span><span><span class="i18n-en">Sign in with a passkey</span><span class="i18n-pt">Entrar com chave de acesso</span></span></button>
              </div>
              <p class="login-alternatives__hint"><span class="i18n-en">A passkey can use your device's face scan, fingerprint, PIN, or password manager. Save one in your profile after signing in.</span><span class="i18n-pt">A chave de acesso pode usar reconhecimento facial, digital, PIN ou gerenciador de senhas. Salve uma no perfil depois de entrar.</span></p>
              <p id="loginAlternativesStatus" class="login-alternatives__status" role="status" aria-live="polite"></p>
            </div>
            <div style="display:flex;justify-content:space-between;gap:12px;font-size:13px;">
              <a href={ROUTES.authRecover} style="color:var(--muted);transition:color .15s;" data-i18n="login2.forgot">Forgot password?</a>
              <a href={ROUTES.signup} style="color:var(--cyan);transition:color .15s;" data-i18n="login2.create_account">Create account</a>
            </div>
            <div style="height:1px;background:var(--line);margin:4px 0;"></div>
            <div style="display:flex;gap:10px;">
              <a href={ROUTES.dashboard} class="button button--ghost" style="flex:1;justify-content:center;" data-i18n="login2.btn_dashboard">Open Dashboard</a>
              <a href={ROUTES.lab} class="button button--ghost" style="flex:1;justify-content:center;" data-i18n="login2.btn_lab">Try Lab</a>
            </div>
            <a href={ROUTES.pricing} class="button button--ghost" style="justify-content:center;" data-i18n="login2.btn_compare">Compare Free vs Pro</a>
          </form>
        </div>
      </div>
    </section>

  </main>
  <FlagshipFooter />

  <script is:inline>
    // Session-expired kicker — only shown when there's an actual expired session redirect
    (function () {
      try {
        const params = new URLSearchParams(window.location.search);
        // A product destination is not evidence that an existing session expired.
        if (params.get("session_expired") === "1") {
          const el = document.getElementById("sessionExpiredKicker");
          if (el) el.hidden = false;
        }
      } catch (_) {}
    })();
  </script>
  <script is:inline src="/vendor/supabase-js-2.118.0/supabase.js"></script>
  <script is:inline type="module" src="/scripts/auth-login.js?v=20261018"></script>
</FlagshipLayout>

<style>
  .msg{ min-height: 18px; margin: 0; font-size: 13px; }
  .msg.err{ color: rgba(255, 140, 140, .95); }
  .msg.ok{ color: rgba(140, 255, 210, .92); }
  .login-alternatives { display: grid; gap: 12px; margin: 8px 0; padding-top: 18px; border-top: 1px solid var(--line); }
  .login-alternatives[hidden], .login-alternatives__button[hidden] { display: none; }
  .login-alternatives__title { margin: 0; color: #f3f3f7; font-size: .86rem; font-weight: 700; }
  .login-alternatives__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .login-alternatives__button { min-height: 52px; width: 100%; justify-content: center; gap: 10px; text-align: center; line-height: 1.25; }
  .login-alternatives__button--wide { grid-column: 1 / -1; }
  .login-alternatives__button:disabled { cursor: not-allowed; opacity: .55; }
  .login-alternatives__button:not(:disabled):focus-visible { outline: 2px solid #b8e9ff; outline-offset: 3px; }
  .login-alternatives__symbol { display: inline-grid; place-items: center; width: 25px; height: 25px; flex: 0 0 auto; border-radius: 50%; background: rgba(255,255,255,.1); color: #f6dba1; font-weight: 800; }
  .login-alternatives__hint, .login-alternatives__status { margin: 0; color: var(--muted); font-size: .78rem; line-height: 1.5; }
  .login-alternatives__status { min-height: 1.5em; }
  @media (max-width: 520px) { .login-alternatives__grid { grid-template-columns: 1fr; } .login-alternatives__button--wide { grid-column: auto; } }
  .account-hero{ padding-top: clamp(40px, 6vw, 80px); padding-bottom: clamp(40px, 6vw, 80px); }

  .session-expired {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 0 0 16px;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid rgba(255, 200, 120, 0.28);
    background: rgba(255, 180, 80, 0.08);
    color: rgba(255, 220, 180, 0.95);
    font-size: 13.5px;
    line-height: 1.5;
  }
  .session-expired[hidden] { display: none; }
  .session-expired strong { color: #fff; font-weight: 700; }
  .session-expired__dot {
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    margin-top: 6px;
    border-radius: 50%;
    background: rgba(255, 190, 100, 0.95);
    box-shadow: 0 0 10px rgba(255, 190, 100, 0.6);
  }
</style>
