---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VxHeader from "../../components/VxHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { ROUTES } from "../../data/routes";

const title = "Sign Up — VOLYNX";
---

<BaseLayout title={title}>
  <VxHeader primaryCtaLabel="Sign in" primaryCtaI18n="header.cta_signin" primaryCtaHref={ROUTES.login} />

  <div class="signup-bg" aria-hidden="true">
    <video
      class="bg-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/assets/lucid5.webp"
    >
      <source src="/assets/login-bg2.mp4" type="video/mp4" />
    </video>
  </div>

  <main class="shell signup">
    <section class="wrap">
      <div class="panel">

        <!-- State 1: Signup form -->
        <div id="signupState">
          <h1 data-i18n="signup.title">Create your account</h1>
          <p class="sub" data-i18n="signup.subtitle">Create your account to access Builder and your tools.</p>

          <form class="form" id="signupForm" action="#" method="get">
            <label class="field">
              <span data-i18n="signup.fullname">Full name</span>
              <input type="text" id="fullname" name="fullname" autocomplete="name" required placeholder="Your full name" data-i18n-placeholder="signup.fullname_ph" />
            </label>

            <label class="field">
              <span data-i18n="signup.username">Username</span>
              <input type="text" id="username" name="username" autocomplete="username" required placeholder="Choose a username" data-i18n-placeholder="signup.username_ph" pattern="[a-z0-9_]{3,30}" title="3-30 characters, lowercase letters, numbers and underscores only" />
            </label>

            <label class="field">
              <span data-i18n="signup.email">Email</span>
              <input type="email" id="email" name="email" autocomplete="email" required />
            </label>

            <label class="field">
              <span data-i18n="signup.password">Password</span>
              <input type="password" id="password" name="password" autocomplete="new-password" required />
            </label>

            <p id="msg" class="msg" aria-live="polite"></p>

            <button class="btn primary" id="submitBtn" type="submit" data-i18n="signup.btn_create">Create account</button>

            <div class="row">
              <a class="link" href={ROUTES.login} data-i18n="signup.have_account">Already have an account</a>
              <a class="link" href={ROUTES.pricing} data-i18n="signup.pricing">Pricing</a>
            </div>
          </form>
        </div>

        <!-- State 2: Check your email -->
        <div id="checkEmailState" class="check-email" hidden>
          <div class="check-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="M22 4L12 13 2 4" />
            </svg>
          </div>
          <h1 data-i18n="signup.check_title">Check your inbox</h1>
          <p class="check-msg" id="checkMsg" data-i18n-html="signup.check_msg">
            We sent a confirmation link to <strong>{"{"+"email}"}</strong>. Click it to activate your account.
          </p>
          <p class="check-hint" data-i18n="signup.check_hint">
            Didn't receive it? Check your spam folder or try signing up again.
          </p>
          <p id="checkStatus" class="check-status" role="status" aria-live="polite"></p>
          <button id="resendBtn" class="btn secondary" type="button" hidden>
            <span data-i18n="signup.resend">Resend confirmation email</span>
          </button>
          <a class="btn primary" href={ROUTES.login} data-i18n="signup.check_login">Go to login</a>
        </div>

      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script is:inline type="module" src="/scripts/auth-signup.js"></script>

<style>
  @import "../../styles/home.css";
  @import "../../styles/services.css";

  .signup-bg{
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .bg-video{
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.03);
    filter: contrast(1.05) saturate(1.05);
  }

  .signup{
    min-height: calc(100svh - 80px);
    display: grid;
    place-items: center;
    padding: 34px 0 70px;
  }
  .wrap{ width: min(520px, 92vw); }
  .panel{
    border-radius: 26px;
    padding: 22px;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(10,12,20,.52);
    backdrop-filter: blur(14px);
  }
  h1{ margin: 0 0 8px; }
  .sub{ margin: 0 0 18px; opacity: .85; max-width: 60ch; }

  .form{ display: grid; gap: 12px; }
  .field{ display: grid; gap: 8px; }
  .field span{ font-size: 13px; opacity: .82; }

  .msg{ min-height: 18px; margin: 0 0 6px; font-size: 13px; opacity: .92; }
  .msg.err{ color: rgba(255, 140, 140, .95); }
  .msg.ok{ color: rgba(140, 255, 210, .92); }

  input{
    width: 100%;
    padding: 12px 14px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(0,0,0,.18);
    color: inherit;
    outline: none;
  }
  input:focus-visible {
    outline: 2px solid rgba(130, 220, 255, 0.6);
    outline-offset: 2px;
  }
  .btn{
    display: inline-flex;
    justify-content: center;
    padding: 12px 14px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.12);
    text-decoration: none;
    cursor: pointer;
  }
  .btn.primary{ font-weight: 700; }

  .row{
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    opacity: .88;
  }
  .link{ text-decoration: none; }

  /* Check your email state */
  .check-email{
    text-align: center;
    padding: 12px 0 4px;
  }
  .check-icon{
    width: 64px;
    height: 64px;
    margin: 0 auto 18px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: rgba(140, 255, 210, .08);
    border: 1px solid rgba(140, 255, 210, .18);
    color: rgba(140, 255, 210, .9);
  }
  .check-email h1{
    margin: 0 0 12px;
    font-size: 24px;
  }
  .check-msg{
    margin: 0 0 14px;
    line-height: 1.6;
    color: rgba(255,255,255,.82);
  }
  .check-hint{
    margin: 0 0 20px;
    font-size: 13px;
    color: rgba(255,255,255,.5);
    line-height: 1.5;
  }
  .check-status{
    min-height: 18px;
    margin: 0 0 8px;
    color: rgba(140,255,210,.92);
    font-size: 13px;
    line-height: 1.5;
  }
  .check-email .btn{
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce){
    .bg-video{ display:none; }
    .signup-bg{
      background-image: url("/assets/lucid5.webp");
      background-size: cover;
      background-position: center;
    }
  }
</style>
