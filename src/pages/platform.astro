  .hero-v2__mockup-tag--myday,
  .hero-v2__mockup-tag--scanner,
  .hero-v2__mockup-tag--summary,
  .hero-v2__mockup-tag--vault,
  .hero-v2__mockup-tag--writing,
  .hero-v2__mockup-tag--decision {
    top: auto;
    left: auto;
    right: auto;
    bottom: auto;
  }

  @keyframes dailyCoreIn {
    from { opacity: 0; transform: translateY(18px) scale(.9); filter: blur(6px); }
    to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
  }

  @keyframes dailyNodeIn {
    from {
      opacity: 0;
      transform: translateY(16px) scale(.92);
      filter: blur(7px);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  @keyframes dailyCardIn {
    from {
      opacity: 0;
      transform: translateY(18px) scale(.96);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  @keyframes dailyIconFloat {
    0%, 100% { transform: translateY(-50%) rotate(var(--icon-rotate, 0deg)) scale(1.08); }
    50% { transform: translateY(calc(-50% - 7px)) rotate(calc(var(--icon-rotate, 0deg) + 2deg)) scale(1.11); }
  }

  @keyframes dailyPanelIn {
    from { opacity: 0; transform: translateY(18px); filter: blur(6px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-v2__mockup--daily-grid .hero-v2__mockup-chip,
    .hero-v2__mockup--daily-grid .hero-v2__mockup-title,
    .hero-v2__mockup-grid--orbit .hero-v2__mockup-tag {
      animation: none;
      opacity: 1;
      filter: none;
    }
  }

  /* ── Free value strip ── */
  .free-strip {
    padding: clamp(20px, 3vw, 32px);
    display: grid;
    gap: clamp(16px, 3vw, 28px);
  }
  .free-strip--with-visual {
    align-items: center;
  }
  .free-strip__visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 220px;
    padding: 8px;
    isolation: isolate;
  }
  .free-strip__visual::before {
    content: "";
    position: absolute;
    inset: 10% 12%;
    border-radius: 36px;
    background:
      radial-gradient(circle at 20% 25%, rgba(250, 204, 21, 0.18), transparent 34%),
      radial-gradient(circle at 80% 25%, rgba(96, 165, 250, 0.22), transparent 38%),
      radial-gradient(circle at 50% 80%, rgba(244, 114, 182, 0.18), transparent 34%);
    filter: blur(20px);
    z-index: -1;
  }
  .free-strip__hero-art {
    width: min(100%, 400px);
    height: auto;
    filter: drop-shadow(0 26px 60px rgba(0, 0, 0, 0.46));
    animation: float 5.2s ease-in-out infinite;
  }
  .free-strip__body {
    display: grid;
    gap: clamp(16px, 3vw, 24px);
  }
  .free-strip__head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .free-strip__head h2 {
    margin: 0;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    letter-spacing: -0.02em;
  }
  .free-strip__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .free-strip__item {
    position: relative;
    display: grid;
    gap: 14px;
    padding: 26px 22px 22px;
    border-radius: 22px;
    background:
      linear-gradient(160deg, rgba(255,255,255,0.06), rgba(255,255,255,0.015)),
      rgba(4, 10, 24, 0.72);
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition: transform .35s cubic-bezier(.2,.7,.2,1), border-color .35s ease, box-shadow .35s ease, background .35s ease;
  }
  .free-strip__item::before {
    content: "";
    position: absolute;
    inset: -30%;
    background:
      radial-gradient(circle at 30% 20%, rgba(0, 240, 255, 0.16), transparent 55%),
      radial-gradient(circle at 75% 80%, rgba(124, 77, 255, 0.14), transparent 55%);
    opacity: 0;
    transition: opacity .4s ease;
    pointer-events: none;
    z-index: 0;
  }
  .free-strip__item > * { position: relative; z-index: 1; }
  a.free-strip__item { cursor: pointer; }
  a.free-strip__item:hover {
    transform: translateY(-6px);
    border-color: rgba(0, 240, 255, .42);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.08),
      0 22px 50px rgba(0, 240, 255, .22),
      0 8px 20px rgba(124, 77, 255, .12);
  }
  a.free-strip__item:hover::before { opacity: 1; }
  a.free-strip__item:hover .free-strip__item-art {
    transform: translateY(-6px) scale(1.06);
    filter:
      drop-shadow(0 0 14px rgba(0, 240, 255, 0.55))
      drop-shadow(0 24px 48px rgba(0, 240, 255, 0.32))
      drop-shadow(0 8px 18px rgba(124, 77, 255, 0.22));
  }
  a.free-strip__item:focus-visible {
    outline: 2px solid rgba(0, 240, 255, .6);
    outline-offset: 3px;
  }
  .free-strip__item-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .free-strip__item-art {
    width: 220px;
    height: 220px;
    object-fit: contain;
    filter:
      drop-shadow(0 0 8px rgba(0, 240, 255, 0.32))
      drop-shadow(0 18px 36px rgba(0, 240, 255, 0.22));
    transition: transform .45s cubic-bezier(.2,.7,.2,1), filter .45s ease;
    animation: freeStripFloat 5.5s ease-in-out infinite;
  }
  .free-strip__item:nth-child(2) .free-strip__item-art { animation-delay: -1.2s; }
  .free-strip__item:nth-child(3) .free-strip__item-art { animation-delay: -2.4s; }
  .free-strip__item:nth-child(4) .free-strip__item-art { animation-delay: -3.6s; }
  @keyframes freeStripFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  .free-strip__item strong {
    display: grid;
    font-size: 1.05rem;
    color: var(--text, #fff);
    letter-spacing: -0.01em;
    align-content: end;
  }
  .free-strip__item p {
    margin: 0;
    color: var(--muted, rgba(255,255,255,.6));
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .free-strip__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(0,240,255,.26), rgba(124,77,255,.22));
    border: 1px solid rgba(0,240,255,.34);
    color: #00f0ff;
    font-weight: 800;
    flex-shrink: 0;
    box-shadow: 0 0 16px rgba(0, 240, 255, 0.28);
  }
  @media (min-width: 760px) {
    .free-strip__grid { grid-template-columns: repeat(2, 1fr); }
    .free-strip__item-art {
      width: 300px;
      height: 300px;
    }
  }
  @media (min-width: 1040px) {
    .free-strip--with-visual {
      grid-template-columns: minmax(280px, 0.95fr) minmax(0, 1.25fr);
      gap: 28px;
    }
    .free-strip__visual {
      min-height: 100%;
    }
  }

  /* ── Lab tools grid (T2) ── */
  .lab-section { padding-top: clamp(40px, 6vw, 80px); }
  .lab-tools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: clamp(16px, 2.5vw, 24px);
    align-items: stretch;
  }
  .lab-tool-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    padding: 20px 20px 22px;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    height: 100%;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .lab-tool-card:hover {
    transform: translateY(-3px);
    border-color: rgba(0,240,255,.35);
    box-shadow: 0 12px 32px rgba(0,240,255,.15);
  }
  .lab-tool-card__icon {
    width: 100%;
    height: clamp(150px, 17vw, 200px);
    object-fit: contain;
    object-position: center bottom;
    margin: 0 auto 4px;
    filter: drop-shadow(0 0 7px rgba(0,240,255,.22)) drop-shadow(0 14px 28px rgba(0,0,0,.35));
    display: block;
  }
  .lab-tool-card .label--free {
    margin-top: 2px;
  }
  .lab-tool-card h3 {
    margin: 2px 0 0;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .lab-tool-card p {
    margin: 0;
    color: var(--muted, rgba(255,255,255,.6));
    font-size: 0.88rem;
    line-height: 1.55;
    max-width: 32ch;
    margin-top: auto;
    padding-top: 6px;
  }
  .lab-section-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: clamp(24px, 3vw, 36px);
  }
  @media (min-width: 720px) {
    .lab-tools-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1040px) {
    .lab-tools-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .section-float--astronaut img {
    width: clamp(220px, 20vw, 320px) !important;
    opacity: 0.94;
    filter: drop-shadow(0 22px 48px rgba(0, 0, 0, 0.42));
  }

  .icons-store-showcase {
    align-items: center;
  }
  .icons-store-preview {
    position: relative;
    width: min(100%, 460px);
    min-height: 360px;
    margin-inline: auto;
    right: auto;
  }
  .icons-store-scene {
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 1 / 1;
    margin-inline: auto;
  }
  .icons-store-scene__halo {
    position: absolute;
    inset: 14% 12%;
    border-radius: 999px;
    background:
      radial-gradient(circle at 50% 50%, rgba(109, 94, 252, 0.24), transparent 52%),
      radial-gradient(circle at 32% 30%, rgba(139, 250, 240, 0.2), transparent 36%),
      radial-gradient(circle at 74% 72%, rgba(244, 114, 182, 0.16), transparent 32%);
    filter: blur(14px);
  }
  .icons-store-scene__card {
    position: absolute;
    display: grid;
    place-items: center;
    border-radius: 28px;
    background:
      linear-gradient(150deg, rgba(255,255,255,0.12), rgba(255,255,255,0.02)),
      rgba(7, 10, 24, 0.84);
    border: 1px solid rgba(177,150,255,.24);
    box-shadow:
      0 24px 60px rgba(8, 10, 24, 0.5),
      inset 0 1px 0 rgba(255,255,255,0.08);
    backdrop-filter: blur(16px);
    padding: 18px;
    animation: iconsVaultFloat 6s ease-in-out infinite;
  }
  .icons-store-scene__card img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 14px 26px rgba(0, 0, 0, 0.28));
  }
  .icons-store-scene__card--center {
    inset: auto;
    width: 210px;
    height: 210px;
    left: 40%;
    top: 48%;
    transform: translate(-50%, -50%);
    margin: 0 auto;
    z-index: 3;
  }
  .icons-store-scene__card--top {
    width: 128px;
    height: 128px;
    top: 4%;
    right: 12%;
    animation-delay: -1s;
  }
  .icons-store-scene__card--left {
    width: 146px;
    height: 146px;
    left: 0;
    top: 36%;
    animation-delay: -2s;
  }
  .icons-store-scene__card--right {
    width: 138px;
    height: 138px;
    right: 2%;
    bottom: 16%;
    animation-delay: -3s;
  }
  .icons-store-scene__pills {
    position: absolute;
    left: 50%;
    bottom: 2%;
    transform: translateX(-50%);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    width: min(100%, 320px);
    z-index: 4;
  }
  .icons-store-scene__pills span {
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.09);
    color: rgba(232, 236, 245, 0.88);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  @keyframes iconsVaultFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  .icons-store-scene__card--center {
    animation-name: iconsVaultCenterFloat;
  }
  @keyframes iconsVaultCenterFloat {
    0%, 100% { transform: translate(-50%, -50%); }
    50% { transform: translate(-50%, calc(-50% - 8px)); }
  }

  .principle-panel--iconic {
    display: flex;
    flex-direction: column;
    gap: 18px;
    overflow: hidden;
    min-height: 100%;
  }
  .principle-panel__art-shell {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 220px;
    padding: 18px;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,0.08);
    overflow: hidden;
    isolation: isolate;
  }
  .principle-panel__art-shell::before {
    content: "";
    position: absolute;
    inset: 8%;
    border-radius: 999px;
    filter: blur(16px);
    opacity: 0.8;
    z-index: -1;
  }
  .principle-panel--clarity .principle-panel__art-shell {
    background: linear-gradient(160deg, rgba(7, 26, 48, 0.86), rgba(10, 14, 26, 0.72));
  }
  .principle-panel--clarity .principle-panel__art-shell::before {
    background: radial-gradient(circle, rgba(34, 211, 238, 0.22), transparent 62%);
  }
  .principle-panel--systems .principle-panel__art-shell {
    background: linear-gradient(160deg, rgba(48, 12, 35, 0.84), rgba(20, 11, 33, 0.72));
  }
  .principle-panel--systems .principle-panel__art-shell::before {
    background: radial-gradient(circle, rgba(244, 114, 182, 0.2), transparent 62%);
  }
  .principle-panel--shipped .principle-panel__art-shell {
    background: linear-gradient(160deg, rgba(20, 16, 52, 0.84), rgba(9, 11, 28, 0.74));
  }
  .principle-panel--shipped .principle-panel__art-shell::before {
    background: radial-gradient(circle, rgba(96, 165, 250, 0.2), transparent 62%);
  }
  .principle-panel--performance .principle-panel__art-shell {
    background: linear-gradient(160deg, rgba(12, 28, 42, 0.84), rgba(9, 12, 28, 0.74));
  }
  .principle-panel--performance .principle-panel__art-shell::before {
    background: radial-gradient(circle, rgba(74, 222, 128, 0.22), transparent 62%);
  }
  .principle-panel__art {
    width: min(100%, 220px);
    max-height: 220px;
    object-fit: contain;
    filter: drop-shadow(0 18px 34px rgba(0, 0, 0, 0.34));
    transition: transform .35s ease, filter .35s ease;
  }
  .principle-panel__copy {
    display: grid;
    gap: 10px;
  }
  .principle-panel__copy h3,
  .principle-panel__copy p {
    margin: 0;
  }
  .principle-panel--iconic:hover .principle-panel__art {
    transform: translateY(-4px) scale(1.03);
    filter: drop-shadow(0 22px 42px rgba(0, 0, 0, 0.4));
  }

  /* ── Dev Journey mission: platform-specific stage ── */
  .dj-mission-section {
    padding-top: clamp(48px, 7vw, 92px);
    padding-bottom: clamp(48px, 7vw, 92px);
  }
  .dj-mission-panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, .86fr) minmax(460px, 1fr);
    align-items: center;
    gap: clamp(28px, 4.6vw, 64px);
    padding: clamp(30px, 5vw, 58px);
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(circle at 12% 16%, rgba(34, 211, 238, .16), transparent 34%),
      radial-gradient(circle at 86% 72%, rgba(168, 85, 247, .18), transparent 38%),
      linear-gradient(140deg, rgba(11, 18, 32, .94), rgba(15, 10, 28, .9));
    border-color: rgba(125, 211, 252, .24);
    box-shadow:
      0 28px 84px rgba(0, 0, 0, .42),
      inset 0 1px 0 rgba(255, 255, 255, .06);
  }
  .dj-mission-panel::before {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    border: 1px solid rgba(255, 255, 255, .055);
    pointer-events: none;
    z-index: 0;
  }
  .dj-mission-panel::after {
    content: "DEV JOURNEY";
    position: absolute;
    right: clamp(-28px, -2vw, -12px);
    bottom: -18px;
    z-index: 0;
    font-family: var(--display);
    font-size: clamp(54px, 10vw, 126px);
    font-weight: 800;
    letter-spacing: -.08em;
    line-height: .8;
    color: rgba(255, 255, 255, .035);
    pointer-events: none;
  }
  .dj-mission-copy,
  .dj-mission-floater {
    position: relative;
    z-index: 1;
  }
  .dj-mission-copy {
    display: grid;
    gap: 18px;
    max-width: 58ch;
    min-width: 0;
  }
  .dj-mission-label {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .dj-mission-label-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #67e8f9;
    box-shadow: 0 0 16px rgba(103, 232, 249, .8);
  }
  .dj-mission-title {
    margin: 0;
    color: #fff;
    font-family: var(--display);
    font-size: clamp(2rem, 4.2vw, 4.8rem);
    line-height: .95;
    letter-spacing: -.055em;
  }
  .dj-mission-accent {
    background: linear-gradient(135deg, #fde68a, #67e8f9 46%, #c4b5fd);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .dj-mission-desc {
    max-width: 58ch;
    margin: 0;
    color: rgba(226, 232, 240, .76);
    font-size: clamp(.98rem, 1.2vw, 1.08rem);
    line-height: 1.42;
  }
  .dj-mission-desc em {
    color: rgba(253, 230, 138, .92);
  }
  .dj-mission-quote {
    position: relative;
    margin: 2px 0 0;
    padding: 18px 20px 18px 28px;
    border-radius: 20px;
    border: 1px solid rgba(253, 230, 138, .2);
    background: linear-gradient(180deg, rgba(253, 230, 138, .08), rgba(255, 255, 255, .025));
    color: rgba(255, 247, 237, .92);
    font-size: .95rem;
    line-height: 1.38;
  }
  .dj-mission-quote::before {
    content: "“";
    position: absolute;
    left: 9px;
    top: 1px;
    color: rgba(253, 230, 138, .62);
    font: 42px/1 Georgia, serif;
  }
  .dj-mission-quote cite {
    display: block;
    margin-top: 8px;
    color: rgba(253, 230, 138, .74);
    font-style: normal;
    font-weight: 700;
    letter-spacing: .04em;
  }
  .dj-mission-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .dj-mission-stat {
    min-width: 0;
    display: grid;
    gap: 7px;
    padding: 15px;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, .09);
    background: rgba(255, 255, 255, .045);
  }
  .dj-mission-stat__icon {
    font-size: 21px;
    line-height: 1;
  }
  .dj-mission-stat strong {
    color: #fff;
    font-weight: 800;
    line-height: 1.18;
  }
  .dj-mission-stat > span:not(.dj-mission-stat__icon) {
    color: rgba(226, 232, 240, .64);
    font-size: .82rem;
    line-height: 1.38;
  }
  .dj-mission-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 2px;
  }
  .dj-mission-floater {
    justify-self: center;
    width: min(100%, 650px);
    min-height: 520px;
    display: grid;
    place-items: center;
    border-radius: 32px;
    overflow: visible;
  }
  .dj-mission-floater-glow {
    position: absolute;
    inset: 3%;
    border-radius: 999px;
    background:
      radial-gradient(circle, rgba(34, 211, 238, .42), transparent 57%),
      radial-gradient(circle at 38% 64%, rgba(168, 85, 247, .34), transparent 60%),
      radial-gradient(circle at 72% 42%, rgba(253, 230, 138, .16), transparent 52%);
    filter: blur(38px);
  }
  .dj-mission-floater-img {
    position: relative;
    z-index: 1;
    display: block;
    width: min(100%, 640px);
    height: auto;
    object-fit: contain;
    border-radius: 28px;
    filter:
      drop-shadow(0 34px 72px rgba(0, 0, 0, .52))
      drop-shadow(0 0 42px rgba(34, 211, 238, .32))
      drop-shadow(0 0 30px rgba(168, 85, 247, .2));
  }
  .dj-mission-panel:hover .dj-mission-floater-img {
    transform: translateY(-4px) scale(1.018);
  }

  /* ── Mobile adjustments ── */
  @media (max-width: 900px) {
    .dj-mission-panel {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .dj-mission-floater {
      order: -1;
      width: min(100%, 680px);
      min-height: auto;
      justify-self: center;
    }
    .dj-mission-floater-img {
      width: min(100%, 680px);
    }
