    border: 1px solid rgba(255, 255, 255, 0.18);
    transition: all .2s ease;
  }
  .hero-v2__cta-ghost:hover {
    border-color: rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.04);
  }

  .hero-v2__trust {
    margin-top: 44px;
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    font-size: .88rem;
    color: rgba(200, 205, 255, 0.48);
  }
  .hero-v2__trust span { display: inline-flex; align-items: center; gap: 6px; }
  .hero-v2__trust .check { color: #2dd4bf; font-weight: 800; }

  /* ── Visual mockup card ── */
  .hero-v2__visual {
    display: none;
    justify-content: center;
    align-items: center;
  }
  @media (min-width: 980px) {
    .hero-v2__visual,
    .hero-v2__mockup,
    .hero-v2__mockup-brand,
    .hero-v2__mockup-grid {
      min-width: 0;
    }
    .hero-v2__visual { display: flex; }
    .hero-v2__mockup--daily-grid .hero-v2__mockup-chip {
      width: min(500px, 100%);
    }
  }
  @media (min-width: 980px) and (max-width: 1199px) {
    .hero-v2__mockup--daily-grid .hero-v2__mockup-chip img {
      transform: scale(1);
    }
