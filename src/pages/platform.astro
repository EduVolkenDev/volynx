  .hero-v2__tag-copy span {
    color: rgba(220, 230, 255, 0.58);
    font-size: .67rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .hero-v2__mockup--daily-grid {
    max-width: 550px;
    min-height: 565px;
    padding: 40px;
    border-radius: 42px;
    border-color: rgba(255,255,255,.14);
    background:
      radial-gradient(circle at 50% 40%, rgba(4,255,231,.16), transparent 33%),
      radial-gradient(circle at 84% 20%, rgba(96,165,250,.18), transparent 34%),
      linear-gradient(145deg, rgba(255,255,255,.095), rgba(255,255,255,.025) 48%, rgba(3,7,18,.9));
    box-shadow:
      0 34px 110px rgba(0,0,0,.58),
      0 0 78px rgba(4,255,231,.08),
      inset 0 1px 0 rgba(255,255,255,.12);
