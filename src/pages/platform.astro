  /* ═══ HERO V2 — Premium Emotional ═══ */
  .hero-v2 {
    position: relative;
    min-height: calc(100vh - 74px);
    display: flex;
    align-items: center;
    padding: clamp(48px, 8vh, 96px) 0 clamp(40px, 6vh, 80px);
    overflow: hidden;
  }
  .hero-v2__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 80% at 50% 40%, rgba(20, 184, 166, 0.12) 0%, transparent 60%),
      radial-gradient(ellipse 40% 60% at 90% 90%, rgba(59, 130, 246, 0.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-v2__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 980px) {
    .hero-v2__inner { grid-template-columns: 1.3fr 1fr; gap: 56px; }
  }

  .hero-v2__copy { max-width: 720px; }

  .hero-v2__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: 999px;
    background: rgba(45, 212, 191, 0.08);
    border: 1px solid rgba(45, 212, 191, 0.25);
    margin-bottom: 24px;
    font-size: .82rem;
    font-weight: 600;
    color: #5eead4;
    letter-spacing: .02em;
  }
  .hero-v2__pill-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #2dd4bf;
    box-shadow: 0 0 8px #2dd4bf;
    animation: heroV2Pulse 2s ease-in-out infinite;
  }
  @keyframes heroV2Pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: .4; transform: scale(.85); }
  }

  .hero-v2__title {
    font-family: var(--display);
    font-size: clamp(2.2rem, 6vw, 4.2rem);
    font-weight: 700;
    letter-spacing: -.035em;
    line-height: 1.02;
    margin: 0 0 24px;
    color: #fff;
  }
  .hero-v2__title .gradient-text {
    background: linear-gradient(135deg, #2dd4bf, #22d3ee, #3b82f6);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    display: inline-block;
  }

  .hero-v2__desc {
    font-size: clamp(1rem, 1.7vw, 1.18rem);
    line-height: 1.42;
    color: rgba(209, 215, 230, 0.78);
    margin: 0 0 36px;
    max-width: min(100%, 54ch);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .hero-v2__actions {
    display: flex;
    gap: 14px;
    flex-direction: column;
  }
  @media (min-width: 640px) {
    .hero-v2__actions { flex-direction: row; }
  }

  .hero-v2__cta-main {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 36px;
    border-radius: 999px;
    background: #fff;
    color: #09090b;
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45), 0 6px 16px rgba(45, 212, 191, 0.1);
    transition: transform .2s ease, box-shadow .25s ease, background .2s;
  }
  .hero-v2__cta-main:hover {
    transform: scale(1.03);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.55), 0 10px 28px rgba(45, 212, 191, 0.25);
  }
  .hero-v2__cta-main:active { transform: scale(.97); }

  .hero-v2__cta-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 34px;
    border-radius: 999px;
    background: transparent;
    color: #fff;
    font-size: 1.05rem;
    font-weight: 600;
