    inset: 20px;
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 32px;
  }

  .hero-v2__mockup--daily-grid::after {
    inset: 9%;
    border: 1px solid rgba(255,255,255,.075);
    border-radius: 50%;
    box-shadow:
      0 0 0 84px rgba(255,255,255,.018),
      0 0 96px rgba(45,212,191,.08);
    mask-image: linear-gradient(180deg, #000 0%, #000 72%, transparent 100%);
  }

  .hero-v2__mockup--daily-grid .hero-v2__mockup-glow {
    inset: -28%;
    opacity: .82;
    background:
      radial-gradient(circle at 48% 42%, rgba(4,255,231,.22), transparent 32%),
      radial-gradient(circle at 22% 78%, rgba(45,212,191,.15), transparent 36%),
      radial-gradient(circle at 86% 78%, rgba(59,130,246,.18), transparent 38%);
