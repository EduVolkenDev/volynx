  .hero-v2__mockup-tag:focus-visible {
    outline: 2px solid #04ffe7;
    outline-offset: 2px;
  }
  .hero-v2__mockup-tag img {
    width: 54px;
    height: 54px;
    flex: 0 0 54px;
    object-fit: contain;
  }
  .hero-v2__tag-copy {
    min-width: 0;
    display: grid;
    gap: 5px;
  }
  .hero-v2__tag-copy strong {
    color: rgba(244,244,245,0.92);
    font-size: .88rem;
    font-weight: 850;
