  .hero-v2__mockup-grid--orbit .hero-v2__mockup-tag--decision { --icon-rotate: 5deg; }

  .hero-v2__mockup-grid--orbit .hero-v2__mockup-tag:hover {
    transform: translateY(-2px) scale(1.02);
    background:
      linear-gradient(145deg, rgba(4,255,231,.16), rgba(96,165,250,.08)),
