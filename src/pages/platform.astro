    <script is:inline>
      (function () {
        var nodes = Array.prototype.slice.call(document.querySelectorAll("[data-platform-reveal]"));
        if (!nodes.length) return;

        var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduceMotion || !("IntersectionObserver" in window)) {
          nodes.forEach(function (node) { node.classList.add("is-visible"); });
          return;
        }

        var viewportFloor = window.innerHeight * 0.82;
        nodes.forEach(function (node) {
          if (node.getBoundingClientRect().top > viewportFloor) node.setAttribute("data-reveal-ready", "");
          else node.classList.add("is-visible");
        });

        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        }, { rootMargin: "0px 0px -10% 0px", threshold: 0.08 });

        nodes.forEach(function (node) {
          if (node.hasAttribute("data-reveal-ready")) observer.observe(node);
        });
      })();
    </script>

