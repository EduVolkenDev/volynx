---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import FlagshipHeader from "../components/FlagshipHeader.astro";
import FlagshipFooter from "../components/FlagshipFooter.astro";
import PlatformAssistStrip from "../components/PlatformAssistStrip.astro";
import ServicesHighlight from "../components/platform/ServicesHighlight.astro";
import WorldFeature from "../components/platform/WorldFeature.astro";
import AdSlot from "../components/AdSlot.astro";
import { ROUTES, productPreviewHref } from "../data/routes";
import { productOfferPreviewBySlug } from "../data/product-offers";

const officialProductImages = {
  essential: productOfferPreviewBySlug["volynx-essential"].image,
  complete: productOfferPreviewBySlug["volynx-complete"].image,
  builderPro: "/assets/new-builder-icon.webp",
  cvitaeBusiness: productOfferPreviewBySlug["cvitae-business"].image,
  vxCore: productOfferPreviewBySlug["vx-core"].image,
  portfolioCommercial: "/assets/kits/portfolio-commercial.webp",
  propertyflowProfessional: "/assets/flow-professional.webp",
} as const;

const homeAssistItems = [
  { href: ROUTES.products, label: { en: "Explore", pt: "Explorar" }, title: { en: "Browse products", pt: "Ver produtos" }, copy: { en: "Jump straight into kits, tools, PropertyFlow and the Icons Store.", pt: "Vá direto para kits, ferramentas, PropertyFlow e Icons Store." }, emphasized: true, iconSrc: "/assets/allproducts.webp" },
  { href: ROUTES.daily, label: { en: "Workspace", pt: "Workspace" }, title: { en: "Open Daily", pt: "Abrir Daily" }, copy: { en: "Go back to My Day, Vault, Summary, Writing and the rest of the daily system.", pt: "Volte para My Day, Vault, Summary, Writing e o resto do sistema diário." }, iconSrc: "/assets/daily-icon.webp" },
  { href: ROUTES.delivery, label: { en: "Post-purchase", pt: "Pós-compra" }, title: { en: "My products", pt: "Meus produtos" }, copy: { en: "Recover downloads, check access and reopen purchased product paths.", pt: "Recupere downloads, verifique acessos e reabra os produtos comprados." }, iconSrc: "/assets/mybox.webp" },
  { href: ROUTES.support, label: { en: "Help", pt: "Ajuda" }, title: { en: "Open support", pt: "Abrir suporte" }, copy: { en: "Route launch, billing and access issues without losing context.", pt: "Direcione questões de lançamento, cobrança e acesso sem perder contexto." }, iconSrc: "/assets/support-gold.webp" },
  { href: ROUTES.launch2026, label: { en: "Launch", pt: "Lançamento" }, title: { en: "Replay launch page", pt: "Rever o lançamento" }, copy: { en: "Revisit the original cinematic launch page without making it the default platform path.", pt: "Reveja a página cinematográfica de lançamento sem transformar isso no caminho padrão da plataforma." }, iconSrc: "/assets/golaunch.webp" },
];
---
<FlagshipLayout title="VOLYNX Dev Hub — Build, operate and ship" pageClass="page-home">
  <FlagshipHeader current={ROUTES.platform} ctaLabel="Open Builder" ctaI18n="nav.open_builder" ctaHref={ROUTES.builder} />
  <main>

    <!-- ═══ HERO (v2 — premium emotional) ═══ -->
    <section class="hero-v2">
      <div class="hero-v2__bg" aria-hidden="true"></div>
      <div class="shell hero-v2__inner">
        <div class="hero-v2__copy">
          <div class="hero-v2__pill">
            <span class="hero-v2__pill-dot" aria-hidden="true"></span>
            <span class="i18n-en">Dev Hub · Build and launch</span>
            <span class="i18n-pt">Dev Hub · Crie e publique</span>
          </div>

          <h1 class="hero-v2__title" data-i18n-html="home2.hero_title_html">
            Crie sites, ferramentas e ativos digitais premium<br />
            <span class="gradient-text">com uma única conta VOLYNX</span>
          </h1>

          <p class="hero-v2__desc" data-i18n-html="home2.hero_subtitle_html">
            Comece grátis com Daily, CVitae e Lab — ou lance um site profissional com Builder e serviços sob medida.
          </p>

          <div class="hero-v2__actions">
            <a href="#ecosystem" class="hero-v2__cta-main" data-i18n="home2.btn_start_free">Começar grátis agora</a>
            <a href={ROUTES.products} class="hero-v2__cta-ghost" data-i18n="home2.btn_view_kits">Ver os produtos</a>
          </div>

          <div class="hero-v2__trust">
            <span><span class="check">✓</span> <span data-i18n="home2.trust_free">Free generoso</span></span>
            <span><span class="check">✓</span> <span data-i18n="home2.trust_no_card">Sem cartão até precisar</span></span>
            <span><span class="check">✓</span> <span data-i18n="home2.trust_pt">Suporte em português</span></span>
          </div>
        </div>

        <div class="hero-v2__visual">
          <div class="hero-v2__mockup hero-v2__mockup--daily-grid">
            <div class="hero-v2__mockup-glow" aria-hidden="true"></div>
            <div class="hero-v2__mockup-brand">
              <a href="https://daily.volynx.world/" class="hero-v2__mockup-chip" aria-label="Open VOLYNX Daily" data-i18n-aria="home2.mockup_daily_aria">
                <img src="/assets/volynx-daily.webp" alt="VOLYNX Daily" width="1920" height="1080" loading="eager" fetchpriority="high" decoding="async" />
              </a>
              <p class="hero-v2__mockup-title" data-i18n="home2.mockup_title">Seu dia mais inteligente e organizado começa aqui</p>
            </div>
            <div class="hero-v2__mockup-grid hero-v2__mockup-grid--orbit" aria-label="VOLYNX Daily tools">
              <a href="https://daily.volynx.world/tools/my-day/" class="hero-v2__mockup-tag hero-v2__mockup-tag--myday" style="--tag-delay: 120ms;">
                <img src="/assets/myday.webp" alt="" width="1080" height="1080" loading="lazy" decoding="async">
                <span class="hero-v2__tag-copy">
                  <strong>My Day</strong>
                  <span data-i18n="home2.mockup_myday_desc">Planeje prioridades e acompanhe seu foco do dia.</span>
                </span>
              </a>
              <a href="https://daily.volynx.world/tools/scanner/" class="hero-v2__mockup-tag hero-v2__mockup-tag--scanner" style="--tag-delay: 260ms;">
                <img src="/assets/scanner.webp" alt="" width="1275" height="1275" loading="lazy" decoding="async">
                <span class="hero-v2__tag-copy">
                  <strong>Scanner</strong>
                  <span data-i18n="home2.mockup_scanner_desc">Leia arquivos, imagens e notas sem perder contexto.</span>
                </span>
              </a>
              <a href="https://daily.volynx.world/tools/summary/" class="hero-v2__mockup-tag hero-v2__mockup-tag--summary" style="--tag-delay: 400ms;">
                <img src="/assets/summary.webp" alt="" width="1275" height="1275" loading="lazy" decoding="async">
                <span class="hero-v2__tag-copy">
                  <strong>Summary</strong>
                  <span data-i18n="home2.mockup_summary_desc">Transforme textos longos em resumo claro e acionável.</span>
                </span>
              </a>
              <a href="https://daily.volynx.world/tools/vault/" class="hero-v2__mockup-tag hero-v2__mockup-tag--vault" style="--tag-delay: 540ms;">
                <img src="/assets/vault.webp" alt="" width="1275" height="1275" loading="lazy" decoding="async">
                <span class="hero-v2__tag-copy">
                  <strong>Vault</strong>
                  <span data-i18n="home2.mockup_vault_desc">Guarde ideias e informações importantes em um só lugar.</span>
                </span>
              </a>
              <a href="https://daily.volynx.world/tools/writing/" class="hero-v2__mockup-tag hero-v2__mockup-tag--writing" style="--tag-delay: 680ms;">
                <img src="/assets/writing.webp" alt="" width="1275" height="1275" loading="lazy" decoding="async">
                <span class="hero-v2__tag-copy">
                  <strong>Writing</strong>
                  <span data-i18n="home2.mockup_writing_desc">Escreva, revise e refine mensagens com mais rapidez.</span>
                </span>
              </a>
              <a href="https://daily.volynx.world/tools/decision/" class="hero-v2__mockup-tag hero-v2__mockup-tag--decision" style="--tag-delay: 820ms;">
                <img src="/assets/decision.webp" alt="" width="1275" height="1275" loading="lazy" decoding="async">
                <span class="hero-v2__tag-copy">
                  <strong>Decision</strong>
                  <span data-i18n="home2.mockup_decision_desc">Compare opções e tome decisões com mais clareza.</span>
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <PlatformAssistStrip eyebrow={{ en: "Platform flow", pt: "Fluxo da plataforma" }} title={{ en: "Already inside VOLYNX?", pt: "Já dentro do VOLYNX?" }} description={{ en: "Move between discovery, daily work, purchases and support without hunting through the navigation.", pt: "Navegue entre descoberta, trabalho diário, compras e suporte sem caçar na navegação." }} items={homeAssistItems} />

    <!-- ═══ REVENUE NOW ═══ -->
    <section class="page-section revenue-now-section" aria-label="Featured VOLYNX products">
      <div class="shell revenue-now">
        <div class="revenue-now__head">
          <span class="label label--pro">
            <span class="i18n-en">Popular starting points</span>
            <span class="i18n-pt">Pontos de partida populares</span>
          </span>
          <h2>
            <span class="i18n-en">Explore first. Decide when you are ready.</span>
            <span class="i18n-pt">Explore primeiro. Decida quando estiver pronto.</span>
          </h2>
          <p>
            <span class="i18n-en">See what each product includes, who it is for and how it fits your work before you buy.</span>
            <span class="i18n-pt">Veja o que cada produto inclui, para quem ele é e como se encaixa no seu trabalho antes de comprar.</span>
          </p>
        </div>

        <div class="revenue-now__grid">
          <article class="revenue-card revenue-card--primary">
            <img src={officialProductImages.essential} alt="" class="revenue-card__icon" loading="lazy" decoding="async" />
            <span class="revenue-card__kicker">Best first subscription</span>
            <h3>VOLYNX Essential</h3>
            <p><span class="i18n-en">Builder Pro + Daily Pro in one subscription. A strong choice for creators who build and organise every day.</span><span class="i18n-pt">Builder Pro + Daily Pro em uma assinatura. Uma ótima escolha para criadores que constroem e se organizam todos os dias.</span></p>
            <strong class="revenue-card__price"><span class="i18n-en">£35 / month</span><span class="i18n-pt">£35 / mês</span></strong>
            <a href={productPreviewHref("bundle_volynx_daily_pro")} class="button button--gold">
              <span class="i18n-en">View Essential</span>
              <span class="i18n-pt">Ver Essential</span>
            </a>
          </article>

          <article class="revenue-card">
            <img src={officialProductImages.builderPro} alt="" class="revenue-card__icon" loading="lazy" decoding="async" />
            <span class="revenue-card__kicker">Publish</span>
            <h3>Builder Pro</h3>
            <p><span class="i18n-en">Custom domain, selected premium kits, faster publishing and no VOLYNX branding.</span><span class="i18n-pt">Domínio próprio, kits premium selecionados, publicação mais rápida e remoção da marca VOLYNX.</span></p>
            <strong class="revenue-card__price"><span class="i18n-en">£24 / month</span><span class="i18n-pt">£24 / mês</span></strong>
            <a href={productPreviewHref("builder_pro")} class="button button--ghost">
              <span class="i18n-en">View Builder Pro</span>
              <span class="i18n-pt">Ver Builder Pro</span>
            </a>
          </article>

          <article class="revenue-card">
            <img src={officialProductImages.vxCore} alt="" class="revenue-card__icon" loading="lazy" decoding="async" />
            <span class="revenue-card__kicker">Extra VX</span>
            <h3>32 VX Core</h3>
            <p><span class="i18n-en">One-time VX for selected exports, templates and Studio features. No subscription change.</span><span class="i18n-pt">VX avulso para exportações, modelos e recursos Studio selecionados. Sem trocar assinatura.</span></p>
            <strong class="revenue-card__price"><span class="i18n-en">£18 one-time</span><span class="i18n-pt">£18 único</span></strong>
            <a href={productPreviewHref("tokens_core")} class="button button--ghost">
              <span class="i18n-en">Review VX Core</span>
              <span class="i18n-pt">Ver VX Core</span>
            </a>
          </article>

          <article class="revenue-card">
            <img src={officialProductImages.portfolioCommercial} alt="" class="revenue-card__icon revenue-card__icon--wide" loading="lazy" decoding="async" />
            <span class="revenue-card__kicker">One-time kit</span>
            <h3>Portfolio Pro Kit</h3>
            <p><span class="i18n-en">A direct product path for users who want one premium asset now instead of a subscription first.</span><span class="i18n-pt">Um caminho direto para quem quer um ativo premium agora, antes de uma assinatura.</span></p>
            <strong class="revenue-card__price"><span class="i18n-en">One-time checkout</span><span class="i18n-pt">Checkout avulso</span></strong>
            <a href={productPreviewHref("kit_portfolio_commercial")} class="button button--ghost">
              <span class="i18n-en">View the kit</span>
              <span class="i18n-pt">Ver o kit</span>
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- ═══ CHOOSE YOUR PATH ═══ -->
    <section class="page-section pathfinder-section" id="choose-path" aria-label="Choose your VOLYNX path">
      <div class="shell pathfinder">
        <div class="pathfinder__intro">
          <span class="label label--pro">
            <span class="i18n-en">Choose your path</span>
            <span class="i18n-pt">Escolha seu caminho</span>
          </span>
          <h2>
            <span class="i18n-en">One ecosystem. Multiple ways to create results.</span>
            <span class="i18n-pt">Um ecossistema. Várias formas de gerar resultado.</span>
          </h2>
          <p>
            <span class="i18n-en">Start from the outcome, not from the tool list. VOLYNX routes each profile to the product mix most likely to produce value today.</span>
            <span class="i18n-pt">Comece pelo resultado, não pela lista de ferramentas. A VOLYNX direciona cada perfil para a combinação com maior chance de gerar valor hoje.</span>
          </p>
        </div>

        <div class="pathfinder__grid">
          <article class="path-card path-card--creator">
            <img src={officialProductImages.essential} alt="" class="path-card__icon" loading="lazy" decoding="async" />
            <span class="path-card__persona">Creator</span>
            <h3><span class="i18n-en">Launch, publish and run your day.</span><span class="i18n-pt">Lance, publique e organize seu dia.</span></h3>
            <p><span class="i18n-en">Best fit: Builder Pro + Daily Pro. The existing Essential bundle is the cleanest first paid step.</span><span class="i18n-pt">Melhor encaixe: Builder Pro + Daily Pro. O bundle Essential já é o primeiro passo pago mais claro.</span></p>
            <ul>
              <li>Builder Pro</li>
              <li>Daily Pro</li>
              <li><span class="i18n-en">Portfolio kit optional</span><span class="i18n-pt">Portfolio opcional</span></li>
            </ul>
            <a href={productPreviewHref("bundle_volynx_daily_pro")} class="button button--gold">
              <span class="i18n-en">View Essential</span>
              <span class="i18n-pt">Ver Essential</span>
            </a>
          </article>

          <article class="path-card path-card--freelancer">
            <img src={officialProductImages.cvitaeBusiness} alt="" class="path-card__icon" loading="lazy" decoding="async" />
            <span class="path-card__persona">Freelancer Premium</span>
            <h3><span class="i18n-en">Look credible before the first conversation.</span><span class="i18n-pt">Pareça confiável antes da primeira conversa.</span></h3>
            <p><span class="i18n-en">Best fit: CVitae Business + Builder Pro + Icons. Start by upgrading the career asset, then add the public presence.</span><span class="i18n-pt">Melhor encaixe: CVitae Business + Builder Pro + Icons. Comece pelo ativo de carreira e depois adicione presença pública.</span></p>
            <ul>
              <li>CVitae Business</li>
              <li>Builder Pro</li>
              <li>Icons Store</li>
            </ul>
            <a href={productPreviewHref("cvitae_business")} class="button button--gold">
              <span class="i18n-en">View CVitae Business</span>
              <span class="i18n-pt">Ver CVitae Business</span>
            </a>
          </article>

          <article class="path-card path-card--realestate">
            <img src={officialProductImages.propertyflowProfessional} alt="" class="path-card__icon path-card__icon--wide" loading="lazy" decoding="async" />
            <span class="path-card__persona"><span class="i18n-en">Real Estate</span><span class="i18n-pt">Imobiliário</span></span>
            <h3><span class="i18n-en">Sell listings with a sharper digital surface.</span><span class="i18n-pt">Venda imóveis com uma presença digital mais forte.</span></h3>
            <p><span class="i18n-en">Best fit: PropertyFlow Professional + premium icons + Lumina. This is the strongest niche path today.</span><span class="i18n-pt">Melhor encaixe: PropertyFlow Professional + icons premium + Lumina. É o caminho de nicho mais forte agora.</span></p>
            <ul>
              <li>PropertyFlow Professional</li>
              <li>Icons Premium</li>
              <li>Lumina Presets</li>
            </ul>
            <a href={productPreviewHref("pf_professional")} class="button button--gold">
              <span class="i18n-en">View PropertyFlow</span>
              <span class="i18n-pt">Ver PropertyFlow</span>
            </a>
          </article>

          <article class="path-card path-card--team">
            <img src={officialProductImages.complete} alt="" class="path-card__icon" loading="lazy" decoding="async" />
            <span class="path-card__persona"><span class="i18n-en">Small Business / Team</span><span class="i18n-pt">Small Business / Equipe</span></span>
            <h3><span class="i18n-en">Build, publish and organise everything in one place.</span><span class="i18n-pt">Construa, publique e organize tudo em um só lugar.</span></h3>
            <p><span class="i18n-en">Best fit: Builder Studio + Daily Diamond. Complete brings our most powerful creative and planning tools together.</span><span class="i18n-pt">Melhor encaixe: Builder Studio + Daily Diamond. Complete reúne nossas ferramentas mais poderosas de criação e organização.</span></p>
            <ul>
              <li>Builder Studio</li>
              <li>Daily Diamond</li>
              <li><span class="i18n-en">Priority support</span><span class="i18n-pt">Suporte prioritário</span></li>
            </ul>
            <a href={productPreviewHref("bundle_volynx_daily_studio")} class="button button--gold">
              <span class="i18n-en">View Complete</span>
              <span class="i18n-pt">Ver Complete</span>
            </a>
          </article>
        </div>
      </div>
    </section>

    <section class="page-section platform-sponsored">
      <div class="shell">
        <AdSlot
          eyebrow={{ en: "Sponsored placement", pt: "Espaço patrocinado" }}
          title={{ en: "A place for carefully selected partners", pt: "Um espaço para parceiros selecionados" }}
          description={{ en: "Reserved for useful partner messages and offers that complement the VOLYNX experience.", pt: "Reservado para mensagens e ofertas úteis de parceiros que complementem a experiência VOLYNX." }}
        />
      </div>
    </section>

    <!-- floating: Ecosystem -->
    <div class="section-float section-float--right" aria-hidden="true">
      <img src="/assets/ecosystem.webp" alt="" loading="lazy" />
    </div>

    <!-- ═══ REDEEM CODE WIDGET ═══ -->
    <section class="page-section redeem-section" id="redeem" aria-label="Redeem code">
      <div class="shell">
        <article class="panel redeem-panel">
          <div class="redeem-copy">
            <span class="redeem-eyebrow">
              <span class="redeem-dot" aria-hidden="true"></span>
              <span class="i18n-en">Have a code or invite?</span>
              <span class="i18n-pt">Tem um código ou convite?</span>
            </span>
            <h2 class="redeem-title">
              <span class="i18n-en">Apply your voucher</span>
              <span class="i18n-pt">Use seu voucher</span>
            </h2>
            <p class="redeem-desc">
              <span class="i18n-en">Black Diamond invite, discount code, VX grant or kit unlock — paste it below.</span>
              <span class="i18n-pt">Convite Black Diamond, código de desconto, VX bônus ou unlock de kit — cole aqui.</span>
            </p>
          </div>
          <form class="redeem-form" id="redeemForm" autocomplete="off">
            <label for="redeemCode" class="visually-hidden">
              <span class="i18n-en">Voucher code</span>
              <span class="i18n-pt">Código do voucher</span>
            </label>
            <input
              type="text"
              id="redeemCode"
              name="code"
              placeholder="BD-XXXXXXXX"
              maxlength="40"
              autocapitalize="characters"
              spellcheck="false"
              required
            />
            <button type="submit" id="redeemBtn" class="button button--gold">
              <span class="i18n-en">Apply</span>
              <span class="i18n-pt">Aplicar</span>
            </button>
            <p class="redeem-msg" id="redeemMsg" aria-live="polite"></p>
          </form>
        </article>
      </div>
    </section>

    <script is:inline>
      (function () {
        var form = document.getElementById("redeemForm");
        if (!form) return;
        var input = document.getElementById("redeemCode");
        var btn = document.getElementById("redeemBtn");
        var msg = document.getElementById("redeemMsg");

        // Pre-fill from ?code= (handles login redirect flow)
        try {
          var params = new URLSearchParams(location.search);
          var pre = params.get("code");
          if (pre) input.value = pre.toUpperCase();
        } catch (_) {}

        function getToken() {
          try { return localStorage.getItem("volynx_access_token") || ""; } catch (_) { return ""; }
        }

        async function getApiBase() {
          try {
            var cfg = await fetch("/config.json", { cache: "no-store" }).then(function (r) { return r.json(); });
            return (cfg.functionsUrl || "").replace(/\/$/, "");
          } catch (_) { return ""; }
        }

        function setMsg(text, kind) {
          msg.textContent = text || "";
          msg.dataset.kind = kind || "";
        }

        function describeGrants(grants) {
          if (!grants || typeof grants !== "object") return "";
          var parts = [];
          if (grants.tokens) parts.push(grants.tokens + " VX");
          if (grants.builder_plan) parts.push("Builder " + grants.builder_plan);
          if (grants.daily_plan) parts.push("Daily " + grants.daily_plan);
          if (grants.plan) parts.push(String(grants.plan).charAt(0).toUpperCase() + String(grants.plan).slice(1));
          if (grants.duration_days) parts.push("(" + grants.duration_days + "d)");
          if (grants.kit_id) parts.push("Kit " + grants.kit_id);
          if (grants.discount_pct) parts.push(grants.discount_pct + "% off");
          if (grants.badge) parts.push(grants.badge + " badge");
          return parts.join(" · ");
        }

        form.addEventListener("submit", async function (e) {
          e.preventDefault();
          var code = (input.value || "").trim().toUpperCase();
          if (!code) return;
          input.value = code;

          var token = getToken();
          if (!token) {
            // Not logged in: bounce to login, preserve code via query param
            var next = "/?code=" + encodeURIComponent(code);
            location.assign("/login/?next=" + encodeURIComponent("/?code=" + code));
            return;
          }

          btn.disabled = true;
          setMsg(document.documentElement.lang.startsWith("pt") ? "Aplicando..." : "Applying...", "info");

          try {
            var apiBase = await getApiBase();
            if (!apiBase) {
              setMsg("API unavailable", "err");
              btn.disabled = false;
              return;
            }
            var res = await fetch(apiBase + "/redeem-voucher", {
              method: "POST",
              headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
              body: JSON.stringify({ code: code }),
            });
            var data = await res.json().catch(function () { return {}; });

            if (data && data.ok) {
              var grantsTxt = describeGrants(data.grants_applied);
              var label = document.documentElement.lang.startsWith("pt")
                ? (grantsTxt ? "Aplicado: " + grantsTxt : "Voucher aplicado!")
                : (grantsTxt ? "Applied: " + grantsTxt : "Voucher applied!");
              setMsg(label, "ok");
              input.value = "";

              // Update tier cache immediately so premium attrs flip without
              // waiting for next check-permission cycle (zero-flash upgrade UX).
              try {
                if (window.VxPlan) {
                  var existing = window.VxPlan.getCachedRelaxed
                    ? window.VxPlan.getCachedRelaxed()
                    : { plan: 'free', isBlackDiamond: false };
                  var ga = data.grants_applied || {};
                  var nextPlan = ga.builder_plan || ga.daily_plan || ga.plan || existing.plan;
                  var becameBD = ga.badge === 'black_diamond';
                  window.VxPlan.cache({
                    plan: nextPlan,
                    isBlackDiamond: becameBD || existing.isBlackDiamond,
                  });
                  if (typeof window.VxPlan.applyTierAttrs === 'function') {
                    window.VxPlan.applyTierAttrs();
                  }
                }
              } catch (_) {}
            } else {
              var err = (data && (data.error || data.message)) || ("HTTP " + res.status);
              var errMap = {
                voucher_not_found: { en: "Code not found.", pt: "Código não encontrado." },
                voucher_expired: { en: "Code expired.", pt: "Código expirado." },
                voucher_exhausted: { en: "Code already used up.", pt: "Código já foi usado." },
                voucher_inactive: { en: "Code is not active.", pt: "Código não está ativo." },
                target_email_mismatch: { en: "This code was issued for another email.", pt: "Esse código foi emitido para outro email." },
                already_redeemed: { en: "You already redeemed this code.", pt: "Você já usou esse código." },
              };
              var pt = document.documentElement.lang.startsWith("pt");
              var msgTxt = errMap[err]
                ? (pt ? errMap[err].pt : errMap[err].en)
                : (pt ? "Erro: " + err : "Error: " + err);
              setMsg(msgTxt, "err");
            }
          } catch (err) {
            setMsg("Network error", "err");
          } finally {
            btn.disabled = false;
          }
        });
      })();
    </script>

