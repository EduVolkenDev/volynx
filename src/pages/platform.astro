  .hero-v2__mockup {
    position: relative;
    width: 100%;
    max-width: 540px;
    min-height: 760px;
    border-radius: 32px;
    border: 1px solid rgba(244,244,245,0.1);
    padding: 24px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    align-content: start;
    box-shadow: 0 30px 80px rgba(0,0,0,0.6),inset 0 1px 0 rgba(255,255,255,0.05);
    overflow: hidden;
  }
  .hero-v2__mockup-glow {
    position: absolute;
    inset: -40%;
    background:
      radial-gradient(circle at 30% 20%, rgba(45, 212, 191, 0.3), transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(59, 130, 246, 0.2), transparent 50%);
    pointer-events: none;
    animation: heroV2Float 8s ease-in-out infinite;
  }
  @keyframes heroV2Float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-10px, 10px); }
  }
  .hero-v2__mockup-brand {
    grid-column: 1 / -1;
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 4px 0 6px;
  }

  .hero-v2__mockup-chip {
    display: block;
    width: min(480px, 90vw);
    max-height: 250px;
    margin: 0 auto;
    padding: 0;
    text-decoration: none;
    transition: transform .25s ease, filter .25s ease;
  }
  .hero-v2__mockup-chip img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    transform: scale(1.24);
    transform-origin: center center;
  }
  .hero-v2__mockup-chip:hover {
    transform: translateY(-2px) scale(1.02);
    filter: drop-shadow(0 8px 24px rgba(4, 255, 231, 0.25));
  }

  .hero-v2__mockup-title {
    position: relative;
    z-index: 2;
    max-width: 24ch;
    margin: 0;
    font-size: 1.08rem;
    font-weight: 700;
    color: #e9f9f7;
    line-height: 1.22;
    text-align: center;
  }

  .hero-v2__mockup-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .hero-v2__mockup-tag {
    min-width: 0;
    padding: 12px 12px 11px;
    border-radius: 24px;
    background: rgba(244,244,245,0.04);
    border: 1px solid rgba(244,244,245,0.08);
    color: rgba(244,244,245,0.85);
    backdrop-filter: blur(10px);
    display: flex;
    position: relative;
    align-items: flex-start;
    gap: 8px;
    text-decoration: none;
    cursor: pointer;
    transition: transform .2s ease, background .2s ease, border-color .2s ease, color .2s ease, box-shadow .2s ease;
  }
  .hero-v2__mockup-tag:hover {
    transform: translateY(-2px);
    background: rgba(4, 255, 231, 0.08);
    border-color: rgba(4, 255, 231, 0.35);
    color: #fff;
    box-shadow: 0 8px 24px rgba(4, 255, 231, 0.14);
