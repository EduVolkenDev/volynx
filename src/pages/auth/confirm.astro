---
const title = "E-mail confirmado • VOLYNX";
---

<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="theme-color" content="#080610" />
</head>

<body style="margin:0;min-height:100vh;background:url('/assets/Purple-Universe.jpg') center center / cover no-repeat fixed;color:white;font-family:Inter, Arial, sans-serif;display:grid;place-items:center;padding:24px;">
  <main style="width:100%;max-width:560px;background:rgba(255,255,255,.04);border:3px outset rgba(255,255,255,.08);border-radius:24px;padding:32px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.35); backdrop-filter:blur(10px);">
    <div id="icon" style="width:100px;height:72px;border-radius:999px;margin:0 auto 18px;display:grid;place-items:center;background:linear-gradient(180deg,#090105,#7a163f,#090105);font-size:32px;">
      ⏳
    </div>

    <h1 id="title" style="margin:0 0 12px;font-size:28px;line-height:1.1;">
      Verificando e-mail…
    </h1>

    <p id="msg" style="margin:0 0 20px;color:rgba(255,255,255,.72);font-size:16px;line-height:1.6;">
      Aguarde um momento.
    </p>

    <a
      id="btn"
      href="/login"
      style="display:none;align-items:center;justify-content:center;padding:12px 18px;border-radius:14px;background:#6d123f;color:white;text-decoration:none;font-weight:600;"
    >
      Ir para o login
    </a>
  </main>

  <script type="module" src="/scripts/auth-confirm.js"></script>
</body>
</html>