---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VxHeader from "../../components/VxHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const title = "Email Confirmation — VOLYNX";
---

<BaseLayout title={title}>
  <VxHeader primaryCtaLabel="Sign in" primaryCtaHref="/login/" />

  <div class="confirm-bg" aria-hidden="true">
    <video
      class="bg-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/assets/login-bg-poster.webp"
    >
      <source src="/assets/login-bg2.mp4" type="video/mp4" />
    </video>
  </div>

  <main class="shell confirm">
    <section class="wrap">
      <div class="panel">
        <div class="confirm-content">
          <div class="confirm-icon" id="confirmIcon">
            <div class="spinner" id="confirmSpinner"></div>
          </div>

          <h1 id="confirmTitle" data-i18n="auth.verifying_title">Verifying your email...</h1>
          <p id="confirmMsg" class="confirm-msg" data-i18n="auth.verifying_msg">Please wait a moment.</p>
          <p id="confirmCountdown" class="confirm-countdown" hidden></p>

          <a
            id="confirmBtn"
            class="btn primary"
            href="/login/"
            hidden
            data-i18n="auth.btn_login"
          >
            Sign in now
          </a>

          <a
            id="confirmBtnRetry"
            class="btn secondary"
            href="/signup/"
            hidden
            data-i18n="auth.error_btn"
          >
            Try again
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script is:inline type="module" src="/scripts/auth-confirm.js"></script>

<style>
  @import "../../styles/home.css";
  @import "../../styles/services.css";

  .confirm-bg{
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .bg-video{
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.03);
    filter: contrast(1.05) saturate(1.05);
  }

  .confirm{
    min-height: calc(100svh - 80px);
    display: grid;
    place-items: center;
    padding: 34px 0 70px;
  }
  .wrap{ width: min(520px, 92vw); }
  .panel{
    border-radius: 26px;
    padding: 22px;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(10,12,20,.52);
    backdrop-filter: blur(14px);
  }

  .confirm-content{
    text-align: center;
    padding: 16px 0 4px;
  }

  .confirm-icon{
    width: 72px;
    height: 72px;
    margin: 0 auto 20px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    font-size: 32px;
    line-height: 1;
    transition: background .3s, border-color .3s;
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.08);
  }
  .confirm-icon.is-success{
    background: rgba(140, 255, 210, .08);
    border-color: rgba(140, 255, 210, .22);
    color: rgba(140, 255, 210, .95);
  }
  .confirm-icon.is-error{
    background: rgba(255, 140, 140, .08);
    border-color: rgba(255, 140, 140, .22);
    color: rgba(255, 140, 140, .95);
  }

  /* Spinner */
  .spinner{
    width: 28px;
    height: 28px;
    border: 3px solid rgba(255,255,255,.12);
    border-top-color: rgba(140, 255, 210, .7);
    border-radius: 999px;
    animation: spin .7s linear infinite;
  }
  .spinner[hidden]{ display: none; }
  @keyframes spin{ to{ transform: rotate(360deg); } }

  h1{
    margin: 0 0 10px;
    font-size: 24px;
  }
  .confirm-msg{
    margin: 0 0 8px;
    color: rgba(255,255,255,.78);
    line-height: 1.6;
  }
  .confirm-countdown{
    margin: 0 0 18px;
    font-size: 13px;
    color: rgba(255,255,255,.45);
  }

  .btn{
    display: inline-flex;
    justify-content: center;
    padding: 12px 18px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.12);
    text-decoration: none;
    cursor: pointer;
    margin-top: 8px;
  }
  .btn.primary{ font-weight: 700; }
  .btn.secondary{
    opacity: .85;
    font-size: 13px;
    margin-top: 10px;
  }

  @media (prefers-reduced-motion: reduce){
    .bg-video{ display:none; }
    .confirm-bg{
      background-image: url("/assets/login-bg-poster.webp");
      background-size: cover;
      background-position: center;
    }
    .spinner{ animation: none; }
  }
</style>
