---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VxHeader from "../../components/VxHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { ROUTES } from "../../data/routes";

const title = "Reset Password — VOLYNX";
---

<BaseLayout title={title}>
  <VxHeader primaryCtaLabel="Sign up" primaryCtaI18n="header.cta_signup" primaryCtaHref={ROUTES.signup} />

  <main class="shell recover">
    <section class="recover-wrap">
      <div class="panel">
        <div id="requestState">
          <h1 data-i18n="recover.title">Reset your password</h1>
          <p class="sub" data-i18n="recover.desc">Enter your email and we'll send you a link to reset your password.</p>

          <form class="form" id="recoverForm" action="#" method="get">
            <label class="field">
              <span data-i18n="recover.email_label">Email</span>
              <input type="email" id="email" name="email" autocomplete="email" required placeholder="your@email.com" data-i18n-placeholder="recover.email_placeholder" />
            </label>

            <button class="btn primary" id="submitBtn" type="submit" data-i18n="recover.btn_send">Send reset link</button>

            <p id="msg" class="msg" aria-live="polite"></p>

            <div class="row">
              <a class="link" href={ROUTES.login} data-i18n="recover.back_login">Back to login</a>
              <a class="link" href={ROUTES.signup} data-i18n="recover.create_account">Create account</a>
            </div>
          </form>
        </div>

        <div id="sentState" hidden>
          <div class="check-icon" aria-hidden="true">✉</div>
          <h1 data-i18n="recover.sent_title">Check your inbox</h1>
          <p class="sub" data-i18n="recover.sent_desc">We sent a password reset link to <span id="sentEmail"></span>. Click the link to set a new password.</p>
          <p class="hint" data-i18n="recover.sent_hint">Didn't receive it? Check your spam folder or try again.</p>
          <a class="btn primary" href={ROUTES.login} data-i18n="recover.back_login">Back to login</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script is:inline type="module">
  async function loadConfig() {
    const res = await fetch("/config.json", { cache: "no-store" });
    if (!res.ok) throw new Error("config.json not found.");
    return await res.json();
  }

  function t(key, fallback) {
    try {
      const lang = localStorage.getItem("volynx_lang") || "en";
      const dict = (window.VX_TRANS && window.VX_TRANS[lang]) || {};
      return dict[key] || fallback;
    } catch (_) {
      return fallback;
    }
  }

  const form = document.getElementById("recoverForm");
  const emailEl = document.getElementById("email");
  const btn = document.getElementById("submitBtn");
  const msg = document.getElementById("msg");

  if (form && emailEl && btn && msg) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = emailEl.value.trim();
      if (!email) {
        msg.textContent = t("recover.msg_enter_email", "Please enter your email.");
        msg.className = "msg err";
        return;
      }

      btn.disabled = true;
      msg.textContent = t("recover.msg_sending", "Sending reset link...");
      msg.className = "msg";

      try {
        const cfg = await loadConfig();
        const res = await fetch(`${cfg.supabaseUrl}/auth/v1/recover`, {
          method: "POST",
          headers: { apikey: cfg.supabaseAnonKey, "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });

        if (res.status === 429) {
          throw new Error(t("recover.msg_rate_limited", "Too many attempts. Please wait a minute and try again."));
        }

        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.error_description || data.msg || t("recover.msg_failed", "Failed to send reset link."));
        }

        // Show success
        document.getElementById("requestState").hidden = true;
        document.getElementById("sentState").hidden = false;
        document.getElementById("sentEmail").textContent = email;

      } catch (err) {
        msg.textContent = err.message || t("recover.msg_unknown", "Something went wrong.");
        msg.className = "msg err";
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  @import "../../styles/home.css";
  @import "../../styles/services.css";

  .recover {
    min-height: calc(100svh - 80px);
    display: grid;
    place-items: center;
    padding: 34px 0 70px;
  }
  .recover-wrap { width: min(480px, 92vw); }

  .panel {
    border-radius: 26px;
    padding: 28px;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(10,12,20,.52);
    backdrop-filter: blur(14px);
  }
  h1 { margin: 0 0 8px; font-size: clamp(22px, 4vw, 28px); }
  .sub { margin: 0 0 20px; opacity: .75; font-size: 15px; line-height: 1.55; }
  .hint { font-size: 13px; opacity: .5; margin: 12px 0 20px; }

  .msg { min-height: 18px; margin: 0 0 6px; font-size: 13px; opacity: .92; }
  .msg.err { color: rgba(255,140,140,.95); }
  .msg.ok { color: rgba(140,255,210,.92); }

  .form { display: grid; gap: 14px; }
  .field { display: grid; gap: 8px; }
  .field span { font-size: 13px; opacity: .82; }

  input {
    width: 100%;
    padding: 13px 16px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(0,0,0,.18);
    color: inherit;
    outline: none;
    font-size: 15px;
  }
  input:focus { border-color: rgba(125,211,252,.35); }
  input:focus-visible {
    outline: 2px solid rgba(130, 220, 255, 0.6);
    outline-offset: 2px;
  }

  .btn {
    display: inline-flex;
    justify-content: center;
    padding: 13px 16px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.12);
    text-decoration: none;
    cursor: pointer;
    font-weight: 700;
    font-size: 15px;
    background: none;
    color: inherit;
    font-family: inherit;
  }
  .btn.primary {
    background: rgba(125,211,252,.1);
    border-color: rgba(125,211,252,.25);
  }
  .btn.primary:hover {
    background: rgba(125,211,252,.18);
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    opacity: .7;
  }
  .link { text-decoration: none; }
  .link:hover { opacity: 1; }

  .check-icon {
    font-size: 40px;
    text-align: center;
    margin-bottom: 16px;
  }

  #sentState { text-align: center; }
</style>
