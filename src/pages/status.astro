---
import BaseLayout from "../layouts/BaseLayout.astro";
import VxHeader from "../components/VxHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
const title = "Status — VOLYNX";
---

<BaseLayout title={title}>
  <VxHeader />

  <main class="shell status">
    <section class="hero">
      <h1 data-i18n="status.title">Status</h1>
      <p class="sub" data-i18n="status.subtitle">Transparency builds trust. Here’s the current platform health.</p>
    </section>

    <section class="panel">
      <h2 data-i18n="status.services_heading">Services</h2>
      <div class="svc-grid">
        <div class="svc">
          <span class="svc-name" data-i18n="status.svc_website">Website</span>
          <span class="pill operational" data-i18n="status.operational">Operational</span>
        </div>
        <div class="svc">
          <span class="svc-name">Volynx Lab</span>
          <span class="pill operational" data-i18n="status.operational">Operational</span>
        </div>
        <div class="svc">
          <span class="svc-name">Studio (Pro)</span>
          <span class="pill planned" data-i18n="status.planned">Planned</span>
        </div>
        <div class="svc">
          <span class="svc-name">QR Generator</span>
          <span class="pill operational" data-i18n="status.operational">Operational</span>
        </div>
        <div class="svc">
          <span class="svc-name">Converter</span>
          <span class="pill operational" data-i18n="status.operational">Operational</span>
        </div>
        <div class="svc">
          <span class="svc-name">Image Scaler</span>
          <span class="pill operational" data-i18n="status.operational">Operational</span>
        </div>
        <div class="svc">
          <span class="svc-name">Image Suite</span>
          <span class="pill beta">Beta</span>
        </div>
      </div>
    </section>

    <section class="panel">
      <h2 data-i18n="status.incidents_heading">Recent incidents</h2>
      <div class="inc-grid">
        <article class="inc">
          <div class="inc-top">
            <span class="pill resolved" data-i18n="status.resolved">Resolved</span>
            <time datetime="2026-02-24">2026-02-24</time>
          </div>
          <h3 data-i18n="status.inc1_title">Deployment migration completed</h3>
          <p data-i18n="status.inc1_body">All routes served from Cloudflare Pages. No ongoing impact.</p>
        </article>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  @import "../styles/legal.css";
  @import "../styles/services.css";

  .status .hero { padding: 48px 0 18px; }
  .status .sub { opacity: .85; max-width: 70ch; }

  .panel {
    margin: 18px 0;
    border-radius: 22px;
    padding: 18px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(10,12,20,.45);
  }

  .svc-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 12px; margin-top: 10px; }
  .svc {
    grid-column: span 6;
    display: flex; justify-content: space-between; align-items: center;
    border-radius: 16px;
    padding: 12px 14px;
    border: 1px solid rgba(255,255,255,.06);
    background: rgba(0,0,0,.18);
  }
  .svc-name { opacity: .9; }

  .inc-grid { display: grid; gap: 12px; margin-top: 10px; }
  .inc { border-radius: 18px; padding: 14px; border: 1px solid rgba(255,255,255,.06); background: rgba(0,0,0,.18); }
  .inc-top { display: flex; justify-content: space-between; align-items: center; opacity: .85; }
  .inc h3 { margin: 10px 0 6px; }
  .inc p { margin: 0; opacity: .85; }

  .pill {
    display: inline-flex; padding: 6px 10px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,.14); font-size: 12px;
  }
  .operational { }
  .beta { opacity: .9; }
  .planned { opacity: .75; }
  .resolved { }

  @media (max-width: 860px) {
    .svc { grid-column: span 12; }
  }
</style>