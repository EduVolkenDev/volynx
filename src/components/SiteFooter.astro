---
// SiteFooter — universal legal footer strip for all Volynx pages
import { ROUTES } from "../data/routes";
---

<footer class="vx-site-footer">
  <div class="vx-site-footer__inner">
    <span class="vx-site-footer__copy">© {new Date().getFullYear()} VOLYNX</span>
    <nav class="vx-site-footer__links" aria-label="Legal links">
      <a href={ROUTES.home} data-i18n="footer.home">Home</a>
      <a href={ROUTES.about} data-i18n="footer.about">About</a>
      <a href={ROUTES.services} data-i18n="footer.services">Services</a>
      <a href={ROUTES.products} data-i18n="footer.products">Products</a>
      <a href={ROUTES.contact} data-i18n="footer.contact">Contact</a>
      <a href={ROUTES.privacy} data-i18n="footer.privacy">Privacy</a>
      <a href={ROUTES.terms} data-i18n="footer.terms">Terms</a>
      <a href={ROUTES.disclaimer} data-i18n="footer.disclaimer">Disclaimer</a>
    </nav>
  </div>
</footer>

<style>
  .vx-site-footer {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background: rgba(2, 4, 13, 0.72);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 18px 24px;
  }
  .vx-site-footer__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .vx-site-footer__copy {
    font-size: 12px;
    color: rgba(200, 205, 255, 0.65);
    font-weight: 600;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .vx-site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .vx-site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 12px;
    color: rgba(200, 205, 255, 0.75);
    text-decoration: none;
    letter-spacing: 0;
    transition: color 0.15s;
    white-space: nowrap;
  }
  .vx-site-footer__links a:hover {
    color: rgba(200, 245, 255, 0.85);
  }
  @media (max-width: 600px) {
    .vx-site-footer__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
