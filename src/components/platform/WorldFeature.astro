---
import { ROUTES } from "../../data/routes";
---

<section class="page-section platform-reveal world-home-section" id="world" data-platform-reveal>
  <div class="shell">
    <article class="panel panel--pro world-home-card">
      <div class="world-home-copy">
        <span class="label label--pro world-home-label">
          <span class="world-home-label__dot" aria-hidden="true"></span>
          <span class="i18n-en">VOLYNX World · premium layer</span>
          <span class="i18n-pt">VOLYNX World · camada premium</span>
        </span>

        <h2 class="world-home-title">
          <span class="i18n-en">Find the people who can <em>build the next step.</em></span>
          <span class="i18n-pt">Encontre quem pode <em>construir o próximo passo.</em></span>
        </h2>

        <p class="world-home-desc">
          <span class="i18n-en">A premium layer for professionals, services and private briefs — connected to the rest of VOLYNX.</span>
          <span class="i18n-pt">Uma camada premium para profissionais, serviços e briefings privados — conectada ao restante da VOLYNX.</span>
        </p>

        <div class="world-home-actions">
          <a class="button button--gold" href={ROUTES.world}>
            <span class="i18n-en">Enter World</span>
            <span class="i18n-pt">Entrar no World</span>
            <span aria-hidden="true">→</span>
          </a>
          <a class="button button--ghost" href={`${ROUTES.world}#join-world`}>
            <span class="i18n-en">Create your presence</span>
            <span class="i18n-pt">Criar sua presença</span>
          </a>
        </div>

        <div class="world-home-signals" role="list">
          <div role="listitem">
            <strong>01</strong>
            <span class="i18n-en">Discovery by delivery</span>
            <span class="i18n-pt">Descoberta por entrega</span>
          </div>
          <div role="listitem">
            <strong>02</strong>
            <span class="i18n-en">Private brief</span>
            <span class="i18n-pt">Briefing privado</span>
          </div>
          <div role="listitem">
            <strong>VX</strong>
            <span class="i18n-en">Member benefits</span>
            <span class="i18n-pt">Benefícios de membro</span>
          </div>
        </div>
      </div>

      <div class="world-home-visual" aria-hidden="true">
        <div class="world-home-orbit">
          <div class="world-home-core">
            <img src="/assets/world/world-network-icon.webp" alt="" loading="lazy" decoding="async" />
          </div>
          <div class="world-home-node world-home-node--profile">
            <img src="/assets/world/world-profile-icon.webp" alt="" loading="lazy" decoding="async" />
          </div>
          <div class="world-home-node world-home-node--service">
            <img src="/assets/world/world-service-icon.webp" alt="" loading="lazy" decoding="async" />
          </div>
          <div class="world-home-node world-home-node--brief">
            <img src="/assets/world/world-brief-icon.webp" alt="" loading="lazy" decoding="async" />
          </div>
          <div class="world-home-node world-home-node--intel">
            <img src="/assets/world/world-intelligence-icon.webp" alt="" loading="lazy" decoding="async" />
          </div>
        </div>
        <div class="world-home-float">
          <strong><span class="i18n-en">Founding marketplace</span><span class="i18n-pt">Marketplace fundador</span></strong>
          <span class="i18n-en">Professionals, services and opportunities in one living layer.</span>
          <span class="i18n-pt">Profissionais, serviços e oportunidades em uma camada viva.</span>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .world-home-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(280px, .96fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: center;
    padding: clamp(28px, 5vw, 58px);
    border-color: rgba(94, 234, 212, .22);
    background:
      radial-gradient(circle at 7% 0%, rgba(94, 234, 212, .16), transparent 33%),
      radial-gradient(circle at 92% 16%, rgba(168, 85, 247, .22), transparent 38%),
      linear-gradient(145deg, rgba(18, 30, 58, .96), rgba(5, 10, 24, .94));
    overflow: hidden;
    isolation: isolate;
  }

  .world-home-card::before {
    content: "";
    position: absolute;
    inset: 1px;
    border: 1px solid rgba(255, 255, 255, .06);
    pointer-events: none;
    z-index: -1;
  }

  .world-home-card::after {
    content: "";
    position: absolute;
    width: 420px;
    height: 420px;
    right: -190px;
    bottom: -230px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(94, 234, 212, .15), transparent 68%);
    pointer-events: none;
    z-index: -1;
  }

  .world-home-copy {
    position: relative;
    z-index: 2;
  }

  .world-home-label {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 22px;
    color: #5eead4;
    background: rgba(94, 234, 212, .08);
    border-color: rgba(94, 234, 212, .22);
  }

  .world-home-label__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #5eead4;
    box-shadow: 0 0 14px rgba(94, 234, 212, .75);
  }

  .world-home-title {
    max-width: 680px;
    margin: 0;
    color: #fff;
    font-family: var(--display);
    font-size: clamp(2.1rem, 4.5vw, 5rem);
    line-height: .96;
    letter-spacing: -.06em;
  }

  .world-home-title em {
    color: #5eead4;
    font-family: var(--serif, Georgia, serif);
    font-weight: 400;
    letter-spacing: -.035em;
  }

  .world-home-desc {
    max-width: 650px;
    margin: 22px 0 0;
    color: rgba(226, 232, 240, .78);
    font-size: clamp(1rem, 1.45vw, 1.2rem);
    line-height: 1.58;
  }

  .world-home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .world-home-actions .button {
    min-height: 48px;
  }

  .world-home-signals {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 34px;
    border: 1px solid rgba(255, 255, 255, .08);
    background: rgba(94, 234, 212, .14);
  }

  .world-home-signals > div {
    display: grid;
    gap: 7px;
    min-height: 78px;
    padding: 15px;
    background: rgba(4, 8, 20, .66);
  }

  .world-home-signals strong {
    color: #fff;
    font-family: var(--display);
    font-size: 1.05rem;
  }

  .world-home-signals span {
    color: rgba(226, 232, 240, .62);
    font-size: .7rem;
    line-height: 1.35;
  }

  .world-home-visual {
    position: relative;
    min-height: 390px;
    display: grid;
    place-items: center;
  }

  .world-home-orbit {
    position: relative;
    width: min(350px, 70vw);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 1px solid rgba(94, 234, 212, .2);
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(94, 234, 212, .12), transparent 37%),
      radial-gradient(circle, rgba(168, 85, 247, .12), transparent 68%);
  }

  .world-home-orbit::before,
  .world-home-orbit::after {
    content: "";
    position: absolute;
    border: 1px solid rgba(94, 234, 212, .12);
    border-radius: inherit;
  }

  .world-home-orbit::before { inset: 13%; }
  .world-home-orbit::after { inset: 29%; border-color: rgba(168, 85, 247, .14); }

  .world-home-core,
  .world-home-node {
    position: absolute;
    display: grid;
    place-items: center;
    border: 1px solid rgba(94, 234, 212, .26);
    background: rgba(4, 8, 20, .84);
    box-shadow: 0 18px 48px rgba(0, 0, 0, .34);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .world-home-core {
    inset: 50%;
    width: 126px;
    height: 126px;
    border-radius: 34px;
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .world-home-core img {
    width: 70px;
    height: 70px;
    object-fit: contain;
    transform: rotate(-45deg);
    filter: drop-shadow(0 0 18px rgba(94, 234, 212, .38));
  }

  .world-home-node {
    width: 72px;
    height: 72px;
    border-radius: 22px;
  }

  .world-home-node img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .world-home-node--profile { top: 4%; left: 50%; transform: translateX(-50%); }
  .world-home-node--service { right: 2%; top: 48%; transform: translateY(-50%); }
  .world-home-node--brief { bottom: 6%; left: 50%; transform: translateX(-50%); }
  .world-home-node--intel { left: 2%; top: 48%; transform: translateY(-50%); }

  .world-home-float {
    position: absolute;
    right: -2px;
    bottom: 0;
    display: grid;
    gap: 7px;
    max-width: 235px;
    padding: 16px;
    border: 1px solid rgba(168, 85, 247, .26);
    border-radius: 18px;
    background: rgba(4, 8, 20, .82);
    box-shadow: 0 20px 54px rgba(0, 0, 0, .34);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .world-home-float strong {
    color: #fff;
    font-family: var(--display);
    font-size: .95rem;
  }

  .world-home-float span {
    color: rgba(226, 232, 240, .66);
    font-size: .72rem;
    line-height: 1.45;
  }

  @media (max-width: 760px) {
    .world-home-card { grid-template-columns: 1fr; }
    .world-home-actions { flex-direction: column; }
    .world-home-actions .button { width: 100%; justify-content: center; }
    .world-home-signals { grid-template-columns: 1fr; }
    .world-home-visual { min-height: 320px; }
    .world-home-orbit { width: min(310px, 76vw); }
    .world-home-core { width: 108px; height: 108px; border-radius: 30px; }
    .world-home-core img { width: 60px; height: 60px; }
    .world-home-node { width: 62px; height: 62px; border-radius: 19px; }
    .world-home-node img { width: 34px; height: 34px; }
    .world-home-float { position: relative; right: auto; bottom: auto; max-width: none; margin-top: -24px; }
  }
</style>
