---
import { ROUTES } from "../data/routes";
interface Props {
  mode?: "default" | "sections";
  primaryCtaLabel?: string;
  primaryCtaI18n?: string;
  primaryCtaHref?: string;
}
const {
  mode = "default",
  primaryCtaLabel,
  primaryCtaI18n,
  primaryCtaHref = ROUTES.login,
} = Astro.props;

const mobileDefaultLinks = [
  { href: ROUTES.products, label: "Products", i18n: "vxh.products" },
  { href: ROUTES.delivery, label: "My Products", i18n: "vxh.my_products" },
  { href: ROUTES.support, label: "Support", i18n: "vxh.support" },
  { href: ROUTES.daily, label: "Daily", i18n: "vxh.daily" },
];
---

<header class="vxh" role="banner">
  <div class="vxh__inner">
    <a class="vxh__brand" href={ROUTES.home} aria-label="VOLYNX — go to home" data-i18n-aria="aria.go_home">
      <img src="/assets/volynx-icon.webp" alt="" class="vxh__icon" width="90" height="90" loading="eager" decoding="async" />
      <img src="/assets/wordmark.webp" alt="" class="vxh__wordmark" width="160" height="32" loading="eager" decoding="async" />
    </a>

    {mode === "sections" && (
      <nav class="vxh__nav" aria-label="Page sections" data-i18n-aria="aria.page_sections">
        <a href="#curriculum" data-i18n="vxh.curriculum">Curriculum</a>
        <a href="#method" data-i18n="vxh.method">Method</a>
        <a href="#projects" data-i18n="vxh.projects">Projects</a>
        <a href="#faq" data-i18n="vxh.faq">FAQ</a>
        <a href="#access" data-i18n="vxh.access">Access</a>
      </nav>
    )}

    <div class="vxh__actions">
      {primaryCtaLabel && (
        <a class="vxh__cta" href={primaryCtaHref} data-i18n={primaryCtaI18n}>{primaryCtaLabel}</a>
      )}
      <button class="vxh__burger" id="menuBtn" type="button" aria-label="Open menu" data-i18n-aria="aria.open_menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="vxh__mobile" id="mobileMenu" aria-hidden="true" inert>
    <div class="vxh__mobileInner">
      {mode === "sections" && (
        <nav aria-label="Page sections — mobile" data-i18n-aria="aria.page_sections_mobile">
          <a href="#curriculum" data-i18n="vxh.curriculum">Curriculum</a>
          <a href="#method" data-i18n="vxh.method">Method</a>
          <a href="#projects" data-i18n="vxh.projects">Projects</a>
          <a href="#faq" data-i18n="vxh.faq">FAQ</a>
          <a href="#access" data-i18n="vxh.access">Access</a>
        </nav>
      )}
      {mode !== "sections" && (
        <nav aria-label="Platform links — mobile" data-i18n-aria="aria.platform_links_mobile">
          {mobileDefaultLinks.map((link) => (
            <a href={link.href} data-i18n={link.i18n}>{link.label}</a>
          ))}
        </nav>
      )}
      {primaryCtaLabel && (
        <a class="vxh__cta" href={primaryCtaHref} data-i18n={primaryCtaI18n}>{primaryCtaLabel}</a>
      )}
    </div>
  </div>
</header>

<style>
  .vxh {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 900;
    background: rgba(8, 6, 16, 0.88);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  .vxh__inner {
    max-width: var(--content-max, 1100px);
  margin: 0px auto;
  padding: 10px 20px;
  height: auto;
  display: flex;
  align-items: center;
  gap: 24px;
  }
  .vxh__brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #fff;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.06em;
    flex-shrink: 0;
  }
  .vxh__brand img { border-radius: 6px; }
  .vxh__icon { width: clamp(34px, 5vw, 44px); height: auto; }
  .vxh__wordmark { width: clamp(140px, 22vw, 200px); height: auto; }
  .vxh__nav {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    justify-content: center;
  }
  .vxh__nav a {
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.80);
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }
  .vxh__nav a:hover { color: #fff; background: rgba(255, 255, 255, 0.07); }
  .vxh__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }
  .vxh__cta {
    padding: 8px 18px;
    border-radius: 999px;
    background: rgba(245, 231, 145, 0.18);
    border: 1px solid rgba(245, 231, 145, 0.34);
    color: rgba(255, 245, 180, 0.95);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap;
  }
  .vxh__cta:hover { background: rgba(245, 231, 145, 0.26); }
  .vxh__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 6px;
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    cursor: pointer;
  }
  .vxh__burger span {
    display: block;
    height: 2px;
    background: rgba(255, 255, 255, 0.80);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }
  .vxh__mobile {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-6px);
    transition: opacity .18s ease, transform .18s ease;

    display: none;
    position: fixed;
    inset: 58px 0 0;
    background: rgba(6, 5, 16, 0.97);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 899;
  }
  .vxh__mobile.vx--open { display: block; opacity: 1; pointer-events: auto; transform: translateY(0); }

  .vxh__mobileInner {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .vxh__mobileInner nav { display: flex; flex-direction: column; gap: 4px; }
  .vxh__mobileInner nav a {
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.80);
    text-decoration: none;
    border: 1px solid transparent;
    transition: background 0.15s, border-color 0.15s;
  }
  .vxh__mobileInner nav a:hover { background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.10); }
  .vxh__mobileInner .vxh__cta { align-self: flex-start; margin-top: 8px; }

  :global(body){ padding-top: 64px; }
  .vxh__brand img{ display:block; }
  .vxh__brand img:first-child{ width:90px; height:auto; }
  .vxh__brand img:last-child{ width:120px; height:auto; }
  @media (max-width: 420px){
    .vxh__brand img:last-child{ width:92px; }
    .vxh__inner{ padding: 10px 14px; gap: 14px; }
  }

  @media (max-width: 768px) {
    .vxh__nav { display: none; }
    .vxh__burger { display: flex; }
  }
</style>

<script src="/js/vx-header.js" defer></script>
