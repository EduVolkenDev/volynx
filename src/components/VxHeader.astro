---
import { ROUTES } from "../data/routes";
interface Props {
  mode?: "default" | "sections";
  brandHref?: string;
  primaryCtaLabel?: string;
  primaryCtaI18n?: string;
  primaryCtaHref?: string;
  primaryCtaAuth?: "always" | "in" | "out";
  showLang?: boolean;
}
const {
  mode = "default",
  brandHref = ROUTES.platform,
  primaryCtaLabel,
  primaryCtaI18n,
  primaryCtaHref = ROUTES.login,
  primaryCtaAuth = "always",
  showLang = true,
} = Astro.props;

const mobileDefaultLinks = [
  { href: ROUTES.products, label: "Products", i18n: "vxh.products" },
  { href: ROUTES.delivery, label: "My Products", i18n: "vxh.my_products" },
  { href: ROUTES.support, label: "Support", i18n: "vxh.support" },
  { href: ROUTES.daily, label: "Daily", i18n: "vxh.daily" },
];
---

<script is:inline>
  (function hydrateVxHeaderAuth() {
    function tokenLooksUsable(token) {
      if (!token) return false;
      try {
        var payload = token.split(".")[1];
        if (!payload) return true;
        payload = payload.replace(/-/g, "+").replace(/_/g, "/");
        var data = JSON.parse(atob(payload.padEnd(payload.length + (4 - payload.length % 4) % 4, "=")));
        if (!data || !data.exp) return true;
        return data.exp * 1000 > Date.now() - 60000;
      } catch (_) {
        return true;
      }
    }

    try {
      var token = localStorage.getItem("volynx_access_token") || "";
      var session = localStorage.getItem("volynx_session") || "";
      if (tokenLooksUsable(token) || session) {
        document.documentElement.classList.add("vx-authed");
      }
    } catch (_) {}
  })();
</script>

<header class="vxh" role="banner">
  <div class="vxh__inner">
    <a class="vxh__brand" href={brandHref} aria-label="VOLYNX — go to platform" data-i18n-aria="aria.platform_home">
      <img src="/assets/V.webp" alt="" class="vxh__icon" width="44" height="44" loading="eager" decoding="async" />
      <img src="/assets/wordmark.webp" alt="" class="vxh__wordmark" width="160" height="32" loading="eager" decoding="async" />
    </a>

    {mode === "sections" && (
      <nav class="vxh__nav" aria-label="Page sections" data-i18n-aria="aria.page_sections">
        <a href="#curriculum" data-i18n="vxh.curriculum">Curriculum</a>
        <a href="#method" data-i18n="vxh.method">Method</a>
        <a href="#projects" data-i18n="vxh.projects">Projects</a>
        <a href="#faq" data-i18n="vxh.faq">FAQ</a>
        <a href="#access" data-i18n="vxh.access">Access</a>
      </nav>
    )}

    <div class="vxh__actions">
      {showLang && (
        <button
          type="button"
          class="vxh__lang"
          data-vx-lang-toggle
          data-vx-lang-title
        >
          <span class="vxh__sr">
            <span class="i18n-en">Language: </span>
            <span class="i18n-pt">Idioma: </span>
          </span>
          <span data-i18n="widget.lang" data-vx-lang-label>EN</span>
        </button>
      )}
      {primaryCtaLabel && (
        <a class="vxh__cta" href={primaryCtaHref} data-i18n={primaryCtaI18n} data-auth={primaryCtaAuth}>{primaryCtaLabel}</a>
      )}
      <button class="vxh__burger" id="menuBtn" type="button" aria-label="Open menu" data-i18n-aria="aria.open_menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="vxh__mobile" id="mobileMenu" aria-hidden="true" inert>
    <div class="vxh__mobileInner">
      {mode === "sections" && (
        <nav aria-label="Page sections — mobile" data-i18n-aria="aria.page_sections_mobile">
          <a href="#curriculum" data-i18n="vxh.curriculum">Curriculum</a>
          <a href="#method" data-i18n="vxh.method">Method</a>
          <a href="#projects" data-i18n="vxh.projects">Projects</a>
          <a href="#faq" data-i18n="vxh.faq">FAQ</a>
          <a href="#access" data-i18n="vxh.access">Access</a>
        </nav>
      )}
      {mode !== "sections" && (
        <nav aria-label="Platform links — mobile" data-i18n-aria="aria.platform_links_mobile">
          {mobileDefaultLinks.map((link) => (
            <a href={link.href} data-i18n={link.i18n}>{link.label}</a>
          ))}
        </nav>
      )}
      {primaryCtaLabel && (
        <a class="vxh__cta" href={primaryCtaHref} data-i18n={primaryCtaI18n} data-auth={primaryCtaAuth}>{primaryCtaLabel}</a>
      )}
    </div>
  </div>
</header>

<style>
  .vxh {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 900;
    background: rgba(8, 6, 16, 0.88);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  .vxh__inner {
    max-width: var(--content-max, 1100px);
  margin: 0px auto;
  padding: 10px 20px;
  height: auto;
  display: flex;
  align-items: center;
  gap: 24px;
  }
  .vxh__brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #fff;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.06em;
    flex-shrink: 0;
  }
  .vxh__brand img { border-radius: 6px; }
  .vxh__icon { width: 44px; height: 44px; object-fit: contain; }
  .vxh__wordmark { width: clamp(160px, 22vw, 220px); height: auto; }
  .vxh__nav {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    justify-content: center;
  }
  .vxh__nav a {
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.80);
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }
  .vxh__nav a:hover { color: #fff; background: rgba(255, 255, 255, 0.07); }
  .vxh__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }
  .vxh__sr {
    position: absolute !important;
    width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  .vxh__lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 38px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.14);
    color: rgba(255,255,255,.78);
    font: inherit;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .08em;
    cursor: pointer;
    text-transform: uppercase;
    transition: color .15s, border-color .15s, background .15s;
  }
  .vxh__lang:hover {
    color: #9ffcf0;
    border-color: rgba(159,252,240,.34);
    background: rgba(159,252,240,.08);
  }
  .vxh__cta {
    padding: 8px 18px;
    border-radius: 999px;
    background: rgba(245, 231, 145, 0.18);
    border: 1px solid rgba(245, 231, 145, 0.34);
    color: rgba(255, 245, 180, 0.95);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap;
  }
  .vxh__cta:hover { background: rgba(245, 231, 145, 0.26); }
  .vxh__cta[data-auth="in"] { display: none; }
  :global(.vx-authed .vxh__cta[data-auth="in"]) { display: inline-flex; }
  :global(.vx-authed .vxh__cta[data-auth="out"]) { display: none; }
  .vxh__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 6px;
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    cursor: pointer;
  }
  .vxh__burger span {
    display: block;
    height: 2px;
    background: rgba(255, 255, 255, 0.80);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }
  .vxh__mobile {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-6px);
    transition: opacity .18s ease, transform .18s ease;

    display: none;
    position: fixed;
    inset: 58px 0 0;
    background: rgba(6, 5, 16, 0.97);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 899;
  }
  .vxh__mobile.vx--open { display: block; opacity: 1; pointer-events: auto; transform: translateY(0); }

  .vxh__mobileInner {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .vxh__mobileInner nav { display: flex; flex-direction: column; gap: 4px; }
  .vxh__mobileInner nav a {
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.80);
    text-decoration: none;
    border: 1px solid transparent;
    transition: background 0.15s, border-color 0.15s;
  }
  .vxh__mobileInner nav a:hover { background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.10); }
  .vxh__mobileInner .vxh__cta { align-self: flex-start; margin-top: 8px; }

  :global(body){ padding-top: 64px; }
  .vxh__brand img{ display:block; }
  .vxh__brand img:first-child{ width:44px; height:44px; }
  .vxh__brand img:last-child{ width:120px; height:auto; }
  @media (max-width: 420px){
    .vxh__brand img:last-child{ display:none; }
    .vxh__inner{ padding: 10px 14px; gap: 10px; }
    .vxh__actions{ gap: 8px; }
    .vxh__cta{ padding: 8px 14px; font-size: 12px; }
  }

  @media (max-width: 768px) {
    .vxh__nav { display: none; }
    .vxh__burger { display: flex; }
  }
</style>

<script src="/js/vx-header.js" defer></script>
