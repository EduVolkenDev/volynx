---
interface Props {
  name: "builder" | "daily" | "lab" | "world" | "services" | "journey";
  size?: number;
}

const { name, size = 32 } = Astro.props;
---

<svg
  class={`core-icon core-icon--${name}`}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  {name === "builder" && (
    <>
      <path d="M6 7.5h20v17H6z" stroke="currentColor" stroke-width="1.5" />
      <path d="M10 12h5M10 16h12M10 20h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path d="m22 7.5 2.5-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </>
  )}
  {name === "daily" && (
    <>
      <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.5" />
      <path d="M16 10v6l4 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M16 3v3M29 16h-3M16 29v-3M3 16h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </>
  )}
  {name === "lab" && (
    <>
      <path d="M12 5v8l-5.5 9.5A3 3 0 0 0 9.1 27h13.8a3 3 0 0 0 2.6-4.5L20 13V5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M10 18h12M12 5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <circle cx="14" cy="21" r="1" fill="currentColor" />
      <circle cx="19" cy="23" r="1" fill="currentColor" />
    </>
  )}
  {name === "world" && (
    <>
      <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.5" />
      <path d="M6 16h20M16 6c3 2.8 4.5 6.1 4.5 10S19 23.2 16 26M16 6c-3 2.8-4.5 6.1-4.5 10S13 23.2 16 26" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
      <path d="M8.5 10.5h15M8.5 21.5h15" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
    </>
  )}
  {name === "services" && (
    <>
      <path d="m19.8 7.2 5 5M7.2 19.8l5 5M21.8 5.2a4.2 4.2 0 0 0-5.1 5.1L6.1 20.9a3 3 0 1 0 4.2 4.2l10.6-10.6a4.2 4.2 0 0 0 5.1-5.1l-3.1 3.1-3.4-.9-.9-3.4 3.2-3Z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {name === "journey" && (
    <>
      <path d="M7 24V8h18v16H7Z" stroke="currentColor" stroke-width="1.5" />
      <path d="M11 12h10M11 16h6M11 20h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path d="m23 20 2 2 3-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
</svg>
