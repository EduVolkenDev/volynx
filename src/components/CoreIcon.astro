---
interface Props {
  name: "builder" | "daily" | "lab" | "world" | "services" | "journey";
  size?: number;
}

const { name, size = 32 } = Astro.props;
---

<svg
  class={`core-icon core-icon--${name}`}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  {name === "builder" && (
    <>
      <rect x="5.5" y="7.5" width="21" height="18" rx="2" stroke="currentColor" stroke-width="1.5" />
      <path d="M5.5 13h21" stroke="currentColor" stroke-width="1.25" />
      <circle cx="9" cy="10.25" r=".9" fill="currentColor" />
      <circle cx="12" cy="10.25" r=".9" fill="currentColor" opacity=".65" />
      <circle cx="15" cy="10.25" r=".9" fill="currentColor" opacity=".35" />
      <path d="M9.5 17h6M9.5 20.5h10M21.5 17h2M21.5 20.5h2" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
      <path d="M23 4.5v3M20.5 7h5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" opacity=".72" />
    </>
  )}
  {name === "daily" && (
    <>
      <circle cx="16" cy="16" r="10.5" stroke="currentColor" stroke-width="1.5" />
      <circle cx="16" cy="16" r="7.3" stroke="currentColor" stroke-width=".85" opacity=".38" />
      <path d="M16 10v6l4.2 2.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="16" cy="16" r="1.7" fill="currentColor" />
      <path d="M16 2.5v3M29.5 16h-3M16 29.5v-3M2.5 16h3M6.5 6.5l2.1 2.1M25.5 6.5l-2.1 2.1M25.5 25.5l-2.1-2.1M6.5 25.5l2.1-2.1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity=".82" />
    </>
  )}
  {name === "lab" && (
    <>
      <path d="M12 4.5v8.5L7.3 21.8A3.2 3.2 0 0 0 10.1 27h11.8a3.2 3.2 0 0 0 2.8-5.2L20 13V4.5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M10 4.5h10M9.5 18h13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      <circle cx="13.5" cy="21.5" r="1.05" fill="currentColor" />
      <circle cx="19" cy="23.2" r="1.05" fill="currentColor" opacity=".75" />
      <path d="M24.5 8h3M26 6.5v3M7 11H4M5.5 9.5v3" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" opacity=".68" />
    </>
  )}
  {name === "world" && (
    <>
      <circle cx="16" cy="16" r="10.5" stroke="currentColor" stroke-width="1.5" />
      <ellipse cx="16" cy="16" rx="4.5" ry="10.5" stroke="currentColor" stroke-width="1.1" opacity=".78" />
      <path d="M5.5 16h21M7.8 10.5h16.4M7.8 21.5h16.4" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" />
      <path d="M5.5 16H3M26.5 16H29M16 5.5V3M16 26.5V29" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" opacity=".82" />
      <circle cx="3" cy="16" r="1.2" fill="currentColor" />
      <circle cx="29" cy="16" r="1.2" fill="currentColor" />
    </>
  )}
  {name === "services" && (
    <>
      <path d="m19.8 7.2 5 5M7.2 19.8l5 5M21.8 5.2a4.2 4.2 0 0 0-5.1 5.1L6.1 20.9a3 3 0 1 0 4.2 4.2l10.6-10.6a4.2 4.2 0 0 0 5.1-5.1l-3.1 3.1-3.4-.9-.9-3.4 3.2-3Z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {name === "journey" && (
    <>
      <path d="M7 24V8h18v16H7Z" stroke="currentColor" stroke-width="1.5" />
      <path d="M11 12h10M11 16h6M11 20h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path d="m23 20 2 2 3-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
</svg>
