---
import CookieBanner from "./CookieBanner.astro";
import { ROUTES } from "../data/routes";
interface Props { hideUtilBar?: boolean; }
const { hideUtilBar = false } = Astro.props;
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
const isAuth = ["/login/", "/signup/", "/auth/"].some(p => Astro.url.pathname.startsWith(p));
const isProfile = Astro.url.pathname.startsWith("/profile");
---

{!hideUtilBar && (
<div class="vx-util-bar" id="vxUtilBar">
  <button
    id="vxLangToggle"
    class="vx-widget vx-lang-btn"
    type="button"
    data-vx-lang-toggle
    data-vx-lang-title
  >
    <span class="vx-sr-only">
      <span class="i18n-en">Language: </span>
      <span class="i18n-pt">Idioma: </span>
    </span>
    <span class="vx-lang-label" data-i18n="widget.lang" data-vx-lang-label>EN</span>
  </button>
  {!isAuth && (
    <a href={ROUTES.login} id="vxLoginBtn" class="vx-widget vx-login-btn" data-i18n="widget.login">
      Login
    </a>
  )}
</div>
)}

{!isHome && (
  <a href={ROUTES.home} id="vxHomeBtn" class="vx-widget vx-home-btn" aria-label="Go home" data-i18n="widget.home" data-i18n-aria="aria.go_home">
    ← Home
  </a>
)}

<button id="vxBackTop" class="vx-widget vx-backtop" aria-label="Back to top" data-i18n-aria="aria.back_to_top" type="button">
  ↑
</button>

<CookieBanner />

<style>
  .vx-widget {
    position: fixed;
    z-index: 9990;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, .16);
    background: rgba(8, 6, 16, .78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-radius: 999px;
    color: rgba(255, 255, 255, .90);
    font-family: inherit;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: .04em;
    cursor: pointer;
    text-decoration: none;
    transition: opacity .2s ease, transform .2s ease, background .15s ease, border-color .15s ease;
    box-shadow: 0 4px 18px rgba(0, 0, 0, .38);
    min-height: 40px;
    min-width: 40px;
    padding: 8px 16px;
    line-height: 1;
    user-select: none;
  }
  .vx-widget:hover {
    background: rgba(130, 220, 255, .13);
    border-color: rgba(130, 220, 255, .36);
    color: #fff;
  }

  /* Home button — bottom-left */
  .vx-home-btn {
    bottom: 22px;
    left: 22px;
    gap: 6px;
  }

  /* Back to top — bottom-right, hidden until scroll */
  .vx-backtop {
    bottom: 22px;
    right: 22px;
    font-size: 18px;
    padding: 8px 14px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
  }
  .vx-backtop.vx--visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* Utility bar — top right, fixed to viewport */
  .vx-util-bar {
    position: fixed;
    top: 13px;
    right: 20px;
    z-index: 9990;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Itens dentro da barra não devem ter position:fixed próprio */
  .vx-util-bar .vx-widget {
    position: relative;
    top: unset;
    right: unset;
    bottom: unset;
    left: unset;
  }

  .vx-sr-only {
    position: absolute !important;
    width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  .vx-lang-btn {
    min-width: 48px;
    padding: 7px 11px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .09em;
  }

  .vx-login-btn {
    padding: 7px 15px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .04em;
    background: rgba(130, 100, 255, .18);
    border-color: rgba(160, 130, 255, .30);
  }
  .vx-login-btn:hover {
    background: rgba(130, 100, 255, .32);
    border-color: rgba(180, 155, 255, .55);
  }
  .vx-login-btn.vx--logged-in {
    background: rgba(0, 232, 197, .14);
    border-color: rgba(0, 232, 197, .32);
    color: rgba(0, 232, 197, .95);
    min-width: 40px;
    padding: 7px 12px;
    font-size: 12px;
  }
  .vx-login-btn.vx--logged-in:hover {
    background: rgba(0, 232, 197, .24);
    border-color: rgba(0, 232, 197, .5);
  }

  @media (max-width: 480px) {
    .vx-home-btn { display: none; }
    .vx-backtop  { bottom: 14px; right: 14px; }
    .vx-util-bar { top: 10px; right: 10px; gap: 6px; }
    .vx-lang-btn { min-width: 42px; padding: 6px 9px; font-size: 12px; }
    .vx-login-btn { padding: 6px 11px; font-size: 11px; }
  }
</style>

<script src="/js/vx-token-refresh.js" defer></script>
<script src="/js/vx-plan.js" defer></script>
<script src="/js/translations.js?v=20260504-devjourney" defer></script>
<script src="/js/i18n.js" defer></script>
<script src="/js/recording-mode.js?v=20260506" defer></script>
<script src="/js/page-widgets.js" defer></script>
<script src="/js/plan-aware-ui.js" defer></script>
<script src="/js/vx-tokens.js" defer></script>
<script src="/js/vx-token-bar.js?v=20260502-vx200" defer></script>
<script src="/js/vx-gamification.js" defer></script>
