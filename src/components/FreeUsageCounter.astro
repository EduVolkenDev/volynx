---
/**
 * Shows remaining free daily usage and an upgrade CTA when limit is hit.
 * Place inside free Lab tool pages.
 */
import { ROUTES } from "../data/routes";
---
<div class="vx-usage-bar" id="vxUsageBar" style="display:none">
  <div class="vx-usage-bar__inner">
    <span class="vx-usage-bar__text" id="vxUsageText">
      <span id="vxUsageCount">0</span> / <span id="vxUsageLimit">5</span> free uses today
    </span>
    <div class="vx-usage-bar__track">
      <div class="vx-usage-bar__fill" id="vxUsageFill" style="width:0%"></div>
    </div>
  </div>
  <a href={ROUTES.pricing} class="vx-usage-bar__upgrade" id="vxUpgradeLink" style="display:none">
    Upgrade to Pro
  </a>
</div>

<!-- Limit-hit overlay -->
<div class="vx-limit-overlay" id="vxLimitOverlay" style="display:none" role="dialog" aria-labelledby="vxLimitTitle">
  <div class="vx-limit-card">
    <div class="vx-limit-icon">&#128274;</div>
    <h3 id="vxLimitTitle">Daily limit reached</h3>
    <p>You've used all your free conversions for today.</p>
    <p class="vx-limit-sub">Upgrade to Studio Pro for much higher limits, batch processing, and commercial rights.</p>
    <a href={ROUTES.studio} class="vx-limit-cta">Upgrade to Studio Pro</a>
    <p class="vx-limit-reset">Free uses reset daily at midnight.</p>
  </div>
</div>

<style>
  .vx-usage-bar {
    position: sticky;
    bottom: 0;
    z-index: 50;
    background: rgba(7, 10, 20, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 10px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .vx-usage-bar__inner {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
  }
  .vx-usage-bar__text {
    font-size: 13px;
    color: rgba(200, 205, 255, 0.75);
    white-space: nowrap;
  }
  .vx-usage-bar__track {
    flex: 1;
    max-width: 200px;
    height: 4px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
  }
  .vx-usage-bar__fill {
    height: 100%;
    background: linear-gradient(90deg, rgba(130, 220, 255, 0.9), rgba(210, 140, 255, 0.9));
    border-radius: 999px;
    transition: width 0.3s ease;
  }
  .vx-usage-bar__fill[data-full="true"] {
    background: linear-gradient(90deg, #ff4d6a, #ff6b8a);
  }
  .vx-usage-bar__upgrade {
    font-size: 13px;
    font-weight: 600;
    padding: 6px 16px;
    border-radius: 999px;
    background: linear-gradient(135deg, #6d5efc, #8b5cf6);
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }
  .vx-usage-bar__upgrade:hover { opacity: 0.85; }

  /* Limit overlay */
  .vx-limit-overlay {
    position: fixed;
    inset: 0;
    z-index: 1100;
    background: rgba(2, 4, 13, 0.85);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .vx-limit-card {
    background: rgba(15, 15, 30, 0.95);
    border: 1px solid rgba(109, 94, 252, 0.3);
    border-radius: 20px;
    padding: 40px 32px;
    max-width: 420px;
    text-align: center;
  }
  .vx-limit-icon { font-size: 40px; margin-bottom: 16px; }
  .vx-limit-card h3 {
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 12px;
  }
  .vx-limit-card p {
    font-size: 15px;
    color: rgba(200, 205, 255, 0.75);
    margin: 0 0 8px;
    line-height: 1.5;
  }
  .vx-limit-sub { font-size: 13px !important; margin-bottom: 24px !important; }
  .vx-limit-cta {
    display: inline-block;
    padding: 12px 32px;
    border-radius: 999px;
    background: linear-gradient(135deg, #6d5efc, #8b5cf6);
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .vx-limit-cta:hover { opacity: 0.85; }
  .vx-limit-reset {
    font-size: 12px !important;
    color: rgba(200, 205, 255, 0.5) !important;
    margin-top: 16px !important;
  }

  @media (max-width: 480px) {
    .vx-usage-bar { flex-direction: column; gap: 8px; padding: 8px 16px; }
    .vx-usage-bar__track { max-width: 100%; }
  }
</style>

<script>
  // Initialize usage display from localStorage
  (function() {
    const bar = document.getElementById('vxUsageBar');
    const countEl = document.getElementById('vxUsageCount');
    const limitEl = document.getElementById('vxUsageLimit');
    const fillEl = document.getElementById('vxUsageFill');
    const upgradeLink = document.getElementById('vxUpgradeLink');
    const overlay = document.getElementById('vxLimitOverlay');
    if (!bar) return;

    const FREE_LIMIT = 5;
    const STORAGE_KEY = 'volynx_converter_usage';

    function todayKey() {
      const d = new Date();
      return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
    }

    function getUsage() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return 0;
        const data = JSON.parse(raw);
        return data.date === todayKey() ? (data.used || 0) : 0;
      } catch { return 0; }
    }

    function update() {
      const used = getUsage();
      if (limitEl) limitEl.textContent = String(FREE_LIMIT);
      if (countEl) countEl.textContent = String(used);
      const pct = Math.min((used / FREE_LIMIT) * 100, 100);
      if (fillEl) {
        fillEl.style.width = pct + '%';
        fillEl.setAttribute('data-full', String(used >= FREE_LIMIT));
      }
      if (upgradeLink) upgradeLink.style.display = used >= Math.ceil(FREE_LIMIT * 0.6) ? '' : 'none';
      if (overlay && used >= FREE_LIMIT) overlay.style.display = '';
      bar.style.display = '';
    }

    // Only show for non-pro users
    // Use VxPlan cache (set by vx-auth-gate.js) instead of orphaned localStorage key
    function shouldShow() {
      if (window.VxPlan) {
        var cached = window.VxPlan.getCached();
        return !cached || !window.VxPlan.isPaid(cached.plan);
      }
      return true; // default to showing for safety
    }

    function init() {
      if (shouldShow()) {
        update();
        window.addEventListener('vx:usage-updated', update);
      } else {
        bar.style.display = 'none';
      }
    }

    // If plan is already resolved (e.g., from vx-auth-gate), check now
    if (window.vxPlan !== undefined) {
      var isPaid = window.VxPlan ? window.VxPlan.isPaid(window.vxPlan) : (window.vxPlan !== 'free');
      if (!isPaid) { update(); window.addEventListener('vx:usage-updated', update); }
      else { bar.style.display = 'none'; }
    } else {
      // Plan not yet resolved — show by default, hide if plan-ready says paid
      init();
      window.addEventListener('vx:plan-ready', function(e) {
        var isPaid = window.VxPlan ? window.VxPlan.isPaid(e.detail.plan) : (e.detail.plan !== 'free');
        if (isPaid) {
          bar.style.display = 'none';
          window.removeEventListener('vx:usage-updated', update);
        }
      });
    }
  })();
</script>
