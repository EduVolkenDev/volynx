---
import { DEVJOURNEY_CURRICULUM, DEVJOURNEY_LESSONS } from "../data/devjourney-curriculum.js";
import DevJourneyExerciseSandbox from "./DevJourneyExerciseSandbox.astro";

const firstLesson = DEVJOURNEY_LESSONS[0];
---

<section class="djl-room" id="learning" aria-labelledby="djlTitle">
  <div class="djl-room__header">
    <div>
      <span class="kicker">
        <span class="i18n-en">Your learning path</span>
        <span class="i18n-pt">Seu caminho de aprendizagem</span>
      </span>
      <h2 id="djlTitle">
        <span class="i18n-en">One lesson at a time. Always know what comes next.</span>
        <span class="i18n-pt">Uma aula por vez. Sempre saiba o que vem depois.</span>
      </h2>
      <p class="djl-room__intro">
        <span class="i18n-en">Read the goal, follow the steps, compare the expected result and mark the checkpoint only when it works.</span>
        <span class="i18n-pt">Leia o objetivo, siga os passos, compare o resultado esperado e marque o checkpoint somente quando funcionar.</span>
      </p>
    </div>
    <div class="djl-progress" aria-live="polite">
      <span class="djl-progress__label">
        <span class="i18n-en">Path progress</span>
        <span class="i18n-pt">Progresso da trilha</span>
      </span>
      <strong id="djlProgressValue">0%</strong>
      <div class="djl-progress__track"><span id="djlProgressBar"></span></div>
      <span id="djlProgressMeta" class="djl-progress__meta">0 / {DEVJOURNEY_LESSONS.length}</span>
      <span id="djlSyncStatus" class="djl-progress__sync" role="status" aria-live="polite">
        <span class="i18n-en">Saved on this device</span>
        <span class="i18n-pt">Salvo neste dispositivo</span>
      </span>
    </div>
  </div>

  <div class="djl-layout">
    <nav class="djl-curriculum" aria-label="Dev Journey curriculum">
      <div class="djl-curriculum__top">
        <span class="i18n-en">Curriculum</span><span class="i18n-pt">Currículo</span>
        <span class="djl-curriculum__hint"><span class="i18n-en">Social unlocked</span><span class="i18n-pt">Social liberado</span></span>
      </div>
      {DEVJOURNEY_CURRICULUM.map((block) => (
        <div class:list={["djl-block", block.tier !== "social" && "djl-block--locked"]} data-tier-required={block.tier !== "social" ? block.tier : undefined}>
          <div class="djl-block__heading">
            <span class="djl-block__number">{block.number}</span>
            <div>
              <strong><span class="i18n-en">{block.titleEn}</span><span class="i18n-pt">{block.titlePt}</span></strong>
              <small><span class="i18n-en">{block.summaryEn}</span><span class="i18n-pt">{block.summaryPt}</span></small>
            </div>
            {block.tier !== "social" && <span class="djl-lock" aria-label={`Requires ${block.tier}`}>⌁</span>}
          </div>
          <div class="djl-block__lessons">
            {block.lessons.map((lesson, index) => (
              <button
                class:list={["djl-lesson-nav", index === 0 && block.id === firstLesson.blockId && "is-active"]}
                type="button"
                data-lesson-id={lesson.id}
                data-tier-required={block.tier !== "social" ? block.tier : undefined}
                disabled={block.tier !== "social"}
                aria-current={lesson.id === firstLesson.id ? "step" : undefined}
              >
                <span class="djl-lesson-nav__state" aria-hidden="true"></span>
                <span class="djl-lesson-nav__copy">
                  <span class="djl-lesson-nav__id">{lesson.id}</span>
                  <span><span class="i18n-en">{lesson.titleEn}</span><span class="i18n-pt">{lesson.titlePt}</span></span>
                </span>
              </button>
            ))}
          </div>
        </div>
      ))}
    </nav>

    <div class="djl-content">
      <div class="djl-mobile-context" aria-live="polite">
        <span class="i18n-en">Now studying</span><span class="i18n-pt">Estudando agora</span>
        <strong id="djlMobileLesson">{firstLesson.id}</strong>
      </div>
      {DEVJOURNEY_LESSONS.map((lesson, index) => (
        <article class:list={["djl-lesson-panel", index !== 0 && "is-hidden"]} data-lesson-panel={lesson.id} data-tier-required={lesson.tier !== "social" ? lesson.tier : undefined}>
          <header class="djl-lesson-head">
            <div>
              <div class="djl-lesson-kicker"><span>{lesson.id}</span><span aria-hidden="true">·</span><span><span class="i18n-en">{lesson.kindEn}</span><span class="i18n-pt">{lesson.kindPt}</span></span></div>
              <h3><span class="i18n-en">{lesson.titleEn}</span><span class="i18n-pt">{lesson.titlePt}</span></h3>
              <p class="djl-lesson-duration"><span aria-hidden="true">◷</span> <span class="i18n-en">{lesson.durationEn}</span><span class="i18n-pt">{lesson.durationPt}</span></p>
            </div>
            <button class="djl-complete" type="button" data-complete-lesson={lesson.id} aria-pressed="false">
              <span class="djl-complete__dot" aria-hidden="true">✓</span>
              <span class="i18n-en">Mark complete</span><span class="i18n-pt">Marcar como concluída</span>
            </button>
          </header>

          <div class="djl-lesson-grid">
            <section class="djl-card djl-card--goal">
              <span class="djl-card__label"><span class="i18n-en">Goal</span><span class="i18n-pt">Objetivo</span></span>
              <p><span class="i18n-en">{lesson.objectiveEn}</span><span class="i18n-pt">{lesson.objectivePt}</span></p>
            </section>
            <section class="djl-card">
              <span class="djl-card__label"><span class="i18n-en">Before you begin</span><span class="i18n-pt">Antes de começar</span></span>
              <p><span class="i18n-en">{lesson.beforeEn}</span><span class="i18n-pt">{lesson.beforePt}</span></p>
            </section>
          </div>

          <section class="djl-section-block">
            <div class="djl-section-title"><span class="djl-section-number">01</span><h4><span class="i18n-en">Do this</span><span class="i18n-pt">Faça assim</span></h4></div>
            <ol class="djl-steps">
              {lesson.stepsEn.map((step, stepIndex) => <li><span class="i18n-en">{step}</span><span class="i18n-pt">{lesson.stepsPt[stepIndex]}</span></li>)}
            </ol>
          </section>

          <div class="djl-lesson-grid djl-lesson-grid--lower">
            <section class="djl-card djl-card--expected">
              <span class="djl-card__label"><span class="i18n-en">What you should see</span><span class="i18n-pt">O que você deve ver</span></span>
              <p><span class="i18n-en">{lesson.expectedEn}</span><span class="i18n-pt">{lesson.expectedPt}</span></p>
            </section>
            <section class="djl-card djl-card--stuck">
              <span class="djl-card__label"><span class="i18n-en">If you get stuck</span><span class="i18n-pt">Se der erro</span></span>
              <p><span class="i18n-en">{lesson.stuckEn}</span><span class="i18n-pt">{lesson.stuckPt}</span></p>
            </section>
          </div>

          <section class="djl-exercise">
            <div>
              <span class="djl-card__label"><span class="i18n-en">Your practice</span><span class="i18n-pt">Sua prática</span></span>
              <h4><span class="i18n-en">Make it yours</span><span class="i18n-pt">Faça do seu jeito</span></h4>
              <p><span class="i18n-en">{lesson.exerciseEn}</span><span class="i18n-pt">{lesson.exercisePt}</span></p>
            </div>
            <span class="djl-exercise__mark"><span class="i18n-en">Build → verify → explain</span><span class="i18n-pt">Construa → verifique → explique</span></span>
          </section>
          {lesson.sandbox && <DevJourneyExerciseSandbox lessonId={lesson.id} sandbox={lesson.sandbox} />}
          <nav class="djl-lesson-nav-actions" aria-label="Lesson navigation">
            {index > 0 ? (
              <button
                class="djl-lesson-step djl-lesson-step--previous"
                type="button"
                data-lesson-target={DEVJOURNEY_LESSONS[index - 1].id}
                data-tier-required={DEVJOURNEY_LESSONS[index - 1].tier !== "social" ? DEVJOURNEY_LESSONS[index - 1].tier : undefined}
                disabled={DEVJOURNEY_LESSONS[index - 1].tier !== "social"}
              >
                <span aria-hidden="true">←</span>
                <span>
                  <small><span class="i18n-en">Previous lesson</span><span class="i18n-pt">Aula anterior</span></small>
                  <strong><span class="i18n-en">{DEVJOURNEY_LESSONS[index - 1].titleEn}</span><span class="i18n-pt">{DEVJOURNEY_LESSONS[index - 1].titlePt}</span></strong>
                </span>
              </button>
            ) : <span class="djl-lesson-step djl-lesson-step--empty" aria-hidden="true"></span>}
            {index + 1 < DEVJOURNEY_LESSONS.length ? (
              <button
                class="djl-lesson-step djl-lesson-step--next"
                type="button"
                data-lesson-target={DEVJOURNEY_LESSONS[index + 1].id}
                data-tier-required={DEVJOURNEY_LESSONS[index + 1].tier !== "social" ? DEVJOURNEY_LESSONS[index + 1].tier : undefined}
                disabled={DEVJOURNEY_LESSONS[index + 1].tier !== "social"}
              >
                <span>
                  <small><span class="i18n-en">Next lesson</span><span class="i18n-pt">Próxima aula</span></small>
                  <strong><span class="i18n-en">{DEVJOURNEY_LESSONS[index + 1].titleEn}</span><span class="i18n-pt">{DEVJOURNEY_LESSONS[index + 1].titlePt}</span></strong>
                </span>
                <span aria-hidden="true">→</span>
              </button>
            ) : <span class="djl-lesson-step djl-lesson-step--empty" aria-hidden="true"></span>}
          </nav>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.getElementById('learning');
    if (!root) return;
    var key = 'volynx_devjourney_lessons';
    var navItems = Array.prototype.slice.call(root.querySelectorAll('[data-lesson-id]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[data-lesson-panel]'));
    var lessonActions = Array.prototype.slice.call(root.querySelectorAll('[data-lesson-target]'));
    var completeButtons = Array.prototype.slice.call(root.querySelectorAll('[data-complete-lesson]'));
    var progressValue = document.getElementById('djlProgressValue');
    var progressBar = document.getElementById('djlProgressBar');
    var progressMeta = document.getElementById('djlProgressMeta');
    var syncStatus = document.getElementById('djlSyncStatus');
    var mobileLesson = document.getElementById('djlMobileLesson');
    var progressEndpoint = 'https://zdmpzrderifgqmqivjoy.supabase.co/functions/v1/devjourney-progress';
    var serverPrefix = 'lesson-';
    var currentLessonKey = 'volynx_devjourney_current_lesson';
    var total = completeButtons.length;
    var completed = {};
    var knownLessons = {};
    var userOpenedLesson = false;

    completeButtons.forEach(function (button) {
      knownLessons[button.getAttribute('data-complete-lesson')] = true;
    });

    try { completed = JSON.parse(localStorage.getItem(key) || '{}') || {}; } catch (_) { completed = {}; }

    function save() {
      try { localStorage.setItem(key, JSON.stringify(completed)); } catch (_) {}
    }

    function getToken() {
      try { return localStorage.getItem('volynx_access_token') || ''; } catch (_) { return ''; }
    }

    function setSyncStatus(state) {
      if (!syncStatus) return;
      var labels = {
        local: ['Saved on this device', 'Salvo neste dispositivo'],
        syncing: ['Syncing to your account…', 'Sincronizando com sua conta…'],
        synced: ['Saved to your account', 'Salvo na sua conta'],
        offline: ['Offline — saved locally', 'Offline — salvo localmente'],
        error: ['Could not sync — saved locally', 'Não foi possível sincronizar — salvo localmente'],
      };
      var pair = labels[state] || labels.local;
      syncStatus.dataset.state = state;
      var en = syncStatus.querySelector('.i18n-en');
      var pt = syncStatus.querySelector('.i18n-pt');
      if (en) en.textContent = pair[0];
      if (pt) pt.textContent = pair[1];
    }

    function syncLesson(id, isComplete, token) {
      return fetch(progressEndpoint, {
        method: 'POST',
        headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'upsert', item_id: serverPrefix + id, completed: isComplete }),
      }).then(function (response) {
        if (response.status === 401) {
          var expired = new Error('session_expired');
          expired.code = 'session_expired';
          throw expired;
        }
        if (!response.ok) throw new Error('sync_failed');
        return response.json().then(function (data) {
          if (data && data.ok === false) throw new Error('sync_failed');
          return data;
        });
      });
    }

    function restoreLesson() {
      var savedLesson = '';
      try { savedLesson = localStorage.getItem(currentLessonKey) || ''; } catch (_) {}
      var firstIncomplete = completeButtons.find(function (button) {
        return !completed[button.getAttribute('data-complete-lesson')];
      });
      var firstIncompleteId = firstIncomplete && firstIncomplete.getAttribute('data-complete-lesson');
      var startLesson = savedLesson && knownLessons[savedLesson] && !completed[savedLesson]
        ? savedLesson
        : firstIncompleteId;
      if (startLesson) openLesson(startLesson);
    }

    function loadServerProgress() {
      var token = getToken();
      if (!token) { setSyncStatus('local'); return; }
      setSyncStatus('syncing');
      fetch(progressEndpoint, {
        method: 'POST',
        headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'get' }),
      }).then(function (response) {
        if (response.status === 401) {
          setSyncStatus('local');
          return null;
        }
        if (!response.ok) throw new Error('progress_failed');
        return response.json();
      }).then(function (data) {
        if (!data) return;
        var merged = {};
        (Array.isArray(data.items) ? data.items : []).forEach(function (itemId) {
          var id = String(itemId || '');
          if (id.indexOf(serverPrefix) === 0 && knownLessons[id.slice(serverPrefix.length)]) {
            merged[id.slice(serverPrefix.length)] = true;
          }
        });
        var pending = [];
        Object.keys(completed).forEach(function (id) {
          if (knownLessons[id] && completed[id] && !merged[id]) {
            merged[id] = true;
            pending.push(id);
          }
        });
        completed = merged;
        save();
        paintCompletion();
        if (!userOpenedLesson) restoreLesson();
        if (!pending.length) { setSyncStatus('synced'); return; }
        Promise.all(pending.map(function (id) { return syncLesson(id, true, token); }))
          .then(function () { setSyncStatus('synced'); })
          .catch(function () { setSyncStatus('error'); });
      }).catch(function () { setSyncStatus('offline'); });
    }

    function updateProgress() {
      var count = Object.keys(completed).filter(function (id) { return completed[id]; }).length;
      var percent = total ? Math.round((count / total) * 100) : 0;
      if (progressValue) progressValue.textContent = percent + '%';
      if (progressBar) progressBar.style.width = percent + '%';
      if (progressMeta) progressMeta.textContent = count + ' / ' + total;
    }

    function paintCompletion() {
      completeButtons.forEach(function (button) {
        var id = button.getAttribute('data-complete-lesson');
        var isComplete = Boolean(completed[id]);
        button.classList.toggle('is-complete', isComplete);
        button.setAttribute('aria-pressed', String(isComplete));
        var text = button.querySelector('.i18n-en');
        var textPt = button.querySelector('.i18n-pt');
        if (text) text.textContent = isComplete ? 'Completed' : 'Mark complete';
        if (textPt) textPt.textContent = isComplete ? 'Concluída' : 'Marcar como concluída';
      });
      navItems.forEach(function (item) {
        var state = item.querySelector('.djl-lesson-nav__state');
        if (state) state.textContent = completed[item.getAttribute('data-lesson-id')] ? '✓' : '';
        item.classList.toggle('is-complete', Boolean(completed[item.getAttribute('data-lesson-id')]));
      });
      updateProgress();
    }

    function openLesson(id) {
      var target = panels.find(function (panel) { return panel.getAttribute('data-lesson-panel') === id; });
      if (!target || target.hasAttribute('data-tier-required') && target.classList.contains('djl-is-locked')) return;
      try { localStorage.setItem(currentLessonKey, id); } catch (_) {}
      panels.forEach(function (panel) { panel.classList.toggle('is-hidden', panel !== target); });
      navItems.forEach(function (item) {
        var active = item.getAttribute('data-lesson-id') === id;
        item.classList.toggle('is-active', active);
        if (active) item.setAttribute('aria-current', 'step'); else item.removeAttribute('aria-current');
      });
      if (mobileLesson) mobileLesson.textContent = id;
    }

    navItems.forEach(function (item) {
      item.addEventListener('click', function () {
        if (!item.disabled) {
          userOpenedLesson = true;
          openLesson(item.getAttribute('data-lesson-id'));
        }
      });
    });
    lessonActions.forEach(function (button) {
      button.addEventListener('click', function () {
        if (button.disabled) return;
        userOpenedLesson = true;
        var targetId = button.getAttribute('data-lesson-target');
        openLesson(targetId);
        var target = panels.find(function (panel) { return panel.getAttribute('data-lesson-panel') === targetId; });
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    completeButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        var id = button.getAttribute('data-complete-lesson');
        completed[id] = !completed[id];
        save();
        paintCompletion();
        var token = getToken();
        if (!token) { setSyncStatus('local'); return; }
        setSyncStatus('syncing');
        syncLesson(id, completed[id], token)
          .then(function () { setSyncStatus('synced'); })
          .catch(function (error) { setSyncStatus(error.code === 'session_expired' ? 'local' : 'error'); });
      });
    });
    paintCompletion();
    restoreLesson();
    loadServerProgress();

    window.addEventListener('volynx:devjourney:tier', function (event) {
      var rank = { social: 0, pro: 1, bundle: 2 };
      var tier = String(event.detail || 'social').toLowerCase();
      root.querySelectorAll('[data-tier-required]').forEach(function (node) {
        var required = node.getAttribute('data-tier-required');
        var allowed = (rank[tier] || 0) >= (rank[required] || 0);
        node.classList.toggle('djl-is-locked', !allowed);
        if (node.classList.contains('djl-block')) node.classList.toggle('djl-block--locked', !allowed);
        if (node.matches('button')) node.disabled = !allowed;
        var lock = node.querySelector('.djl-lock');
        if (lock) lock.hidden = allowed;
      });
    });
  })();
</script>

<style>
  .djl-room { margin: 38px 0 42px; }
  .djl-room__header { display: flex; justify-content: space-between; gap: 28px; align-items: end; margin-bottom: 18px; }
  .djl-room__header h2 { margin: 7px 0 8px; max-width: 27ch; font-size: clamp(24px, 3vw, 36px); line-height: 1.08; }
  .djl-room__intro { max-width: 62ch; margin: 0; color: rgba(255,255,255,.68); line-height: 1.65; font-size: 14px; }
  .djl-progress { width: min(230px, 100%); padding: 14px; border: 1px solid rgba(140,255,210,.2); border-radius: 14px; background: rgba(140,255,210,.05); flex: 0 0 auto; }
  .djl-progress__label, .djl-progress__meta { display: block; color: rgba(255,255,255,.58); font-size: 11px; text-transform: uppercase; letter-spacing: .1em; }
  .djl-progress__sync { display: block; min-height: 16px; margin-top: 9px; color: rgba(140,255,210,.72); font-size: 10px; line-height: 1.4; }
  .djl-progress__sync[data-state="syncing"] { color: rgba(0,219,255,.82); }
  .djl-progress__sync[data-state="offline"], .djl-progress__sync[data-state="error"] { color: rgba(255,186,120,.88); }
  .djl-progress strong { display: block; margin: 3px 0 8px; color: #f3e1a0; font-size: 24px; }
  .djl-progress__track { height: 6px; border-radius: 99px; overflow: hidden; background: rgba(255,255,255,.1); }
  .djl-progress__track span { display: block; width: 0; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #8cffd2, #00dbff); transition: width .25s ease; }
  .djl-layout { display: grid; grid-template-columns: minmax(230px, .72fr) minmax(0, 1.7fr); gap: 16px; align-items: start; }
  .djl-curriculum, .djl-content { min-width: 0; border: 1px solid rgba(255,255,255,.1); border-radius: 18px; background: rgba(255,255,255,.035); }
  .djl-curriculum { position: sticky; top: 24px; padding: 14px; max-height: min(720px, calc(100vh - 48px)); overflow: auto; }
  .djl-curriculum__top { display: flex; justify-content: space-between; gap: 8px; margin: 2px 3px 12px; color: #fff; font-size: 13px; font-weight: 700; }
  .djl-curriculum__hint { color: rgba(140,255,210,.8); font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; }
  .djl-block { padding: 12px 0 9px; border-top: 1px solid rgba(255,255,255,.08); }
  .djl-block:first-of-type { border-top: 0; }
  .djl-block__heading { display: grid; grid-template-columns: 28px minmax(0,1fr) 18px; gap: 9px; align-items: start; margin-bottom: 8px; }
  .djl-block__number { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 9px; color: #080610; background: #f3e1a0; font-size: 11px; font-weight: 800; }
  .djl-block--locked .djl-block__number { opacity: .5; }
  .djl-block__heading strong { display: block; color: rgba(255,255,255,.92); font-size: 12px; }
  .djl-block__heading small { display: block; margin-top: 3px; color: rgba(255,255,255,.48); font-size: 10.5px; line-height: 1.4; }
  .djl-lock { color: rgba(255,255,255,.4); font-size: 16px; transform: rotate(45deg); }
  .djl-block__lessons { display: grid; gap: 3px; }
  .djl-lesson-nav { display: grid; grid-template-columns: 14px minmax(0,1fr); gap: 8px; align-items: start; width: 100%; padding: 8px 8px; border: 1px solid transparent; border-radius: 10px; color: rgba(255,255,255,.62); background: transparent; text-align: left; cursor: pointer; font: inherit; }
  .djl-lesson-nav:hover, .djl-lesson-nav:focus-visible { border-color: rgba(0,219,255,.25); background: rgba(0,219,255,.06); color: #fff; }
  .djl-lesson-nav.is-active { border-color: rgba(0,219,255,.35); background: rgba(0,219,255,.1); color: #fff; }
  .djl-lesson-nav:disabled { cursor: not-allowed; opacity: .42; }
  .djl-lesson-nav__state { display: grid; place-items: center; width: 14px; height: 14px; margin-top: 2px; border: 1px solid rgba(255,255,255,.25); border-radius: 50%; color: #080610; background: transparent; font-size: 9px; font-weight: 900; }
  .djl-lesson-nav.is-complete .djl-lesson-nav__state { border-color: #8cffd2; background: #8cffd2; }
  .djl-lesson-nav__copy { display: grid; gap: 2px; font-size: 11.5px; line-height: 1.35; }
  .djl-lesson-nav__id { color: rgba(255,255,255,.38); font-size: 9px; letter-spacing: .08em; }
  .djl-content { padding: clamp(18px, 3vw, 28px); }
  .djl-mobile-context { display: none; }
  .djl-lesson-panel.is-hidden { display: none; }
