---
// VxFooter — minimal footer for VOLYNX education/lab pages
---

<footer class="vxf" role="contentinfo">
  <div class="vxf__inner">
    <span class="vxf__copy">© {new Date().getFullYear()} VOLYNX</span>
    <nav class="vxf__links" aria-label="Links legais">
      <a href="/">Home</a>
      <a href="/products/">Products</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="/disclaimer/">Legal</a>
    </nav>
  </div>
</footer>

<style>
  .vxf {
    width: 100%;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(4, 5, 14, 0.80);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 18px 24px;
  }
  .vxf__inner {
    max-width: 1160px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }
  .vxf__copy {
    font-size: 12px;
    color: rgba(200, 205, 255, 0.40);
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .vxf__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }
  .vxf__links a {
    font-size: 12px;
    color: rgba(200, 205, 255, 0.45);
    text-decoration: none;
    letter-spacing: 0.03em;
    transition: color 0.15s;
  }
  .vxf__links a:hover { color: rgba(200, 245, 255, 0.85); }
  @media (max-width: 600px) {
    .vxf__inner { flex-direction: column; align-items: flex-start; }
  }
</style>
