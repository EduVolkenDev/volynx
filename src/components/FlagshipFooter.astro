---
import { ROUTES } from "../data/routes";
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <div class="footer-brand">VOLYNX</div>
      <p class="footer-copy" data-i18n="footer.tagline">Building a smarter future through premium kits, local-first tools and production-grade digital systems.</p>
    </div>
    <div>
      <h4 data-i18n="footer.ecosystem">Ecosystem</h4>
      <a href={ROUTES.builder} data-i18n="nav.builder">Builder</a>
      <a href={ROUTES.products} data-i18n="nav.products">Products</a>
      <a href={ROUTES.services} data-i18n="nav.services">Services</a>
      <a href={ROUTES.lab} data-i18n="footer.link_lab">VOLYNX Lab</a>
      <a href={ROUTES.iconsStore} data-i18n="footer.link_icons">Icons Store</a>
      <a href={ROUTES.pricing} data-i18n="nav.pricing">Pricing</a>
    </div>
    <div>
      <h4 data-i18n="footer.platform">Platform</h4>
      <a href={ROUTES.profile} data-i18n="footer.link_command">Command Center</a>
      <a href={ROUTES.devHub} data-i18n="nav.devhub">Dev Hub</a>
      <a href={ROUTES.daily} data-i18n="footer.link_daily">VOLYNX Daily</a>
      <a href={ROUTES.delivery}>My Products</a>
      <a href={ROUTES.cvitae} data-i18n="footer.link_cvitae">CVitae</a>
    </div>
    <div>
      <h4 data-i18n="footer.legal">Legal</h4>
      <a href={ROUTES.privacy} data-i18n="footer.link_privacy">Privacy</a>
      <a href={ROUTES.terms} data-i18n="footer.link_terms">Terms</a>
      <a href={ROUTES.disclaimer} data-i18n="footer.link_disclaimer">Disclaimer</a>
      <a href={ROUTES.support}>Support</a>
      <a href={ROUTES.contact} data-i18n="footer.link_contact">Contact</a>
    </div>
  </div>
</footer>
