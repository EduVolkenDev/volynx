---
interface Props {
  productName?: string;
  className?: string;
}

const {
  productName = "VOLYNX",
  className = "",
} = Astro.props;

const trustItems = [
  {
    label: "Session checked",
    copy: "Checkout and purchase context stay attached before delivery surfaces unlock."
  },
  {
    label: "Protected access",
    copy: "Products route through the right destination so downloads and unlocks are not exposed by accident."
  },
  {
    label: "Support ready",
    copy: "If delivery stalls, the same purchase context gives support a fast recovery path."
  }
];
---

<section class:list={["delivery-trust", className]} aria-label={productName + " delivery checks"}>
  {trustItems.map((item) => (
    <article class="delivery-trust__card">
      <span class="delivery-trust__badge" aria-hidden="true"></span>
      <div>
        <h2>{item.label}</h2>
        <p>{item.copy}</p>
      </div>
    </article>
  ))}
</section>

<style>
  .delivery-trust {
    display: grid;
    gap: 12px;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 14px;
    border: 1px solid rgba(148, 163, 184, .16);
    border-radius: 26px;
    background:
      radial-gradient(circle at 8% 0%, rgba(79, 195, 247, .18), transparent 34%),
      radial-gradient(circle at 92% 100%, rgba(167, 139, 250, .16), transparent 38%),
      linear-gradient(135deg, rgba(18, 29, 48, .9), rgba(8, 12, 24, .82) 52%, rgba(18, 12, 35, .9));
    box-shadow: 0 26px 60px rgba(0, 0, 0, .22), inset 0 1px 0 rgba(255, 255, 255, .08);
  }
  .delivery-trust__card {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 14px;
    min-height: 132px;
    padding: 20px;
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,.1);
    background: linear-gradient(145deg, rgba(255,255,255,.09), rgba(7, 10, 20, .56));
    box-shadow: inset 0 1px 0 rgba(255,255,255,.07);
  }
  .delivery-trust__badge {
    display: inline-flex;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    margin-top: 4px;
    background: #4fc3f7;
    box-shadow: 0 0 18px rgba(79,195,247,.45);
    flex-shrink: 0;
  }
  .delivery-trust__card h2 {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
  }
  .delivery-trust__card p {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.65;
    color: rgba(255,255,255,.68);
  }
  @media (min-width: 860px) {
    .delivery-trust {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 50px;
    }
  }
</style>
