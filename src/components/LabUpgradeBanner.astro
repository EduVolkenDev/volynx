---
// Upgrade CTA banner for free Lab tools — shown after tool use
---

<aside class="lab-upgrade-banner" aria-label="Studio Pro upgrade">
  <div class="lab-upgrade-banner__inner">
    <div class="lab-upgrade-banner__left">
      <span class="lab-upgrade-banner__badge">Studio Pro</span>
      <p class="lab-upgrade-banner__text">
        <strong>Free tools have daily limits.</strong>
        Studio Pro removes them all — unlimited processing, batch mode, and commercial rights.
      </p>
    </div>
    <a class="lab-upgrade-banner__cta" href="/volynx-lab/studio/">
      Explore Studio — £19/month →
    </a>
  </div>
</aside>

<style>
  .lab-upgrade-banner {
    margin: 32px auto 0;
    max-width: 860px;
    padding: 0 clamp(14px, 4vw, 24px);
  }
  .lab-upgrade-banner__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: rgba(109, 94, 252, .08);
    border: 1px solid rgba(109, 94, 252, .22);
    border-radius: 16px;
    padding: 16px 22px;
    flex-wrap: wrap;
  }
  .lab-upgrade-banner__left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }
  .lab-upgrade-banner__badge {
    flex-shrink: 0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(180, 160, 255, .9);
    background: rgba(109, 94, 252, .15);
    border: 1px solid rgba(109, 94, 252, .35);
    border-radius: 999px;
    padding: 4px 10px;
  }
  .lab-upgrade-banner__text {
    font-size: 13px;
    color: rgba(255, 255, 255, .6);
    margin: 0;
    line-height: 1.5;
  }
  .lab-upgrade-banner__text strong {
    color: rgba(255, 255, 255, .85);
    font-weight: 600;
  }
  .lab-upgrade-banner__cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border-radius: 10px;
    background: rgba(109, 94, 252, .15);
    border: 1px solid rgba(109, 94, 252, .4);
    color: rgba(200, 185, 255, .9);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s;
  }
  .lab-upgrade-banner__cta:hover {
    background: rgba(109, 94, 252, .25);
    border-color: rgba(130, 110, 255, .6);
    color: rgba(220, 210, 255, 1);
  }
  @media (max-width: 580px) {
    .lab-upgrade-banner__inner { flex-direction: column; align-items: flex-start; }
    .lab-upgrade-banner__cta { width: 100%; justify-content: center; }
  }
</style>
