---
// Upgrade CTA banner for free Lab tools — shown after tool use
import { productPreviewHref } from "../data/routes";
const studioProOfferHref = `${productPreviewHref("studio_pro")}?utm_source=volynx-lab&utm_medium=upgrade-banner&utm_campaign=studio-pro`;
---

<aside class="lab-upgrade-banner" id="labUpgradeBanner" hidden aria-label="Studio Pro upgrade" data-i18n-aria="aria.studio_upgrade">
  <div class="lab-upgrade-banner__inner">
    <div class="lab-upgrade-banner__left">
      <span class="lab-upgrade-banner__badge" data-i18n="lab_banner.badge">Studio Pro</span>
      <p class="lab-upgrade-banner__text">
        <strong data-i18n="lab_banner.limit">Free tools have daily limits.</strong>
        <span data-i18n="lab_banner.promo"> Studio Pro raises them significantly — much higher limits, batch mode, and commercial rights.</span>
      </p>
    </div>
    <a class="lab-upgrade-banner__cta" href={studioProOfferHref} data-i18n="lab_banner.cta">
      Explore Studio — £18/month →
    </a>
  </div>
</aside>

<script is:inline>
  (function () {
    var banner = document.getElementById('labUpgradeBanner');
    if (!banner) return;
    var RANK = { free: 0, launch: 1, business: 2, pro: 2, diamond: 2, studio: 3, teams: 4, enterprise: 5 };
    var STUDIO = 3;

    function rankOf(plan) {
      if (!plan) return 0;
      var r = RANK[String(plan).toLowerCase()];
      return r == null ? 0 : r;
    }

    function apply(plan) {
      var r = rankOf(plan);
      banner.hidden = !(r > 0 && r < STUDIO);
    }

    try {
      var cached = JSON.parse(localStorage.getItem('volynx_plan_cache') || 'null');
      if (cached && cached.plan) apply(cached.plan);
    } catch (_) {}

    if (window.vxPlan) apply(window.vxPlan);

    window.addEventListener('vx:plan-ready', function (e) {
      apply(e && e.detail && e.detail.plan);
    });
  })();
</script>

<style>
  .lab-upgrade-banner {
    margin: 32px auto 0;
    max-width: 860px;
    padding: 0 clamp(14px, 4vw, 24px);
  }
  .lab-upgrade-banner[hidden] {
    display: none !important;
  }
  .lab-upgrade-banner__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: rgba(109, 94, 252, .08);
    border: 1px solid rgba(109, 94, 252, .22);
    border-radius: 16px;
    padding: 16px 22px;
    flex-wrap: wrap;
  }
  .lab-upgrade-banner__left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }
  .lab-upgrade-banner__badge {
    flex-shrink: 0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(180, 160, 255, .9);
    background: rgba(109, 94, 252, .15);
    border: 1px solid rgba(109, 94, 252, .35);
    border-radius: 999px;
    padding: 4px 10px;
  }
  .lab-upgrade-banner__text {
    font-size: 13px;
    color: rgba(255, 255, 255, .6);
    margin: 0;
    line-height: 1.5;
  }
  .lab-upgrade-banner__text strong {
    color: rgba(255, 255, 255, .85);
    font-weight: 600;
  }
  .lab-upgrade-banner__cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border-radius: 10px;
    background: rgba(109, 94, 252, .15);
    border: 1px solid rgba(109, 94, 252, .4);
    color: rgba(200, 185, 255, .9);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s;
  }
  .lab-upgrade-banner__cta:hover {
    background: rgba(109, 94, 252, .25);
    border-color: rgba(130, 110, 255, .6);
    color: rgba(220, 210, 255, 1);
  }
  @media (max-width: 580px) {
    .lab-upgrade-banner__inner { flex-direction: column; align-items: flex-start; }
    .lab-upgrade-banner__cta { width: 100%; justify-content: center; }
  }
</style>
