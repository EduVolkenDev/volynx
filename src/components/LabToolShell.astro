---
import LabToolSwitcher from "./LabToolSwitcher.astro";
import { ROUTES } from "../data/routes";

type ToolKey = "home" | "converter" | "scaler" | "suite" | "lumina" | "qr";

interface Props {
  active?: ToolKey;
}

const { active = "home" } = Astro.props;
---

<section class="vx-lab-shell" aria-label="VOLYNX Lab workspace">
  <LabToolSwitcher active={active} />
  <div class="vx-lab-shell__bar">
    <div class="vx-lab-shell__copy">
      <span>Lab Workspace</span>
      <strong>History, presets and exports now follow your profile.</strong>
    </div>
    <div class="vx-lab-shell__actions">
      <a href={ROUTES.profile} data-auth="in">Profile</a>
      <a href={`${ROUTES.login}?next=${ROUTES.lab}`} data-auth="out">Sign in</a>
      <a href={ROUTES.pricing}>Upgrade</a>
    </div>
  </div>
</section>

<style>
  .vx-lab-shell {
    width: min(1120px, calc(100% - 40px));
    margin: 18px auto 8px;
    position: relative;
    z-index: 2;
  }

  .vx-lab-shell :global(.vx-lab-switcher) {
    width: 100%;
    margin: 0;
  }

  .vx-lab-shell__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 10px;
    padding: 12px 14px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(214,168,79,.1), rgba(125,249,255,.055)),
      rgba(4,8,18,.72);
    box-shadow: 0 18px 60px rgba(0,0,0,.22);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .vx-lab-shell__copy {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .vx-lab-shell__copy span {
    color: rgba(125,249,255,.78);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .vx-lab-shell__copy strong {
    color: rgba(255,255,255,.88);
    font-size: 13px;
    line-height: 1.35;
  }

  .vx-lab-shell__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    flex: 0 0 auto;
  }

  .vx-lab-shell__actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 8px 12px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 8px;
    color: rgba(255,255,255,.84);
    background: rgba(255,255,255,.045);
    font-size: 12px;
    font-weight: 900;
    text-decoration: none;
    white-space: nowrap;
  }

  .vx-lab-shell__actions a:last-child {
    color: #06142e;
    border-color: rgba(214,168,79,.4);
    background: linear-gradient(135deg, #d6a84f, #f8e9c1);
  }

  @media (max-width: 720px) {
    .vx-lab-shell {
      width: min(100% - 22px, 1120px);
    }

    .vx-lab-shell__bar {
      align-items: stretch;
      flex-direction: column;
    }

    .vx-lab-shell__actions {
      justify-content: stretch;
    }

    .vx-lab-shell__actions a {
      flex: 1 1 auto;
    }
  }
</style>
