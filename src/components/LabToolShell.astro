---
import LabToolSwitcher from "./LabToolSwitcher.astro";
import { ROUTES, productPreviewHref } from "../data/routes";

type ToolKey = "home" | "converter" | "scaler" | "suite" | "lumina" | "qr";

interface Props {
  active?: ToolKey;
}

const { active = "home" } = Astro.props;

const shellByTool: Record<ToolKey, { title: string; copy: string; states: string[]; cta: string; ctaHref: string }> = {
  home: {
    title: "VOLYNX Lab",
    copy: "Your toolkit for browser tools, AI tools, saved presets and exports.",
    states: ["Free", "Pro", "VX on selected actions", "Runs locally"],
    cta: "Open your saved work",
    ctaHref: ROUTES.profile,
  },
  converter: {
    title: "Converter",
    copy: "Free browser conversion with ZIP export, saved presets and Pro limits when volume grows.",
    states: ["Free", "Local", "ZIP", "Presets"],
    cta: "Explore plans",
    ctaHref: ROUTES.pricing,
  },
  scaler: {
    title: "Image Scaler",
    copy: "Local upscale with saved scale presets, clear results and Pro features for larger projects.",
    states: ["Free", "Local", "Preview", "Pro features"],
    cta: "Explore plans",
    ctaHref: ROUTES.pricing,
  },
  suite: {
    title: "iMage Suite",
    copy: "Reusable image tools for upscaling, compression, conversion and background removal.",
    states: ["Free", "Pro", "Local AI", "Recipes"],
    cta: "Open Studio Pro",
    ctaHref: `${productPreviewHref("studio_pro")}?utm_source=image-suite&utm_medium=tool-shell&utm_campaign=studio-pro`,
  },
  lumina: {
    title: "Lumina",
    copy: "Clear explanations, local fallback, reusable answers and profile history.",
    states: ["Free", "AI", "Local fallback", "Export"],
    cta: "Upgrade Lumina",
    ctaHref: ROUTES.pricing,
  },
  qr: {
    title: "QRGen",
    copy: "Create branded QR projects with strong previews and premium export options.",
    states: ["Free", "Launch", "Pro", "Projects"],
    cta: "Compare QRGen plans",
    ctaHref: ROUTES.pricing,
  },
};

const shell = shellByTool[active] || shellByTool.home;
---

<section class="vx-lab-shell" aria-label="VOLYNX Lab tools">
  <LabToolSwitcher active={active} />
  <div class="vx-lab-shell__bar">
    <div class="vx-lab-shell__copy">
      <span data-i18n={`lab_shell.${active}_title`}>{shell.title}</span>
      <strong data-i18n={`lab_shell.${active}_copy`}>{shell.copy}</strong>
      <div class="vx-lab-shell__states" aria-label="Tool access states">
        {shell.states.map((state, index) => <em data-i18n={`lab_shell.${active}_state${index + 1}`}>{state}</em>)}
      </div>
    </div>
    <div class="vx-lab-shell__actions">
      <a href={ROUTES.profile} data-auth="in" data-i18n="nav.profile">Profile</a>
      <a href={`${ROUTES.login}?next=${ROUTES.lab}`} data-auth="out" data-i18n="login2.kicker">Sign in</a>
      <a href={shell.ctaHref} data-i18n={`lab_shell.${active}_cta`}>{shell.cta}</a>
    </div>
  </div>
  <div class="vx-lab-shell__legend" aria-label="Tool access">
    <span><b data-i18n="lab_shell.legend_free_label">Free</b><em data-i18n="lab_shell.legend_free_desc">starter limits may apply</em></span>
    <span><b>Pro</b><em data-i18n="lab_shell.legend_pro_desc">higher limits and premium exports</em></span>
    <span><b>VX</b><em data-i18n="lab_shell.legend_vx_desc">available for selected actions</em></span>
    <span><b>Local</b><em data-i18n="lab_shell.legend_local_desc">runs in this browser when possible</em></span>
  </div>
</section>

<style>
  .vx-lab-shell {
    width: min(1120px, calc(100% - 40px));
    margin: 18px auto 8px;
    position: relative;
    z-index: 2;
  }

  .vx-lab-shell :global(.vx-lab-switcher) {
    width: 100%;
    margin: 0;
  }

  .vx-lab-shell__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 10px;
    padding: 12px 14px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(214,168,79,.1), rgba(125,249,255,.055)),
      rgba(4,8,18,.72);
    box-shadow: 0 18px 60px rgba(0,0,0,.22);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .vx-lab-shell__copy {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .vx-lab-shell__copy span {
    color: rgba(125,249,255,.78);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .vx-lab-shell__copy strong {
    color: rgba(255,255,255,.88);
    font-size: 13px;
    line-height: 1.35;
  }

  .vx-lab-shell__states,
  .vx-lab-shell__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .vx-lab-shell__states em,
  .vx-lab-shell__legend span {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 5px 8px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 8px;
    background: rgba(255,255,255,.045);
    color: rgba(255,255,255,.72);
    font-size: 11px;
    font-style: normal;
    font-weight: 800;
    line-height: 1.15;
  }

  .vx-lab-shell__states em:first-child {
    border-color: rgba(125,249,255,.26);
    color: rgba(125,249,255,.9);
    background: rgba(125,249,255,.075);
  }

  .vx-lab-shell__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    flex: 0 0 auto;
  }

  .vx-lab-shell__actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 10px 14px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 8px;
    color: rgba(255,255,255,.84);
    background: rgba(255,255,255,.045);
    font-size: 12px;
    font-weight: 900;
    text-decoration: none;
    white-space: nowrap;
  }

  .vx-lab-shell__actions a:last-child {
    color: #06142e;
    border-color: rgba(214,168,79,.4);
    background: linear-gradient(135deg, #d6a84f, #f8e9c1);
  }

  .vx-lab-shell__legend {
    margin-top: 8px;
    padding: 10px 12px;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 8px;
    background: rgba(4,8,18,.48);
  }

  .vx-lab-shell__legend b {
    color: #fff;
    margin-right: 4px;
  }

  .vx-lab-shell__legend em {
    font-style: normal;
  }

  @media (max-width: 720px) {
    .vx-lab-shell {
      width: min(100% - 22px, 1120px);
    }

    .vx-lab-shell__bar {
      align-items: stretch;
      flex-direction: column;
    }

    .vx-lab-shell__actions {
      justify-content: stretch;
    }

    .vx-lab-shell__actions a {
      flex: 1 1 auto;
      min-width: min(100%, 120px);
    }
  }
</style>
