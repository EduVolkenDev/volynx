---
import { ROUTES } from "../data/routes";

const nav = [
  { href: "https://daily.volynx.world", label: "Daily", i18n: "nav.daily" },
  { href: ROUTES.builder, label: "Builder", i18n: "nav.builder" },
  { href: "https://cvitae.volynx.world", label: "CVitae", i18n: "nav.cvitae" },
  { href: ROUTES.propertyflow, label: "PropertyFlow", i18n: "nav.propertyflow" },
  { href: ROUTES.lab, label: "Lab", i18n: "nav.lab" },
  { href: ROUTES.products, label: "Products", i18n: "nav.products" },
  { href: ROUTES.services, label: "Services", i18n: "nav.services" },
  { href: ROUTES.pricing, label: "Pricing", i18n: "nav.pricing" },
];

interface Props {
  current?: string;
  ctaHref?: string;
  ctaLabel?: string;
  ctaI18n?: string;
}
const { current = "", ctaHref = ROUTES.pricing, ctaLabel = "Go Pro", ctaI18n = "nav.go_pro" } = Astro.props;
---
<header class="vx-topbar" id="vxTopbar">
  <div class="vx-topbar__inner">
    <!-- LOGO -->
    <a href={ROUTES.home} class="vx-brand" aria-label="VOLYNX Ecosystem home" data-i18n-aria="aria.ecosystem_home">
      <img src="/assets/V.webp" alt="" class="vx-brand__mark" width="44" height="44" aria-hidden="true" loading="eager" decoding="async" />
      <span class="vx-brand__text">
        <img src="/assets/wordmark.webp" alt="VOLYNX" class="vx-brand__wordmark" width="132" height="72" loading="eager" decoding="async" />
      </span>
    </a>

    <!-- DESKTOP NAV -->
    <nav class="vx-nav" aria-label="Primary" data-i18n-aria="aria.primary_nav">
      {nav.map((item) => (
        <a href={item.href} class:list={{ "is-active": current === item.href }} data-i18n={item.i18n}>{item.label}</a>
      ))}
    </nav>

    <!-- RIGHT ACTIONS -->
    <div class="vx-actions">
      <!-- Token pill (authed only) -->
      <a href={ROUTES.account} class="vx-token-pill" id="vxTokenPill" aria-label="VX balance" data-i18n-aria="aria.vx_balance">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 7v10M8 10h8M8 14h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="vx-token-count" id="vxTokenCount">—</span>
        <span class="vx-token-label" data-i18n="widget.tokens">VX</span>
      </a>

      <!-- Get VX (authed only) -->
      <a href={ROUTES.recarregar} class="vx-recharge" data-i18n="widget.recharge">Get VX</a>

      <!-- Lang toggle -->
      <button
        id="vxLangToggle"
        class="vx-lang"
        aria-label="Toggle language"
        data-i18n-aria="aria.toggle_lang"
        data-vx-lang-toggle
        data-vx-lang-title
      >
        <span data-i18n="widget.lang" data-vx-lang-label>EN</span>
      </button>

      <!-- Signed-out: login + CTA -->
      <a href={ROUTES.login} class="vx-login" data-i18n="nav.login">Login</a>
      <a href={ctaHref} class="vx-cta" data-vx-hide-if-plan="pro" data-i18n={ctaI18n}>{ctaLabel}</a>

      <!-- Avatar (authed only) -->
      <a href={ROUTES.profile} class="vx-avatar" id="vxUserBadge" aria-label="Profile" data-i18n-aria="aria.profile">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>

      <!-- Mobile menu btn -->
      <button class="vx-burger" id="mobileMenuBtn" type="button" aria-label="Open menu" data-i18n-aria="aria.open_menu" aria-expanded="false">
        <svg class="vx-burger__open"  width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="6"  x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg class="vx-burger__close" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- MOBILE MENU -->
  <nav class="vx-mobile" id="mobileNav" aria-label="Mobile" data-i18n-aria="aria.mobile_nav">
    {nav.map((item) => (
      <a href={item.href} class:list={{ "is-active": current === item.href }} data-i18n={item.i18n}>{item.label}</a>
    ))}
    <a href={ROUTES.delivery} class="vx-mobile__link" data-i18n="nav.my_products">My Products</a>
    <a href={ROUTES.support} class="vx-mobile__link" data-i18n="nav.support">Support</a>
    <hr class="vx-mobile__hr" />
    <button
      type="button"
      class="vx-mobile__link vx-mobile__lang"
      id="vxLangToggleMobile"
      aria-label="Toggle language"
      data-i18n-aria="aria.toggle_lang"
      data-vx-lang-toggle
      data-vx-lang-title
    >
      <span data-i18n="widget.lang_full">Language</span>
      <span class="vx-mobile__lang-tag" id="vxLangTagMobile" data-vx-lang-label>EN</span>
    </button>
    <a href={ROUTES.login} class="vx-mobile__link" data-auth="out" data-i18n="nav.login">Login</a>
    <a href={ctaHref} class="vx-mobile__cta" data-auth="out" data-i18n={ctaI18n}>{ctaLabel}</a>
    <a href={ROUTES.profile} class="vx-mobile__profile" data-auth="in">
      <span class="vx-mobile__avatar" id="vxUserBadgeMobileInitials"></span>
      <span data-i18n="nav.profile">Profile</span>
    </a>
  </nav>
</header>

<style>
  :root {
    --topbar-h: 64px;
    --topbar-bg: rgba(9, 9, 11, 0.92);
    --topbar-border: rgba(39, 39, 42, 0.8);
    --topbar-text: #fafafa;
    --topbar-muted: #d4d4d8;
    --topbar-soft: #71717a;
    --topbar-accent: #2dd4bf;
  }

  /* ── SHELL ───────────────────────────────────────── */
  .vx-topbar {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--topbar-bg);
    backdrop-filter: blur(24px) saturate(1.4);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    border-bottom: 1px solid var(--topbar-border);
  }
  .vx-topbar__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 16px;
    min-height: var(--topbar-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .vx-topbar__inner { padding: 0 32px; }
  }

  /* ── BRAND ───────────────────────────────────────── */
  .vx-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    flex-shrink: 0;
    min-width: 44px;
    min-height: 44px;
    transition: opacity .15s;
  }
  .vx-brand:hover { opacity: .9; }
  .vx-brand__mark {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    object-fit: contain;
    box-shadow: 0 10px 28px rgba(45, 212, 191, 0.35);
    transition: transform .2s;
  }
  .vx-brand:hover .vx-brand__mark { transform: scale(1.08); }
  .vx-brand__text {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }
  .vx-brand__wordmark {
    width: 132px;
    height: auto;
    max-height: 38px;
    object-fit: contain;
    object-position: left center;
  }
  @media (max-width: 520px) {
    .vx-brand__text { display: none; }
  }

  /* ── DESKTOP NAV ─────────────────────────────────── */
  .vx-nav { display: none; }
  @media (min-width: 980px) {
    .vx-nav {
      display: flex;
      align-items: center;
      gap: 32px;
      font-size: 14px;
      font-weight: 500;
    }
    .vx-nav a {
      color: var(--topbar-muted);
      text-decoration: none;
      transition: color .25s ease, text-shadow .25s ease, transform .25s ease;
      white-space: nowrap;
      display: inline-block;
      will-change: transform;
    }
    .vx-nav a:hover {
      color: #fff;
      text-shadow: 0 0 10px #fff;
      transform: translateY(-2px);
    }
    .vx-nav a.is-active { color: #fff; }
  }

  /* ── ACTIONS ─────────────────────────────────────── */
  .vx-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  /* Token pill */
  .vx-token-pill { display: none; }
  :global(.vx-authed) .vx-token-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    background: #18181b;
    border: 1px solid #3f3f46;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all .15s;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  :global(.vx-authed) .vx-token-pill:hover {
    background: #27272a;
    border-color: var(--topbar-accent);
  }
  .vx-token-pill svg { color: var(--topbar-accent); flex-shrink: 0; }
  .vx-token-pill .vx-token-label {
    color: var(--topbar-soft);
    font-size: 12px;
    font-weight: 500;
  }

  /* Recharge CTA */
  .vx-recharge { display: none; }
  :global(.vx-authed) .vx-recharge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 22px;
    border-radius: 999px;
    background: #fafafa;
    color: #09090b;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all .15s;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    white-space: nowrap;
  }
  :global(.vx-authed) .vx-recharge:hover { background: #f4f4f5; }
  :global(.vx-authed) .vx-recharge:active { transform: scale(.96); }

  /* Lang */
  .vx-lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    height: 36px;
    padding: 0 12px;
    border-radius: 999px;
    background: #18181b;
    border: 1px solid #3f3f46;
    color: var(--topbar-muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all .15s;
    flex-shrink: 0;
  }
  .vx-lang:hover { background: #27272a; color: #fff; border-color: var(--topbar-accent); }

  /* Login link (signed-out) */
  .vx-login {
    color: var(--topbar-muted);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    padding: 6px 12px;
    white-space: nowrap;
    transition: color .15s;
  }
  .vx-login:hover { color: #fff; }
  :global(.vx-authed) .vx-login { display: none !important; }

  /* Gold CTA (Go Pro) */
  .vx-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 20px;
    border-radius: 999px;
    background: linear-gradient(135deg, #d4af37 0%, #f1c40f 100%);
    color: #09090b;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(212, 175, 55, 0.25);
    transition: all .15s;
  }
  .vx-cta:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(212, 175, 55, 0.4); }
  :global(.vx-authed) .vx-cta[data-vx-hide-if-plan="pro"] { display: none !important; }

  /* Avatar */
  .vx-avatar { display: none; }
  :global(.vx-authed) .vx-avatar {
    width: 36px;
    height: 36px;
    border-radius: 14px;
    background: linear-gradient(135deg, #3f3f46, #52525b);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    cursor: pointer;
    transition: all .15s;
    flex-shrink: 0;
    border: 1px solid transparent;
  }
  :global(.vx-authed) .vx-avatar:hover {
    border-color: rgba(45, 212, 191, 0.5);
    box-shadow: 0 0 0 2px rgba(45, 212, 191, 0.15);
  }

  /* Burger */
  .vx-burger {
    display: none;
    background: transparent;
    border: 0;
    padding: 8px;
    margin-right: -8px;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    color: var(--topbar-muted);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .vx-burger__close { display: none; }
  .vx-burger.is-open .vx-burger__open { display: none; }
  .vx-burger.is-open .vx-burger__close { display: inline; }

  /* ── MOBILE MENU ─────────────────────────────────── */
  .vx-mobile {
    display: none;
    background: #09090b;
    border-top: 1px solid #27272a;
    padding: 32px 24px;
    gap: 8px;
    flex-direction: column;
  }
  .vx-mobile.is-open { display: flex; }
  .vx-mobile a, .vx-mobile__profile {
    display: block;
    padding: 14px 4px;
    color: #fff;
    font-size: 18px;
    font-weight: 500;
    text-decoration: none;
  }
  .vx-mobile a.is-active { color: var(--topbar-accent); }
  .vx-mobile__hr { border: 0; border-top: 1px solid #27272a; margin: 12px 0; }
  .vx-mobile__cta {
    margin-top: 8px;
    padding: 14px !important;
    border-radius: 999px;
    background: linear-gradient(135deg, #d4af37 0%, #f1c40f 100%);
    color: #09090b !important;
    text-align: center;
    font-weight: 700 !important;
  }
  .vx-mobile__profile { display: none !important; align-items: center; gap: 12px; }
  :global(.vx-authed) .vx-mobile__profile { display: flex !important; }
  :global(.vx-authed) .vx-mobile [data-auth="out"] { display: none !important; }
  .vx-mobile__avatar {
    width: 36px; height: 36px;
    border-radius: 14px;
    background: linear-gradient(135deg, #3f3f46, #52525b);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
  }

  /* ── RESPONSIVE ──────────────────────────────────── */
  @media (max-width: 979px) {
    .vx-login, .vx-cta { display: none !important; }
    :global(.vx-authed) .vx-cta { display: none !important; }
    .vx-burger { display: inline-flex; }
    /* Lang toggle stays visible on mobile — every page must expose it */
    .vx-lang { display: inline-flex; min-width: 40px; height: 34px; padding: 0 10px; font-size: 11px; }
  }
  @media (max-width: 767px) {
    .vx-token-pill .vx-token-label { display: none; }
    .vx-token-pill { padding: 8px 12px; }
  }
  @media (max-width: 520px) {
    :global(.vx-authed) .vx-token-pill { display: none !important; }
    :global(.vx-authed) .vx-recharge { padding: 8px 14px; font-size: 12px; }
    .vx-actions { gap: 8px; }
    .vx-brand__mark { width: 44px; height: 44px; border-radius: 8px; }
  }
  @media (max-width: 460px) {
    :global(.vx-authed) .vx-recharge,
    :global(.vx-authed) .vx-avatar { display: none !important; }
    .vx-topbar__inner { padding: 0 12px; }
    .vx-actions { gap: 6px; }
    .vx-burger { display: inline-flex !important; margin-right: -4px; }
  }
  @media (max-width: 380px) {
    :global(.vx-authed) .vx-recharge { padding: 7px 12px; font-size: 11px; }
  }

  /* Mobile lang toggle row */
  .vx-mobile__lang {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: transparent;
    border: 0;
    border-radius: 12px;
    cursor: pointer;
    font-size: 18px;
    font-weight: 500;
    font-family: inherit;
  }
  .vx-mobile__lang-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 28px;
    padding: 0 10px;
    border-radius: 999px;
    background: #18181b;
    border: 1px solid #3f3f46;
    color: var(--topbar-muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .vx-mobile__lang:hover .vx-mobile__lang-tag {
    color: #fff;
    border-color: var(--topbar-accent);
  }
</style>

<script>
  // Burger
  const btn = document.getElementById("mobileMenuBtn");
  const nav = document.getElementById("mobileNav");
  if (btn && nav) {
    btn.addEventListener("click", () => {
      const open = nav.classList.toggle("is-open");
      btn.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", String(open));
    });
  }

  // Mobile lang toggle — toggle is handled globally by i18n.js.
  // We only close the menu here for a cleaner mobile flow.
  const langMobileBtn = document.getElementById("vxLangToggleMobile");
  langMobileBtn?.addEventListener("click", () => {
    nav?.classList.remove("is-open");
    btn?.classList.remove("is-open");
    btn?.setAttribute("aria-expanded", "false");
  });

  // Token pill — resilient: cache → VxTokens (polled) → direct fetch fallback
  (function wireTokenPill() {
    const countEl = document.getElementById("vxTokenCount");
    if (!countEl) return;
    function setCount(n: number | string | null | undefined) {
      if (n === null || n === undefined) { countEl.textContent = "—"; return; }
      const num = typeof n === "number" ? n : parseFloat(String(n));
      if (isNaN(num)) { countEl.textContent = "—"; return; }
      countEl.textContent = num.toLocaleString();
    }
    function persistBalance(n: number) {
      try {
        localStorage.setItem("volynx_token_balance", String(n));
        localStorage.setItem("volynx_token_balance_ts", String(Date.now()));
      } catch (_) {}
    }

    // 1. Show cached balance immediately from localStorage
    try {
      const rawCached = localStorage.getItem("volynx_token_balance");
      if (rawCached !== null) {
        const n = parseInt(rawCached, 10);
        if (!isNaN(n)) setCount(n);
      }
    } catch (_) {}

    // 2. Direct fetch — independent of VxTokens (used as fallback)
    async function directFetch() {
      try {
        const jwt = localStorage.getItem("volynx_access_token");
        if (!jwt) return;
        const cfg = await fetch("/config.json", { cache: "no-store" }).then(r => r.json());
        const apiBase = ((cfg && (cfg.functionsUrl || cfg.apiBaseUrl)) || "").replace(/\/$/, "");
        if (!apiBase) return;
        const res = await fetch(apiBase + "/get-balance", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Authorization": "Bearer " + jwt },
          body: JSON.stringify({}),
        });
        if (!res.ok) return;
        const data = await res.json();
        const bal = (data && typeof data.balance === "number") ? data.balance : null;
        if (bal !== null) { setCount(bal); persistBalance(bal); }
      } catch (_) {}
    }

    // 3. Prefer VxTokens when it loads (keeps cache warm across products)
    let tries = 0;
    function tryVxTokens() {
      // @ts-ignore global
      const VxTokens = (window as any).VxTokens;
      if (!VxTokens) {
        if (++tries > 40) { directFetch(); return; }
        setTimeout(tryVxTokens, 100);
        return;
      }
      const cached = VxTokens.getCachedBalance();
      if (cached !== null) setCount(cached);
      if (VxTokens.getBalance) {
        VxTokens.getBalance()
          .then((b: number) => { if (typeof b === "number") { setCount(b); persistBalance(b); } })
          .catch(() => { directFetch(); });
      } else {
        directFetch();
      }
    }
    tryVxTokens();

    window.addEventListener("vx:balance-changed", (e: any) => {
      if (e.detail && typeof e.detail.balance === "number") {
        setCount(e.detail.balance);
        const pill = document.getElementById("vxTokenPill");
        if (pill) {
          pill.style.borderColor = "rgba(45, 212, 191, 0.6)";
          setTimeout(() => { pill.style.borderColor = ""; }, 800);
        }
      }
    });
  })();
</script>
