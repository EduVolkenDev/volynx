---
import { ROUTES } from "../data/routes";

const navGroups = [
  {
    key: "volynx",
    href: ROUTES.platform,
    label: "VOLYNX",
    eyebrow: "Ecosystem",
    eyebrowPt: "Ecossistema",
    description: "Move between every VOLYNX layer from one command panel.",
    descriptionPt: "Navegue por todas as camadas VOLYNX em um único painel.",
    items: [
      { href: ROUTES.world, label: "World", detail: "People, opportunities and the ecosystem.", detailPt: "Pessoas, oportunidades e ecossistema.", icon: "/assets/V.webp" },
      { href: ROUTES.daily, label: "Daily OS", detail: "Daily command, Vault and intelligent routines.", detailPt: "Comando diário, Vault e rotinas inteligentes.", icon: "/assets/volynx-daily.webp" },
      { href: ROUTES.cvitae, label: "CVitae", detail: "Career assets, resumes and applications.", detailPt: "Carreira, currículos e candidaturas.", icon: "/assets/cvitae.webp" },
      { href: ROUTES.propertyflow, label: "PropertyFlow", detail: "Premium real-estate workflows.", detailPt: "Fluxos imobiliários premium.", icon: "/assets/propertyflow.webp" },
    ],
  },
  {
    key: "build",
    href: ROUTES.builder,
    label: "Build",
    labelPt: "Construir",
    eyebrow: "Create and ship",
    eyebrowPt: "Criar e publicar",
    description: "Build, publish and recover everything you own.",
    descriptionPt: "Crie, publique e recupere tudo que é seu.",
    items: [
      { href: ROUTES.builder, label: "Builder", detail: "Create and publish premium sites.", detailPt: "Crie e publique sites premium.", icon: "/assets/builder.webp" },
      { href: ROUTES.products, label: "Products", labelPt: "Produtos", detail: "Ready-to-use systems and premium kits.", detailPt: "Sistemas prontos e kits premium.", icon: "/assets/products.webp" },
      { href: ROUTES.devHub, label: "Dev Hub", detail: "Documentation, journeys and technical resources.", detailPt: "Documentação, jornadas e recursos técnicos.", icon: "/assets/devjourneyicon1.webp" },
      { href: ROUTES.delivery, label: "My products", labelPt: "Meus produtos", detail: "Recover purchases and delivered assets.", detailPt: "Recupere compras e arquivos entregues.", icon: "/assets/producticon.webp" },
    ],
  },
  {
    key: "lab",
    href: ROUTES.lab,
    label: "Lab",
    eyebrow: "Creative intelligence",
    eyebrowPt: "Inteligência criativa",
    description: "Open the Lab or jump directly into a production tool.",
    descriptionPt: "Abra o Lab ou entre direto em uma ferramenta.",
    items: [
      { href: ROUTES.labConverter, label: "Converter", detail: "Convert image formats locally.", detailPt: "Converta formatos de imagem localmente.", icon: "/assets/converterbig.webp" },
      { href: ROUTES.labImageScaler, label: "Image Scaler", detail: "Resize and upscale with precision.", detailPt: "Redimensione e amplie com precisão.", icon: "/assets/newimagescaler.webp" },
      { href: ROUTES.labImageSuite, label: "iMage Suite", detail: "Compress, clean and process images.", detailPt: "Comprima, limpe e processe imagens.", icon: "/assets/newimagesuite.webp" },
      { href: ROUTES.labLumina, label: "Lumina", detail: "AI-assisted knowledge and writing.", detailPt: "Conhecimento e escrita assistidos por IA.", icon: "/assets/education.webp" },
      { href: ROUTES.qrgen, label: "QRGen", detail: "Design production-ready QR projects.", detailPt: "Crie projetos QR prontos para produção.", icon: "/assets/newqrgen.webp" },
    ],
  },
  {
    key: "services",
    href: ROUTES.services,
    label: "Services",
    labelPt: "Serviços",
    eyebrow: "Expert support",
    eyebrowPt: "Suporte especializado",
    description: "Premium implementation, design and platform support.",
    descriptionPt: "Implementação, design e suporte premium.",
    items: [
      { href: ROUTES.services, label: "Services", labelPt: "Serviços", detail: "Strategy, design and product execution.", detailPt: "Estratégia, design e execução de produto.", icon: "/assets/support-gold.webp" },
      { href: ROUTES.designStudio, label: "Design Studio", detail: "Identity and premium visual systems.", detailPt: "Identidade e sistemas visuais premium.", icon: "/assets/producticon.webp" },
      { href: ROUTES.support, label: "Support", labelPt: "Suporte", detail: "Get help and resolve platform questions.", detailPt: "Resolva dúvidas e problemas da plataforma.", icon: "/assets/support.webp" },
      { href: ROUTES.pricing, label: "Plans", labelPt: "Planos", detail: "Compare access, capacity and upgrades.", detailPt: "Compare acesso, capacidade e upgrades.", icon: "/assets/producticon.webp" },
    ],
  },
];

interface Props {
  current?: string;
  brandHref?: string;
  ctaHref?: string;
  ctaLabel?: string;
  ctaI18n?: string;
}
const { current = "", brandHref = ROUTES.platform, ctaHref = ROUTES.pricing, ctaLabel = "Go Pro", ctaI18n = "nav.go_pro" } = Astro.props;
---
<header class="vx-topbar" id="vxTopbar">
  <div class="vx-topbar__inner">
    <!-- LOGO -->
    <a href={brandHref} class="vx-brand" aria-label="VOLYNX platform home" data-i18n-aria="aria.platform_home">
      <img src="/assets/V.webp" alt="" class="vx-brand__mark" width="44" height="44" aria-hidden="true" loading="eager" decoding="async" />
      <span class="vx-brand__text">
        <img src="/assets/wordmark-dark-trimmed.webp" alt="VOLYNX" class="vx-brand__wordmark" width="160" height="69" loading="eager" decoding="async" />
      </span>
    </a>

    <!-- DESKTOP NAV -->
    <nav class="vx-nav" aria-label="Primary" data-i18n-aria="aria.primary_nav">
      {navGroups.map((group) => (
        <div class:list={["vx-nav-group", { "is-active": current === group.href || group.items.some((item) => current === item.href) }]} data-vx-nav-group>
          <a href={group.href} class="vx-nav-trigger">
            <span><span class="i18n-en">{group.label}</span><span class="i18n-pt">{group.labelPt || group.label}</span></span>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <div class:list={["vx-mega", `vx-mega--${group.key}`]} data-vx-mega>
            <div class="vx-mega__intro">
              <span><span class="i18n-en">{group.eyebrow}</span><span class="i18n-pt">{group.eyebrowPt}</span></span>
              <strong><span class="i18n-en">{group.label}</span><span class="i18n-pt">{group.labelPt || group.label}</span></strong>
              <p><span class="i18n-en">{group.description}</span><span class="i18n-pt">{group.descriptionPt}</span></p>
              <a href={group.href} class="vx-mega__open">
                <span class="i18n-en">Open {group.label}</span>
                <span class="i18n-pt">Abrir {group.labelPt || group.label}</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
            <div class="vx-mega__grid">
              {group.items.map((item) => (
                <a href={item.href} class="vx-mega-item">
                  <span class="vx-mega-item__icon"><img src={item.icon} alt="" loading="lazy" decoding="async" /></span>
                  <span class="vx-mega-item__copy"><strong><span class="i18n-en">{item.label}</span><span class="i18n-pt">{item.labelPt || item.label}</span></strong><span><span class="i18n-en">{item.detail}</span><span class="i18n-pt">{item.detailPt}</span></span></span>
                  <span class="vx-mega-item__arrow" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </nav>

    <!-- RIGHT ACTIONS -->
    <div class="vx-actions">
      <!-- Token pill (authed only) -->
      <a href={ROUTES.account} class="vx-token-pill" id="vxTokenPill" aria-label="VX balance" data-i18n-aria="aria.vx_balance">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 7v10M8 10h8M8 14h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="vx-token-count" id="vxTokenCount">—</span>
        <span class="vx-token-label" data-i18n="widget.tokens">VX</span>
      </a>

      <!-- Get VX (authed only) -->
      <a href={ROUTES.recarregar} class="vx-recharge" data-i18n="widget.recharge">Get VX</a>

      <!-- Lang toggle -->
      <button
        id="vxLangToggle"
        class="vx-lang"
        data-vx-lang-toggle
        data-vx-lang-title
      >
        <span class="vx-sr-only">
          <span class="i18n-en">Language: </span>
          <span class="i18n-pt">Idioma: </span>
        </span>
        <span data-i18n="widget.lang" data-vx-lang-label>EN</span>
      </button>

      <!-- Signed-out: login + CTA -->
      <a href={ROUTES.login} class="vx-login" data-i18n="nav.login">Login</a>
      <a href={ctaHref} class="vx-cta" data-vx-hide-if-plan="pro" data-i18n={ctaI18n}>{ctaLabel}</a>

      <!-- Account switcher (authed only) — renders <img> via vx-avatar.js when avatar cached -->
      <div class="vx-account">
        <button type="button" class="vx-avatar" id="vxUserBadge" aria-label="Profile" aria-haspopup="menu" aria-expanded="false" data-i18n-aria="aria.profile" data-vx-avatar-slot>
          <svg class="vx-avatar__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span class="vx-avatar__initials" hidden></span>
        </button>
        <div class="vx-account-menu" id="vxAccountMenu" role="menu" aria-labelledby="vxUserBadge" hidden>
          <a href={ROUTES.profile} class="vx-account-menu__item" role="menuitem">
            <span class="vx-account-menu__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 21v-2.2a4.8 4.8 0 0 0-4.8-4.8H8.8A4.8 4.8 0 0 0 4 18.8V21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="7.5" r="4" stroke="currentColor" stroke-width="2"/></svg>
            </span>
            <span><span class="i18n-en">Profile</span><span class="i18n-pt">Perfil</span></span>
          </a>
          <a href={ROUTES.daily} class="vx-account-menu__item" role="menuitem">
            <span class="vx-account-menu__icon vx-account-menu__icon--daily" aria-hidden="true">
              <img src="/assets/volynx-daily.webp" alt="" loading="lazy" decoding="async" />
            </span>
            <span>Daily</span>
          </a>
          <button type="button" class="vx-account-menu__item vx-account-menu__item--danger" id="vxAccountSignout" role="menuitem">
            <span class="vx-account-menu__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M10 17l5-5-5-5M15 12H3M21 4v16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span><span class="i18n-en">Sign out</span><span class="i18n-pt">Sair</span></span>
          </button>
        </div>
      </div>

      <!-- Mobile menu btn -->
      <button class="vx-burger" id="mobileMenuBtn" type="button" aria-label="Open menu" data-i18n-aria="aria.open_menu" aria-expanded="false">
        <svg class="vx-burger__open"  width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="6"  x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg class="vx-burger__close" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- MOBILE MENU -->
  <nav class="vx-mobile" id="mobileNav" aria-label="Mobile" data-i18n-aria="aria.mobile_nav">
    {navGroups.map((group) => (
      <div class="vx-mobile-group" data-vx-mobile-group>
        <button type="button" class="vx-mobile-group__trigger" aria-expanded="false" data-vx-mobile-trigger>
          <span><span class="i18n-en">{group.label}</span><span class="i18n-pt">{group.labelPt || group.label}</span></span>
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="vx-mobile-group__panel" hidden>
          <a href={group.href} class="vx-mobile-group__open">
            <span class="i18n-en">Open {group.label}</span><span class="i18n-pt">Abrir {group.labelPt || group.label}</span><span aria-hidden="true">→</span>
          </a>
          {group.items.map((item) => (
            <a href={item.href} class="vx-mobile-group__item">
              <span class="vx-mobile-group__icon"><img src={item.icon} alt="" loading="lazy" decoding="async" /></span>
              <span><strong><span class="i18n-en">{item.label}</span><span class="i18n-pt">{item.labelPt || item.label}</span></strong><small><span class="i18n-en">{item.detail}</span><span class="i18n-pt">{item.detailPt}</span></small></span>
            </a>
          ))}
        </div>
      </div>
    ))}
    <hr class="vx-mobile__hr" />
    <button
      type="button"
      class="vx-mobile__link vx-mobile__lang"
      id="vxLangToggleMobile"
      data-vx-lang-toggle
      data-vx-lang-title
    >
      <span data-i18n="widget.lang_full">Language</span>
      <span class="vx-mobile__lang-tag" id="vxLangTagMobile" data-vx-lang-label>EN</span>
    </button>
    <a href={ROUTES.login} class="vx-mobile__link" data-auth="out" data-i18n="nav.login">Login</a>
    <a href={ctaHref} class="vx-mobile__cta" data-auth="out" data-i18n={ctaI18n}>{ctaLabel}</a>
    <a href={ROUTES.profile} class="vx-mobile__profile" data-auth="in" data-vx-avatar-slot>
      <span class="vx-mobile__avatar vx-avatar__initials" id="vxUserBadgeMobileInitials"></span>
      <span data-i18n="nav.profile">Profile</span>
    </a>
    <a href={ROUTES.daily} class="vx-mobile__profile" data-auth="in">
      <span class="vx-mobile__avatar vx-mobile__avatar--daily" aria-hidden="true"><img src="/assets/volynx-daily.webp" alt="" loading="lazy" decoding="async" /></span>
      <span>Daily</span>
    </a>
  </nav>
</header>

<style>
  .vx-sr-only {
    position: absolute !important;
    width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  :root {
    --topbar-h: 64px;
    --topbar-bg: rgba(9, 9, 11, 0.92);
    --topbar-border: rgba(39, 39, 42, 0.8);
    --topbar-text: #fafafa;
    --topbar-muted: #d4d4d8;
    --topbar-soft: #71717a;
    --topbar-accent: #2dd4bf;
  }

  /* ── SHELL ───────────────────────────────────────── */
  .vx-topbar {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--topbar-bg);
    backdrop-filter: blur(24px) saturate(1.4);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    border-bottom: 1px solid var(--topbar-border);
  }
  .vx-topbar__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 16px;
    min-height: var(--topbar-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 80px;
  }
  @media (min-width: 768px) {
    .vx-topbar__inner { padding: 0 32px; }
  }

  /* ── BRAND ───────────────────────────────────────── */
  .vx-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    flex-shrink: 0;
    min-width: 44px;
    min-height: 44px;
    transition: opacity .15s;
  }
  .vx-brand:hover { opacity: .9; }
  .vx-brand__mark {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    object-fit: contain;
    box-shadow: 0 10px 28px rgba(45, 212, 191, 0.35);
    transition: transform .2s;
  }
  .vx-brand:hover .vx-brand__mark { transform: scale(1.08); }
  .vx-brand__text {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }
  .vx-brand__wordmark {
    width: 160px;
    height: auto;
    max-height: 46px;
    object-fit: contain;
    object-position: left center;
    filter: drop-shadow(0 0 0 rgba(255,255,255,0));
    animation: vxBrandSheen 7s ease-in-out infinite;
    transition: filter .35s ease, transform .35s ease;
  }
  .vx-brand:hover .vx-brand__wordmark {
    animation-play-state: paused;
    filter: drop-shadow(0 0 14px rgba(255,255,255,0.18));
    transform: translateY(-1px);
  }
  @keyframes vxBrandSheen {
    0%, 100% { filter: drop-shadow(0 0 0 rgba(255,255,255,0)); }
    50%      { filter: drop-shadow(0 0 10px rgba(255,255,255,0.10)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .vx-brand__wordmark { animation: none; }
  }
  @media (max-width: 520px) {
    .vx-brand__text { display: none; }
  }

  /* ── DESKTOP NAV ─────────────────────────────────── */
  .vx-nav { display: none; }
  @media (min-width: 980px) {
    .vx-nav {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 650;
      align-self: stretch;
    }
    .vx-nav-group {
      position: relative;
      display: flex;
      align-items: center;
    }
    .vx-nav-trigger {
      min-height: 40px;
      display: inline-flex !important;
      align-items: center;
      gap: 5px;
      padding: 8px 11px;
      border: 1px solid transparent;
      border-radius: 8px;
      color: var(--topbar-muted);
      text-decoration: none;
      transition: color .2s ease, border-color .2s ease, background .2s ease, box-shadow .2s ease;
      white-space: nowrap;
    }
    .vx-nav-trigger svg { transition: transform .2s ease; }
    .vx-nav-group:hover .vx-nav-trigger,
    .vx-nav-group:focus-within .vx-nav-trigger,
    .vx-nav-group.is-active .vx-nav-trigger {
      color: #fff;
      border-color: rgba(45,212,191,.2);
      background: rgba(45,212,191,.06);
      box-shadow: 0 0 24px rgba(45,212,191,.08);
    }
    .vx-nav-group:hover .vx-nav-trigger svg,
    .vx-nav-group:focus-within .vx-nav-trigger svg { transform: rotate(180deg); }
    .vx-mega {
      position: absolute;
      top: calc(100% - 2px);
      left: 50%;
      width: min(680px, calc(100vw - 32px));
      display: grid;
      grid-template-columns: 190px minmax(0, 1fr);
      gap: 12px;
      padding: 12px;
      border: 1px solid rgba(125,249,255,.16);
      border-radius: 8px;
      background:
        linear-gradient(145deg, rgba(18,22,29,.98), rgba(6,8,12,.98)),
        #09090b;
      box-shadow: 0 28px 70px rgba(0,0,0,.58), 0 0 42px rgba(45,212,191,.08);
      backdrop-filter: blur(28px) saturate(1.25);
      -webkit-backdrop-filter: blur(28px) saturate(1.25);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translate(-50%, 8px);
      transition: opacity .18s ease, visibility .18s ease, transform .18s ease;
      z-index: 300;
    }
    .vx-nav-group:first-child .vx-mega { left: 0; transform: translate(0, 8px); }
    .vx-nav-group:last-child .vx-mega { left: auto; right: 0; transform: translate(0, 8px); }
    .vx-nav-group:hover .vx-mega,
    .vx-nav-group:focus-within .vx-mega,
    .vx-nav-group.is-open .vx-mega {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translate(-50%, 0);
    }
    .vx-nav-group:first-child:hover .vx-mega,
    .vx-nav-group:first-child:focus-within .vx-mega,
    .vx-nav-group:first-child.is-open .vx-mega,
    .vx-nav-group:last-child:hover .vx-mega,
    .vx-nav-group:last-child:focus-within .vx-mega,
    .vx-nav-group:last-child.is-open .vx-mega { transform: translate(0, 0); }
    .vx-mega__intro {
      min-width: 0;
      padding: 14px;
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 8px;
      background: rgba(255,255,255,.03);
    }
    .vx-mega__intro > span {
      display: block;
      margin-bottom: 9px;
      color: #7df9ff;
      font-size: 10px;
      font-weight: 900;
      text-transform: uppercase;
    }
    .vx-mega__intro strong { display: block; color: #fff; font-size: 19px; }
    .vx-mega__intro p {
      margin: 8px 0 16px;
      color: rgba(255,255,255,.5);
      font-size: 12px;
      font-weight: 550;
      line-height: 1.5;
    }
    .vx-mega__open {
      min-height: 36px;
      display: flex !important;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 8px 10px;
      border: 1px solid rgba(214,168,79,.25);
      border-radius: 8px;
      background: rgba(214,168,79,.08);
      color: #f5d78f;
      font-size: 11px;
      font-weight: 850;
      text-decoration: none;
    }
    .vx-mega__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
    }
    .vx-mega-item {
      min-width: 0;
      min-height: 70px;
      display: grid !important;
      grid-template-columns: 38px minmax(0, 1fr) auto;
      align-items: center;
      gap: 9px;
      padding: 9px;
      border: 1px solid transparent;
      border-radius: 8px;
      color: #fff;
      text-decoration: none;
      transition: background .18s ease, border-color .18s ease, box-shadow .18s ease;
    }
    .vx-mega-item:hover,
    .vx-mega-item:focus-visible {
      outline: none;
      border-color: rgba(125,249,255,.18);
      background: rgba(125,249,255,.055);
      box-shadow: inset 0 0 24px rgba(125,249,255,.025);
    }
    .vx-mega-item__icon {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 8px;
      background: rgba(255,255,255,.04);
