    .vx-mega-item__icon img { width: 32px; height: 32px; object-fit: contain; display: block; }
    .vx-mega-item__copy { display: grid; gap: 3px; min-width: 0; }
    .vx-mega-item__copy strong { color: rgba(255,255,255,.92); font-size: 12px; }
    .vx-mega-item__copy > span {
      overflow: hidden;
      color: rgba(255,255,255,.42);
      font-size: 10px;
      font-weight: 550;
