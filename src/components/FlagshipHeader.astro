  @keyframes vxPillFlash {
    0%   { box-shadow: 0 0 0 0 rgba(45, 212, 191, 0); }
    20%  { box-shadow: 0 0 0 6px rgba(45, 212, 191, 0.35); }
    100% { box-shadow: 0 0 0 0 rgba(45, 212, 191, 0); }
