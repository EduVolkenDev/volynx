</style>

<script>
  // Burger
  const btn = document.getElementById("mobileMenuBtn");
  const nav = document.getElementById("mobileNav");
  if (btn && nav) {
    btn.addEventListener("click", () => {
      const open = nav.classList.toggle("is-open");
      btn.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", String(open));
    });
  }

  // Mobile ecosystem groups: first tap expands, links inside navigate directly.
  document.querySelectorAll("[data-vx-mobile-group]").forEach((group) => {
    const trigger = group.querySelector("[data-vx-mobile-trigger]");
    const panel = group.querySelector(".vx-mobile-group__panel") as HTMLElement | null;
    trigger?.addEventListener("click", () => {
      const willOpen = !group.classList.contains("is-open");
      document.querySelectorAll("[data-vx-mobile-group].is-open").forEach((openGroup) => {
        if (openGroup === group) return;
        openGroup.classList.remove("is-open");
        openGroup.querySelector("[data-vx-mobile-trigger]")?.setAttribute("aria-expanded", "false");
        const openPanel = openGroup.querySelector(".vx-mobile-group__panel") as HTMLElement | null;
        if (openPanel) openPanel.hidden = true;
      });
      group.classList.toggle("is-open", willOpen);
      trigger.setAttribute("aria-expanded", String(willOpen));
      if (panel) panel.hidden = !willOpen;
    });
  });

  // Mobile lang toggle — toggle is handled globally by i18n.js.
  // We only close the menu here for a cleaner mobile flow.
  const langMobileBtn = document.getElementById("vxLangToggleMobile");
  langMobileBtn?.addEventListener("click", () => {
    nav?.classList.remove("is-open");
    btn?.classList.remove("is-open");
    btn?.setAttribute("aria-expanded", "false");
  });

  // Account switcher
  const accountToggle = document.getElementById("vxUserBadge");
  const accountMenu = document.getElementById("vxAccountMenu");
  const accountSignout = document.getElementById("vxAccountSignout");
  function closeAccountMenu() {
    if (!accountToggle || !accountMenu) return;
    accountMenu.hidden = true;
    accountToggle.setAttribute("aria-expanded", "false");
  }
  function openAccountMenu() {
    if (!accountToggle || !accountMenu) return;
    accountMenu.hidden = false;
    accountToggle.setAttribute("aria-expanded", "true");
  }
  accountToggle?.addEventListener("click", (event) => {
    event.preventDefault();
    event.stopPropagation();
    if (!accountMenu) return;
    if (accountMenu.hidden) openAccountMenu();
    else closeAccountMenu();
  });
  accountMenu?.addEventListener("click", (event) => {
    event.stopPropagation();
  });
  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (!accountToggle || !accountMenu || accountMenu.hidden) return;
    if (!accountToggle.contains(target) && !accountMenu.contains(target)) closeAccountMenu();
  });
  document.addEventListener("keydown", (event) => {
    if ((event.key === "Escape" || event.keyCode === 27) && accountMenu && !accountMenu.hidden) {
      closeAccountMenu();
      accountToggle?.focus();
    }
  });
  accountSignout?.addEventListener("click", (event) => {
    event.preventDefault();
    try {
      ["volynx_access_token", "volynx_refresh_token", "volynx_user_email", "volynx_session", "volynx_post_login_next"].forEach((key) => {
        localStorage.removeItem(key);
      });
      (window as any).VxAuthBridge?.clear?.();
      (window as any).VxPlan?.clearCache?.();
      (window as any).VxPlan?.clearAllUsage?.();
      (window as any).VxTokens?.clearCache?.();
    } catch (_) {}
    window.location.href = "/login/";
  });

  // Token pill — resilient: cache → VxTokens (polled) → direct fetch fallback
  (function wireTokenPill() {
    const countEl = document.getElementById("vxTokenCount");
    if (!countEl) return;
    function setCount(n: number | string | null | undefined) {
      if (n === null || n === undefined) { countEl.textContent = "—"; return; }
      const num = typeof n === "number" ? n : parseFloat(String(n));
      if (isNaN(num)) { countEl.textContent = "—"; return; }
      countEl.textContent = num.toLocaleString();
    }
    function persistBalance(n: number) {
      try {
        localStorage.setItem("volynx_token_balance", String(n));
        localStorage.setItem("volynx_token_balance_ts", String(Date.now()));
      } catch (_) {}
    }

    // 1. Show cached balance immediately from localStorage
    try {
      const rawCached = localStorage.getItem("volynx_token_balance");
      if (rawCached !== null) {
        const n = parseInt(rawCached, 10);
        if (!isNaN(n)) setCount(n);
      }
    } catch (_) {}

    // 2. Direct fetch — independent of VxTokens (used as fallback).
    //    Two tiers: edge function first, Supabase REST as last-resort.
    async function directFetch() {
      try {
        const jwt = localStorage.getItem("volynx_access_token");
        if (!jwt) return;
        const cfg = await fetch("/config.json", { cache: "no-store" }).then(r => r.json());
        const apiBase = ((cfg && (cfg.functionsUrl || cfg.apiBaseUrl)) || "").replace(/\/$/, "");

        // Tier A — edge function (audit trail, rate-limited, recommended path).
        if (apiBase) {
          try {
            const res = await fetch(apiBase + "/get-balance", {
              method: "POST",
              headers: { "Content-Type": "application/json", "Authorization": "Bearer " + jwt },
              body: JSON.stringify({}),
            });
            if (res.ok) {
              const data = await res.json();
              const bal = (data && typeof data.balance === "number") ? data.balance : null;
              if (bal !== null) { setCount(bal); persistBalance(bal); return; }
            }
          } catch (_) { /* fall through to REST */ }
        }

        // Tier B — Supabase REST direct read on profiles.token_balance.
        //   Column is `token_balance` (NOT `vx_balance` — VX is presentation-only;
        //   the DB always uses 'tokens'). Filter by auth.uid() so RLS returns
        //   exactly one row when the JWT is valid.
        const supaUrl = (cfg && (cfg.supabaseUrl || cfg.supabase_url) || "").replace(/\/$/, "");
        const anonKey = (cfg && (cfg.supabaseAnonKey || cfg.anonKey)) || "";
        if (!supaUrl || !anonKey) return;

        // Decode user_id from the JWT sub claim — same trick the dashboard pages use.
        let uid = null;
        try {
          const part = jwt.split(".")[1];
          if (part) {
            const norm = part.replace(/-/g, "+").replace(/_/g, "/");
            const payload = JSON.parse(atob(norm.padEnd(norm.length + (4 - norm.length % 4) % 4, "=")));
            uid = payload && payload.sub ? payload.sub : null;
          }
        } catch (_) {}
        if (!uid) return;

        const restRes = await fetch(
          supaUrl + "/rest/v1/profiles?select=token_balance&id=eq." + encodeURIComponent(uid),
          {
            headers: {
              apikey: anonKey,
              Authorization: "Bearer " + jwt,
              "Accept": "application/json",
            },
          }
        );
        if (!restRes.ok) return;
        const rows = await restRes.json();
        const row = Array.isArray(rows) && rows.length > 0 ? rows[0] : null;
        const bal = row && typeof row.token_balance === "number" ? row.token_balance : null;
        if (bal !== null) { setCount(bal); persistBalance(bal); }
      } catch (_) {}
    }

    // 3. Prefer VxTokens when it loads (keeps cache warm across products)
    let tries = 0;
    function tryVxTokens() {
      // @ts-ignore global
      const VxTokens = (window as any).VxTokens;
      if (!VxTokens) {
        if (++tries > 40) { directFetch(); return; }
        setTimeout(tryVxTokens, 100);
        return;
      }
      const cached = VxTokens.getCachedBalance();
      if (cached !== null) setCount(cached);
      if (VxTokens.getBalance) {
        VxTokens.getBalance()
          .then((b: number) => { if (typeof b === "number") { setCount(b); persistBalance(b); } })
          .catch(() => { directFetch(); });
      } else {
        directFetch();
      }
    }
    tryVxTokens();

    function applyBalanceCues(n: number) {
      const pill = document.getElementById("vxTokenPill");
      if (!pill) return;
      // Low balance: <10 VX → amber pulsing icon. Skip for admin (∞).
      if (!(window as any).VX_IS_ADMIN && n < 10) pill.classList.add("vx-pill-low");
      else pill.classList.remove("vx-pill-low");
      // One-shot flash — restart animation cleanly.
      pill.classList.remove("vx-pill-flash");
      // Force reflow so re-adding the class re-triggers the keyframes.
      void pill.offsetWidth;
      pill.classList.add("vx-pill-flash");
      window.setTimeout(() => pill.classList.remove("vx-pill-flash"), 950);
    }

    window.addEventListener("vx:balance-changed", (e: any) => {
      if (e.detail && typeof e.detail.balance === "number") {
        setCount(e.detail.balance);
        applyBalanceCues(e.detail.balance);
      }
    });
  })();
</script>
