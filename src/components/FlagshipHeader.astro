---
import { ROUTES } from "../data/routes";

const nav = [
  { href: ROUTES.home, label: "Home", i18n: "nav.home" },
  { href: ROUTES.builder, label: "Builder", i18n: "nav.builder" },
  { href: ROUTES.products, label: "Products", i18n: "nav.products" },
  { href: ROUTES.services, label: "Services", i18n: "nav.services" },
  { href: ROUTES.lab, label: "Lab", i18n: "nav.lab" },
  { href: "https://daily.volynx.world", label: "Daily", i18n: "nav.daily" },
  { href: ROUTES.pricing, label: "Pricing", i18n: "nav.pricing" },
  { href: ROUTES.devHub, label: "Dev Hub", i18n: "nav.devhub" },
];

interface Props {
  current?: string;
  ctaHref?: string;
  ctaLabel?: string;
  ctaI18n?: string;
}
const { current = "", ctaHref = ROUTES.pricing, ctaLabel = "Go Pro", ctaI18n = "nav.go_pro" } = Astro.props;
---
<header class="site-header">
  <div class="shell header-shell">
    <a href={ROUTES.home} class="brandmark" aria-label="VOLYNX home">
      <img src="/assets/volynx-icon.webp" alt="VOLYNX" class="brandmark__icon" width="44" height="44" loading="eager" />
      <img src="/assets/wordmark.webp" alt="VOLYNX" class="brandmark__wordmark" width="122" height="24" loading="eager" />
    </a>

    <nav class="main-nav" aria-label="Primary navigation">
      {nav.map((item) => (
        <a href={item.href} class:list={{ active: current === item.href }} data-i18n={item.i18n}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <!-- Token balance pill — only visible when authed -->
      <a href={ROUTES.account} class="vx-token-pill" id="vxTokenPill" aria-label="Token balance" title="View your tokens">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 7v10M8 10h8M8 14h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="vx-token-count" id="vxTokenCount">—</span>
        <span class="vx-token-label" data-i18n="widget.tokens">tokens</span>
      </a>

      <!-- Recharge CTA — only visible when authed -->
      <a href={ROUTES.recarregar} class="vx-recharge-btn" data-i18n="widget.recharge">Recarregar</a>

      <button id="vxLangToggle" class="vx-widget vx-lang-btn" aria-label="Toggle language" title="Switch language / Mudar idioma">
        <span class="vx-lang-label" data-i18n="widget.lang">EN</span>
      </button>
      <a href={ROUTES.login} class="header-link vx-login-link" data-i18n="nav.login">Login</a>
      <a href={ROUTES.profile} class="vx-user-badge" id="vxUserBadge" aria-label="Profile"></a>
      <a href={ctaHref} class="button button--gold" data-vx-hide-if-plan="pro" data-i18n={ctaI18n}>{ctaLabel}</a>
      <button class="mobile-menu-btn" id="mobileMenuBtn" type="button" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobile navigation -->
  <nav class="mobile-nav" id="mobileNav" aria-label="Mobile navigation">
    {nav.map((item) => (
      <a href={item.href} class:list={{ active: current === item.href }} data-i18n={item.i18n}>{item.label}</a>
    ))}
    <a href={ROUTES.login} class="button button--ghost" data-i18n="nav.login">Login</a>
    <a href={ctaHref} class="button button--gold" data-vx-hide-if-plan="pro">{ctaLabel}</a>
    <a href={ROUTES.profile} class="mobile-profile-link" id="vxUserBadgeMobile" aria-label="Profile">
      <span class="mobile-profile-avatar" id="vxUserBadgeMobileInitials"></span>
      <span class="mobile-profile-label" data-i18n="nav.profile">Profile</span>
    </a>
  </nav>
</header>

<style>
  /* Token pill + recharge: hidden by default, shown when authed */
  .vx-token-pill, .vx-recharge-btn { display: none; }
  :global(.vx-authed) .vx-token-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(139,250,240,.2);
    color: rgba(242,244,248,.9);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: all .15s;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  :global(.vx-authed) .vx-token-pill:hover {
    background: rgba(139,250,240,.08);
    border-color: rgba(139,250,240,.4);
  }
  .vx-token-pill svg { color: #8bfaf0; flex-shrink: 0; }
  .vx-token-pill .vx-token-count { color: #fff; font-size: 13px; }
  .vx-token-pill .vx-token-label { color: rgba(242,244,248,.45); font-size: 10px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }

  :global(.vx-authed) .vx-recharge-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 18px;
    border-radius: 999px;
    background: #fff;
    color: #0c0e16;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .01em;
    text-decoration: none;
    transition: all .15s;
    box-shadow: 0 4px 16px rgba(255,255,255,.12);
    white-space: nowrap;
  }
  :global(.vx-authed) .vx-recharge-btn:hover {
    background: #f0f4f8;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(255,255,255,.2);
  }
  :global(.vx-authed) .vx-recharge-btn:active {
    transform: translateY(0) scale(.97);
  }

  /* Responsive progressive disclosure */
  @media (max-width: 767px) {
    .vx-token-pill .vx-token-label { display: none; }
    .vx-token-pill { padding: 6px 10px; font-size: 11px; }
    .vx-recharge-btn { padding: 7px 14px; font-size: 11px; }
  }
  @media (max-width: 520px) {
    :global(.vx-authed) .vx-token-pill { display: none !important; }
  }
  @media (max-width: 380px) {
    :global(.vx-authed) .vx-recharge-btn { padding: 6px 12px; font-size: 10.5px; }
  }

  /* Auth flash prevention — hide login, show badge instantly when authed */
  .vx-user-badge { display: none; }
  :global(.vx-authed) .vx-login-link { display: none !important; }
  :global(.vx-authed) .vx-user-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(139,250,240,.08);
    border: 1px solid rgba(139,250,240,.2);
    color: rgba(139,250,240,.9);
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: .03em;
    white-space: nowrap;
  }
  :global(.vx-authed) .vx-user-badge:hover {
    background: rgba(139,250,240,.14);
    border-color: rgba(139,250,240,.35);
  }

  /* Mobile nav: hide Login + Go Pro when authenticated */
  :global(.vx-authed) .mobile-nav .button--ghost { display: none !important; }
  :global(.vx-authed) .mobile-nav .button--gold { display: none !important; }

  /* Mobile profile link: hidden by default, shown when authed */
  .mobile-profile-link { display: none; }
  :global(.vx-authed) .mobile-profile-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    margin-top: 8px;
    border-radius: 12px;
    background: rgba(139,250,240,.08);
    border: 1px solid rgba(139,250,240,.2);
    color: rgba(242,244,248,.95);
    text-decoration: none;
    font-weight: 700;
    transition: all .15s;
  }
  :global(.vx-authed) .mobile-profile-link:hover {
    background: rgba(139,250,240,.14);
    border-color: rgba(139,250,240,.4);
  }
  .mobile-profile-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: rgba(139,250,240,.18);
    border: 1px solid rgba(139,250,240,.35);
    color: rgba(139,250,240,1);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .03em;
    flex-shrink: 0;
  }
  .mobile-profile-label {
    flex: 1;
    font-size: 14px;
  }

  .vx-lang-btn {
    position: relative;
    top: unset; right: unset;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .09em;
    line-height: 1;
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 999px;
    color: rgba(255,255,255,.82);
    cursor: pointer;
    user-select: none;
    transition: background 160ms, border-color 160ms, color 160ms;
  }
  .vx-lang-btn:hover {
    background: rgba(130,220,255,.13);
    border-color: rgba(130,220,255,.36);
    color: #fff;
  }

  /* Tablet and smaller: compact header */
  @media (max-width: 640px) {
    .header-actions .button--gold { display: none; }
    .header-actions { gap: 6px; }
    .brandmark__wordmark { width: 90px; }
  }
  /* Narrow phones: hide wordmark entirely */
  @media (max-width: 380px) {
    .brandmark__wordmark { display: none; }
    .vx-lang-btn { min-width: 36px; padding: 5px 8px; font-size: 10px; }
  }
</style>

<script>
  const btn = document.getElementById("mobileMenuBtn");
  const nav = document.getElementById("mobileNav");
  if (btn && nav) {
    btn.addEventListener("click", () => {
      const open = nav.classList.toggle("is-open");
      btn.setAttribute("aria-expanded", String(open));
    });
  }

  // Wire up token balance pill (uses VxTokens)
  (function wireTokenPill() {
    const countEl = document.getElementById("vxTokenCount");
    if (!countEl) return;

    function setCount(n: number | string | null | undefined) {
      if (n === null || n === undefined) { countEl.textContent = "—"; return; }
      const num = typeof n === "number" ? n : parseFloat(String(n));
      if (isNaN(num)) { countEl.textContent = "—"; return; }
      countEl.textContent = num.toLocaleString();
    }

    // @ts-ignore — VxTokens is a global loaded via /js/vx-tokens.js
    const VxTokens = (window as any).VxTokens;
    if (VxTokens) {
      const cached = VxTokens.getCachedBalance();
      if (cached !== null) setCount(cached);
      VxTokens.getBalance?.().then((b: number) => setCount(b)).catch(() => {});
    }

    // Listen for realtime / local balance changes
    window.addEventListener("vx:balance-changed", (e: any) => {
      if (e.detail && typeof e.detail.balance === "number") {
        setCount(e.detail.balance);
        // Flash animation on change
        const pill = document.getElementById("vxTokenPill");
        if (pill) {
          pill.style.borderColor = "rgba(139,250,240,.6)";
          setTimeout(() => { pill.style.borderColor = ""; }, 800);
        }
      }
    });
  })();
</script>
