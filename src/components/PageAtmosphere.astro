function hashRoute(value: string) {
  let hash = 2166136261;
  for (let index = 0; index < value.length; index += 1) {
    hash ^= value.charCodeAt(index);
    hash = Math.imul(hash, 16777619);
  }
  return hash >>> 0;
}

const seed = hashRoute(normalizedPath);
const preset = curated[normalizedPath] || {};
const hue = preset.hue ?? seed % 360;
const accentHue = preset.accentHue ?? (hue + 78 + (seed % 64)) % 360;
const x = 12 + (seed % 77);
const y = 10 + ((seed >>> 8) % 58);
const x2 = 12 + ((seed >>> 15) % 77);
const y2 = 18 + ((seed >>> 22) % 58);
const imageOpacity = preset.imageOpacity ?? 0;
const imageScale = preset.imageScale ?? 1;
const imageSize = preset.imageSize ?? "cover";
const atmosphereKey = normalizedPath === "/"
  ? "home"
  : normalizedPath.replace(/^\//, "").replace(/\/$/, "").replace(/[^a-z0-9]+/gi, "-") || "page";
const atmosphereStyle = [
  `--vx-atm-image:${preset.image ? `url(\"${preset.image}\")` : "none"}`,
  `--vx-atm-position:${preset.position || "center"}`,
  `--vx-atm-size:${imageSize}`,
  `--vx-atm-image-opacity:${imageOpacity}`,
  `--vx-atm-image-scale:${imageScale}`,
  `--vx-atm-hue:${hue}`,
  `--vx-atm-accent-hue:${accentHue}`,
  `--vx-atm-x:${x}%`,
  `--vx-atm-y:${y}%`,
  `--vx-atm-x2:${x2}%`,
  `--vx-atm-y2:${y2}%`,
].join(";");
