<section id="passwordResetState" hidden aria-labelledby="resetTitle">
  <h1 id="resetTitle" data-reset-en="Choose a new password" data-reset-pt="Escolha uma nova senha">Choose a new password</h1>
  <p id="resetStatus" role="status" aria-live="polite"></p>
  <form id="passwordResetForm" hidden>
    <label for="newPassword" data-reset-en="New password" data-reset-pt="Nova senha">New password</label>
    <input class="input" id="newPassword" type="password" autocomplete="new-password" minlength="8" required aria-describedby="resetPasswordHint" />
    <p id="resetPasswordHint" data-reset-en="Use at least 8 characters." data-reset-pt="Use pelo menos 8 caracteres.">Use at least 8 characters.</p>
    <label for="confirmPassword" data-reset-en="Confirm password" data-reset-pt="Confirme a senha">Confirm password</label>
    <input class="input" id="confirmPassword" type="password" autocomplete="new-password" minlength="8" required />
    <button class="btn btn-primary primary" id="savePasswordBtn" type="submit" data-reset-en="Save new password" data-reset-pt="Salvar nova senha">Save new password</button>
  </form>
  <button class="btn btn-secondary" type="button" id="resetRetry" hidden data-reset-en="Request a new link" data-reset-pt="Pedir um novo link">Request a new link</button>
  <a class="btn btn-primary primary" id="resetContinue" hidden href="/" data-reset-en="Continue to your task" data-reset-pt="Voltar à sua tarefa">Continue to your task</a>
</section>

<style>
  #passwordResetState[hidden], #passwordResetState [hidden] { display: none !important; }
  #passwordResetState { display: grid; gap: 16px; }
  #passwordResetState h1 { font-size: clamp(24px, 4vw, 32px); line-height: 1.15; margin: 0; }
  #passwordResetState p { margin: 0; line-height: 1.6; color: var(--muted, #b4b4bd); }
  #passwordResetForm { display: grid; gap: 12px; }
  #passwordResetForm input { box-sizing: border-box; width: 100%; min-width: 0; padding: 14px; border-radius: 12px; background: rgba(255,255,255,.05); color: inherit; border: 1px solid rgba(255,255,255,.2); font: inherit; }
  #passwordResetForm input:focus-visible { outline: 2px solid #2dd4bf; outline-offset: 3px; }
  #passwordResetForm button, #passwordResetState a, #resetRetry { width: 100%; box-sizing: border-box; min-height: 44px; text-align: center; justify-content: center; }
  #resetStatus[data-error="true"] { color: #fda4af; }
  #savePasswordBtn, #resetContinue { background: #2dd4bf; color: #042f2e; border: 1px solid #2dd4bf; font-weight: 700; border-radius: 12px; padding: 12px 16px; text-decoration: none; cursor: pointer; }
  #savePasswordBtn:hover, #resetContinue:hover { background: #5eead4; }
  #savePasswordBtn:focus-visible, #resetContinue:focus-visible, #resetRetry:focus-visible { outline: 2px solid #99f6e4; outline-offset: 3px; }
  #savePasswordBtn:disabled { opacity: .6; cursor: wait; }
</style>
