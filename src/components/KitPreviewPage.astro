---
import FlagshipLayout from "../layouts/FlagshipLayout.astro";
import FlagshipHeader from "./FlagshipHeader.astro";
import FlagshipFooter from "./FlagshipFooter.astro";
import { ROUTES } from "../data/routes";
import type { KitPreview } from "../data/kit-previews";

interface Props {
  preview: KitPreview;
}

const { preview } = Astro.props;
---

<FlagshipLayout
  title={`${preview.name} Preview — VOLYNX`}
  description={preview.summary.en}
  ogImage={preview.art}
  pageClass={`page-kit-preview page-kit-preview--${preview.id}`}
>
  <FlagshipHeader current={ROUTES.products} ctaLabel="Open product page" ctaHref={preview.productRoute} />
  <main>
    <section class="hero kit-preview-hero">
      <div class="shell kit-preview-hero__grid">
        <div class="hero-copy">
          <span class="kicker"><span class="i18n-en">{preview.kicker.en}</span><span class="i18n-pt">{preview.kicker.pt}</span></span>
          <h1><span class="i18n-en">{preview.title.en}</span><span class="i18n-pt">{preview.title.pt}</span></h1>
          <p><span class="i18n-en">{preview.summary.en}</span><span class="i18n-pt">{preview.summary.pt}</span></p>
          <div class="hero-actions">
            <a href={preview.productRoute} class="button button--gold"><span class="i18n-en">Buy {preview.name}</span><span class="i18n-pt">Comprar {preview.name}</span></a>
            <a href={ROUTES.pricing} class="button button--ghost"><span class="i18n-en">See pricing</span><span class="i18n-pt">Ver preços</span></a>
          </div>
        </div>
        <div class="kit-preview-hero__art panel" aria-hidden="true">
          <img src={preview.art} alt="" loading="eager" decoding="async" />
        </div>
      </div>
    </section>

    <section class="page-section page-section--tight">
      <div class="shell kit-preview-metrics">
        {preview.metrics.map((metric) => (
          <article class="panel kit-preview-metric">
            <strong>{metric.value}</strong>
            <span><span class="i18n-en">{metric.label.en}</span><span class="i18n-pt">{metric.label.pt}</span></span>
          </article>
        ))}
      </div>
    </section>

    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">Why it works</span><span class="i18n-pt">Por que funciona</span></span>
        <h2><span class="i18n-en">{preview.name} ships with the parts that actually move the buyer.</span><span class="i18n-pt">{preview.name} já vem com as partes que de fato movem o comprador.</span></h2>
      </div>
      <div class="shell kit-preview-grid">
        {preview.proofCards.map((card) => (
          <article class="panel kit-preview-card">
            <h3><span class="i18n-en">{card.title.en}</span><span class="i18n-pt">{card.title.pt}</span></h3>
            <p><span class="i18n-en">{card.copy.en}</span><span class="i18n-pt">{card.copy.pt}</span></p>
          </article>
        ))}
      </div>
    </section>

    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">What you get</span><span class="i18n-pt">O que você recebe</span></span>
        <h2><span class="i18n-en">Exact deliverables — no surprises after checkout.</span><span class="i18n-pt">Entregas exatas — sem surpresa depois do checkout.</span></h2>
      </div>
      <div class="shell kit-preview-unlock">
        <article class="panel kit-preview-stack">
          <span class="label"><span class="i18n-en">Inside the kit</span><span class="i18n-pt">Dentro do kit</span></span>
          <ul>
            {preview.whatYouGet.map((item) => (
              <li><span class="i18n-en">{item.en}</span><span class="i18n-pt">{item.pt}</span></li>
            ))}
          </ul>
        </article>
        <article class="panel kit-preview-stack">
          <span class="label label--pro"><span class="i18n-en">Who it's for</span><span class="i18n-pt">Pra quem é</span></span>
          <ul>
            {preview.whoItsFor.map((item) => (
              <li><span class="i18n-en">{item.en}</span><span class="i18n-pt">{item.pt}</span></li>
            ))}
          </ul>
        </article>
      </div>
    </section>

    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">How it works</span><span class="i18n-pt">Como funciona</span></span>
        <h2><span class="i18n-en">From checkout to a published site in three steps.</span><span class="i18n-pt">Do checkout ao site no ar em três passos.</span></h2>
      </div>
      <div class="shell kit-preview-steps">
        {preview.steps.map((step, index) => (
          <article class="panel kit-preview-step">
            <span class="kit-preview-step__index">0{index + 1}</span>
            <h3><span class="i18n-en">{step.title.en}</span><span class="i18n-pt">{step.title.pt}</span></h3>
            <p><span class="i18n-en">{step.copy.en}</span><span class="i18n-pt">{step.copy.pt}</span></p>
          </article>
        ))}
      </div>
    </section>

    <section class="page-section">
      <div class="shell section-head">
        <span class="eyebrow"><span class="i18n-en">FAQ</span><span class="i18n-pt">Perguntas frequentes</span></span>
        <h2><span class="i18n-en">What buyers ask before checkout.</span><span class="i18n-pt">O que compradores perguntam antes de fechar.</span></h2>
      </div>
      <div class="shell kit-preview-faq">
        {preview.faq.map((item) => (
          <details class="panel kit-preview-faq__item">
            <summary><span class="i18n-en">{item.question.en}</span><span class="i18n-pt">{item.question.pt}</span></summary>
            <p><span class="i18n-en">{item.answer.en}</span><span class="i18n-pt">{item.answer.pt}</span></p>
          </details>
        ))}
      </div>
    </section>

    <section class="page-section page-section--last">
      <div class="shell callout panel panel--pro kit-preview-cta">
        <div>
          <span class="eyebrow"><span class="i18n-en">Ready to ship?</span><span class="i18n-pt">Pronto pra publicar?</span></span>
          <strong><span class="i18n-en">{preview.name} — auto-loaded into Builder the moment you buy.</span><span class="i18n-pt">{preview.name} — carregado no Builder no momento da compra.</span></strong>
          <p><span class="i18n-en">No setup, no zip extracting. Edit content, hit publish, your site is live.</span><span class="i18n-pt">Sem setup, sem extrair zip. Edite o conteúdo, clique em publicar e seu site fica no ar.</span></p>
        </div>
        <div class="hero-actions">
          <a href={preview.productRoute} class="button button--gold"><span class="i18n-en">Buy {preview.name}</span><span class="i18n-pt">Comprar {preview.name}</span></a>
          <a href={ROUTES.pricing} class="button button--ghost"><span class="i18n-en">Compare tiers</span><span class="i18n-pt">Comparar tiers</span></a>
        </div>
      </div>
    </section>
  </main>
  <FlagshipFooter />
</FlagshipLayout>

<style is:global>
  .page-kit-preview .kit-preview-hero__grid {
    display: grid;
    gap: 24px;
    align-items: center;
  }
  .page-kit-preview .kit-preview-hero__art {
    padding: 18px;
    min-height: 320px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .page-kit-preview .kit-preview-hero__art img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 20px;
  }
  .page-kit-preview .kit-preview-metrics,
  .page-kit-preview .kit-preview-grid,
  .page-kit-preview .kit-preview-steps,
  .page-kit-preview .kit-preview-faq {
    display: grid;
    gap: 14px;
  }
  .page-kit-preview .kit-preview-metrics {
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }
  .page-kit-preview .kit-preview-metric {
    padding: 18px;
    display: grid;
    gap: 6px;
    text-align: center;
  }
  .page-kit-preview .kit-preview-metric strong {
    font-size: 1.9rem;
    color: #fff;
    letter-spacing: -0.05em;
  }
  .page-kit-preview .kit-preview-metric span {
    color: var(--muted);
    font-size: .94rem;
  }
  .page-kit-preview .kit-preview-grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .page-kit-preview .kit-preview-card,
  .page-kit-preview .kit-preview-step {
    padding: 22px;
    min-height: 220px;
  }
  .page-kit-preview .kit-preview-card h3,
  .page-kit-preview .kit-preview-step h3 {
    margin: 0 0 12px;
    font-size: 1.1rem;
    color: #fff;
  }
  .page-kit-preview .kit-preview-card p,
  .page-kit-preview .kit-preview-step p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }
  .page-kit-preview .kit-preview-unlock {
    display: grid;
    gap: 14px;
  }
  .page-kit-preview .kit-preview-stack {
    padding: 22px;
  }
  .page-kit-preview .kit-preview-stack ul {
    margin: 16px 0 0;
    padding-left: 18px;
    color: var(--muted);
    display: grid;
    gap: 10px;
    line-height: 1.7;
  }
  .page-kit-preview .kit-preview-step__index {
    display: inline-flex;
    margin-bottom: 16px;
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .18em;
    color: rgba(255,255,255,.45);
  }
  .page-kit-preview .kit-preview-faq__item {
    padding: 18px 20px;
  }
  .page-kit-preview .kit-preview-faq__item summary {
    cursor: pointer;
    font-weight: 600;
    color: #fff;
    list-style: none;
  }
  .page-kit-preview .kit-preview-faq__item summary::-webkit-details-marker {
    display: none;
  }
  .page-kit-preview .kit-preview-faq__item p {
    margin: 14px 0 0;
    color: var(--muted);
    line-height: 1.7;
  }
  .page-kit-preview .kit-preview-cta {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 900px) {
    .page-kit-preview .kit-preview-hero__grid,
    .page-kit-preview .kit-preview-unlock,
    .page-kit-preview .kit-preview-cta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .page-kit-preview .kit-preview-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .page-kit-preview .kit-preview-faq {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
