---
// CookieBanner — universal consent banner for all Volynx pages
// Uses localStorage key "volynx_consent_v1"
// Fires window CustomEvent "volynx:consent" on save
import { ROUTES } from "../data/routes";
---

<!-- Cookie Banner — JS controls visibility via vx-cookie--show class -->
<div class="vx-cookie" id="vxCookie" role="region" aria-label="Cookie preferences">
  <div class="vx-cookie__card">
    <div class="vx-cookie__glow" aria-hidden="true"></div>
    <div class="vx-cookie__head">
      <div class="vx-cookie__badge" aria-hidden="true">VOLYNX</div>
      <div class="vx-cookie__title" data-i18n="cookie.title">Cookies &amp; Privacy</div>
    </div>
    <p class="vx-cookie__text" data-i18n="cookie.msg">
      We use essential cookies to keep VOLYNX working. Analytics are optional and stay in your control.
    </p>
    <div class="vx-cookie__actions">
      <button class="vx-cbtn vx-cbtn--ghost" id="vxCookiePrefs" type="button" data-i18n="cookie.prefs_btn">Preferences</button>
      <button class="vx-cbtn vx-cbtn--soft"  id="vxCookieReject" type="button" data-i18n="cookie.reject_btn">Reject</button>
      <button class="vx-cbtn vx-cbtn--primary" id="vxCookieAccept" type="button" data-i18n="cookie.accept_btn">Accept all</button>
    </div>
    <a class="vx-cookie__link" href={ROUTES.privacy} rel="noopener" data-i18n="cookie.privacy_link">Privacy policy</a>
    <div class="vx-cookie__prefs" id="vxCookiePanel" style="display:none">
      <div class="vx-cookie__prefsTitle" data-i18n="cookie.prefs_title">Preferences</div>
      <label class="vx-toggle">
        <input type="checkbox" checked disabled />
        <span class="vx-toggle__ui"></span>
        <span class="vx-toggle__label"><span data-i18n="cookie.essential">Essential</span> <small data-i18n="cookie.essential_sub">Always on</small></span>
      </label>
      <label class="vx-toggle">
        <input type="checkbox" id="vxConsentAnalytics" />
        <span class="vx-toggle__ui"></span>
        <span class="vx-toggle__label"><span data-i18n="cookie.analytics">Analytics</span> <small data-i18n="cookie.analytics_sub">Helps improve the experience</small></span>
      </label>
      <div class="vx-cookie__prefsActions">
        <button class="vx-cbtn vx-cbtn--soft" id="vxCookieSave" type="button" data-i18n="cookie.save_btn">Save</button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Hidden by default — JS adds .vx-cookie--show to reveal */
  .vx-cookie {
    position: fixed;
    inset: auto 16px 16px 16px;
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    pointer-events: none;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  .vx-cookie.vx-cookie--show {
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0);
  }

  .vx-cookie__card {
    position: relative;
    width: min(560px, 100%);
    box-sizing: border-box;
    max-height: min(440px, calc(100svh - 96px));
    border-radius: 8px;
    background: rgba(8, 49, 128, 0.95);
    border: 1px solid rgba(160, 130, 255, 0.2);
    box-shadow: 0 0 30px white, 0 24px 64px rgba(0, 0, 0, 0.72), 0 0 0 1px rgba(255, 255, 255, 0.05) inset;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    overflow: hidden auto;
    overscroll-behavior: contain;
  }

  .vx-cookie__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 20%, rgba(4, 229, 255, 0.18), transparent 45%),
      radial-gradient(circle at 80% 70%, rgba(167, 139, 250, 0.18), transparent 45%);
    filter: blur(10px);
    pointer-events: none;
  }

  .vx-cookie__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 14px 0;
    position: relative;
  }
  .vx-cookie__badge {
    font-weight: 800;
    letter-spacing: 0.16em;
    font-size: 11px;
    padding: 8px 10px;
    border-radius: 999px;
    border: 1px solid rgba(160, 252, 252, 0.22);
    background: rgba(4, 6, 13, 0.45);
    color: rgba(200, 245, 255, 0.92);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .vx-cookie__title {
    font-weight: 800;
    color: #fff;
    letter-spacing: 0;
  }
  .vx-cookie__text {
    padding: 10px 14px 0;
    margin: 0;
    color: rgba(230, 232, 255, 0.86);
    line-height: 1.5;
    font-size: 14px;
    position: relative;
    overflow-wrap: anywhere;
  }
  .vx-cookie__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 12px 14px 14px;
    position: relative;
  }

  /* Buttons — prefixed vx-cbtn to avoid collision */
  .vx-cbtn {
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
    font-size: 11px;
    padding: 10px 14px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(10, 8, 24, 0.60);
    color: #fff;
    cursor: pointer;
    font-family: inherit;
    min-height: 44px;
    min-width: 44px;
  }
  .vx-cbtn--primary {
    background: radial-gradient(
      9% 100% at 50% 50%,
      rgba(245, 231, 145, 0.55) 20%,
      rgba(210, 202, 54, 0.35) 120%,
      rgba(223, 221, 121, 0.65) 250%,
      rgba(201, 196, 111, 0.40) 392%
    );
    border: 1px solid rgba(255, 255, 255, 0.34);
  }
  .vx-cbtn--soft {
    border: 1px solid rgba(160, 252, 252, 0.22);
    box-shadow: 0 0 18px rgba(4, 229, 255, 0.12);
  }
  .vx-cbtn--ghost { background: transparent; }

  .vx-cookie__link {
    display: inline-block;
    padding: 0 14px 14px;
    min-height: 44px;
    font-size: 12px;
    color: rgba(200, 245, 255, 0.85);
    text-decoration: underline;
    position: relative;
  }
  .vx-cookie__prefs {
    padding: 0 14px 14px;
    position: relative;
  }
  .vx-cookie__prefsTitle {
    font-weight: 800;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.92);
    margin: 8px 0;
  }

  .vx-toggle {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    user-select: none;
    color: rgba(230, 232, 255, 0.88);
    font-size: 13px;
    cursor: pointer;
  }
  .vx-toggle input { position: absolute; opacity: 0; pointer-events: none; }
  .vx-toggle__ui {
    flex-shrink: 0;
    width: 38px;
    height: 22px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(10, 8, 24, 0.50);
    position: relative;
    transition: background 0.15s, border-color 0.15s;
  }
  .vx-toggle__ui::after {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.55);
    transition: left 0.15s, background 0.15s;
  }
  .vx-toggle input:checked + .vx-toggle__ui {
    background: rgba(4, 229, 255, 0.16);
    border-color: rgba(160, 252, 252, 0.26);
  }
  .vx-toggle input:checked + .vx-toggle__ui::after {
    left: 21px;
    background: rgba(245, 231, 145, 0.85);
  }
  .vx-toggle input:disabled + .vx-toggle__ui {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .vx-cookie__prefsActions {
    display: flex;
    justify-content: flex-end;
    padding-top: 6px;
  }

  @media (max-width: 480px) {
    .vx-cookie { inset: auto 8px 8px 8px; max-width: 100vw; }
    .vx-cookie__card {
      width: calc(100vw - 16px);
      max-width: calc(100vw - 16px);
      max-height: min(260px, calc(100svh - 88px));
      box-shadow: 0 0 30px white, 0 18px 42px rgba(0, 0, 0, 0.68), 0 0 0 1px rgba(255, 255, 255, 0.05) inset;
    }
    .vx-cookie__head {
      gap: 8px;
      padding: 12px 12px 0;
    }
    .vx-cookie__badge {
      padding: 7px 9px;
      font-size: 10px;
      letter-spacing: 0.08em;
      border-radius: 8px;
    }
    .vx-cookie__title {
      font-size: 14px;
    }
    .vx-cookie__text {
      padding: 8px 12px 0;
      font-size: 13px;
      line-height: 1.4;
    }
    .vx-cookie__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      padding: 10px 12px 12px;
    }
    .vx-cbtn {
      width: 100%;
      padding: 9px 10px;
    }
    .vx-cbtn--primary {
      grid-column: 1 / -1;
    }
    .vx-cookie__link {
      padding: 0 12px 12px;
    }
  }
</style>

<script src="/js/cookie-banner.js" defer></script>
