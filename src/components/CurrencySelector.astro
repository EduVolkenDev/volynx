---
interface Props {
  variant?: "utility" | "flagship" | "topbar" | "compact" | "mobile";
}

const { variant = "compact" } = Astro.props;
---

<label class={`vx-currency-select vx-currency-select--${variant}`}>
  <span class="vx-currency-select__label" data-i18n="widget.currency">Currency</span>
  <select data-vx-currency-select data-i18n-aria="aria.currency_selector" aria-label="Currency">
    <option value="GBP">GBP</option>
    <option value="EUR">EUR</option>
    <option value="BRL">BRL</option>
  </select>
</label>

<style>
  .vx-currency-select {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    color: rgba(255, 255, 255, .72);
    font-family: inherit;
  }

  .vx-currency-select__label {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .vx-currency-select select {
    min-width: 72px;
    min-height: 38px;
    padding: 0 26px 0 11px;
    border: 1px solid rgba(255, 255, 255, .14);
    border-radius: 999px;
    background: rgba(24, 24, 27, .92);
    color: inherit;
    font: inherit;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0;
    color-scheme: dark;
    cursor: pointer;
    transition: color .15s ease, border-color .15s ease, background .15s ease;
  }

  .vx-currency-select select:hover,
  .vx-currency-select select:focus-visible {
    border-color: rgba(125, 249, 255, .46);
    background: #27272a;
    color: #fff;
    outline: none;
  }

  .vx-currency-select--utility select {
    min-width: 68px;
    min-height: 40px;
    background: rgba(8, 6, 16, .78);
    box-shadow: 0 4px 18px rgba(0, 0, 0, .38);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .vx-currency-select--topbar select {
    min-height: 44px;
    border-radius: 8px;
    background: rgba(255, 255, 255, .04);
    color: rgba(255, 255, 255, .55);
  }

  .vx-currency-select--compact select {
    min-width: 70px;
  }

  .vx-currency-select--mobile {
    width: 100%;
  }

  .vx-currency-select--mobile .vx-currency-select__label {
    position: static !important;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    color: rgba(255, 255, 255, .86);
    font-size: 18px;
    font-weight: 500;
  }

  .vx-currency-select--mobile {
    justify-content: space-between;
    min-height: 48px;
    padding: 8px 0;
  }

  .vx-currency-select--mobile select {
    min-width: 86px;
    min-height: 34px;
    border-color: #3f3f46;
  }

  @media (max-width: 380px) {
    .vx-currency-select--flagship select,
    .vx-currency-select--compact select {
      min-width: 64px;
      padding-left: 8px;
    }
  }
</style>
