---
interface Props {
  src?: string;
}
const { src = "/assets/vynx-ai.jpg" } = Astro.props;
---

<div class="lab-bg" aria-hidden="true">
  <img src={src} alt="" width="1920" height="1080" loading="eager" fetchpriority="high" decoding="sync" />
</div>

<style>
  .lab-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .lab-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.45;
    display: block;
  }
</style>
