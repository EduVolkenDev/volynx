---
const { pack, locale, currency } = Astro.props;
const currencies = ['GBP', 'EUR', 'BRL'] as const;
---
<div class="token-card" data-pack-id={pack.id}>
  <img src="/assets/vx-new.webp" alt="" class="token-card__icon" loading="lazy" decoding="async" />
  {pack.badge && <span class="token-pill"><span class="i18n-en">{pack.badge.en}</span><span class="i18n-pt">{pack.badge.pt}</span></span>}
  <h3 class="token-card__amount">{pack.amount} VX</h3>
  {currencies.map((c) => (
    <span class={`token-card__price ${c !== currency ? 'vx-price--hidden' : ''}`} data-currency={c}>{pack.price[c]}</span>
  ))}
  {pack.description
    ? <p class="token-card__desc"><span class="i18n-en">{pack.description.en}</span><span class="i18n-pt">{pack.description.pt}</span></p>
    : <p class="token-card__desc"><span class="i18n-en">One-time pack. Flexible capacity across the ecosystem.</span><span class="i18n-pt">Pacote avulso. Capacidade flexível em todo o ecossistema.</span></p>
  }
  <div class="token-card__buttons">
    <button type="button" class="token-card__cta"><span class="i18n-en">Buy</span><span class="i18n-pt">Comprar</span></button>
    <button type="button" class="token-card__pix" data-pix-pack={`tokens_${pack.id}_brl`}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="vertical-align:middle;margin-right:4px;">
        <path d="M17.7 6.3c-1.2-1.2-2.8-1.8-4.5-1.8s-3.3.6-4.5 1.8L5.4 9.6l2.1 2.1 3.3-3.3c.6-.6 1.4-.9 2.4-.9s1.8.3 2.4.9l3.3 3.3 2.1-2.1-3.3-3.3z" fill="currentColor"/>
        <path d="M6.3 17.7c1.2 1.2 2.8 1.8 4.5 1.8s3.3-.6 4.5-1.8l3.3-3.3-2.1-2.1-3.3 3.3c-.6.6-1.4.9-2.4.9s-1.8-.3-2.4-.9l-3.3-3.3-2.1 2.1 3.3 3.3z" fill="currentColor"/>
      </svg>
      Pix
    </button>
  </div>
</div>

<style>
  .token-card {
    position: relative;
    padding: 28px 22px 22px;
    border-radius: 22px;
    border: 1px solid rgba(255,255,255,.08);
    background:
      radial-gradient(circle at 50% -20%, rgba(15, 244, 212, .12), transparent 55%),
      rgba(255,255,255,.03);
    backdrop-filter: blur(10px);
    text-align: center;
    transition: all .25s;
    min-width: 0;
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
  }
  .token-card__icon {
    display: block;
    width: clamp(86px, 14vw, 120px);
    height: auto;
    margin: 0 auto 14px;
    filter: drop-shadow(0 0 14px rgba(15, 244, 212, .35)) drop-shadow(0 14px 28px rgba(0,0,0,.45));
    animation: tokenFloat 4.4s ease-in-out infinite;
  }
  @keyframes tokenFloat {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-4px); }
  }
  .token-card:hover {
    border-color: rgba(52,211,153,.32);
    transform: translateY(-3px);
    box-shadow: 0 18px 44px rgba(0, 240, 200, .18);
  }
  .token-card:hover .token-card__icon {
    transform: translateY(-2px) scale(1.04);
    filter: drop-shadow(0 0 18px rgba(15, 244, 212, .55)) drop-shadow(0 14px 28px rgba(0,0,0,.5));
  }
  .token-pill {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    background: rgba(52,211,153,.1);
    border: 1px solid rgba(52,211,153,.25);
    color: #34D399;
    margin-bottom: 10px;
  }
  .token-card__amount {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -.02em;
    margin: 0 0 6px;
  }
  .token-card__price {
    display: block;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -.04em;
    color: #0ff4d4;
    margin: 4px 0 0;
  }
  .token-card__desc {
    font-size: 12px;
    color: rgba(255,255,255,.4);
    margin: 10px 0 16px;
    line-height: 1.5;
  }
  .vx-price--hidden { display: none !important; }
  .token-card__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .token-card__cta {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    min-height: 44px;
    border-radius: 12px;
    border: 1px solid rgba(52,211,153,.2);
    background: rgba(52,211,153,.06);
    color: #34D399;
    text-decoration: none;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    transition: all .2s;
  }
  .token-card__cta:hover {
    background: rgba(52,211,153,.12);
  }
  .token-card__pix {
    display: none; /* Hidden by default, shown via JS when currency is BRL */
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    min-height: 44px;
    border-radius: 12px;
    border: 1px solid rgba(0,186,228,.2);
    background: rgba(0,186,228,.06);
    color: #00bae4;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    transition: all .2s;
    white-space: nowrap;
  }
  .token-card__pix:hover {
    background: rgba(0,186,228,.12);
    border-color: rgba(0,186,228,.35);
  }
</style>
