---
const { addon, locale, currency } = Astro.props;
const currencies = ['GBP', 'EUR', 'BRL'] as const;
const addonLookupKey = ({
  'domain-setup': 'addon_domain_setup',
  'template-pack': 'addon_template_pack',
  'html-export': 'addon_html_export',
  'extra-slot': 'addon_extra_slot',
  'bilingual': 'addon_bilingual',
  'icons-addon': 'addon_icons',
} as Record<string, string>)[addon.id] || `addon_${String(addon.id).replace(/-/g, '_')}`;
const isComingSoon = addon.comingSoon === true;
---
<div class={`addon-card${isComingSoon ? ' addon-card--soon' : ''}`} data-addon-id={addon.id} data-coming-soon={isComingSoon ? 'true' : null}>
  <div class="addon-card__info">
    <h3 class="addon-card__name">
      <span class="i18n-en">{addon.name.en}</span><span class="i18n-pt">{addon.name.pt}</span>
      {isComingSoon && (
        <span class="addon-card__pill"><span class="i18n-en">Coming soon</span><span class="i18n-pt">Em breve</span></span>
      )}
    </h3>
    <p class="addon-card__desc"><span class="i18n-en">{addon.description.en}</span><span class="i18n-pt">{addon.description.pt}</span></p>
  </div>
  <div class="addon-card__right">
    {currencies.map((c) => (
      <span class={`addon-card__price ${c !== currency ? 'vx-price--hidden' : ''}`} data-currency={c}>{addon.price[c]}</span>
    ))}
    {isComingSoon ? (
      <button type="button" class="addon-card__cta addon-card__cta--soon" disabled aria-disabled="true">
        <span class="i18n-en">Notify me</span><span class="i18n-pt">Avise-me</span>
      </button>
    ) : (
      <button type="button" class="addon-card__cta" data-addon-key={addonLookupKey}>
        <span class="i18n-en">Add</span><span class="i18n-pt">Adicionar</span>
      </button>
    )}
  </div>
</div>

<style>
  .addon-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,.06);
    background: rgba(255,255,255,.03);
    backdrop-filter: blur(10px);
    transition: all .2s;
    cursor: pointer;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }
  .addon-card:hover {
    border-color: rgba(196,181,253,.25);
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(0,0,0,.12);
  }
  .addon-card__name {
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 3px;
  }
  .addon-card__desc {
    font-size: 12px;
    color: rgba(255,255,255,.45);
    margin: 0;
    line-height: 1.5;
  }
  .addon-card__right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    flex-shrink: 0;
  }
  .addon-card__price {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0;
    white-space: nowrap;
    color: #C4B5FD;
  }
  .addon-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    border: 1px solid rgba(196,181,253,.25);
    background: rgba(196,181,253,.08);
    color: #C4B5FD;
    cursor: pointer;
    transition: all .15s;
    white-space: nowrap;
  }
  .addon-card__cta:hover {
    background: rgba(196,181,253,.18);
    border-color: rgba(196,181,253,.4);
  }
  .addon-card__cta.added {
    background: rgba(52,211,153,.1);
    border-color: rgba(52,211,153,.25);
    color: #34D399;
    pointer-events: none;
  }
  .addon-card--soon { opacity: .68; cursor: default; }
  .addon-card--soon:hover { transform: none; box-shadow: none; border-color: rgba(255,255,255,.06); }
  .addon-card__pill {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    background: rgba(255,255,255,.06);
    color: rgba(255,255,255,.55);
    border: 1px solid rgba(255,255,255,.08);
  }
  .addon-card__cta--soon {
    background: rgba(255,255,255,.04);
    border-color: rgba(255,255,255,.08);
    color: rgba(255,255,255,.4);
    cursor: not-allowed;
  }
  .addon-card__cta--soon:hover {
    background: rgba(255,255,255,.04);
    border-color: rgba(255,255,255,.08);
  }
</style>
