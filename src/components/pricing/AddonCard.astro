---
const { addon, locale, currency } = Astro.props;
const currencies = ['GBP', 'EUR', 'BRL'] as const;
---
<div class="addon-card">
  <div class="addon-card__info">
    <h3 class="addon-card__name">{addon.name[locale]}</h3>
    <p class="addon-card__desc">{addon.description[locale]}</p>
  </div>
  {currencies.map((c) => (
    <span class={`addon-card__price ${c !== currency ? 'vx-price--hidden' : ''}`} data-currency={c}>{addon.price[c]}</span>
  ))}
</div>

<style>
  .addon-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,.06);
    background: rgba(255,255,255,.03);
    backdrop-filter: blur(10px);
    transition: all .2s;
  }
  .addon-card:hover {
    border-color: rgba(255,255,255,.1);
    transform: translateY(-1px);
  }
  .addon-card__name {
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 3px;
  }
  .addon-card__desc {
    font-size: 12px;
    color: rgba(255,255,255,.45);
    margin: 0;
  }
  .addon-card__price {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -.03em;
    white-space: nowrap;
    color: #C4B5FD;
  }
</style>
