---
const { plan, locale, currency } = Astro.props;
const currencies = ['GBP', 'EUR', 'BRL'] as const;
---
<article class={`pricing-card ${plan.featured ? 'pricing-card--featured' : ''}${plan.image ? ' has-card-asset' : ''}`} data-plan={plan.id}>
  {plan.image && <img src={plan.image} alt="" class="card-asset" loading="lazy" />}
  <div class="pricing-card__head">
    <div>
      {plan.badge && <span class="pricing-pill"><span class="i18n-en">{plan.badge.en}</span><span class="i18n-pt">{plan.badge.pt}</span></span>}
      <h3 class="pricing-card__name"><span class="i18n-en">{plan.name.en}</span><span class="i18n-pt">{plan.name.pt}</span></h3>
      <p class="pricing-card__desc"><span class="i18n-en">{plan.description.en}</span><span class="i18n-pt">{plan.description.pt}</span></p>
    </div>
    <div class="pricing-card__price-block">
      {currencies.map((c) => (
        <span class={`pricing-card__price ${c !== currency ? 'pricing-card__price--hidden' : ''}`} data-currency={c}>{plan.price[c]}</span>
      ))}
      <span class="pricing-card__billing"><span class="i18n-en">{plan.billing.en}</span><span class="i18n-pt">{plan.billing.pt}</span></span>
    </div>
  </div>
  <ul class="pricing-card__features">
    {plan.features.en.map((f: string, i: number) => (
      <li><span class="i18n-en">{f}</span><span class="i18n-pt">{plan.features.pt[i] || f}</span></li>
    ))}
  </ul>
  <button type="button" class={`pricing-card__cta ${plan.featured ? 'pricing-card__cta--primary' : ''}`}><span class="i18n-en">{plan.cta.en}</span><span class="i18n-pt">{plan.cta.pt}</span></button>
</article>

<style>
  .pricing-card {
    padding: 24px;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,.06);
    background: rgba(255,255,255,.03);
    backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    transition: all .25s;
    position: relative;
    overflow: hidden;
  }

  /* Floating plan icon — top-right, visually prominent */
  .pricing-card > .card-asset {
    position: absolute;
    top: -28px;
    right: -28px;
    width: 190px;
    height: auto;
    opacity: 0.75;
    pointer-events: none;
    z-index: 0;
    transition: opacity .35s ease, transform .35s ease;
    filter: drop-shadow(0 12px 32px rgba(0,0,0,.45));
    mix-blend-mode: normal;
  }
  .pricing-card:hover > .card-asset {
    opacity: 0.92;
    transform: scale(1.07) rotate(-3deg);
  }
  .pricing-card > *:not(.card-asset) { position: relative; z-index: 1; }
  @media (min-width: 768px) {
    .pricing-card > .card-asset { width: 230px; top: -36px; right: -32px; }
  }
  .pricing-card:hover {
    border-color: rgba(255,255,255,.12);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0,0,0,.2);
  }
  .pricing-card--featured {
    border-color: rgba(139,123,255,.45);
    background: rgba(109,94,252,.07);
    box-shadow: 0 18px 60px rgba(139,123,255,.18), 0 0 0 1px rgba(139,123,255,.12);
  }
  .pricing-card--featured:hover {
    border-color: rgba(139,123,255,.6);
    box-shadow: 0 24px 70px rgba(139,123,255,.24), 0 0 0 1px rgba(139,123,255,.18);
  }
  .pricing-card__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 18px;
  }
  .pricing-pill {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    background: rgba(109,94,252,.12);
    border: 1px solid rgba(109,94,252,.3);
    color: #C4B5FD;
    margin-bottom: 10px;
  }
  .pricing-card__name {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -.02em;
    margin: 0 0 6px;
  }
  .pricing-card__desc {
    font-size: 13px;
    color: rgba(255,255,255,.5);
    margin: 0;
    line-height: 1.5;
  }
  .pricing-card__price-block {
    text-align: right;
    min-width: 100px;
    flex-shrink: 0;
  }
  .pricing-card__price {
    display: block;
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -.04em;
  }
  .pricing-card__price--hidden {
    display: none;
  }
  .pricing-card__billing {
    font-size: 13px;
    color: rgba(255,255,255,.4);
  }
  .pricing-card__features {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    flex: 1;
  }
  .pricing-card__features :global(li) {
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,.04);
    font-size: 14px;
    color: rgba(255,255,255,.75);
  }
  .pricing-card__features :global(li)::before {
    content: "✓ ";
    color: #34D399;
    font-weight: 700;
  }
  .pricing-card__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    min-height: 44px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.1);
    background: rgba(255,255,255,.04);
    color: rgba(255,255,255,.7);
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: all .2s;
  }
  .pricing-card__cta:hover {
    background: rgba(255,255,255,.08);
    color: #fff;
  }
  .pricing-card__cta--primary {
    background: rgba(109,94,252,.18);
    border-color: rgba(109,94,252,.4);
    color: #C4B5FD;
  }
  .pricing-card__cta--primary:hover {
    background: rgba(109,94,252,.28);
  }
</style>
