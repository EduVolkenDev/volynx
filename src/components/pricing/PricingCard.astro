---
import { ROUTES, checkoutHref } from "../../data/routes";

const { plan, locale, currency } = Astro.props;
const currencies = ['GBP', 'EUR', 'BRL'] as const;
const planLookupPrefix = ({
  launch: 'builder_launch',
  pro: 'builder_pro',
  studio: 'builder_studio',
  teams: 'builder_teams',
  daily_pro: 'daily_pro',
  daily_diamond: 'daily_diamond',
} as Record<string, string>)[plan.id];
const freePlanHref = ({
  free: ROUTES.builder,
  daily_free: ROUTES.daily,
} as Record<string, string>)[plan.id];
const ctaHref = freePlanHref || (planLookupPrefix ? checkoutHref(planLookupPrefix, { next: ROUTES.pricing }) : ROUTES.support);
---
<article class={`pricing-card ${plan.featured ? 'pricing-card--featured' : ''}${plan.image ? ' has-card-asset' : ''}`} data-plan={plan.id}>
  {plan.image && <img src={plan.image} alt="" class="card-asset" loading="lazy" />}
  <div class="pricing-card__head">
    <div>
      {plan.badge && <span class="pricing-pill"><span class="i18n-en">{plan.badge.en}</span><span class="i18n-pt">{plan.badge.pt}</span></span>}
      <h3 class="pricing-card__name"><span class="i18n-en">{plan.name.en}</span><span class="i18n-pt">{plan.name.pt}</span></h3>
      <p class="pricing-card__desc"><span class="i18n-en">{plan.description.en}</span><span class="i18n-pt">{plan.description.pt}</span></p>
    </div>
    <div class="pricing-card__price-block">
      {currencies.map((c) => (
        <span class={`pricing-card__price ${c !== currency ? 'pricing-card__price--hidden' : ''}`} data-currency={c}>{plan.price[c]}</span>
      ))}
      <span class="pricing-card__billing"><span class="i18n-en">{plan.billing.en}</span><span class="i18n-pt">{plan.billing.pt}</span></span>
    </div>
  </div>
  <ul class="pricing-card__features">
    {plan.features.en.map((f: string, i: number) => (
      <li><span class="i18n-en">{f}</span><span class="i18n-pt">{plan.features.pt[i] || f}</span></li>
    ))}
  </ul>
  <a href={ctaHref} class={`pricing-card__cta ${plan.featured ? 'pricing-card__cta--primary' : ''}`} data-lookup={planLookupPrefix || undefined}><span class="i18n-en">{plan.cta.en}</span><span class="i18n-pt">{plan.cta.pt}</span></a>
</article>

<style>
  .pricing-card {
    padding: 24px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,.06);
    background: rgba(255,255,255,.03);
    backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    transition: all .25s;
    position: relative;
    overflow: hidden;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  /* Floating plan icon — top-right hero, scaled to read as the card's identity */
  .pricing-card > .card-asset {
    position: absolute;
    top: -6px;
    right: -10px;
    width: min(150px, 42%);
    height: auto;
    opacity: 0.78;
    pointer-events: none;
    z-index: 0;
    transition: opacity .35s ease, transform .35s ease, filter .35s ease;
    filter: drop-shadow(0 14px 32px rgba(0,0,0,.45));
    mix-blend-mode: normal;
  }
  .pricing-card:hover > .card-asset {
    opacity: 1;
    transform: scale(1.08) rotate(-3deg);
    filter: drop-shadow(0 22px 44px rgba(0,0,0,.55));
  }
  .pricing-card > *:not(.card-asset) { position: relative; z-index: 1; }
  @media (min-width: 768px) {
    .pricing-card > .card-asset { width: 200px; top: -16px; right: -16px; }
  }
  .pricing-card:hover {
    border-color: rgba(255,255,255,.12);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0,0,0,.2);
  }
  .pricing-card--featured {
    border-color: rgba(139,123,255,.45);
    background: rgba(109,94,252,.07);
    box-shadow: 0 18px 60px rgba(139,123,255,.18), 0 0 0 1px rgba(139,123,255,.12);
    animation: pricingFeaturedPulse 4.2s ease-in-out infinite;
  }
  .pricing-card--featured:hover {
    border-color: rgba(139,123,255,.6);
    box-shadow: 0 24px 70px rgba(139,123,255,.24), 0 0 0 1px rgba(139,123,255,.18);
    animation-play-state: paused;
  }
  @keyframes pricingFeaturedPulse {
    0%, 100% {
      border-color: rgba(139,123,255,.40);
      box-shadow: 0 18px 60px rgba(139,123,255,.16), 0 0 0 1px rgba(139,123,255,.12);
    }
    50% {
      border-color: rgba(139,123,255,.65);
      box-shadow: 0 22px 70px rgba(139,123,255,.26), 0 0 0 1px rgba(139,123,255,.22);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pricing-card--featured { animation: none; }
  }
  .pricing-card__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 18px;
  }
  .pricing-pill {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
    background: rgba(109,94,252,.12);
    border: 1px solid rgba(109,94,252,.3);
    color: #C4B5FD;
    margin-bottom: 10px;
  }
  .pricing-card__name {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 0;
    margin: 0 0 6px;
  }
  .pricing-card__desc {
    font-size: 13px;
    color: rgba(255,255,255,.5);
    margin: 0;
    line-height: 1.5;
  }
  .pricing-card__price-block {
    text-align: right;
    min-width: 90px;
    max-width: 140px;
    flex-shrink: 0;
  }
  .pricing-card__price {
    display: block;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: 0;
    word-break: break-word;
  }
  @media (max-width: 400px) {
    .pricing-card__head {
      flex-direction: column;
    }
    .pricing-card__price-block {
      text-align: left;
      min-width: 0;
      max-width: none;
    }
  }
  .pricing-card__price--hidden {
    display: none;
  }
  .pricing-card__billing {
    font-size: 13px;
    color: rgba(255,255,255,.4);
  }
  .pricing-card__features {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    flex: 1;
  }
  .pricing-card__features :global(li) {
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,.04);
    font-size: 14px;
    color: rgba(255,255,255,.75);
  }
  .pricing-card__features :global(li)::before {
    content: "✓ ";
    color: #34D399;
    font-weight: 700;
  }
  .pricing-card__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    min-height: 44px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,.1);
    background: rgba(255,255,255,.04);
    color: rgba(255,255,255,.7);
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: all .2s;
  }
  .pricing-card__cta:hover {
    background: rgba(255,255,255,.08);
    color: #fff;
  }
  .pricing-card__cta--primary {
    background: rgba(109,94,252,.18);
    border-color: rgba(109,94,252,.4);
    color: #C4B5FD;
  }
  .pricing-card__cta--primary:hover {
    background: rgba(109,94,252,.28);
  }
</style>
